@namespace Vargshala.Web.Components.UI.Skeletons

<div class="space-y-3">
    @for (int i = 0; i < Count; i++)
    {
        <div class="p-4 rounded-2xl border border-slate-200/70 dark:border-slate-800 bg-white dark:bg-[#142025] flex flex-col gap-3 shadow-2xs">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <Skeleton Width="36px" Height="36px" Shape="Skeleton.SkeletonShape.Rounded" />
                    <div class="space-y-1.5">
                        <Skeleton Width="110px" Height="14px" />
                        <Skeleton Width="70px" Height="10px" />
                    </div>
                </div>
                <Skeleton Width="70px" Height="12px" />
            </div>
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center gap-2">
                <Skeleton Width="130px" Height="32px" Shape="Skeleton.SkeletonShape.Rounded" />
                <Skeleton Width="160px" Height="32px" Shape="Skeleton.SkeletonShape.Rounded" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 3;
}
