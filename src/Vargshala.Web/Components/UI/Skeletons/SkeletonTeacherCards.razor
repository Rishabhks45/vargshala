@namespace Vargshala.Web.Components.UI.Skeletons

<div class="space-y-2">
    @for (int i = 0; i < Count; i++)
    {
        <div class="p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 bg-white dark:bg-[#142025] flex items-center justify-between gap-2 shadow-2xs">
            <div class="flex items-center gap-2.5 min-w-0">
                <Skeleton Width="32px" Height="32px" Shape="Skeleton.SkeletonShape.Rounded" />
                <div class="space-y-1.5">
                    <Skeleton Width="110px" Height="12px" />
                    <div class="flex items-center gap-1">
                        <Skeleton Width="45px" Height="14px" Shape="Skeleton.SkeletonShape.Pill" />
                        <Skeleton Width="55px" Height="14px" Shape="Skeleton.SkeletonShape.Pill" />
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <Skeleton Width="55px" Height="20px" Shape="Skeleton.SkeletonShape.Pill" />
                <Skeleton Width="12px" Height="16px" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 5;
}
