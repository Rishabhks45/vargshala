<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-5 animate-pulse select-none pb-20">

    <!-- Breadcrumb & Top Actions Skeleton -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <Skeleton Width="40px" Height="40px" Class="rounded-2xl shrink-0" />
            <div class="space-y-1.5">
                <Skeleton Width="130px" Height="20px" Class="rounded-lg" />
                <Skeleton Width="240px" Height="12px" Class="rounded-md" />
            </div>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
            <Skeleton Width="80px" Height="36px" Class="rounded-xl" />
            <Skeleton Width="120px" Height="36px" Class="rounded-xl" />
        </div>
    </div>

    <!-- Profile Hero Card Skeleton -->
    <div class="relative overflow-hidden rounded-2xl bg-slate-200 dark:bg-[#15252b] p-5 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <!-- Avatar Skeleton -->
                <Skeleton Width="64px" Height="64px" Class="rounded-2xl shrink-0" />
                <!-- Name & Info Badges -->
                <div class="space-y-2.5 min-w-0">
                    <div class="flex items-center gap-2">
                        <Skeleton Width="160px" Height="22px" Class="rounded-lg" />
                        <Skeleton Width="70px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                        <Skeleton Width="60px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                    </div>
                    <div class="flex items-center gap-2.5">
                        <Skeleton Width="130px" Height="12px" Class="rounded-md" />
                        <Skeleton Width="100px" Height="12px" Class="rounded-md" />
                        <Skeleton Width="120px" Height="12px" Class="rounded-md" />
                    </div>
                </div>
            </div>
            <!-- Member Since Pill Skeleton -->
            <Skeleton Width="160px" Height="30px" Class="rounded-xl shrink-0 self-start md:self-auto" />
        </div>
    </div>

    <!-- Main Content Grid Skeleton -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- Left Column Skeleton (col-span-4) -->
        <div class="lg:col-span-4 space-y-4">
            <!-- Account Status Card Skeleton -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-xs space-y-3">
                <Skeleton Width="110px" Height="14px" Class="rounded-md" />
                <div class="space-y-2.5 pt-1">
                    <div class="flex items-center justify-between">
                        <Skeleton Width="50px" Height="12px" Class="rounded-md" />
                        <Skeleton Width="65px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                    </div>
                    <div class="flex items-center justify-between">
                        <Skeleton Width="60px" Height="12px" Class="rounded-md" />
                        <Skeleton Width="65px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                    </div>
                    <div class="flex items-center justify-between">
                        <Skeleton Width="55px" Height="12px" Class="rounded-md" />
                        <Skeleton Width="55px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                    </div>
                </div>
            </div>

            <!-- Organization Card Skeleton -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-xs space-y-3">
                <Skeleton Width="90px" Height="14px" Class="rounded-md" />
                <div class="flex items-center gap-3 pt-1">
                    <Skeleton Width="40px" Height="40px" Class="rounded-xl shrink-0" />
                    <div class="space-y-1.5 flex-1">
                        <Skeleton Width="120px" Height="14px" Class="rounded-md" />
                        <Skeleton Width="60px" Height="10px" Class="rounded-md" />
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card Skeleton -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-xs space-y-3">
                <Skeleton Width="100px" Height="14px" Class="rounded-md" />
                <Skeleton Height="36px" Class="w-full rounded-xl" />
            </div>
        </div>

        <!-- Right Column Skeleton (col-span-8) -->
        <div class="lg:col-span-8 space-y-4">

            <!-- Personal Information Card Skeleton -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
                <div class="px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <Skeleton Width="140px" Height="16px" Class="rounded-md" />
                </div>
                <div class="p-5 space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <Skeleton Width="70px" Height="12px" Class="rounded-md" />
                            <Skeleton Height="40px" Class="w-full rounded-xl" />
                        </div>
                        <div class="space-y-1.5">
                            <Skeleton Width="70px" Height="12px" Class="rounded-md" />
                            <Skeleton Height="40px" Class="w-full rounded-xl" />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <Skeleton Width="90px" Height="12px" Class="rounded-md" />
                            <Skeleton Height="40px" Class="w-full rounded-xl" />
                        </div>
                        <div class="space-y-1.5">
                            <Skeleton Width="90px" Height="12px" Class="rounded-md" />
                            <Skeleton Height="40px" Class="w-full rounded-xl" />
                        </div>
                    </div>
                    <div class="pt-2 flex justify-end">
                        <Skeleton Width="130px" Height="36px" Class="rounded-xl" />
                    </div>
                </div>
            </div>

            <!-- Change Password Card Skeleton (Default Collapsed) -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden px-5 py-3.5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <Skeleton Width="32px" Height="32px" Class="rounded-xl" />
                    <div class="space-y-1">
                        <Skeleton Width="130px" Height="14px" Class="rounded-md" />
                        <Skeleton Width="180px" Height="10px" Class="rounded-md" />
                    </div>
                </div>
                <Skeleton Width="28px" Height="28px" Class="rounded-lg" />
            </div>

            <!-- Account Metadata Card Skeleton -->
            <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
                <div class="px-5 py-3.5 border-b border-slate-100 dark:border-slate-800">
                    <Skeleton Width="130px" Height="16px" Class="rounded-md" />
                </div>
                <div class="p-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <Skeleton Height="54px" Class="w-full rounded-xl" />
                        <Skeleton Height="54px" Class="w-full rounded-xl" />
                        <Skeleton Height="54px" Class="w-full rounded-xl" />
                        <Skeleton Height="54px" Class="w-full rounded-xl" />
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
