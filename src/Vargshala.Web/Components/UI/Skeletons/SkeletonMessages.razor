@namespace Vargshala.Web.Components.UI.Skeletons

<div class="space-y-4 p-2">
    <!-- Date Separator Pill Skeleton -->
    <div class="flex items-center justify-center my-2">
        <Skeleton Width="110px" Height="22px" Shape="Skeleton.SkeletonShape.Pill" />
    </div>

    @for (int i = 0; i < Count; i++)
    {
        var isOutgoing = i % 2 != 0;

        @if (isOutgoing)
        {
            <!-- Outgoing Bubble Skeleton (Right Aligned, Teal-Tinted) -->
            <div class="flex items-end justify-end">
                <div class="max-w-md w-full sm:w-auto min-w-[200px] p-3.5 rounded-2xl rounded-tr-xs bg-teal-50/70 dark:bg-[#122b24]/80 border border-teal-100 dark:border-teal-900/60 shadow-2xs space-y-2">
                    <Skeleton Width="@(i % 3 == 0 ? "240px" : "170px")" Height="13px" />
                    @if (i % 3 == 0)
                    {
                        <Skeleton Width="130px" Height="13px" />
                    }
                    <div class="flex items-center justify-end gap-1 pt-1">
                        <Skeleton Width="42px" Height="10px" />
                        <Skeleton Width="14px" Height="10px" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Incoming Bubble Skeleton (Left Aligned, White/Dark Card) -->
            <div class="flex items-start gap-2.5">
                <Skeleton Width="32px" Height="32px" Shape="Skeleton.SkeletonShape.Circle" Class="mt-1" />

                <div class="max-w-md w-full sm:w-auto min-w-[220px] space-y-1">
                    <Skeleton Width="75px" Height="11px" Class="mb-1" />

                    <div class="p-3.5 rounded-2xl rounded-tl-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-800 shadow-2xs space-y-2">
                        <Skeleton Width="@(i % 3 == 0 ? "260px" : "190px")" Height="13px" />
                        <Skeleton Width="@(i % 3 == 0 ? "180px" : "110px")" Height="13px" />
                        <div class="flex items-center justify-end pt-1">
                            <Skeleton Width="42px" Height="10px" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 4;
}
