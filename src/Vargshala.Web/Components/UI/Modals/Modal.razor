<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 @(IsOpen ? "animate-in fade-in duration-150" : "hidden")"
     @onclick="HandleBackdropClick">
    <div class="w-full @MaxWidth bg-white rounded-3xl shadow-2xl border border-teal-800/40 animate-in zoom-in-95 duration-150 relative select-none overflow-hidden"
         @onclick:stopPropagation="true">
        
        <!-- Modal Header with Theme 4 Deep Teal Gradient & Glow -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                @if (IconTemplate != null)
                {
                    @IconTemplate
                }
                else
                {
                    <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0">
                        <img src="images/plant-books.png" alt="Vargshala" class="w-full h-full object-contain" />
                    </div>
                }
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight">
                        @Title
                    </h3>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="text-xs text-teal-200/90 font-medium mt-0.5">
                            @Subtitle
                        </p>
                    }
                </div>
            </div>

            <button type="button" 
                    @onclick="Close" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Modal Body Content -->
        <div class="p-6 space-y-4 select-text">
            @ChildContent
        </div>

        <!-- Optional Modal Footer -->
        @if (FooterTemplate != null)
        {
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/90 flex items-center justify-end gap-2.5">
                @FooterTemplate
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; } = true;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string MaxWidth { get; set; } = "max-w-md";
    [Parameter] public RenderFragment? IconTemplate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }
}
