@namespace Vargshala.Web.Components.UI.Notifications
@implements IDisposable

@if (IsVisible && (!string.IsNullOrWhiteSpace(Message) || ChildContent != null))
{
    <div class="@ContainerClasses @AnimationClass @ShadowClass @(IsFloating ? "fixed top-20 right-5 sm:right-6 z-[99999] max-w-[360px]" : "w-full")"
         style="@(IsFloating ? "z-index: 99999;" : null)"
         @onmouseenter="HandleMouseEnter"
         @onmouseleave="HandleMouseLeave"
         role="alert">
        
        <!-- Left Solid Accent Bar -->
        <div class="absolute left-0 top-0 bottom-0 w-1.5 @(IsThemed ? "" : AccentBarColor) rounded-l-xl"
             style="@(IsThemed ? "background-color: var(--theme-primary, #009488);" : null)"></div>

        <!-- Ambient Right Wave Graphic & Floating Dots -->
        <div class="absolute right-0 top-0 bottom-0 w-44 pointer-events-none overflow-hidden z-0">
            <svg class="absolute right-0 top-0 h-full w-full" viewBox="0 0 200 70" fill="none" preserveAspectRatio="none">
                @if (IsThemed)
                {
                    <path d="M50,70 C80,45 110,55 140,25 C160,10 180,20 200,15 L200,70 Z" fill="var(--theme-primary, #009488)" fill-opacity="0.18" />
                    <path d="M90,70 C120,50 150,52 175,30 C185,18 195,24 200,20 L200,70 Z" fill="var(--theme-primary, #009488)" fill-opacity="0.28" />
                }
                else
                {
                    <path d="M50,70 C80,45 110,55 140,25 C160,10 180,20 200,15 L200,70 Z" fill="@WaveColor1" fill-opacity="0.25" />
                    <path d="M90,70 C120,50 150,52 175,30 C185,18 195,24 200,20 L200,70 Z" fill="@WaveColor2" fill-opacity="0.35" />
                }
            </svg>
            <div class="absolute top-2.5 right-12 w-2 h-2 rounded-full @(IsThemed ? "" : DotColor1) opacity-60"
                 style="@(IsThemed ? "background-color: var(--theme-primary, #009488);" : null)"></div>
            <div class="absolute top-5 right-24 w-1 h-1 rounded-full @(IsThemed ? "" : DotColor2) opacity-40"
                 style="@(IsThemed ? "background-color: var(--theme-primary, #009488);" : null)"></div>
        </div>

        <div class="flex items-center gap-2.5 pl-1.5 w-full z-10">
            <!-- Concentric Circle Icon Badge (Outer Soft Ring + Inner Vibrant Core) -->
            <div class="w-9 h-9 rounded-full @(IsThemed ? "" : OuterCircleColor) flex items-center justify-center shrink-0"
                 style="@(IsThemed ? "background-color: color-mix(in srgb, var(--theme-primary, #009488) 18%, transparent);" : null)">
                <div class="w-6 h-6 rounded-full @(IsThemed ? "" : InnerCircleColor) flex items-center justify-center text-white shadow-xs"
                     style="@(IsThemed ? "background-color: var(--theme-primary, #009488);" : null)">
                    @switch (ResolvedType)
                    {
                        case AlertType.Success:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            break;

                        case AlertType.Error:
                        case AlertType.Failed:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            break;

                        case AlertType.Warning:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            break;

                        case AlertType.Theme:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                            </svg>
                            break;

                        case AlertType.Info:
                        default:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            break;
                    }
                </div>
            </div>

            <!-- Thin Vertical Divider Line -->
            <div class="h-7 w-[1px] @(IsThemed ? "" : DividerColor) shrink-0"
                 style="@(IsThemed ? "background-color: color-mix(in srgb, var(--theme-primary, #009488) 25%, transparent);" : null)"></div>

            <!-- Content Area -->
            <div class="flex-1 min-w-0 pr-1">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h5 class="font-extrabold text-[13px] tracking-tight leading-tight @(IsThemed ? "alert-themed-title" : TitleTextColor)">
                        @Title
                    </h5>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p class="text-[11px] font-medium leading-snug text-slate-700 dark:text-slate-300 mt-0.5">
                        @Message
                    </p>
                }

                @if (ChildContent != null)
                {
                    <div class="mt-1 text-xs text-slate-600 dark:text-slate-300">
                        @ChildContent
                    </div>
                }
            </div>

            <!-- Close / Dismiss Button -->
            @if (Dismissible)
            {
                <button type="button"
                        @onclick="CloseAsync"
                        class="p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-black/5 dark:hover:bg-white/10 transition-all active:scale-90 cursor-pointer shrink-0 -mt-1.5 -mr-1"
                        aria-label="Dismiss notification">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public AlertType Type { get; set; } = AlertType.Info;
    [Parameter] public bool UseTheme { get; set; } = false;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public bool IsFloating { get; set; } = false;
    [Parameter] public bool IsToast { get; set; } = false;
    [Parameter] public bool ForceClose { get; set; } = false;
    [Parameter] public int DurationSeconds { get; set; } = 2;

    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private AlertType ResolvedType => Type == AlertType.Failed ? AlertType.Error : Type;
    private bool IsThemed => UseTheme || ResolvedType == AlertType.Theme || ResolvedType == AlertType.Info;
    private readonly object _ctsLock = new();
    private CancellationTokenSource? _autoDismissCts;
    private bool _isDisposed;
    private bool _isClosing;
    private bool _isLeaving;
    private bool _isHovered;
    private string? _lastMessage;
    private bool _lastVisible;

    protected override void OnParametersSet()
    {
        if (IsVisible && (!_lastVisible || Message != _lastMessage))
        {
            _isClosing = false;
            _isLeaving = false;
        }
        _lastVisible = IsVisible;
        _lastMessage = Message;

        if (IsVisible && DurationSeconds > 0 && !_isHovered && !_isClosing && !_isDisposed)
        {
            StartAutoDismissTimer();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ForceClose && !_isClosing && !_isDisposed)
        {
            await CloseAsync();
        }
    }

    private void CancelTimer()
    {
        lock (_ctsLock)
        {
            if (_autoDismissCts != null)
            {
                try
                {
                    if (!_autoDismissCts.IsCancellationRequested)
                    {
                        _autoDismissCts.Cancel();
                    }
                }
                catch (ObjectDisposedException) { }
                catch (AggregateException) { }

                try
                {
                    _autoDismissCts.Dispose();
                }
                catch (ObjectDisposedException) { }

                _autoDismissCts = null;
            }
        }
    }

    private void StartAutoDismissTimer()
    {
        CancelTimer();

        if (!IsVisible || _isClosing || _isDisposed || _isHovered || DurationSeconds <= 0) return;

        CancellationToken token;
        lock (_ctsLock)
        {
            _autoDismissCts = new CancellationTokenSource();
            token = _autoDismissCts.Token;
        }

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(DurationSeconds), token);
                if (!token.IsCancellationRequested && !_isHovered && !_isClosing && !_isDisposed)
                {
                    await InvokeAsync(CloseAsync);
                }
            }
            catch (TaskCanceledException) { }
            catch (ObjectDisposedException) { }
        }, token);
    }

    private void HandleMouseEnter()
    {
        if (_isClosing || _isDisposed) return;
        _isHovered = true;
        CancelTimer();
    }

    private async Task HandleMouseLeave()
    {
        if (_isClosing || _isDisposed || !IsVisible) return;
        _isHovered = false;

        // User requirement: "cursor hatte hi close"
        try
        {
            await Task.Delay(350);
            if (!_isHovered && !_isClosing && !_isDisposed && IsVisible)
            {
                await InvokeAsync(CloseAsync);
            }
        }
        catch (Exception) { }
    }

    public async Task CloseAsync()
    {
        lock (_ctsLock)
        {
            if (_isClosing || _isDisposed) return;
            _isClosing = true;
        }

        CancelTimer();
        _isLeaving = true;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch { }

        try
        {
            await Task.Delay(320);
        }
        catch (TaskCanceledException) { }

        if (_isDisposed) return;

        IsVisible = false;

        try
        {
            await IsVisibleChanged.InvokeAsync(false);
            await OnClose.InvokeAsync();
        }
        catch (ObjectDisposedException) { }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        lock (_ctsLock)
        {
            _isDisposed = true;
        }
        CancelTimer();
    }

    private string AnimationClass => (IsToast || IsFloating)
        ? (_isLeaving ? "alert-toast-out" : "alert-toast-in")
        : (_isLeaving ? "alert-inline-out" : "alert-inline-in");

    private string ShadowClass => (IsToast || IsFloating)
        ? "shadow-2xl"
        : "shadow-md shadow-emerald-950/5";

    private string ContainerClasses => IsThemed
        ? "relative overflow-hidden rounded-xl alert-themed px-3.5 py-2.5 select-none"
        : ResolvedType switch
        {
            AlertType.Success => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#f0fdf9] via-[#f4fbf8] to-[#e6f7f2] dark:from-[#0d1f1c] dark:via-[#112521] dark:to-[#0f211e] border border-[#a7f3d0] dark:border-emerald-800/60 px-3.5 py-2.5 select-none",
            AlertType.Error => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#fff1f2] via-[#fff5f6] to-[#fee2e2] dark:from-[#210d10] dark:via-[#261013] dark:to-[#220e10] border border-[#fecdd3] dark:border-rose-800/60 px-3.5 py-2.5 select-none",
            AlertType.Warning => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#fffbeb] via-[#fefce8] to-[#fef3c7] dark:from-[#211909] dark:via-[#261e0c] dark:to-[#221b0b] border border-[#fde68a] dark:border-amber-800/60 px-3.5 py-2.5 select-none",
            AlertType.Theme => "relative overflow-hidden rounded-xl alert-themed px-3.5 py-2.5 select-none",
            AlertType.Info => "relative overflow-hidden rounded-xl alert-themed px-3.5 py-2.5 select-none",
            _ => "relative overflow-hidden rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3.5 py-2.5 select-none"
        };

    private string AccentBarColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]",
        AlertType.Error => "bg-[#f43f5e]",
        AlertType.Warning => "bg-[#f59e0b]",
        AlertType.Info => "bg-[#009488]",
        _ => "bg-slate-500"
    };

    private string OuterCircleColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]/15 dark:bg-emerald-950/70",
        AlertType.Error => "bg-[#f43f5e]/15 dark:bg-rose-950/70",
        AlertType.Warning => "bg-[#f59e0b]/15 dark:bg-amber-950/70",
        AlertType.Info => "bg-[#009488]/15 dark:bg-teal-950/70",
        _ => "bg-slate-200 dark:bg-slate-800"
    };

    private string InnerCircleColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]",
        AlertType.Error => "bg-[#f43f5e]",
        AlertType.Warning => "bg-[#f59e0b]",
        AlertType.Info => "bg-[#009488]",
        _ => "bg-slate-600"
    };

    private string DividerColor => ResolvedType switch
    {
        AlertType.Success => "bg-emerald-200/90 dark:bg-emerald-800/60",
        AlertType.Error => "bg-rose-200/90 dark:bg-rose-800/60",
        AlertType.Warning => "bg-amber-200/90 dark:bg-amber-800/60",
        AlertType.Info => "bg-teal-200/90 dark:bg-teal-800/60",
        _ => "bg-slate-200 dark:bg-slate-700"
    };

    private string TitleTextColor => ResolvedType switch
    {
        AlertType.Success => "text-[#065f46] dark:text-emerald-400",
        AlertType.Error => "text-[#9f1239] dark:text-rose-400",
        AlertType.Warning => "text-[#92400e] dark:text-amber-400",
        AlertType.Info => "text-[#004D40] dark:text-teal-400",
        _ => "text-slate-900 dark:text-white"
    };

    private string WaveColor1 => ResolvedType switch
    {
        AlertType.Success => "#6ee7b7",
        AlertType.Error => "#fda4af",
        AlertType.Warning => "#fcd34d",
        AlertType.Info => "#5eead4",
        _ => "#cbd5e1"
    };

    private string WaveColor2 => ResolvedType switch
    {
        AlertType.Success => "#34d399",
        AlertType.Error => "#fb7185",
        AlertType.Warning => "#fbbf24",
        AlertType.Info => "#2dd4bf",
        _ => "#94a3b8"
    };

    private string DotColor1 => ResolvedType switch
    {
        AlertType.Success => "bg-[#6ee7b7]",
        AlertType.Error => "bg-[#fda4af]",
        AlertType.Warning => "bg-[#fcd34d]",
        AlertType.Info => "bg-[#5eead4]",
        _ => "bg-slate-300"
    };

    private string DotColor2 => ResolvedType switch
    {
        AlertType.Success => "bg-[#34d399]",
        AlertType.Error => "bg-[#fb7185]",
        AlertType.Warning => "bg-[#fbbf24]",
        AlertType.Info => "bg-[#2dd4bf]",
        _ => "bg-slate-400"
    };
}
