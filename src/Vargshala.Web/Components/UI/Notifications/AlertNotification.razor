@namespace Vargshala.Web.Components.UI.Notifications
@implements IDisposable

@if (IsVisible && (!string.IsNullOrWhiteSpace(Message) || ChildContent != null))
{
    <div class="@ContainerClasses @(IsFloating ? "fixed top-20 right-5 sm:right-6 z-50 max-w-[360px] shadow-xl animate-in slide-in-from-top-4 duration-300" : "w-full shadow-md shadow-emerald-950/5 animate-in fade-in duration-200")"
         role="alert">
        
        <!-- Left Solid Accent Bar -->
        <div class="absolute left-0 top-0 bottom-0 w-1.5 @AccentBarColor rounded-l-xl"></div>

        <!-- Ambient Right Wave Graphic & Floating Dots -->
        <div class="absolute right-0 top-0 bottom-0 w-44 pointer-events-none overflow-hidden z-0">
            <svg class="absolute right-0 top-0 h-full w-full" viewBox="0 0 200 70" fill="none" preserveAspectRatio="none">
                <path d="M50,70 C80,45 110,55 140,25 C160,10 180,20 200,15 L200,70 Z" fill="@WaveColor1" fill-opacity="0.25" />
                <path d="M90,70 C120,50 150,52 175,30 C185,18 195,24 200,20 L200,70 Z" fill="@WaveColor2" fill-opacity="0.35" />
            </svg>
            <div class="absolute top-2.5 right-12 w-2 h-2 rounded-full @DotColor1 opacity-60"></div>
            <div class="absolute top-5 right-24 w-1 h-1 rounded-full @DotColor2 opacity-40"></div>
        </div>

        <div class="flex items-center gap-2.5 pl-1.5 w-full z-10">
            <!-- Concentric Circle Icon Badge (Outer Soft Ring + Inner Vibrant Core) -->
            <div class="w-9 h-9 rounded-full @OuterCircleColor flex items-center justify-center shrink-0">
                <div class="w-6 h-6 rounded-full @InnerCircleColor flex items-center justify-center text-white shadow-xs">
                    @switch (ResolvedType)
                    {
                        case AlertType.Success:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            break;

                        case AlertType.Error:
                        case AlertType.Failed:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            break;

                        case AlertType.Warning:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            break;

                        case AlertType.Info:
                        default:
                            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            break;
                    }
                </div>
            </div>

            <!-- Thin Vertical Divider Line -->
            <div class="h-7 w-[1px] @DividerColor shrink-0"></div>

            <!-- Content Area -->
            <div class="flex-1 min-w-0 pr-1">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h5 class="font-extrabold text-[13px] tracking-tight @TitleTextColor leading-tight">
                        @Title
                    </h5>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p class="text-[11px] font-medium leading-snug text-slate-700 dark:text-slate-300 mt-0.5">
                        @Message
                    </p>
                }

                @if (ChildContent != null)
                {
                    <div class="mt-1 text-xs text-slate-600 dark:text-slate-300">
                        @ChildContent
                    </div>
                }
            </div>

            <!-- Close / Dismiss Button -->
            @if (Dismissible)
            {
                <button type="button"
                        @onclick="CloseAsync"
                        class="p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer shrink-0 -mt-1.5 -mr-1"
                        aria-label="Dismiss notification">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public AlertType Type { get; set; } = AlertType.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public bool IsFloating { get; set; } = false;
    [Parameter] public int DurationSeconds { get; set; } = 0;

    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private AlertType ResolvedType => Type == AlertType.Failed ? AlertType.Error : Type;
    private CancellationTokenSource? _autoDismissCts;

    protected override void OnParametersSet()
    {
        if (IsVisible && DurationSeconds > 0)
        {
            StartAutoDismissTimer();
        }
    }

    private void StartAutoDismissTimer()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
        _autoDismissCts = new CancellationTokenSource();

        var token = _autoDismissCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(DurationSeconds), token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(CloseAsync);
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    public async Task CloseAsync()
    {
        _autoDismissCts?.Cancel();
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    private string ContainerClasses => ResolvedType switch
    {
        AlertType.Success => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#f0fdf9] via-[#f4fbf8] to-[#e6f7f2] dark:from-[#0d1f1c] dark:via-[#112521] dark:to-[#0f211e] border border-[#a7f3d0] dark:border-emerald-800/60 px-3.5 py-2.5 select-none",
        AlertType.Error => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#fff1f2] via-[#fff5f6] to-[#fee2e2] dark:from-[#210d10] dark:via-[#261013] dark:to-[#220e10] border border-[#fecdd3] dark:border-rose-800/60 px-3.5 py-2.5 select-none",
        AlertType.Warning => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#fffbeb] via-[#fefce8] to-[#fef3c7] dark:from-[#211909] dark:via-[#261e0c] dark:to-[#221b0b] border border-[#fde68a] dark:border-amber-800/60 px-3.5 py-2.5 select-none",
        AlertType.Info => "relative overflow-hidden rounded-xl bg-gradient-to-r from-[#f0fdfa] via-[#f4fcf9] to-[#ccfbf1] dark:from-[#0b1f1e] dark:via-[#0e2523] dark:to-[#0c2120] border border-[#99f6e4] dark:border-teal-800/60 px-3.5 py-2.5 select-none",
        _ => "relative overflow-hidden rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3.5 py-2.5 select-none"
    };

    private string AccentBarColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]",
        AlertType.Error => "bg-[#f43f5e]",
        AlertType.Warning => "bg-[#f59e0b]",
        AlertType.Info => "bg-[#009488]",
        _ => "bg-slate-500"
    };

    private string OuterCircleColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]/15 dark:bg-emerald-950/70",
        AlertType.Error => "bg-[#f43f5e]/15 dark:bg-rose-950/70",
        AlertType.Warning => "bg-[#f59e0b]/15 dark:bg-amber-950/70",
        AlertType.Info => "bg-[#009488]/15 dark:bg-teal-950/70",
        _ => "bg-slate-200 dark:bg-slate-800"
    };

    private string InnerCircleColor => ResolvedType switch
    {
        AlertType.Success => "bg-[#10b981]",
        AlertType.Error => "bg-[#f43f5e]",
        AlertType.Warning => "bg-[#f59e0b]",
        AlertType.Info => "bg-[#009488]",
        _ => "bg-slate-600"
    };

    private string DividerColor => ResolvedType switch
    {
        AlertType.Success => "bg-emerald-200/90 dark:bg-emerald-800/60",
        AlertType.Error => "bg-rose-200/90 dark:bg-rose-800/60",
        AlertType.Warning => "bg-amber-200/90 dark:bg-amber-800/60",
        AlertType.Info => "bg-teal-200/90 dark:bg-teal-800/60",
        _ => "bg-slate-200 dark:bg-slate-700"
    };

    private string TitleTextColor => ResolvedType switch
    {
        AlertType.Success => "text-[#065f46] dark:text-emerald-400",
        AlertType.Error => "text-[#9f1239] dark:text-rose-400",
        AlertType.Warning => "text-[#92400e] dark:text-amber-400",
        AlertType.Info => "text-[#004D40] dark:text-teal-400",
        _ => "text-slate-900 dark:text-white"
    };

    private string WaveColor1 => ResolvedType switch
    {
        AlertType.Success => "#6ee7b7",
        AlertType.Error => "#fda4af",
        AlertType.Warning => "#fcd34d",
        AlertType.Info => "#5eead4",
        _ => "#cbd5e1"
    };

    private string WaveColor2 => ResolvedType switch
    {
        AlertType.Success => "#34d399",
        AlertType.Error => "#fb7185",
        AlertType.Warning => "#fbbf24",
        AlertType.Info => "#2dd4bf",
        _ => "#94a3b8"
    };

    private string DotColor1 => ResolvedType switch
    {
        AlertType.Success => "bg-[#6ee7b7]",
        AlertType.Error => "bg-[#fda4af]",
        AlertType.Warning => "bg-[#fcd34d]",
        AlertType.Info => "bg-[#5eead4]",
        _ => "bg-slate-300"
    };

    private string DotColor2 => ResolvedType switch
    {
        AlertType.Success => "bg-[#34d399]",
        AlertType.Error => "bg-[#fb7185]",
        AlertType.Warning => "bg-[#fbbf24]",
        AlertType.Info => "bg-[#2dd4bf]",
        _ => "bg-slate-400"
    };

    public void Dispose()
    {
        _autoDismissCts?.Cancel();
        _autoDismissCts?.Dispose();
    }
}
