@namespace Vargshala.Web.Components.UI.Notifications
@implements IDisposable
@inject INotificationService NotificationService

<div class="fixed @PositionClass z-50 flex flex-col gap-2.5 max-w-[340px] sm:max-w-[360px] w-full pointer-events-none px-3 sm:px-0"
     aria-live="polite">
    @foreach (var item in _notifications)
    {
        <div class="pointer-events-auto transition-all duration-300 animate-in slide-in-from-top-4 fade-in shadow-lg shadow-emerald-950/10 rounded-xl">
            <AlertNotification Type="item.Type"
                               Title="@item.Title"
                               Message="@item.Message"
                               Dismissible="item.Dismissible"
                               DurationSeconds="item.DurationSeconds"
                               OnClose="() => RemoveNotification(item.Id)" />
        </div>
    }
</div>

@code {
    [Parameter] public string PositionClass { get; set; } = "top-20 right-5 sm:right-6";

    private readonly List<NotificationItem> _notifications = new();

    protected override void OnInitialized()
    {
        NotificationService.OnNotificationReceived += HandleNotificationReceived;
        NotificationService.OnNotificationDismissed += HandleNotificationDismissed;
    }

    private void HandleNotificationReceived(NotificationItem item)
    {
        InvokeAsync(() =>
        {
            _notifications.Insert(0, item);
            StateHasChanged();
        });
    }

    private void HandleNotificationDismissed(Guid id)
    {
        InvokeAsync(() =>
        {
            RemoveNotification(id);
        });
    }

    private void RemoveNotification(Guid id)
    {
        var existing = _notifications.FirstOrDefault(x => x.Id == id);
        if (existing != null)
        {
            _notifications.Remove(existing);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= HandleNotificationReceived;
        NotificationService.OnNotificationDismissed -= HandleNotificationDismissed;
    }
}
