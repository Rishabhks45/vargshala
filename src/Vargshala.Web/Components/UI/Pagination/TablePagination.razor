@using Vargshala.Web.Components.UI.Inputs

<div class="p-4 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 select-none">
    <!-- Showing summary + Rows per page -->
    <div class="flex flex-wrap items-center gap-3">
        <div>
            Showing <span class="font-bold text-slate-800 dark:text-white">@FromRecord-@ToRecord</span> of <span class="font-bold text-slate-800 dark:text-white">@TotalRecords</span> @ItemLabel
        </div>

        @if (ShowPageSizeSelector)
        {
            <div class="flex items-center gap-1.5">
                <span class="text-slate-400 text-[11px]">Rows:</span>
                <div class="w-28">
                    <CustomSelect Value="@PageSize.ToString()" 
                                  ValueChanged="HandlePageSizeChangedAsync" 
                                  Options="_pageSizeOptions" 
                                  Placeholder="10 / page" 
                                  DropUp="true"
                                  Align="left"
                                  MenuWidthClass="w-full min-w-[110px]" />
                </div>
            </div>
        }
    </div>

    <!-- Navigation Buttons -->
    <div class="flex items-center gap-1.5">
        <button type="button" 
                @onclick="() => ChangePageAsync(PageNumber - 1)" 
                disabled="@(PageNumber <= 1 || IsLoading)"
                class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 disabled:opacity-40 hover:bg-slate-50 dark:hover:bg-[#1f3037] cursor-pointer disabled:cursor-not-allowed transition-all shadow-2xs">
            Previous
        </button>

        <div class="px-3 py-1.5 rounded-lg bg-[#009488] text-white font-bold flex items-center justify-center shadow-xs">
            @PageNumber / @TotalPages
        </div>

        <button type="button" 
                @onclick="() => ChangePageAsync(PageNumber + 1)" 
                disabled="@(PageNumber >= TotalPages || IsLoading)"
                class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 disabled:opacity-40 hover:bg-slate-50 dark:hover:bg-[#1f3037] cursor-pointer disabled:cursor-not-allowed transition-all shadow-2xs">
            Next
        </button>
    </div>
</div>

@code {
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalRecords { get; set; } = 0;
    [Parameter] public string ItemLabel { get; set; } = "records";
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    private int TotalPages => PageSize > 0 ? Math.Max(1, (int)Math.Ceiling(TotalRecords / (double)PageSize)) : 1;
    private int FromRecord => TotalRecords == 0 ? 0 : ((PageNumber - 1) * PageSize + 1);
    private int ToRecord => Math.Min(PageNumber * PageSize, TotalRecords);

    private readonly List<CustomSelect.CustomSelectOption> _pageSizeOptions = new()
    {
        new("10", "10 / page"),
        new("25", "25 / page"),
        new("50", "50 / page"),
        new("100", "100 / page")
    };

    private async Task ChangePageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == PageNumber) return;
        if (OnPageChanged.HasDelegate)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task HandlePageSizeChangedAsync(string value)
    {
        if (int.TryParse(value, out var newSize) && newSize != PageSize)
        {
            if (OnPageSizeChanged.HasDelegate)
            {
                await OnPageSizeChanged.InvokeAsync(newSize);
            }
        }
    }
}
