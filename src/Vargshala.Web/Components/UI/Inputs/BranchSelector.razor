@using Vargshala.Contracts.Branches
@using Vargshala.Web.Services
@inject IBranchContextService BranchContext
@implements IDisposable

<div class="relative text-left" @onclick:stopPropagation="true">
    <!-- Trigger Button in Header -->
    <button type="button" 
            @onclick="ToggleDropdown"
            class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 border border-teal-400/30 hover:border-teal-300/50 text-white transition-all duration-150 cursor-pointer text-xs select-none shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-300/40">
        
        <!-- Icon -->
        @if (BranchContext.IsAllBranches)
        {
            <span class="flex items-center justify-center w-5 h-5 rounded-lg bg-teal-500/30 text-teal-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
            </span>
            <span class="font-bold truncate max-w-[120px] sm:max-w-[160px]">All Branches</span>
        }
        else if (BranchContext.CurrentBranch?.IsMainBranch == true)
        {
            <span class="flex items-center justify-center w-5 h-5 rounded-lg bg-amber-400/20 text-amber-300">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </span>
            <div class="flex items-center gap-1.5 truncate max-w-[120px] sm:max-w-[160px]">
                <span class="font-bold truncate">@BranchContext.CurrentBranch?.Name</span>
                <span class="text-[9px] px-1.5 py-0.2 bg-amber-400/30 text-amber-200 font-extrabold rounded tracking-wide shrink-0">MAIN</span>
            </div>
        }
        else
        {
            <span class="flex items-center justify-center w-5 h-5 rounded-lg bg-teal-400/20 text-teal-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
            </span>
            <span class="font-bold truncate max-w-[120px] sm:max-w-[160px]">@(BranchContext.CurrentBranch?.Name ?? "Select Branch")</span>
        }

        <!-- Dropdown Arrow -->
        <svg class="w-3.5 h-3.5 text-teal-200 transition-transform duration-200 @(_isOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>

    <!-- Floating Dropdown Menu -->
    @if (_isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <div class="absolute right-0 top-full mt-2 w-72 rounded-2xl bg-[#00382E] border border-teal-600/50 shadow-2xl p-2 z-50 animate-in fade-in zoom-in-95 duration-100 text-left backdrop-blur-md select-none">
            
            <div class="px-2.5 py-1.5 mb-1 flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-teal-300">Branch Scope</span>
                <span class="text-[10px] text-teal-400/80">@BranchContext.AvailableBranches.Count active</span>
            </div>

            <div class="space-y-1 max-h-72 overflow-y-auto" style="scrollbar-width: thin; scrollbar-color: #00796B transparent;">
                
                <!-- Option: All Branches -->
                <button type="button"
                        @onclick="() => SelectBranch(null)"
                        class="w-full px-3 py-2 rounded-xl text-xs flex items-center justify-between transition-all cursor-pointer @(BranchContext.IsAllBranches ? "bg-[#009488] text-white font-bold shadow-sm" : "text-teal-100 hover:bg-white/10 hover:text-white")">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-teal-500/30 text-teal-200 shrink-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </span>
                        <div class="flex flex-col text-left truncate">
                            <span class="truncate">All Branches</span>
                            <span class="text-[10px] opacity-75 font-normal">Organization-wide view</span>
                        </div>
                    </div>
                    @if (BranchContext.IsAllBranches)
                    {
                        <svg class="w-4 h-4 text-white shrink-0 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                    }
                </button>

                <div class="h-px bg-teal-700/40 my-1"></div>

                <!-- Option: Main Branch (if exists) -->
                @if (MainBranch != null)
                {
                    var isSelected = BranchContext.CurrentBranchId == MainBranch.Id;
                    <button type="button"
                            @onclick="() => SelectBranch(MainBranch.Id)"
                            class="w-full px-3 py-2 rounded-xl text-xs flex items-center justify-between transition-all cursor-pointer @(isSelected ? "bg-[#009488] text-white font-bold shadow-sm" : "text-teal-100 hover:bg-white/10 hover:text-white")">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-amber-400/20 text-amber-300 shrink-0">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                            </span>
                            <div class="flex flex-col text-left truncate">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="truncate font-semibold">@MainBranch.Name</span>
                                    <span class="text-[9px] px-1.5 py-0.2 bg-amber-400/30 text-amber-200 font-extrabold rounded shrink-0">MAIN</span>
                                </div>
                                <span class="text-[10px] opacity-75 font-normal truncate">@MainBranch.Code @(!string.IsNullOrEmpty(MainBranch.City) ? $"• {MainBranch.City}" : "")</span>
                            </div>
                        </div>
                        @if (isSelected)
                        {
                            <svg class="w-4 h-4 text-white shrink-0 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }

                <!-- Other Branches -->
                @foreach (var branch in OtherBranches)
                {
                    var isSelected = BranchContext.CurrentBranchId == branch.Id;
                    <button type="button"
                            @onclick="() => SelectBranch(branch.Id)"
                            class="w-full px-3 py-2 rounded-xl text-xs flex items-center justify-between transition-all cursor-pointer @(isSelected ? "bg-[#009488] text-white font-bold shadow-sm" : "text-teal-100 hover:bg-white/10 hover:text-white")">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="flex items-center justify-center w-6 h-6 rounded-lg bg-teal-500/20 text-teal-300 shrink-0">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                </svg>
                            </span>
                            <div class="flex flex-col text-left truncate">
                                <span class="truncate font-semibold">@branch.Name</span>
                                <span class="text-[10px] opacity-75 font-normal truncate">@branch.Code @(!string.IsNullOrEmpty(branch.City) ? $"• {branch.City}" : "")</span>
                            </div>
                        </div>
                        @if (isSelected)
                        {
                            <svg class="w-4 h-4 text-white shrink-0 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _isOpen = false;

    private BranchDto? MainBranch => BranchContext.AvailableBranches.FirstOrDefault(b => b.IsMainBranch);
    private IEnumerable<BranchDto> OtherBranches => BranchContext.AvailableBranches.Where(b => !b.IsMainBranch);

    protected override void OnInitialized()
    {
        BranchContext.OnBranchChanged += HandleBranchChangedAsync;
    }

    private Task HandleBranchChangedAsync()
    {
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;
    private void Close() => _isOpen = false;

    private async Task SelectBranch(Guid? branchId)
    {
        _isOpen = false;
        await BranchContext.SetBranchAsync(branchId);
    }

    public void Dispose()
    {
        BranchContext.OnBranchChanged -= HandleBranchChangedAsync;
    }
}
