<div class="relative inline-block text-left @(Class.Contains("w-") ? Class : $"w-full sm:w-auto {Class}")" @onclick:stopPropagation="true">
    <!-- Trigger Button (Full Responsive with Theme 4 Hover & Focus Ring) -->
    <button type="button" 
            @onclick="ToggleDropdown"
            class="w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 shadow-2xs transition-all cursor-pointer select-none">
        <span class="truncate @(string.IsNullOrEmpty(Value) ? "text-slate-400 dark:text-slate-500" : "text-slate-800 dark:text-white")">
            @(SelectedLabel)
        </span>
        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 shrink-0 transform transition-transform duration-200 @(_isOpen ? "rotate-180 text-[#009488]" : "")" 
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>

    <!-- Floating Custom Dropdown Menu with Pill Selection (Perfect Fit, No Gaps!) -->
    @if (_isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <div class="absolute left-0 sm:left-auto right-0 top-full mt-1.5 w-full min-w-[180px] bg-white dark:bg-[#111c21] rounded-2xl shadow-xl border border-slate-100 dark:border-slate-800 p-1.5 z-50 animate-in fade-in zoom-in-95 duration-100 select-none">
            <div class="space-y-0.5">
                @foreach (var opt in Options)
                {
                    var isSelected = opt.Value == Value;
                    <button type="button"
                            @onclick="() => SelectOption(opt.Value)"
                            class="w-full px-3 py-2 rounded-xl text-xs text-left flex items-center justify-between transition-all cursor-pointer @(isSelected ? "bg-[#009488] text-white font-bold shadow-xs" : "text-slate-700 dark:text-slate-300 hover:bg-teal-50/80 dark:hover:bg-teal-950/80 hover:text-[#00796b] dark:hover:text-teal-300")">
                        <span class="truncate">@opt.Label</span>
                        @if (isSelected)
                        {
                            <svg class="w-3.5 h-3.5 text-white shrink-0 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public List<CustomSelectOption> Options { get; set; } = new();
    [Parameter] public string Placeholder { get; set; } = "Select option...";
    [Parameter] public string Class { get; set; } = string.Empty;

    private bool _isOpen = false;

    private string SelectedLabel
    {
        get
        {
            var match = Options.FirstOrDefault(o => o.Value == Value);
            return match != null ? match.Label : (string.IsNullOrEmpty(Placeholder) ? Value : Placeholder);
        }
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void Close()
    {
        _isOpen = false;
    }

    private async Task SelectOption(string val)
    {
        Value = val;
        _isOpen = false;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(val);
        }
    }

    public class CustomSelectOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;

        public CustomSelectOption(string value, string label)
        {
            Value = value;
            Label = label;
        }
    }
}
