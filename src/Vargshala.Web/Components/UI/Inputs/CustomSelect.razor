<div class="relative text-left @(Class.Contains("w-") ? Class : $"w-full sm:w-auto {Class}")" @onclick:stopPropagation="true">
    <!-- Trigger Button (Full Responsive with Exact SearchBox Focus Color) -->
    <button type="button" 
            @onclick="ToggleDropdown"
            class="custom-select-trigger w-full flex items-center justify-between gap-2 @TriggerStyleClass cursor-pointer select-none outline-none focus:outline-none focus-visible:outline-none">
        <span class="truncate @(string.IsNullOrEmpty(Value) ? "text-slate-400 dark:text-slate-500" : (IsFormMode ? "text-slate-900 dark:text-white font-medium" : "text-slate-800 dark:text-white font-semibold"))">
            @(SelectedLabel)
        </span>
        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 shrink-0 transform transition-transform duration-200 @(_isOpen ? "rotate-180 text-[#009488]" : "")" 
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>

    <!-- Floating Custom Dropdown Menu with Pill Selection (Perfect Fit, No Gaps!) -->
    @if (_isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <div class="absolute @DropdownPositionClass w-full @MenuWidthClass bg-white dark:bg-[#111c21] rounded-2xl shadow-xl border border-slate-100 dark:border-slate-800 p-1.5 z-50 animate-in fade-in zoom-in-95 duration-100 select-none">
            <div class="space-y-0.5 max-h-60 overflow-y-auto">
                @foreach (var opt in Options)
                {
                    var isSelected = opt.Value == Value;
                    <button type="button"
                            @onclick="() => SelectOption(opt.Value)"
                            class="w-full px-3 py-2 rounded-xl text-xs text-left flex items-center justify-between transition-all cursor-pointer @(isSelected ? "bg-[#009488] text-white font-bold shadow-xs" : "text-slate-700 dark:text-slate-300 hover:bg-teal-50/80 dark:hover:bg-teal-950/80 hover:text-[#00796b] dark:hover:text-teal-300")">
                        <span class="truncate">@opt.Label</span>
                        @if (isSelected)
                        {
                            <svg class="w-3.5 h-3.5 text-white shrink-0 ml-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public List<CustomSelectOption> Options { get; set; } = new();
    [Parameter] public string Placeholder { get; set; } = "Select option...";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public bool IsForm { get; set; } = false;
    [Parameter] public bool DropUp { get; set; } = false;
    [Parameter] public string Align { get; set; } = "auto";
    [Parameter] public string MenuWidthClass { get; set; } = "min-w-[160px]";

    private bool _isOpen = false;

    private bool IsFormMode => IsForm || Class.Contains("w-full") || Class.Contains("form") || Class.Contains("h-10");

    private string TriggerStyleClass
    {
        get
        {
            if (Compact)
            {
                return "h-7 px-2.5 text-[11px] rounded-lg bg-white dark:bg-[#18262c] font-semibold text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700/80 shadow-2xs";
            }

            if (IsFormMode)
            {
                // Exact height, padding, background and border matching InputText / Form inputs
                var stateClasses = _isOpen
                    ? "bg-white dark:bg-[#142025] border-[#009488] ring-2 ring-teal-500/20 is-open"
                    : "bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600";

                return $"h-10 min-h-[40px] px-3.5 py-2.5 text-xs rounded-xl border text-slate-900 dark:text-white transition-all shadow-2xs {stateClasses}";
            }

            // Default Table Filter dropdown style
            var filterState = _isOpen
                ? "border-[#009488] dark:border-[#009488] ring-2 ring-teal-500/20 is-open"
                : "border-slate-200 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600";

            return $"px-3.5 py-2 text-xs rounded-xl bg-white dark:bg-[#18262c] font-semibold text-slate-700 dark:text-slate-200 border shadow-2xs transition-all {filterState}";
        }
    }

    private string DropdownPositionClass
    {
        get
        {
            var vertical = DropUp ? "bottom-full mb-1.5" : "top-full mt-1.5";
            var horizontal = Align switch
            {
                "left" => "left-0 right-auto",
                "right" => "right-0 left-auto",
                _ => "left-0 sm:left-auto right-0"
            };
            return $"{vertical} {horizontal}";
        }
    }

    private string SelectedLabel
    {
        get
        {
            var match = Options.FirstOrDefault(o => o.Value == Value);
            return match != null ? match.Label : (string.IsNullOrEmpty(Placeholder) ? Value : Placeholder);
        }
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void Close()
    {
        _isOpen = false;
    }

    private async Task SelectOption(string val)
    {
        Value = val;
        _isOpen = false;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(val);
        }
    }

    public class CustomSelectOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;

        public CustomSelectOption(string value, string label)
        {
            Value = value;
            Label = label;
        }
    }
}
