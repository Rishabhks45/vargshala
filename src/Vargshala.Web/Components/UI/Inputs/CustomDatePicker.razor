@using System.Globalization

<div class="relative inline-flex items-center @(Class.Contains("w-") ? Class : $"w-auto {Class}")" @onclick:stopPropagation="true">
    <!-- Trigger Container Pill -->
    <div class="flex items-center @(IsFormMode ? "w-full justify-between h-10 px-1" : "") bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl shadow-2xs transition-all @(_isOpen ? "border-[#009488] ring-2 ring-teal-500/20" : "hover:border-slate-300 dark:hover:border-slate-600") @(Disabled ? "opacity-60 cursor-not-allowed" : "")">
        
        @if (ShowSteppers)
        {
            <!-- Previous Day Step Button -->
            <button type="button"
                    @onclick="StepPreviousDay"
                    @onclick:stopPropagation="true"
                    disabled="@Disabled"
                    title="Previous Day"
                    class="px-2 py-2 text-slate-400 dark:text-slate-500 hover:text-[#009488] dark:hover:text-teal-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-l-xl transition-colors cursor-pointer disabled:cursor-not-allowed">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700/80 shrink-0"></div>
        }

        <!-- Center Date Display & Dropdown Trigger -->
        <button type="button"
                @onclick="ToggleDropdown"
                disabled="@Disabled"
                class="flex items-center @(IsFormMode ? "flex-1 justify-between px-3.5" : "gap-2 px-3") py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 select-none outline-none cursor-pointer disabled:cursor-not-allowed">
            <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-[#009488] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="whitespace-nowrap">
                    @FormattedDateText
                </span>
            </div>
            <svg class="w-3 h-3 text-slate-400 dark:text-slate-500 shrink-0 ml-1 transform transition-transform duration-200 @(_isOpen ? "rotate-180 text-[#009488]" : "")"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>

        @if (ShowSteppers)
        {
            <div class="h-4 w-px bg-slate-200 dark:bg-slate-700/80 shrink-0"></div>
            <!-- Next Day Step Button -->
            <button type="button"
                    @onclick="StepNextDay"
                    @onclick:stopPropagation="true"
                    disabled="@Disabled"
                    title="Next Day"
                    class="px-2 py-2 text-slate-400 dark:text-slate-500 hover:text-[#009488] dark:hover:text-teal-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 rounded-r-xl transition-colors cursor-pointer disabled:cursor-not-allowed">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        }
    </div>

    <!-- Floating Calendar Popover Dropdown -->
    @if (_isOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <div class="absolute @DropdownPositionClass w-80 bg-white dark:bg-[#142025] rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 p-4 z-50 animate-in fade-in zoom-in-95 duration-100 select-none">
            
            <!-- Direct Editable Date Input Row -->
            <div class="flex items-center gap-2 mb-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="relative flex-1">
                    <input type="date"
                           value="@Value.ToString("yyyy-MM-dd")"
                           @onchange="OnDirectDateInput"
                           class="w-full h-8 px-2.5 text-xs font-semibold rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all cursor-pointer" />
                </div>
                <button type="button"
                        @onclick="SetToToday"
                        class="h-8 px-3 text-[11px] font-bold rounded-xl bg-teal-50 dark:bg-teal-950/70 text-[#009488] hover:bg-teal-100 dark:hover:bg-teal-900 border border-teal-200 dark:border-teal-800/60 transition-all cursor-pointer shrink-0">
                    Today
                </button>
            </div>

            <!-- Month & Year Navigation Header -->
            <div class="flex items-center justify-between gap-1 mb-2.5">
                <button type="button"
                        @onclick="PreviousMonth"
                        title="Previous Month"
                        class="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-[#009488] dark:hover:text-teal-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <div class="flex items-center gap-1.5">
                    <!-- Month Selector -->
                    <select value="@_viewMonth"
                            @onchange="OnMonthDropdownChanged"
                            class="bg-transparent text-xs font-bold text-slate-800 dark:text-white rounded-lg px-1.5 py-1 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-[#009488] cursor-pointer">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" class="bg-white dark:bg-[#142025] text-slate-800 dark:text-white">
                                @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                            </option>
                        }
                    </select>

                    <!-- Year Selector -->
                    <select value="@_viewYear"
                            @onchange="OnYearDropdownChanged"
                            class="bg-transparent text-xs font-bold text-slate-800 dark:text-white rounded-lg px-1.5 py-1 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-[#009488] cursor-pointer">
                        @for (int y = _viewYear - 5; y <= _viewYear + 5; y++)
                        {
                            <option value="@y" class="bg-white dark:bg-[#142025] text-slate-800 dark:text-white">
                                @y
                            </option>
                        }
                    </select>
                </div>

                <button type="button"
                        @onclick="NextMonth"
                        title="Next Month"
                        class="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-[#009488] dark:hover:text-teal-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Days of Week Header -->
            <div class="grid grid-cols-7 gap-1 text-center mb-1">
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">Mo</span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">Tu</span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">We</span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">Th</span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">Fr</span>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">Sa</span>
                <span class="text-[10px] font-bold text-rose-400/80 uppercase tracking-wider py-1">Su</span>
            </div>

            <!-- 42-Day Calendar Grid (6 full weeks) -->
            <div class="grid grid-cols-7 gap-1 text-center">
                @foreach (var day in CalendarDays)
                {
                    var isCurrentMonth = day.Month == _viewMonth && day.Year == _viewYear;
                    var isSelected = day == Value;
                    var isToday = day == DateOnly.FromDateTime(DateTime.Today);

                    string dayStyle = isSelected
                        ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white font-extrabold shadow-sm rounded-xl"
                        : isToday
                            ? "border border-[#009488] text-[#009488] font-bold rounded-xl hover:bg-teal-50 dark:hover:bg-teal-950/60"
                            : isCurrentMonth
                                ? "text-slate-700 dark:text-slate-200 hover:bg-teal-50 dark:hover:bg-teal-950/60 hover:text-[#00796b] dark:hover:text-teal-300 rounded-xl font-medium"
                                : "text-slate-300 dark:text-slate-600 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl font-normal";

                    <button type="button"
                            @onclick="() => SelectDate(day)"
                            class="h-8 w-8 mx-auto flex items-center justify-center text-xs transition-all cursor-pointer @dayStyle">
                        @day.Day
                    </button>
                }
            </div>

            <!-- Quick Shortcuts Footer -->
            <div class="flex items-center justify-between gap-1.5 mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-1">
                    <button type="button"
                            @onclick="SetToYesterday"
                            class="px-2 py-1 text-[11px] font-medium rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                        Yesterday
                    </button>
                    <button type="button"
                            @onclick="SetToTomorrow"
                            class="px-2 py-1 text-[11px] font-medium rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                        Tomorrow
                    </button>
                </div>

                <button type="button"
                        @onclick="Close"
                        class="px-2.5 py-1 text-[11px] font-semibold text-slate-500 hover:text-slate-800 dark:hover:text-white cursor-pointer">
                    Done
                </button>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public DateOnly Value { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public EventCallback<DateOnly> ValueChanged { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ShowSteppers { get; set; } = true;
    [Parameter] public string Align { get; set; } = "right";
    [Parameter] public bool IsForm { get; set; } = false;

    private bool IsFormMode => IsForm || Class.Contains("w-full");
    private bool _isOpen = false;
    private int _viewMonth;
    private int _viewYear;

    protected override void OnInitialized()
    {
        SyncViewDate();
    }

    protected override void OnParametersSet()
    {
        if (!_isOpen)
        {
            SyncViewDate();
        }
    }

    private void SyncViewDate()
    {
        var target = Value != default ? Value : DateOnly.FromDateTime(DateTime.Today);
        _viewMonth = target.Month;
        _viewYear = target.Year;
    }

    private string FormattedDateText
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var isToday = Value == today;
            return $"{Value:dd MMM yyyy}{(isToday ? " (Today)" : "")}";
        }
    }

    private string DropdownPositionClass
    {
        get
        {
            var horizontal = Align switch
            {
                "left" => "left-0 right-auto",
                "right" => "right-0 left-auto",
                _ => "right-0 left-auto"
            };
            return $"top-full mt-2 {horizontal}";
        }
    }

    private List<DateOnly> CalendarDays
    {
        get
        {
            var firstDay = new DateTime(_viewYear, _viewMonth, 1);
            // Monday start: Sunday=0, Monday=1, ..., Saturday=6
            int dayOfWeek = (int)firstDay.DayOfWeek;
            int offset = (dayOfWeek - 1 + 7) % 7;
            var start = DateOnly.FromDateTime(firstDay.AddDays(-offset));

            var days = new List<DateOnly>(42);
            var curr = start;
            for (int i = 0; i < 42; i++)
            {
                days.Add(curr);
                curr = curr.AddDays(1);
            }
            return days;
        }
    }

    private void ToggleDropdown()
    {
        if (Disabled) return;
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            SyncViewDate();
        }
    }

    private void Close()
    {
        _isOpen = false;
    }

    private async Task SelectDate(DateOnly date)
    {
        Value = date;
        _viewMonth = date.Month;
        _viewYear = date.Year;
        _isOpen = false;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(date);
        }
    }

    private async Task StepPreviousDay()
    {
        if (Disabled) return;
        var newDate = Value.AddDays(-1);
        await SelectDate(newDate);
    }

    private async Task StepNextDay()
    {
        if (Disabled) return;
        var newDate = Value.AddDays(1);
        await SelectDate(newDate);
    }

    private async Task SetToToday()
    {
        await SelectDate(DateOnly.FromDateTime(DateTime.Today));
    }

    private async Task SetToYesterday()
    {
        await SelectDate(DateOnly.FromDateTime(DateTime.Today.AddDays(-1)));
    }

    private async Task SetToTomorrow()
    {
        await SelectDate(DateOnly.FromDateTime(DateTime.Today.AddDays(1)));
    }

    private void PreviousMonth()
    {
        if (_viewMonth == 1)
        {
            _viewMonth = 12;
            _viewYear--;
        }
        else
        {
            _viewMonth--;
        }
    }

    private void NextMonth()
    {
        if (_viewMonth == 12)
        {
            _viewMonth = 1;
            _viewYear++;
        }
        else
        {
            _viewMonth++;
        }
    }

    private void OnMonthDropdownChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 1 && m <= 12)
        {
            _viewMonth = m;
        }
    }

    private void OnYearDropdownChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 1900 && y <= 2100)
        {
            _viewYear = y;
        }
    }

    private async Task OnDirectDateInput(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
        {
            await SelectDate(parsed);
        }
    }
}
