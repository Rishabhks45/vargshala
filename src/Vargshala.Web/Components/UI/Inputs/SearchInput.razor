@implements IDisposable

<div class="relative @WidthClass">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
    </span>

    <input type="text" 
           autocomplete="off"
           value="@Value" 
           @oninput="HandleInputAsync"
           placeholder="@Placeholder" 
           class="w-full pl-9 pr-8 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:shadow-none focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500 @InputClass" />

    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" 
                @onclick="ClearAsync" 
                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public string WidthClass { get; set; } = "w-full";
    [Parameter] public string InputClass { get; set; } = string.Empty;
    [Parameter] public int DebounceMs { get; set; } = 300;

    private CancellationTokenSource? _cts;

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            await Task.Delay(DebounceMs, token);
            if (!token.IsCancellationRequested && OnSearch.HasDelegate)
            {
                await OnSearch.InvokeAsync();
            }
        }
        catch (TaskCanceledException)
        {
            // Keystroke was superseded by next stroke
        }
    }

    private async Task ClearAsync()
    {
        Value = string.Empty;
        await ValueChanged.InvokeAsync(Value);
        _cts?.Cancel();
        if (OnSearch.HasDelegate)
        {
            await OnSearch.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
