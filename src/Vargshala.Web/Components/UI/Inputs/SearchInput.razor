<div class="relative @WidthClass">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
    </span>
    <input type="text" 
           value="@Value" 
           @oninput="HandleInput"
           placeholder="@Placeholder" 
           class="w-full py-2 pl-10 pr-4 text-xs bg-white text-slate-800 rounded-xl shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-300 placeholder-slate-400 border-none transition-all @InputClass" />
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search anything...";
    [Parameter] public string WidthClass { get; set; } = "w-80 lg:w-96";
    [Parameter] public string InputClass { get; set; } = string.Empty;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
