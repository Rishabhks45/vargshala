@page "/settings"
@using Vargshala.Web.Components.UI.Inputs
@rendermode InteractiveServer

<PageTitle>Settings | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Header -->
    <div>
        <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Settings</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage institute profile, academic sessions, branding, and account preferences.</p>
    </div>

    <!-- Settings Tabs -->
    <div class="flex items-center gap-1 border-b border-slate-200 dark:border-slate-800">
        @foreach (var tab in _tabs)
        {
            var currentTab = tab;
            <button type="button" @onclick="() => _activeTab = currentTab"
                    class="px-4 py-2.5 text-xs font-bold transition-all border-b-2 @(_activeTab == currentTab ? "text-[#009488] border-[#009488]" : "text-slate-500 dark:text-slate-400 border-transparent hover:text-slate-700 dark:hover:text-slate-200 hover:border-slate-300") cursor-pointer">
                @currentTab
            </button>
        }
    </div>

    <!-- Institute Profile Tab -->
    @if (_activeTab == "Institute")
    {
        <div class="card-surface p-6 space-y-6">
            <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                <span>Institute Profile</span>
            </div>

            <div class="flex items-start gap-5">
                <div class="w-20 h-20 rounded-2xl bg-teal-50 dark:bg-teal-950/80 border-2 border-dashed border-teal-300 dark:border-teal-800 flex items-center justify-center shrink-0 cursor-pointer hover:bg-teal-100 dark:hover:bg-teal-950 transition-colors">
                    <div class="text-center">
                        <svg class="w-6 h-6 text-[#009488] mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span class="text-[9px] font-bold text-[#009488]">Upload Logo</span>
                    </div>
                </div>
                <div class="flex-1 space-y-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Institute Name</label>
                        <InputText @bind-Value="_instituteName" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-bold transition-all" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Tagline</label>
                        <InputText @bind-Value="_tagline" placeholder="e.g. Excellence in Education Since 2015" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Address</label>
                    <InputText @bind-Value="_address" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Contact Number</label>
                    <InputText @bind-Value="_contactNumber" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Email</label>
                    <InputText @bind-Value="_email" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Website</label>
                    <InputText @bind-Value="_website" placeholder="https://www.vargshala.com" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>
            </div>

            <div class="flex justify-end">
                <button type="button" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    }

    <!-- Academic Sessions Tab -->
    @if (_activeTab == "Sessions")
    {
        <div class="card-surface p-6 space-y-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                    <span>Academic Sessions</span>
                </div>
                <button type="button" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-[#009488] to-[#00796b] text-white shadow-sm border border-teal-400/30 transition-all cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    <span>New Session</span>
                </button>
            </div>

            <div class="space-y-3">
                @foreach (var session in _sessions)
                {
                    <div class="flex items-center justify-between p-4 bg-slate-50/80 dark:bg-[#18262c] rounded-xl border @(session.IsActive ? "border-teal-200 dark:border-teal-800 bg-teal-50/40 dark:bg-teal-950/30" : "border-slate-200 dark:border-slate-700")">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg @(session.IsActive ? "bg-[#009488] text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-500 dark:text-slate-400") flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800 dark:text-white">@session.Name</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500">@session.Duration</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (session.IsActive)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">● Current</span>
                            }
                            else
                            {
                                <button type="button" class="px-3 py-1.5 text-[11px] font-bold text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/50 rounded-lg transition-colors cursor-pointer">Set Active</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Security Tab -->
    @if (_activeTab == "Security")
    {
        <div class="card-surface p-6 space-y-6">
            <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                <span>Account Security</span>
            </div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Current Password</label>
                    <input type="password" class="w-full max-w-md px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" placeholder="••••••••" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-lg">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">New Password</label>
                        <input type="password" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" placeholder="••••••••" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Confirm Password</label>
                        <input type="password" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" placeholder="••••••••" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end">
                <button type="button" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                    <span>Update Password</span>
                </button>
            </div>
        </div>
    }

    <!-- Branding Tab -->
    @if (_activeTab == "Branding")
    {
        <div class="card-surface p-6 space-y-5">
            <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                <span>Branding & Appearance</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="p-4 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200 dark:border-slate-700 space-y-2 text-center">
                    <div class="w-12 h-12 rounded-2xl bg-[#004D40] mx-auto flex items-center justify-center">
                        <span class="text-white text-xs font-bold">Dark</span>
                    </div>
                    <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Deep Teal</p>
                    <p class="text-[10px] text-slate-400">#004D40</p>
                </div>
                <div class="p-4 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200 dark:border-slate-700 space-y-2 text-center">
                    <div class="w-12 h-12 rounded-2xl bg-[#009488] mx-auto flex items-center justify-center">
                        <span class="text-white text-xs font-bold">Primary</span>
                    </div>
                    <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Teal Accent</p>
                    <p class="text-[10px] text-slate-400">#009488</p>
                </div>
                <div class="p-4 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200 dark:border-slate-700 space-y-2 text-center">
                    <div class="w-12 h-12 rounded-2xl bg-[#00796b] mx-auto flex items-center justify-center">
                        <span class="text-white text-xs font-bold">Gradient</span>
                    </div>
                    <p class="text-xs font-bold text-slate-700 dark:text-slate-300">Teal Gradient</p>
                    <p class="text-[10px] text-slate-400">#00796b</p>
                </div>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400">Custom theme colors will be available in a future update. Currently using Theme 4 — Deep Teal.</p>
        </div>
    }
</div>

@code {
    private string _activeTab = "Institute";
    private readonly string[] _tabs = { "Institute", "Sessions", "Security", "Branding" };

    // Institute Profile
    private string _instituteName = "Vidya Mandir Coaching Institute";
    private string _tagline = "Excellence in Education Since 2015";
    private string _address = "Near Clock Tower, MI Road, Jaipur, Rajasthan 302001";
    private string _contactNumber = "+91 98765 43210";
    private string _email = "info@vidyamandir.edu.in";
    private string _website = "https://www.vidyamandir.edu.in";

    // Sessions
    private readonly List<SessionItem> _sessions = new()
    {
        new("Academic Year 2026-27", "April 2026 — March 2027", true),
        new("Academic Year 2025-26", "April 2025 — March 2026", false),
        new("Academic Year 2024-25", "April 2024 — March 2025", false)
    };

    public record SessionItem(string Name, string Duration, bool IsActive);
}
