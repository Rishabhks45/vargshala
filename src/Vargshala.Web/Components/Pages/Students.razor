                    <div>
                        <span class="text-[10px] text-slate-500 block font-medium">Total Fee</span>
                        <span class="font-bold text-slate-800">₹@_feeCollectStudent.TotalFee.ToString("N0")</span>
                    </div>
                    <div class="border-x border-teal-200/60">
                        <span class="text-[10px] text-slate-500 block font-medium">Paid So Far</span>
                        <span class="font-bold text-emerald-600">₹@_feeCollectStudent.PaidFee.ToString("N0")</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-500 block font-medium">Remaining Due</span>
                        <span class="font-bold text-rose-600">₹@_feeCollectStudent.DueFee.ToString("N0")</span>
                    </div>
                </div>

                <!-- Payment Input Form -->
                <div class="space-y-3 pt-1">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700">Payment Amount (₹) *</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 font-bold text-xs">₹</span>
