@if (_selectedProfileStudent != null)
{
    <Modal IsOpen="true" 
           Title="Student Profile" 
           Subtitle="@($"{_selectedProfileStudent.RollNumber} • {_selectedProfileStudent.EnrollmentNumber}")"
           MaxWidth="max-w-md" 
           OnClose="() => _selectedProfileStudent = null">
        <ChildContent>
            <div class="space-y-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-teal-50 border border-teal-200 text-[#00796b] font-black text-lg flex items-center justify-center shadow-xs">
                        @_selectedProfileStudent.Initials
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900">@_selectedProfileStudent.Name</h4>
                        <p class="text-xs text-slate-400 font-medium">Roll: @_selectedProfileStudent.RollNumber • ID: @_selectedProfileStudent.EnrollmentNumber</p>
                        <div class="mt-1">
                            <Badge Text="@_selectedProfileStudent.Status" 
                                   Variant="@(_selectedProfileStudent.Status == "Active" ? Badge.BadgeVariant.Green : Badge.BadgeVariant.Gray)" 
                                   ShowDot="true" />
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 p-3.5 rounded-2xl space-y-2.5 text-xs border border-slate-100">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 font-medium">Batch</span>
                        <span class="font-bold text-slate-800">@_selectedProfileStudent.BatchName</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 font-medium">Contact</span>
                        <span class="font-bold text-slate-800">@_selectedProfileStudent.Phone</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 font-medium">Parent / Guardian</span>
                        <span class="font-bold text-slate-800">@_selectedProfileStudent.ParentName</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 font-medium">Fee Status</span>
                        <Badge Text="@($"{_selectedProfileStudent.FeeStatus} (₹{_selectedProfileStudent.PaidFee:N0} / ₹{_selectedProfileStudent.TotalFee:N0})")"
                               Variant="@(_selectedProfileStudent.FeeStatus == "Paid" ? Badge.BadgeVariant.Green : _selectedProfileStudent.FeeStatus == "Partial" ? Badge.BadgeVariant.Teal : Badge.BadgeVariant.Coral)" />
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" 
                    @onclick="() => OpenFeeModal(_selectedProfileStudent)" 
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                <span>Collect Fee →</span>
            </button>
        </FooterTemplate>
    </Modal>
}

