        new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };

    private readonly List<CustomSelect.CustomSelectOption> _feeStatusFilterOptions = new()
    {
        new("", "All Fee Status"),
        new("Paid", "Paid"),
        new("Partial", "Partial"),
        new("Overdue", "Overdue")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Active", "Active"),
        new("Inactive", "Inactive")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerBatchOptions = new()
    {
        new("Class 10 — Maths", "Class 10 — Maths"),
        new("Class 10 — Science", "Class 10 — Science"),
        new("Class 12 — Physics", "Class 12 — Physics"),
        new("Class 12 — Chemistry", "Class 12 — Chemistry"),
        new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerFeeStatusOptions = new()
    {
        new("Paid", "Paid"),
        new("Partial", "Partial"),
        new("Overdue", "Overdue")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerStatusOptions = new()
    {
        new("Active", "Active"),
        new("Inactive", "Inactive")
    };

    private readonly List<CustomSelect.CustomSelectOption> _paymentModeOptions = new()
    {
        new("UPI / Online (GPay, PhonePe, Paytm)", "UPI / Online (GPay, PhonePe, Paytm)"),
        new("Cash Receipt", "Cash Receipt"),
        new("Bank Transfer (NEFT/IMPS)", "Bank Transfer (NEFT/IMPS)"),
        new("Cheque", "Cheque")
    };

    private Guid? _activeMenuStudentId;
    private bool _showAddEditModal = false;
    private bool _isDrawerOpen = false;
    private StudentDto? _editingStudent;
    private StudentDto _modalModel = new();
    private StudentDto? _selectedProfileStudent;
    private StudentDto? _feeCollectStudent;
    private decimal _feeAmountToCollect = 5000;

    private readonly List<StudentDto> _students = new()
    {
        new() { Name = "Aarav Mehta", EnrollmentNumber = "VM-2026-001", RollNumber = "10A-01", BatchName = "Class 10 — Maths", Phone = "+91 90000 10001", ParentName = "Rohit Mehta", Status = "Active", FeeStatus = "Paid", TotalFee = 25000, PaidFee = 25000 },
        new() { Name = "Isha Agarwal", EnrollmentNumber = "VM-2026-002", RollNumber = "10A-02", BatchName = "Class 10 — Maths", Phone = "+91 90000 10002", ParentName = "Neeraj Agarwal", Status = "Active", FeeStatus = "Partial", TotalFee = 25000, PaidFee = 15000 },
        new() { Name = "Kabir Singh", EnrollmentNumber = "VM-2026-014", RollNumber = "10B-04", BatchName = "Class 10 — Science", Phone = "+91 90000 10003", ParentName = "Jaspal Singh", Status = "Inactive", FeeStatus = "Overdue", TotalFee = 28000, PaidFee = 0 },
        new() { Name = "Ananya Rao", EnrollmentNumber = "VM-2026-021", RollNumber = "10B-07", BatchName = "Class 10 — Science", Phone = "+91 90000 10004", ParentName = "Suresh Rao", Status = "Active", FeeStatus = "Paid", TotalFee = 28000, PaidFee = 28000 },
        new() { Name = "Devansh Jain", EnrollmentNumber = "VM-2026-044", RollNumber = "12P-03", BatchName = "Class 12 — Physics", Phone = "+91 90000 10005", ParentName = "Mahesh Jain", Status = "Active", FeeStatus = "Partial", TotalFee = 32000, PaidFee = 20000 },
        new() { Name = "Ridhima Kaur", EnrollmentNumber = "VM-2026-052", RollNumber = "12C-05", BatchName = "Class 12 — Chemistry", Phone = "+91 90000 10006", ParentName = "Harleen Kaur", Status = "Active", FeeStatus = "Paid", TotalFee = 32000, PaidFee = 32000 },
        new() { Name = "Vivaan Chopra", EnrollmentNumber = "VM-2026-070", RollNumber = "JEE-11", BatchName = "IIT-JEE Morning Batch", Phone = "+91 90000 10007", ParentName = "Amit Chopra", Status = "Active", FeeStatus = "Overdue", TotalFee = 65000, PaidFee = 20000 },
        new() { Name = "Meera Iyer", EnrollmentNumber = "VM-2026-071", RollNumber = "JEE-12", BatchName = "IIT-JEE Morning Batch", Phone = "+91 90000 10008", ParentName = "Ganesh Iyer", Status = "Active", FeeStatus = "Paid", TotalFee = 65000, PaidFee = 65000 }
    };

    private List<StudentDto> FilteredStudents
    {
        get
        {
            var query = _students.Where(s =>
                (string.IsNullOrWhiteSpace(_searchQuery) || 
                 s.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                 s.RollNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                 s.EnrollmentNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Phone.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_selectedBatch) || s.BatchName == _selectedBatch) &&
                (string.IsNullOrWhiteSpace(_selectedFeeStatus) || s.FeeStatus == _selectedFeeStatus) &&
                (string.IsNullOrWhiteSpace(_selectedStatus) || s.Status == _selectedStatus)
            );

            if (_sortDirection != SortDirection.None && !string.IsNullOrEmpty(_sortColumn))
            {
                query = _sortColumn switch
                {
                    "Name" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.Name) : query.OrderByDescending(s => s.Name),
                    "Roll" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.RollNumber) : query.OrderByDescending(s => s.RollNumber),
                    "Batch" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.BatchName) : query.OrderByDescending(s => s.BatchName),
                    "Contact" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.Phone) : query.OrderByDescending(s => s.Phone),
                    "Status" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.Status) : query.OrderByDescending(s => s.Status),
                    "Fees" => _sortDirection == SortDirection.Ascending ? query.OrderBy(s => s.FeeStatus) : query.OrderByDescending(s => s.FeeStatus),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDirection = _sortDirection switch
            {
                SortDirection.None => SortDirection.Ascending,
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None,
                _ => SortDirection.Ascending
            };

            if (_sortDirection == SortDirection.None)
            {
                _sortColumn = null;
            }
        }
        else
        {
            _sortColumn = column;
            _sortDirection = SortDirection.Ascending;
        }
    }

    private void ToggleMenu(Guid studentId)
    {
        _activeMenuStudentId = _activeMenuStudentId == studentId ? null : studentId;
    }

    private async Task OpenAddModalAsync()
    {
        _editingStudent = null;
        _modalModel = new StudentDto
        {
            EnrollmentNumber = $"VM-2026-{(_students.Count + 1):D3}",
            BatchName = "Class 10 — Maths",
            FeeStatus = "Paid",
            Status = "Active"
        };
        _showAddEditModal = true;
        StateHasChanged();
        await Task.Delay(20);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenEditModalAsync(StudentDto student)
    {
        _activeMenuStudentId = null;
        _editingStudent = student;
        _modalModel = new StudentDto
        {
            Id = student.Id,
            Name = student.Name,
            EnrollmentNumber = student.EnrollmentNumber,
            RollNumber = student.RollNumber,
            BatchName = student.BatchName,
            Phone = student.Phone,
            ParentName = student.ParentName,
            Status = student.Status,
            FeeStatus = student.FeeStatus,
            TotalFee = student.TotalFee,
            PaidFee = student.PaidFee
        };
        _showAddEditModal = true;
        StateHasChanged();
        await Task.Delay(20);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showAddEditModal = false;
        _editingStudent = null;
        StateHasChanged();
    }

    private async Task SaveStudentAsync()
    {
        if (string.IsNullOrWhiteSpace(_modalModel.Name)) return;

        if (_editingStudent != null)
        {
            var idx = _students.FindIndex(s => s.Id == _editingStudent.Id);
            if (idx >= 0)
            {
                _students[idx] = _modalModel;
            }
        }
        else
        {
            _students.Insert(0, _modalModel);
        }

        await CloseDrawerAsync();
    }

    private void OpenViewProfile(StudentDto student)
    {
        _activeMenuStudentId = null;
        _selectedProfileStudent = student;
    }

    private void OpenFeeModal(StudentDto student)
    {
        _activeMenuStudentId = null;
        _selectedProfileStudent = null;
        _feeCollectStudent = student;
        _feeAmountToCollect = student.DueFee > 0 ? student.DueFee : 5000;
    }

    private void ProcessFeePayment()
    {
        if (_feeCollectStudent != null)
        {
            _feeCollectStudent.PaidFee += _feeAmountToCollect;
            if (_feeCollectStudent.PaidFee >= _feeCollectStudent.TotalFee)
            {
                _feeCollectStudent.FeeStatus = "Paid";
            }
            else
            {
                _feeCollectStudent.FeeStatus = "Partial";
            }
        }
        _feeCollectStudent = null;
    }

    private void ToggleStudentStatus(StudentDto student)
    {
        student.Status = student.Status == "Active" ? "Inactive" : "Active";
        _activeMenuStudentId = null;
    }

    private void ExportCsv()
    {
        // CSV export action
    }
}
