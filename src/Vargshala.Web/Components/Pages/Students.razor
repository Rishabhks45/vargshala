@page "/students"
@using Vargshala.Contracts.Students
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@rendermode InteractiveServer

<PageTitle>Students Directory | Vargshala</PageTitle>

<div class="space-y-6">
    
    <!-- Top Header & Action Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 tracking-tight">
                Students Directory
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
                Manage enrolled students, batch assignments, contact details, and fee records.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 hover:border-slate-300 transition-all shadow-2xs hover:shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddModalAsync"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </span>
                <span>Add Student</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500">Total Students</p>
                <h3 class="text-lg font-extrabold text-slate-800">1,248</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500">Active Students</p>
                <h3 class="text-lg font-extrabold text-emerald-600">1,180</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500">Fee Overdue</p>
                <h3 class="text-lg font-extrabold text-rose-600">68</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500">New This Month</p>
                <h3 class="text-lg font-extrabold text-amber-600">+42</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <!-- Search Input -->
        <div class="relative flex-1 w-full lg:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </span>
            <input type="text" 
                   @bind="_searchQuery" 
                   @bind:event="oninput"
                   placeholder="Search student by name, roll no, phone..." 
                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all placeholder-slate-400" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" @onclick="() => _searchQuery = string.Empty" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <!-- Filter Dropdowns with 100% Theme 4 Teal Custom Styling (Zero Browser Blue Boxes) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_selectedBatch" Options="_batchFilterOptions" Placeholder="All Batches" />
            <CustomSelect @bind-Value="_selectedFeeStatus" Options="_feeStatusFilterOptions" Placeholder="All Fee Status" />
            <CustomSelect @bind-Value="_selectedStatus" Options="_statusFilterOptions" Placeholder="All Status" />
        </div>
    </div>

    <!-- Students Data Table (Exact Pixel-Matched Layout from Screenshot) -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 text-[11px] font-bold text-slate-400 tracking-wider select-none">
                        <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Student</span>
                                <span class="@GetSortIndicatorClass("Name")">@GetSortIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Roll")'>
                            <div class="flex items-center gap-1.5">
                                <span>Roll</span>
                                <span class="@GetSortIndicatorClass("Roll")">@GetSortIndicator("Roll")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Batch")'>
                            <div class="flex items-center gap-1.5">
                                <span>Batch</span>
                                <span class="@GetSortIndicatorClass("Batch")">@GetSortIndicator("Batch")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Contact")'>
                            <div class="flex items-center gap-1.5">
                                <span>Contact</span>
                                <span class="@GetSortIndicatorClass("Contact")">@GetSortIndicator("Contact")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Status")'>
                            <div class="flex items-center gap-1.5">
                                <span>Status</span>
                                <span class="@GetSortIndicatorClass("Status")">@GetSortIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 transition-colors group" @onclick='() => SortBy("Fees")'>
                            <div class="flex items-center gap-1.5">
                                <span>Fees</span>
                                <span class="@GetSortIndicatorClass("Fees")">@GetSortIndicator("Fees")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    @if (FilteredStudents.Any())
                    {
                        @foreach (var student in FilteredStudents)
                        {
                            <tr class="hover:bg-teal-50/40 transition-colors group">
                                
                                <!-- Student: Initials Avatar + Full Name + ID -->
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-teal-50 border border-teal-200/80 text-[#00796b] font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                                            @student.Initials
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 leading-snug truncate cursor-pointer hover:text-[#009488]"
                                               @onclick="() => OpenViewProfile(student)">
                                                @student.Name
                                            </p>
                                            <p class="text-[10px] text-slate-400 font-medium">
                                                @student.EnrollmentNumber
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Roll Number -->
                                <td class="py-3.5 px-4 font-semibold text-slate-700">
                                    @student.RollNumber
                                </td>

                                <!-- Batch Name Pill -->
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-medium bg-slate-50 border border-slate-200 text-slate-700">
                                        @student.BatchName
                                    </span>
                                </td>

                                <!-- Contact & Parent -->
                                <td class="py-3.5 px-4">
                                    <p class="font-semibold text-slate-800">
                                        @student.Phone
                                    </p>
                                    <p class="text-[10px] text-slate-400">
                                        @student.ParentName
                                    </p>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3.5 px-4">
                                    @if (student.Status == "Active")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Fee Status Badge -->
                                <td class="py-3.5 px-4">
                                    @if (student.FeeStatus == "Paid")
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                            Paid
                                        </span>
                                    }
                                    else if (student.FeeStatus == "Partial")
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200/80">
                                            Partial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200/80">
                                            Overdue
                                        </span>
                                    }
                                </td>

                                <!-- Action Menu (••• Dropdown with View profile, Edit, Collect fee, Deactivate) -->
                                <td class="py-3.5 px-6 text-right relative">
                                    <div class="inline-block text-left">
                                        <button type="button" 
                                                @onclick="() => ToggleMenu(student.Id)" 
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors">
                                            <svg class="w-4 h-4 font-extrabold" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M6 10a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4z"/>
                                            </svg>
                                        </button>

                                        @if (_activeMenuStudentId == student.Id)
                                        {
                                            <div class="fixed inset-0 z-30" @onclick="() => _activeMenuStudentId = null"></div>
                                            <div class="absolute right-0 top-full mt-1 w-44 rounded-2xl bg-white shadow-2xl shadow-slate-900/15 border border-slate-200/90 py-2 z-40 text-left animate-in fade-in zoom-in-95 duration-150 select-none">
                                                <button type="button" 
                                                        @onclick="() => OpenViewProfile(student)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-950 hover:bg-slate-50 flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                                    <span>View profile</span>
                                                </button>
                                                <button type="button" 
                                                        @onclick="() => OpenEditModalAsync(student)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-950 hover:bg-slate-50 flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                    <span>Edit</span>
                                                </button>
                                                <button type="button" 
                                                        @onclick="() => OpenFeeModal(student)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-950 hover:bg-slate-50 flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                                    <span>Collect fee</span>
                                                </button>
                                                <div class="my-1.5 border-t border-slate-100"></div>
                                                <button type="button" 
                                                        @onclick="() => ToggleStudentStatus(student)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50/80 flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                                                    <span>@(student.Status == "Active" ? "Deactivate" : "Activate")</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 text-sm">No students found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination -->
        <div class="p-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
            <div>
                Showing <span class="font-bold text-slate-800">1-@FilteredStudents.Count</span> of <span class="font-bold text-slate-800">@_students.Count</span> students
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button" class="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-400 hover:bg-slate-50 disabled:opacity-40" disabled>
                    Previous
                </button>
                <button type="button" class="w-8 h-8 rounded-lg bg-[#009488] text-white font-bold flex items-center justify-center">
                    1
                </button>
                <button type="button" class="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-50">
                    Next
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Add / Edit Student Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showAddEditModal)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Side-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white shadow-2xl flex flex-col justify-between border-l border-teal-800/80 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient & Golden/Teal Badge -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/plant-books.png" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingStudent == null ? "New Student Admission" : "Edit Student Profile")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingStudent == null ? "Enroll a new student to coaching batch" : $"Updating records for {_editingStudent.Name}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Scrollable Form Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-5 select-text">
            
            <!-- Section 1: Basic Information -->
            <div class="space-y-3">
                <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] uppercase tracking-wider">
                    <span>1. Basic Information</span>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700">Full Name *</label>
                    <input type="text" @bind="_modalModel.Name" placeholder="e.g. Aarav Mehta" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700">Roll Number *</label>
                        <input type="text" @bind="_modalModel.RollNumber" placeholder="e.g. 10A-01" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700">Enrollment ID</label>
                        <input type="text" @bind="_modalModel.EnrollmentNumber" placeholder="e.g. VM-2026-001" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all" />
                    </div>
                </div>
            </div>

            <!-- Section 2: Batch & Academic Details -->
            <div class="space-y-3 pt-2 border-t border-slate-100">
