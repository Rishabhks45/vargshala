                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700">Payment Mode *</label>
                        <CustomSelect @bind-Value="_selectedPaymentMode" Options="_paymentModeOptions" Placeholder="Select Payment Mode" Class="w-full" />
                    </div>
                </div>

            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" 
                    @onclick="() => _feeCollectStudent = null" 
                    class="px-4 py-2.5 text-xs font-bold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 hover:bg-slate-100 rounded-xl transition-all cursor-pointer">
                Cancel
            </button>
            <button type="button" 
                    @onclick="ProcessFeePayment" 
                    class="inline-flex items-center gap-1.5 px-6 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Confirm & Generate Receipt</span>
            </button>
        </FooterTemplate>
    </Modal>
}

@code {
    private string _searchQuery = string.Empty;
    private string _selectedBatch = string.Empty;
    private string _selectedFeeStatus = string.Empty;
    private string _selectedStatus = string.Empty;
    private string _selectedPaymentMode = "UPI / Online (GPay, PhonePe, Paytm)";
    public enum SortDirection { None, Ascending, Descending }
    private string? _sortColumn = null;
    private SortDirection _sortDirection = SortDirection.None;

    private string GetSortIndicator(string column)
    {
        if (_sortColumn != column || _sortDirection == SortDirection.None)
            return "↕";
        return _sortDirection == SortDirection.Ascending ? "▲" : "▼";
    }

    private string GetSortIndicatorClass(string column)
    {
        if (_sortColumn == column && _sortDirection != SortDirection.None)
            return "text-[#009488] font-bold text-[11px]";
        return "text-slate-300 group-hover:text-slate-400 text-[10px]";
    }

    private readonly List<CustomSelect.CustomSelectOption> _batchFilterOptions = new()
