                            <p class="font-bold text-slate-900 text-xs leading-snug">@_feeCollectStudent.Name</p>
                            <p class="text-[11px] text-slate-400 font-medium">Roll: @_feeCollectStudent.RollNumber • @_feeCollectStudent.BatchName</p>
