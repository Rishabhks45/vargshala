@page "/batches"
@using Vargshala.Contracts.Batches
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Validation
@rendermode InteractiveServer

<PageTitle>Classes & Batches | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header & Action Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                Classes & Batches
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Manage batches, student enrollment, teacher assignment, and class capacity.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <!-- Toggle View: Grid / List -->
            <div class="inline-flex rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] overflow-hidden shadow-2xs">
                <button type="button" @onclick='() => _viewMode = "grid"'
                        class="px-3 py-2 text-xs font-bold transition-all @(_viewMode == "grid" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </button>
                <button type="button" @onclick='() => _viewMode = "list"'
                        class="px-3 py-2 text-xs font-bold transition-all @(_viewMode == "list" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>

            <button type="button"
                    @onclick="OpenAddModal"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </span>
                <span>Create Batch</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Batches</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_batches.Count</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Active Batches</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_batches.Count(b => b.Status == "Active")</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Enrolled</p>
                <h3 class="text-lg font-extrabold text-blue-600 dark:text-blue-400">@_batches.Sum(b => b.StudentCount)</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Avg Occupancy</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">@(_batches.Count > 0 ? Math.Round(_batches.Average(b => b.OccupancyPercent), 0) : 0)%</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <div class="relative flex-1 w-full lg:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input type="text"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   placeholder="Search batch by name, grade, teacher..."
                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" @onclick="() => _searchQuery = string.Empty" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_selectedGrade" Options="_gradeFilterOptions" Placeholder="All Grades" />
            <CustomSelect @bind-Value="_selectedStatus" Options="_statusFilterOptions" Placeholder="All Status" />
        </div>
    </div>

    <!-- GRID VIEW -->
    @if (_viewMode == "grid")
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var batch in FilteredBatches)
            {
                <div class="card-surface p-5 space-y-4 hover:shadow-md transition-all duration-200 group border border-tealborder cursor-pointer" @onclick="() => OpenBatchDetail(batch)">
                    <!-- Header: Initials + Name + Status -->
                    <div class="flex items-start justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#009488] to-[#00796b] text-white font-bold text-sm flex items-center justify-center shadow-md shadow-teal-900/20 shrink-0">
                                @batch.Initials
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug truncate group-hover:text-[#009488] transition-colors">
                                    @batch.Name
                                </h3>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500 font-medium">@batch.Grade • @batch.AcademicSession</p>
                            </div>
                        </div>
                        @if (batch.Status == "Active")
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">Active</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">Archived</span>
                        }
                    </div>

                    <!-- Metrics Row -->
                    <div class="grid grid-cols-3 gap-2 p-3 bg-slate-50/80 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800 text-center">
                        <div>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Students</p>
                            <p class="font-extrabold text-slate-800 dark:text-white text-sm">@batch.StudentCount</p>
                        </div>
                        <div class="border-x border-slate-200/80 dark:border-slate-700">
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Capacity</p>
                            <p class="font-extrabold text-slate-800 dark:text-white text-sm">@batch.MaxCapacity</p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Occupancy</p>
                            <p class="font-extrabold @(batch.OccupancyPercent >= 90 ? "text-rose-600 dark:text-rose-400" : batch.OccupancyPercent >= 70 ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400") text-sm">@batch.OccupancyPercent%</p>
                        </div>
                    </div>

                    <!-- Occupancy Progress Bar -->
                    <div class="space-y-1">
                        <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-500 @(batch.OccupancyPercent >= 90 ? "bg-rose-500" : batch.OccupancyPercent >= 70 ? "bg-amber-500" : "bg-[#009488]")"
                                 style="width: @(batch.OccupancyPercent)%"></div>
                        </div>
                    </div>

                    <!-- Teacher & Room Info -->
                    <div class="flex items-center justify-between text-[11px]">
                        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="font-semibold text-slate-700 dark:text-slate-300 truncate max-w-[120px]">@batch.PrimaryTeacher</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span class="truncate max-w-[100px]">@batch.RoomOrTiming</span>
                        </div>
                    </div>
                </div>
            }

            @if (!FilteredBatches.Any())
            {
                <div class="col-span-full card-surface p-12 text-center">
                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"/></svg>
                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No batches found</p>
                    <p class="text-xs text-slate-400 mt-1">Try changing your search query or filter options.</p>
                </div>
            }
        </div>
    }

    <!-- LIST VIEW -->
    @if (_viewMode == "list")
    {
        <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[680px] text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                            <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Name")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Batch</span>
                                    <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                                </div>
                            </th>
                            <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Grade")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Grade</span>
                                    <span class="@_sortState.GetIndicatorClass("Grade")">@_sortState.GetIndicator("Grade")</span>
                                </div>
                            </th>
                            <th class="py-3.5 px-4">Teacher</th>
                            <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Students")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Students</span>
                                    <span class="@_sortState.GetIndicatorClass("Students")">@_sortState.GetIndicator("Students")</span>
                                </div>
                            </th>
                            <th class="py-3.5 px-4">Occupancy</th>
                            <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Status")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Status</span>
                                    <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                        @foreach (var batch in FilteredBatches)
                        {
                            <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors cursor-pointer" @onclick="() => OpenBatchDetail(batch)">
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#009488] to-[#00796b] text-white font-bold text-[10px] flex items-center justify-center shadow-xs shrink-0">@batch.Initials</div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 dark:text-white truncate">@batch.Name</p>
                                            <p class="text-[10px] text-slate-400 dark:text-slate-500">@batch.AcademicSession • @batch.RoomOrTiming</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300">@batch.Grade</span>
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-slate-700 dark:text-slate-300">@batch.PrimaryTeacher</td>
                                <td class="py-3.5 px-4 font-extrabold text-slate-800 dark:text-white">@batch.StudentCount / @batch.MaxCapacity</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        <div class="w-16 h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                            <div class="h-full rounded-full @(batch.OccupancyPercent >= 90 ? "bg-rose-500" : batch.OccupancyPercent >= 70 ? "bg-amber-500" : "bg-[#009488]")"
                                                 style="width: @(batch.OccupancyPercent)%"></div>
                                        </div>
                                        <span class="font-bold text-[11px] @(batch.OccupancyPercent >= 90 ? "text-rose-600 dark:text-rose-400" : "text-slate-600 dark:text-slate-400")">@batch.OccupancyPercent%</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (batch.Status == "Active")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">Active</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">Archived</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- MODAL: Create / Edit Batch -->
<!-- ========================================================================= -->
@if (_showBatchModal)
{
    <Modal IsOpen="true"
           Title="@(_editingBatch == null ? "Create New Batch" : "Edit Batch")"
           Subtitle="@(_editingBatch == null ? "Configure a new class batch" : $"Editing {_editingBatch.Name}")"
           MaxWidth="max-w-md"
           OnClose="() => _showBatchModal = false">
        <ChildContent>
            <EditForm Model="@_batchModel" OnValidSubmit="SaveBatch">
                <div class="space-y-4">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Batch Name *</label>
                        <InputText @bind-Value="_batchModel.Name" placeholder="e.g. Class 10 — Science Morning" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Grade *</label>
                            <CustomSelect @bind-Value="_batchModel.Grade" Options="_gradeOptions" Placeholder="Select Grade" Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Academic Session</label>
                            <CustomSelect @bind-Value="_batchModel.AcademicSession" Options="_sessionOptions" Placeholder="Session" Class="w-full" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Primary Teacher</label>
                        <CustomSelect @bind-Value="_batchModel.PrimaryTeacher" Options="_teacherOptions" Placeholder="Assign Teacher" Class="w-full" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Max Capacity</label>
                            <InputNumber @bind-Value="_batchModel.MaxCapacity" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none font-bold text-slate-800 dark:text-white" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Status</label>
                            <CustomSelect @bind-Value="_batchModel.Status" Options="_batchStatusOptions" Placeholder="Status" Class="w-full" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Room / Timing</label>
                        <InputText @bind-Value="_batchModel.RoomOrTiming" placeholder="e.g. Room A1, 8:00 AM - 10:00 AM" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>

                    <div class="pt-2 flex items-center justify-end gap-3">
                        <button type="button" @onclick="() => _showBatchModal = false"
                                class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-all cursor-pointer">Cancel</button>
                        <button type="submit"
                                class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span>@(_editingBatch == null ? "Create Batch" : "Update Batch")</span>
                        </button>
                    </div>
                </div>
            </EditForm>
        </ChildContent>
    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL: Batch Detail View -->
<!-- ========================================================================= -->
@if (_detailBatch != null)
{
    <Modal IsOpen="true"
           Title="@_detailBatch.Name"
           Subtitle="@($"{_detailBatch.Grade} • {_detailBatch.AcademicSession}")"
           MaxWidth="max-w-md"
           OnClose="() => _detailBatch = null">
        <ChildContent>
            <div class="space-y-4">
                <div class="grid grid-cols-3 gap-2 p-3 bg-teal-50/60 dark:bg-teal-950/40 rounded-xl border border-teal-100/80 dark:border-teal-900/60 text-center text-xs">
                    <div>
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium">Students</span>
                        <span class="font-extrabold text-slate-800 dark:text-slate-200">@_detailBatch.StudentCount</span>
                    </div>
                    <div class="border-x border-teal-200/60 dark:border-teal-900/60">
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium">Capacity</span>
                        <span class="font-extrabold text-slate-800 dark:text-slate-200">@_detailBatch.MaxCapacity</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-medium">Occupancy</span>
                        <span class="font-extrabold @(_detailBatch.OccupancyPercent >= 90 ? "text-rose-600" : "text-emerald-600")">@_detailBatch.OccupancyPercent%</span>
                    </div>
                </div>

                <div class="bg-slate-50 dark:bg-[#18262c] p-3.5 rounded-2xl space-y-2.5 text-xs border border-slate-100 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Primary Teacher</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_detailBatch.PrimaryTeacher</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Room / Timing</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_detailBatch.RoomOrTiming</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Status</span>
                        <Badge Text="@_detailBatch.Status"
                               Variant="@(_detailBatch.Status == "Active" ? Badge.BadgeVariant.Green : Badge.BadgeVariant.Gray)"
                               ShowDot="true" />
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button"
                    @onclick="() => { var b = _detailBatch; _detailBatch = null; OpenEditModal(b); }"
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                <span>Edit Batch →</span>
            </button>
        </FooterTemplate>
    </Modal>
}

