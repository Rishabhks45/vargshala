        new("2025-26", "2025-26")
    };

    private readonly List<CustomSelect.CustomSelectOption> _teacherOptions = new()
    {
        new("Dr. Priya Sharma", "Dr. Priya Sharma"),
        new("Rajesh Verma", "Rajesh Verma"),
        new("Sunita Gupta", "Sunita Gupta"),
        new("Amit Tiwari", "Amit Tiwari"),
        new("Dr. Kavita Reddy", "Dr. Kavita Reddy"),
        new("Neha Agarwal", "Neha Agarwal")
    };

    private readonly List<CustomSelect.CustomSelectOption> _batchStatusOptions = new()
    {
        new("Active", "Active"),
        new("Archived", "Archived")
    };

    // State
    private bool _showBatchModal = false;
    private BatchDto? _editingBatch;
    private BatchDto _batchModel = new();
    private BatchDto? _detailBatch;

    // Mock Data
    private readonly List<BatchDto> _batches = new()
    {
        new() { Name = "Class 10 — Maths", Grade = "Class 10", AcademicSession = "2026-27", RoomOrTiming = "Room A1, 8 AM", PrimaryTeacher = "Dr. Priya Sharma", StudentCount = 42, MaxCapacity = 50 },
        new() { Name = "Class 10 — Science", Grade = "Class 10", AcademicSession = "2026-27", RoomOrTiming = "Room A2, 10 AM", PrimaryTeacher = "Amit Tiwari", StudentCount = 38, MaxCapacity = 50 },
        new() { Name = "Class 12 — Physics", Grade = "Class 12", AcademicSession = "2026-27", RoomOrTiming = "Room B1, 8 AM", PrimaryTeacher = "Rajesh Verma", StudentCount = 35, MaxCapacity = 40 },
        new() { Name = "Class 12 — Chemistry", Grade = "Class 12", AcademicSession = "2026-27", RoomOrTiming = "Room B2, 10 AM", PrimaryTeacher = "Sunita Gupta", StudentCount = 30, MaxCapacity = 40 },
        new() { Name = "Class 12 — Biology", Grade = "Class 12", AcademicSession = "2026-27", RoomOrTiming = "Room B3, 12 PM", PrimaryTeacher = "Dr. Kavita Reddy", StudentCount = 28, MaxCapacity = 35 },
        new() { Name = "IIT-JEE Morning Batch", Grade = "Competitive", AcademicSession = "2026-27", RoomOrTiming = "Hall 1, 6 AM", PrimaryTeacher = "Dr. Priya Sharma", StudentCount = 55, MaxCapacity = 60 },
        new() { Name = "NEET Evening Batch", Grade = "Competitive", AcademicSession = "2026-27", RoomOrTiming = "Hall 2, 4 PM", PrimaryTeacher = "Dr. Kavita Reddy", StudentCount = 48, MaxCapacity = 50 },
        new() { Name = "Class 11 — Foundation", Grade = "Class 11", AcademicSession = "2025-26", RoomOrTiming = "Room C1, 2 PM", PrimaryTeacher = "Neha Agarwal", StudentCount = 20, MaxCapacity = 45, Status = "Archived" }
    };

    private List<BatchDto> FilteredBatches
    {
        get
        {
            var query = _batches.Where(b =>
                (string.IsNullOrWhiteSpace(_searchQuery) ||
                 b.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 b.Grade.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 b.PrimaryTeacher.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_selectedGrade) || b.Grade == _selectedGrade) &&
                (string.IsNullOrWhiteSpace(_selectedStatus) || b.Status == _selectedStatus)
            );

            if (_sortState.IsSorted)
            {
                query = _sortState.Column switch
                {
                    "Name" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(b => b.Name) : query.OrderByDescending(b => b.Name),
                    "Grade" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(b => b.Grade) : query.OrderByDescending(b => b.Grade),
                    "Students" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(b => b.StudentCount) : query.OrderByDescending(b => b.StudentCount),
                    "Status" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(b => b.Status) : query.OrderByDescending(b => b.Status),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private void OpenAddModal()
    {
        _editingBatch = null;
        _batchModel = new BatchDto { Status = "Active", AcademicSession = "2026-27", MaxCapacity = 50 };
        _showBatchModal = true;
    }

    private void OpenEditModal(BatchDto batch)
    {
        _editingBatch = batch;
        _batchModel = new BatchDto
        {
            Id = batch.Id, Name = batch.Name, Grade = batch.Grade, AcademicSession = batch.AcademicSession,
            RoomOrTiming = batch.RoomOrTiming, PrimaryTeacher = batch.PrimaryTeacher, StudentCount = batch.StudentCount,
            MaxCapacity = batch.MaxCapacity, Status = batch.Status
        };
        _showBatchModal = true;
    }

    private void SaveBatch()
    {
        if (_editingBatch == null)
        {
            _batchModel.Id = Guid.NewGuid();
            _batches.Insert(0, _batchModel);
        }
        else
        {
            var index = _batches.FindIndex(b => b.Id == _editingBatch.Id);
            if (index != -1)
            {
                _batchModel.StudentCount = _editingBatch.StudentCount;
                _batches[index] = _batchModel;
            }
        }
        _showBatchModal = false;
    }

    private void OpenBatchDetail(BatchDto batch)
    {
        _detailBatch = batch;
    }
}
