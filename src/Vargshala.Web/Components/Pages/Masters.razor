@page "/masters"
@using Vargshala.Contracts.Masters
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Badges
@rendermode InteractiveServer

<PageTitle>Master Configuration | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                Master Data Setup
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Configure branches, academic subjects, faculty assignments, and bell schedules.
            </p>
        </div>

        <div>
            @if (_activeTab == "Branches")
            {
                <button type="button" @onclick="OpenAddBranchModal"
                        class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                    <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    </span>
                    <span>Add Branch</span>
                </button>
            }
            else if (_activeTab == "Subjects")
            {
                <button type="button" @onclick="OpenAddSubjectModal"
                        class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                    <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    </span>
                    <span>Add Subject</span>
                </button>
            }
            else if (_activeTab == "FacultyAssignment")
            {
                <button type="button" @onclick="OpenAddAssignmentModal"
                        class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                    <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    </span>
                    <span>Assign Faculty</span>
                </button>
            }
            else if (_activeTab == "PeriodTimings")
            {
                <button type="button" @onclick="OpenAddPeriodModal"
                        class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                    <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    </span>
                    <span>Add Period Slot</span>
                </button>
            }
        </div>
    </div>

    <!-- Master Tabs Header (4 Tabs) -->
    <div class="card-surface p-1.5 flex items-center gap-1.5 border border-slate-200/80 dark:border-slate-800 shadow-2xs overflow-x-auto">
        <button type="button" @onclick='() => _activeTab = "Branches"'
                class="flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer @(_activeTab == "Branches" ? "bg-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <span>Branches</span>
            <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full @(_activeTab == "Branches" ? "bg-white/20 text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300")">@_branches.Count</span>
        </button>

        <button type="button" @onclick='() => _activeTab = "Subjects"'
                class="flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer @(_activeTab == "Subjects" ? "bg-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            <span>Subjects</span>
            <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full @(_activeTab == "Subjects" ? "bg-white/20 text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300")">@_subjects.Count</span>
        </button>

        <button type="button" @onclick='() => _activeTab = "FacultyAssignment"'
                class="flex-1 min-w-[180px] px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer @(_activeTab == "FacultyAssignment" ? "bg-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Assign to Faculty</span>
            <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full @(_activeTab == "FacultyAssignment" ? "bg-white/20 text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300")">@_assignments.Count</span>
        </button>

        <button type="button" @onclick='() => _activeTab = "PeriodTimings"'
                class="flex-1 min-w-[150px] px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer @(_activeTab == "PeriodTimings" ? "bg-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Period Timings</span>
            <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full @(_activeTab == "PeriodTimings" ? "bg-white/20 text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300")">@_periods.Count</span>
        </button>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: BRANCHES -->
    <!-- ========================================================================= -->
    @if (_activeTab == "Branches")
    {
        <div class="space-y-4">
            <!-- Search & Count -->
            <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <div class="relative flex-1 max-w-md">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" @bind="_searchBranch" @bind:event="oninput" placeholder="Search branch by name, code, or city..."
                           class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white" />
                </div>
                <div class="text-xs text-slate-500 font-medium">
                    Total Branches: <span class="font-bold text-slate-800 dark:text-white">@FilteredBranches.Count</span>
                </div>
            </div>

            <!-- Branches Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var branch in FilteredBranches)
                {
                    <div class="card-surface p-5 space-y-3.5 border border-tealborder hover:shadow-md transition-all">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 text-[#00796b] dark:text-teal-300 font-bold text-xs flex items-center justify-center shrink-0 border border-teal-200 dark:border-teal-800">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">@branch.Name</h3>
                                    <span class="text-[10px] font-semibold text-[#009488]">@branch.Code</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                @branch.Status
                            </span>
                        </div>

                        <p class="text-xs text-slate-500 dark:text-slate-400 flex items-start gap-1.5">
                            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                            <span>@branch.Address</span>
                        </p>

                        <div class="grid grid-cols-2 gap-2 p-2.5 bg-slate-50 dark:bg-[#18262c] rounded-xl text-center text-xs border border-slate-100 dark:border-slate-800">
                            <div>
                                <span class="text-[10px] text-slate-400 block font-medium">Active Batches</span>
                                <span class="font-extrabold text-slate-800 dark:text-white">@branch.ActiveBatchesCount</span>
                            </div>
                            <div class="border-l border-slate-200 dark:border-slate-700">
                                <span class="text-[10px] text-slate-400 block font-medium">Students</span>
                                <span class="font-extrabold text-emerald-600 dark:text-emerald-400">@branch.TotalStudentsCount</span>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-500">
                            <span>Head: <strong class="text-slate-700 dark:text-slate-300 font-semibold">@branch.ContactPerson</strong></span>
                            <span>@branch.Phone</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: SUBJECTS -->
    <!-- ========================================================================= -->
    @if (_activeTab == "Subjects")
    {
        <div class="space-y-4">
            <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <div class="relative flex-1 max-w-md">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" @bind="_searchSubject" @bind:event="oninput" placeholder="Search subject by name or code..."
                           class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white" />
                </div>
                <div class="flex items-center gap-2.5">
                    <CustomSelect @bind-Value="_filterStream" Options="_streamFilterOptions" Placeholder="All Streams" />
                </div>
            </div>

            <!-- Subjects Table -->
            <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[650px] text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                                <th class="py-3.5 px-6">Subject Code</th>
                                <th class="py-3.5 px-4">Subject Name</th>
                                <th class="py-3.5 px-4">Grade Level</th>
                                <th class="py-3.5 px-4">Stream</th>
                                <th class="py-3.5 px-4">Weekly Hours</th>
                                <th class="py-3.5 px-4">Assigned Teachers</th>
                                <th class="py-3.5 px-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                            @foreach (var subject in FilteredSubjects)
                            {
                                <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors">
                                    <td class="py-3.5 px-6 font-mono font-bold text-[#009488]">@subject.Code</td>
                                    <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">@subject.Name</td>
                                    <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300">@subject.GradeLevel</td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800 text-blue-700 dark:text-blue-300">
                                            @subject.Stream
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800 dark:text-white">@subject.WeeklyHours hrs/wk</td>
                                    <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">@subject.TotalFacultyAssigned teachers</td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            @subject.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: ASSIGN SUBJECTS TO FACULTY -->
    <!-- ========================================================================= -->
    @if (_activeTab == "FacultyAssignment")
    {
        <div class="space-y-4">
            <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <div class="relative flex-1 max-w-md">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" @bind="_searchFaculty" @bind:event="oninput" placeholder="Search by faculty, subject, or batch..."
                           class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white" />
                </div>
                <div class="text-xs text-slate-500 font-medium">
                    Total Mappings: <span class="font-bold text-slate-800 dark:text-white">@FilteredAssignments.Count</span>
                </div>
            </div>

            <!-- Faculty Assignment Table -->
            <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[720px] text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                                <th class="py-3.5 px-6">Faculty Member</th>
                                <th class="py-3.5 px-4">Subject</th>
                                <th class="py-3.5 px-4">Branch</th>
                                <th class="py-3.5 px-4">Assigned Batch</th>
                                <th class="py-3.5 px-4">Hours / Wk</th>
                                <th class="py-3.5 px-4">Role</th>
                                <th class="py-3.5 px-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                            @foreach (var item in FilteredAssignments)
                            {
                                <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors">
                                    <td class="py-3.5 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold text-[10px] flex items-center justify-center shrink-0">
                                                @item.FacultyInitials
                                            </div>
                                            <span class="font-bold text-slate-900 dark:text-white">@item.FacultyName</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                                            @item.SubjectName
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300 font-medium">@item.BranchName</td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400">
                                            @item.BatchName
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800 dark:text-white">@item.HoursPerWeek hrs</td>
                                    <td class="py-3.5 px-4">
                                        @if (item.IsPrimary)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                                ★ Primary
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                                Support
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- TAB 4: PERIOD TIMINGS -->
    <!-- ========================================================================= -->
    @if (_activeTab == "PeriodTimings")
    {
        <div class="space-y-4">
            <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <!-- Shift Toggle -->
                <div class="inline-flex rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] overflow-hidden shadow-2xs">
                    <button type="button" @onclick='() => _selectedShift = "Morning Shift"'
                            class="px-4 py-2 text-xs font-bold transition-all @(_selectedShift == "Morning Shift" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")">
                        🌅 Morning Shift (08:00 AM – 02:00 PM)
                    </button>
                    <button type="button" @onclick='() => _selectedShift = "Evening Shift"'
                            class="px-4 py-2 text-xs font-bold transition-all @(_selectedShift == "Evening Shift" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")">
                        🌆 Evening Shift (03:00 PM – 08:30 PM)
                    </button>
                </div>

                <div class="text-xs text-slate-500 font-medium">
                    Total Periods: <span class="font-bold text-slate-800 dark:text-white">@FilteredPeriods.Count</span> slots
                </div>
            </div>

            <!-- Period Timetable List -->
            <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[650px] text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                                <th class="py-3.5 px-6 w-16">Slot</th>
                                <th class="py-3.5 px-4">Period Name</th>
                                <th class="py-3.5 px-4">Start Time</th>
                                <th class="py-3.5 px-4">End Time</th>
                                <th class="py-3.5 px-4">Duration</th>
                                <th class="py-3.5 px-4">Branch</th>
                                <th class="py-3.5 px-4">Type</th>
                                <th class="py-3.5 px-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                            @foreach (var period in FilteredPeriods)
                            {
                                <tr class="@(period.IsBreak ? "bg-amber-50/40 dark:bg-amber-950/20" : "hover:bg-teal-50/40 dark:hover:bg-teal-950/30") transition-colors">
                                    <td class="py-3.5 px-6 font-bold text-slate-500 dark:text-slate-400">#@period.PeriodNumber</td>
                                    <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                        @if (period.IsBreak)
                                        {
                                            <span class="text-amber-500 font-bold">☕</span>
                                        }
                                        <span>@period.PeriodName</span>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono font-bold text-[#00796b] dark:text-teal-300">@period.StartTime</td>
                                    <td class="py-3.5 px-4 font-mono font-bold text-[#00796b] dark:text-teal-300">@period.EndTime</td>
                                    <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300">@period.DurationMinutes min</td>
                                    <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400">@period.BranchName</td>
                                    <td class="py-3.5 px-4">
                                        @if (period.IsBreak)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 dark:bg-amber-950/70 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300">
                                                Recess / Break
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 dark:bg-teal-950/70 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                                                Lecture
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            @period.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

