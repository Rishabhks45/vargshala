    // Filtered lists
    private List<BranchDto> FilteredBranches => _branches.Where(b =>
        string.IsNullOrWhiteSpace(_searchBranch) ||
        b.Name.Contains(_searchBranch, StringComparison.OrdinalIgnoreCase) ||
        b.Code.Contains(_searchBranch, StringComparison.OrdinalIgnoreCase) ||
        b.Address.Contains(_searchBranch, StringComparison.OrdinalIgnoreCase)
    ).ToList();

    private List<SubjectDto> FilteredSubjects => _subjects.Where(s =>
        (string.IsNullOrWhiteSpace(_searchSubject) || s.Name.Contains(_searchSubject, StringComparison.OrdinalIgnoreCase) || s.Code.Contains(_searchSubject, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterStream) || s.Stream == _filterStream)
    ).ToList();

    private List<FacultySubjectAssignmentDto> FilteredAssignments => _assignments.Where(a =>
        string.IsNullOrWhiteSpace(_searchFaculty) ||
        a.FacultyName.Contains(_searchFaculty, StringComparison.OrdinalIgnoreCase) ||
        a.SubjectName.Contains(_searchFaculty, StringComparison.OrdinalIgnoreCase) ||
        a.BatchName.Contains(_searchFaculty, StringComparison.OrdinalIgnoreCase)
    ).ToList();

    private List<PeriodTimingDto> FilteredPeriods => _periods.Where(p => p.Shift == _selectedShift).ToList();

    // Modal Triggers
    private void OpenAddBranchModal()
    {
        _newBranch = new BranchDto { Status = "Active" };
        _showAddBranchModal = true;
    }

    private void SaveBranch()
    {
        if (string.IsNullOrWhiteSpace(_newBranch.Name)) return;
        _newBranch.Id = Guid.NewGuid();
        _branches.Add(_newBranch);
        _showAddBranchModal = false;
    }

    private void OpenAddSubjectModal()
    {
        _newSubject = new SubjectDto { Status = "Active", Stream = "Science", WeeklyHours = 6 };
        _showAddSubjectModal = true;
    }

    private void SaveSubject()
    {
        if (string.IsNullOrWhiteSpace(_newSubject.Name)) return;
        _newSubject.Id = Guid.NewGuid();
        _subjects.Add(_newSubject);
        _showAddSubjectModal = false;
    }

    private void OpenAddAssignmentModal()
    {
        _newAssignment = new FacultySubjectAssignmentDto
        {
            FacultyName = "Dr. Priya Sharma",
            BranchName = "Main Campus — Malviya Nagar",
            SubjectName = "Mathematics",
            BatchName = "Class 10 — Maths",
            HoursPerWeek = 5,
            IsPrimary = true
        };
        _showAddAssignmentModal = true;
    }

    private void SaveAssignment()
    {
        if (string.IsNullOrWhiteSpace(_newAssignment.FacultyName)) return;
        _newAssignment.Id = Guid.NewGuid();
        _assignments.Add(_newAssignment);
        _showAddAssignmentModal = false;
    }

    private void OpenAddPeriodModal()
    {
        _newPeriod = new PeriodTimingDto
        {
            PeriodNumber = FilteredPeriods.Count + 1,
            Shift = _selectedShift,
            DurationMinutes = 50,
            BranchName = "All Branches",
            Status = "Active"
        };
        _showAddPeriodModal = true;
    }

    private void SavePeriod()
    {
        if (string.IsNullOrWhiteSpace(_newPeriod.PeriodName)) return;
        _newPeriod.Id = Guid.NewGuid();
        _periods.Add(_newPeriod);
        _showAddPeriodModal = false;
    }
