                        <input type="text" @bind="_newPeriod.PeriodName" placeholder="e.g. Period 5 or Lunch Break"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Start Time</label>
                        <input type="text" @bind="_newPeriod.StartTime" placeholder="08:00 AM"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-mono" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">End Time</label>
                        <input type="text" @bind="_newPeriod.EndTime" placeholder="08:50 AM"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-mono" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Duration (Minutes)</label>
                        <input type="number" @bind="_newPeriod.DurationMinutes" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-bold" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Shift</label>
                        <CustomSelect @bind-Value="_newPeriod.Shift" Options="_shiftModalOptions" Placeholder="Shift" Class="w-full" />
                    </div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="chkBreak" @bind="_newPeriod.IsBreak" class="rounded text-[#009488] focus:ring-teal-500" />
                    <label for="chkBreak" class="text-xs text-slate-700 dark:text-slate-300 font-medium cursor-pointer">This slot is a Recess / Tiffin Break (No teaching)</label>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => _showAddPeriodModal = false" class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl transition-all cursor-pointer">Cancel</button>
            <button type="button" @onclick="SavePeriod" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                <span>Save Period</span>
            </button>
        </FooterTemplate>
    </Modal>
}

