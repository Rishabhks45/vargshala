    private void AddCoAdmin()
    {
        if (!string.IsNullOrWhiteSpace(_newAdminToAssign) && _selectedConversation != null)
        {
            if (!_selectedConversation.Admins.Contains(_newAdminToAssign))
            {
                _selectedConversation.Admins.Add(_newAdminToAssign);
            }
            _newAdminToAssign = string.Empty;
        }
    }

    private void CreateNewConversation()
    {
        if (string.IsNullOrWhiteSpace(_newChatName)) return;

        var adminsList = new List<string> { _currentUserName };
        if (CurrentUserRole == "Admin")
        {
            adminsList.AddRange(_selectedCoAdmins.Where(a => !adminsList.Contains(a)));
        }

        var conv = new ChatConversationDto
        {
            Name = _newChatName,
            Subtitle = $"{_newChatBranch} • {_newChatBatch}",
            Type = _newChatType == "Channel" ? ConversationType.Channel : ConversationType.Direct,
            BranchName = _newChatBranch,
            BatchName = _newChatBatch,
            WhoCanPost = CurrentUserRole == "Student" ? ChannelPostingPermission.AllMembers : _newChatWhoCanPost,
            Admins = adminsList,
            CreatedByRole = CurrentUserRole,
            Initials = _newChatName.Length >= 2 ? _newChatName[..2].ToUpper() : "CH",
            MemberCount = 35,
            LastMessage = "Channel created.",
            LastMessageTime = "Just now",
            Members = new()
            {
                new() { Name = _currentUserName, Role = CurrentUserRole, Initials = "ME", IsOnline = true, IsAdmin = true }
            }
        };

        _conversations.Insert(0, conv);
        _messagesDb[conv.Id] = new List<ChatMessageDto>
        {
            new()
            {
                ConversationId = conv.Id,
                SenderName = "System",
                SenderRole = "Admin",
                SenderInitials = "VS",
                Content = $"Welcome to **{_newChatName}**! This channel was created for **{_newChatBatch}** at **{_newChatBranch}**. Permission: **{GetPostingPermissionLabel(conv.WhoCanPost)}**.",
                SentAt = DateTime.Now,
                IsOutgoing = false
            }
        };

        _selectedConversation = conv;
        _showNewChatModal = false;
        _newChatName = string.Empty;
    }
