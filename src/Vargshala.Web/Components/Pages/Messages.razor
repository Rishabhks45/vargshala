    private readonly Dictionary<Guid, List<ChatMessageDto>> _messagesDb = new();

    protected override void OnInitialized()
    {
        var c1 = _conversations[0].Id;
        _messagesDb[c1] = new List<ChatMessageDto>
        {
            new()
