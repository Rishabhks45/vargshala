@page "/messages"
@using Vargshala.Contracts.Messages
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Modals
@rendermode InteractiveServer

<PageTitle>Messages & Teams | Vargshala</PageTitle>

<!-- Full-Height Teams Hub Container -->
<div class="h-[calc(100vh-6.5rem)] rounded-3xl bg-white border border-slate-200/80 shadow-md flex overflow-hidden select-none">

    <!-- ========================================================================= -->
    <!-- LEFT PANEL: Teams & Conversations Sidebar (Microsoft Teams Style) -->
    <!-- ========================================================================= -->
    <div class="w-80 lg:w-88 border-r border-slate-200/70 bg-slate-50/60 flex flex-col shrink-0">
        
        <!-- Sidebar Header -->
        <div class="p-4 border-b border-slate-200/70 bg-white">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-teal-50 border border-teal-200 text-[#00796b] font-bold flex items-center justify-center shadow-2xs">
                        <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-sm font-extrabold text-slate-800 tracking-tight leading-tight">
                            Messages & Teams
                        </h2>
                        <p class="text-[10px] text-slate-400 font-medium">Coaching Channels & Chats</p>
                    </div>
                </div>

                <button type="button" 
                        @onclick="() => _showNewChatModal = true" 
                        class="p-2 rounded-xl bg-teal-50 hover:bg-teal-100 text-[#00796b] border border-teal-200/60 shadow-2xs transition-all cursor-pointer"
                        title="New Chat / Channel">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </button>
            </div>

            <!-- Search Bar -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </span>
                <input type="text" 
                       @bind="_searchQuery" 
                       @bind:event="oninput"
                       placeholder="Search channels, teachers, students..." 
                       class="w-full pl-8 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all placeholder-slate-400" />
            </div>

            <!-- Filter Category Pills (Teams Style) -->
            <div class="flex items-center gap-1.5 mt-2.5 overflow-x-auto pb-1 text-[11px] font-bold">
                <button type="button" 
                        @onclick='() => _activeCategory = "All"'
                        class="px-2.5 py-1 rounded-lg transition-all cursor-pointer whitespace-nowrap @(_activeCategory == "All" ? "bg-[#009488] text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    All
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Channels"'
                        class="px-2.5 py-1 rounded-lg transition-all cursor-pointer whitespace-nowrap @(_activeCategory == "Channels" ? "bg-[#009488] text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Channels (@_conversations.Count(c => c.Type == ConversationType.Channel))
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Direct"'
                        class="px-2.5 py-1 rounded-lg transition-all cursor-pointer whitespace-nowrap @(_activeCategory == "Direct" ? "bg-[#009488] text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Direct (@_conversations.Count(c => c.Type == ConversationType.Direct))
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Unread"'
                        class="px-2.5 py-1 rounded-lg transition-all cursor-pointer whitespace-nowrap @(_activeCategory == "Unread" ? "bg-[#009488] text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    Unread (@_conversations.Count(c => c.UnreadCount > 0))
                </button>
            </div>
        </div>

        <!-- Conversations Scrollable Feed -->
        <div class="flex-1 overflow-y-auto divide-y divide-slate-100">
            @if (FilteredConversations.Any())
            {
                @foreach (var conv in FilteredConversations)
                {
                    var isSelected = conv.Id == _selectedConversation?.Id;
                    <div @onclick="() => SelectConversation(conv)"
                         class="p-3.5 flex items-start gap-3 cursor-pointer transition-all relative @(isSelected ? "bg-teal-50/90 border-l-4 border-[#009488] text-slate-900" : "hover:bg-slate-100/70 text-slate-700")">
                        
                        <!-- Avatar / Channel Icon -->
                        <div class="relative shrink-0 mt-0.5">
                            @if (conv.Type == ConversationType.Channel)
                            {
                                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-teal-500 to-[#004D40] text-white font-black text-sm flex items-center justify-center shadow-xs">
                                    #
                                </div>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-2xl bg-teal-100/80 border border-teal-200 text-[#00796b] font-bold text-xs flex items-center justify-center shadow-2xs">
                                    @conv.Initials
                                </div>
                                @if (conv.IsOnline)
                                {
                                    <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white" title="Active Now"></span>
                                }
                            }
                        </div>

                        <!-- Conversation Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-1 mb-0.5">
                                <h4 class="text-xs font-bold truncate @(conv.UnreadCount > 0 ? "text-slate-900 font-extrabold" : "text-slate-800")">
                                    @conv.Name
                                </h4>
                                <span class="text-[10px] text-slate-400 font-medium shrink-0">@conv.LastMessageTime</span>
                            </div>

                            <p class="text-[11px] text-slate-500 truncate leading-snug @(conv.UnreadCount > 0 ? "font-semibold text-slate-800" : "")">
                                @conv.LastMessage
                            </p>

                            <!-- Sub-Tags & Badges -->
                            <div class="flex items-center gap-1.5 mt-1">
                                @if (conv.Type == ConversationType.Channel)
                                {
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[9px] font-bold bg-teal-100/70 text-[#00796b]">
                                        @conv.BatchName
                                    </span>
                                }
                                @if (conv.IsPinned)
                                {
                                    <span class="text-amber-500 text-[10px]" title="Pinned">📌</span>
                                }
                            </div>
                        </div>

                        <!-- Unread Count Pill -->
                        @if (conv.UnreadCount > 0)
                        {
                            <div class="w-5 h-5 rounded-full bg-[#009488] text-white text-[10px] font-extrabold flex items-center justify-center shrink-0 shadow-xs">
                                @conv.UnreadCount
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="p-8 text-center text-slate-400 space-y-2">
                    <svg class="w-8 h-8 mx-auto text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    <p class="text-xs font-medium">No conversations found</p>
                </div>
            }
        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- MIDDLE PANEL: Active Conversation & Feed (Teams UI) -->
    <!-- ========================================================================= -->
    <div class="flex-1 flex flex-col bg-[#FAFDFD] min-w-0">
        
        @if (_selectedConversation != null)
        {
            <!-- Teams Active Header -->
            <div class="px-6 py-3.5 bg-white border-b border-slate-200/70 flex items-center justify-between gap-3 shrink-0 shadow-2xs z-10">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="relative shrink-0">
                        @if (_selectedConversation.Type == ConversationType.Channel)
                        {
                            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-teal-500 to-[#004D40] text-white font-black text-base flex items-center justify-center shadow-xs">
                                #
                            </div>
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-2xl bg-teal-100 border border-teal-200 text-[#00796b] font-extrabold text-sm flex items-center justify-center shadow-xs">
                                @_selectedConversation.Initials
                            </div>
                            @if (_selectedConversation.IsOnline)
                            {
                                <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white"></span>
                            }
                        }
                    </div>

                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-extrabold text-slate-900 truncate">
                                @_selectedConversation.Name
                            </h3>
                            @if (_selectedConversation.Type == ConversationType.Channel)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-[#00796b] border border-teal-200">
                                    @_selectedConversation.BatchName
                                </span>
                            }
                        </div>
                        <p class="text-[11px] text-slate-400 font-medium truncate">
                            @_selectedConversation.Subtitle
                        </p>
                    </div>
                </div>

                <!-- Header Actions (Search, Pin, Info Toggle - No Voice/Video as requested) -->
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" 
                            @onclick="TogglePin" 
                            class="p-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-500 hover:text-amber-500 transition-all cursor-pointer"
                            title="@(_selectedConversation.IsPinned ? "Unpin conversation" : "Pin conversation")">
                        <span class="text-xs">📌</span>
                    </button>

                    <button type="button" 
                            @onclick="() => _showRightPanel = !_showRightPanel" 
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 hover:text-[#009488] text-xs font-bold transition-all cursor-pointer shadow-2xs">
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span class="hidden sm:inline">Details</span>
                    </button>
                </div>
            </div>

            <!-- Messages Stream -->
            <div class="flex-1 overflow-y-auto p-6 space-y-4 select-text">
                
                <!-- Date Separator Pill -->
                <div class="flex items-center justify-center my-2">
                    <span class="px-3.5 py-1 rounded-full bg-slate-100/90 border border-slate-200 text-[10px] font-bold text-slate-500 uppercase tracking-wider shadow-2xs">
                        Today • Academic Discussion
                    </span>
                </div>

                @foreach (var msg in CurrentMessages)
                {
                    @if (msg.IsAnnouncement)
                    {
                        <!-- Pinned Announcement Banner (Teams Style) -->
                        <div class="p-4 rounded-2xl bg-gradient-to-r from-teal-50 via-teal-50/70 to-amber-50/50 border border-teal-200/80 shadow-xs space-y-2">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-[#004D40] text-amber-300 font-black text-xs flex items-center justify-center shadow-2xs">📢</span>
                                    <span class="text-xs font-black text-[#004D40] uppercase tracking-wider">Announcement: @msg.AnnouncementTitle</span>
                                </div>
                                <span class="text-[10px] text-slate-400 font-medium">@msg.SentAt.ToString("hh:mm tt")</span>
                            </div>
                            <p class="text-xs text-slate-700 leading-relaxed font-medium">
                                @msg.Content
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Message Bubble -->
                        <div class="flex items-start gap-3 group @(msg.IsOutgoing ? "flex-row-reverse" : "")">
                            
                            <!-- Sender Avatar -->
                            <div class="w-9 h-9 rounded-2xl flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs @(msg.IsOutgoing ? "bg-gradient-to-br from-[#009488] to-[#00796b] text-white" : "bg-white border border-slate-200 text-[#00796b]")">
                                @msg.SenderInitials
                            </div>

                            <!-- Message Body -->
                            <div class="max-w-xl space-y-1.5 @(msg.IsOutgoing ? "items-end text-right" : "")">
                                <div class="flex items-center gap-2 text-[11px] @(msg.IsOutgoing ? "justify-end" : "")">
                                    <span class="font-bold text-slate-800">@msg.SenderName</span>
                                    
                                    <!-- Role Pill Badge -->
                                    <span class="px-1.5 py-0.2 rounded-md text-[9px] font-bold @(msg.SenderRole == "Teacher" ? "bg-teal-50 text-[#00796b] border border-teal-200" : msg.SenderRole == "Admin" ? "bg-purple-50 text-purple-700 border border-purple-200" : "bg-slate-100 text-slate-600")">
                                        @msg.SenderRole
                                    </span>

                                    <span class="text-[10px] text-slate-400">@msg.SentAt.ToString("hh:mm tt")</span>
                                </div>

                                <!-- Bubble Card -->
                                <div class="p-3.5 rounded-2xl text-xs leading-relaxed shadow-xs text-left @(msg.IsOutgoing ? "bg-[#009488] text-white rounded-tr-xs" : "bg-white border border-slate-200/80 text-slate-800 rounded-tl-xs")">
                                    <p class="whitespace-pre-wrap">@msg.Content</p>

                                    <!-- Attachment Preview Card (If any) -->
                                    @if (!string.IsNullOrEmpty(msg.AttachmentName))
                                    {
                                        <div class="mt-2.5 p-2.5 rounded-xl flex items-center justify-between gap-3 @(msg.IsOutgoing ? "bg-white/15 border border-white/20 text-white" : "bg-teal-50/60 border border-teal-200 text-slate-800")">
                                            <div class="flex items-center gap-2 min-w-0">
                                                <div class="w-8 h-8 rounded-lg bg-rose-500 text-white font-bold text-[10px] flex items-center justify-center shrink-0">
                                                    PDF
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-xs font-bold truncate">@msg.AttachmentName</p>
                                                    <p class="text-[10px] opacity-80">@msg.AttachmentSize</p>
                                                </div>
                                            </div>
                                            <button type="button" 
                                                    @onclick="() => DownloadAttachment(msg.AttachmentName)" 
                                                    class="p-1.5 rounded-lg hover:bg-black/10 transition-colors cursor-pointer" 
                                                    title="Download">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Reactions Bar -->
                                <div class="flex items-center gap-1.5 pt-0.5 @(msg.IsOutgoing ? "justify-end" : "")">
                                    @foreach (var reaction in msg.Reactions)
                                    {
                                        <button type="button" 
                                                @onclick="() => ToggleReaction(msg, reaction.Key)"
                                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-white border border-slate-200 hover:border-teal-300 text-slate-600 shadow-2xs transition-all cursor-pointer">
                                            <span>@reaction.Key</span>
                                            <span class="text-[#00796b]">@reaction.Value</span>
                                        </button>
                                    }
                                    
                                    <!-- Add Reaction Button -->
                                    <button type="button" 
                                            @onclick='() => ToggleReaction(msg, "👍")' 
                                            class="opacity-0 group-hover:opacity-100 p-1 rounded-full text-slate-400 hover:text-[#009488] hover:bg-slate-100 text-xs transition-opacity cursor-pointer"
                                            title="React with 👍">
                                        +👍
                                    </button>
                                </div>

                            </div>
                        </div>
                    }
                }

            </div>

            <!-- ========================================================================= -->
            <!-- RICH MESSAGE COMPOSER (Teams Style) -->
            <!-- ========================================================================= -->
            <div class="p-4 bg-white border-t border-slate-200/80 shrink-0">
                
                @if (!string.IsNullOrEmpty(_pendingAttachmentName))
                {
                    <div class="mb-2 p-2 bg-teal-50 border border-teal-200 rounded-xl flex items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-[#00796b]">📎 Attachment:</span>
                            <span class="text-slate-800 font-medium">@_pendingAttachmentName</span>
                        </div>
                        <button type="button" @onclick="() => _pendingAttachmentName = null" class="text-slate-400 hover:text-rose-500">
                            ✕
                        </button>
                    </div>
                }

                <div class="border border-slate-200 hover:border-slate-300 focus-within:border-[#009488] focus-within:ring-2 focus-within:ring-teal-500/20 rounded-2xl bg-white shadow-xs transition-all overflow-hidden">
                    
                    <!-- Formatting Toolbar -->
                    <div class="px-3 py-1.5 bg-slate-50 border-b border-slate-100 flex items-center justify-between text-xs text-slate-500">
                        <div class="flex items-center gap-1">
                            <button type="button" @onclick='() => AppendFormatting("**", "**")' class="p-1 rounded-lg hover:bg-slate-200 font-black" title="Bold (Ctrl+B)">B</button>
                            <button type="button" @onclick='() => AppendFormatting("*", "*")' class="p-1 rounded-lg hover:bg-slate-200 italic font-serif" title="Italic (Ctrl+I)">I</button>
                            <button type="button" @onclick='() => AppendFormatting("`", "`")' class="p-1 rounded-lg hover:bg-slate-200 font-mono" title="Code Snippet">&lt;/&gt;</button>
                            <button type="button" @onclick='() => AppendFormatting("\n- ", "")' class="p-1 rounded-lg hover:bg-slate-200" title="Bullet List">• List</button>
                            <span class="h-4 w-px bg-slate-200 mx-1"></span>
                            <button type="button" @onclick="SimulateAttachment" class="inline-flex items-center gap-1 p-1 px-2 rounded-lg hover:bg-slate-200 font-semibold text-slate-700" title="Attach Document / Homework">
                                <span>📎 Attach File</span>
                            </button>
                            <button type="button" @onclick='() => _isAnnouncementMode = !_isAnnouncementMode' class="inline-flex items-center gap-1 p-1 px-2 rounded-lg transition-colors font-semibold @(_isAnnouncementMode ? "bg-amber-100 text-amber-800" : "hover:bg-slate-200")" title="Announcement Mode">
                                <span>📢 Announcement</span>
                            </button>
                        </div>
                        <span class="text-[10px] text-slate-400 hidden sm:inline">Press Enter to send, Shift+Enter for new line</span>
                    </div>

                    @if (_isAnnouncementMode)
                    {
                        <div class="p-2.5 bg-amber-50/70 border-b border-amber-200">
                            <input type="text" 
                                   @bind="_announcementTitle" 
                                   placeholder="Announcement Headline (e.g. Physics Test Rescheduled to Saturday)..." 
                                   class="w-full text-xs font-bold text-amber-900 bg-transparent focus:outline-none placeholder-amber-700/60" />
                        </div>
                    }

                    <!-- Text Area Input -->
                    <div class="p-3 flex items-end gap-2">
                        <textarea @bind="_messageInput"
                                  @bind:event="oninput"
                                  @onkeydown="HandleKeyPress"
                                  placeholder="Type a message to @(_selectedConversation.Name)..."
                                  rows="2"
                                  class="w-full text-xs text-slate-800 placeholder-slate-400 focus:outline-none resize-none bg-transparent"></textarea>

                        <button type="button" 
                                @onclick="SendMessage"
                                disabled="@(string.IsNullOrWhiteSpace(_messageInput) && string.IsNullOrEmpty(_pendingAttachmentName))"
                                class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] disabled:opacity-50 disabled:cursor-not-allowed rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer shrink-0">
                            <span>Send</span>
                            <svg class="w-3.5 h-3.5 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                        </button>
                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400 space-y-3">
                <div class="w-16 h-16 rounded-3xl bg-teal-50 border border-teal-200 flex items-center justify-center text-[#00796b] shadow-sm">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-700">Select a conversation to start messaging</h3>
                    <p class="text-xs text-slate-400 max-w-sm mt-1">Chat directly with enrolled students, faculty members, or broadcast updates to coaching batch channels.</p>
                </div>
            </div>
        }

    </div>

    <!-- ========================================================================= -->
    <!-- RIGHT PANEL: Collapsible Details, Members & Shared Files -->
    <!-- ========================================================================= -->
    @if (_selectedConversation != null && _showRightPanel)
    {
        <div class="w-72 lg:w-80 border-l border-slate-200/70 bg-white p-5 flex flex-col shrink-0 overflow-y-auto space-y-5 animate-in slide-in-from-right duration-150">
            
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Channel Details</h3>
                <button type="button" @onclick="() => _showRightPanel = false" class="text-slate-400 hover:text-slate-600">
                    ✕
                </button>
            </div>

            <!-- Overview Card -->
            <div class="p-4 rounded-2xl bg-teal-50/60 border border-teal-100 text-center space-y-2">
                @if (_selectedConversation.Type == ConversationType.Channel)
                {
                    <div class="w-12 h-12 mx-auto rounded-2xl bg-gradient-to-br from-teal-500 to-[#004D40] text-white font-black text-lg flex items-center justify-center shadow-md">
                        #
                    </div>
                }
                else
                {
                    <div class="w-12 h-12 mx-auto rounded-2xl bg-teal-100 border border-teal-200 text-[#00796b] font-black text-sm flex items-center justify-center shadow-md">
                        @_selectedConversation.Initials
                    </div>
                }

                <div>
                    <h4 class="text-sm font-extrabold text-slate-900">@_selectedConversation.Name</h4>
                    <p class="text-[11px] text-slate-500">@_selectedConversation.Subtitle</p>
                </div>

                @if (_selectedConversation.Type == ConversationType.Channel)
                {
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold bg-white text-[#00796b] border border-teal-200 shadow-2xs">
                        <span>👥 @_selectedConversation.MemberCount Members Enrolled</span>
                    </div>
                }
            </div>

            <!-- Panel Tabs: Members vs Shared Files -->
            <div class="space-y-3">
                <div class="flex items-center border-b border-slate-100 text-xs font-bold">
                    <button type="button" 
                            @onclick='() => _rightPanelTab = "Members"'
                            class="flex-1 pb-2 transition-colors border-b-2 @(_rightPanelTab == "Members" ? "border-[#009488] text-[#00796b]" : "border-transparent text-slate-400 hover:text-slate-600")">
                        Members (@_selectedConversation.Members.Count)
                    </button>
                    <button type="button" 
                            @onclick='() => _rightPanelTab = "Files"'
                            class="flex-1 pb-2 transition-colors border-b-2 @(_rightPanelTab == "Files" ? "border-[#009488] text-[#00796b]" : "border-transparent text-slate-400 hover:text-slate-600")">
                        Files (@_selectedConversation.SharedFiles.Count)
                    </button>
                </div>

                @if (_rightPanelTab == "Members")
                {
                    <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
                        @foreach (var member in _selectedConversation.Members)
                        {
                            <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 text-xs">
                                <div class="flex items-center gap-2 min-w-0">
                                    <div class="relative">
                                        <div class="w-7 h-7 rounded-xl bg-slate-100 text-slate-700 font-bold text-[10px] flex items-center justify-center">
                                            @member.Initials
                                        </div>
                                        @if (member.IsOnline)
                                        {
                                            <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-500"></span>
                                        }
                                    </div>
                                    <span class="truncate font-semibold text-slate-800">@member.Name</span>
                                </div>
                                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold @(member.Role == "Teacher" ? "bg-teal-50 text-[#00796b]" : "bg-slate-100 text-slate-500")">
                                    @member.Role
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
                        @foreach (var file in _selectedConversation.SharedFiles)
                        {
                            <div class="p-2.5 rounded-xl border border-slate-200/70 hover:border-teal-300 bg-slate-50/50 flex items-center justify-between gap-2 text-xs">
                                <div class="min-w-0">
                                    <p class="font-bold text-slate-800 truncate">@file.FileName</p>
                                    <p class="text-[10px] text-slate-400">@file.FileSize • @file.UploadDate</p>
                                </div>
                                <button type="button" @onclick="() => DownloadAttachment(file.FileName)" class="p-1 rounded-lg text-[#009488] hover:bg-teal-100" title="Download">
                                    ⬇
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }

</div>

