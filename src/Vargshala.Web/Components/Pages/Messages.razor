    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageInput) && string.IsNullOrEmpty(_pendingAttachmentName)) return;
        if (_selectedConversation == null) return;

        var newMsg = new ChatMessageDto
        {
            ConversationId = _selectedConversation.Id,
            SenderName = "Rishabh Sharma (Admin)",
            SenderRole = "Teacher",
            SenderInitials = "RS",
            Content = _messageInput.Trim(),
            SentAt = DateTime.Now,
            IsOutgoing = true,
            IsAnnouncement = _isAnnouncementMode,
            AnnouncementTitle = _isAnnouncementMode ? _announcementTitle : null,
            AttachmentName = _pendingAttachmentName,
            AttachmentSize = !string.IsNullOrEmpty(_pendingAttachmentName) ? "2.4 MB" : null
        };

        if (!_messagesDb.ContainsKey(_selectedConversation.Id))
        {
            _messagesDb[_selectedConversation.Id] = new();
        }

        _messagesDb[_selectedConversation.Id].Add(newMsg);
        _selectedConversation.LastMessage = string.IsNullOrWhiteSpace(newMsg.Content) ? $"📎 {newMsg.AttachmentName}" : newMsg.Content;
        _selectedConversation.LastMessageTime = DateTime.Now.ToString("hh:mm tt");

        _messageInput = string.Empty;
        _pendingAttachmentName = null;
        _isAnnouncementMode = false;
        _announcementTitle = string.Empty;
    }

