@if (_showNewChatModal)
{
    <Modal IsOpen="true" 
           Title="Start New Discussion / Channel" 
           Subtitle="Connect with students, faculty, or coaching batches" 
           MaxWidth="max-w-md" 
           OnClose="() => _showNewChatModal = false">
        <ChildContent>
            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700">Discussion Type *</label>
                    <select @bind="_newChatType" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:outline-none cursor-pointer">
                        <option value="Channel">Batch Channel (Group Broadcast & Discussion)</option>
                        <option value="Direct">Direct Message (1-on-1 Student/Teacher)</option>
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700">Name / Topic *</label>
                    <input type="text" @bind="_newChatName" placeholder="e.g. # IIT-JEE Physics Doubt Session" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none font-bold text-slate-800" />
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700">Assign Coaching Batch</label>
                    <select @bind="_newChatBatch" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-[#009488] focus:outline-none cursor-pointer">
                        <option value="Class 10 — Maths">Class 10 — Maths</option>
                        <option value="Class 10 — Science">Class 10 — Science</option>
                        <option value="Class 12 — Physics">Class 12 — Physics</option>
                        <option value="Class 12 — Chemistry">Class 12 — Chemistry</option>
                        <option value="IIT-JEE Morning Batch">IIT-JEE Morning Batch</option>
                    </select>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => _showNewChatModal = false" class="px-4 py-2.5 text-xs font-bold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 rounded-xl">
                Cancel
            </button>
            <button type="button" @onclick="CreateNewConversation" class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 cursor-pointer">
                <span>Create Channel</span>
            </button>
        </FooterTemplate>
    </Modal>
}

