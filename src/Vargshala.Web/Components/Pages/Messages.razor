    private List<ChatConversationDto> FilteredConversations
    {
        get
        {
            var query = _conversations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(c => 
                    c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.Subtitle.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.BatchName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (_activeCategory == "Channels")
            {
                query = query.Where(c => c.Type == ConversationType.Channel);
            }
            else if (_activeCategory == "Direct")
            {
                query = query.Where(c => c.Type == ConversationType.Direct);
            }
            else if (_activeCategory == "Unread")
            {
                query = query.Where(c => c.UnreadCount > 0);
            }

            return query.OrderByDescending(c => c.IsPinned).ToList();
        }
    }

    private List<ChatMessageDto> CurrentMessages
    {
        get
        {
            if (_selectedConversation == null) return new();
            if (!_messagesDb.ContainsKey(_selectedConversation.Id))
            {
                _messagesDb[_selectedConversation.Id] = new();
            }
            return _messagesDb[_selectedConversation.Id];
        }
    }

    private bool CanCurrentUserPostInSelectedConversation()
    {
        if (_selectedConversation == null) return false;
        if (CurrentUserRole == "Admin" || CurrentUserRole == "Teacher") return true;

        // If current user is Student:
        if (_selectedConversation.Type == ConversationType.Direct) return true;
        return _selectedConversation.WhoCanPost == ChannelPostingPermission.AllMembers;
    }

    private string GetPostingPermissionLabel(ChannelPostingPermission perm) => perm switch
    {
        ChannelPostingPermission.AllMembers => "Open (All Members)",
        ChannelPostingPermission.AdminsAndTeachersOnly => "Admins & Teachers Only",
        _ => "Admins Only"
    };

    private string RenderFormattedContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;

        var html = System.Net.WebUtility.HtmlEncode(content);

        // Bold: **text**
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong class='font-bold text-slate-900'>$1</strong>");
        
        // Italic: *text*
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        
        // Code: `code`
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code class='px-1.5 py-0.5 rounded bg-slate-100 font-mono text-[11px] text-teal-700 font-bold'>$1</code>");

        // Newlines to <br/>
        html = html.Replace("\n", "<br/>");

        return html;
    }

