    private List<ChatConversationDto> FilteredConversations
    {
        get
        {
            var query = _conversations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(c => 
                    c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.Subtitle.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.BatchName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (_activeCategory == "Channels")
            {
                query = query.Where(c => c.Type == ConversationType.Channel);
            }
            else if (_activeCategory == "Direct")
            {
                query = query.Where(c => c.Type == ConversationType.Direct);
            }
            else if (_activeCategory == "Unread")
            {
                query = query.Where(c => c.UnreadCount > 0);
            }

            return query.OrderByDescending(c => c.IsPinned).ToList();
        }
    }

    private List<ChatMessageDto> CurrentMessages
    {
        get
        {
            if (_selectedConversation == null) return new();
            if (!_messagesDb.ContainsKey(_selectedConversation.Id))
            {
                _messagesDb[_selectedConversation.Id] = new();
            }
            return _messagesDb[_selectedConversation.Id];
        }
    }

    private void SelectConversation(ChatConversationDto conv)
    {
        _selectedConversation = conv;
        conv.UnreadCount = 0; // Mark as read
    }

    private void TogglePin()
    {
        if (_selectedConversation != null)
        {
            _selectedConversation.IsPinned = !_selectedConversation.IsPinned;
        }
    }

    private void ToggleReaction(ChatMessageDto msg, string emoji)
    {
        if (!msg.Reactions.ContainsKey(emoji))
        {
            msg.Reactions[emoji] = 1;
        }
        else
        {
            msg.Reactions[emoji]++;
        }
    }

    private void AppendFormatting(string prefix, string suffix)
    {
        _messageInput += $"{prefix}text{suffix}";
    }

    private void SimulateAttachment()
    {
