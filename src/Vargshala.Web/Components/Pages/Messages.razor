                SentAt = DateTime.Today.AddHours(10).AddMinutes(25),
                IsOutgoing = true,
                Reactions = new() { { "❤️", 4 }, { "👍", 8 } }
            }
        };

        _selectedConversation = _conversations[0];
    }

    private List<ChatConversationDto> FilteredConversations
    {
        get
        {
            var query = _conversations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(c => 
                    c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.BatchName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (_activeCategory == "Channels") query = query.Where(c => c.Type == ConversationType.Channel);
            else if (_activeCategory == "Direct") query = query.Where(c => c.Type == ConversationType.Direct);
            else if (_activeCategory == "Unread") query = query.Where(c => c.UnreadCount > 0);

            return query.ToList();
        }
    }

    private List<ChatMessageDto> CurrentMessages => _selectedConversation != null && _messagesDb.ContainsKey(_selectedConversation.Id)
        ? _messagesDb[_selectedConversation.Id]
        : new();

    private bool CanCurrentUserPostInSelectedConversation()
    {
        if (_selectedConversation == null) return false;
        if (CurrentUserRole == "Admin" || CurrentUserRole == "Teacher") return true;
        if (_selectedConversation.Type == ConversationType.Direct) return true;
        return _selectedConversation.WhoCanPost == ChannelPostingPermission.AllMembers;
    }

    private string RenderFormattedContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;
        var html = System.Net.WebUtility.HtmlEncode(content);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong class='font-bold'>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code class='px-1 py-0.2 rounded bg-slate-100 dark:bg-slate-800 font-mono text-[11px] text-teal-700 dark:text-teal-300 font-bold'>$1</code>");
        return html.Replace("\n", "<br/>");
    }

    private void SelectConversation(ChatConversationDto conv)
    {
        _selectedConversation = conv;
        conv.UnreadCount = 0;
    }

    private void TogglePin()
    {
        if (_selectedConversation != null) _selectedConversation.IsPinned = !_selectedConversation.IsPinned;
    }

    private void ToggleReaction(ChatMessageDto msg, string emoji)
    {
        if (!msg.Reactions.ContainsKey(emoji)) msg.Reactions[emoji] = 1;
        else msg.Reactions[emoji]++;
    }

    private void WrapSelection(string prefix, string suffix) => _messageInput += $" {prefix}text{suffix} ";
    private void InsertAtCursor(string text) => _messageInput += text;
    private void SimulateAttachment() => _pendingAttachmentName = "Physics_Problem_Set.pdf";
    private void DownloadAttachment(string fileName) { }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) SendMessage();
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageInput) && string.IsNullOrEmpty(_pendingAttachmentName)) return;
        if (_selectedConversation == null || !CanCurrentUserPostInSelectedConversation()) return;

        var newMsg = new ChatMessageDto
        {
            ConversationId = _selectedConversation.Id,
            SenderName = _currentUserName,
            SenderRole = CurrentUserRole,
            SenderInitials = CurrentUserRole == "Student" ? "AM" : CurrentUserRole == "Teacher" ? "VS" : "RS",
            Content = _messageInput.Trim(),
            SentAt = DateTime.Now,
            IsOutgoing = true,
            AttachmentName = _pendingAttachmentName
        };

        if (!_messagesDb.ContainsKey(_selectedConversation.Id)) _messagesDb[_selectedConversation.Id] = new();
        _messagesDb[_selectedConversation.Id].Add(newMsg);

        _selectedConversation.LastMessage = newMsg.Content;
        _selectedConversation.LastMessageTime = DateTime.Now.ToString("hh:mm tt");
        _messageInput = string.Empty;
        _pendingAttachmentName = null;
    }

    private void OpenCreateChannelModal()
    {
        _newChatName = string.Empty;
        _showNewChatModal = true;
    }

    private void CreateNewConversation()
    {
        if (string.IsNullOrWhiteSpace(_newChatName)) return;

        var conv = new ChatConversationDto
        {
            Name = _newChatName,
            Subtitle = _newChatBatch,
            Type = ConversationType.Channel,
            BranchName = "Main Campus",
            BatchName = _newChatBatch,
            WhoCanPost = ChannelPostingPermission.AllMembers,
            Admins = new() { _currentUserName },
            Initials = _newChatName.Length >= 2 ? _newChatName[..2].ToUpper() : "CH",
            LastMessage = "Channel created.",
            LastMessageTime = "Just now",
            Members = new()
            {
                new() { Name = _currentUserName, Role = CurrentUserRole, Initials = "ME", IsOnline = true }
            }
        };

        _conversations.Insert(0, conv);
        _messagesDb[conv.Id] = new List<ChatMessageDto>();
        _selectedConversation = conv;
        _showNewChatModal = false;
    }
}
