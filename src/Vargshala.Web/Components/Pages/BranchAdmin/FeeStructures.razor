@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _submitted = false;

    private List<FeeStructureDto> _items = new();
    private int _totalRecords = 0;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private string _searchTerm = string.Empty;
    private string _selectedClassId = string.Empty;
    private string _selectedSession = string.Empty;
    private string _selectedStatus = string.Empty;

    private readonly TableSortState _sortState = new();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrWhiteSpace(_selectedClassId) ||
        !string.IsNullOrWhiteSpace(_selectedSession) ||
        !string.IsNullOrWhiteSpace(_selectedStatus);

    // Filters
    private List<CustomSelect.CustomSelectOption> _classFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _sessionFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _statusFilterOptions = new();

    // Drawer State
    private bool _showDrawer = false;
    private bool _isDrawerOpen = false;
    private FeeStructureDto? _editingItem = null;
    private FeeStructureFormModel _formModel = new();
    private List<CustomSelect.CustomSelectOption> _drawerClassOptions = new();
    private List<CustomSelect.CustomSelectOption> _sessionOptions = new();

    // View Modal & Delete
    private FeeStructureDto? _viewingItem = null;
    private FeeStructureDto? _itemToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        InitializeFilterOptions();
        await LoadFilterOptionsAsync();
        await LoadDataAsync(1);
    }

    private void InitializeFilterOptions()
    {
        _statusFilterOptions = FeeFilterHelper.GetEntityStatusFilterOptions();
        _sessionOptions = FeeFilterHelper.GetSessionOptions();
        _sessionFilterOptions = FeeFilterHelper.GetSessionFilterOptions();
    }

    private async Task LoadFilterOptionsAsync()
    {
        var classesRes = await BranchClassService.GetAllActiveClassesAsync();
        if (classesRes.Success && classesRes.Data != null)
        {
            _classFilterOptions = classesRes.Data
                .Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name))
                .ToList();
            _drawerClassOptions = _classFilterOptions;
        }
    }

    private async Task LoadDataAsync(int page)
    {
        _isLoading = true;
        _currentPage = page;

        var request = new PagedRequest
        {
            PageNumber = _currentPage,
            PageSize = _pageSize,
            Search = _searchTerm,
            SortBy = _sortState.Column,
            SortDirection = _sortState.IsSorted ? (_sortState.Direction == SortDirection.Descending ? "desc" : "asc") : null
        };

        Guid? classId = Guid.TryParse(_selectedClassId, out var cId) && cId != Guid.Empty ? cId : null;
        string? session = !string.IsNullOrWhiteSpace(_selectedSession) ? _selectedSession : null;
        bool? isActive = _selectedStatus switch
        {
            "Active" => true,
            "Inactive" => false,
            _ => null
        };

        var response = await BranchFeeStructureService.GetFeeStructuresPagedAsync(
            request, classId, session, isActive);

        if (response.Success && response.Data != null)
        {
            _items = response.Data.Items;
            _totalRecords = response.Data.TotalRecords;
        }
        else
        {
            _items = new();
            _totalRecords = 0;
            Toast.Error(response.Message ?? "Failed to load fee structures.");
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadDataAsync(1);
    }

    private async Task HandleClassFilterChanged(string val)
    {
        _selectedClassId = val;
        await LoadDataAsync(1);
    }

    private async Task HandleSessionFilterChanged(string val)
    {
        _selectedSession = val;
        await LoadDataAsync(1);
    }

    private async Task HandleStatusFilterChanged(string val)
    {
        _selectedStatus = val;
        await LoadDataAsync(1);
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = string.Empty;
        _selectedClassId = string.Empty;
        _selectedSession = string.Empty;
        _selectedStatus = string.Empty;
        await LoadDataAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadDataAsync(1);
    }

    // =========================================================================
    // ADD / EDIT DRAWER ACTIONS
    // =========================================================================
    private async Task OpenAddDrawerAsync()
    {
        _editingItem = null;
        _formModel = new FeeStructureFormModel
        {
            AcademicSession = FeeFilterHelper.GetCurrentAcademicSession(),
            IsActive = true
        };
        _submitted = false;

        _showDrawer = true;
        StateHasChanged();
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(FeeStructureDto item)
    {
        _editingItem = item;
        _formModel = new FeeStructureFormModel
        {
            Id = item.Id,
            ClassId = item.ClassId,
            Name = item.Name,
            AcademicSession = item.AcademicSession,
            TotalAmount = item.TotalAmount,
            Description = item.Description,
            IsActive = item.Status == EntityStatus.Active
        };
        _submitted = false;

        _showDrawer = true;
        StateHasChanged();
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showDrawer = false;
        _editingItem = null;
    }

    private async Task SaveFeeStructureAsync()
    {
        _submitted = true;

        if (string.IsNullOrWhiteSpace(_formModel.Name) ||
            string.IsNullOrWhiteSpace(_formModel.AcademicSession) ||
            _formModel.TotalAmount < 0)
        {
            return;
        }

        _isSaving = true;

        if (_editingItem == null)
        {
            var req = new CreateFeeStructureRequest
            {
                ClassId = _formModel.ClassId,
                Name = _formModel.Name.Trim(),
                AcademicSession = _formModel.AcademicSession,
                TotalAmount = _formModel.TotalAmount,
                Description = _formModel.Description?.Trim()
            };

            var res = await BranchFeeStructureService.CreateFeeStructureAsync(req);
            _isSaving = false;

            if (res.Success && res.Data != null)
            {
                Toast.Success("Fee structure created successfully.");
                await CloseDrawerAsync();
                await LoadDataAsync(1);
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to create fee structure.");
            }
        }
        else
        {
            var req = new UpdateFeeStructureRequest
            {
                Id = _editingItem.Id,
                ClassId = _formModel.ClassId,
                Name = _formModel.Name.Trim(),
                AcademicSession = _formModel.AcademicSession,
                TotalAmount = _formModel.TotalAmount,
                Description = _formModel.Description?.Trim(),
                IsActive = _formModel.IsActive
            };

            var res = await BranchFeeStructureService.UpdateFeeStructureAsync(_editingItem.Id, req);
            _isSaving = false;

            if (res.Success && res.Data != null)
            {
                Toast.Success("Fee structure updated successfully.");
                await CloseDrawerAsync();
                await LoadDataAsync(_currentPage);
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to update fee structure.");
            }
        }
    }

    // =========================================================================
    // STATUS TOGGLE & DELETE
    // =========================================================================
    private async Task ToggleStatusAsync(FeeStructureDto item)
    {
        var res = await BranchFeeStructureService.ToggleFeeStructureStatusAsync(item.Id);
        if (res.Success)
        {
            Toast.Success($"Package {(item.Status == EntityStatus.Active ? "deactivated" : "activated")} successfully.");
            await LoadDataAsync(_currentPage);
        }
        else
        {
            Toast.Error(res.Message ?? "Could not toggle status.");
        }
    }

    private void ConfirmDelete(FeeStructureDto item)
    {
        _itemToDelete = item;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_itemToDelete == null) return;
        var res = await BranchFeeStructureService.DeleteFeeStructureAsync(_itemToDelete.Id);
        _itemToDelete = null;

        if (res.Success)
        {
            Toast.Success("Fee structure deleted successfully.");
            await LoadDataAsync(_currentPage);
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete fee structure.");
        }
    }

    private void OpenViewModal(FeeStructureDto item)
    {
        _viewingItem = item;
    }

    private async Task ExportCsv()
    {
        if (!_items.Any())
        {
            Toast.Warning("No records to export.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Package Name,Class,Academic Session,Total Amount,Status");
        foreach (var item in _items)
        {
            sb.AppendLine($"\"{item.Name}\",\"{item.ClassName ?? "General"}\",\"{item.AcademicSession}\",{item.TotalAmount},\"{item.Status}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", $"branch_fee_structures_{DateTime.UtcNow:yyyyMMdd}.csv", "text/csv", base64);
        Toast.Success("Fee structures exported to CSV.");
    }

    private static string GetStatusBadgeClass(EntityStatus status) => status switch
    {
        EntityStatus.Active => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
        _ => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700"
    };

