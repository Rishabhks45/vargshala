@page "/branch/fee-structures"
@page "/branch/fee-structure"
@attribute [Authorize(Roles = "BranchAdmin,4")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.FeeStructures
@using Vargshala.Contracts.Classes
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services.BranchAdmin
@using Vargshala.Web.Services
@inject IBranchFeeStructureClientService BranchFeeStructureService
@inject IBranchClassClientService BranchClassService
@inject INotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Branch Fee Packages | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Fee Structures
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage branch fee packages, academic session rates, and grade allocations.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Add Fee Structure</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Total Structures -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Packages</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_items.Count(x => x.Status == EntityStatus.Active) Active • @_items.Count(x => x.Status == EntityStatus.Inactive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Active Structures -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Packages</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@_items.Count(x => x.Status == EntityStatus.Active)</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Available for Students</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Average Fee Amount -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Average Fee</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">
                        @(_items.Any() ? "₹" + _items.Average(x => x.TotalAmount).ToString("N0") : "₹0")
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Across All Packages</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Linked Classes -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Class Mappings</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_items.Count(x => x.ClassId.HasValue)</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">
                        @_items.Count(x => !x.ClassId.HasValue) General / Branch-wide
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-2xs flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[200px] max-w-md">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" 
                   value="@_searchTerm" 
                   @oninput="HandleSearchInput"
                   placeholder="Search fee package name or session..." 
                   class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-[#009488] focus:ring-1 focus:ring-[#009488] transition-all" />
        </div>

        <!-- Filter Selectors -->
        <div class="w-full md:w-auto flex flex-wrap items-center gap-2.5">
            <!-- Class Filter -->
            <div class="w-40">
                <CustomSelect Value="@_selectedClassId" 
                              ValueChanged="HandleClassFilterChanged" 
                              Options="@_classFilterOptions" 
                              Placeholder="All Classes" />
            </div>

            <!-- Session Filter -->
            <div class="w-36">
                <CustomSelect Value="@_selectedSession" 
                              ValueChanged="HandleSessionFilterChanged" 
                              Options="@_sessionFilterOptions" 
                              Placeholder="All Sessions" />
            </div>

            <!-- Status Filter -->
            <div class="w-32">
                <CustomSelect Value="@_selectedStatus" 
                              ValueChanged="HandleStatusFilterChanged" 
                              Options="@_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" 
                        @onclick="ClearFiltersAsync"
                        class="px-3 py-2 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-xl transition-all cursor-pointer">
                    Clear
                </button>
            }
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs flex-1 flex flex-col justify-between min-h-[360px]">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse table-fixed">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider select-none bg-slate-50/50 dark:bg-[#152328]/40">
                        <th class="py-3 px-4 w-[28%] cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Fee Package Name</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[17%] cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("ClassName")'>
                            <div class="flex items-center gap-1.5">
                                <span>Class / Grade</span>
                                <span class="@_sortState.GetIndicatorClass("ClassName")">@_sortState.GetIndicator("ClassName")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[14%] cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("AcademicSession")'>
                            <div class="flex items-center gap-1.5">
                                <span>Academic Session</span>
                                <span class="@_sortState.GetIndicatorClass("AcademicSession")">@_sortState.GetIndicator("AcademicSession")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[15%] text-right cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("TotalAmount")'>
                            <div class="flex items-center justify-end gap-1.5">
                                <span>Total Fee (₹)</span>
                                <span class="@_sortState.GetIndicatorClass("TotalAmount")">@_sortState.GetIndicator("TotalAmount")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[10%] text-center cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("IsActive")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("IsActive")">@_sortState.GetIndicator("IsActive")</span>
                            </div>
                        </th>
                        <th class="py-3 px-4 w-[16%] text-right">Actions</th>
                    </tr>
                </thead>

                @if (_isLoading && !_items.Any())
                {
                    <TableSkeletonRows Columns="6" Rows="5" />
                }
                else if (!_items.Any())
                {
                    <tbody>
                        <tr>
                            <td colspan="6" class="py-12 text-center">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                        </svg>
                                    </div>
                                    <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No Fee Structures Found</p>
                                    <p class="text-xs text-slate-400 max-w-sm">No fee packages match your current search or filters. Create a new fee structure to start assigning packages.</p>
                                    <button type="button" @onclick="OpenAddDrawerAsync" class="mt-2 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#009488] text-white shadow-sm hover:bg-[#00796b] transition-all cursor-pointer">
                                        Create New Package
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
                else
                {
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs @(_isLoading ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                        @foreach (var item in _items)
                        {
                            <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/20 transition-colors group">
                                <!-- Name & Description -->
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold text-xs flex items-center justify-center shrink-0">
                                            ₹
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 dark:text-white truncate">@item.Name</p>
                                            <p class="text-[10px] text-slate-400 truncate">@(string.IsNullOrWhiteSpace(item.Description) ? "No description notes" : item.Description)</p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Class Mapping -->
                                <td class="py-3 px-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ClassName))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                            @item.ClassName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-teal-50 dark:bg-teal-950/40 text-[#00796b] dark:text-teal-300 border border-teal-200/50 dark:border-teal-800/50">
                                            All Classes (General)
                                        </span>
                                    }
                                </td>

                                <!-- Academic Session -->
                                <td class="py-3 px-3">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-[#18262c] text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                                        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        @item.AcademicSession
                                    </span>
                                </td>

                                <!-- Total Amount -->
                                <td class="py-3 px-3 text-right">
                                    <span class="font-extrabold text-slate-900 dark:text-white text-xs">₹@item.TotalAmount.ToString("N0")</span>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3 px-3 text-center">
                                    <span class="@GetStatusBadgeClass(item.Status)">
                                        @(item.Status == EntityStatus.Active ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Action 1: View Structure -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenViewModal(item)" 
                                                    class="p-1.5 text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="View Details">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-sky-700 text-white border border-sky-500/50 shadow-lg tracking-wide">
                                                    View Details
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-sky-700 border-r border-b border-sky-500/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 2: Edit Structure -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenEditDrawerAsync(item)" 
                                                    class="p-1.5 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="Edit Package">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-amber-600 text-white border border-amber-400/50 shadow-lg tracking-wide">
                                                    Edit Package
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-amber-600 border-r border-b border-amber-400/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 3: Toggle Status -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => ToggleStatusAsync(item)" 
                                                    class="p-1.5 @(item.Status == EntityStatus.Active 
                                                        ? "text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-950/40" 
                                                        : "text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="Toggle Status">
                                                @if (item.Status == EntityStatus.Active)
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                                    </svg>
                                                }
                                            </button>
                                            <div class="absolute bottom-full right-0 mb-2 hidden group-hover/act:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded @(item.Status == EntityStatus.Active ? "bg-sky-700" : "bg-slate-700") text-white border border-white/20 shadow-lg tracking-wide">
                                                    @(item.Status == EntityStatus.Active ? "Deactivate" : "Activate")
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-2.5 @(item.Status == EntityStatus.Active ? "bg-sky-700" : "bg-slate-700") border-r border-b border-white/20"></span>
                                            </div>
                                        </div>

                                        <!-- Action 4: Delete Package -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => ConfirmDelete(item)" 
                                                    class="p-1.5 text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="Delete Package">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full right-0 mb-2 hidden group-hover/act:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-rose-600 text-white border border-rose-400/50 shadow-lg tracking-wide">
                                                    Delete Package
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-2.5 bg-rose-600 border-r border-b border-rose-400/50"></span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="shrink-0 p-3 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 bg-white dark:bg-[#111c21]">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                Showing <span class="font-bold text-slate-700 dark:text-slate-200">@((_currentPage - 1) * _pageSize + (_items.Any() ? 1 : 0))</span> to <span class="font-bold text-slate-700 dark:text-slate-200">@(Math.Min(_currentPage * _pageSize, _totalRecords))</span> of <span class="font-bold text-slate-700 dark:text-slate-200">@_totalRecords</span> packages
            </span>
            <div class="flex items-center gap-1.5">
                <button type="button" 
                        @onclick="() => LoadDataAsync(_currentPage - 1)" 
                        disabled="@(_currentPage <= 1 || _isLoading)"
                        class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
                    Previous
                </button>
                <span class="px-2.5 py-1 text-xs font-bold text-slate-700 dark:text-slate-200">
                    @_currentPage / @(Math.Max(1, (int)Math.Ceiling((double)_totalRecords / _pageSize)))
                </span>
                <button type="button" 
                        @onclick="() => LoadDataAsync(_currentPage + 1)" 
                        disabled="@(_currentPage >= (int)Math.Ceiling((double)_totalRecords / _pageSize) || _isLoading)"
                        class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

