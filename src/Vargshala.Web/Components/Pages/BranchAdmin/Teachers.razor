    private readonly List<CustomSelect.CustomSelectOption> _designationOptions = Enum.GetValues<Designation>()
        .Select(d => new CustomSelect.CustomSelectOption(d.GetDisplayName(), d.GetDisplayName()))
        .ToList();

    private readonly List<CustomSelect.CustomSelectOption> _qualificationOptions = Enum.GetValues<HighestQualification>()
        .Select(q => new CustomSelect.CustomSelectOption(q.GetDisplayName(), q.GetDisplayName()))
        .ToList();

    private readonly TableQueryState _query = new();
    private TableSortState _sortState => _query.SortState;
    private int _totalRecords = 0;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _searchQuery = string.Empty;
    private string _selectedDepartment = string.Empty;
    private string _selectedStatus = string.Empty;

    // Drawer and Modal states
    private bool _showDrawer = false;
    private bool _isDrawerOpen = false;
    private TeacherDto? _editingTeacher;
