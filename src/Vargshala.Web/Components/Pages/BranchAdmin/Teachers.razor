    private TeacherDto? _teacherToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync(1);
    }

    private async Task LoadTeachersAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = page;

        try
        {
            bool? isActive = EntityStatusExtensions.FromString(_selectedStatus).ToNullableBool();

            var pagedRequest = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim(),
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : (_sortState.Direction == SortDirection.Ascending ? "asc" : null)
            };

            var response = await BranchTeacherService.GetTeachersPagedAsync(
                pagedRequest,
                department: string.IsNullOrWhiteSpace(_selectedDepartment) ? null : _selectedDepartment,
                isActive: isActive);

            if (response != null && response.Success && response.Data != null)
            {
                _teachers = response.Data.Items.ToList();
                _totalRecords = response.Data.TotalRecords;

                // Build distinct department list
                var distinctDeps = _teachers
                    .Select(t => t.Department)
                    .Where(d => !string.IsNullOrWhiteSpace(d))
                    .Distinct()
                    .OrderBy(d => d)
                    .ToList();

                _departmentFilterOptions = new List<CustomSelect.CustomSelectOption> { new("", "All Departments") };
                _departmentFilterOptions.AddRange(distinctDeps.Select(d => new CustomSelect.CustomSelectOption(d!, d!)));
            }
            else
            {
                _teachers = new();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load faculty: {ex.Message}");
            _teachers = new();
            _totalRecords = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadTeachersAsync(1);
    }

    private async Task HandleDepartmentChanged(string val)
    {
        _selectedDepartment = val;
        await LoadTeachersAsync(1);
    }

    private async Task HandleStatusChanged(string val)
    {
        _selectedStatus = val;
        await LoadTeachersAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadTeachersAsync(1);
    }

    private void OpenViewProfile(TeacherDto teacher)
    {
        _selectedProfileTeacher = teacher;
    }

    private void ConfirmDeleteTeacher(TeacherDto teacher)
    {
        _teacherToDelete = teacher;
    }

    private async Task DeleteTeacherAsync()
    {
        if (_teacherToDelete == null) return;

        try
        {
            var res = await BranchTeacherService.DeleteTeacherAsync(_teacherToDelete.Id);
            if (res != null && res.Success)
            {
                Toast.Success("Faculty removed successfully.");
                _teacherToDelete = null;
                await LoadTeachersAsync(_query.PageNumber);
            }
            else
            {
                Toast.Error(res?.Message ?? "Failed to delete faculty.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error deleting faculty: {ex.Message}");
        }
    }

    private async Task ToggleTeacherStatus(TeacherDto teacher)
    {
        try
        {
            var req = new UpdateTeacherRequest
            {
                Id = teacher.Id,
                FirstName = !string.IsNullOrWhiteSpace(teacher.FirstName) ? teacher.FirstName : "Teacher",
                LastName = !string.IsNullOrWhiteSpace(teacher.LastName) ? teacher.LastName : ".",
                Email = teacher.Email,
                Mobile = teacher.Mobile,
                EmployeeCode = teacher.EmployeeCode,
                Department = teacher.Department,
                Designation = teacher.Designation,
                HighestQualification = teacher.HighestQualification,
                TeachingExperienceYears = teacher.TeachingExperienceYears,
                Specialization = teacher.Specialization,
                JoiningDate = teacher.JoiningDate,
                Address = teacher.Address,
                City = teacher.City,
                State = teacher.State,
                PostalCode = teacher.PostalCode,
                Country = teacher.Country,
                AadharNumber = teacher.AadharNumber,
                PreviousInstitute = teacher.PreviousInstitute,
                Bio = teacher.Bio,
                IsActive = !teacher.IsActive
            };

            var res = await BranchTeacherService.UpdateTeacherAsync(teacher.Id, req);
            if (res != null && res.Success)
            {
                Toast.Success($"Faculty status changed to {(req.IsActive ? "Active" : "Inactive")}.");
                await LoadTeachersAsync(_query.PageNumber);
            }
            else
            {
                Toast.Error(res?.Message ?? "Failed to update status.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error updating faculty status: {ex.Message}");
        }
    }

