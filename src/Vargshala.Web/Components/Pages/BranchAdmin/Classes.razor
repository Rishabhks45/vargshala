@page "/branch/classes"
@page "/branch/class"
@attribute [Authorize(Roles = "BranchAdmin,4")]
@using Microsoft.AspNetCore.Components.Web
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Classes
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services.BranchAdmin
@using Vargshala.Web.Services
@inject IBranchClassClientService BranchClassService
@inject INotificationService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Branch Classes | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">
    
    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Classes Directory
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage academic standards and classes allocated to your branch.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Add Class</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Classes</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_classes.Count(c => c.IsActive) Active • @_classes.Count(c => !c.IsActive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Classes</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">
                        @_classes.Count(c => c.IsActive)
                    </h3>
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">Available for batches</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Linked Batches</p>
                    <h3 class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1">
                        @_classes.Sum(c => c.BatchesCount)
                    </h3>
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">In branch classes</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Branch Scoped</p>
                    <h3 class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">
                        100%
                    </h3>
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">Dedicated branch view</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        
        <div class="relative w-full md:w-72 lg:w-80 shrink-0">
            <SearchInput @bind-Value="_searchQuery" 
                         OnSearch="() => LoadClassesAsync(1)" 
                         Placeholder="Search by name or code..." />
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto flex-wrap md:flex-nowrap justify-end">
            <!-- Status Filter -->
            <div class="w-36">
                <CustomSelect Value="@(_selectedStatus.HasValue ? _selectedStatus.Value.ToString().ToLower() : "")"
                              ValueChanged="HandleStatusChanged"
                              Options="_statusFilterOptions"
                              Placeholder="All Statuses" />
            </div>

            <!-- View Mode Toggle -->
            <div class="inline-flex rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] p-0.5 shadow-2xs shrink-0">
                <button type="button" @onclick='() => _viewMode = "table"'
                        class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all @(_viewMode == "table" ? "bg-[#009488] text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")"
                        title="Table View">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <button type="button" @onclick='() => _viewMode = "grid"'
                        class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all @(_viewMode == "grid" ? "bg-[#009488] text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")"
                        title="Grid View">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Data Container -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        @if (_viewMode == "table")
        {
            <div class="flex-1 overflow-auto">
                <table class="w-full min-w-[850px] text-left border-collapse table-fixed">
                    <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                        <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                            <th class="w-[32%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Class Details</span>
                                    <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                                </div>
                            </th>
                            <th class="w-[30%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Description")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Description</span>
                                    <span class="@_sortState.GetIndicatorClass("Description")">@_sortState.GetIndicator("Description")</span>
                                </div>
                            </th>
                            <th class="w-[12%] py-2 px-3 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <span>Batches</span>
                                </div>
                            </th>
                            <th class="w-[12%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                                <div class="flex items-center justify-center gap-1.5">
                                    <span>Status</span>
                                    <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                                </div>
                            </th>
                            <th class="w-[14%] min-w-[130px] py-2 px-4 text-right select-none whitespace-nowrap">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _classes.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                        @if (_isLoading && !_classes.Any())
                        {
                            <TableSkeletonRows Columns="5" Rows="8" />
                        }
                        else if (_classes.Any())
                        {
                            @foreach (var cls in _classes)
                            {
                                <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors">
                                    <td class="py-2.5 px-5">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/60 dark:border-teal-800 font-extrabold text-xs flex items-center justify-center shrink-0 shadow-2xs">
                                                @GetInitials(cls.Name)
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-bold text-slate-900 dark:text-white truncate" title="@cls.Name">@cls.Name</p>
                                                <span class="inline-block uppercase font-mono text-[10px] font-bold text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/40 px-1.5 py-0.5 rounded border border-teal-200/80 dark:border-teal-800/80 mt-0.5">
                                                    @cls.Code
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-2.5 px-3">
                                        <p class="text-slate-500 dark:text-slate-400 truncate text-[11px]" title="@cls.Description">
                                            @(string.IsNullOrWhiteSpace(cls.Description) ? "—" : cls.Description)
                                        </p>
                                    </td>

                                    <td class="py-2.5 px-3 text-center">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-extrabold @(cls.BatchesCount > 0 ? "bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800" : "bg-slate-100 dark:bg-slate-800 text-slate-500")">
                                            <svg class="w-3 h-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                                            @cls.BatchesCount
                                        </span>
                                    </td>

                                    <td class="py-2.5 px-3 text-center">
                                        <button type="button" @onclick="() => ToggleStatusAsync(cls)"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold border transition-all cursor-pointer @(cls.IsActive ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/80 hover:bg-emerald-100" : "bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200 dark:border-slate-700 hover:bg-slate-200")"
                                                title="Click to toggle status">
                                            <span class="w-1.5 h-1.5 rounded-full @(cls.IsActive ? "bg-emerald-500 animate-pulse" : "bg-slate-400")"></span>
                                            @(cls.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </td>

                                    <td class="py-2.5 px-4 text-right whitespace-nowrap">
                                        <div class="flex items-center justify-end gap-1">
                                            
                                            <!-- Action 1: View Details -->
                                            <div class="relative group/act inline-flex items-center justify-center">
                                                <button type="button"
                                                        @onclick="() => OpenViewModal(cls)"
                                                        class="p-1.5 text-[#009488] dark:text-teal-400 hover:text-[#00796b] dark:hover:text-teal-300 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                        aria-label="View Details">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                    </svg>
                                                </button>
                                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                        View Details
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                                </div>
                                            </div>

                                            <!-- Action 2: Edit Class -->
                                            <div class="relative group/act inline-flex items-center justify-center">
                                                <button type="button"
                                                        @onclick="() => OpenEditDrawerAsync(cls)"
                                                        class="p-1.5 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                        aria-label="Edit Class">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                                                    </svg>
                                                </button>
                                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-amber-600 text-white border border-amber-400/50 shadow-lg tracking-wide">
                                                        Edit Class
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-amber-600 border-r border-b border-amber-400/50"></span>
                                                </div>
                                            </div>

                                            <!-- Action 3: Delete Class -->
                                            <div class="relative group/act inline-flex items-center justify-center">
                                                <button type="button"
                                                        @onclick="() => ConfirmDelete(cls)"
                                                        class="p-1.5 text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                        aria-label="Delete Class">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                                                    </svg>
                                                </button>
                                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-rose-600 text-white border border-rose-400/50 shadow-lg tracking-wide">
                                                        Delete Class
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-rose-600 border-r border-b border-rose-400/50"></span>
                                                </div>
                                            </div>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-slate-400">
                                    No classes found. Click "Add Class" above to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Grid View -->
            <div class="flex-1 overflow-auto p-4">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var cls in _classes)
                    {
                        <div class="card-surface p-4 border border-tealborder shadow-xs rounded-2xl flex flex-col justify-between hover:border-teal-400 transition-all">
                            <div>
                                <div class="flex items-center justify-between">
                                    <span class="inline-block uppercase font-mono text-[10px] font-bold text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/40 px-2 py-0.5 rounded border border-teal-200">
                                        @cls.Code
                                    </span>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold @(cls.IsActive ? "text-emerald-600" : "text-slate-400")">
                                        <span class="w-1.5 h-1.5 rounded-full @(cls.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                        @(cls.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <h4 class="font-bold text-slate-800 dark:text-white mt-2 text-sm">@cls.Name</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                                    @(string.IsNullOrWhiteSpace(cls.Description) ? "No description provided." : cls.Description)
                                </p>
                            </div>
                            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                                <span class="text-slate-500 font-medium">@cls.BatchesCount Batches</span>
                                <div class="flex items-center gap-1">
                                    <button type="button" @onclick="() => OpenEditDrawerAsync(cls)" class="p-1 text-slate-400 hover:text-teal-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>
                                    <button type="button" @onclick="() => ConfirmDelete(cls)" class="p-1 text-slate-400 hover:text-rose-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Pagination Component -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber"
                             PageSize="_query.PageSize"
                             TotalRecords="_totalRecords"
                             ItemLabel="classes"
                             IsLoading="_isLoading"
                             OnPageChanged="LoadClassesAsync"
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DRAWER: Add / Edit Class Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showAddEditModal)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-white/10 border border-teal-400/30 p-1.5 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/Logo.svg" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight">
                        <span>@(_editingClass == null ? "Add New Class" : "Edit Class Details")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingClass == null ? "Define a standard or grade for your branch" : $"Updating records for {_editingClass.Name}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <EditForm Model="@_formModel" OnValidSubmit="SaveClassAsync" class="flex-1 flex flex-col justify-between overflow-hidden">
            <DataAnnotationsValidator />

            <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-4 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                <!-- Class Name -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Class / Grade Name *</label>
                    <InputText @bind-Value="_formModel.Name" placeholder="e.g. Class 10th or Grade 12 - PCM" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    <ValidationMessage For="@(() => _formModel.Name)" class="text-[10px] text-rose-500" />
                </div>

                <!-- Class Code -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Class Code *</label>
                    <InputText @bind-Value="_formModel.Code" placeholder="e.g. CLS-10" class="w-full uppercase font-mono px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    <ValidationMessage For="@(() => _formModel.Code)" class="text-[10px] text-rose-500" />
                    <p class="text-[10px] text-slate-400">Unique identifier within your branch.</p>
                </div>

                <!-- Description -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Description / Academic Note</label>
                    <InputTextArea @bind-Value="_formModel.Description" rows="3" placeholder="Additional details, syllabus board, or notes..." class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>

                <!-- Active Status Toggle -->
                <div class="pt-2">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" @bind="_formModel.IsActive" class="w-4 h-4 rounded text-[#009488] focus:ring-teal-500 border-slate-300 dark:border-slate-700" />
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Active (Visible for batch creation)</span>
                    </label>
                </div>

            </div>

            <!-- Drawer Footer Buttons -->
            <div class="p-4 bg-slate-50 dark:bg-[#111c21] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-2.5 shrink-0">
                <button type="button" 
                        @onclick="CloseDrawerAsync" 
                        disabled="@_isSaving"
                        class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-[#1f3037] rounded-xl transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="submit" 
                        disabled="@_isSaving"
                        class="inline-flex items-center gap-1.5 px-6 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] rounded-xl shadow-md shadow-[#004D40]/20 transition-all cursor-pointer disabled:opacity-50">
                    @if (_isSaving)
                    {
                        <svg class="animate-spin -ml-1 mr-1.5 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(_editingClass == null ? "Create Class" : "Save Changes")</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- View Details Modal -->
@if (_selectedClass != null)
{
    <Modal IsOpen="true" 
           Title="@_selectedClass.Name" 
           Subtitle="@($"Code: {_selectedClass.Code}")" 
           MaxWidth="max-w-md" 
           OnClose="() => _selectedClass = null">
        <ChildContent>
            <div class="space-y-4">
                <div class="p-4 bg-slate-50 dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-700/80 space-y-3 text-xs">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <span class="text-slate-400 font-medium">Class Code:</span>
                        <span class="font-mono font-bold text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/50 px-2 py-0.5 rounded-md border border-teal-200 dark:border-teal-800">
                            @_selectedClass.Code
                        </span>
                    </div>
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <span class="text-slate-400 font-medium">Active Batches:</span>
                        <span class="font-bold text-blue-600 dark:text-blue-400">@_selectedClass.BatchesCount</span>
                    </div>
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <span class="text-slate-400 font-medium">Status:</span>
                        <span class="inline-flex items-center gap-1 font-bold @(_selectedClass.IsActive ? "text-emerald-600" : "text-slate-400")">
                            <span class="w-1.5 h-1.5 rounded-full @(_selectedClass.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                            @(_selectedClass.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 font-medium">Created On:</span>
                        <span class="text-slate-600 dark:text-slate-300 font-medium">
                            @_selectedClass.CreatedAt.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_selectedClass.Description))
                {
                    <div class="space-y-1">
                        <h5 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Description</h5>
                        <p class="text-xs text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-[#18262c] p-3 rounded-xl border border-slate-200 dark:border-slate-700/60 leading-relaxed">
                            @_selectedClass.Description
                        </p>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterTemplate>
            <div class="flex items-center justify-between w-full">
                <button type="button" @onclick='() => Navigation.NavigateTo("branch/batches")'
                        class="text-xs font-bold text-[#009488] hover:underline cursor-pointer">
                    Manage Batches →
                </button>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="async () => { var c = _selectedClass; _selectedClass = null; await OpenEditDrawerAsync(c); }"
                            class="px-4 py-2 text-xs font-bold text-white bg-[#009488] hover:bg-[#007A6F] rounded-xl transition-all cursor-pointer">
                        Edit Class
                    </button>
                    <button type="button" @onclick="() => _selectedClass = null"
                            class="px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 bg-slate-100 dark:bg-slate-800 rounded-xl transition-all cursor-pointer">
                        Close
                    </button>
                </div>
            </div>
        </FooterTemplate>
    </Modal>
}

<!-- Delete Confirmation Modal -->
@if (_classToDelete != null)
{
    <Modal IsOpen="true" 
           Title="Delete Class" 
           Subtitle="Are you sure you want to delete this class?" 
           MaxWidth="max-w-sm" 
           OnClose="() => _classToDelete = null">
        <ChildContent>
            <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
                <p>This will soft-delete <span class="font-bold text-slate-900 dark:text-white">@_classToDelete.Name</span> (@_classToDelete.Code).</p>
                <p class="text-[11px] text-slate-400">If active batches exist, deletion will be rejected to protect your academic records.</p>
            </div>
        </ChildContent>
        <FooterTemplate>
            <div class="flex items-center justify-end gap-2 w-full">
                <button type="button" @onclick="() => _classToDelete = null"
                        class="px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 bg-slate-100 dark:bg-slate-800 rounded-xl transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="DeleteClassAsync"
                        disabled="@_isDeleting"
                        class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-md shadow-rose-600/20 transition-all cursor-pointer disabled:opacity-50">
                    @(_isDeleting ? "Deleting..." : "Delete Class")
                </button>
            </div>
        </FooterTemplate>
    </Modal>
}

@code {
    private List<ClassDto> _classes = new();

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Statuses"),
        new("true", "Active Only"),
        new("false", "Inactive Only")
    };
    private bool _isLoading = true;
    private string _viewMode = "table";

    private readonly TableQueryState _query = new();
    private TableSortState _sortState => _query.SortState;
    private string _searchQuery = string.Empty;
    private bool? _selectedStatus;
    private int _totalRecords = 0;

    private bool _showAddEditModal = false;
    private bool _isDrawerOpen = false;
    private bool _isSaving = false;
    private ClassDto? _editingClass;
    private ClassFormModel _formModel = new();

    private ClassDto? _selectedClass;
    private ClassDto? _classToDelete;
    private bool _isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadClassesAsync(1);
    }

    private async Task LoadClassesAsync(int pageNumber = 1)
    {
        _isLoading = true;
        _query.PageNumber = pageNumber;

        try
        {
            _query.Search = _searchQuery;
            var pagedReq = _query.ToPagedRequest();

            var res = await BranchClassService.GetClassesPagedAsync(pagedReq, _selectedStatus);
            if (res.Success && res.Data != null)
            {
                _classes = res.Data.Items;
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _classes = new();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading classes: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadClassesAsync(1);
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadClassesAsync(1);
        }
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadClassesAsync(1);
    }

    private async Task HandleStatusChanged(string val)
    {
        if (string.IsNullOrEmpty(val)) _selectedStatus = null;
        else _selectedStatus = bool.Parse(val);
        await LoadClassesAsync(1);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadClassesAsync(1);
    }

    private async Task OpenAddDrawerAsync()
    {
        _editingClass = null;
        _formModel = new ClassFormModel { IsActive = true };
        _showAddEditModal = true;
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenEditDrawerAsync(ClassDto cls)
    {
        _editingClass = cls;
        _formModel = new ClassFormModel
        {
            Id = cls.Id,
            Name = cls.Name,
            Code = cls.Code,
            Description = cls.Description,
            IsActive = cls.IsActive
        };
        _showAddEditModal = true;
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showAddEditModal = false;
        _editingClass = null;
        StateHasChanged();
    }

    private async Task SaveClassAsync()
    {
        _isSaving = true;
        try
        {
            if (_editingClass == null)
            {
                var req = new CreateClassRequest
                {
                    Name = _formModel.Name,
                    Code = _formModel.Code,
                    Description = _formModel.Description
                };
                var res = await BranchClassService.CreateClassAsync(req);
                if (res.Success)
                {
                    Toast.Success("Class created successfully.");
                    await CloseDrawerAsync();
                    await LoadClassesAsync(1);
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to create class.");
                }
            }
            else
            {
                var req = new UpdateClassRequest
                {
                    Id = _formModel.Id,
                    Name = _formModel.Name,
                    Code = _formModel.Code,
                    Description = _formModel.Description,
                    IsActive = _formModel.IsActive
                };
                var res = await BranchClassService.UpdateClassAsync(_formModel.Id, req);
                if (res.Success)
                {
                    Toast.Success("Class updated successfully.");
                    await CloseDrawerAsync();
                    await LoadClassesAsync(_query.PageNumber);
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to update class.");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error saving class: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleStatusAsync(ClassDto cls)
    {
        try
        {
            var res = await BranchClassService.ToggleClassStatusAsync(cls.Id);
            if (res.Success)
            {
                cls.IsActive = !cls.IsActive;
                Toast.Success($"Class {(cls.IsActive ? "activated" : "deactivated")} successfully.");
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to toggle status.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
    }

    private void OpenViewModal(ClassDto cls)
    {
        _selectedClass = cls;
    }

    private void ConfirmDelete(ClassDto cls)
    {
        _classToDelete = cls;
    }

    private async Task DeleteClassAsync()
    {
        if (_classToDelete == null) return;
        _isDeleting = true;
        try
        {
            var res = await BranchClassService.DeleteClassAsync(_classToDelete.Id);
            if (res.Success)
            {
                Toast.Success("Class deleted successfully.");
                _classToDelete = null;
                await LoadClassesAsync(1);
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to delete class.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error deleting class: {ex.Message}");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "C";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    public class ClassFormModel
    {
        public Guid Id { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Class Name is required.")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Class Code is required.")]
        public string Code { get; set; } = string.Empty;

        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private void ExportCsv()
    {
        Toast.Info("Exporting branch classes list to CSV...");
    }
}
