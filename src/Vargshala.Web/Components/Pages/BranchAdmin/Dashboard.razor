@page "/branch"
@attribute [Authorize(Roles = "BranchAdmin,4")]
@using Microsoft.AspNetCore.Components.Web
@using Vargshala.Contracts.BranchAdmin
@using Vargshala.Contracts.Common
@using Vargshala.Web.Common
@using Vargshala.Web.Services
@using Vargshala.Web.Services.BranchAdmin
@inject IBranchDashboardClientService DashboardService
@inject INotificationService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Dashboard | Vargshala</PageTitle>

<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-6 transition-colors duration-200 pb-20 select-none">
    
    <!-- Top Dashboard Action Bar with DateRangePicker & Coral Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Overview &amp; Analytics</h2>
                @if (!string.IsNullOrWhiteSpace(_stats.BranchName))
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
                        @_stats.BranchName (@_stats.BranchCode)
                    </span>
                }
            </div>
            <AuthorizeView>
                <Authorized>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Welcome back, @(context.User.Identity?.Name ?? "Branch Admin")! Here is what is happening today.</p>
                </Authorized>
                <NotAuthorized>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Welcome back! Here is what is happening today.</p>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="flex items-center gap-3">
            <!-- Blazor DateRangePicker Component -->
            <DateRangePicker RangeText="@_dateRangeText" />

            <!-- Blazor Button Component (Coral Variant) -->
            <Button Variant="Button.ButtonVariant.Coral" 
                    Text="Export" 
                    Icon="Export" 
                    OnClick="HandleExport" />
        </div>
    </div>

    <!-- Vargshala Institute Hero Showcase Banner with Section.svg -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#004D40] via-[#00382E] to-[#002B23] border border-teal-700/60 shadow-xl p-5 sm:p-6 text-white flex flex-col lg:flex-row items-center justify-between gap-6">
        <!-- Ambient Glowing Background Spheres -->
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-[#009488]/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-3 max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-900/80 border border-teal-500/40 text-[11px] font-bold text-teal-300">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                @(!string.IsNullOrWhiteSpace(_stats.BranchName) ? $"{_stats.BranchName} Operations Active" : "Branch Operations Active")
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
                Welcome to <span class="text-[#2DD4BF]">@(!string.IsNullOrWhiteSpace(_stats.BranchName) ? _stats.BranchName : "Vargshala")</span>
            </h1>
            <p class="text-xs sm:text-sm text-teal-200/90 leading-relaxed">
                Streamlined multi-tenant coaching &amp; institute automation. Monitor student admissions, live classroom batches, fee collections, and staff analytics in real time.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="branch/students" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white text-xs font-bold shadow-md transition-all">
                    <span>+ New Admission</span>
                </a>
                <a href="branch/batches" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-teal-500/30 text-white text-xs font-semibold transition-all">
                    <span>View Batches</span>
                </a>
            </div>
        </div>

        <div class="relative z-10 w-full lg:w-auto flex justify-center lg:justify-end shrink-0">
            <img src="images/Section.svg" alt="Vargshala Institutes" class="w-full max-w-sm sm:max-w-md lg:max-w-lg h-auto object-contain drop-shadow-2xl hover:scale-[1.02] transition-transform duration-300" />
        </div>
    </div>

    <!-- 4 Key Metric Cards (Blazor MetricCard Components) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <MetricCard Title="Total Students" 
                    Value="@_stats.TotalStudents.ToString("N0")" 
                    Trend="12.5%" 
                    IsPositiveTrend="true" 
                    Subtitle="enrolled in branch" 
                    Icon="Students" />

        <MetricCard Title="Total Teachers" 
                    Value="@_stats.TotalTeachers.ToString("N0")" 
                    Trend="8.4%" 
                    IsPositiveTrend="true" 
                    Subtitle="assigned faculty" 
                    Icon="Teachers" />

        <MetricCard Title="Total Classes" 
                    Value="@_stats.TotalClasses.ToString("N0")" 
                    Trend="11.3%" 
                    IsPositiveTrend="true" 
                    Subtitle="active standards" 
                    Icon="Classes" />

        <MetricCard Title="Attendance" 
                    Value="@($"{_stats.TodayAttendancePercentage}%")" 
                    Trend="6.2%" 
                    IsPositiveTrend="true" 
                    Subtitle="today's present rate" 
                    Icon="Attendance" />

    </div>

    <!-- Middle Section: AttendanceChart Component + RecentActivitiesCard Component -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Blazor AttendanceChart Component (7 cols) -->
        <div class="lg:col-span-7">
            <AttendanceChart Title="Attendance Overview" 
                             CurrentMonthLabel="This Month" 
                             LastMonthLabel="Last Month" />
        </div>

        <!-- Blazor RecentActivitiesCard Component (5 cols) -->
        <div class="lg:col-span-5">
            <RecentActivitiesCard Title="Recent Activities" 
                                  ViewAllUrl="branch/attendance" 
                                  Activities="GetRecentActivities()" />
        </div>

    </div>

    <!-- Quick Links Grid using Blazor QuickLinkCard Components -->
    <div class="card-surface p-6">
        <h2 class="font-bold text-base text-slate-800 dark:text-white mb-4">Quick Links</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            
            <QuickLinkCard Title="Students" 
                           Subtitle="Manage students" 
                           Href="branch/students" 
                           Icon="Students" 
                           IconBgClass="bg-teal-50" 
                           IconTextClass="text-brand-600" />

            <QuickLinkCard Title="Teachers" 
                           Subtitle="Manage teachers" 
                           Href="branch/teachers" 
                           Icon="Teachers" 
                           IconBgClass="bg-emerald-50" 
                           IconTextClass="text-emerald-600" />

            <QuickLinkCard Title="Classes" 
                           Subtitle="Manage classes" 
                           Href="branch/classes" 
                           Icon="Classes" 
                           IconBgClass="bg-blue-50" 
                           IconTextClass="text-blue-600" />

            <QuickLinkCard Title="Batches" 
                           Subtitle="Manage batches" 
                           Href="branch/batches" 
                           Icon="Classes" 
                           IconBgClass="bg-purple-50" 
                           IconTextClass="text-purple-600" />

            <QuickLinkCard Title="Attendance" 
                           Subtitle="Record attendance" 
                           Href="branch/attendance" 
                           Icon="Attendance" 
                           IconBgClass="bg-coral-50" 
                           IconTextClass="text-coral-500" />

            <QuickLinkCard Title="Sessions" 
                           Subtitle="View timetable" 
                           Href="branch/class-sessions" 
                           Icon="Reports" 
                           IconBgClass="bg-amber-50" 
                           IconTextClass="text-amber-500" />

        </div>
    </div>

    <!-- Recent Class Sessions Section -->
    <div class="rounded-3xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
            <div>
                <h3 class="text-sm font-bold text-slate-800 dark:text-white tracking-tight">Recent &amp; Upcoming Sessions</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Live timetable and session registers for this branch</p>
            </div>
            <a href="branch/class-sessions" class="text-xs font-bold text-[#009488] hover:underline flex items-center gap-1">
                <span>View Full Schedule →</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full table-fixed text-left text-xs">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-[#18262c]/60 border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400">
                        <th class="py-3 px-4 w-[25%]">Batch &amp; Class</th>
                        <th class="py-3 px-4 w-[20%]">Subject</th>
                        <th class="py-3 px-4 w-[20%]">Faculty</th>
                        <th class="py-3 px-4 w-[15%]">Timing</th>
                        <th class="py-3 px-4 w-[10%]">Status</th>
                        <th class="py-3 px-4 w-[10%] text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
                    @if (!_stats.RecentSessions.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                                No class sessions scheduled yet in this branch.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var session in _stats.RecentSessions)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-[#18262c]/40 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-bold text-slate-800 dark:text-white truncate">@session.BatchName</div>
                                    <div class="text-[10px] text-slate-400 truncate">@session.ClassName</div>
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 truncate">
                                    @session.SubjectName
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 truncate">
                                    @session.TeacherName
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 text-[11px]">
                                    <div>@session.Date.ToString("dd MMM yyyy")</div>
                                    <div class="text-[10px] text-slate-400">@session.StartTime.ToString("hh:mm tt") - @session.EndTime.ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold @GetStatusBadgeClass(session.Status)">
                                        @session.Status
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <a href="branch/attendance?batchId=@session.Id"
                                       class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] hover:bg-teal-100 transition-all">
                                        Mark
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private BranchDashboardDto _stats = new();
    private string _dateRangeText = "01 May, 2026 – 31 May, 2026";

    private readonly List<RecentActivitiesCard.ActivityItemModel> _defaultActivities = new()
    {
        new()
        {
            Title = "New student added",
            Subtitle = "Aryan Kapoor",
            TimeAgo = "2 min ago",
            Type = RecentActivitiesCard.ActivityType.Student
        },
        new()
        {
            Title = "Assignment submitted",
            Subtitle = "TH JEE Batch - Physics",
            TimeAgo = "1 hour ago",
            Type = RecentActivitiesCard.ActivityType.Assignment
        },
        new()
        {
            Title = "Class session scheduled",
            Subtitle = "TH Foundation 10 - Math",
            TimeAgo = "3 hours ago",
            Type = RecentActivitiesCard.ActivityType.Exam
        },
        new()
        {
            Title = "Attendance marked",
            Subtitle = "TH Physics 12",
            TimeAgo = "5 hours ago",
            Type = RecentActivitiesCard.ActivityType.Fee
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        var start = new DateTime(now.Year, now.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        _dateRangeText = $"{start:dd MMM, yyyy} – {end:dd MMM, yyyy}";

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var response = await DashboardService.GetDashboardStatsAsync();
            if (response.Success && response.Data != null)
            {
                _stats = response.Data;
            }
            else
            {
                Toast.Error(response.Message ?? "Could not load branch dashboard stats.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Failed to fetch branch dashboard: " + ex.Message);
        }
    }

    private List<RecentActivitiesCard.ActivityItemModel> GetRecentActivities()
    {
        var list = new List<RecentActivitiesCard.ActivityItemModel>();
        if (_stats.RecentSessions != null && _stats.RecentSessions.Any())
        {
            foreach (var s in _stats.RecentSessions.Take(4))
            {
                list.Add(new RecentActivitiesCard.ActivityItemModel
                {
                    Title = $"{s.BatchName} - {s.SubjectName}",
                    Subtitle = $"Faculty: {s.TeacherName} • Status: {s.Status}",
                    TimeAgo = s.Date == DateOnly.FromDateTime(DateTime.UtcNow) ? "Today" : s.Date.ToString("dd MMM"),
                    Type = s.Status == "Completed" ? RecentActivitiesCard.ActivityType.Assignment : RecentActivitiesCard.ActivityType.Exam
                });
            }
        }

        if (!list.Any())
        {
            list.AddRange(_defaultActivities);
        }

        return list;
    }

    private void HandleExport()
    {
        Toast.Info("Exporting branch analytics report...");
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
            "Cancelled" => "bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800",
            "Ongoing" or "In-Progress" => "bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800",
            _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
        };
    }
}
