@page "/branch"
@attribute [Authorize(Roles = "BranchAdmin,4")]
@using Microsoft.AspNetCore.Components.Web
@using Vargshala.Contracts.BranchAdmin
@using Vargshala.Contracts.Common
@using Vargshala.Web.Common
@using Vargshala.Web.Services
@using Vargshala.Web.Services.BranchAdmin
@inject IBranchDashboardClientService DashboardService
@inject INotificationService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Branch Dashboard | Vargshala</PageTitle>

<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-6 transition-colors duration-200 pb-20 select-none">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Branch Operations & Overview</h1>
                @if (!string.IsNullOrWhiteSpace(_stats.BranchName))
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
                        @_stats.BranchName (@_stats.BranchCode)
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Real-time metrics, active batches, and attendance registers for your assigned branch.
            </p>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="branch/attendance" 
               class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] transition-all shadow-2xs flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                </svg>
                <span>Attendance Register</span>
            </a>

            <a href="branch/class-sessions" 
               class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Live Sessions</span>
            </a>
        </div>
    </div>

    <!-- Branch Showcase Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#004D40] via-[#00382E] to-[#002B23] border border-teal-700/60 shadow-xl p-5 sm:p-6 text-white flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-[#009488]/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-3 max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-900/80 border border-teal-500/40 text-[11px] font-bold text-teal-300">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Single Branch Isolation Active
            </div>
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
                @(!string.IsNullOrWhiteSpace(_stats.BranchName) ? _stats.BranchName : "Branch Management")
            </h2>
            <p class="text-xs sm:text-sm text-teal-200/90 leading-relaxed">
                Branch academic control center. Monitor student rosters, faculty allocations, batch schedules, and classroom sessions securely within this branch.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="branch/students" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white text-xs font-bold shadow-md transition-all">
                    <span>Manage Students</span>
                </a>
                <a href="branch/batches" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-teal-500/30 text-white text-xs font-semibold transition-all">
                    <span>View Batches</span>
                </a>
            </div>
        </div>

        <!-- Metric Highlight Badge -->
        <div class="relative z-10 w-full lg:w-auto shrink-0 bg-white/10 dark:bg-black/20 backdrop-blur-md rounded-2xl p-5 border border-white/10 flex items-center justify-around gap-6">
            <div class="text-center">
                <p class="text-[11px] text-teal-200 uppercase tracking-wider font-semibold">Today's Sessions</p>
                <p class="text-2xl font-black text-white mt-0.5">@_stats.TodaySessionsCount</p>
            </div>
            <div class="w-px h-10 bg-white/15"></div>
            <div class="text-center">
                <p class="text-[11px] text-teal-200 uppercase tracking-wider font-semibold">Attendance Rate</p>
                <p class="text-2xl font-black text-emerald-300 mt-0.5">@_stats.TodayAttendancePercentage%</p>
            </div>
        </div>
    </div>

    <!-- 6 Direct KPI Stat Cards (No blinking layout shift) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        <!-- 1. Students -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Students</span>
                <span class="w-7 h-7 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-[#009488] flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TotalStudents</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Academic Roster</p>
        </div>

        <!-- 2. Faculty -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Faculty</span>
                <span class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TotalTeachers</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Assigned Teachers</p>
        </div>

        <!-- 3. Classes -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Classes</span>
                <span class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TotalClasses</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Standards & Grades</p>
        </div>

        <!-- 4. Batches -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Batches</span>
                <span class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TotalBatches</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Active Cohorts</p>
        </div>

        <!-- 5. Today's Sessions -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Today Sessions</span>
                <span class="w-7 h-7 rounded-lg bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TodaySessionsCount</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Scheduled Today</p>
        </div>

        <!-- 6. Attendance Rate -->
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Attendance</span>
                <span class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </span>
            </div>
            <div class="text-xl font-extrabold text-slate-800 dark:text-white mt-2">@_stats.TodayAttendancePercentage%</div>
            <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-medium">Present Rate</p>
        </div>
    </div>

    <!-- Recent Class Sessions Section -->
    <div class="rounded-3xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-xs overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
            <div>
                <h3 class="text-sm font-bold text-slate-800 dark:text-white tracking-tight">Recent & Upcoming Sessions</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Live timetable and session registers for this branch</p>
            </div>
            <a href="branch/class-sessions" class="text-xs font-bold text-[#009488] hover:underline flex items-center gap-1">
                <span>View Full Schedule →</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full table-fixed text-left text-xs">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-[#18262c]/60 border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400">
                        <th class="py-3 px-4 w-[25%]">Batch & Class</th>
                        <th class="py-3 px-4 w-[20%]">Subject</th>
                        <th class="py-3 px-4 w-[20%]">Faculty</th>
                        <th class="py-3 px-4 w-[15%]">Timing</th>
                        <th class="py-3 px-4 w-[10%]">Status</th>
                        <th class="py-3 px-4 w-[10%] text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
                    @if (!_stats.RecentSessions.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                                No class sessions scheduled yet in this branch.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var session in _stats.RecentSessions)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-[#18262c]/40 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-bold text-slate-800 dark:text-white truncate">@session.BatchName</div>
                                    <div class="text-[10px] text-slate-400 truncate">@session.ClassName</div>
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 truncate">
                                    @session.SubjectName
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 truncate">
                                    @session.TeacherName
                                </td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300 text-[11px]">
                                    <div>@session.Date.ToString("dd MMM yyyy")</div>
                                    <div class="text-[10px] text-slate-400">@session.StartTime.ToString("hh:mm tt") - @session.EndTime.ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold @GetStatusBadgeClass(session.Status)">
                                        @session.Status
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <a href="branch/attendance?batchId=@session.Id"
                                       class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] hover:bg-teal-100 transition-all">
                                        Mark
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private BranchDashboardDto _stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var response = await DashboardService.GetDashboardStatsAsync();
            if (response.Success && response.Data != null)
            {
                _stats = response.Data;
            }
            else
            {
                Toast.Error(response.Message ?? "Could not load branch dashboard stats.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Failed to fetch branch dashboard: " + ex.Message);
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
            "Cancelled" => "bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800",
            "Ongoing" or "In-Progress" => "bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800",
            _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
        };
    }
}
