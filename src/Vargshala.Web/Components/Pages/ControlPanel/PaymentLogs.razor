@page "/controlpanel/payment-logs"
@page "/controlpanel/payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@rendermode InteractiveServer

@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Payments
@using Vargshala.Contracts.Subscriptions
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services

@inject IPaymentLogService PaymentLogService
@inject INotificationService Toast
@inject IJSRuntime JS

<PageTitle>Payment Logs &amp; Gateway Transactions | Control Panel</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header & Action Controls (Matched with Users.razor gold standard) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">💳</span>
                Payment Logs &amp; Gateway Transactions
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                Real-time audit of Razorpay, UPI, credit card transactions, webhook events, and settlement logs.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" 
                    @onclick="ExportCsvAsync"
                    class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs hover:shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="SyncGatewayLogsAsync"
                    disabled="@_isSyncing"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer disabled:opacity-60">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white @(_isSyncing ? "animate-spin" : "group-hover:rotate-180") transition-transform duration-300">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                </span>
                <span>@(_isSyncing ? "Syncing..." : "Sync Gateway")</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Gold standard: NO layout shift or text blinking) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5 border border-tealborder shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Volume (30d)</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">₹@_stats.TotalVolume30Days.ToString("N0")</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5 border border-tealborder shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Success Rate</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_stats.SuccessRate.ToString("F1")%</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5 border border-tealborder shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/80 text-rose-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Failed / Dropoffs</p>
                <h3 class="text-lg font-extrabold text-rose-600 dark:text-rose-400">@_stats.FailedCount</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5 border border-tealborder shadow-2xs">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Transactions</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">@_stats.TotalTransactionsCount</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card-surface p-3.5 border border-tealborder shadow-xs flex flex-col md:flex-row items-center justify-between gap-3">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-96">
            <SearchInput @bind-Value="_query.Search" 
                         OnSearch="() => LoadDataAsync(1)" 
                         Placeholder="Search Payment ID, Order ID, institute, or email..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2.5 w-full md:w-auto">
            <div class="w-48">
                <CustomSelect Value="@_selectedMethod" 
                              ValueChanged="HandleMethodFilterChangedAsync" 
                              Options="_methodFilterOptions" 
                              Placeholder="All Payment Methods" />
            </div>
            <div class="w-40">
                <CustomSelect Value="@_selectedStatus" 
                              ValueChanged="HandleStatusFilterChangedAsync" 
                              Options="_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Payments Data Table (Pixel-Matched Layout, Zero Blinking Header, table-fixed) -->
    <div class="card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden rounded-2xl">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[22%] py-3 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("PaymentId")'>
                            <div class="flex items-center gap-1.5">
                                <span>Payment / Order ID</span>
                                <span class="@_sortState.GetIndicatorClass("PaymentId")">@_sortState.GetIndicator("PaymentId")</span>
                            </div>
                        </th>
                        <th class="w-[22%] py-3 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Institute")'>
                            <div class="flex items-center gap-1.5">
                                <span>Coaching Institute</span>
                                <span class="@_sortState.GetIndicatorClass("Institute")">@_sortState.GetIndicator("Institute")</span>
                            </div>
                        </th>
                        <th class="w-[13%] py-3 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Amount")'>
                            <div class="flex items-center gap-1.5">
                                <span>Amount</span>
                                <span class="@_sortState.GetIndicatorClass("Amount")">@_sortState.GetIndicator("Amount")</span>
                            </div>
                        </th>
                        <th class="w-[12%] py-3 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Method")'>
                            <div class="flex items-center gap-1.5">
                                <span>Method</span>
                                <span class="@_sortState.GetIndicatorClass("Method")">@_sortState.GetIndicator("Method")</span>
                            </div>
                        </th>
                        <th class="w-[15%] py-3 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Date")'>
                            <div class="flex items-center gap-1.5">
                                <span>Date (UTC)</span>
                                <span class="@_sortState.GetIndicatorClass("Date")">@_sortState.GetIndicator("Date")</span>
                            </div>
                        </th>
                        <th class="w-[8%] py-3 px-3 text-center">Status</th>
                        <th class="w-[8%] py-3 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _payments.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_payments.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="8" />
                    }
                    else if (_payments.Any())
                    {
                        @foreach (var p in _payments)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors group">
                                <!-- Payment ID & Order ID -->
                                <td class="py-3 px-5 font-mono">
                                    <div class="font-bold text-slate-800 dark:text-white truncate flex items-center gap-1.5" title="@p.ReceiptNumber">
                                        <span>@(string.IsNullOrWhiteSpace(p.ReceiptNumber) ? p.PaymentId.ToString("N")[..8].ToUpperInvariant() : p.ReceiptNumber)</span>
                                    </div>
                                    <div class="text-[10px] text-slate-400 font-mono truncate" title="@p.OrderId">
                                        @(string.IsNullOrWhiteSpace(p.OrderId) ? (p.TransactionReference ?? "-") : p.OrderId)
                                    </div>
                                </td>

                                <!-- Institute & Payer Email -->
                                <td class="py-3 px-4">
                                    <div class="font-bold text-slate-800 dark:text-white truncate" title="@p.InstituteName">
                                        @p.InstituteName
                                    </div>
                                    <div class="text-[11px] text-slate-400 truncate" title="@p.PayerEmail">
                                        @(string.IsNullOrWhiteSpace(p.PayerEmail) ? "-" : p.PayerEmail)
                                    </div>
                                </td>

                                <!-- Amount -->
                                <td class="py-3 px-4 font-black text-sm text-slate-800 dark:text-white">
                                    @(p.Amount == 0 ? "Free" : $"₹{p.Amount:N2}")
                                </td>

                                <!-- Method Badge -->
                                <td class="py-3 px-4">
                                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-[#18262c] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                        @p.PaymentMethod
                                    </span>
                                </td>

                                <!-- Timestamp -->
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300">
                                    <div class="font-semibold text-slate-800 dark:text-white leading-tight">
                                        @p.PaymentDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="text-[10px] text-slate-400 mt-0.5 leading-none font-mono">
                                        @p.PaymentDate.ToString("hh:mm tt")
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3 px-3 text-center">
                                    @if (p.Status.Equals("Captured", StringComparison.OrdinalIgnoreCase) || 
                                         p.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) || 
                                         p.Status.Equals("Success", StringComparison.OrdinalIgnoreCase) ||
                                         p.Status.Equals("Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                                            Success
                                        </span>
                                    }
                                    else if (p.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800" title="@p.FailureReason">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1"></span>
                                            Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 dark:bg-amber-950/70 text-amber-700 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800">
                                            @p.Status
                                        </span>
                                    }
                                </td>

                                <!-- Action Menu (Dropdown exact like gold standard) -->
                                <td class="py-3 px-5 text-right relative">
                                    <div class="inline-block text-left">
                                        <button type="button" 
                                                @onclick="() => ToggleMenu(p.PaymentId)" 
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                            <svg class="w-4 h-4 font-extrabold" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M6 10a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4z"/>
                                            </svg>
                                        </button>

                                        @if (_activeMenuPaymentId == p.PaymentId)
                                        {
                                            <div class="fixed inset-0 z-30" @onclick="() => _activeMenuPaymentId = null"></div>
                                            <div class="absolute right-0 top-full mt-1 w-52 rounded-2xl bg-white dark:bg-[#111c21] shadow-2xl border border-slate-200/90 dark:border-slate-800 py-2 z-40 text-left animate-in fade-in zoom-in-95 duration-150 select-none">
                                                <button type="button" 
                                                        @onclick="() => OpenDetailDrawer(p)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-[#18262c] flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                    <span>View Gateway Details</span>
                                                </button>
                                                <button type="button" 
                                                        @onclick='() => CopyTextAsync(p.TransactionReference ?? p.PaymentId.ToString(), "Payment ID")'
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-[#18262c] flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                    <span>Copy Payment Reference</span>
                                                </button>
                                                <div class="my-1.5 border-t border-slate-100 dark:border-slate-800"></div>
                                                <button type="button" 
                                                        @onclick="() => DownloadReceiptAsync(p)"
                                                        disabled="@(_downloadingReceiptId == p.PaymentId)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-teal-600 dark:text-teal-400 hover:bg-teal-50/80 dark:hover:bg-teal-950/50 flex items-center gap-2.5 transition-colors cursor-pointer disabled:opacity-50">
                                                    @if (_downloadingReceiptId == p.PaymentId)
                                                    {
                                                        <svg class="w-3.5 h-3.5 animate-spin text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                        </svg>
                                                        <span>Generating PDF...</span>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-3.5 h-3.5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                                        <span>Download Receipt (PDF)</span>
                                                    }
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No transactions found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber" 
                             PageSize="_query.PageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="transactions"
                             IsLoading="_isLoading"
                             OnPageSizeChanged="HandlePageSizeChangedAsync"
                             OnPageChanged="HandlePageChangedAsync" />
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Transaction Gateway Details (Exact Match with Students.razor) -->
<!-- ========================================================================= -->
@if (_showDetailDrawer && _selectedPayment != null)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🧾
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5 font-mono">
                        <span>@(string.IsNullOrWhiteSpace(_selectedPayment.ReceiptNumber) ? _selectedPayment.PaymentId.ToString("N")[..8].ToUpperInvariant() : _selectedPayment.ReceiptNumber)</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Razorpay Gateway Transaction Details
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
            <div class="card-surface p-4 space-y-2.5 rounded-2xl border border-tealborder">
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Payment ID:</span> 
                    <span class="font-mono font-bold text-[#009488]">@_selectedPayment.PaymentId</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Receipt / Invoice #:</span> 
                    <span class="font-mono text-slate-700 dark:text-slate-200 font-bold">@(string.IsNullOrWhiteSpace(_selectedPayment.ReceiptNumber) ? "-" : _selectedPayment.ReceiptNumber)</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Order ID:</span> 
                    <span class="font-mono text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(_selectedPayment.OrderId) ? "-" : _selectedPayment.OrderId)</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Gateway Ref:</span> 
                    <span class="font-mono text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(_selectedPayment.TransactionReference) ? "-" : _selectedPayment.TransactionReference)</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Institute Name:</span> 
                    <span class="font-bold text-slate-800 dark:text-white">@_selectedPayment.InstituteName</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Billing Email:</span> 
                    <span class="text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(_selectedPayment.PayerEmail) ? "-" : _selectedPayment.PayerEmail)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedPayment.PlanName))
                {
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400">Plan:</span> 
                        <span class="font-bold text-[#009488]">@_selectedPayment.PlanName</span>
                    </div>
                }
                <div class="flex justify-between items-center pt-2 border-t border-slate-100 dark:border-slate-800">
                    <span class="text-slate-400">Amount Charged:</span> 
                    <span class="font-black text-lg text-emerald-600">₹@_selectedPayment.Amount.ToString("N2")</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Payment Channel:</span> 
                    <span class="font-semibold text-slate-700 dark:text-slate-200">@_selectedPayment.PaymentMethod</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Date &amp; Time (UTC):</span> 
                    <span class="font-mono text-slate-600 dark:text-slate-400">@_selectedPayment.PaymentDate.ToString("dd MMM yyyy, hh:mm:ss tt")</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Gateway Status:</span> 
                    <span class="font-bold text-emerald-600">@_selectedPayment.Status</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_selectedPayment.FailureReason))
                {
                    <div class="flex justify-between items-center text-rose-500 pt-2 border-t border-rose-100 dark:border-rose-950/60">
                        <span class="text-slate-400">Error Description:</span>
                        <span class="font-bold">@_selectedPayment.FailureReason</span>
                    </div>
                }
            </div>

            <!-- Transaction Notes & Metadata -->
            @if (!string.IsNullOrWhiteSpace(_selectedPayment.Remarks))
            {
                <div class="card-surface p-4 space-y-2 rounded-2xl border border-tealborder">
                    <label class="block font-bold text-slate-700 dark:text-slate-300">Transaction Notes &amp; Metadata</label>
                    <p class="font-mono text-slate-700 dark:text-slate-200 text-xs bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/80 dark:border-slate-800">
                        @_selectedPayment.Remarks
                    </p>
                </div>
            }
        </div>

        <!-- Drawer Footer -->
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-between gap-3 shrink-0">
            <button type="button" 
                    @onclick="() => DownloadReceiptAsync(_selectedPayment)"
                    disabled="@(_downloadingReceiptId == _selectedPayment.PaymentId)"
                    class="px-4 py-2.5 rounded-xl border border-teal-500/40 text-[#009488] dark:text-teal-400 hover:bg-teal-50 dark:hover:bg-teal-950/40 text-xs font-bold transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50">
                @if (_downloadingReceiptId == _selectedPayment.PaymentId)
                {
                    <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Generating PDF...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>Download Tax Invoice</span>
                }
            </button>

            <button type="button" 
                    @onclick="CloseDrawerAsync"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                Close Window
            </button>
        </div>

    </div>
}

@code {
    private PagedRequest _query = new() { PageNumber = 1, PageSize = 10 };
    private int _totalRecords = 0;
    private bool _isLoading = false;
    private bool _isSyncing = false;
    private Guid? _downloadingReceiptId;

    private string _selectedMethod = "";
    private string _selectedStatus = "";
    private Guid? _activeMenuPaymentId;

    private readonly TableSortState _sortState = new();
    private List<PaymentLogDto> _payments = new();
    private PaymentLogsStatsDto _stats = new();

    private readonly List<CustomSelect.CustomSelectOption> _methodFilterOptions = new()
    {
        new("", "All Payment Methods"),
        new("Razorpay", "Razorpay"),
        new("UPI", "UPI / QR Code"),
        new("Card", "Credit / Debit Card"),
        new("NetBanking", "NetBanking")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Captured", "Captured / Success"),
        new("Failed", "Failed Only"),
        new("Refunded", "Refunded Only")
    };

    // Drawer state
    private bool _showDetailDrawer = false;
    private bool _isDrawerOpen = false;
    private PaymentLogDto? _selectedPayment;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync(1);
    }

    private async Task LoadDataAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = page;

        try
        {
            var pagedRequest = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = _query.Search,
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : _sortState.Direction == SortDirection.Ascending ? "asc" : null
            };

            var logsTask = PaymentLogService.GetPaymentLogsPagedAsync(
                pagedRequest,
                string.IsNullOrWhiteSpace(_selectedMethod) ? null : _selectedMethod,
                string.IsNullOrWhiteSpace(_selectedStatus) ? null : _selectedStatus);

            var statsTask = PaymentLogService.GetPaymentLogsStatsAsync();

            await Task.WhenAll(logsTask, statsTask);

            var logsRes = await logsTask;
            if (logsRes != null && logsRes.Success && logsRes.Data != null)
            {
                _payments = logsRes.Data.Items.ToList();
                _totalRecords = logsRes.Data.TotalRecords;
            }
            else
            {
                _payments = new();
                _totalRecords = 0;
                if (logsRes != null && !string.IsNullOrEmpty(logsRes.Message))
                {
                    Toast.Error(logsRes.Message);
                }
            }

            var statsRes = await statsTask;
            if (statsRes != null && statsRes.Success && statsRes.Data != null)
            {
                _stats = statsRes.Data;
            }
        }
        catch (Exception ex)
        {
            _payments = new();
            _totalRecords = 0;
            Toast.Error("Connection error while loading payment logs: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadDataAsync(1);
    }

    private async Task HandleMethodFilterChangedAsync(string selectedValue)
    {
        _selectedMethod = selectedValue;
        await LoadDataAsync(1);
    }

    private async Task HandleStatusFilterChangedAsync(string selectedValue)
    {
        _selectedStatus = selectedValue;
        await LoadDataAsync(1);
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        await LoadDataAsync(newPage);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadDataAsync(1);
    }

    private void ToggleMenu(Guid paymentId)
    {
        _activeMenuPaymentId = _activeMenuPaymentId == paymentId ? null : paymentId;
    }

    private async Task CopyTextAsync(string text, string label)
    {
        _activeMenuPaymentId = null;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success($"{label} copied to clipboard!");
        }
        catch
        {
            Toast.Info($"Copy: {text}");
        }
    }

    private async Task DownloadReceiptAsync(PaymentLogDto p)
    {
        _activeMenuPaymentId = null;
        if (_downloadingReceiptId.HasValue) return;

        _downloadingReceiptId = p.PaymentId;
        try
        {
            var pdfBytes = await PaymentLogService.GetSubscriptionReceiptPdfAsync(p.PaymentId);
            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                Toast.Error("Unable to generate receipt PDF. Please verify transaction details.");
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var safeReceipt = string.IsNullOrWhiteSpace(p.ReceiptNumber) ? p.PaymentId.ToString("N")[..8].ToUpperInvariant() : p.ReceiptNumber;
            var fileName = $"Vargshala_Tax_Invoice_{safeReceipt}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/pdf", base64);
            Toast.Success("Tax Invoice / Receipt downloaded successfully.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Receipt download failed: {ex.Message}");
        }
        finally
        {
            _downloadingReceiptId = null;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (!_payments.Any())
        {
            Toast.Info("No transactions available to export.");
            return;
        }

        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Payment ID,Receipt Number,Order ID,Gateway Reference,Institute Name,Payer Email,Amount (INR),Method,Status,Date (UTC),Failure Reason");

            foreach (var p in _payments)
            {
                var reason = (p.FailureReason ?? "").Replace("\"", "\"\"");
                var inst = p.InstituteName.Replace("\"", "\"\"");
                sb.AppendLine($"\"{p.PaymentId}\",\"{p.ReceiptNumber}\",\"{p.OrderId}\",\"{p.TransactionReference}\",\"{inst}\",\"{p.PayerEmail}\",{p.Amount},\"{p.PaymentMethod}\",\"{p.Status}\",\"{p.PaymentDate:yyyy-MM-dd HH:mm:ss}\",\"{reason}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Vargshala_PaymentLogs_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv;charset=utf-8", base64);
            Toast.Success("Payment logs exported to CSV.");
        }
        catch (Exception ex)
        {
            Toast.Error($"Export failed: {ex.Message}");
        }
    }

    private async Task SyncGatewayLogsAsync()
    {
        _isSyncing = true;
        try
        {
            await LoadDataAsync(_query.PageNumber);
            Toast.Success("Payment logs and gateway transactions synced.");
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task OpenDetailDrawer(PaymentLogDto p)
    {
        _activeMenuPaymentId = null;
        _selectedPayment = p;
        _showDetailDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(300);
        _showDetailDrawer = false;
    }
}
