    private List<PaymentTransaction> FilteredPayments
    {
        get
        {
            var query = _payments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(p => p.PaymentId.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         p.OrderId.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         p.InstituteName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         p.PayerEmail.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_selectedMethod))
            {
                query = query.Where(p => p.Method.Contains(_selectedMethod, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_selectedStatus))
            {
                query = query.Where(p => p.Status.Equals(_selectedStatus, StringComparison.OrdinalIgnoreCase) ||
                                         (_selectedStatus == "Captured" && p.Status == "Success"));
            }

            if (_sortState.IsSorted)
            {
                var isAsc = _sortState.Direction == SortDirection.Ascending;
                query = _sortState.Column switch
                {
                    "PaymentId" => isAsc ? query.OrderBy(p => p.PaymentId) : query.OrderByDescending(p => p.PaymentId),
                    "Institute" => isAsc ? query.OrderBy(p => p.InstituteName) : query.OrderByDescending(p => p.InstituteName),
                    "Amount" => isAsc ? query.OrderBy(p => p.Amount) : query.OrderByDescending(p => p.Amount),
                    "Method" => isAsc ? query.OrderBy(p => p.Method) : query.OrderByDescending(p => p.Method),
                    "Time" => isAsc ? query.OrderBy(p => p.Timestamp) : query.OrderByDescending(p => p.Timestamp),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

