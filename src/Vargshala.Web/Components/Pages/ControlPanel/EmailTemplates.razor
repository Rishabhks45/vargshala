@page "/controlpanel/email-templates"
@page "/controlpanel/templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.EmailTemplates
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Notifications
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Services
@inject IEmailTemplateService TemplateService
@inject INotificationService Toast
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>System Email Templates | Control Panel</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Actions -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    System Email Templates
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage transactional emails, automated receipts, password recoveries, and system notification templates
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" @onclick="OpenCreateDrawer"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                <span>New Template</span>
            </button>
        </div>
    </div>

    <!-- Live Page Alert Notification -->
    @if (!string.IsNullOrEmpty(_notificationMessage) || !string.IsNullOrEmpty(_errorMessage))
    {
        <div class="shrink-0 space-y-2">
            @if (!string.IsNullOrEmpty(_notificationMessage))
            {
                <AlertNotification Type="AlertType.Success"
                                   Message="@_notificationMessage"
                                   Dismissible="true"
                                   OnClose="() => _notificationMessage = null" />
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <AlertNotification Type="AlertType.Error"
                                   Message="@_errorMessage"
                                   Dismissible="true"
                                   OnClose="() => _errorMessage = null" />
            }
        </div>
    }

    <!-- 4 KPI Summary Cards -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Templates</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active &amp; Live</p>
                    <h3 class="text-2xl font-black text-emerald-600 mt-1">@_templates.Count(t => t.IsActive)</h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Billing &amp; Invoicing</p>
                    <h3 class="text-2xl font-black text-indigo-600 mt-1">@_templates.Count(t => t.Category == "Billing")</h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Auth &amp; Security</p>
                    <h3 class="text-2xl font-black text-purple-600 mt-1">@_templates.Count(t => t.Category == "Auth & Security")</h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Category Filters Bar -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <div class="relative w-full md:w-80">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" 
                   @bind="_query.Search" 
                   @bind:event="oninput" 
                   @bind:after="() => LoadTemplatesAsync(1)"
                   placeholder="Search template name, code, subject..." 
                   class="w-full pl-10 pr-4 py-2 text-xs rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-[#009488]" />
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-44">
                <CustomSelect
                              Value="@_selectedCategoryFilter"
                              ValueChanged="OnCategoryFilterChanged"
                              Options="@_categoryFilterOptions"
                              Placeholder="All Categories" />
            </div>

            <div class="w-36">
                <CustomSelect
                              Value="@_selectedStatusFilter"
                              ValueChanged="OnStatusFilterChanged"
                              Options="@_statusFilterOptions"
                              Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Email Templates Data Table (Fits screen height, internal scrolling with hidden scrollbar) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[760px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[28%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Template &amp; System Code</span>
                                <span class="@_sortState.GetIndicatorClass("name")">@_sortState.GetIndicator("name")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("category")'>
                            <div class="flex items-center gap-1.5">
                                <span>Category</span>
                                <span class="@_sortState.GetIndicatorClass("category")">@_sortState.GetIndicator("category")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("role")'>
                            <div class="flex items-center gap-1.5">
                                <span>Role</span>
                                <span class="@_sortState.GetIndicatorClass("role")">@_sortState.GetIndicator("role")</span>
                            </div>
                        </th>
                        <th class="w-[26%] py-2 px-3 select-none">Subject Line</th>
                        <th class="w-[10%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("status")">@_sortState.GetIndicator("status")</span>
                            </div>
                        </th>
                        <th class="w-[8%] py-2 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs @(_isLoading && _templates.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_templates.Any())
                    {
                        <TableSkeletonRows Columns="6" Rows="8" />
                    }
                    else if (_templates.Any())
                    {
                        @foreach (var tpl in _templates)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors group">
                                <td class="py-1.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-[#009488] flex items-center justify-center font-bold text-xs shrink-0 border border-teal-200 dark:border-teal-800/60">
                                            @switch (tpl.Category)
                                            {
                                                case "Onboarding":
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
                                                    </svg>
                                                    break;
                                                case "Auth & Security":
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                                                    </svg>
                                                    break;
                                                case "Billing":
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                                                    </svg>
                                                    break;
                                                default:
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                                    </svg>
                                                    break;
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <span class="font-bold text-slate-800 dark:text-slate-100 group-hover:text-[#009488] transition-colors leading-tight truncate block">
                                                @tpl.Name
                                            </span>
                                            <div class="text-[10px] font-mono text-slate-400 dark:text-slate-500 leading-none mt-0.5">
                                                @tpl.Code
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-1.5 px-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold @GetCategoryBadgeClass(tpl.Category)">
                                        @tpl.Category
                                    </span>
                                </td>
                                <td class="py-1.5 px-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold @GetRoleBadgeClass(tpl.TargetRole)">
                                        @(tpl.TargetRole?.GetDisplayName() ?? "All Roles")
                                    </span>
                                </td>
                                <td class="py-1.5 px-3 font-medium text-slate-700 dark:text-slate-200 max-w-xs truncate text-xs" title="@tpl.Subject">
                                    @tpl.Subject
                                </td>
                                <td class="py-1.5 px-3 text-center">
                                    <button type="button" 
                                            @onclick="() => ToggleStatusAsync(tpl)"
                                            title="Click to toggle status"
                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold cursor-pointer transition-all @(tpl.IsActive ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800")">
                                        <span class="w-1.5 h-1.5 rounded-full @(tpl.IsActive ? "bg-emerald-500 animate-pulse" : "bg-rose-500")"></span>
                                        @(tpl.IsActive ? "Active" : "Disabled")
                                    </button>
                                </td>
                                <td class="py-1.5 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Action 1: Edit Template -->
                                        <button type="button" 
                                                @onclick="() => OpenEditDrawer(tpl)"
                                                title="Edit Template"
                                                class="p-1 rounded-md text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>

                                        <!-- Action 3: Send Test Email -->
                                        <button type="button" 
                                                @onclick="() => OpenTestEmailModal(tpl)"
                                                title="Dispatch Test Email"
                                                class="p-1 rounded-md text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-[#009488] flex items-center justify-center mx-auto mb-3">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                    </svg>
                                </div>
                                <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">No email templates found matching filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component / Footer -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber" 
                             PageSize="_query.PageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="templates"
                             IsLoading="_isLoading"
                             OnPageChanged="HandlePageChangedAsync" 
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DRAWER: Create / Edit Template Slide-Over -->
<!-- ========================================================================= -->
@if (_showEditDrawer)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-teal-500/20 p-1 flex items-center justify-center shadow-md shrink-0 text-white">
                    @if (_isCreating)
                    {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                        </svg>
                    }
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight">
                        @(_isCreating ? "New Email Template" : $"Edit: {_editModel.Name}")
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Configure layout, dynamic tokens, and dispatch criteria
                    </p>
                </div>
            </div>

            <button type="button" @onclick="CloseDrawerAsync" class="p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <AlertNotification Type="AlertType.Error"
                                       Message="@_formError"
                                       Dismissible="true"
                                       OnClose="() => _formError = null" />
                }

                <!-- Top Row: Category, Target Role & Template Preset in 1 line -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Category *</label>
                        <CustomSelect
                                      Value="@_editModel.Category"
                                      ValueChanged="@OnModalCategoryChanged"
                                      Options="@_modalCategoryOptions"
                                      Placeholder="Select Category..." />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Target Role</label>
                        <CustomSelect
                                      Value="@_selectedModalRoleString"
                                      ValueChanged="@OnModalRoleChanged"
                                      Options="@_modalRoleOptions"
                                      Placeholder="Select Target Role..." />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Template Preset *</label>
                        <CustomSelect
                                      Value="@_selectedModalTemplatePreset"
                                      ValueChanged="@OnModalTemplatePresetChanged"
                                      Options="@_modalTemplateOptions"
                                      Placeholder="Select Template..." />
                    </div>
                </div>

                <!-- Row 2: System Code & Display Name in 1 line -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1 flex items-center justify-between">
                            <span>System Code</span>
                            <span class="text-[10px] text-slate-400 font-normal">Read-only</span>
                        </label>
                        <input type="text" @bind="_editModel.Code" readonly disabled placeholder="e.g. WELCOME_ONBOARDING"
                               class="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-[#18262c]/60 border border-slate-200 dark:border-slate-700 rounded-xl font-mono uppercase font-bold text-slate-500 dark:text-slate-400 focus:outline-none cursor-not-allowed select-none" />
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1 flex items-center justify-between">
                            <span>Display Name</span>
                            <span class="text-[10px] text-slate-400 font-normal">Read-only</span>
                        </label>
                        <input type="text" @bind="_editModel.Name" readonly disabled placeholder="e.g. Welcome & Onboarding"
                               class="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-[#18262c]/60 border border-slate-200 dark:border-slate-700 rounded-xl font-medium text-slate-600 dark:text-slate-300 focus:outline-none cursor-not-allowed select-none" />
                    </div>
                </div>

                <!-- Subject Line -->
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Subject Line *</label>
                    <input type="text" @bind="_editModel.Subject" @bind:event="oninput" placeholder="e.g. Welcome to {{InstituteName}}!"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl font-medium text-slate-800 dark:text-white focus:outline-none focus:border-[#009488]" />
                </div>

                <!-- Available Placeholders Editor (Add, Delete, Click to Insert) -->
                <div class="space-y-2 p-3 rounded-2xl bg-slate-50 dark:bg-[#142025] border border-slate-200 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <label class="font-bold text-slate-700 dark:text-slate-300">
                            Available Placeholders
                        </label>
                        <span class="text-[11px] text-teal-600 dark:text-teal-400 font-semibold">
                            @_currentTokens.Count dynamic tokens
                        </span>
                    </div>

                    <!-- Add New Placeholder Input Bar -->
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 font-mono text-slate-400 select-none text-xs">{{</span>
                            <input type="text" 
                                   @bind="_newCustomToken" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleTokenKeyDown"
                                   placeholder="EnterTokenName"
                                   class="w-full pl-7 pr-7 py-1.5 text-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl font-mono text-slate-800 dark:text-white focus:outline-none focus:border-[#009488]" />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 font-mono text-slate-400 select-none text-xs">}}</span>
                        </div>
                        <button type="button" 
                                @onclick="AddCustomToken" 
                                disabled="@(string.IsNullOrWhiteSpace(_newCustomToken))"
                                class="px-3.5 py-1.5 rounded-xl bg-[#009488] hover:bg-[#00796b] text-white text-xs font-bold transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5 shadow-xs shrink-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            <span>Add</span>
                        </button>
                    </div>

                    <!-- Chips with Click to Insert and Delete button -->
                    <div class="flex flex-wrap gap-1.5 p-2 rounded-xl bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 min-h-[44px] items-center">
                        @if (_currentTokens.Any())
                        {
                            @foreach (var token in _currentTokens)
                            {
                                <div class="inline-flex items-center gap-1 pl-2.5 pr-1.5 py-1 rounded-lg bg-slate-50 dark:bg-[#111c21] text-slate-700 dark:text-slate-200 text-[11px] font-mono border border-slate-200 dark:border-slate-700 shadow-2xs group hover:border-[#009488] transition-all">
                                    <button type="button" 
                                            @onclick="() => InsertToken(token)"
                                            title="Click to insert into HTML body"
                                            class="cursor-pointer hover:text-[#009488] transition-colors flex items-center gap-1">
                                        <span class="text-teal-600 font-bold">+</span>
                                        <span>@token</span>
                                    </button>
                                    <button type="button" 
                                            @onclick="() => RemoveToken(token)"
                                            title="Delete placeholder"
                                            class="text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/50 p-0.5 rounded transition-colors cursor-pointer ml-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-[11px] text-slate-400 dark:text-slate-500 italic px-1">
                                No placeholders yet. Type token name above and click "Add" or press Enter.
                            </span>
                        }
                    </div>
                </div>

                <!-- HTML Email Body Content with In-Place Code / Preview Tabs -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="font-bold text-slate-700 dark:text-slate-300">HTML Email Body Content *</label>
                        
                        <!-- Toggle tabs for HTML Body specifically: Code vs Preview -->
                        <div class="inline-flex p-0.5 rounded-lg bg-slate-100 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-[11px] font-bold">
                            <button type="button" 
                                    @onclick='() => _bodyPreviewMode = false'
                                    class="px-2.5 py-0.5 rounded-md transition-all cursor-pointer flex items-center gap-1 @(!_bodyPreviewMode ? "bg-white dark:bg-[#111c21] text-[#009488] shadow-2xs" : "text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                                <span>&lt;/&gt;</span>
                                <span>Code</span>
                            </button>
                            <button type="button" 
                                    @onclick='() => _bodyPreviewMode = true'
                                    class="px-2.5 py-0.5 rounded-md transition-all cursor-pointer flex items-center gap-1 @(_bodyPreviewMode ? "bg-white dark:bg-[#111c21] text-[#009488] shadow-2xs" : "text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                                <span>👁️</span>
                                <span>Preview</span>
                            </button>
                        </div>
                    </div>

                    @if (!_bodyPreviewMode)
                    {
                        <textarea @bind="_editModel.BodyHtml" @bind:event="oninput" rows="11" placeholder="<html><body>...</body></html>"
                                  class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl font-mono text-slate-800 dark:text-slate-100 focus:outline-none focus:border-[#009488] resize-y"></textarea>
                    }
                    else
                    {
                        <!-- Live Preview Frame inside the Textarea location -->
                        <div class="w-full min-h-[200px] max-h-[350px] overflow-y-auto p-3.5 bg-white border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 text-xs shadow-inner">
                            @if (string.IsNullOrWhiteSpace(_editModel.BodyHtml))
                            {
                                <div class="h-32 flex flex-col items-center justify-center text-slate-400 italic text-center">
                                    <span>No HTML content entered yet.</span>
                                    <span class="text-[10px] mt-1 text-slate-400 font-normal">Switch to "Code" tab to write or paste your HTML.</span>
                                </div>
                            }
                            else
                            {
                                @((MarkupString)GetLivePreviewHtml())
                            }
                        </div>
                    }
                </div>

                <div>
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input type="checkbox" @bind="_editModel.IsActive" class="w-4 h-4 rounded text-[#009488] focus:ring-[#009488] border-slate-300" />
                        <span class="font-bold text-slate-700 dark:text-slate-200">Enable and mark as active template</span>
                    </label>
                </div>
            </div>

            <!-- Drawer Footer -->
            <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-between gap-3 shrink-0">
                <button type="button" @onclick="CloseDrawerAsync" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SaveTemplateAsync" disabled="@_isSaving" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer disabled:opacity-50 flex items-center gap-2">
                    @if (_isSaving)
                    {
                        <div class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin"></div>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Template</span>
                    }
                </button>
            </div>
    </div>
}

