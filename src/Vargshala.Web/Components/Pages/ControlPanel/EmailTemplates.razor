@code {
    private readonly TableQueryState _query = new();
    private TableSortState _sortState => _query.SortState;
    private int _totalRecords = 0;
    private List<EmailTemplateDto> _templates = new();

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isSendingTest = false;
    private string _selectedCategoryFilter = "";
    private string _selectedStatusFilter = "";
    private string? _notificationMessage;
    private string? _errorMessage;
    private string? _formError;

    // Drawer state
    private bool _showEditDrawer = false;
    private bool _isDrawerOpen = false;
    private bool _isCreating = false;
    private bool _bodyPreviewMode = false;

    // Test Modal
    private bool _showTestModal = false;
    private EmailTemplateDto? _testTargetTemplate;
    private string _testRecipientEmail = "";

    // Edit Model
    private EmailTemplateDto _editModel = new();

    private List<CustomSelect.CustomSelectOption> _categoryFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _modalCategoryOptions = new();
    private string _selectedModalRoleString = "";
    private string _selectedModalTemplatePreset = "";

    private List<CustomSelect.CustomSelectOption> _modalRoleOptions = new();
    private List<CustomSelect.CustomSelectOption> _modalTemplateOptions = new();
    private List<string> _currentTokens = new();

    private List<CustomSelect.CustomSelectOption> _statusFilterOptions = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeDropdownOptions();
        await LoadTemplatesAsync(1);
    }

    private void InitializeDropdownOptions()
    {
        _categoryFilterOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", "All Categories")
        };
        foreach (EmailTemplateCategory cat in Enum.GetValues<EmailTemplateCategory>())
        {
            _categoryFilterOptions.Add(new(cat.ToString(), cat.GetDisplayName()));
        }

        _modalCategoryOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", "Select Category...")
        };
        foreach (EmailTemplateCategory cat in Enum.GetValues<EmailTemplateCategory>())
        {
            _modalCategoryOptions.Add(new(cat.GetDisplayName(), cat.GetDisplayName()));
        }

        _modalRoleOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", "Select Target Role (Audience)...")
        };
        foreach (UserRole role in Enum.GetValues<UserRole>())
        {
            _modalRoleOptions.Add(new(((int)role).ToString(), role.GetDisplayName()));
        }

        _statusFilterOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", "All Status"),
            new("Active", "Active Only"),
            new("Disabled", "Disabled Only")
        };

        UpdateModalTemplateOptions();
    }

    private async Task LoadTemplatesAsync(int page = 1)
    {
        _query.PageNumber = Math.Max(1, page);
        _isLoading = true;
        try
        {
            EmailTemplateCategory? category = null;
            if (!string.IsNullOrWhiteSpace(_selectedCategoryFilter) &&
                Enum.TryParse<EmailTemplateCategory>(_selectedCategoryFilter, out var cat))
            {
                category = cat;
            }

            bool? isActive = _selectedStatusFilter == "Active" ? true : _selectedStatusFilter == "Disabled" ? false : null;

            var res = await TemplateService.GetTemplatesPagedAsync(_query.ToPagedRequest(), category, isActive);
            if (res != null && res.Success && res.Data != null)
            {
                _templates = res.Data.Items ?? new List<EmailTemplateDto>();
                _totalRecords = res.Data.TotalRecords;
                _errorMessage = null;
            }
            else
            {
                _templates = new();
                _totalRecords = 0;
                var errorMsg = res?.Message ?? "Failed to load email templates.";
                _errorMessage = errorMsg;
                if (errorMsg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
                {
                    Toast.Error("Your session has expired or you are unauthorized. Please sign in again.", "Unauthorized");
                }
                else
                {
                    Toast.Error(errorMsg, "Error");
                }
            }
        }
        catch (Exception ex)
        {
            _templates = new();
            _totalRecords = 0;
            var errorMsg = ex.Message;
            _errorMessage = "Failed to load email templates: " + errorMsg;
            Toast.Error(errorMsg, "Error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnCategoryFilterChanged(string val)
    {
        _selectedCategoryFilter = val;
        await LoadTemplatesAsync(1);
    }

    private async Task OnStatusFilterChanged(string val)
    {
        _selectedStatusFilter = val;
        await LoadTemplatesAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _query.SortState.Toggle(column);
        await LoadTemplatesAsync(1);
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        await LoadTemplatesAsync(newPage);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadTemplatesAsync(1);
    }

    private void OnModalCategoryChanged(string newCategory)
    {
        _editModel.Category = newCategory;
        StateHasChanged();
    }

    private void OnModalRoleChanged(string roleVal)
    {
        _selectedModalRoleString = roleVal;
        if (int.TryParse(roleVal, out var intVal) && Enum.IsDefined(typeof(UserRole), (UserRole)intVal))
        {
            _editModel.TargetRole = (UserRole)intVal;
        }
        else
        {
            _editModel.TargetRole = null;
        }
        StateHasChanged();
    }

    private void OnModalTemplatePresetChanged(string presetCode)
    {
        _selectedModalTemplatePreset = presetCode;
        ApplyTemplatePreset(presetCode);
        StateHasChanged();
    }

    private void UpdateModalTemplateOptions()
    {
        _modalTemplateOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", "Select Template Preset...")
        };
        foreach (EmailTemplateName e in Enum.GetValues<EmailTemplateName>())
        {
            _modalTemplateOptions.Add(new(e.ToString(), e.GetDisplayName()));
        }
    }

    private void ApplyTemplatePreset(string presetCode)
    {
        if (string.IsNullOrWhiteSpace(presetCode))
        {
            _editModel.Name = "";
            _editModel.Code = "";
            _editModel.Subject = "";
            _editModel.BodyHtml = "";
            _editModel.Description = "";
            _currentTokens = new List<string>();
            _editModel.AvailablePlaceholders = new List<string>(_currentTokens);
            return;
        }

        var matched = EmailTemplateNameExtensions.FromSystemCodeOrDisplayName(presetCode);
        if (matched.HasValue)
        {
            var enumVal = matched.Value;
            _editModel.Name = enumVal.GetDisplayName();
            _editModel.Code = enumVal.ToSystemCode();

            // Load existing template data from database if already present
            var existing = _templates.FirstOrDefault(t => 
                t.Code.Equals(_editModel.Code, StringComparison.OrdinalIgnoreCase) ||
                t.Code.Equals(enumVal.GetDefaultCode(), StringComparison.OrdinalIgnoreCase) ||
                t.Name.Equals(_editModel.Name, StringComparison.OrdinalIgnoreCase));

            if (existing != null)
            {
                _editModel.Subject = existing.Subject;
                _editModel.BodyHtml = existing.BodyHtml;
                _editModel.Description = existing.Description;
                _currentTokens = existing.AvailablePlaceholders != null 
                    ? new List<string>(existing.AvailablePlaceholders) 
                    : new List<string>();
            }
            else
            {
                _editModel.Subject = "";
                _editModel.BodyHtml = "";
                _editModel.Description = "";
                _currentTokens = new List<string>();
            }

            _editModel.AvailablePlaceholders = new List<string>(_currentTokens);
            return;
        }

        if (string.IsNullOrWhiteSpace(_editModel.Name))
            _editModel.Name = presetCode;
        _editModel.Code = EmailTemplateNameExtensions.ToSystemCode(_editModel.Name);
        _currentTokens = new List<string>();
        _editModel.AvailablePlaceholders = new List<string>(_currentTokens);
    }

    private void OpenCreateDrawer()
    {
        _isCreating = true;
        _bodyPreviewMode = false;
        _formError = null;
        _errorMessage = null;
        _notificationMessage = null;
        _editModel = new EmailTemplateDto
        {
            Category = "",
            IsActive = true
        };
        _selectedModalRoleString = "";
        _selectedModalTemplatePreset = "";
        _currentTokens = new List<string>();
        UpdateModalTemplateOptions();

        _showEditDrawer = true;
        StateHasChanged();
        Task.Run(async () =>
        {
            await Task.Yield();
            _isDrawerOpen = true;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenEditDrawer(EmailTemplateDto tpl)
    {
        _isCreating = false;
        _bodyPreviewMode = false;
        _formError = null;
        _errorMessage = null;
        _notificationMessage = null;
        _editModel = new EmailTemplateDto
        {
            Id = tpl.Id,
            Code = tpl.Code,
            Name = tpl.Name,
            Category = tpl.Category,
            TargetRole = tpl.TargetRole,
            Subject = tpl.Subject,
            BodyHtml = tpl.BodyHtml,
            Description = tpl.Description,
            AvailablePlaceholders = new List<string>(tpl.AvailablePlaceholders),
            IsActive = tpl.IsActive
        };
        _selectedModalRoleString = tpl.TargetRole.HasValue ? ((int)tpl.TargetRole.Value).ToString() : "";
        UpdateModalTemplateOptions();
        
        var matched = EmailTemplateNameExtensions.FromSystemCodeOrDisplayName(tpl.Code) 
                      ?? EmailTemplateNameExtensions.FromSystemCodeOrDisplayName(tpl.Name);
        _selectedModalTemplatePreset = matched.HasValue ? matched.Value.ToString() : "";
        _currentTokens = tpl.AvailablePlaceholders != null && tpl.AvailablePlaceholders.Count > 0 
            ? new List<string>(tpl.AvailablePlaceholders) 
            : new List<string>();

        _showEditDrawer = true;
        StateHasChanged();
        Task.Run(async () =>
        {
            await Task.Yield();
            _isDrawerOpen = true;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(250);
        _showEditDrawer = false;
        StateHasChanged();
    }

    private string _newCustomToken = "";

    private void AddCustomToken()
    {
        if (string.IsNullOrWhiteSpace(_newCustomToken)) return;

        var token = _newCustomToken.Trim();
        token = token.Trim('{', '}').Trim();
        if (string.IsNullOrWhiteSpace(token)) return;

        var formatted = "{{" + token + "}}";
        if (!_currentTokens.Any(t => t.Equals(formatted, StringComparison.OrdinalIgnoreCase)))
        {
            _currentTokens.Add(formatted);
            if (!_editModel.AvailablePlaceholders.Any(t => t.Equals(formatted, StringComparison.OrdinalIgnoreCase)))
            {
                _editModel.AvailablePlaceholders.Add(formatted);
            }
        }
        _newCustomToken = "";
    }

    private void HandleTokenKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCustomToken();
        }
    }

    private void RemoveToken(string token)
    {
        _currentTokens.RemoveAll(t => t.Equals(token, StringComparison.OrdinalIgnoreCase));
        _editModel.AvailablePlaceholders.RemoveAll(t => t.Equals(token, StringComparison.OrdinalIgnoreCase));
    }

    private void InsertToken(string token)
    {
        _editModel.BodyHtml += " " + token;
        if (!_editModel.AvailablePlaceholders.Contains(token))
        {
            _editModel.AvailablePlaceholders.Add(token);
        }
    }

    private async Task SaveTemplateAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_editModel.Name) || string.IsNullOrWhiteSpace(_editModel.Subject) || string.IsNullOrWhiteSpace(_editModel.BodyHtml))
        {
            _formError = "Name, subject line, and HTML content are required.";
            return;
        }

        _isSaving = true;
        StateHasChanged();

        if (_isCreating)
        {
            var req = new CreateEmailTemplateRequest
            {
                Code = _editModel.Code,
                Name = _editModel.Name,
                Category = _editModel.Category,
                TargetRole = _editModel.TargetRole,
                Subject = _editModel.Subject,
                BodyHtml = _editModel.BodyHtml,
                Description = _editModel.Description,
                AvailablePlaceholders = _editModel.AvailablePlaceholders,
                IsActive = _editModel.IsActive
            };
            var res = await TemplateService.CreateTemplateAsync(req);
            if (res.Success)
            {
                _notificationMessage = $"Template '{_editModel.Name}' created successfully.";
                await LoadTemplatesAsync();
                await CloseDrawerAsync();
            }
            else
            {
                _formError = res.Message;
            }
        }
        else
        {
            var req = new UpdateEmailTemplateRequest
            {
                Id = _editModel.Id,
                Name = _editModel.Name,
                Category = _editModel.Category,
                TargetRole = _editModel.TargetRole,
                Subject = _editModel.Subject,
                BodyHtml = _editModel.BodyHtml,
                Description = _editModel.Description,
                AvailablePlaceholders = _editModel.AvailablePlaceholders,
                IsActive = _editModel.IsActive
            };
            var res = await TemplateService.UpdateTemplateAsync(req);
            if (res.Success)
            {
                _notificationMessage = $"Template '{_editModel.Name}' updated successfully.";
                await LoadTemplatesAsync();
                await CloseDrawerAsync();
            }
            else
            {
                _formError = res.Message;
            }
        }

        _isSaving = false;
        StateHasChanged();
    }

    private async Task ToggleStatusAsync(EmailTemplateDto tpl)
    {
        var res = await TemplateService.ToggleTemplateStatusAsync(tpl.Id);
        if (res.Success)
        {
            tpl.IsActive = res.Data;
            _errorMessage = null;
            _notificationMessage = $"Template '{tpl.Name}' status updated to {(tpl.IsActive ? "Active" : "Disabled")}.";
            StateHasChanged();
        }
        else
        {
            _errorMessage = res.Message ?? "Failed to update template status.";
            Toast.Error(_errorMessage, "Error");
            StateHasChanged();
        }
    }

    private void OpenTestEmailModal(EmailTemplateDto tpl)
    {
        _testTargetTemplate = tpl;
        _showTestModal = true;
    }

    private async Task DispatchTestEmailAsync()
    {
        if (_testTargetTemplate == null) return;
        _isSendingTest = true;
        StateHasChanged();

        var res = await TemplateService.SendTestEmailAsync(new SendTestEmailRequest
        {
            TemplateId = _testTargetTemplate.Id,
            RecipientEmail = _testRecipientEmail
        });

        _isSendingTest = false;
        _showTestModal = false;
        if (res.Success)
        {
            Toast.Success(res.Message ?? "Email dispatched successfully.", "Email Dispatched");
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to dispatch email.", "Dispatch Failed");
        }
        StateHasChanged();
    }

    private string GetLivePreviewHtml()
    {
        if (string.IsNullOrWhiteSpace(_editModel.BodyHtml))
        {
            return "<div style='text-align:center; padding: 40px 20px; color:#94a3b8; font-family:sans-serif;'><p style='font-size:13px; font-weight:700;'>No HTML content entered yet.</p><p style='font-size:11px; margin-top:4px;'>Switch to the <strong>Editor</strong> tab to type or paste your email template HTML.</p></div>";
        }

        return ReplaceSampleTokens(_editModel.BodyHtml);
    }

    private string ReplaceSampleTokens(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            { "{{StudentName}}", "Rahul Sharma" },
            { "{{FirstName}}", "Rahul" },
            { "{{LastName}}", "Sharma" },
            { "{{TeacherName}}", "Dr. A. K. Verma" },
            { "{{AdminName}}", "Vargshala SuperAdmin" },
            { "{{InstituteName}}", "Apex Coaching Academy" },
            { "{{Email}}", "rahul.sharma@example.com" },
            { "{{Mobile}}", "+91 98765 43210" },
            { "{{OtpCode}}", "582914" },
            { "{{TemporaryPassword}}", "P@ssw0rd!2026" },
            { "{{VerificationLink}}", "https://vargshala.com/auth/verify?token=sample_token_xyz" },
            { "{{ResetLink}}", "https://vargshala.com/auth/reset-password?token=sample_reset_xyz" },
            { "{{LoginUrl}}", "https://vargshala.com/login" },
            { "{{InvoiceNumber}}", "INV-2026-0042" },
            { "{{Amount}}", "₹4,999" },
            { "{{PlanName}}", "Annual Pro SaaS" },
            { "{{DueDate}}", DateTime.UtcNow.AddDays(7).ToString("dd MMM yyyy") },
            { "{{Date}}", DateTime.UtcNow.ToString("dd MMM yyyy") },
            { "{{BatchName}}", "Class XII - JEE Advanced Morning Batch" },
            { "{{ExamTitle}}", "Physics Weekly Mock Test #4" }
        };

        foreach (var kvp in map)
        {
            text = text.Replace(kvp.Key, kvp.Value, StringComparison.OrdinalIgnoreCase);
        }

        foreach (var token in _currentTokens)
        {
            if (text.Contains(token, StringComparison.OrdinalIgnoreCase))
            {
                var clean = token.Trim('{', '}');
                text = text.Replace(token, $"[{clean}]", StringComparison.OrdinalIgnoreCase);
            }
        }

        return text;
    }

