                <button type="submit" 
                        disabled="@_isSaving"
                        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer disabled:opacity-50 flex items-center gap-2">
                    @if (_isSaving)
                    {
                        <div class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin"></div>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </EditForm>

    </div>
}

@code {
    private string _selectedPlanFilter = "";
    private string _selectedStatusFilter = "";
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _formError;

    private readonly TableQueryState _query = new();
    private int _totalRecords = 0;
    private TableSortState _sortState => _query.SortState;

    private readonly List<CustomSelect.CustomSelectOption> _planFilterOptions = new()
    {
        new("", "All Plans"),
        new("Standard", "Standard"),
        new("Pro Institute", "Pro Institute"),
        new("Enterprise", "Enterprise"),
        new("Free Trial", "Free Trial")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Active", "Active Only"),
        new("Suspended", "Suspended Only")
    };

    private List<InstituteSummaryDto> _institutes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInstitutesAsync(1);
    }

    private async Task LoadInstitutesAsync(int page = 1)
    {
        _query.PageNumber = Math.Max(1, page);
        _isLoading = true;
        try
        {
            var res = await InstituteService.GetAllInstitutesAsync(_query.ToPagedRequest());
            if (res != null && res.Success && res.Data != null)
            {
                _institutes = res.Data.Items ?? new List<InstituteSummaryDto>();
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _institutes = new List<InstituteSummaryDto>();
                _totalRecords = 0;
                var errorMsg = res?.Message ?? "Could not load institutes from database.";
                if (errorMsg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
                {
                    Toast.Error("Your session has expired or you are unauthorized. Please sign in again.", "Unauthorized");
                }
                else
                {
                    Toast.Error(errorMsg, "Error");
                }
            }
        }
        catch (Exception ex)
        {
            _institutes = new List<InstituteSummaryDto>();
            _totalRecords = 0;
            Toast.Error("Network or server connection error: " + ex.Message, "Connection Error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadInstitutesAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _query.SortState.Toggle(column);
        await LoadInstitutesAsync(1);
    }

    private IEnumerable<InstituteSummaryDto> FilteredInstitutes
    {
        get
        {
            var query = _institutes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_selectedPlanFilter))
            {
                query = query.Where(i => i.Plan.Equals(_selectedPlanFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_selectedStatusFilter))
            {
                if (_selectedStatusFilter == "Active") query = query.Where(i => i.IsActive);
                else if (_selectedStatusFilter == "Suspended") query = query.Where(i => !i.IsActive);
            }

            return query.ToList();
        }
    }

    private string GetPlanBadgeClass(string plan) => plan switch
    {
        "Pro Institute" => "bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800",
        "Enterprise" => "bg-purple-50 dark:bg-purple-950/70 text-purple-700 dark:text-purple-300 border-purple-200 dark:border-purple-800",
        "Free Trial" => "bg-amber-50 dark:bg-amber-950/70 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800",
        _ => "bg-teal-50 dark:bg-teal-950/70 text-teal-700 dark:text-teal-300 border-teal-200 dark:border-teal-800"
    };

    private async Task ToggleInstituteStatusAsync(InstituteSummaryDto inst)
    {
        inst.IsActive = !inst.IsActive;
        StateHasChanged();

        try
        {
            var res = await InstituteService.ToggleInstituteStatusAsync(inst.Id);
            if (res != null && res.Success)
            {
                inst.IsActive = res.Data;
                Toast.Success($"Institute '{inst.Name}' status updated to {(inst.IsActive ? "Active" : "Suspended")}.");
            }
            else
            {
                inst.IsActive = !inst.IsActive;
                Toast.Error(res?.Message ?? "Failed to update institute status.");
            }
        }
        catch (Exception ex)
        {
            inst.IsActive = !inst.IsActive;
            Toast.Error("Error: " + ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }


    private void ExportCsv()
    {
        Toast.Info($"CSV export prepared for {_institutes.Count} institutes.");
    }

    // Drawer state
    private bool _showOnboardDrawer = false;
    private bool _showProfileDrawer = false;
    private bool _showEditDrawer = false;
    private bool _isDrawerOpen = false;
    private InstituteSummaryDto? _selectedInstitute;
    private RegisterOrganizationRequest _regModel = new();
    private UpdateOrganizationRequest _editModel = new();
    private string? _editFormError;

    private async Task OpenOnboardDrawerAsync()
    {
        _formError = null;
        _regModel = new RegisterOrganizationRequest
        {
            AcademicSession = "2026-2027",
            AcceptTerms = true
        };
        _showOnboardDrawer = true;
        _showProfileDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenProfileDrawer(InstituteSummaryDto inst)
    {
        _selectedInstitute = inst;
        _showProfileDrawer = true;
        _showOnboardDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenEditDrawerAsync(InstituteSummaryDto inst)
    {
        _editFormError = null;
        _selectedInstitute = inst;
        _editModel = new UpdateOrganizationRequest
        {
            Id = inst.Id,
            Name = inst.Name,
            Email = inst.Email,
            Mobile = inst.Mobile,
            Address = inst.Address,
            City = inst.City,
            State = inst.State,
            Pincode = inst.Pincode,
            AcademicSession = inst.AcademicSession,
            LogoUrl = inst.LogoUrl,
            IsActive = inst.IsActive
        };
        _showProfileDrawer = false;
        _showOnboardDrawer = false;
        _showEditDrawer = true;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showOnboardDrawer = false;
        _showProfileDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
    }

    private async Task SubmitEditAsync()
    {
        _editFormError = null;
        _isSaving = true;
        StateHasChanged();

        try
        {
            var res = await InstituteService.UpdateInstituteAsync(_editModel);
            if (res != null && res.Success && res.Data != null)
            {
                if (_selectedInstitute != null)
                {
                    _selectedInstitute.Name = res.Data.Name;
                    _selectedInstitute.Email = res.Data.Email;
                    _selectedInstitute.Mobile = res.Data.Mobile;
                    _selectedInstitute.Address = res.Data.Address;
                    _selectedInstitute.City = res.Data.City;
                    _selectedInstitute.State = res.Data.State;
                    _selectedInstitute.Pincode = res.Data.Pincode;
                    _selectedInstitute.AcademicSession = res.Data.AcademicSession;
                    _selectedInstitute.IsActive = res.Data.IsActive;
                }

                Toast.Success($"Institute '{res.Data.Name}' updated successfully!");
                await CloseDrawerAsync();
            }
            else
            {
                _editFormError = res?.Message ?? "Failed to update institute.";
            }
        }
        catch (Exception ex)
        {
            _editFormError = ex.Message;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SubmitOnboardingAsync()
    {
        _formError = null;
        _regModel.AcceptTerms = true;
        _regModel.ConfirmPassword = _regModel.Password;

        _isSaving = true;
        try
        {
            var response = await AuthService.RegisterOrganizationAsync(_regModel);
            if (response.Success)
            {
                Toast.Success($"Institute '{_regModel.OrganizationName}' onboarded successfully!");
                await CloseDrawerAsync();
                await LoadInstitutesAsync();
            }
            else
            {
                _formError = response.Message ?? "Failed to onboard institute.";
            }
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
