    // Drawer state
    private bool _showOnboardDrawer = false;
    private bool _showProfileDrawer = false;
    private bool _showEditDrawer = false;
    private bool _isDrawerOpen = false;
    private InstituteSummaryDto? _selectedInstitute;
    private RegisterOrganizationRequest _regModel = new();
    private UpdateOrganizationRequest _editModel = new();
    private string? _editFormError;

    private async Task OpenOnboardDrawerAsync()
    {
        _formError = null;
        _regModel = new RegisterOrganizationRequest
        {
            AcademicSession = "2026-2027"
        };
        _showOnboardDrawer = true;
        _showProfileDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
        await Task.Yield();
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenProfileDrawer(InstituteSummaryDto inst)
    {
        _selectedInstitute = inst;
        _showProfileDrawer = true;
        _showOnboardDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
        await Task.Yield();
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task OpenEditDrawerAsync(InstituteSummaryDto inst)
    {
        _editFormError = null;
        _selectedInstitute = inst;
        _editModel = new UpdateOrganizationRequest
        {
            Id = inst.Id,
            Name = inst.Name,
            Email = inst.Email,
            Mobile = inst.Mobile,
            Address = inst.Address,
            City = inst.City,
            State = inst.State,
            Pincode = inst.Pincode,
            AcademicSession = inst.AcademicSession,
            LogoUrl = inst.LogoUrl,
            IsActive = inst.IsActive
        };
        _showProfileDrawer = false;
        _showOnboardDrawer = false;
        _showEditDrawer = true;
        StateHasChanged();
        await Task.Yield();
        _isDrawerOpen = true;
        StateHasChanged();
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(250);
        _showOnboardDrawer = false;
        _showProfileDrawer = false;
        _showEditDrawer = false;
        StateHasChanged();
    }

    private async Task SubmitEditAsync()
    {
        _editFormError = null;

        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            _editFormError = "Institute full name is required.";
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var res = await InstituteService.UpdateInstituteAsync(_editModel);
            if (res != null && res.Success && res.Data != null)
            {
                if (_selectedInstitute != null)
                {
                    _selectedInstitute.Name = res.Data.Name;
                    _selectedInstitute.Email = res.Data.Email;
                    _selectedInstitute.Mobile = res.Data.Mobile;
                    _selectedInstitute.Address = res.Data.Address;
                    _selectedInstitute.City = res.Data.City;
                    _selectedInstitute.State = res.Data.State;
                    _selectedInstitute.Pincode = res.Data.Pincode;
                    _selectedInstitute.AcademicSession = res.Data.AcademicSession;
                    _selectedInstitute.IsActive = res.Data.IsActive;
                }

                await CloseDrawerAsync();
            }
            else
            {
                _editFormError = res?.Message ?? "Failed to update institute.";
            }
        }
        catch (Exception ex)
        {
            _editFormError = ex.Message;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SubmitOnboardingAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_regModel.OrganizationName))
        {
            _formError = "Institute full name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_regModel.OrganizationCode))
        {
            _formError = "Tenant code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_regModel.AdminEmail) || string.IsNullOrWhiteSpace(_regModel.Password))
        {
            _formError = "Admin email and password are required.";
            return;
        }

        _isSaving = true;
        try
        {
            var response = await AuthService.RegisterOrganizationAsync(_regModel);
            if (response.Success)
            {
                await CloseDrawerAsync();
                await LoadInstitutesAsync();
            }
            else
            {
                _formError = response.Message ?? "Failed to onboard institute.";
            }
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
