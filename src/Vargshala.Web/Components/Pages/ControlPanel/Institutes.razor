    private async Task ToggleInstituteStatusAsync(InstituteSummaryDto inst)
    {
        inst.IsActive = !inst.IsActive;
        StateHasChanged();

        try
        {
            var res = await InstituteService.ToggleInstituteStatusAsync(inst.Id);
            if (res != null && res.Success)
            {
                inst.IsActive = res.Data;
            }
            else
            {
                inst.IsActive = !inst.IsActive;
            }
        }
        catch
        {
            inst.IsActive = !inst.IsActive;
        }
        finally
        {
            StateHasChanged();
        }
    }

