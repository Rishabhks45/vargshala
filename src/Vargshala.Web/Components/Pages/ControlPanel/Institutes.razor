                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _editModel.City)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">State</label>
                            <InputText @bind-Value="_editModel.State" placeholder="e.g. Bihar"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _editModel.State)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Pincode</label>
