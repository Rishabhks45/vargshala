@page "/controlpanel/institutes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,BackOffice,1001,1002")]
@using Vargshala.Contracts.Authentication
@using Vargshala.Contracts.Organizations
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Services
@inject IInstituteService InstituteService
@inject IAuthService AuthService
@inject INotificationService Toast
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Institutes &amp; Tenant Management | Control Panel</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Institutes &amp; Tenant Management
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage registered coaching centers, multi-tenant isolation, user quotas, and live database tenants.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenOnboardDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Onboard Institute</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Matched with EmailTemplates.razor) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Institutes</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">@_institutes.Count(i => i.IsActive) Active • @_institutes.Count(i => !i.IsActive) Suspended</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Enrolled Students</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@_institutes.Sum(i => i.StudentCount).ToString("N0")</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Across all coaching batches</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Faculty &amp; Teachers</p>
                    <h3 class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">@_institutes.Sum(i => i.TeacherCount).ToString("N0")</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Active educators</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Tenant Isolation</p>
                    <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">100% Secure</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">PostgreSQL 18 Multi-Tenant</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls (Matched with EmailTemplates.razor) -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_query.Search" 
                         OnSearch="() => LoadInstitutesAsync(1)" 
                         Placeholder="Search institute name, code, city, or owner..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-40">
                <CustomSelect @bind-Value="_selectedPlanFilter" Options="_planFilterOptions" Placeholder="All Plans" />
            </div>
            <div class="w-36">
                <CustomSelect @bind-Value="_selectedStatusFilter" Options="_statusFilterOptions" Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Institutes Data Table (Fits screen height, internal scrolling with hidden scrollbar) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[760px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[26%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Institute &amp; Code</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="w-[18%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Owner")'>
                            <div class="flex items-center gap-1.5">
                                <span>Contact / Owner</span>
                                <span class="@_sortState.GetIndicatorClass("Owner")">@_sortState.GetIndicator("Owner")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("City")'>
                            <div class="flex items-center gap-1.5">
                                <span>Location</span>
                                <span class="@_sortState.GetIndicatorClass("City")">@_sortState.GetIndicator("City")</span>
                            </div>
                        </th>
                        <th class="w-[16%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Students")'>
                            <div class="flex items-center gap-1.5">
                                <span>Students / Faculty</span>
                                <span class="@_sortState.GetIndicatorClass("Students")">@_sortState.GetIndicator("Students")</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Plan")'>
                            <div class="flex items-center gap-1.5">
                                <span>SaaS Plan</span>
                                <span class="@_sortState.GetIndicatorClass("Plan")">@_sortState.GetIndicator("Plan")</span>
                            </div>
                        </th>
                        <th class="w-[8%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="w-[8%] py-2 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && FilteredInstitutes.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !FilteredInstitutes.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="8" />
                    }
                    else if (FilteredInstitutes.Any())
                    {
                        @foreach (var inst in FilteredInstitutes)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors group">
                                <!-- Institute Name & Code -->
                                <td class="py-1.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                            @inst.Name.Substring(0, 1).ToUpperInvariant()
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-800 dark:text-white leading-tight truncate">@inst.Name</div>
                                            <div class="text-[10px] font-mono text-teal-600 dark:text-teal-400 leading-none mt-0.5">CODE: @inst.Code • ID: @inst.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Contact / Owner -->
                                <td class="py-1.5 px-3">
                                    <div class="font-semibold text-slate-800 dark:text-white leading-tight truncate">@inst.OwnerName</div>
                                    <div class="text-[10px] text-slate-400 leading-none mt-0.5">@inst.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(inst.Mobile))
                                    {
                                        <div class="text-[9px] font-mono text-slate-400 leading-none mt-0.5">@inst.Mobile</div>
                                    }
                                </td>

                                <!-- Location -->
                                <td class="py-1.5 px-3 text-slate-600 dark:text-slate-300">
                                    <div class="font-semibold text-slate-800 dark:text-white leading-tight">@inst.City</div>
                                    <div class="text-[10px] text-slate-400 leading-none mt-0.5">@inst.State</div>
                                </td>

                                <!-- Students / Teachers Count -->
                                <td class="py-1.5 px-3">
                                    <div class="font-bold text-slate-800 dark:text-white leading-tight">@inst.StudentCount Students</div>
                                    <div class="text-[10px] text-teal-600 dark:text-teal-400 font-medium leading-none mt-0.5">@inst.TeacherCount Teachers • @inst.TotalUsersCount Users</div>
                                </td>

                                <!-- SaaS Plan Badge -->
                                <td class="py-1.5 px-3">
                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold @GetPlanBadgeClass(inst.Plan) border">
                                        @inst.Plan
                                    </span>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-1.5 px-3 text-center">
                                    @if (inst.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1"></span>
                                            Suspended
                                        </span>
                                    }
                                </td>

                                 <!-- Actions Column: Direct Action Buttons -->
                                 <td class="py-1.5 px-5 text-right">
                                     <div class="flex items-center justify-end gap-1">
                                         <!-- Quick Action 1: View Profile Details -->
                                         <button type="button" 
                                                 @onclick="() => OpenProfileDrawer(inst)" 
                                                 title="View Details"
                                                 class="p-1 text-[#009488] dark:text-teal-400 hover:text-[#00796b] dark:hover:text-teal-300 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="View Details">
                                             <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                             </svg>
                                         </button>

                                         <!-- Quick Action 2: Edit Institute -->
                                         <button type="button" 
                                                 @onclick="() => OpenEditDrawerAsync(inst)" 
                                                 title="Edit Institute"
                                                 class="p-1 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="Edit Institute">
                                             <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                             </svg>
                                         </button>

                                         <!-- Quick Action 4: Toggle Status (Active / Suspend) -->
                                         <button type="button" 
                                                 @onclick="() => ToggleInstituteStatusAsync(inst)" 
                                                 title="@(inst.IsActive ? "Suspend Institute" : "Activate Institute")"
                                                 class="p-1 @(inst.IsActive ? "text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40" : "text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/40") rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="Toggle Status">
                                             <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                             </svg>
                                         </button>
                                     </div>
                                 </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No institutes found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber" 
                             PageSize="_query.PageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="institutes"
                             IsLoading="_isLoading"
                             OnPageChanged="LoadInstitutesAsync" 
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Onboard New Institute Slide-Over (Exact Match with Students.razor) -->
<!-- ========================================================================= -->
@if (_showOnboardDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏛️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>Onboard New Institute</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Create multi-tenant educational organization &amp; admin account
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body & Footer inside EditForm -->
        <EditForm Model="@_regModel" OnValidSubmit="SubmitOnboardingAsync" class="flex-1 flex flex-col justify-between overflow-hidden">
            <FluentValidationValidator />

            <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <AlertNotification Type="AlertType.Error"
                                       Message="@_formError"
                                       Dismissible="true"
                                       OnClose="() => _formError = null" />
                }

                <div class="space-y-3">
                    <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider">1. Institute Information</h4>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-slate-300">Institute Full Name *</label>
                        <InputText @bind-Value="_regModel.OrganizationName" placeholder="e.g. Apex Physics Institute"
                                   class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-medium" />
                        <ValidationMessage For="@(() => _regModel.OrganizationName)" class="text-[10px] text-rose-500 font-semibold" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Tenant Code *</label>
                            <InputText @bind-Value="_regModel.OrganizationCode" placeholder="e.g. APEX01"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none font-mono uppercase text-slate-800 dark:text-white font-bold" />
                            <ValidationMessage For="@(() => _regModel.OrganizationCode)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Academic Session</label>
                            <InputText @bind-Value="_regModel.AcademicSession" placeholder="2026-2027"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _regModel.AcademicSession)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-slate-300">Campus / Street Address</label>
