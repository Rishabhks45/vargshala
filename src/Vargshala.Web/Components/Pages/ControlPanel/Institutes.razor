@code {
    private string _selectedPlanFilter = "";
    private string _selectedStatusFilter = "";
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _formError;
    private string? _errorMessage;

    private readonly TableQueryState _query = new();
    private int _totalRecords = 0;
    private TableSortState _sortState => _query.SortState;

    private readonly List<CustomSelect.CustomSelectOption> _planFilterOptions = new()
    {
        new("", "All Plans"),
        new("Standard", "Standard"),
        new("Pro Institute", "Pro Institute"),
        new("Enterprise", "Enterprise"),
        new("Free Trial", "Free Trial")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Active", "Active Only"),
        new("Suspended", "Suspended Only")
    };

    private List<InstituteSummaryDto> _institutes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInstitutesAsync(1);
    }

    private async Task LoadInstitutesAsync(int page = 1)
    {
        _query.PageNumber = Math.Max(1, page);
        _isLoading = true;
        try
        {
            var res = await InstituteService.GetAllInstitutesAsync(_query.ToPagedRequest());
            if (res != null && res.Success && res.Data != null)
            {
                _institutes = res.Data.Items ?? new List<InstituteSummaryDto>();
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _institutes = new List<InstituteSummaryDto>();
                _totalRecords = 0;
                _errorMessage = res?.Message ?? "Could not load institutes from database.";
            }
        }
        catch (Exception ex)
        {
            _institutes = new List<InstituteSummaryDto>();
            _totalRecords = 0;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadInstitutesAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _query.SortState.Toggle(column);
        await LoadInstitutesAsync(1);
    }

    private IEnumerable<InstituteSummaryDto> FilteredInstitutes
    {
        get
        {
            var query = _institutes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_selectedPlanFilter))
            {
                query = query.Where(i => i.Plan.Equals(_selectedPlanFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_selectedStatusFilter))
            {
                if (_selectedStatusFilter == "Active") query = query.Where(i => i.IsActive);
                else if (_selectedStatusFilter == "Suspended") query = query.Where(i => !i.IsActive);
            }

            return query.ToList();
        }
    }

