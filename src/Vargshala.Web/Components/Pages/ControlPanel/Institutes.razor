                            <InputText @bind-Value="_regModel.AdminFirstName" placeholder="Admin First Name"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _regModel.AdminFirstName)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Last Name *</label>
                            <InputText @bind-Value="_regModel.AdminLastName" placeholder="Admin Last Name"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _regModel.AdminLastName)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-slate-300">Admin Login Email *</label>
                        <InputText type="email" @bind-Value="_regModel.AdminEmail" placeholder="admin@institute.com"
                                   class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                        <ValidationMessage For="@(() => _regModel.AdminEmail)" class="text-[10px] text-rose-500 font-semibold" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Mobile</label>
                            <InputText @bind-Value="_regModel.AdminMobile" placeholder="9876543210"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _regModel.AdminMobile)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Temporary Password *</label>
                            <InputText type="password" @bind-Value="_regModel.Password" @bind-Value:after="() => _regModel.ConfirmPassword = _regModel.Password" placeholder="Strong password"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                            <ValidationMessage For="@(() => _regModel.Password)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Drawer Footer -->
            <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-end gap-3 shrink-0">
                <button type="button" 
                        @onclick="CloseDrawerAsync"
                        class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" 
                        disabled="@_isSaving"
                        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer flex items-center gap-2">
                    @if (_isSaving)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Registering...</span>
                    }
                    else
                    {
                        <span>Save &amp; Onboard</span>
                    }
                </button>
            </div>
        </EditForm>

    </div>
}

<!-- ========================================================================= -->
<!-- DRAWER: Institute Profile Details Viewer (Exact Match with Students.razor) -->
<!-- ========================================================================= -->
@if (_showProfileDrawer && _selectedInstitute != null)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-teal-500/20 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏛️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@_selectedInstitute.Name</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Tenant Code: @_selectedInstitute.Code
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
            <div class="card-surface p-4 space-y-2.5">
                <div class="flex justify-between items-center"><span class="text-slate-400">Organization GUID:</span> <span class="font-mono text-[11px] font-bold text-[#009488]">@_selectedInstitute.Id</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Institute Code:</span> <span class="font-mono font-bold text-slate-800 dark:text-white">@_selectedInstitute.Code</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Primary Contact:</span> <span class="font-bold text-slate-800 dark:text-white">@_selectedInstitute.OwnerName</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Email:</span> <span class="text-slate-700 dark:text-slate-200">@_selectedInstitute.Email</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Mobile:</span> <span class="text-slate-700 dark:text-slate-200 font-mono">@_selectedInstitute.Mobile</span></div>
                @if (!string.IsNullOrWhiteSpace(_selectedInstitute.Address))
                {
                    <div class="flex justify-between items-center"><span class="text-slate-400">Address:</span> <span class="text-slate-700 dark:text-slate-200 text-right max-w-xs truncate">@_selectedInstitute.Address</span></div>
                }
                <div class="flex justify-between items-center"><span class="text-slate-400">City / State:</span> <span class="text-slate-700 dark:text-slate-200">@_selectedInstitute.City, @_selectedInstitute.State @(!string.IsNullOrWhiteSpace(_selectedInstitute.Pincode) ? $"({_selectedInstitute.Pincode})" : "")</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Academic Session:</span> <span class="font-semibold text-slate-700 dark:text-slate-200">@_selectedInstitute.AcademicSession</span></div>
                <div class="flex justify-between items-center pt-2 border-t border-slate-100 dark:border-slate-800"><span class="text-slate-400">Enrolled Students:</span> <span class="font-extrabold text-emerald-600">@_selectedInstitute.StudentCount Students</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Active Teachers:</span> <span class="font-extrabold text-purple-600">@_selectedInstitute.TeacherCount Teachers</span></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Status:</span> <span class="font-bold @(_selectedInstitute.IsActive ? "text-emerald-600" : "text-rose-600")">@(_selectedInstitute.IsActive ? "Active" : "Suspended")</span></div>
            </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-between gap-3 shrink-0">
            <div class="flex items-center gap-2">
                <button type="button" 
                        @onclick="() => OpenEditDrawerAsync(_selectedInstitute)"
                        class="px-3.5 py-2.5 rounded-xl bg-amber-500/10 text-amber-600 hover:bg-amber-500/20 text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5">
                    <span>✏️</span>
                    <span>Edit</span>
                </button>
            </div>
            <button type="button" 
                    @onclick="CloseDrawerAsync"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                Close
            </button>
        </div>

    </div>
}

