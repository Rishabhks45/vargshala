                            <ValidationMessage For="@(() => _regModel.State)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">Pincode</label>
