@page "/controlpanel/institutes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,BackOffice,1001,1002")]
@using Vargshala.Contracts.Authentication
@using Vargshala.Contracts.Organizations
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Services
@inject IInstituteService InstituteService
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Institutes &amp; Tenant Management | Control Panel</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header & Action Controls (Matched with Students.razor) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">🏛️</span>
                Institutes &amp; Tenant Management
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Manage registered coaching centers, multi-tenant isolation, user quotas, and live database tenants.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs hover:shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenOnboardDrawerAsync"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </span>
                <span>Onboard Institute</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Exact Structure from Students.razor) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Institutes</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_institutes.Count</h3>
                <p class="text-[10px] text-emerald-600 font-semibold mt-0.5">@_institutes.Count(i => i.IsActive) Active • @_institutes.Count(i => !i.IsActive) Suspended</p>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Enrolled Students</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_institutes.Sum(i => i.StudentCount).ToString("N0")</h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Across all coaching batches</p>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/80 text-purple-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Faculty &amp; Teachers</p>
                <h3 class="text-lg font-extrabold text-purple-600 dark:text-purple-400">@_institutes.Sum(i => i.TeacherCount).ToString("N0")</h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Active educators</p>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Tenant Isolation</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">100% Secure</h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">PostgreSQL 18 Multi-Tenant</p>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls (Exact Students.razor Component Layout) -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="flex-1 w-full lg:max-w-md">
            <SearchInput @bind-Value="_query.Search" 
                         OnSearch="() => LoadInstitutesAsync(1)" 
                         Placeholder="Search institute name, code, city, or owner..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_selectedPlanFilter" Options="_planFilterOptions" Placeholder="All Plans" />
            <CustomSelect @bind-Value="_selectedStatusFilter" Options="_statusFilterOptions" Placeholder="All Status" />
        </div>
    </div>

    <!-- Institutes Data Table (Pixel-Matched Layout with Full Dark Mode & TableSortState) -->
    <div class="card-surface border border-tealborder shadow-xs">
        <div class="overflow-x-auto min-h-[260px]">
            <table class="w-full min-w-[760px] text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                        <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Institute &amp; Code</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("Owner")'>
                            <div class="flex items-center gap-1.5">
                                <span>Contact / Owner</span>
                                <span class="@_sortState.GetIndicatorClass("Owner")">@_sortState.GetIndicator("Owner")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("City")'>
                            <div class="flex items-center gap-1.5">
                                <span>Location</span>
                                <span class="@_sortState.GetIndicatorClass("City")">@_sortState.GetIndicator("City")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("Students")'>
                            <div class="flex items-center gap-1.5">
                                <span>Students / Faculty</span>
                                <span class="@_sortState.GetIndicatorClass("Students")">@_sortState.GetIndicator("Students")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("Plan")'>
                            <div class="flex items-center gap-1.5">
                                <span>SaaS Plan</span>
                                <span class="@_sortState.GetIndicatorClass("Plan")">@_sortState.GetIndicator("Plan")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 text-center cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/80 dark:divide-slate-800/40 text-xs">
                    @if (_isLoading)
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center space-y-2">
                                    <div class="w-8 h-8 rounded-full border-2 border-teal-500 border-t-transparent animate-spin"></div>
                                    <p class="text-xs font-semibold text-slate-500">Loading institutes from database...</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (FilteredInstitutes.Any())
                    {
                        @foreach (var inst in FilteredInstitutes)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-[#152329]/60 transition-colors">
                                <!-- Institute Name & Code -->
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] font-black text-sm flex items-center justify-center shrink-0 shadow-inner">
                                            @inst.Name.Substring(0, 1).ToUpperInvariant()
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-white leading-tight">@inst.Name</div>
                                            <div class="text-[10px] font-mono text-teal-600 dark:text-teal-400 mt-0.5">CODE: @inst.Code • ID: @inst.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Contact / Owner -->
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-800 dark:text-white">@inst.OwnerName</div>
                                    <div class="text-[11px] text-slate-400">@inst.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(inst.Mobile))
                                    {
                                        <div class="text-[10px] font-mono text-slate-400">@inst.Mobile</div>
                                    }
                                </td>

                                <!-- Location -->
                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300">
                                    <div class="font-semibold text-slate-800 dark:text-white">@inst.City</div>
                                    <div class="text-[11px] text-slate-400">@inst.State</div>
                                </td>

                                <!-- Students / Teachers Count -->
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-800 dark:text-white">@inst.StudentCount Students</div>
                                    <div class="text-[10px] text-teal-600 dark:text-teal-400 font-medium">@inst.TeacherCount Teachers • @inst.TotalUsersCount Total Users</div>
                                </td>

                                <!-- SaaS Plan Badge -->
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold @GetPlanBadgeClass(inst.Plan) border">
                                        @inst.Plan
                                    </span>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3.5 px-4 text-center">
                                    @if (inst.IsActive)
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>
                                            Suspended
                                        </span>
                                    }
                                </td>

                                 <!-- Actions Column: Direct Action Buttons -->
                                 <td class="py-3.5 px-6 text-right">
                                     <div class="flex items-center justify-end gap-1">
                                         <!-- Quick Action 1: View Profile Details -->
                                         <button type="button" 
                                                 @onclick="() => OpenProfileDrawer(inst)" 
                                                 title="View Details"
                                                 class="p-2 rounded-xl text-slate-400 hover:text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="View Details">
                                             <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                             </svg>
                                         </button>

                                         <!-- Quick Action 2: Edit Institute -->
                                         <button type="button" 
                                                 @onclick="() => OpenEditDrawerAsync(inst)" 
                                                 title="Edit Institute"
                                                 class="p-2 rounded-xl text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/50 transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="Edit Institute">
                                             <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                             </svg>
                                         </button>

                                         <!-- Quick Action 3: Login As Admin (Impersonate) -->
                                         <button type="button" 
                                                 @onclick="() => ImpersonateInstitute(inst)" 
                                                 title="Login As Admin (Impersonate)"
                                                 class="p-2 rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/50 transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="Login As Admin">
                                             <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                             </svg>
                                         </button>

                                         <!-- Quick Action 3: Toggle Status (Active / Suspend) -->
                                         <button type="button" 
                                                 @onclick="() => ToggleInstituteStatusAsync(inst)" 
                                                 title="@(inst.IsActive ? "Suspend Institute" : "Activate Institute")"
                                                 class="p-2 rounded-xl @(inst.IsActive ? "text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/50" : "text-emerald-500 hover:bg-emerald-50 dark:hover:bg-emerald-950/50") transition-all cursor-pointer inline-flex items-center justify-center"
                                                 aria-label="Toggle Status">
                                             <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                 <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                             </svg>
                                         </button>
                                     </div>
                                 </td>
                            </tr>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-rose-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                    </svg>
                                    <p class="font-bold text-rose-600 dark:text-rose-400 text-sm">Database Connection Error</p>
                                    <p class="text-xs text-slate-400">@_errorMessage</p>
                                    <button type="button" @onclick="() => LoadInstitutesAsync(1)" 
                                            class="mt-2 px-3.5 py-1.5 rounded-xl bg-teal-500/10 text-[#009488] hover:bg-teal-500/20 text-xs font-bold transition-all cursor-pointer">
                                        Retry Connection
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No institutes found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component -->
        <TablePagination PageNumber="_query.PageNumber" 
                         PageSize="_query.PageSize" 
                         TotalRecords="_totalRecords" 
                         ItemLabel="institutes"
                         IsLoading="_isLoading"
                         OnPageChanged="LoadInstitutesAsync" 
                         OnPageSizeChanged="HandlePageSizeChangedAsync" />
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Onboard New Institute Slide-Over (Exact Match with Students.razor) -->
<!-- ========================================================================= -->
@if (_showOnboardDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏛️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>Onboard New Institute</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Create multi-tenant educational organization &amp; admin account
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
