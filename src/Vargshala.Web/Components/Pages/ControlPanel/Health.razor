@page "/controlpanel/health"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@rendermode InteractiveServer

<PageTitle>Infrastructure &amp; Health - Control Panel</PageTitle>

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">📈</span>
                Infrastructure &amp; Health Diagnostics
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Real-time status of PostgreSQL database, API endpoints, Blazor circuit health, and server telemetry.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold flex items-center gap-1.5 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                All Systems Operational
            </span>
            <button @onclick="RunDiagnostic"
                    class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold hover:from-[#00a89a] hover:to-[#00897b] transition-all flex items-center gap-1.5 shadow-md">
                <svg class="w-3.5 h-3.5 @(_isPinging ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Run Diagnostic Ping
            </button>
        </div>
    </div>

    <!-- 4 Core Service Health Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- DB -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xs font-bold">🗄️</span>
                    <span class="text-xs font-bold text-slate-800 dark:text-white">PostgreSQL 18</span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Healthy</span>
            </div>
            <div class="space-y-1 text-xs">
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Latency:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">@_dbLatency</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Conn Pool:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">12 / 100 max</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Database:</span> <span class="font-mono font-bold text-teal-600 dark:text-teal-400">vargshala</span></div>
            </div>
        </div>

        <!-- API -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center text-xs font-bold">⚡</span>
                    <span class="text-xs font-bold text-slate-800 dark:text-white">ASP.NET Core API</span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Healthy</span>
            </div>
            <div class="space-y-1 text-xs">
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Port:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">7288 (HTTPS)</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Avg Response:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">18 ms</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Uptime:</span> <span class="font-mono font-bold text-emerald-600">99.98%</span></div>
            </div>
        </div>

        <!-- Blazor Server -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-indigo-500/10 text-indigo-600 flex items-center justify-center text-xs font-bold">🌐</span>
                    <span class="text-xs font-bold text-slate-800 dark:text-white">Blazor Web Circuit</span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Healthy</span>
            </div>
            <div class="space-y-1 text-xs">
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Port:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">7277 (HTTPS)</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Active Circuits:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">8 Active</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Memory Used:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">142 MB</span></div>
            </div>
        </div>

        <!-- Storage -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-600 flex items-center justify-center text-xs font-bold">💾</span>
                    <span class="text-xs font-bold text-slate-800 dark:text-white">Media &amp; PDFs Storage</span>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Healthy</span>
            </div>
            <div class="space-y-1 text-xs">
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Used Storage:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">18.4 GB</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">Capacity:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">500 GB (3.6%)</span></div>
                <div class="flex justify-between text-slate-500"><span class="text-[11px]">File Count:</span> <span class="font-mono font-bold text-slate-700 dark:text-slate-200">4,120 Files</span></div>
            </div>
        </div>
    </div>

    <!-- Live Telemetry & Resource Gauges -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-4">
        <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center justify-between">
            <span>Server Resources Telemetry</span>
            <span class="text-[11px] font-mono text-slate-400">Node: Windows 11 PRO • .NET 10.0</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
            <!-- CPU -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs">
                    <span class="font-bold text-slate-700 dark:text-slate-300">CPU Utilization</span>
                    <span class="font-mono font-bold text-[#009488]">@_cpuPercent%</span>
                </div>
                <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-[#009488] to-[#2DD4BF] transition-all duration-500" style="width: @(_cpuPercent)%"></div>
                </div>
                <span class="text-[10px] text-slate-400">8 Cores active • System load normal</span>
            </div>

            <!-- RAM -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs">
                    <span class="font-bold text-slate-700 dark:text-slate-300">Memory (RAM)</span>
                    <span class="font-mono font-bold text-indigo-600 dark:text-indigo-400">3.2 GB / 16 GB (20%)</span>
                </div>
                <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-indigo-500 to-indigo-400 transition-all duration-500" style="width: 20%"></div>
                </div>
                <span class="text-[10px] text-slate-400">GC Generation 0/1/2 healthy</span>
            </div>

            <!-- DB Pool -->
            <div class="space-y-2">
                <div class="flex justify-between text-xs">
                    <span class="font-bold text-slate-700 dark:text-slate-300">DB Connection Pool</span>
                    <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">12% used</span>
                </div>
                <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-emerald-400 transition-all duration-500" style="width: 12%"></div>
                </div>
                <span class="text-[10px] text-slate-400">Npgsql pooled connections active</span>
            </div>
        </div>
    </div>

    <!-- Infrastructure Endpoints Matrix Table -->
    <div class="rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white">Active SaaS Microservices &amp; Ports</h2>
            <span class="text-xs font-semibold text-emerald-600">4 / 4 Services UP</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/40 border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3 px-4">Service</th>
                        <th class="py-3 px-4">Internal Endpoint</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4">Latency</th>
                        <th class="py-3 px-4">Last Health Check</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono text-[11px]">
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 font-sans font-bold text-slate-800 dark:text-white">PostgreSQL Engine</td>
                        <td class="py-3 px-4 text-slate-500">localhost:5432 (vargshala)</td>
                        <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Operational</span></td>
                        <td class="py-3 px-4 font-bold text-emerald-600">3 ms</td>
                        <td class="py-3 px-4 text-slate-400 font-sans text-xs">10 seconds ago</td>
                    </tr>
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 font-sans font-bold text-slate-800 dark:text-white">Vargshala.API (Backend)</td>
                        <td class="py-3 px-4 text-slate-500">https://localhost:7288</td>
                        <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Operational</span></td>
                        <td class="py-3 px-4 font-bold text-emerald-600">12 ms</td>
                        <td class="py-3 px-4 text-slate-400 font-sans text-xs">15 seconds ago</td>
                    </tr>
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 font-sans font-bold text-slate-800 dark:text-white">Vargshala.Web (Blazor)</td>
                        <td class="py-3 px-4 text-slate-500">https://localhost:7277</td>
                        <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Operational</span></td>
                        <td class="py-3 px-4 font-bold text-emerald-600">8 ms</td>
                        <td class="py-3 px-4 text-slate-400 font-sans text-xs">Just now</td>
                    </tr>
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 font-sans font-bold text-slate-800 dark:text-white">Push Gateway</td>
                        <td class="py-3 px-4 text-slate-500">api/v1/notifications</td>
                        <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600">Operational</span></td>
                        <td class="py-3 px-4 font-bold text-emerald-600">24 ms</td>
                        <td class="py-3 px-4 text-slate-400 font-sans text-xs">1 minute ago</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    private bool _isPinging = false;
    private string _dbLatency = "4 ms";
    private int _cpuPercent = 14;

    private async Task RunDiagnostic()
    {
        _isPinging = true;
        await Task.Delay(400);
        _dbLatency = "2 ms";
        _cpuPercent = 16;
        _isPinging = false;
    }
}
