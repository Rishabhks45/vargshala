@page "/controlpanel/logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@rendermode InteractiveServer

<PageTitle>System &amp; Audit Logs - Control Panel</PageTitle>

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">📜</span>
                System Logs &amp; Security Audit
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Live audit trail, authentication logs, tenant query security, and unhandled exception traces.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button class="px-3.5 py-2 rounded-xl border border-tealborder dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-[#111c21] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all flex items-center gap-1.5 shadow-2xs">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Download Audit Log
            </button>
            <button @onclick="RefreshLogs"
                    class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold hover:from-[#00a89a] hover:to-[#00897b] transition-all flex items-center gap-1.5 shadow-md">
                <svg class="w-3.5 h-3.5 @(_isRefreshing ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Refresh Stream
            </button>
        </div>
    </div>

    <!-- Live Counters -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Total Events (24h)</span>
            <div class="text-2xl font-black text-slate-800 dark:text-white mt-1">12,490</div>
            <span class="text-[10px] text-teal-600 font-medium">Standard operations</span>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Auth Logins</span>
            <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">1,842</div>
            <span class="text-[10px] text-emerald-600 font-medium">99.2% success rate</span>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Warnings</span>
            <div class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">14</div>
            <span class="text-[10px] text-amber-600 font-medium">Rate limit throttling</span>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Exceptions (500)</span>
            <div class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">1</div>
            <span class="text-[10px] text-rose-500 font-medium">Resolved automatically</span>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" @bind="_search" @bind:event="oninput"
                   placeholder="Filter by keyword, IP address, user or trace ID..."
                   class="w-full pl-10 pr-4 py-2 rounded-xl text-xs bg-slate-50 dark:bg-slate-800/50 border border-tealborder dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:border-[#009488]" />
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <select @bind="_levelFilter" class="px-3 py-2 rounded-xl text-xs bg-slate-50 dark:bg-slate-800/50 border border-tealborder dark:border-slate-700 text-slate-700 dark:text-slate-200 focus:outline-none">
                <option value="All">All Levels</option>
                <option value="Info">Information Only</option>
                <option value="Warning">Warnings Only</option>
                <option value="Error">Errors Only</option>
                <option value="Security">Security &amp; Auth</option>
            </select>

            <select @bind="_sourceFilter" class="px-3 py-2 rounded-xl text-xs bg-slate-50 dark:bg-slate-800/50 border border-tealborder dark:border-slate-700 text-slate-700 dark:text-slate-200 focus:outline-none">
                <option value="All">All Sources</option>
                <option value="Auth">Auth &amp; Cookie</option>
                <option value="EFCore">EF Core &amp; Database</option>
                <option value="Api">API Gateway</option>
            </select>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/40 border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono">
                        <th class="py-3 px-4">Time (IST)</th>
                        <th class="py-3 px-4">Level</th>
                        <th class="py-3 px-4">Source</th>
                        <th class="py-3 px-4">Message / Event</th>
                        <th class="py-3 px-4">Client IP</th>
                        <th class="py-3 px-4 text-right">Trace ID</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono text-[11px]">
                    @foreach (var log in FilteredLogs)
                    {
                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3 px-4 text-slate-500 whitespace-nowrap">@log.Timestamp</td>

                            <td class="py-3 px-4 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded-md font-bold text-[10px] @GetLevelBadgeClass(log.Level)">
                                    @log.Level
                                </span>
                            </td>

                            <td class="py-3 px-4 text-slate-700 dark:text-slate-300 font-bold whitespace-nowrap">@log.Source</td>

                            <td class="py-3 px-4 font-sans text-xs text-slate-800 dark:text-slate-200">
                                @log.Message
                            </td>

                            <td class="py-3 px-4 text-slate-500 whitespace-nowrap">@log.ClientIp</td>

                            <td class="py-3 px-4 text-right text-teal-600 dark:text-teal-400 whitespace-nowrap">
                                @log.TraceId
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    private string _search = "";
    private string _levelFilter = "All";
    private string _sourceFilter = "All";
    private bool _isRefreshing = false;

    public record LogEntry(
        string Timestamp,
        string Level,
        string Source,
        string Message,
        string ClientIp,
        string TraceId);

    private List<LogEntry> _logs = new()
    {
        new("01:08:42", "Info", "Auth", "Cookie signin successful for superadmin@vargshala.com. Role: SuperAdmin.", "127.0.0.1", "trc_84920"),
        new("01:06:15", "Info", "EFCore", "Tenant query executed with filter OrganizationId = 'f9c4025b-8c4f-5abf-c3ea-2345678901bc'. Duration: 12ms.", "192.168.1.14", "trc_84919"),
        new("00:58:20", "Warning", "Api", "Rate limit check: 45 req/min from IP 103.21.54.12 (Within tolerance).", "103.21.54.12", "trc_84918"),
        new("00:45:10", "Security", "Auth", "Password verification successful for user bcc@gmail.com. Issued 30m JWT.", "182.74.12.9", "trc_84917"),
        new("00:32:00", "Info", "Storage", "Study material PDF uploaded: Physics_Thermodynamics_Notes.pdf (4.2 MB).", "182.74.12.9", "trc_84916"),
        new("00:15:30", "Error", "Api", "Failed to send SMS gateway notification: provider response code 503.", "127.0.0.1", "trc_84915")
    };

    private IEnumerable<LogEntry> FilteredLogs => _logs.Where(l =>
        (string.IsNullOrWhiteSpace(_search) ||
         l.Message.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         l.Source.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         l.ClientIp.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         l.TraceId.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (_levelFilter == "All" || l.Level == _levelFilter) &&
        (_sourceFilter == "All" || l.Source == _sourceFilter));

    private string GetLevelBadgeClass(string level) => level switch
    {
        "Error" => "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20",
        "Warning" => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20",
        "Security" => "bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20",
        _ => "bg-teal-500/10 text-[#009488] border border-teal-500/20"
    };

    private async Task RefreshLogs()
    {
        _isRefreshing = true;
        await Task.Delay(300);
        _isRefreshing = false;
    }
}
