@page "/controlpanel"
@page "/controlpanel/platform"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,BackOffice,1001,1002")]
@rendermode InteractiveServer

<PageTitle>Platform Control Center - Control Panel</PageTitle>

<div class="space-y-6">

    <!-- Platform Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-[#004D40] p-1 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/Logo.svg" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                Platform Control Center
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Multi-tenant educational SaaS operational overview, customer growth, and system infrastructure.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-[#004D40]/10 text-[#004D40] dark:text-teal-300 text-xs font-black border border-teal-600/30 flex items-center gap-1.5 shadow-2xs">
                <span>🛡️</span>
                Control Panel Root
            </span>
            <a href="controlpanel/health"
               class="px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold flex items-center gap-1.5 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Systems 100% UP
            </a>
        </div>
    </div>

    <!-- Vargshala Platform Hero Showcase with Section.svg -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#004D40] via-[#00382E] to-[#002B23] border border-teal-700/60 shadow-xl p-5 sm:p-6 text-white flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-[#009488]/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-2.5 max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-900/80 border border-teal-500/40 text-[11px] font-bold text-teal-300">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                SaaS Multi-Tenant Cloud Architecture
            </div>
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
                Vargshala <span class="text-[#2DD4BF]">Platform Core</span>
            </h2>
            <p class="text-xs sm:text-sm text-teal-200/90 leading-relaxed">
                Centralized tenant isolation, automated subscription lifecycle, tenant database partition, and unified system telemetry.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="controlpanel/institutes" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white text-xs font-bold shadow-md transition-all">
                    <span>Manage Institutes</span>
                </a>
                <a href="controlpanel/subscriptions" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-teal-500/30 text-white text-xs font-semibold transition-all">
                    <span>Subscriptions</span>
                </a>
            </div>
        </div>

        <div class="relative z-10 w-full lg:w-auto flex justify-center lg:justify-end shrink-0">
            <img src="images/Section.svg" alt="Vargshala Institutes" class="w-full max-w-sm sm:max-w-md lg:max-w-lg h-auto object-contain drop-shadow-2xl hover:scale-[1.02] transition-transform duration-300" />
        </div>
    </div>

    <!-- Global Platform KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Institutes -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Coaching Institutes</span>
                <span class="w-8 h-8 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center text-sm font-bold">🏛️</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">94</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-2 font-medium">↑ +8 this month</span>
            </div>
        </div>

        <!-- 2. MRR -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Monthly Revenue (MRR)</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold">₹</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">₹1,84,500</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-2 font-medium">↑ +14.2% MoM</span>
            </div>
        </div>

        <!-- 3. SaaS Users -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Active Students &amp; Staff</span>
                <span class="w-8 h-8 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm font-bold">👥</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">2,840</span>
                <span class="text-[11px] text-indigo-600 dark:text-indigo-400 ml-2 font-medium">Across all tenants</span>
            </div>
        </div>

        <!-- 4. Uptime -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Platform Uptime</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold">💚</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">99.98%</span>
                <span class="text-[11px] text-slate-400 ml-2 font-medium">Zero downtime 30d</span>
            </div>
        </div>
    </div>

    <!-- SuperAdmin Quick Modules Nav Grid -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-4">
        <h2 class="text-sm font-bold text-slate-800 dark:text-white">Platform Control Modules</h2>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
            <a href="controlpanel/institutes" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">🏛️</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Institutes</div>
                <div class="text-[10px] text-slate-400 mt-0.5">94 Active</div>
            </a>

            <a href="controlpanel/subscriptions" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">💳</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Subscriptions</div>
                <div class="text-[10px] text-slate-400 mt-0.5">₹1.84L MRR</div>
            </a>

            <a href="controlpanel/coupons" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">🏷️</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Coupons</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Discounts</div>
            </a>

            <a href="controlpanel/payment-logs" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">🧾</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Payment Logs</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Gateway Audit</div>
            </a>

            <a href="controlpanel/push" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">🔔</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Push Alerts</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Broadcasts</div>
            </a>

            <a href="controlpanel/logs" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">📜</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">System Logs</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Audit Trail</div>
            </a>

            <a href="controlpanel/health" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1.5 group-hover:scale-110 transition-transform">📈</div>
                <div class="text-xs font-bold text-slate-800 dark:text-white">Health</div>
                <div class="text-[10px] text-emerald-600 mt-0.5">PG 18 &bull; 4ms</div>
            </a>
        </div>
    </div>

    <!-- Recently Onboarded Institutes -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white">Recently Onboarded Coaching Institutes</h2>
            <a href="controlpanel/institutes" class="text-xs font-bold text-[#009488] hover:underline">
                View All (94) →
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-2.5 px-3">Institute</th>
                        <th class="py-2.5 px-3">Owner / Contact</th>
                        <th class="py-2.5 px-3">City</th>
                        <th class="py-2.5 px-3">Enrolled</th>
                        <th class="py-2.5 px-3">Plan</th>
                        <th class="py-2.5 px-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3">
                            <div class="font-bold text-slate-800 dark:text-white">Apex Physics Academy</div>
                            <div class="text-[10px] text-teal-600 font-mono">ID: APEX01</div>
                        </td>
                        <td class="py-3 px-3 text-slate-600 dark:text-slate-300">Dr. Rajesh Kumar</td>
                        <td class="py-3 px-3 text-slate-500">Patna, Bihar</td>
                        <td class="py-3 px-3 font-semibold text-slate-700 dark:text-slate-200">185 Students</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-500/10 text-[#009488]">Standard</span></td>
                        <td class="py-3 px-3 text-right">
                            <a href="controlpanel/institutes" class="px-2.5 py-1 rounded-lg bg-teal-500/10 text-[#009488] font-bold hover:bg-teal-500/20 text-[11px]">Manage →</a>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3">
                            <div class="font-bold text-slate-800 dark:text-white">Brillent Coaching Center</div>
                            <div class="text-[10px] text-teal-600 font-mono">ID: BCC001</div>
                        </td>
                        <td class="py-3 px-3 text-slate-600 dark:text-slate-300">Vikash Sharma</td>
                        <td class="py-3 px-3 text-slate-500">Muzaffarpur, Bihar</td>
                        <td class="py-3 px-3 font-semibold text-slate-700 dark:text-slate-200">142 Students</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">Pro Institute</span></td>
                        <td class="py-3 px-3 text-right">
                            <a href="controlpanel/institutes" class="px-2.5 py-1 rounded-lg bg-teal-500/10 text-[#009488] font-bold hover:bg-teal-500/20 text-[11px]">Manage →</a>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3">
                            <div class="font-bold text-slate-800 dark:text-white">Gravity IIT &amp; Medical Prep</div>
                            <div class="text-[10px] text-teal-600 font-mono">ID: GRAV99</div>
                        </td>
                        <td class="py-3 px-3 text-slate-600 dark:text-slate-300">Ananya Verma</td>
                        <td class="py-3 px-3 text-slate-500">Ranchi, Jharkhand</td>
                        <td class="py-3 px-3 font-semibold text-slate-700 dark:text-slate-200">320 Students</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400">Enterprise</span></td>
                        <td class="py-3 px-3 text-right">
                            <a href="controlpanel/institutes" class="px-2.5 py-1 rounded-lg bg-teal-500/10 text-[#009488] font-bold hover:bg-teal-500/20 text-[11px]">Manage →</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
