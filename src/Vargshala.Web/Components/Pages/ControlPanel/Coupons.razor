@page "/controlpanel/coupons"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@rendermode InteractiveServer

<PageTitle>Coupons &amp; Discounts | Control Panel</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header & Action Controls (Matched with Students.razor) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">🏷️</span>
                Coupons &amp; Discounts
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Manage promotional coupon codes, percentage/flat discounts, usage caps, and institute subscription campaigns.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs hover:shadow-xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </span>
                <span>Create Coupon</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Exact Structure from Students.razor) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Active Coupons</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_coupons.Count(c => c.IsActive)</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Redemptions</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_coupons.Sum(c => c.UsedCount)</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/80 text-rose-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Discount Conferred</p>
                <h3 class="text-lg font-extrabold text-rose-600 dark:text-rose-400">₹46,250</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Top Campaign</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">WELCOME50</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls (Exact Students.razor Component Layout) -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <!-- Search Input with Clear Button -->
        <div class="relative flex-1 w-full lg:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </span>
            <input type="text" 
                   @bind="_searchQuery" 
                   @bind:event="oninput"
                   placeholder="Search coupon code, campaign description..." 
                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" @onclick="() => _searchQuery = string.Empty" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_selectedType" Options="_typeFilterOptions" Placeholder="All Discount Types" />
            <CustomSelect @bind-Value="_selectedStatus" Options="_statusFilterOptions" Placeholder="All Status" />
        </div>
    </div>

    <!-- Coupons Data Table (Pixel-Matched Layout with Full Dark Mode & TableSortState) -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                        <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Code")'>
                            <div class="flex items-center gap-1.5">
                                <span>Coupon Code</span>
                                <span class="@_sortState.GetIndicatorClass("Code")">@_sortState.GetIndicator("Code")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Discount")'>
                            <div class="flex items-center gap-1.5">
                                <span>Discount Value</span>
                                <span class="@_sortState.GetIndicatorClass("Discount")">@_sortState.GetIndicator("Discount")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Plan")'>
                            <div class="flex items-center gap-1.5">
                                <span>Applicable Plan</span>
                                <span class="@_sortState.GetIndicatorClass("Plan")">@_sortState.GetIndicator("Plan")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Usage")'>
                            <div class="flex items-center gap-1.5">
                                <span>Redemptions / Cap</span>
                                <span class="@_sortState.GetIndicatorClass("Usage")">@_sortState.GetIndicator("Usage")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors group" @onclick='() => _sortState.Toggle("Expiry")'>
                            <div class="flex items-center gap-1.5">
                                <span>Valid Until</span>
                                <span class="@_sortState.GetIndicatorClass("Expiry")">@_sortState.GetIndicator("Expiry")</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/80 dark:divide-slate-800/40 text-xs">
                    @if (FilteredCoupons.Any())
                    {
                        @foreach (var coupon in FilteredCoupons)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-[#152329]/60 transition-colors">
                                <!-- Coupon Code & Description -->
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-black text-xs text-[#009488] bg-teal-50 dark:bg-teal-950/60 px-2.5 py-1 rounded-lg border border-teal-500/30 tracking-wider">
                                            @coupon.Code
                                        </span>
                                        <button type="button" @onclick="() => CopyCode(coupon.Code)" title="Copy Code"
                                                class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 transition-colors">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                        </button>
                                    </div>
                                    <div class="text-[11px] text-slate-400 mt-1 max-w-xs truncate">@coupon.Description</div>
                                </td>

                                <!-- Discount Value -->
                                <td class="py-3.5 px-4">
                                    @if (coupon.IsPercentage)
                                    {
                                        <span class="text-emerald-600 dark:text-emerald-400 font-extrabold text-sm">@coupon.DiscountValue% OFF</span>
                                    }
                                    else
                                    {
                                        <span class="text-indigo-600 dark:text-indigo-400 font-extrabold text-sm">₹@coupon.DiscountValue FLAT</span>
                                    }
                                </td>

                                <!-- Applicable Plan -->
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-[#18262c] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                        @coupon.ApplicablePlan
                                    </span>
                                </td>

                                <!-- Usage Stats with Progress Bar -->
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center justify-between text-[11px] mb-1 font-semibold text-slate-700 dark:text-slate-300">
                                        <span>@coupon.UsedCount / @coupon.MaxUses</span>
                                        <span class="text-slate-400 font-mono text-[10px]">@((coupon.UsedCount * 100) / coupon.MaxUses)%</span>
                                    </div>
                                    <div class="w-24 h-1.5 rounded-full bg-slate-100 dark:bg-[#18262c] overflow-hidden">
                                        <div class="h-full rounded-full bg-gradient-to-r from-[#009488] to-[#2DD4BF]" style="width: @((coupon.UsedCount * 100) / coupon.MaxUses)%"></div>
                                    </div>
                                </td>

                                <!-- Expiry Date -->
                                <td class="py-3.5 px-4 font-mono text-slate-600 dark:text-slate-400 text-[11px]">
                                    @coupon.ExpiryDate
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3.5 px-4 text-center">
                                    @if (coupon.IsActive)
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Action Menu (Dropdown exact like Students.razor) -->
                                <td class="py-3.5 px-6 text-right relative">
                                    <div class="inline-block text-left">
                                        <button type="button" 
                                                @onclick="() => ToggleMenu(coupon.Code)" 
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                            <svg class="w-4 h-4 font-extrabold" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M6 10a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4zm6 0a2 2 0 110 4 2 2 0 010-4z"/>
                                            </svg>
                                        </button>

                                        @if (_activeMenuCode == coupon.Code)
                                        {
                                            <div class="fixed inset-0 z-30" @onclick="() => _activeMenuCode = null"></div>
                                            <div class="absolute right-0 top-full mt-1 w-44 rounded-2xl bg-white dark:bg-[#111c21] shadow-2xl border border-slate-200/90 dark:border-slate-800 py-2 z-40 text-left animate-in fade-in zoom-in-95 duration-150 select-none">
                                                <button type="button" 
                                                        @onclick="() => CopyCode(coupon.Code)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-[#18262c] flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                    <span>Copy Code</span>
                                                </button>
                                                <button type="button" 
                                                        @onclick="() => OpenEditDrawerAsync(coupon)"
                                                        class="w-full px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-[#18262c] flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                    <span>Edit Coupon</span>
                                                </button>
                                                <div class="my-1.5 border-t border-slate-100 dark:border-slate-800"></div>
                                                <button type="button" 
                                                        @onclick="() => ToggleCouponStatus(coupon)"
                                                        class="w-full px-4 py-2 text-xs font-semibold @(coupon.IsActive ? "text-rose-600 dark:text-rose-400 hover:bg-rose-50/80 dark:hover:bg-rose-950/50" : "text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50/80") flex items-center gap-2.5 transition-colors cursor-pointer">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                                                    <span>@(coupon.IsActive ? "Deactivate" : "Activate")</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No coupons found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination (Exact Students.razor Footer) -->
        <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
            <div>
                Showing <span class="font-bold text-slate-800 dark:text-white">1-@FilteredCoupons.Count</span> of <span class="font-bold text-slate-800 dark:text-white">@_coupons.Count</span> coupons
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-400 dark:text-slate-500 disabled:opacity-40" disabled>
                    Previous
                </button>
                <button type="button" class="w-8 h-8 rounded-lg bg-[#009488] text-white font-bold flex items-center justify-center">
                    1
                </button>
                <button type="button" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#1f3037]">
                    Next
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Create / Edit Coupon Slide-Over (Exact Match with Students.razor) -->
<!-- ========================================================================= -->
@if (_showAddEditDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏷️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingCoupon == null ? "Create New Coupon" : "Edit Coupon Details")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingCoupon == null ? "Configure promotional discount for SaaS subscriptions" : $"Updating parameters for {_editingCoupon.Code}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Coupon Code (Uppercase)</label>
                <input type="text" @bind="_formCode" placeholder="e.g. FESTIVE30"
                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none font-mono font-bold uppercase text-slate-800 dark:text-white" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Discount Type</label>
                    <select @bind="_formIsPercentage"
                            class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white">
                        <option value="true">Percentage (%)</option>
                        <option value="false">Flat Amount (₹)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Discount Value</label>
                    <input type="number" @bind="_formDiscountValue"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-bold" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Applicable Plan</label>
                <select @bind="_formApplicablePlan"
                        class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white">
                    <option value="All Plans">All Plans</option>
                    <option value="Standard">Standard (₹999)</option>
                    <option value="Pro Institute">Pro Institute (₹2,499)</option>
                    <option value="Enterprise">Enterprise (₹5,999)</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Max Redemptions</label>
                    <input type="number" @bind="_formMaxUses"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Valid Until (Expiry)</label>
                    <input type="date" @bind="_formExpiryDate"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white font-mono" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Campaign Description</label>
                <textarea rows="3" @bind="_formDescription" placeholder="e.g. Diwali festive special promotion for new coaching centers"
                          class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white"></textarea>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" id="couponActive" @bind="_formIsActive" class="w-4 h-4 rounded text-[#009488] focus:ring-[#009488]" />
                <label for="couponActive" class="text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
                    Activate coupon immediately
                </label>
            </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-end gap-3 shrink-0">
            <button type="button" 
                    @onclick="CloseDrawerAsync"
                    class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="button" 
                    @onclick="SaveCouponAsync"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                @(_editingCoupon == null ? "Save & Activate" : "Update Coupon")
            </button>
        </div>

    </div>
}

@code {
    private string _searchQuery = "";
    private string _selectedType = "";
    private string _selectedStatus = "";
    private string? _activeMenuCode;

    private readonly TableSortState _sortState = new();

    private readonly List<CustomSelect.CustomSelectOption> _typeFilterOptions = new()
    {
        new("", "All Discount Types"),
        new("Percentage", "Percentage (%)"),
        new("Flat", "Flat Amount (₹)")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Active", "Active Only"),
        new("Inactive", "Inactive Only")
    };

    public record CouponItem(
        string Code,
        string Description,
        bool IsPercentage,
        decimal DiscountValue,
        string ApplicablePlan,
        int UsedCount,
        int MaxUses,
        string ExpiryDate,
        bool IsActive);

    private List<CouponItem> _coupons = new()
    {
        new("WELCOME50", "Flat 50% discount for first-time coaching institute registrations", true, 50, "All Plans", 84, 100, "31 Dec 2026", true),
        new("PROANNUAL", "Flat ₹1,000 off on Pro Institute annual subscription", false, 1000, "Pro Institute", 36, 50, "15 Nov 2026", true),
        new("STARTUP20", "20% off for newly established coaching institutes (<50 students)", true, 20, "Standard", 28, 50, "30 Oct 2026", true),
        new("ENTERPRISEVIP", "Special VIP discount for multi-branch enterprise networks", false, 2000, "Enterprise", 12, 20, "31 Dec 2026", true),
        new("EARLYBIRD", "Early beta tester launch incentive campaign", true, 30, "All Plans", 8, 50, "30 Sep 2026", true),
        new("SUMMER2026", "Expired summer coaching enrollment discount", true, 25, "Standard", 50, 50, "15 Jul 2026", false)
    };

    private List<CouponItem> FilteredCoupons
    {
        get
        {
            var query = _coupons.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(c => c.Code.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         c.Description.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (_selectedType == "Percentage") query = query.Where(c => c.IsPercentage);
            else if (_selectedType == "Flat") query = query.Where(c => !c.IsPercentage);

            if (_selectedStatus == "Active") query = query.Where(c => c.IsActive);
            else if (_selectedStatus == "Inactive") query = query.Where(c => !c.IsActive);

            if (_sortState.IsSorted)
            {
                var isAsc = _sortState.Direction == SortDirection.Ascending;
                query = _sortState.Column switch
                {
                    "Code" => isAsc ? query.OrderBy(c => c.Code) : query.OrderByDescending(c => c.Code),
                    "Discount" => isAsc ? query.OrderBy(c => c.DiscountValue) : query.OrderByDescending(c => c.DiscountValue),
                    "Plan" => isAsc ? query.OrderBy(c => c.ApplicablePlan) : query.OrderByDescending(c => c.ApplicablePlan),
                    "Usage" => isAsc ? query.OrderBy(c => c.UsedCount) : query.OrderByDescending(c => c.UsedCount),
                    "Expiry" => isAsc ? query.OrderBy(c => c.ExpiryDate) : query.OrderByDescending(c => c.ExpiryDate),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private void ToggleMenu(string code)
    {
        _activeMenuCode = _activeMenuCode == code ? null : code;
    }

    private void ToggleCouponStatus(CouponItem coupon)
    {
        _activeMenuCode = null;
        var idx = _coupons.FindIndex(c => c.Code == coupon.Code);
        if (idx != -1)
        {
            _coupons[idx] = coupon with { IsActive = !coupon.IsActive };
        }
    }

    private void CopyCode(string code)
    {
        _activeMenuCode = null;
    }

    private void ExportCsv()
    {
    }

    // Drawer state
    private bool _showAddEditDrawer = false;
    private bool _isDrawerOpen = false;
    private CouponItem? _editingCoupon = null;

    private string _formCode = "";
    private bool _formIsPercentage = true;
    private decimal _formDiscountValue = 20;
    private string _formApplicablePlan = "All Plans";
    private int _formMaxUses = 100;
    private DateTime _formExpiryDate = DateTime.UtcNow.AddMonths(1);
    private string _formDescription = "";
    private bool _formIsActive = true;

    private async Task OpenAddDrawerAsync()
    {
        _editingCoupon = null;
        _formCode = "";
        _formIsPercentage = true;
        _formDiscountValue = 20;
        _formApplicablePlan = "All Plans";
        _formMaxUses = 100;
        _formExpiryDate = DateTime.UtcNow.AddMonths(1);
        _formDescription = "";
        _formIsActive = true;

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(CouponItem coupon)
    {
        _activeMenuCode = null;
        _editingCoupon = coupon;
        _formCode = coupon.Code;
        _formIsPercentage = coupon.IsPercentage;
        _formDiscountValue = coupon.DiscountValue;
        _formApplicablePlan = coupon.ApplicablePlan;
        _formMaxUses = coupon.MaxUses;
        _formExpiryDate = DateTime.UtcNow.AddMonths(1);
        _formDescription = coupon.Description;
        _formIsActive = coupon.IsActive;

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(300);
        _showAddEditDrawer = false;
    }

    private async Task SaveCouponAsync()
    {
        if (string.IsNullOrWhiteSpace(_formCode)) return;

        if (_editingCoupon != null)
        {
            var idx = _coupons.FindIndex(c => c.Code == _editingCoupon.Code);
            if (idx != -1)
            {
                _coupons[idx] = new CouponItem(
                    _formCode.ToUpperInvariant().Trim(),
                    _formDescription,
                    _formIsPercentage,
                    _formDiscountValue,
                    _formApplicablePlan,
                    _editingCoupon.UsedCount,
                    _formMaxUses,
                    _formExpiryDate.ToString("dd MMM yyyy"),
                    _formIsActive);
            }
        }
        else
        {
            _coupons.Insert(0, new CouponItem(
                _formCode.ToUpperInvariant().Trim(),
                _formDescription,
                _formIsPercentage,
                _formDiscountValue,
                _formApplicablePlan,
                0,
                _formMaxUses,
                _formExpiryDate.ToString("dd MMM yyyy"),
                _formIsActive));
        }

        await CloseDrawerAsync();
    }
}
