@page "/controlpanel/coupons"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Coupons
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services
@inject ICouponService CouponService
@inject INotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Coupons &amp; Discounts | Control Panel</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Coupons &amp; Discounts
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage promotional codes, percentage and flat discounts, usage limits, and subscription campaigns
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Create Coupon</span>
            </button>
        </div>
    </div>

    <!-- 4 Quick Stats KPI Cards (Theme 4 Deep Teal Standard - Real Database Metrics) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- 1. Active Coupons -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Coupons</p>
                <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">
                    @_coupons.Count(c => c.IsActive && !c.IsExpired)
                </h3>
                <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                    @_totalRecords Total Campaigns
                </p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
                </svg>
            </div>
        </div>

        <!-- 2. Total Redemptions -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Redemptions</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">
                    @_coupons.Sum(c => c.UsedCount).ToString("N0")
                </h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Across registered institutes</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>

        <!-- 3. Total Conferred Discounts -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Discounts Conferred</p>
                <h3 class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1">
                    ₹@(_coupons.Sum(c => c.UsedCount * (c.DiscountType == DiscountType.FlatAmount ? c.DiscountValue : 250)).ToString("N0"))
                </h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Estimated promotional savings</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center">
                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>

        <!-- 4. Top Performing Campaign -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Top Campaign</p>
                <h3 class="text-xl font-black text-amber-600 dark:text-amber-400 mt-1 font-mono tracking-wide">
                    @(_coupons.OrderByDescending(c => c.UsedCount).FirstOrDefault()?.Code ?? "NONE")
                </h3>
                <p class="text-[10px] text-slate-400 font-medium mt-0.5">
                    @(_coupons.OrderByDescending(c => c.UsedCount).FirstOrDefault()?.UsedCount ?? 0) redemptions logged
                </p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls Bar -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_query.Search" 
                         OnSearch="() => LoadCouponsAsync(1)" 
                         Placeholder="Search coupon code, campaign description..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto flex-wrap sm:flex-nowrap">
            <div class="w-36">
                <CustomSelect Value="_selectedType" 
                              ValueChanged="OnTypeFilterChanged" 
                              Options="_typeFilterOptions" 
                              Placeholder="All Discount Types" />
            </div>
            <div class="w-40">
                <CustomSelect Value="_selectedPlan" 
                              ValueChanged="OnPlanFilterChanged" 
                              Options="_planFilterOptions" 
                              Placeholder="All Plans" />
            </div>
            <div class="w-36">
                <CustomSelect Value="_selectedStatus" 
                              ValueChanged="OnStatusFilterChanged" 
                              Options="_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_query.Search) || !string.IsNullOrWhiteSpace(_selectedType) || !string.IsNullOrWhiteSpace(_selectedPlan) || !string.IsNullOrWhiteSpace(_selectedStatus))
            {
                <button type="button" 
                        @onclick="ClearFiltersAsync"
                        class="px-2.5 py-2 text-xs font-semibold text-rose-600 hover:text-rose-700 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-xl transition-colors cursor-pointer shrink-0 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    <span>Clear</span>
                </button>
            }
        </div>
    </div>

    <!-- Coupons & Discounts Data Table -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[840px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <!-- 1. Coupon Code & Campaign -->
                        <th class="w-[28%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Code")'>
                            <div class="flex items-center gap-1.5">
                                <span>Coupon &amp; Campaign</span>
                                <span class="@_sortState.GetIndicatorClass("Code")">@_sortState.GetIndicator("Code")</span>
                            </div>
                        </th>

                        <!-- 2. Discount Offer -->
                        <th class="w-[15%] py-2 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Discount")'>
                            <div class="flex items-center gap-1.5">
                                <span>Discount Offer</span>
                                <span class="@_sortState.GetIndicatorClass("Discount")">@_sortState.GetIndicator("Discount")</span>
                            </div>
                        </th>

                        <!-- 3. Applicable Plan -->
                        <th class="w-[13%] py-2 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Plan")'>
                            <div class="flex items-center gap-1.5">
                                <span>Scope / Plan</span>
                                <span class="@_sortState.GetIndicatorClass("Plan")">@_sortState.GetIndicator("Plan")</span>
                            </div>
                        </th>

                        <!-- 4. Usage / Quota -->
                        <th class="w-[15%] py-2 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Usage")'>
                            <div class="flex items-center gap-1.5">
                                <span>Redemption / Quota</span>
                                <span class="@_sortState.GetIndicatorClass("Usage")">@_sortState.GetIndicator("Usage")</span>
                            </div>
                        </th>

                        <!-- 5. Valid Until -->
                        <th class="w-[13%] py-2 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Expiry")'>
                            <div class="flex items-center gap-1.5">
                                <span>Valid Until</span>
                                <span class="@_sortState.GetIndicatorClass("Expiry")">@_sortState.GetIndicator("Expiry")</span>
                            </div>
                        </th>

                        <!-- 6. Status -->
                        <th class="w-[8%] py-2 px-4 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>

                        <!-- 7. Actions -->
                        <th class="w-[8%] py-2 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _coupons.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_coupons.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="8" />
                    }
                    else if (_coupons.Any())
                    {
                        @foreach (var coupon in _coupons)
                        {
                            var daysRemaining = (coupon.ExpiryDate.Date - DateTime.UtcNow.Date).Days;
                            var usagePct = Math.Min(100, (coupon.UsedCount * 100) / Math.Max(1, coupon.MaxUses));

                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors group">
                                <!-- 1. Coupon Code & Campaign Description -->
                                <td class="py-2 px-5">
                                    <div class="flex items-center gap-3">
                                        <!-- Ticket Icon Container -->
                                        <div class="w-8 h-8 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-[#009488] flex items-center justify-center font-bold text-xs shrink-0 border border-teal-200 dark:border-teal-800/60 shadow-2xs">
                                            <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
                                            </svg>
                                        </div>

                                        <div class="min-w-0">
                                            <!-- Code Pill with Instant Copy -->
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-teal-50/90 dark:bg-teal-950/60 border border-dashed border-teal-400/60 dark:border-teal-600/60 shadow-2xs">
                                                    <span class="font-mono font-black text-xs text-[#004D40] dark:text-teal-300 tracking-wider">
                                                        @coupon.Code
                                                    </span>
                                                    <button type="button" 
                                                            @onclick="() => CopyCodeAsync(coupon.Code)" 
                                                            title="Copy code to clipboard"
                                                            class="p-0.5 text-teal-600 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-200 transition-colors cursor-pointer">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                                        </svg>
                                                    </button>
                                                </div>

                                                <!-- Category Badge with Enum Display Name -->
                                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                                                    @coupon.CategoryName
                                                </span>
                                            </div>

                                            <!-- Description -->
                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 max-w-sm truncate font-medium" title="@coupon.Description">
                                                @coupon.Description
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- 2. Discount Offer -->
                                <td class="py-2 px-4">
                                    <div class="flex flex-col items-start gap-0.5">
                                        @if (coupon.DiscountType == DiscountType.Percentage)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-black bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                                <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5 1.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm-12 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                                                </svg>
                                                @coupon.DiscountValue% OFF
                                            </span>
                                            <span class="text-[10px] text-slate-400 font-medium">
                                                @(coupon.MaxDiscountAmount.HasValue ? $"Capped at ₹{coupon.MaxDiscountAmount.Value:N0}" : "No cap limit")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-black bg-teal-50 dark:bg-teal-950/70 text-[#004D40] dark:text-teal-200 border border-teal-200/80 dark:border-teal-800">
                                                <span class="font-bold">₹</span>@coupon.DiscountValue.ToString("N0") FLAT
                                            </span>
                                            <span class="text-[10px] text-slate-400 font-medium">
                                                @(coupon.MinOrderAmount.HasValue ? $"Min spend ₹{coupon.MinOrderAmount.Value:N0}" : "No min spend")
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- 3. Scope / Applicable Plan -->
                                <td class="py-2 px-4">
                                    <div class="flex items-center gap-1.5">
                                        @switch (coupon.ApplicablePlan)
                                        {
                                            case ApplicablePlan.Enterprise:
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                                                    <svg class="w-3 h-3 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                                                    </svg>
                                                    @coupon.ApplicablePlanName
                                                </span>
                                                break;
                                            case ApplicablePlan.ProInstitute:
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                                                    <svg class="w-3 h-3 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                                                    </svg>
                                                    @coupon.ApplicablePlanName
                                                </span>
                                                break;
                                            case ApplicablePlan.Standard:
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800">
                                                    <svg class="w-3 h-3 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                                                    </svg>
                                                    @coupon.ApplicablePlanName
                                                </span>
                                                break;
                                            default:
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-[#18262c] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                                    <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" />
                                                    </svg>
                                                    @coupon.ApplicablePlanName
                                                </span>
                                                break;
                                        }
                                    </div>
                                </td>

                                <!-- 4. Usage / Quota Progress -->
                                <td class="py-2 px-4">
                                    <div class="flex items-center justify-between text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                                        <span>
                                            @coupon.UsedCount <span class="text-slate-400 font-normal">/ @coupon.MaxUses</span>
                                        </span>
                                        <span class="font-mono text-[10px] px-1.5 py-0.2 rounded font-bold @(usagePct >= 90 ? "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                            @usagePct%
                                        </span>
                                    </div>
                                    <div class="w-28 h-1.5 rounded-full bg-slate-100 dark:bg-[#18262c] overflow-hidden border border-slate-200/60 dark:border-slate-800">
                                        <div class="h-full rounded-full transition-all duration-500 @(usagePct >= 100 ? "bg-rose-500" : usagePct >= 80 ? "bg-amber-500" : "bg-gradient-to-r from-[#004D40] to-[#009488]")" 
                                             style="width: @(usagePct)%"></div>
                                    </div>
                                    <div class="text-[9px] text-slate-400 mt-1 font-medium">
                                        @(coupon.MaxUses > coupon.UsedCount ? $"{coupon.MaxUses - coupon.UsedCount} redemptions left" : "Quota exhausted")
                                    </div>
                                </td>

                                <!-- 5. Valid Until -->
                                <td class="py-2 px-4">
                                    <div class="flex flex-col">
                                        <span class="font-mono text-slate-700 dark:text-slate-200 text-xs font-bold">
                                            @coupon.ExpiryDate.ToString("dd MMM yyyy")
                                        </span>
                                        <div class="mt-0.5">
                                            @if (coupon.IsExpired)
                                            {
                                                <span class="inline-flex items-center px-1.5 py-0.2 text-[9px] font-extrabold rounded bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-900">
                                                    Expired
                                                </span>
                                            }
                                            else if (daysRemaining <= 7)
                                            {
                                                <span class="inline-flex items-center px-1.5 py-0.2 text-[9px] font-extrabold rounded bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-900">
                                                    Ends in @daysRemaining d
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-slate-400 font-medium">
                                                    In @daysRemaining days
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- 6. Interactive Status Badge -->
                                <td class="py-2 px-4 text-center">
                                    <button type="button" 
                                            @onclick="() => ToggleCouponStatus(coupon)"
                                            title="Click to toggle status"
                                            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold cursor-pointer transition-all hover:scale-105 active:scale-95 @(coupon.IsActive && !coupon.IsExpired ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                        <span class="w-1.5 h-1.5 rounded-full @(coupon.IsActive && !coupon.IsExpired ? "bg-emerald-500 animate-pulse" : "bg-slate-400")"></span>
                                        @(coupon.IsActive && !coupon.IsExpired ? "Active" : coupon.IsExpired ? "Expired" : "Inactive")
                                    </button>
                                </td>

                                <!-- 7. Actions Column -->
                                <td class="py-2 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Quick Copy Code -->
                                        <button type="button" 
                                                @onclick="() => CopyCodeAsync(coupon.Code)"
                                                title="Copy Coupon Code"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                            </svg>
                                        </button>

                                        <!-- Edit Coupon -->
                                        <button type="button" 
                                                @onclick="() => OpenEditDrawerAsync(coupon)"
                                                title="Edit Coupon"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>

                                        <!-- Toggle Active / Pause -->
                                        <button type="button" 
                                                @onclick="() => ToggleCouponStatus(coupon)"
                                                title="@(coupon.IsActive ? "Deactivate Coupon" : "Activate Coupon")"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-teal-600 hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            @if (coupon.IsActive)
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5-6v6m-4.5 3a9 9 0 1118 0 9 9 0 01-18 0z" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
                                                </svg>
                                            }
                                        </button>

                                        <!-- Delete Coupon -->
                                        <button type="button" 
                                                @onclick="() => DeleteCoupon(coupon)"
                                                title="Delete Coupon"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-[#009488] flex items-center justify-center mx-auto mb-3">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                                    </svg>
                                </div>
                                <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No coupons or discounts found.</p>
                                <p class="text-xs text-slate-400 mt-1">Try resetting search filters or create a new coupon promotional code.</p>
                                <button type="button" 
                                        @onclick="ClearFiltersAsync" 
                                        class="mt-3 px-3 py-1.5 rounded-xl text-xs font-bold text-[#009488] bg-teal-50 dark:bg-teal-950/50 border border-teal-200 dark:border-teal-800 hover:bg-teal-100 transition-colors cursor-pointer">
                                    Reset Filters
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination -->
        <div class="shrink-0 px-5 py-2.5 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400 select-none bg-slate-50/50 dark:bg-[#111c21]/50">
            <div class="text-[11px] leading-tight">
                Showing <span class="font-bold text-slate-800 dark:text-white">@(_coupons.Any() ? (_query.PageNumber - 1) * _query.PageSize + 1 : 0)-@Math.Min(_query.PageNumber * _query.PageSize, _totalRecords)</span> of <span class="font-bold text-slate-800 dark:text-white">@_totalRecords</span> coupons
            </div>
            <div class="flex items-center gap-1">
                <button type="button" 
                        @onclick="() => LoadCouponsAsync(_query.PageNumber - 1)"
                        disabled="@(_query.PageNumber <= 1)"
                        class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 text-[11px] font-semibold hover:bg-slate-50 dark:hover:bg-[#1f3037] disabled:opacity-40 disabled:cursor-not-allowed transition-all leading-none cursor-pointer">
                    Previous
                </button>
                <span class="px-2 text-[11px] font-bold text-slate-700 dark:text-slate-300">
                    Page @_query.PageNumber of @Math.Max(1, _totalPages)
                </span>
                <button type="button" 
                        @onclick="() => LoadCouponsAsync(_query.PageNumber + 1)"
                        disabled="@(_query.PageNumber >= _totalPages)"
                        class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 text-[11px] font-semibold hover:bg-slate-50 dark:hover:bg-[#1f3037] disabled:opacity-40 disabled:cursor-not-allowed transition-all leading-none cursor-pointer">
                    Next
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Create / Edit Coupon Slide-Over (Standard max-w-lg) -->
<!-- ========================================================================= -->
@if (_showAddEditDrawer)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-teal-500/20 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold text-teal-200">
                    🏷️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingCoupon == null ? "Create New Coupon" : "Edit Coupon Details")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingCoupon == null ? "Configure promotional discount for SaaS subscriptions" : $"Updating parameters for {_editingCoupon.Code}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
            @if (!string.IsNullOrEmpty(_formError))
            {
                <AlertNotification Type="AlertType.Error"
                                   Message="@_formError"
                                   Dismissible="true"
                                   OnClose="() => _formError = null" />
            }

            <!-- Live Coupon Card Ticket Preview -->
            <div class="rounded-2xl bg-gradient-to-br from-[#004D40] to-[#00796B] p-4 text-white shadow-lg relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-[#009488]/40 rounded-full blur-2xl"></div>
                
                <div class="flex items-start justify-between relative z-10">
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] font-extrabold uppercase tracking-widest text-teal-200 bg-white/15 px-2 py-0.5 rounded">
                                @GetSelectedCategoryDisplayName()
                            </span>
                            <span class="text-[10px] text-teal-200/80">@GetSelectedPlanDisplayName()</span>
                        </div>
                        <div class="mt-2 flex items-baseline gap-2">
                            <h4 class="text-2xl font-black tracking-tight text-white">
                                @(_formTypeString == nameof(DiscountType.Percentage) ? $"{_formDiscountValue}% OFF" : $"₹{_formDiscountValue:N0} OFF")
                            </h4>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/20 border border-dashed border-white/40 font-mono font-black text-sm tracking-wider text-white shadow-xs">
                            @(string.IsNullOrWhiteSpace(_formCode) ? "COUPONCODE" : _formCode.ToUpperInvariant())
                        </span>
                    </div>
                </div>

                <div class="mt-3 pt-3 border-t border-white/20 flex items-center justify-between text-[10px] text-teal-100 relative z-10">
                    <span>Valid until: @_formExpiryDate.ToString("dd MMM yyyy")</span>
                    <span>Max Uses: @_formMaxUses</span>
                </div>
            </div>

            <!-- Form Inputs -->
            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Coupon Code (Uppercase) *</label>
                <input type="text" @bind="_formCode" placeholder="e.g. FESTIVE30"
                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none font-mono font-bold uppercase text-slate-800 dark:text-white" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Campaign Category *</label>
                    <CustomSelect @bind-Value="_formCategoryString" Options="_drawerCategoryOptions" Placeholder="Select Category" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Applicable Plan *</label>
                    <CustomSelect @bind-Value="_formPlanString" Options="_drawerPlanOptions" Placeholder="Select Plan" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Discount Type *</label>
                    <CustomSelect @bind-Value="_formTypeString" Options="_drawerTypeOptions" Placeholder="Select Type" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Discount Value *</label>
                    <input type="number" @bind="_formDiscountValue"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white font-bold" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Min Order Amount (₹)</label>
                    <input type="number" @bind="_formMinOrderAmount" placeholder="Optional"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Max Discount Cap (₹)</label>
                    <input type="number" @bind="_formMaxDiscountAmount" placeholder="Optional"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Max Redemptions *</label>
                    <input type="number" @bind="_formMaxUses"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white font-medium" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Valid Until (Expiry) *</label>
                    <input type="date" @bind="_formExpiryDate"
                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white font-mono" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Campaign Description</label>
                <textarea rows="3" @bind="_formDescription" placeholder="e.g. Special promotional launch discount for coaching institutes"
                          class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-0 focus:outline-none text-slate-800 dark:text-white resize-y"></textarea>
            </div>

            <div class="pt-1">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                    <input type="checkbox" @bind="_formIsActive" class="w-4 h-4 rounded text-[#009488] focus:ring-[#009488] border-slate-300" />
                    <span class="font-bold text-slate-700 dark:text-slate-200">Activate coupon immediately</span>
                </label>
            </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#142025] flex items-center justify-between gap-3 shrink-0">
            <button type="button" 
                    @onclick="CloseDrawerAsync"
                    class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold transition-all cursor-pointer">
                Cancel
            </button>
            <button type="button" 
                    @onclick="SaveCouponAsync"
                    class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer">
                @(_editingCoupon == null ? "Save Coupon" : "Update Coupon")
            </button>
        </div>

    </div>
}

@code {
    private readonly TableQueryState _query = new();
    private TableSortState _sortState => _query.SortState;
    private int _totalRecords = 0;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling((double)_totalRecords / Math.Max(1, _query.PageSize)));

    private string _selectedType = "";
    private string _selectedPlan = "";
    private string _selectedStatus = "";
    private string? _formError;
    private bool _isLoading = true;

    private readonly List<CustomSelect.CustomSelectOption> _typeFilterOptions = new()
    {
        new("", "All Discount Types"),
        new(nameof(DiscountType.Percentage), "Percentage (%)"),
        new(nameof(DiscountType.FlatAmount), "Flat Amount (₹)")
    };

    private readonly List<CustomSelect.CustomSelectOption> _planFilterOptions = new()
    {
        new("", "All Plans"),
        new(nameof(ApplicablePlan.Standard), "Standard Plan"),
        new(nameof(ApplicablePlan.ProInstitute), "Pro Institute"),
        new(nameof(ApplicablePlan.Enterprise), "Enterprise")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"),
        new("Active", "Active Only"),
        new("Inactive", "Inactive Only"),
        new("Expired", "Expired Only")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerTypeOptions = Enum.GetValues<DiscountType>()
        .Select(d => new CustomSelect.CustomSelectOption(d.ToString(), d.GetDisplayName()))
        .ToList();

    private readonly List<CustomSelect.CustomSelectOption> _drawerPlanOptions = Enum.GetValues<ApplicablePlan>()
        .Select(p => new CustomSelect.CustomSelectOption(p.ToString(), p.GetDisplayName()))
        .ToList();

    private readonly List<CustomSelect.CustomSelectOption> _drawerCategoryOptions = Enum.GetValues<CampaignCategory>()
        .Select(c => new CustomSelect.CustomSelectOption(c.ToString(), c.GetDisplayName()))
        .ToList();

    // Real dynamic coupons loaded from database API using PagedRequest
    private List<CouponDto> _coupons = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCouponsAsync(1);
    }

    private async Task LoadCouponsAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = Math.Max(1, page);

        try
        {
            DiscountType? discountType = Enum.TryParse<DiscountType>(_selectedType, out var dt) ? dt : null;
            ApplicablePlan? plan = Enum.TryParse<ApplicablePlan>(_selectedPlan, out var p) ? p : null;
            bool? isActive = _selectedStatus == "Active" ? true : _selectedStatus == "Inactive" ? false : null;

            var pagedRequest = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = _query.Search,
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : _sortState.Direction == SortDirection.Ascending ? "asc" : null
            };

            var res = await CouponService.GetCouponsPagedAsync(
                request: pagedRequest,
                discountType: discountType,
                plan: plan,
                isActive: isActive);

            if (res != null && res.Success && res.Data != null)
            {
                _coupons = res.Data.Items?.ToList() ?? new List<CouponDto>();
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _coupons = new();
                _totalRecords = 0;
                var errorMsg = res?.Message ?? "Failed to fetch coupons.";
                if (errorMsg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase))
                {
                    Toast.Error("Your session has expired or you are unauthorized. Please sign in again.", "Unauthorized");
                }
                else
                {
                    Toast.Error(errorMsg, "Loading Error");
                }
            }
        }
        catch (Exception ex)
        {
            _coupons = new();
            _totalRecords = 0;
            Toast.Error($"Network or server connection error: {ex.Message}", "Connection Error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnTypeFilterChanged(string val)
    {
        _selectedType = val;
        await LoadCouponsAsync(1);
    }

    private async Task OnPlanFilterChanged(string val)
    {
        _selectedPlan = val;
        await LoadCouponsAsync(1);
    }

    private async Task OnStatusFilterChanged(string val)
    {
        _selectedStatus = val;
        await LoadCouponsAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _query.SortState.Toggle(column);
        await LoadCouponsAsync(1);
    }

    private async Task ClearFiltersAsync()
    {
        _query.Search = "";
        _selectedType = "";
        _selectedPlan = "";
        _selectedStatus = "";
        _query.SortState.Reset();
        await LoadCouponsAsync(1);
    }

    private async Task ToggleCouponStatus(CouponDto coupon)
    {
        var res = await CouponService.ToggleStatusAsync(coupon.Id);
        if (res.Success)
        {
            coupon.IsActive = !coupon.IsActive;
            Toast.Success($"Coupon '{coupon.Code}' status set to {(coupon.IsActive ? "Active" : "Inactive")}.", "Status Updated");
        }
        else
        {
            Toast.Error(res.Message ?? "Status update failed.", "Status Update Failed");
        }
    }

    private async Task DeleteCoupon(CouponDto coupon)
    {
        var res = await CouponService.DeleteCouponAsync(coupon.Id);
        if (res.Success)
        {
            Toast.Success($"Coupon '{coupon.Code}' deleted successfully.", "Coupon Removed");
            await LoadCouponsAsync(_query.PageNumber);
        }
        else
        {
            Toast.Error(res.Message ?? "Delete failed.", "Delete Failed");
        }
    }

    private async Task CopyCodeAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            Toast.Success($"Coupon code '{code}' copied to clipboard!", "Copied");
        }
        catch
        {
            Toast.Info($"Code: {code}", "Coupon Code");
        }
    }

    private void ExportCsv()
    {
        Toast.Info("Exporting coupons list to CSV format...", "Export CSV");
    }

    // Drawer state
    private bool _showAddEditDrawer = false;
    private bool _isDrawerOpen = false;
    private CouponDto? _editingCoupon = null;

    private string _formCode = "";
    private string _formCategoryString = nameof(CampaignCategory.Promotional);
    private string _formTypeString = nameof(DiscountType.Percentage);
    private decimal _formDiscountValue = 20;
    private decimal? _formMinOrderAmount;
    private decimal? _formMaxDiscountAmount;
    private string _formPlanString = nameof(ApplicablePlan.AllPlans);
    private int _formMaxUses = 100;
    private DateTime _formExpiryDate = DateTime.UtcNow.AddMonths(1);
    private string _formDescription = "";
    private bool _formIsActive = true;

    private string GetSelectedCategoryDisplayName()
    {
        return Enum.TryParse<CampaignCategory>(_formCategoryString, out var cat) ? cat.GetDisplayName() : _formCategoryString;
    }

    private string GetSelectedPlanDisplayName()
    {
        return Enum.TryParse<ApplicablePlan>(_formPlanString, out var p) ? p.GetDisplayName() : _formPlanString;
    }

    private async Task OpenAddDrawerAsync()
    {
        _editingCoupon = null;
        _formError = null;
        _formCode = "";
        _formCategoryString = nameof(CampaignCategory.Promotional);
        _formTypeString = nameof(DiscountType.Percentage);
        _formDiscountValue = 20;
        _formMinOrderAmount = null;
        _formMaxDiscountAmount = null;
        _formPlanString = nameof(ApplicablePlan.AllPlans);
        _formMaxUses = 100;
        _formExpiryDate = DateTime.UtcNow.AddMonths(1);
        _formDescription = "";
        _formIsActive = true;

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(CouponDto coupon)
    {
        _editingCoupon = coupon;
        _formError = null;
        _formCode = coupon.Code;
        _formCategoryString = coupon.Category.ToString();
        _formTypeString = coupon.DiscountType.ToString();
        _formDiscountValue = coupon.DiscountValue;
        _formMinOrderAmount = coupon.MinOrderAmount;
        _formMaxDiscountAmount = coupon.MaxDiscountAmount;
        _formPlanString = coupon.ApplicablePlan.ToString();
        _formMaxUses = coupon.MaxUses;
        _formExpiryDate = coupon.ExpiryDate;
        _formDescription = coupon.Description ?? "";
        _formIsActive = coupon.IsActive;

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(250);
        _showAddEditDrawer = false;
    }

    private async Task SaveCouponAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formCode))
        {
            _formError = "Coupon code is required.";
            return;
        }

        if (_formDiscountValue <= 0)
        {
            _formError = "Discount value must be greater than zero.";
            return;
        }

        var discountType = Enum.TryParse<DiscountType>(_formTypeString, out var dt) ? dt : DiscountType.Percentage;
        var applicablePlan = Enum.TryParse<ApplicablePlan>(_formPlanString, out var ap) ? ap : ApplicablePlan.AllPlans;
        var category = Enum.TryParse<CampaignCategory>(_formCategoryString, out var cat) ? cat : CampaignCategory.Promotional;

        if (_editingCoupon != null)
        {
            var updateReq = new UpdateCouponRequest
            {
                Id = _editingCoupon.Id,
                Code = _formCode.ToUpperInvariant().Trim(),
                Category = category,
                Description = _formDescription?.Trim(),
                DiscountType = discountType,
                DiscountValue = _formDiscountValue,
                MinOrderAmount = _formMinOrderAmount,
                MaxDiscountAmount = _formMaxDiscountAmount,
                ApplicablePlan = applicablePlan,
                MaxUses = _formMaxUses,
                ExpiryDate = _formExpiryDate,
                IsActive = _formIsActive
            };

            var res = await CouponService.UpdateCouponAsync(updateReq);
            if (!res.Success)
            {
                _formError = res.Message;
                return;
            }

            Toast.Success($"Coupon '{updateReq.Code}' updated successfully.", "Coupon Updated");
            await LoadCouponsAsync();
        }
        else
        {
            var createReq = new CreateCouponRequest
            {
                Code = _formCode.ToUpperInvariant().Trim(),
                Category = category,
                Description = _formDescription?.Trim(),
                DiscountType = discountType,
                DiscountValue = _formDiscountValue,
                MinOrderAmount = _formMinOrderAmount,
                MaxDiscountAmount = _formMaxDiscountAmount,
                ApplicablePlan = applicablePlan,
                MaxUses = _formMaxUses,
                ExpiryDate = _formExpiryDate,
                IsActive = _formIsActive
            };

            var res = await CouponService.CreateCouponAsync(createReq);
            if (!res.Success)
            {
                _formError = res.Message;
                return;
            }

            Toast.Success($"Coupon '{createReq.Code}' created successfully.", "Coupon Created");
            await LoadCouponsAsync();
        }

        await CloseDrawerAsync();
    }
}
