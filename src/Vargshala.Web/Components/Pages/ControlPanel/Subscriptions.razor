@code {
    #region State Variables
    private List<SubscriptionPlanDto> _plans = new();
    private int _totalRecords = 0;
    private int _totalPages = 1;
    private bool _isLoading = true;
    private bool _isSaving = false;

    private readonly PagedRequest _query = new() { PageNumber = 1, PageSize = 10, SortBy = "Price", SortDirection = "asc" };
    private readonly TableSortState _sortState = new();
    private string _searchQuery = string.Empty;

    private string _selectedCycleString = "All";
    private string _selectedStatusString = "All";

    private readonly List<CustomSelect.CustomSelectOption> _cycleFilterOptions = new()
    {
        new("All", "All Cycles"),
        new(nameof(BillingCycle.Monthly), "Monthly"),
        new(nameof(BillingCycle.Quarterly), "Quarterly"),
        new(nameof(BillingCycle.Yearly), "Yearly"),
        new(nameof(BillingCycle.Trial), "7-Day Trial")
    };

    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("All", "All Status"),
        new("Active", "Active Only"),
        new("Inactive", "Inactive Only")
    };

    private readonly List<CustomSelect.CustomSelectOption> _billingCycleOptions = new()
    {
        new(nameof(BillingCycle.Monthly), "Monthly"),
        new(nameof(BillingCycle.Quarterly), "Quarterly"),
        new(nameof(BillingCycle.Yearly), "Yearly"),
        new(nameof(BillingCycle.Trial), "7-Day Trial")
    };
    #endregion

    #region Drawer Form State
    private bool _showAddEditDrawer = false;
    private bool _isDrawerOpen = false;
    private SubscriptionPlanDto? _editingPlan = null;
    private SubscriptionPlanDto? _planToDelete = null;
    private string? _formError = null;

    private string _formName = string.Empty;
    private string? _formDescription = null;
    private decimal _formPrice = 999;
    private BillingCycle _formBillingCycle = BillingCycle.Monthly;
    private int? _formMaxStudents = 250;
    private int? _formMaxTeachers = 25;
    private int? _formMaxBranches = 2;
    private bool _formIsActive = true;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync(1);
    }
    #endregion

    #region Data Loading
    private async Task LoadPlansAsync(int pageNumber = 1)
    {
        _isLoading = true;
        _query.PageNumber = pageNumber;
        _query.Search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim();
        _query.SortBy = _sortState.Column ?? "Price";
        _query.SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : "asc";

        bool? isActive = _selectedStatusString switch
        {
            "Active" => true,
            "Inactive" => false,
            _ => null
        };

        BillingCycle? cycle = Enum.TryParse<BillingCycle>(_selectedCycleString, out var parsedCycle)
            ? parsedCycle
            : null;

        var response = await PlanService.GetPlansPagedAsync(_query, isActive, cycle);
        if (response.Success && response.Data != null)
        {
            _plans = response.Data.Items;
            _totalRecords = response.Data.TotalRecords;
            _totalPages = response.Data.TotalPages;
        }
        else
        {
            _plans = new();
            _totalRecords = 0;
            _totalPages = 1;
            if (!string.IsNullOrEmpty(response.Message))
            {
                Toast.Error(response.Message);
            }
        }

        _isLoading = false;
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadPlansAsync(1);
    }

    private async Task HandleCycleChanged(string value)
    {
        _selectedCycleString = value;
        await LoadPlansAsync(1);
    }

    private async Task HandleStatusChanged(string value)
    {
        _selectedStatusString = value;
        await LoadPlansAsync(1);
    }

    private void HandleFormCycleChanged(string value)
    {
        if (Enum.TryParse<BillingCycle>(value, out var cycle))
        {
            _formBillingCycle = cycle;
        }
    }
    #endregion

    #region Drawer & Actions
    private async Task OpenAddDrawerAsync()
    {
        _editingPlan = null;
        _formError = null;
        _formName = string.Empty;
        _formDescription = null;
        _formPrice = 999;
        _formBillingCycle = BillingCycle.Monthly;
        _formMaxStudents = 250;
        _formMaxTeachers = 25;
        _formMaxBranches = 2;
        _formIsActive = true;

        _showAddEditDrawer = true;
        StateHasChanged();
        await Task.Delay(20);
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(SubscriptionPlanDto plan)
    {
        _editingPlan = plan;
        _formError = null;
        _formName = plan.Name;
        _formDescription = plan.Description;
        _formPrice = plan.Price;
        _formBillingCycle = plan.BillingCycle;
        _formMaxStudents = plan.MaxStudents;
        _formMaxTeachers = plan.MaxTeachers;
        _formMaxBranches = plan.MaxBranches;
        _formIsActive = plan.IsActive;

        _showAddEditDrawer = true;
        StateHasChanged();
        await Task.Delay(20);
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showAddEditDrawer = false;
        _editingPlan = null;
    }

    private async Task HandleSavePlanAsync()
    {
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Plan name is required.";
            return;
        }

        if (_formPrice < 0)
        {
            _formError = "Price must be 0 or greater.";
            return;
        }

        _isSaving = true;
        _formError = null;

        if (_editingPlan == null)
        {
            var createReq = new CreateSubscriptionPlanRequest
            {
                Name = _formName.Trim(),
                Description = _formDescription?.Trim(),
                Price = _formPrice,
                BillingCycle = _formBillingCycle,
                MaxStudents = _formMaxStudents,
                MaxTeachers = _formMaxTeachers,
                MaxBranches = _formMaxBranches,
                IsActive = _formIsActive
            };

            var res = await PlanService.CreatePlanAsync(createReq);
            if (res.Success)
            {
                Toast.Success($"Subscription plan '{_formName}' created successfully.");
                await CloseDrawerAsync();
                await LoadPlansAsync(_query.PageNumber);
            }
            else
            {
                _formError = res.Message ?? "Failed to create plan.";
            }
        }
        else
        {
            var updateReq = new UpdateSubscriptionPlanRequest
            {
                Id = _editingPlan.Id,
                Name = _formName.Trim(),
                Description = _formDescription?.Trim(),
                Price = _formPrice,
                BillingCycle = _formBillingCycle,
                MaxStudents = _formMaxStudents,
                MaxTeachers = _formMaxTeachers,
                MaxBranches = _formMaxBranches,
                IsActive = _formIsActive
            };

            var res = await PlanService.UpdatePlanAsync(_editingPlan.Id, updateReq);
            if (res.Success)
            {
                Toast.Success($"Subscription plan '{_formName}' updated successfully.");
                await CloseDrawerAsync();
                await LoadPlansAsync(_query.PageNumber);
            }
            else
            {
                _formError = res.Message ?? "Failed to update plan.";
            }
        }

        _isSaving = false;
    }

    private async Task TogglePlanStatusAsync(SubscriptionPlanDto plan)
    {
        var res = await PlanService.TogglePlanStatusAsync(plan.Id);
        if (res.Success)
        {
            plan.IsActive = !plan.IsActive;
            Toast.Success($"Plan '{plan.Name}' status updated.");
            StateHasChanged();
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to update plan status.");
        }
    }

    private void OpenDeleteModal(SubscriptionPlanDto plan)
    {
        _planToDelete = plan;
    }

    private async Task ConfirmDeletePlanAsync()
    {
        if (_planToDelete == null) return;

        var res = await PlanService.DeletePlanAsync(_planToDelete.Id);
        if (res.Success)
        {
            Toast.Success($"Plan '{_planToDelete.Name}' deleted.");
            _planToDelete = null;
            await LoadPlansAsync(_query.PageNumber);
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to delete plan.");
        }
    }

    private async Task ExportCsv()
    {
        if (!_plans.Any())
        {
            Toast.Warning("No plans available to export.");
            return;
        }

        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Plan Name,Billing Cycle,Price (INR),Max Students,Max Teachers,Max Branches,Status,Active Institutes");

        foreach (var p in _plans)
        {
            csv.AppendLine($"\"{p.Name}\",\"{p.BillingCycleName}\",{p.Price},\"{p.MaxStudentsDisplay}\",\"{p.MaxTeachersDisplay}\",\"{p.MaxBranchesDisplay}\",\"{(p.IsActive ? "Active" : "Inactive")}\",{p.ActiveInstitutesCount}");
        }

        var fileName = $"Vargshala_Pricing_Plans_{DateTime.UtcNow:yyyyMMdd}.csv";
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv", base64);
        Toast.Success("Plans exported to CSV.");
    }
    #endregion
}
