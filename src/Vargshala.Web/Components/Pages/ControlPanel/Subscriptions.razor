@page "/controlpanel/subscriptions"
@page "/controlpanel/subscription-plans"
@page "/controlpanel/plans"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Subscriptions
@using Vargshala.SharedKernel.Enums
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services
@inject ISubscriptionPlanService PlanService
@inject INotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Subscriptions &amp; Pricing Plans | Control Panel</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    SaaS Subscriptions &amp; Pricing Plans
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Configure Vargshala SaaS tiers, set capacity quotas (students, teachers, branches), and manage institute subscriptions
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="controlpanel/coupons" class="px-3.5 py-2 rounded-xl border border-tealborder dark:border-slate-800 text-xs font-semibold text-[#009488] bg-teal-50/50 dark:bg-teal-950/30 hover:bg-teal-100/50 transition-all flex items-center gap-1.5 shadow-2xs">
                <span>🏷️</span> Coupons &amp; Discounts
            </a>
            <a href="controlpanel/payment-logs" class="px-3.5 py-2 rounded-xl border border-tealborder dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-[#111c21] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all flex items-center gap-1.5 shadow-2xs">
                <span>💳</span> Payment Logs
            </a>
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>
            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>New Pricing Plan</span>
            </button>
        </div>
    </div>

    <!-- 4 Quick Stats KPI Cards (Theme 4 Deep Teal - Direct Display Without Blinking) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- 1. Total Plans -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Tiers</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_plans.Count(p => p.IsActive) Active • @_plans.Count(p => !p.IsActive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- 2. Active Monthly Plans -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Monthly Plans</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">
                        @_plans.Count(p => p.BillingCycle == BillingCycle.Monthly)
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Recurring Monthly Billing</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- 3. Enterprise / Unlimited Capacity -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Unlimited Tiers</p>
                    <h3 class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">
                        @_plans.Count(p => !p.MaxStudents.HasValue)
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">No Student/Branch Cap</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- 4. Subscribed Institutes -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Subscriptions</p>
                    <h3 class="text-2xl font-black text-[#009488] dark:text-teal-400 mt-1">
                        @_plans.Sum(p => p.ActiveInstitutesCount)
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Enrolled Coaching Institutes</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center font-bold text-sm">
                    🏛️
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Tier Cards Showcase (Interactive Overview) -->
    @if (_plans.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            @foreach (var plan in _plans.Take(4))
            {
                <div class="p-4 rounded-2xl border transition-all duration-200 @(plan.Name.Contains("Standard", StringComparison.OrdinalIgnoreCase) ? "border-[#009488]/40 bg-teal-50/40 dark:bg-teal-950/20 shadow-xs" : "border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#111c21] shadow-2xs") flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-black text-slate-800 dark:text-white">@plan.Name</span>
                            @if (plan.Name.Contains("Standard", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-[#009488]/15 text-[#009488]">Popular</span>
                            }
                            else if (plan.Name.Contains("Enterprise", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-purple-500/15 text-purple-600 dark:text-purple-400">Custom</span>
                            }
                            else if (plan.Name.Contains("Pro", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-indigo-500/15 text-indigo-600 dark:text-indigo-400">High Growth</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-amber-500/15 text-amber-600 dark:text-amber-400">Starter</span>
                            }
                        </div>
                        <div class="text-xl font-black text-slate-800 dark:text-white tracking-tight">
                            ₹@plan.Price.ToString("N0") <span class="text-xs font-normal text-slate-400">/@plan.BillingCycleName.ToLowerInvariant()</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 min-h-[32px]">
                            @(string.IsNullOrWhiteSpace(plan.Description) ? "All-in-one management suite with instant attendance, tests, and fees." : plan.Description)
                        </p>

                        <div class="space-y-1.5 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800/60 text-[11px] text-slate-600 dark:text-slate-300">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Max Students</span>
                                <span class="font-bold">@plan.MaxStudentsDisplay</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Max Teachers</span>
                                <span class="font-bold">@plan.MaxTeachersDisplay</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Max Branches</span>
                                <span class="font-bold">@plan.MaxBranchesDisplay</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between">
                        <span class="text-[10px] font-bold text-slate-400">
                            @plan.ActiveInstitutesCount Active Institutes
                        </span>
                        <button type="button" 
                                @onclick="() => OpenEditDrawerAsync(plan)"
                                class="text-[11px] font-bold text-[#009488] hover:underline cursor-pointer">
                            Edit Plan →
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Search & Filter Controls (Matched with Students.razor & Users.razor) -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_searchQuery" 
                         OnSearch="() => LoadPlansAsync(1)" 
                         Placeholder="Search plan by name, description..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-44">
                <CustomSelect Value="@_selectedCycleString" 
                              ValueChanged="HandleCycleChanged" 
                              Options="_cycleFilterOptions" 
                              Placeholder="All Billing Cycles" />
            </div>
            <div class="w-36">
                <CustomSelect Value="@_selectedStatusString" 
                              ValueChanged="HandleStatusChanged" 
                              Options="_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Pricing Plans Data Table (table-fixed, explicit percentage widths on all <th>, no blinking) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[860px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[24%] py-2.5 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Plan Name</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="w-[12%] py-2.5 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("BillingCycle")'>
                            <div class="flex items-center gap-1.5">
                                <span>Cycle</span>
                                <span class="@_sortState.GetIndicatorClass("BillingCycle")">@_sortState.GetIndicator("BillingCycle")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2.5 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Price")'>
                            <div class="flex items-center gap-1.5">
                                <span>Price (₹)</span>
                                <span class="@_sortState.GetIndicatorClass("Price")">@_sortState.GetIndicator("Price")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2.5 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("MaxStudents")'>
                            <div class="flex items-center gap-1.5">
                                <span>Max Students</span>
                                <span class="@_sortState.GetIndicatorClass("MaxStudents")">@_sortState.GetIndicator("MaxStudents")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2.5 px-3">
                            <div class="flex items-center gap-1.5">
                                <span>Teachers &amp; Branches</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2.5 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("IsActive")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("IsActive")">@_sortState.GetIndicator("IsActive")</span>
                            </div>
                        </th>
                        <th class="w-[12%] py-2.5 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _plans.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_plans.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="5" />
                    }
                    else if (_plans.Any())
                    {
                        @foreach (var plan in _plans)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors">
                                <!-- Plan Name & Description -->
                                <td class="py-2.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-xl bg-teal-500/10 text-[#009488] font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                            @(plan.Name.Length > 0 ? plan.Name[0].ToString() : "P")
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-800 dark:text-white leading-tight truncate">
                                                @plan.Name
                                            </div>
                                            <div class="text-[10px] text-slate-400 truncate mt-0.5">
                                                @(string.IsNullOrWhiteSpace(plan.Description) ? "Standard coaching management tier" : plan.Description)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Billing Cycle -->
                                <td class="py-2.5 px-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                        @plan.BillingCycleName
                                    </span>
                                </td>

                                <!-- Price -->
                                <td class="py-2.5 px-3 font-mono font-bold text-slate-800 dark:text-white">
                                    ₹@plan.Price.ToString("N2")
                                </td>

                                <!-- Max Students -->
                                <td class="py-2.5 px-3">
                                    @if (plan.MaxStudents.HasValue)
                                    {
                                        <span class="font-semibold text-slate-700 dark:text-slate-300">
                                            @plan.MaxStudents.Value.ToString("N0") Students
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 font-bold text-purple-600 dark:text-purple-400">
                                            <span>∞</span> Unlimited
                                        </span>
                                    }
                                </td>

                                <!-- Max Teachers & Branches -->
                                <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400 text-[11px]">
                                    <div>@plan.MaxTeachersDisplay Teachers</div>
                                    <div class="text-[10px] text-slate-400">@plan.MaxBranchesDisplay Branches</div>
                                </td>

                                <!-- Interactive Status Badge -->
                                <td class="py-2.5 px-3 text-center">
                                    <button type="button" 
                                            @onclick="() => TogglePlanStatusAsync(plan)"
                                            title="Click to toggle status"
                                            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold cursor-pointer transition-all hover:scale-105 active:scale-95 @(plan.IsActive ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                        <span class="w-1.5 h-1.5 rounded-full @(plan.IsActive ? "bg-emerald-500 animate-pulse" : "bg-slate-400")"></span>
                                        @(plan.IsActive ? "Active" : "Inactive")
                                    </button>
                                </td>

                                <!-- Actions -->
                                <td class="py-2.5 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Edit Plan -->
                                        <button type="button" 
                                                @onclick="() => OpenEditDrawerAsync(plan)"
                                                title="Edit Plan"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>

                                        <!-- Toggle Status -->
                                        <button type="button" 
                                                @onclick="() => TogglePlanStatusAsync(plan)"
                                                title="@(plan.IsActive ? "Deactivate Plan" : "Activate Plan")"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-teal-600 hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            @if (plan.IsActive)
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5-6v6m-4.5 3a9 9 0 1118 0 9 9 0 01-18 0z" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
                                                </svg>
                                            }
                                        </button>

                                        <!-- Delete Plan -->
                                        <button type="button" 
                                                @onclick="() => OpenDeleteModal(plan)"
                                                title="Delete Plan"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-all cursor-pointer inline-flex items-center justify-center">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="w-12 h-12 rounded-2xl bg-teal-50 dark:bg-teal-950/40 text-[#009488] flex items-center justify-center mx-auto mb-2 text-2xl">
                                    📦
                                </div>
                                <p class="font-bold text-slate-700 dark:text-slate-300 text-sm">No pricing plans found</p>
                                <p class="text-xs text-slate-400 mt-1">Try changing your search query or create a new plan.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="shrink-0 p-3 bg-white dark:bg-[#111c21] border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-500">
                Showing @((_query.PageNumber - 1) * _query.PageSize + (_plans.Count > 0 ? 1 : 0)) to @((_query.PageNumber - 1) * _query.PageSize + _plans.Count) of @_totalRecords records
            </span>
            <div class="flex items-center gap-2">
                <button type="button" 
                        @onclick="() => LoadPlansAsync(_query.PageNumber - 1)"
                        disabled="@(_query.PageNumber <= 1)"
                        class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 text-[11px] font-semibold hover:bg-slate-50 dark:hover:bg-[#1f3037] disabled:opacity-40 disabled:cursor-not-allowed transition-all leading-none cursor-pointer">
                    Previous
                </button>
                <span class="px-2 text-[11px] font-bold text-slate-700 dark:text-slate-300">
                    Page @_query.PageNumber of @Math.Max(1, _totalPages)
                </span>
                <button type="button" 
                        @onclick="() => LoadPlansAsync(_query.PageNumber + 1)"
                        disabled="@(_query.PageNumber >= _totalPages)"
                        class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-700 dark:text-slate-300 text-[11px] font-semibold hover:bg-slate-50 dark:hover:bg-[#1f3037] disabled:opacity-40 disabled:cursor-not-allowed transition-all leading-none cursor-pointer">
                    Next
                </button>
            </div>
        </div>
    </div>

</div>

