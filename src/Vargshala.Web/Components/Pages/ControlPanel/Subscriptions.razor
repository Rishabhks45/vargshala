@page "/controlpanel/subscriptions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,1001")]

<PageTitle>Subscriptions &amp; Billing - Control Panel</PageTitle>

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-[#004D40] text-teal-300 flex items-center justify-center text-sm shadow-md">💳</span>
                Subscriptions &amp; Revenue
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Manage SaaS pricing plans, track monthly recurring revenue (MRR) and institute billing.
            </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="controlpanel/coupons" class="px-3.5 py-2 rounded-xl border border-tealborder dark:border-slate-800 text-xs font-semibold text-[#009488] bg-teal-50/50 dark:bg-teal-950/30 hover:bg-teal-100/50 transition-all flex items-center gap-1.5 shadow-2xs">
                <span>🏷️</span> Coupons &amp; Discounts
            </a>
            <a href="controlpanel/payment-logs" class="px-3.5 py-2 rounded-xl border border-tealborder dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-[#111c21] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all flex items-center gap-1.5 shadow-2xs">
                <span>💳</span> Payment Logs
            </a>
            <button class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold hover:from-[#00a89a] hover:to-[#00897b] transition-all flex items-center gap-1.5 shadow-md">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Create Invoice
            </button>
        </div>
    </div>

    <!-- Revenue KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Monthly Recurring (MRR)</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold">₹</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">₹1,84,500</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-2 font-medium">↑ +14.2% this mo</span>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Paid Subscriptions</span>
                <span class="w-8 h-8 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center text-sm font-bold">✓</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">68</span>
                <span class="text-[11px] text-[#009488] ml-2 font-medium">out of 94 institutes</span>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Active Free Trials</span>
                <span class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-bold">⏳</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">22</span>
                <span class="text-[11px] text-amber-600 dark:text-amber-400 ml-2 font-medium">14 days trial</span>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Pending Renewals (7 Days)</span>
                <span class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-sm font-bold">⚠️</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-rose-600 dark:text-rose-400">9</span>
                <span class="text-[11px] text-rose-500 ml-2 font-medium">Auto-reminders active</span>
            </div>
        </div>
    </div>

    <!-- Pricing Tiers Overview -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white">Active SaaS Pricing Plans</h2>
            <span class="text-xs font-semibold text-[#009488]">4 Plans Configured</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Plan 1 -->
            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-700/60 bg-slate-50/50 dark:bg-slate-800/30 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Free Trial</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/10 text-amber-600 dark:text-amber-400">14 Days</span>
                    </div>
                    <div class="text-xl font-black text-slate-800 dark:text-white">₹0 <span class="text-xs font-normal text-slate-400">/mo</span></div>
                    <ul class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1.5 mt-3">
                        <li class="flex items-center gap-1.5">✓ Up to 50 Students</li>
                        <li class="flex items-center gap-1.5">✓ Attendance &amp; Batches</li>
                        <li class="flex items-center gap-1.5">✓ Basic Study Material</li>
                    </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-700/40 text-[11px] font-bold text-slate-500">
                    22 Active Coaching Institutes
                </div>
            </div>

            <!-- Plan 2 -->
            <div class="p-4 rounded-xl border border-teal-500/40 bg-teal-50/30 dark:bg-teal-950/20 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-teal-800 dark:text-teal-300">Standard</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-500/10 text-[#009488]">Popular</span>
                    </div>
                    <div class="text-xl font-black text-slate-800 dark:text-white">₹999 <span class="text-xs font-normal text-slate-400">/mo</span></div>
                    <ul class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1.5 mt-3">
                        <li class="flex items-center gap-1.5">✓ Up to 250 Students</li>
                        <li class="flex items-center gap-1.5">✓ Fees &amp; Expense Manager</li>
                        <li class="flex items-center gap-1.5">✓ Push Notifications</li>
                    </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-teal-200/60 dark:border-teal-800/40 text-[11px] font-bold text-[#009488]">
                    39 Active Coaching Institutes
                </div>
            </div>

            <!-- Plan 3 -->
            <div class="p-4 rounded-xl border border-indigo-500/30 bg-indigo-50/20 dark:bg-indigo-950/20 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300">Pro Institute</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">High Growth</span>
                    </div>
                    <div class="text-xl font-black text-slate-800 dark:text-white">₹2,499 <span class="text-xs font-normal text-slate-400">/mo</span></div>
                    <ul class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1.5 mt-3">
                        <li class="flex items-center gap-1.5">✓ Up to 1,000 Students</li>
                        <li class="flex items-center gap-1.5">✓ Online Exams &amp; Quizzes</li>
                        <li class="flex items-center gap-1.5">✓ SMS &amp; WhatsApp Alerts</li>
                    </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-indigo-200/60 dark:border-indigo-800/40 text-[11px] font-bold text-indigo-600 dark:text-indigo-400">
                    24 Active Coaching Institutes
                </div>
            </div>

            <!-- Plan 4 -->
            <div class="p-4 rounded-xl border border-purple-500/30 bg-purple-50/20 dark:bg-purple-950/20 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold text-purple-700 dark:text-purple-300">Enterprise</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-purple-500/10 text-purple-600 dark:text-purple-400">Custom</span>
                    </div>
                    <div class="text-xl font-black text-slate-800 dark:text-white">₹5,999 <span class="text-xs font-normal text-slate-400">/mo</span></div>
                    <ul class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1.5 mt-3">
                        <li class="flex items-center gap-1.5">✓ Unlimited Students</li>
                        <li class="flex items-center gap-1.5">✓ Custom Institute Domain</li>
                        <li class="flex items-center gap-1.5">✓ 24/7 Dedicated Support</li>
                    </ul>
                </div>
                <div class="mt-4 pt-3 border-t border-purple-200/60 dark:border-purple-800/40 text-[11px] font-bold text-purple-600 dark:text-purple-400">
                    5 Active Coaching Institutes
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Billing & Invoices Table -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white">Recent Subscription Invoices</h2>
            
            <div class="flex items-center gap-2">
                <input type="text" placeholder="Search invoice or institute..."
                       class="px-3 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-800/50 border border-tealborder dark:border-slate-700 text-slate-700 dark:text-slate-200 focus:outline-none focus:border-[#009488]" />
                <select class="px-3 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-800/50 border border-tealborder dark:border-slate-700 text-slate-700 dark:text-slate-200">
                    <option>All Statuses</option>
                    <option>Paid</option>
                    <option>Pending</option>
                    <option>Overdue</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-3 px-3">Invoice #</th>
                        <th class="py-3 px-3">Institute Name</th>
                        <th class="py-3 px-3">Plan</th>
                        <th class="py-3 px-3">Billing Cycle</th>
                        <th class="py-3 px-3">Amount</th>
                        <th class="py-3 px-3">Status</th>
                        <th class="py-3 px-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3 font-mono font-bold text-slate-700 dark:text-slate-200">INV-2026-084</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">Apex Physics Academy</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-teal-500/10 text-[#009488]">Standard</span></td>
                        <td class="py-3 px-3 text-slate-500">01 Sep 2026 - 30 Sep 2026</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">₹999</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">Paid</span></td>
                        <td class="py-3 px-3 text-right">
                            <button class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/40">Receipt ↓</button>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3 font-mono font-bold text-slate-700 dark:text-slate-200">INV-2026-083</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">Brillent Coaching Center</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">Pro Institute</span></td>
                        <td class="py-3 px-3 text-slate-500">28 Aug 2026 - 27 Sep 2026</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">₹2,499</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">Paid</span></td>
                        <td class="py-3 px-3 text-right">
                            <button class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/40">Receipt ↓</button>
                        </td>
                    </tr>
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition-colors">
                        <td class="py-3 px-3 font-mono font-bold text-slate-700 dark:text-slate-200">INV-2026-082</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">Gravity IIT &amp; Medical Prep</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400">Enterprise</span></td>
                        <td class="py-3 px-3 text-slate-500">25 Aug 2026 - 24 Sep 2026</td>
                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">₹5,999</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/10 text-amber-600 dark:text-amber-400">Due Today</span></td>
                        <td class="py-3 px-3 text-right">
                            <button class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/40">Remind ✉</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
