@page "/student/fees"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using Vargshala.Contracts.Fees

<PageTitle>Fees & Payment Receipts | Student Portal</PageTitle>

<div class="space-y-6 transition-colors duration-200 pb-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Fee Summary & Receipts</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Review your enrollment fee status, installment breakdown, and download official payment receipts.</p>
        </div>
        <div>
            <button type="button" 
                    @onclick="() => _showReceiptModal = true"
                    class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#003d33] hover:to-[#00796b] shadow-md transition-all flex items-center gap-2 cursor-pointer">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Latest Payment Receipt</span>
            </button>
        </div>
    </div>

    <!-- Stats Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Course Fee</span>
            <div class="text-xl font-black text-slate-900 dark:text-white mt-1">₹45,000</div>
            <p class="text-[11px] text-slate-500 mt-0.5">Class 12 - PCM Entrance Batch</p>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Amount Paid</span>
            <div class="text-xl font-black text-emerald-600 dark:text-emerald-400 mt-1">₹45,000</div>
            <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5 flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                100% Cleared (All Installments Paid)
            </p>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Outstanding Due</span>
            <div class="text-xl font-black text-slate-700 dark:text-slate-300 mt-1">₹0</div>
            <p class="text-[11px] text-slate-400 mt-0.5">No pending dues for current term</p>
        </div>
    </div>

    <!-- Official Payment Receipts Table -->
    <div class="bg-white dark:bg-[#111c21] rounded-2xl border border-tealborder/70 dark:border-slate-800/80 shadow-2xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
                <h3 class="font-bold text-sm text-slate-800 dark:text-white">Payment Receipts History</h3>
                <p class="text-[11px] text-slate-400 mt-0.5">Click download or view on any payment to obtain your standard printable receipt.</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                1 Verified Receipt
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
                <thead class="bg-slate-50/70 dark:bg-slate-800/40 text-[10.5px] font-bold text-slate-500 dark:text-slate-400 uppercase border-b border-slate-100 dark:border-slate-800">
                    <tr>
                        <th class="py-3 px-4">Receipt No</th>
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4">Particulars</th>
                        <th class="py-3 px-4">Payment Mode</th>
                        <th class="py-3 px-4 text-right">Amount Paid</th>
                        <th class="py-3 px-4 text-center">Status</th>
                        <th class="py-3 px-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="py-3.5 px-4 font-mono font-bold text-[#009488]">@_receipt.ReceiptNumber</td>
                        <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300">@_receipt.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td class="py-3.5 px-4 text-slate-800 dark:text-white font-medium">Class 12 - PCM Coaching (Term 1 & 2)</td>
                        <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300">
                            <span class="inline-flex items-center gap-1 font-semibold">
                                @_receipt.PaymentMethod
                                <span class="text-[10px] text-slate-400 font-mono">(@_receipt.TransactionReference)</span>
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right font-black text-slate-900 dark:text-white text-sm">
                            ₹@_receipt.Amount.ToString("N0")
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                PAID
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <button type="button" 
                                    @onclick="() => _showReceiptModal = true"
                                    class="px-3 py-1.5 rounded-xl text-xs font-bold text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-teal-200 dark:border-teal-800/80 transition-all inline-flex items-center gap-1.5 cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                <span>View Receipt</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Standard Printable & Downloadable Fee Receipt Modal -->
<FeeReceiptModal @bind-IsOpen="_showReceiptModal"
                 Receipt="_receipt"
                 InstituteName="Vargshala Institute"
                 InstituteTagline="Academic Excellence & Coaching Center" />

@code {
    private bool _showReceiptModal = false;

    private PaymentDto _receipt = new()
    {
        ReceiptNumber = "RCP-2026-9021",
        StudentName = "Aryan Kapoor",
        StudentRollNumber = "ROL-1204",
        StudentCode = "STU-2026-9021",
        BranchName = "Main Campus (Science Wing)",
        Amount = 45000,
        PaymentDate = new DateTime(2026, 9, 1, 11, 30, 0),
        PaymentMethod = "UPI",
        TransactionReference = "UPI/260901/78491290",
        Remarks = "Class 12 - PCM Comprehensive Coaching Package (Term 1 & 2)",
        Allocations = new()
        {
            new() { InstallmentNumber = 1, DueDate = new DateOnly(2026, 8, 15), AllocatedAmount = 25000 },
            new() { InstallmentNumber = 2, DueDate = new DateOnly(2026, 9, 1), AllocatedAmount = 20000 }
        }
    };
}
