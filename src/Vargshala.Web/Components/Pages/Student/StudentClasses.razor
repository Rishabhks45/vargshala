@page "/student/classes"
@page "/student/my-classes"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer

<PageTitle>My Classes | Student Portal</PageTitle>

<div class="space-y-6 transition-colors duration-200">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">My Classes & Subjects</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">View your enrolled subjects, faculty teachers, and lecture details.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] dark:text-teal-300 border border-teal-200 dark:border-teal-800/80 shadow-2xs">
                Class 12 • Science
            </span>
        </div>
    </div>

    <!-- Classes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Mathematics -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-sm">
                        📐
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">
                        Active
                    </span>
                </div>
                <div>
                    <h3 class="font-black text-base text-slate-800 dark:text-white">Mathematics</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Amit Sir • Room 101</p>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-500 space-y-1">
                    <div class="flex justify-between">
                        <span>Batch:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">Morning Batch</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Time:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">07:00 AM - 08:30 AM</span>
                    </div>
                </div>
            </div>
            <a href="student/study-material" class="mt-4 w-full py-2 rounded-xl bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 text-[#009488] dark:text-teal-300 text-xs font-bold text-center border border-teal-200/80 dark:border-teal-800/80 transition-colors">
                View Materials
            </a>
        </div>

        <!-- Physics -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center font-black text-sm">
                        ⚡
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">
                        Active
                    </span>
                </div>
                <div>
                    <h3 class="font-black text-base text-slate-800 dark:text-white">Physics</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Rahul Sir • Room 102</p>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-500 space-y-1">
                    <div class="flex justify-between">
                        <span>Batch:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">Morning Batch</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Time:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">10:00 AM - 11:30 AM</span>
                    </div>
                </div>
            </div>
            <a href="student/study-material" class="mt-4 w-full py-2 rounded-xl bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 text-[#009488] dark:text-teal-300 text-xs font-bold text-center border border-teal-200/80 dark:border-teal-800/80 transition-colors">
                View Materials
            </a>
        </div>

        <!-- Chemistry -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-sm">
                        🧪
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">
                        Active
                    </span>
                </div>
                <div>
                    <h3 class="font-black text-base text-slate-800 dark:text-white">Chemistry</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Neha Ma'am • Room 201</p>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-500 space-y-1">
                    <div class="flex justify-between">
                        <span>Batch:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">Afternoon Batch</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Time:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">01:00 PM - 02:30 PM</span>
                    </div>
                </div>
            </div>
            <a href="student/study-material" class="mt-4 w-full py-2 rounded-xl bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 text-[#009488] dark:text-teal-300 text-xs font-bold text-center border border-teal-200/80 dark:border-teal-800/80 transition-colors">
                View Materials
            </a>
        </div>

        <!-- English -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 flex items-center justify-center font-black text-sm">
                        📖
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-200">
                        Active
                    </span>
                </div>
                <div>
                    <h3 class="font-black text-base text-slate-800 dark:text-white">English</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Suman Sir • Room 203</p>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-500 space-y-1">
                    <div class="flex justify-between">
                        <span>Batch:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">Evening Batch</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Time:</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">04:00 PM - 05:30 PM</span>
                    </div>
                </div>
            </div>
            <a href="student/study-material" class="mt-4 w-full py-2 rounded-xl bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 text-[#009488] dark:text-teal-300 text-xs font-bold text-center border border-teal-200/80 dark:border-teal-800/80 transition-colors">
                View Materials
            </a>
        </div>
    </div>
</div>
