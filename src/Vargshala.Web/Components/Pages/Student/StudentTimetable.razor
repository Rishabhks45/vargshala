@page "/student/timetable"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer

<PageTitle>My Timetable | Student Portal</PageTitle>

<div class="space-y-6 transition-colors duration-200">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Weekly Timetable</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Check your weekly class schedules, teachers, and assigned rooms.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] dark:text-teal-300 border border-teal-200 dark:border-teal-800/80 shadow-2xs">
                📅 Current Academic Week
            </span>
        </div>
    </div>

    <!-- Timetable Grid -->
    <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-2xs overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse min-w-[600px]">
            <thead>
                <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-500 font-bold">
                    <th class="py-3 px-4">Time</th>
                    <th class="py-3 px-4">Mon</th>
                    <th class="py-3 px-4">Tue</th>
                    <th class="py-3 px-4">Wed</th>
                    <th class="py-3 px-4">Thu</th>
                    <th class="py-3 px-4">Fri</th>
                    <th class="py-3 px-4">Sat</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
                <tr>
                    <td class="py-3.5 px-4 font-bold text-slate-700 dark:text-slate-300">07:00 AM</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-semibold">Maths (R-101)</td>
                </tr>
                <tr>
                    <td class="py-3.5 px-4 font-bold text-slate-700 dark:text-slate-300">10:00 AM</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                    <td class="py-3.5 px-4 text-amber-600 font-semibold">Physics (R-102)</td>
                </tr>
                <tr>
                    <td class="py-3.5 px-4 font-bold text-slate-700 dark:text-slate-300">01:00 PM</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                    <td class="py-3.5 px-4 text-blue-600 font-semibold">Chemistry (R-201)</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                    <td class="py-3.5 px-4 text-blue-600 font-semibold">Chemistry (R-201)</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                    <td class="py-3.5 px-4 text-blue-600 font-semibold">Chemistry (R-201)</td>
                </tr>
                <tr>
                    <td class="py-3.5 px-4 font-bold text-slate-700 dark:text-slate-300">04:00 PM</td>
                    <td class="py-3.5 px-4 text-purple-600 font-semibold">English (R-203)</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                    <td class="py-3.5 px-4 text-purple-600 font-semibold">English (R-203)</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                    <td class="py-3.5 px-4 text-purple-600 font-semibold">English (R-203)</td>
                    <td class="py-3.5 px-4 text-slate-400">-</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
