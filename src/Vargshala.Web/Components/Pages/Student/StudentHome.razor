{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white dark:bg-[#111c21] rounded-2xl max-w-md w-full p-6 border border-tealborder dark:border-slate-800 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-xl bg-orange-50 dark:bg-orange-950/50 text-orange-600 flex items-center justify-center font-bold text-sm">
                        📋
                    </span>
                    <div>
                        <h3 class="font-black text-base text-slate-800 dark:text-white">@_modalAssignmentSubject</h3>
                        <p class="text-xs text-rose-500 font-semibold">Due: @_modalAssignmentDueDate</p>
                    </div>
                </div>
                <button type="button" @onclick="() => _showAssignmentModal = false" class="text-slate-400 hover:text-slate-600 p-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 text-xs text-slate-600 dark:text-slate-300">
                <p class="font-bold text-slate-800 dark:text-white">Topic / Worksheet:</p>
                <p class="mt-1">@_modalAssignmentTitle</p>
                <p class="mt-2 text-[11px] text-slate-400">Complete exercises 1 to 25 and upload your PDF submission before the deadline.</p>
            </div>

            <div class="pt-3 flex items-center gap-3">
                <a href="student/tasks" class="flex-1 py-2 rounded-xl bg-[#009488] hover:bg-[#00796b] text-white text-xs font-bold text-center shadow-xs transition-all">
                    Upload Solution
                </a>
                <button type="button" @onclick="() => _showAssignmentModal = false" class="py-2 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@if (_showReceiptModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white dark:bg-[#111c21] rounded-2xl max-w-md w-full p-6 border border-tealborder dark:border-slate-800 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <img src="images/Logo.svg" alt="Vargshala" class="w-7 h-7 object-contain" />
                    <div>
                        <h3 class="font-black text-base text-slate-800 dark:text-white">Brillent Coaching Center</h3>
                        <p class="text-[10px] text-slate-500">Official Fee Payment Receipt</p>
                    </div>
                </div>
                <button type="button" @onclick="() => _showReceiptModal = false" class="text-slate-400 hover:text-slate-600 p-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-slate-500">Receipt No:</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-white">RCP-2026-9021</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Student Name:</span>
                    <span class="font-bold text-slate-800 dark:text-white">@_studentName</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Class & Course:</span>
                    <span class="font-semibold text-slate-700 dark:text-slate-300">Class 12 - PCM Science</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Payment Date:</span>
                    <span class="font-semibold text-slate-700 dark:text-slate-300">01 Sep 2026</span>
                </div>
                <div class="flex justify-between pt-2 border-t border-slate-200 dark:border-slate-700 font-bold">
                    <span class="text-slate-700 dark:text-slate-300">Total Amount Paid:</span>
                    <span class="text-emerald-600 text-sm">₹45,000</span>
                </div>
                <div class="flex justify-between text-[11px] text-emerald-600">
                    <span>Status:</span>
                    <span class="font-bold">PAID (Clear)</span>
                </div>
            </div>

            <div class="pt-2 flex items-center gap-3">
                <button type="button" @onclick="() => _showReceiptModal = false" class="flex-1 py-2 rounded-xl bg-[#009488] hover:bg-[#00796b] text-white text-xs font-bold text-center shadow-xs transition-all">
                    Download PDF
                </button>
                <button type="button" @onclick="() => _showReceiptModal = false" class="py-2 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string _studentName = "Aryan Kapoor";
    private DateTime _selectedDate = new DateTime(2026, 9, 11);
    private string _currentDateDisplay = "Thu, 11 Sep 2026";
    private string _attendancePeriod = "month";

    // Modal States
    private bool _showClassModal = false;
    private string _modalClassSubject = "";
    private string _modalClassTeacher = "";
    private string _modalClassRoom = "";
    private string _modalClassTime = "";
    private string _modalClassBatch = "";
    private bool _modalClassCanJoin = false;

    private bool _showAssignmentModal = false;
    private string _modalAssignmentSubject = "";
    private string _modalAssignmentTitle = "";
    private string _modalAssignmentDueDate = "";

    private bool _showReceiptModal = false;

    protected override async Task OnInitializedAsync()
    {
        UpdateDateDisplay();

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var name = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                           ?? authState.User.Identity?.Name;
                if (!string.IsNullOrWhiteSpace(name) && !name.Equals("student", StringComparison.OrdinalIgnoreCase))
                {
                    _studentName = name;
                }
            }
        }
    }

    private void PrevDay()
    {
        _selectedDate = _selectedDate.AddDays(-1);
        UpdateDateDisplay();
    }

    private void NextDay()
    {
        _selectedDate = _selectedDate.AddDays(1);
        UpdateDateDisplay();
    }

    private void UpdateDateDisplay()
    {
        _currentDateDisplay = _selectedDate.ToString("ddd, dd MMM yyyy");
    }

    private void OpenClassModal(string subject, string teacher, string room, string time, string batch, bool canJoin)
    {
        _modalClassSubject = subject;
        _modalClassTeacher = teacher;
        _modalClassRoom = room;
        _modalClassTime = time;
        _modalClassBatch = batch;
        _modalClassCanJoin = canJoin;
        _showClassModal = true;
    }

    private void OpenAssignmentModal(string subject, string title, string dueDate)
    {
        _modalAssignmentSubject = subject;
        _modalAssignmentTitle = title;
        _modalAssignmentDueDate = dueDate;
        _showAssignmentModal = true;
    }

    private void OpenReceiptModal()
    {
        _showReceiptModal = true;
    }

    private string GetDayColor(int day)
    {
        // 4 absent (red), 2 late (amber), 44 present (green)
        if (day is 12 or 21 or 22 or 28)
            return "bg-rose-500";
        if (day is 7 or 18)
            return "bg-amber-400";
        return "bg-emerald-500";
    }

    private string GetDayHeight(int day)
    {
        if (day is 12 or 28)
            return "60%";
        if (day is 21 or 22)
            return "70%";
        if (day is 7 or 18)
            return "80%";
        if (day % 3 == 0)
            return "92%";
        if (day % 2 == 0)
            return "85%";
        return "88%";
    }

    private string GetDayStatus(int day)
    {
        if (day is 12 or 21 or 22 or 28)
            return "Absent";
        if (day is 7 or 18)
            return "Late (Marked with reason)";
        return "Present (Full Attendance)";
    }
}
