@page "/student"
@page "/student/home"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer

<PageTitle>Student Portal | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                Welcome back, <AuthorizeView><Authorized>@(context.User.Identity?.Name ?? "Student")</Authorized></AuthorizeView> 👋
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Here's your learning overview, recent study material, upcoming tasks, and institute updates.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] dark:text-teal-300 border border-teal-200 dark:border-teal-800/80 shadow-2xs">
                🎓 Student Portal
            </span>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Attendance -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs hover:border-teal-500 transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Attendance</span>
                <span class="w-8 h-8 rounded-xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center text-sm font-bold">📅</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">92%</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-2 font-medium">Good Standing</span>
            </div>
        </div>

        <!-- Card 2: Pending Tasks -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs hover:border-teal-500 transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Active Tasks</span>
                <span class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-bold">📋</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">4</span>
                <span class="text-[11px] text-amber-600 dark:text-amber-400 ml-2 font-medium">Due this week</span>
            </div>
        </div>

        <!-- Card 3: Study Notes -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs hover:border-teal-500 transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Study Materials</span>
                <span class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-sm font-bold">📁</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-slate-800 dark:text-white">18</span>
                <span class="text-[11px] text-blue-600 dark:text-blue-400 ml-2 font-medium">Available</span>
            </div>
        </div>

        <!-- Card 4: Fee Status -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs hover:border-teal-500 transition-all">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Fee Status</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm font-bold">₹</span>
            </div>
            <div class="mt-3">
                <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">Paid</span>
                <span class="text-[11px] text-slate-400 ml-2 font-medium">Up to date</span>
            </div>
        </div>
    </div>

    <!-- Student Quick Navigation Grid -->
    <div class="p-6 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder dark:border-slate-800/80 shadow-xs">
        <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-4">Quick Shortcuts</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <a href="student/study-material" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1 group-hover:scale-110 transition-transform">📁</div>
                <div class="text-xs font-bold text-slate-700 dark:text-slate-200">Study Material</div>
            </a>
            <a href="student/tasks" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1 group-hover:scale-110 transition-transform">📋</div>
                <div class="text-xs font-bold text-slate-700 dark:text-slate-200">Tasks</div>
            </a>
            <a href="student/quizzes" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1 group-hover:scale-110 transition-transform">❓</div>
                <div class="text-xs font-bold text-slate-700 dark:text-slate-200">Quizzes</div>
            </a>
            <a href="student/progress" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-teal-50 dark:hover:bg-teal-950/40 border border-slate-100 dark:border-slate-700/60 transition-all text-center group">
                <div class="text-2xl mb-1 group-hover:scale-110 transition-transform">📈</div>
                <div class="text-xs font-bold text-slate-700 dark:text-slate-200">Progress</div>
            </a>
        </div>
    </div>
</div>
