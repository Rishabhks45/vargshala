@page "/student"
@page "/student/home"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IUserService UserService

<PageTitle>Student Dashboard | Vargshala</PageTitle>

<div class="h-full overflow-y-auto pr-1 no-scrollbar space-y-4 select-none pb-8">

    <!-- 1. Top Welcome Banner -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white dark:bg-[#111c21] rounded-2xl p-5 border border-tealborder/70 dark:border-slate-800/80 shadow-2xs">
        <!-- Left: Student Info & Greeting -->
        <div class="flex items-start gap-3.5 min-w-0">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/50 border border-teal-100 dark:border-teal-900/50 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
                <img src="images/Logo.svg" alt="Vargshala" class="w-7 h-7 object-contain" />
            </div>
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <h1 class="text-xl sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight truncate">
                        Welcome back, @(_studentName) 👋
                    </h1>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1 flex items-center flex-wrap gap-2">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">Class 12</span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span>Brillent Coaching Center</span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span>Main Branch</span>
                </p>
                <p class="text-xs italic text-slate-400 dark:text-slate-400 mt-1.5 font-normal">
                    “Small steps everyday lead to big results.”
                </p>
            </div>
        </div>

        <!-- Right: Motivational Card & Portal Badge -->
        <div class="flex items-center gap-3 self-start lg:self-center shrink-0">
            <!-- Motivational Pill Card -->
            <div class="relative overflow-hidden bg-[#eef8f3] dark:bg-[#0f2822] border border-emerald-100 dark:border-emerald-800/50 rounded-2xl px-4 py-2.5 flex items-center gap-3.5 shadow-2xs">
                <!-- Leaf graphic SVG -->
                <div class="w-8 h-8 shrink-0 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 22C12 22 11 18 11 14C11 9.58172 14.5817 6 19 6C19 10.4183 15.4183 14 11 14" opacity="0.85"/>
                        <path d="M12 22C12 22 13 17 13 12C13 7.58172 9.41828 4 5 4C5 8.41828 8.58172 12 13 12" opacity="0.95"/>
                        <path d="M12 22V13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <!-- Text lines -->
                <div class="flex flex-col leading-tight pr-1">
                    <span class="text-xs font-black text-slate-800 dark:text-white">Stay Focused</span>
                    <span class="text-xs font-black text-slate-800 dark:text-white">Keep Learning</span>
                    <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">You Can Do It!</span>
                </div>
                <!-- Subtle leaf watermark on background -->
                <div class="absolute -right-3 -bottom-3 pointer-events-none opacity-10">
                    <svg class="w-16 h-16 text-emerald-700" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 22C12 22 11 18 11 14C11 9.58172 14.5817 6 19 6C19 10.4183 15.4183 14 11 14"/>
                    </svg>
                </div>
            </div>

            <!-- Student Portal Pill -->
            <div class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#111c21] text-[#00796b] dark:text-teal-300 border border-teal-200 dark:border-teal-700/80 shadow-2xs">
                <span>🎓</span>
                <span>Student Portal</span>
            </div>
        </div>
    </div>

    <!-- 2. Row of 4 Hero Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: My Batches -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                    </svg>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">My Batches</span>
                    <div class="text-3xl font-black text-slate-800 dark:text-white leading-tight mt-0.5">3</div>
                </div>
            </div>
            <a href="student/batches" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:text-blue-700 mt-4 flex items-center gap-1">
                <span>View Details</span>
                <span>→</span>
            </a>
        </div>

        <!-- Card 2: Attendance -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-teal-50 dark:bg-teal-950/50 text-[#009488] dark:text-teal-400 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h12a1 1 0 100-2H6z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Attendance</span>
                    <div class="text-3xl font-black text-slate-800 dark:text-white leading-tight mt-0.5">92%</div>
                </div>
            </div>
            <a href="student/attendance" class="text-xs font-bold text-[#009488] dark:text-teal-400 hover:text-teal-700 mt-4 flex items-center gap-1">
                <span>View Report</span>
                <span>→</span>
            </a>
        </div>

        <!-- Card 3: Assignments -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-orange-50 dark:bg-orange-950/50 text-orange-500 dark:text-orange-400 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                    </svg>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Assignments</span>
                    <div class="text-3xl font-black text-slate-800 dark:text-white leading-tight mt-0.5">4</div>
                </div>
            </div>
            <a href="student/tasks" class="text-xs font-bold text-orange-600 dark:text-orange-400 hover:text-orange-700 mt-4 flex items-center gap-1">
                <span>View Assignments</span>
                <span>→</span>
            </a>
        </div>

        <!-- Card 4: Fee Due -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-tealborder/70 dark:border-slate-800/80 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    </svg>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Fee Due</span>
                    <div class="flex items-baseline gap-1.5 mt-0.5">
                        <span class="text-3xl font-black text-emerald-600 dark:text-emerald-400">Paid</span>
                        <span class="text-[11px] font-medium text-slate-400">Up to date</span>
                    </div>
                </div>
            </div>
            <a href="student/fees" class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:text-purple-700 mt-4 flex items-center gap-1">
                <span>View Fee Details</span>
                <span>→</span>
            </a>
        </div>
    </div>

    <!-- 3. Middle Section (3-Column Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        
        <!-- Col 1 (Today's Classes, 4 cols) -->
        <div class="lg:col-span-4 bg-white dark:bg-[#111c21] rounded-2xl p-5 border border-tealborder/70 dark:border-slate-800/80 shadow-2xs flex flex-col justify-between">
            <div>
                <!-- Header -->
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-slate-800 dark:text-white font-extrabold text-sm">
                        <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span>Today's Classes</span>
                    </div>
                    <div class="flex items-center gap-1 text-slate-500 dark:text-slate-400 text-xs font-semibold">
                        <span class="text-[11px]">@_currentDateDisplay</span>
                        <button type="button" @onclick="PrevDay" class="p-1 hover:text-slate-700 dark:hover:text-white transition-colors" title="Previous Day">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button type="button" @onclick="NextDay" class="p-1 hover:text-slate-700 dark:hover:text-white transition-colors" title="Next Day">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Classes Timeline List -->
                <div class="divide-y divide-slate-100 dark:divide-slate-800/60 mt-1">
                    <!-- Class 1: Mathematics -->
                    <div class="py-3 flex items-center justify-between gap-3">
                        <div class="flex items-start gap-3 min-w-0">
                            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 w-16 shrink-0 pt-0.5">07:00 AM</span>
                            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-emerald-100 dark:ring-emerald-950/60 shrink-0 mt-1.5"></div>
                            <div class="min-w-0">
                                <h4 class="font-extrabold text-xs text-slate-800 dark:text-white leading-tight truncate">Mathematics</h4>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">Class 12 • Morning Batch</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate">Amit Sir • Room 101</p>
                            </div>
                        </div>
                        <button type="button" @onclick='() => OpenClassModal("Mathematics", "Amit Sir", "Room 101", "07:00 AM - 08:30 AM", "Morning Batch", true)'
                                class="px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-[#00796b] font-bold text-[11px] border border-teal-200 transition-colors shrink-0">
                            Join Class
                        </button>
                    </div>

                    <!-- Class 2: Physics -->
                    <div class="py-3 flex items-center justify-between gap-3">
                        <div class="flex items-start gap-3 min-w-0">
                            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 w-16 shrink-0 pt-0.5">10:00 AM</span>
                            <div class="w-2.5 h-2.5 rounded-full bg-amber-500 ring-4 ring-amber-100 dark:ring-amber-950/60 shrink-0 mt-1.5"></div>
                            <div class="min-w-0">
                                <h4 class="font-extrabold text-xs text-slate-800 dark:text-white leading-tight truncate">Physics</h4>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">Class 12 • Morning Batch</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate">Rahul Sir • Room 102</p>
                            </div>
                        </div>
                        <button type="button" @onclick='() => OpenClassModal("Physics", "Rahul Sir", "Room 102", "10:00 AM - 11:30 AM", "Morning Batch", false)'
                                class="px-3 py-1.5 rounded-lg bg-teal-50/50 hover:bg-teal-100 text-[#00796b] font-bold text-[11px] border border-teal-200 transition-colors shrink-0">
                            View Class
                        </button>
                    </div>

                    <!-- Class 3: Chemistry -->
                    <div class="py-3 flex items-center justify-between gap-3">
                        <div class="flex items-start gap-3 min-w-0">
                            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 w-16 shrink-0 pt-0.5">01:00 PM</span>
                            <div class="w-2.5 h-2.5 rounded-full bg-blue-500 ring-4 ring-blue-100 dark:ring-blue-950/60 shrink-0 mt-1.5"></div>
                            <div class="min-w-0">
                                <h4 class="font-extrabold text-xs text-slate-800 dark:text-white leading-tight truncate">Chemistry</h4>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">Class 12 • Afternoon Batch</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate">Neha Ma'am • Room 201</p>
                            </div>
                        </div>
                        <button type="button" @onclick='() => OpenClassModal("Chemistry", "Neha Ma\x27am", "Room 201", "01:00 PM - 02:30 PM", "Afternoon Batch", false)'
                                class="px-3 py-1.5 rounded-lg bg-teal-50/50 hover:bg-teal-100 text-[#00796b] font-bold text-[11px] border border-teal-200 transition-colors shrink-0">
                            View Class
                        </button>
                    </div>

                    <!-- Class 4: English -->
                    <div class="py-3 flex items-center justify-between gap-3">
                        <div class="flex items-start gap-3 min-w-0">
                            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 w-16 shrink-0 pt-0.5">04:00 PM</span>
                            <div class="w-2.5 h-2.5 rounded-full bg-purple-500 ring-4 ring-purple-100 dark:ring-purple-950/60 shrink-0 mt-1.5"></div>
                            <div class="min-w-0">
                                <h4 class="font-extrabold text-xs text-slate-800 dark:text-white leading-tight truncate">English</h4>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">Class 12 • Evening Batch</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-500 truncate">Suman Sir • Room 203</p>
                            </div>
                        </div>
                        <button type="button" @onclick='() => OpenClassModal("English", "Suman Sir", "Room 203", "04:00 PM - 05:30 PM", "Evening Batch", false)'
                                class="px-3 py-1.5 rounded-lg bg-teal-50/50 hover:bg-teal-100 text-[#00796b] font-bold text-[11px] border border-teal-200 transition-colors shrink-0">
                            View Class
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Col 2 (Attendance Overview, 5 cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-[#111c21] rounded-2xl p-5 border border-tealborder/70 dark:border-slate-800/80 shadow-2xs flex flex-col justify-between">
            <div>
                <!-- Header -->
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-slate-800 dark:text-white font-extrabold text-sm">
                        <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        <span>Attendance Overview</span>
                    </div>
                    <div class="relative">
                        <select @bind="_attendancePeriod" class="text-[11px] font-semibold bg-transparent text-slate-600 dark:text-slate-300 border-none outline-none cursor-pointer pr-1">
                            <option value="month">This Month</option>
                            <option value="last">Last Month</option>
                            <option value="year">All Time</option>
                        </select>
                    </div>
                </div>

                <!-- Donut Chart & Legend Row -->
                <div class="flex items-center justify-between gap-4 my-3 px-2">
                    <!-- Circular Donut SVG -->
                    <div class="relative w-28 h-28 shrink-0 flex items-center justify-center">
                        <svg class="w-28 h-28 transform -rotate-90" viewBox="0 0 100 100">
                            <!-- Background Track -->
                            <circle cx="50" cy="50" r="40" fill="transparent" stroke="currentColor" stroke-width="11" class="text-slate-100 dark:text-slate-800" />
                            <!-- 92% Circumference Progress Arc (2 * pi * 40 = 251.32; 251.32 * 0.08 = 20.1 offset) -->
                            <circle cx="50" cy="50" r="40" fill="transparent" stroke="#10b981" stroke-width="11" stroke-linecap="round"
                                    stroke-dasharray="251.32" stroke-dashoffset="20.1" class="transition-all duration-700 ease-out" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                            <span class="text-2xl font-black text-slate-800 dark:text-white leading-none">92%</span>
                            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 mt-1">Overall</span>
                        </div>
                    </div>

                    <!-- Legend Items -->
                    <div class="space-y-1.5 text-xs flex-1 max-w-[170px]">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
                                <span class="text-slate-600 dark:text-slate-300 font-medium text-[11px]">Present</span>
                            </div>
                            <span class="font-extrabold text-slate-800 dark:text-white text-xs">46</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#ef4444]"></span>
                                <span class="text-slate-600 dark:text-slate-300 font-medium text-[11px]">Absent</span>
                            </div>
                            <span class="font-extrabold text-slate-800 dark:text-white text-xs">4</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#f59e0b]"></span>
                                <span class="text-slate-600 dark:text-slate-300 font-medium text-[11px]">Late</span>
                            </div>
                            <span class="font-extrabold text-slate-800 dark:text-white text-xs">2</span>
                        </div>
                        <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                <span class="text-slate-500 dark:text-slate-400 font-medium text-[11px]">Total Classes</span>
                            </div>
                            <span class="font-extrabold text-slate-800 dark:text-white text-xs">50</span>
                        </div>
                    </div>
                </div>

                <!-- Daily Attendance Bar Chart (30 Days of September) -->
                <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                    <div class="flex items-end gap-1.5 h-16 w-full px-1">
                        <!-- Y-axis scale -->
                        <div class="flex flex-col justify-between h-full text-[9px] text-slate-400 font-mono pr-1 select-none">
                            <span>100</span>
                            <span>50</span>
                            <span>0</span>
                        </div>
                        <!-- Daily 30 Vertical Bars -->
                        <div class="flex-1 flex items-end justify-between h-full gap-[3px]">
                            @for (int day = 1; day <= 30; day++)
                            {
                                var currentDay = day;
                                var barColor = GetDayColor(currentDay);
                                var barHeight = GetDayHeight(currentDay);
                                <div class="flex-1 flex flex-col justify-end h-full group relative cursor-pointer" title="@($"Sep {currentDay}: {GetDayStatus(currentDay)}")">
                                    <div class="w-full bg-slate-100 dark:bg-slate-800/80 rounded-full h-full flex items-end">
                                        <div class="w-full @barColor rounded-full transition-all duration-300 group-hover:brightness-110" style="height: @barHeight;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- X-Axis Labels -->
                    <div class="flex justify-between pl-6 text-[9px] text-slate-400 font-medium mt-1 select-none">
                        <span>1 Sep</span>
                        <span>5 Sep</span>
                        <span>10 Sep</span>
                        <span>15 Sep</span>
                        <span>20 Sep</span>
                        <span>25 Sep</span>
                        <span>30 Sep</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Col 3 (Fee Summary, 3 cols) -->
