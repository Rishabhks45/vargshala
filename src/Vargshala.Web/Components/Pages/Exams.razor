    private bool _showAddedAlert = false;

    private async Task AddDraftQuestionToList()
    {
        // If text is blank, auto-assign default title so button never fails silently
        var text = string.IsNullOrWhiteSpace(_newQuestionDraft.QuestionText)
            ? $"Question #{_newQuizQuestions.Count + 1}"
            : _newQuestionDraft.QuestionText.Trim();

        var category = !string.IsNullOrWhiteSpace(_newQuestionDraft.Category)
