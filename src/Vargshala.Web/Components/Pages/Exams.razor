    private async Task OpenEditDrawerAsync(ExamItem exam)
    {
        // Completed quizzes are locked and cannot be edited
        if (exam.Status == "Completed") return;

        _editingExam = exam;
        _newQuizTitle = exam.Title;
        _newQuizBatch = exam.BatchName;
        _newQuizDuration = exam.Duration;
        _newQuizDate = DateTime.TryParse(exam.ScheduledDate, out var dt) ? dt : DateTime.Today.AddDays(3);
        _activeCategoryTab = "All";
        _renamingCategory = null;

        _availableCategories = new List<string>(exam.Categories.Any() ? exam.Categories : new() { "Physics", "Mathematics" });
        
        _newQuestionDraft = new QuizQuestionModel(_availableCategories.FirstOrDefault() ?? "Physics", "", "Option A", "Option B", "Option C", "Option D", "A", 4, 1, "Easy") { IsCollapsed = false };

        // Load copy of questions with collapsed state
        _newQuizQuestions = exam.Questions != null && exam.Questions.Any()
            ? exam.Questions.Select(q => new QuizQuestionModel(
                q.Category, q.QuestionText, q.OptionA, q.OptionB, q.OptionC, q.OptionD, 
                q.CorrectOption, q.Marks, Math.Max(1, q.TimeLimitMinutes), q.Difficulty,
                q.QuestionImageUrl, q.OptionAImageUrl, q.OptionBImageUrl, q.OptionCImageUrl, q.OptionDImageUrl
            ) { IsCollapsed = true }).ToList()
            : new List<QuizQuestionModel>();

        _showCreateDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
