        // Min 1 min, expend if hard
        q.TimeLimitMinutes = difficulty switch
        {
            "Easy" => 1,
            "Medium" => 2,
            "Hard" => 4,
            _ => 1
        };
    }

    private void SyncDurationWithQuestions()
    {
        var totalQuestionMinutes = _newQuizQuestions.Sum(q => Math.Max(1, q.TimeLimitMinutes));
        if (totalQuestionMinutes > 0)
        {
            _newQuizDuration = totalQuestionMinutes;
        }
