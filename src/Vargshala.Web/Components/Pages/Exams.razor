            text,
            string.IsNullOrWhiteSpace(_newQuestionDraft.OptionA) ? "Option A" : _newQuestionDraft.OptionA,
            string.IsNullOrWhiteSpace(_newQuestionDraft.OptionB) ? "Option B" : _newQuestionDraft.OptionB,
            string.IsNullOrWhiteSpace(_newQuestionDraft.OptionC) ? "Option C" : _newQuestionDraft.OptionC,
            string.IsNullOrWhiteSpace(_newQuestionDraft.OptionD) ? "Option D" : _newQuestionDraft.OptionD,
            _newQuestionDraft.CorrectOption,
            _newQuestionDraft.Marks > 0 ? _newQuestionDraft.Marks : 4,
            Math.Max(1, _newQuestionDraft.TimeLimitMinutes),
            _newQuestionDraft.Difficulty,
            _newQuestionDraft.QuestionImageUrl,
            _newQuestionDraft.OptionAImageUrl,
            _newQuestionDraft.OptionBImageUrl,
            _newQuestionDraft.OptionCImageUrl,
            _newQuestionDraft.OptionDImageUrl
        )
        {
            IsCollapsed = true // Har question complete hone pe collapse ho jaye!
        };

        // Question create hone pe niche chala jaye!
        _newQuizQuestions.Add(created);

        // Make sure active category tab shows the new question
        if (_activeCategoryTab != "All" && _activeCategoryTab != category)
        {
            _activeCategoryTab = category;
        }

        // Top composer stays at top and resets for next question
        _newQuestionDraft = new QuizQuestionModel(
            category,
            "",
            "Option A",
            "Option B",
            "Option C",
            "Option D",
            "A",
            4,
            1,
            "Easy"
        )
        {
            IsCollapsed = false
        };

        _showAddedAlert = true;
        StateHasChanged();

        _ = Task.Delay(2500).ContinueWith(_ =>
        {
            _showAddedAlert = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void CollapseAllQuestions()
    {
        foreach (var q in _newQuizQuestions) q.IsCollapsed = true;
    }

    private void ExpandAllQuestions()
    {
        foreach (var q in _newQuizQuestions) q.IsCollapsed = false;
    }

    private void AddNewQuestion()
    {
        var targetCategory = _activeCategoryTab == "All" ? _availableCategories.FirstOrDefault() ?? "Physics" : _activeCategoryTab;
        _newQuizQuestions.Add(new(
            targetCategory,
            "",
            "Option A",
            "Option B",
            "Option C",
            "Option D",
            "A",
            4,
            1, // min 1 min
            "Easy"
        ) { IsCollapsed = false });
    }

    private void RemoveQuestion(QuizQuestionModel q)
    {
        _newQuizQuestions.Remove(q);
    }

    private async Task SaveAndPublishQuiz()
    {
        if (string.IsNullOrWhiteSpace(_newQuizTitle)) return;

        // Ensure minimum 1 min time for all questions
        foreach (var q in _newQuizQuestions)
        {
            if (q.TimeLimitMinutes < 1) q.TimeLimitMinutes = 1;
        }

        var distinctCategories = _newQuizQuestions.Select(q => q.Category).Distinct().ToList();
        if (!distinctCategories.Any()) distinctCategories.Add("General");

        var questionsCopy = new List<QuizQuestionModel>(_newQuizQuestions);

        if (_editingExam != null)
        {
            // Update existing upcoming exam
            var index = _exams.FindIndex(e => e.Title == _editingExam.Title);
            if (index != -1)
            {
                _exams[index] = new ExamItem(
                    _newQuizTitle,
                    _newQuizBatch,
                    _editingExam.Status, // keep Upcoming
                    _newQuizDate.ToString("dd MMM yyyy"),
                    _newQuizQuestions.Count,
                    _newQuizDuration,
                    _newQuizQuestions.Sum(q => q.Marks),
                    _editingExam.AvgScore,
                    distinctCategories,
                    questionsCopy
                );
            }
        }
        else
        {
            // Create new exam
            var newExam = new ExamItem(
                _newQuizTitle,
                _newQuizBatch,
                "Upcoming",
                _newQuizDate.ToString("dd MMM yyyy"),
                _newQuizQuestions.Count,
                _newQuizDuration,
                _newQuizQuestions.Sum(q => q.Marks),
                0,
                distinctCategories,
                questionsCopy
            );
            _exams.Insert(0, newExam);
        }

        await CloseCreateDrawerAsync();
    }

    private void PreviewExam(ExamItem exam)
    {
        _previewExam = exam;
    }

    private async Task HandleQuestionImageUpload(InputFileChangeEventArgs e, QuizQuestionModel q)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var format = file.ContentType;
                if (string.IsNullOrWhiteSpace(format)) format = "image/png";
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                q.QuestionImageUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            catch { }
        }
    }

    private async Task HandleOptionImageUpload(InputFileChangeEventArgs e, QuizQuestionModel q, string opt)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var format = file.ContentType;
                if (string.IsNullOrWhiteSpace(format)) format = "image/png";
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var dataUrl = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
                switch (opt)
                {
                    case "A": q.OptionAImageUrl = dataUrl; break;
                    case "B": q.OptionBImageUrl = dataUrl; break;
                    case "C": q.OptionCImageUrl = dataUrl; break;
                    case "D": q.OptionDImageUrl = dataUrl; break;
                }
            }
            catch { }
        }
    }

    public class QuizQuestionModel
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Category { get; set; } = "Physics";
        public string QuestionText { get; set; } = string.Empty;
        public string? QuestionImageUrl { get; set; }
        public bool ShowQuestionImageInput { get; set; } = false;
        public string QuestionImageMode { get; set; } = "upload"; // "upload" or "link"

        public string OptionA { get; set; } = string.Empty;
        public string? OptionAImageUrl { get; set; }
        public bool ShowOptionAImage { get; set; } = false;
        public string OptionAImageMode { get; set; } = "upload";

        public string OptionB { get; set; } = string.Empty;
        public string? OptionBImageUrl { get; set; }
        public bool ShowOptionBImage { get; set; } = false;
        public string OptionBImageMode { get; set; } = "upload";

        public string OptionC { get; set; } = string.Empty;
        public string? OptionCImageUrl { get; set; }
        public bool ShowOptionCImage { get; set; } = false;
        public string OptionCImageMode { get; set; } = "upload";

        public string OptionD { get; set; } = string.Empty;
        public string? OptionDImageUrl { get; set; }
        public bool ShowOptionDImage { get; set; } = false;
        public string OptionDImageMode { get; set; } = "upload";

        public string CorrectOption { get; set; } = "A";
        public int Marks { get; set; } = 4;
        public bool IsCollapsed { get; set; } = true; // Auto-collapse when completed
        
        // Question Timing: Minimum 1 minute, expandable if hard
        public int TimeLimitMinutes { get; set; } = 1;
        public string Difficulty { get; set; } = "Easy"; // Easy (1m), Medium (2m), Hard (4m)

        public QuizQuestionModel(
            string category, 
            string text, 
            string a, 
            string b, 
            string c, 
            string d, 
            string correct, 
            int marks,
            int timeMinutes = 1,
            string difficulty = "Easy",
            string? qImg = null,
            string? optAImg = null,
            string? optBImg = null,
            string? optCImg = null,
            string? optDImg = null)
        {
            Category = category;
            QuestionText = text;
            OptionA = a;
            OptionB = b;
            OptionC = c;
            OptionD = d;
            CorrectOption = correct;
            Marks = marks;
            TimeLimitMinutes = Math.Max(1, timeMinutes);
            Difficulty = difficulty;
            QuestionImageUrl = qImg;
            OptionAImageUrl = optAImg;
            OptionBImageUrl = optBImg;
            OptionCImageUrl = optCImg;
            OptionDImageUrl = optDImg;
        }
    }

    public record ExamItem(
        string Title, 
        string BatchName, 
        string Status, 
        string ScheduledDate, 
        int TotalQuestions, 
        int Duration, 
        int MaxMarks, 
        int AvgScore, 
        List<string> Categories,
        List<QuizQuestionModel>? Questions = null
    );
}
