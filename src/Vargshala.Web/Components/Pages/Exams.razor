    private void AddCustomCategory()
    {
        if (!string.IsNullOrWhiteSpace(_customCategoryInput) && !_availableCategories.Contains(_customCategoryInput.Trim(), StringComparer.OrdinalIgnoreCase))
        {
            var trimmed = _customCategoryInput.Trim();
            _availableCategories.Add(trimmed);
            _activeCategoryTab = trimmed;
            _customCategoryInput = string.Empty;
        }
    }

    private void StartRenameCategory(string categoryName)
    {
        _renamingCategory = categoryName;
        _renameCategoryValue = categoryName;
    }

    private void ConfirmRenameCategory(string oldName)
    {
        if (!string.IsNullOrWhiteSpace(_renameCategoryValue) && _renameCategoryValue.Trim() != oldName)
        {
            var newName = _renameCategoryValue.Trim();
            var index = _availableCategories.IndexOf(oldName);
            if (index != -1)
            {
                _availableCategories[index] = newName;
            }

            // Update all questions that were under this category
            foreach (var q in _newQuizQuestions.Where(q => q.Category == oldName))
            {
                q.Category = newName;
            }

            if (_activeCategoryTab == oldName)
            {
                _activeCategoryTab = newName;
            }
        }
        _renamingCategory = null;
    }

    private void DeleteCategory(string categoryName)
    {
        if (_availableCategories.Count <= 1) return;

        _availableCategories.Remove(categoryName);
        var fallbackCategory = _availableCategories.FirstOrDefault() ?? "General";

        // Reassign existing questions in this category to fallback
        foreach (var q in _newQuizQuestions.Where(q => q.Category == categoryName))
        {
            q.Category = fallbackCategory;
        }

        if (_activeCategoryTab == categoryName)
        {
            _activeCategoryTab = "All";
        }
    }

