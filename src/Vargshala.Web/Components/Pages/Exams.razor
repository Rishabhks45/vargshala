@page "/exams"
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Badges
@inject IWebHostEnvironment WebHostEnvironment
@rendermode InteractiveServer

<PageTitle>Exam & Quizzes | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Exam & Quizzes</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Create, schedule, and manage multi-section quizzes with category time allocation and diagram/image support.
            </p>
        </div>
        <button type="button" @onclick="OpenCreateDrawerAsync"
                class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
            <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </span>
            <span>Create Quiz</span>
        </button>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Quizzes</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_exams.Count</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Upcoming (Editable)</p>
                <h3 class="text-lg font-extrabold text-blue-600 dark:text-blue-400">@_exams.Count(e => e.Status == "Upcoming")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Completed (Locked)</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_exams.Count(e => e.Status == "Completed")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Avg Performance</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">76%</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <!-- Search Input with Search Button on Left -->
        <div class="flex items-center gap-2 flex-1 w-full max-w-md">
            <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Search quiz by title, batch, or subject..."
                       class="w-full pl-9 pr-8 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button" @onclick="() => _searchQuery = string.Empty" class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                }
            </div>
            <button type="button" 
                    class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer shrink-0 shadow-xs flex items-center gap-1.5 active:scale-95">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span>Search</span>
            </button>
        </div>

        <!-- Both Dropdowns on the Right -->
        <div class="flex items-center gap-2.5 sm:justify-end">
            <CustomSelect @bind-Value="_filterStatus" Options="_statusOptions" Placeholder="All Status" />
            <CustomSelect @bind-Value="_filterBatch" Options="_batchOptions" Placeholder="All Batches" />
        </div>
    </div>

    <!-- Exam Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var exam in FilteredExams)
        {
            <div class="card-surface p-5 space-y-3.5 hover:shadow-md transition-all duration-200 border border-tealborder flex flex-col justify-between">
                <div>
                    <!-- Header: Title + Status -->
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white truncate cursor-pointer hover:text-[#009488]"
                                @onclick="() => PreviewExam(exam)">
                                @exam.Title
                            </h3>
                            <p class="text-[10px] text-slate-400 dark:text-slate-500 font-medium mt-0.5">@exam.BatchName</p>
                        </div>
                        @if (exam.Status == "Upcoming")
                        { <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800 shrink-0">Upcoming</span> }
                        else if (exam.Status == "Live")
                        { <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 animate-pulse shrink-0">● Live</span> }
                        else
                        { <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 shrink-0">Completed</span> }
                    </div>

                    <!-- Category / Section Badges -->
                    <div class="flex flex-wrap gap-1 mt-2.5">
                        @foreach (var cat in exam.Categories)
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[9px] font-bold bg-teal-50 dark:bg-teal-950/80 text-[#00796b] dark:text-teal-300 border border-teal-200/60 dark:border-teal-900">
                                @cat
                            </span>
                        }
                    </div>
                </div>

                <div class="space-y-3">
                    <!-- Metrics -->
                    <div class="grid grid-cols-3 gap-2 p-3 bg-slate-50/80 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800 text-center text-xs">
                        <div>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Questions</p>
                            <p class="font-extrabold text-slate-800 dark:text-white">@exam.TotalQuestions</p>
                        </div>
                        <div class="border-x border-slate-200/80 dark:border-slate-700">
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Duration</p>
                            <p class="font-extrabold text-slate-800 dark:text-white">@exam.Duration min</p>
                        </div>
                        <div>
                            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Max Marks</p>
                            <p class="font-extrabold text-slate-800 dark:text-white">@exam.MaxMarks</p>
                        </div>
                    </div>

                    <!-- Date & Actions: Upcoming is Editable, Completed is Locked -->
                    <div class="flex items-center justify-between text-[11px] pt-2 border-t border-slate-100 dark:border-slate-800">
                        <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span class="font-medium">@exam.ScheduledDate</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => PreviewExam(exam)"
                                    class="text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-[#009488] transition-colors cursor-pointer">
                                View
                            </button>
                            @if (exam.Status == "Upcoming")
                            {
                                <!-- Upcoming quiz is editable -->
                                <button type="button" @onclick="() => OpenEditDrawerAsync(exam)"
                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-teal-50 dark:bg-teal-950/80 text-[#00796b] dark:text-teal-300 font-bold text-xs border border-teal-200 dark:border-teal-800 hover:bg-teal-100 dark:hover:bg-teal-900/50 transition-colors cursor-pointer"
                                        title="Edit this upcoming quiz">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    <span>Edit</span>
                                </button>
                            }
                            else
                            {
                                <!-- Completed quiz is locked (not editable) -->
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-400 text-[10px] font-semibold select-none"
                                      title="Completed exam cannot be modified">
                                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                    <span>Locked</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<!-- ========================================================================= -->
<!-- SIDEBAR DRAWER: CREATE / EDIT QUIZ WITH EDITABLE SECTIONS & QUESTION TIMINGS & IMAGES -->
<!-- ========================================================================= -->
@if (_showCreateDrawer)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseCreateDrawerAsync"></div>

    <!-- Right Slide-Over Drawer -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-2xl bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/plant-books.png" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingExam == null ? "Create Multi-Section Quiz" : $"Edit Quiz: {_editingExam.Title}")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Configure sections, question timings (min 1 min), and diagram images for questions & options.
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseCreateDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Scrollable Drawer Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-5 no-scrollbar select-text text-slate-800 dark:text-slate-100">
            
            <!-- Section 1: Basic Quiz Metadata -->
            <div class="space-y-3 p-4 bg-slate-50 dark:bg-[#18262c] rounded-2xl border border-slate-200/80 dark:border-slate-800">
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">1. Quiz General Setup</span>
                    <span class="text-[10px] text-slate-400 font-semibold">
                        @_newQuizQuestions.Count Questions • @_newQuizQuestions.Sum(q => q.Marks) Marks • Time: @_newQuizQuestions.Sum(q => q.TimeLimitMinutes) min
                    </span>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Quiz Title *</label>
                    <input type="text" @bind="_newQuizTitle" placeholder="e.g. Combined Science & Math Mock Test 01"
                           class="w-full px-3.5 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-bold transition-all" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Target Batch *</label>
                        <CustomSelect @bind-Value="_newQuizBatch" Options="_batchOptions.Where(o => !string.IsNullOrEmpty(o.Value)).ToList()" Placeholder="Select Batch" Class="w-full" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 flex items-center justify-between">
                            <span>Duration (min)</span>
                            <button type="button" @onclick="SyncDurationWithQuestions" class="text-[9px] text-[#009488] hover:underline font-bold" title="Auto-calculate from question times">
                                Auto-Sum
                            </button>
                        </label>
                        <input type="number" @bind="_newQuizDuration" min="1"
                               class="w-full px-3.5 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none font-bold text-slate-800 dark:text-white" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Schedule Date</label>
                        <input type="date" @bind="_newQuizDate"
                               class="w-full px-3.5 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:outline-none font-semibold text-slate-800 dark:text-white" />
                    </div>
                </div>
            </div>

            <!-- Section 2: EDITABLE Subject Categories / Sections -->
            <div class="space-y-3 p-4 bg-slate-50 dark:bg-[#18262c] rounded-2xl border border-slate-200/80 dark:border-slate-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <span class="text-[11px] font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                            2. Subject Categories / Sections (Editable)
                        </span>
                        <p class="text-[10px] text-slate-400">Click a category pill to filter, or click the pencil icon to rename it.</p>
                    </div>
                    <!-- Add new section input -->
                    <div class="flex items-center gap-1.5">
                        <input type="text" @bind="_customCategoryInput" placeholder="New category..." 
                               class="px-2.5 py-1 text-[11px] bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-lg focus:border-[#009488] focus:outline-none w-28" />
                        <button type="button" @onclick="AddCustomCategory" 
                                class="px-2.5 py-1 bg-teal-50 dark:bg-teal-950/70 border border-teal-300 dark:border-teal-800 text-[#00796b] dark:text-teal-300 rounded-lg text-[10px] font-bold hover:bg-teal-100 transition-colors cursor-pointer">
                            + Add
                        </button>
                    </div>
                </div>

                <!-- Category Pills Bar with Rename & Delete Actions -->
                <div class="flex flex-wrap items-center gap-2 pt-1">
                    <button type="button" @onclick='() => _activeCategoryTab = "All"'
                            class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeCategoryTab == "All" ? "bg-[#004D40] text-white shadow-xs" : "bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:bg-slate-100")">
                        All Sections (@_newQuizQuestions.Count)
                    </button>

                    @foreach (var cat in _availableCategories)
                    {
                        var catName = cat;
                        var count = _newQuizQuestions.Count(q => q.Category == catName);
                        var isEditing = _renamingCategory == catName;

                        if (isEditing)
                        {
                            <!-- Inline Rename Input -->
                            <div class="inline-flex items-center gap-1 px-2 py-1 rounded-xl bg-teal-50 dark:bg-teal-950 border border-[#009488]">
                                <input type="text" @bind="_renameCategoryValue" 
                                       class="text-xs font-bold bg-white dark:bg-[#111c21] border border-teal-400 rounded px-1.5 py-0.5 w-24 text-slate-900 dark:text-white focus:outline-none" />
                                <button type="button" @onclick="() => ConfirmRenameCategory(catName)" class="text-emerald-600 hover:text-emerald-700 p-0.5" title="Save">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                </button>
                                <button type="button" @onclick="() => _renamingCategory = null" class="text-slate-400 hover:text-slate-600 p-0.5" title="Cancel">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-bold transition-all @(_activeCategoryTab == catName ? "bg-[#009488] text-white shadow-xs" : "bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100")">
                                <span class="cursor-pointer" @onclick="() => _activeCategoryTab = catName">@catName</span>
                                <span class="px-1.5 py-0.2 rounded-full text-[9px] @(_activeCategoryTab == catName ? "bg-white/20 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400")">
                                    @count
                                </span>
                                <!-- Rename Category Pen Icon -->
                                <button type="button" @onclick="() => StartRenameCategory(catName)" 
                                        class="p-0.5 text-slate-400 hover:text-white transition-colors cursor-pointer" title="Rename this section">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </button>
                                <!-- Delete Category Icon (if more than 1 category) -->
                                @if (_availableCategories.Count > 1)
                                {
                                    <button type="button" @onclick="() => DeleteCategory(catName)" 
                                            class="p-0.5 text-slate-400 hover:text-rose-300 transition-colors cursor-pointer" title="Delete section">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Section 3: QUESTION CREATOR (STAYS AT TOP) -->
