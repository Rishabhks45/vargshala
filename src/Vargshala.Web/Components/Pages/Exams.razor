                                        else
                                        {
                                            <input type="text" @bind="_newQuestionDraft.OptionDImageUrl" placeholder="https://..." class="w-full text-[10px] px-2 py-0.5 bg-slate-50 border rounded focus:outline-none" />
                                        }
                                        @if (!string.IsNullOrEmpty(_newQuestionDraft.OptionDImageUrl)) { <img src="@_newQuestionDraft.OptionDImageUrl" alt="Opt D" class="h-8 object-contain rounded border" /> }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Add Question Button: Pushes created question below & auto-collapses it -->
                    <div class="flex items-center justify-between pt-2 border-t border-teal-200/40 dark:border-slate-800">
                        <div class="text-[10px] text-slate-500 dark:text-slate-400">
                            @if (_showAddedAlert)
                            {
                                <span class="text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    <span>Question added to list below!</span>
                                </span>
                            }
                            else
                            {
                                <span>Pushes this question to list below & clears form for next</span>
                            }
                        </div>
                        <button type="button" @onclick="AddDraftQuestionToList"
                                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer active:scale-95">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            <span>Add Question to Quiz (Pushes Below)</span>
                        </button>
                    </div>

                </div>

                <!-- Section 4: ADDED QUESTIONS LIST (AUTO-COLLAPSED BELOW) -->
                <div class="space-y-3 pt-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                                Added Questions (@CurrentSectionQuestions.Count)
                            </span>
                            @if (_activeCategoryTab != "All")
                            {
                                <span class="text-[10px] text-teal-600 font-semibold">in @_activeCategoryTab</span>
                            }
                        </div>
                        
                        @if (CurrentSectionQuestions.Any())
                        {
                            <div class="flex items-center gap-2 text-[10px] font-bold">
                                <button type="button" @onclick="CollapseAllQuestions" class="text-slate-500 hover:text-[#009488] cursor-pointer">
                                    Collapse All
                                </button>
                                <span class="text-slate-300">|</span>
                                <button type="button" @onclick="ExpandAllQuestions" class="text-slate-500 hover:text-[#009488] cursor-pointer">
                                    Expand All
                                </button>
                            </div>
                        }
                    </div>

                    @if (!CurrentSectionQuestions.Any())
                    {
                        <div class="p-6 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center space-y-1 bg-slate-50/50 dark:bg-[#18262c]/50">
                            <p class="text-xs font-bold text-slate-500 dark:text-slate-400">No questions added in this list yet.</p>
                            <p class="text-[10px] text-slate-400">Use the top composer above to create and push questions here.</p>
                        </div>
                    }

                    @for (int i = 0; i < CurrentSectionQuestions.Count; i++)
                    {
                        var qIndex = i;
                        var q = CurrentSectionQuestions[qIndex];

                        <div class="rounded-2xl border transition-all duration-200 @(q.IsCollapsed ? "bg-white dark:bg-[#142025] border-slate-200 dark:border-slate-800 hover:border-teal-300 dark:hover:border-teal-700" : "bg-slate-50 dark:bg-[#18262c] border-teal-500/50 shadow-sm")">
                            
                            <!-- Question Bar / Header (Always Visible, Click to Toggle Collapse) -->
                            <div class="flex items-center justify-between p-3.5 cursor-pointer select-none gap-2"
                                 @onclick="() => q.IsCollapsed = !q.IsCollapsed">
                                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                    <span class="w-6 h-6 rounded-lg bg-[#009488] text-white font-bold text-[10px] flex items-center justify-center shrink-0">
                                        Q@(qIndex + 1)
                                    </span>
                                    <span class="px-2 py-0.5 rounded-md text-[9px] font-bold bg-teal-50 dark:bg-teal-950 text-[#00796b] dark:text-teal-300 border border-teal-200/60 dark:border-teal-900 shrink-0">
                                        @q.Category
                                    </span>
                                    <span class="text-xs font-semibold text-slate-800 dark:text-white truncate">
                                        @(string.IsNullOrWhiteSpace(q.QuestionText) ? "Untitled Question" : q.QuestionText)
                                    </span>
                                    @if (!string.IsNullOrEmpty(q.QuestionImageUrl))
                                    {
                                        <span class="text-[10px] shrink-0" title="Contains Diagram">🖼️</span>
                                    }
                                </div>

                                <div class="flex items-center gap-2.5 shrink-0 ml-2">
                                    <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/80 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800">
                                        Ans: @q.CorrectOption
                                    </span>
                                    <span class="text-[10px] font-medium text-slate-500">
                                        ⏱ @q.TimeLimitMinutes m
                                    </span>
                                    <span class="text-[10px] font-bold text-[#009488]">
                                        +@q.Marks
                                    </span>
                                    <!-- Toggle Chevron -->
                                    <button type="button" class="p-1 text-slate-400 hover:text-slate-700 dark:hover:text-white cursor-pointer" title="@(q.IsCollapsed ? "Expand to Edit" : "Collapse")">
                                        <svg class="w-4 h-4 transform transition-transform duration-200 @(q.IsCollapsed ? "" : "rotate-180")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                    <!-- Delete Button -->
                                    <button type="button" @onclick:stopPropagation="true" @onclick="() => RemoveQuestion(q)"
                                            class="p-1 text-slate-400 hover:text-rose-500 transition-colors cursor-pointer" title="Delete Question">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Expanded Editable Body -->
                            @if (!q.IsCollapsed)
                            {
                                <div class="p-4 pt-0 space-y-3.5 border-t border-slate-200/60 dark:border-slate-800 mt-1">
                                    <!-- Timing & Difficulty for this question -->
                                    <div class="flex flex-wrap items-center justify-between gap-2 pt-2">
                                        <div class="flex items-center gap-2">
                                            <span class="text-[10px] text-slate-400 font-medium">Category:</span>
                                            <select @bind="q.Category" 
                                                    class="text-[10px] font-bold bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 text-[#00796b] rounded-lg px-2 py-0.5 focus:outline-none">
                                                @foreach (var cat in _availableCategories)
                                                {
                                                    <option value="@cat">@cat</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="flex items-center gap-2 text-[11px]">
                                            <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#142025] p-0.5">
                                                <button type="button" @onclick='() => SetDifficulty(q, "Easy")'
                                                        class="px-2 py-0.5 rounded text-[10px] font-bold transition-all @(q.Difficulty == "Easy" ? "bg-emerald-500 text-white" : "text-slate-500")">Easy (1m)</button>
                                                <button type="button" @onclick='() => SetDifficulty(q, "Medium")'
                                                        class="px-2 py-0.5 rounded text-[10px] font-bold transition-all @(q.Difficulty == "Medium" ? "bg-amber-500 text-white" : "text-slate-500")">Med (2m)</button>
                                                <button type="button" @onclick='() => SetDifficulty(q, "Hard")'
                                                        class="px-2 py-0.5 rounded text-[10px] font-bold transition-all @(q.Difficulty == "Hard" ? "bg-rose-500 text-white" : "text-slate-500")">Hard (4m)</button>
                                            </div>
                                            <div class="flex items-center gap-1 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded-lg">
                                                <input type="number" min="1" max="30" @bind="q.TimeLimitMinutes" class="w-8 text-center text-xs font-bold text-slate-800 dark:text-white bg-transparent border-none focus:outline-none" />
                                                <span class="text-[10px] text-slate-400">min</span>
                                            </div>
                                            <div class="flex items-center gap-1 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded-lg">
                                                <span class="text-[10px] text-slate-400">Marks:</span>
                                                <input type="number" @bind="q.Marks" min="1" class="w-8 text-center text-xs font-bold text-[#009488] bg-transparent border-none focus:outline-none" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Question Statement Input -->
                                    <div class="space-y-1.5">
                                        <div class="flex items-center justify-between">
                                            <label class="text-[10px] font-semibold text-slate-500">Edit Question Statement</label>
                                            <button type="button" @onclick="() => q.ShowQuestionImageInput = !q.ShowQuestionImageInput" class="text-[10px] text-[#009488] font-bold hover:underline">
                                                @(string.IsNullOrEmpty(q.QuestionImageUrl) ? "+ Add Diagram" : "Edit Diagram")
                                            </button>
                                        </div>
                                        <textarea @bind="q.QuestionText" rows="2" class="w-full px-3 py-2 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none"></textarea>

                                        @if (q.ShowQuestionImageInput || !string.IsNullOrEmpty(q.QuestionImageUrl))
                                        {
                                            <div class="p-2.5 bg-white dark:bg-[#142025] rounded-xl border border-teal-200 dark:border-teal-900 space-y-2">
                                                <div class="flex items-center justify-between">
                                                    <div class="inline-flex rounded border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 p-0.5 text-[9px]">
                                                        <button type="button" @onclick='() => q.QuestionImageMode = "upload"' class="px-2 py-0.5 rounded font-bold @(q.QuestionImageMode == "upload" ? "bg-white text-[#009488]" : "text-slate-500")">Upload</button>
                                                        <button type="button" @onclick='() => q.QuestionImageMode = "link"' class="px-2 py-0.5 rounded font-bold @(q.QuestionImageMode == "link" ? "bg-white text-[#009488]" : "text-slate-500")">Link</button>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(q.QuestionImageUrl))
                                                    {
                                                        <button type="button" @onclick="() => { q.QuestionImageUrl = null; q.ShowQuestionImageInput = false; }" class="text-xs text-rose-500 font-bold px-2">Remove</button>
                                                    }
                                                </div>
                                                @if (q.QuestionImageMode == "upload")
                                                {
                                                    <label class="block text-center py-2 border-2 border-dashed border-teal-300 rounded-xl bg-teal-50/30 text-[10px] text-slate-700 font-bold cursor-pointer">
                                                        Choose file...
                                                        <InputFile OnChange="@(e => HandleQuestionImageUpload(e, q))" accept="image/*" class="hidden" />
                                                    </label>
                                                }
                                                else
                                                {
                                                    <input type="text" @bind="q.QuestionImageUrl" placeholder="https://..." class="w-full text-xs px-2 py-1 bg-slate-50 border rounded-lg focus:outline-none" />
                                                }
                                                @if (!string.IsNullOrEmpty(q.QuestionImageUrl))
                                                {
                                                    <img src="@q.QuestionImageUrl" alt="Diagram" class="max-h-24 object-contain rounded border" />
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- 4 Options -->
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                        <!-- Opt A -->
                                        <div class="p-2 bg-white dark:bg-[#142025] rounded-xl border @(q.CorrectOption == "A" ? "border-emerald-500 ring-1 ring-emerald-500" : "border-slate-200 dark:border-slate-700")">
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick='() => q.CorrectOption = "A"' class="w-6 h-6 rounded-lg font-bold text-[10px] flex items-center justify-center @(q.CorrectOption == "A" ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-600")">A</button>
                                                <input type="text" @bind="q.OptionA" class="flex-1 text-xs bg-transparent border-none focus:outline-none" />
                                            </div>
                                        </div>
                                        <!-- Opt B -->
                                        <div class="p-2 bg-white dark:bg-[#142025] rounded-xl border @(q.CorrectOption == "B" ? "border-emerald-500 ring-1 ring-emerald-500" : "border-slate-200 dark:border-slate-700")">
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick='() => q.CorrectOption = "B"' class="w-6 h-6 rounded-lg font-bold text-[10px] flex items-center justify-center @(q.CorrectOption == "B" ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-600")">B</button>
                                                <input type="text" @bind="q.OptionB" class="flex-1 text-xs bg-transparent border-none focus:outline-none" />
                                            </div>
                                        </div>
                                        <!-- Opt C -->
                                        <div class="p-2 bg-white dark:bg-[#142025] rounded-xl border @(q.CorrectOption == "C" ? "border-emerald-500 ring-1 ring-emerald-500" : "border-slate-200 dark:border-slate-700")">
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick='() => q.CorrectOption = "C"' class="w-6 h-6 rounded-lg font-bold text-[10px] flex items-center justify-center @(q.CorrectOption == "C" ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-600")">C</button>
                                                <input type="text" @bind="q.OptionC" class="flex-1 text-xs bg-transparent border-none focus:outline-none" />
                                            </div>
                                        </div>
                                        <!-- Opt D -->
                                        <div class="p-2 bg-white dark:bg-[#142025] rounded-xl border @(q.CorrectOption == "D" ? "border-emerald-500 ring-1 ring-emerald-500" : "border-slate-200 dark:border-slate-700")">
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick='() => q.CorrectOption = "D"' class="w-6 h-6 rounded-lg font-bold text-[10px] flex items-center justify-center @(q.CorrectOption == "D" ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-600")">D</button>
                                                <input type="text" @bind="q.OptionD" class="flex-1 text-xs bg-transparent border-none focus:outline-none" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Done / Collapse Button -->
                                    <div class="flex justify-end pt-1">
                                        <button type="button" @onclick="() => q.IsCollapsed = true"
                                                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-teal-50 dark:bg-teal-950/80 border border-teal-300 dark:border-teal-800 text-[#00796b] dark:text-teal-300 text-xs font-bold hover:bg-teal-100 transition-colors cursor-pointer">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                            <span>Done / Collapse Question</span>
                                        </button>
                                    </div>
                                </div>
                            }

                        </div>
                    }
                </div>

            </div>

        </div>

        <!-- Sticky Drawer Footer -->
        <div class="p-4 px-6 border-t border-slate-200/80 dark:border-slate-800 bg-slate-50/90 dark:bg-[#18262c] flex items-center justify-between gap-3 shrink-0">
            <div>
                <span class="text-xs font-bold text-slate-800 dark:text-white">@_newQuizQuestions.Count Questions</span>
                <span class="text-[10px] text-slate-400 block font-medium">@_newQuizQuestions.Sum(q => q.Marks) Marks • Time: @_newQuizQuestions.Sum(q => q.TimeLimitMinutes) min</span>
            </div>

            <div class="flex items-center gap-2.5">
                <button type="button" 
                        @onclick="CloseCreateDrawerAsync" 
                        class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="button" 
                        @onclick="SaveAndPublishQuiz"
                        class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>@(_editingExam == null ? "Save & Schedule Quiz" : "Update Quiz")</span>
                </button>
            </div>
        </div>

    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: Preview Quiz Questions (With Images & Timings) -->
<!-- ========================================================================= -->
@if (_previewExam != null)
{
    <Modal IsOpen="true"
           Title="@_previewExam.Title"
           Subtitle="@($"{_previewExam.BatchName} • {_previewExam.TotalQuestions} Questions • {_previewExam.MaxMarks} Marks • Status: {_previewExam.Status}")"
           MaxWidth="max-w-2xl"
           OnClose="() => _previewExam = null">
        <ChildContent>
            <div class="space-y-4 max-h-[65vh] overflow-y-auto no-scrollbar">
                
                <!-- Status Banner: Completed (Locked) or Upcoming (Editable) -->
                <div class="p-3 rounded-xl border flex items-center justify-between text-xs @(_previewExam.Status == "Completed" ? "bg-slate-100 dark:bg-slate-800/80 border-slate-200 text-slate-600 dark:text-slate-400" : "bg-teal-50/60 dark:bg-teal-950/60 border-teal-200 text-teal-800 dark:text-teal-200")">
                    <div class="flex items-center gap-2">
                        @if (_previewExam.Status == "Completed")
                        {
                            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            <span class="font-bold">Completed Exam (Locked — Changes are strictly disabled)</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            <span class="font-bold">Upcoming Exam (Fully Editable)</span>
                        }
                    </div>
                    @if (_previewExam.Status == "Upcoming")
                    {
                        <button type="button" @onclick="() => { var e = _previewExam; _previewExam = null; OpenEditDrawerAsync(e); }"
                                class="px-3 py-1 bg-[#009488] text-white font-bold text-xs rounded-lg hover:bg-[#00796b] transition-colors cursor-pointer">
                            Edit Quiz →
                        </button>
                    }
                </div>

                <!-- Sections list -->
                <div class="flex flex-wrap gap-1.5 pb-1">
                    @foreach (var cat in _previewExam.Categories)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                            Section: @cat
                        </span>
                    }
                </div>

                @if (_previewExam.Questions != null && _previewExam.Questions.Any())
                {
                    @for (int i = 0; i < _previewExam.Questions.Count; i++)
                    {
                        var item = _previewExam.Questions[i];
                        <div class="p-3.5 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200/80 dark:border-slate-800 space-y-2 text-xs">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-[#009488]">Q@(i + 1) • Section: @item.Category</span>
                                <div class="flex items-center gap-2 text-[11px] text-slate-500">
                                    <span class="font-bold">⏱ @item.TimeLimitMinutes min (@item.Difficulty)</span>
                                    <span>•</span>
                                    <span class="font-bold text-emerald-600">+@item.Marks Marks</span>
                                </div>
                            </div>

                            <p class="font-semibold text-slate-800 dark:text-white">@item.QuestionText</p>

                            <!-- Question Image Preview if present -->
                            @if (!string.IsNullOrEmpty(item.QuestionImageUrl))
                            {
                                <div class="max-w-xs max-h-36 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 my-1">
                                    <img src="@item.QuestionImageUrl" alt="Diagram" class="w-full h-full object-contain max-h-36 bg-white dark:bg-[#142025]" />
                                </div>
                            }

                            <!-- Options Grid with Option Images -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1">
                                <!-- Option A -->
                                <div class="p-2 rounded-lg @(item.CorrectOption == "A" ? "bg-emerald-50 dark:bg-emerald-950/60 font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-300" : "bg-white dark:bg-[#142025] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                    <div class="flex items-center justify-between">
                                        <span>A) @item.OptionA</span>
                                        @if (item.CorrectOption == "A") { <span class="text-emerald-600">✓ Correct</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.OptionAImageUrl))
                                    {
                                        <img src="@item.OptionAImageUrl" alt="Opt A" class="mt-1 h-12 object-contain rounded border" />
                                    }
                                </div>

                                <!-- Option B -->
                                <div class="p-2 rounded-lg @(item.CorrectOption == "B" ? "bg-emerald-50 dark:bg-emerald-950/60 font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-300" : "bg-white dark:bg-[#142025] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                    <div class="flex items-center justify-between">
                                        <span>B) @item.OptionB</span>
                                        @if (item.CorrectOption == "B") { <span class="text-emerald-600">✓ Correct</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.OptionBImageUrl))
                                    {
                                        <img src="@item.OptionBImageUrl" alt="Opt B" class="mt-1 h-12 object-contain rounded border" />
                                    }
                                </div>

                                <!-- Option C -->
                                <div class="p-2 rounded-lg @(item.CorrectOption == "C" ? "bg-emerald-50 dark:bg-emerald-950/60 font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-300" : "bg-white dark:bg-[#142025] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                    <div class="flex items-center justify-between">
                                        <span>C) @item.OptionC</span>
                                        @if (item.CorrectOption == "C") { <span class="text-emerald-600">✓ Correct</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.OptionCImageUrl))
                                    {
                                        <img src="@item.OptionCImageUrl" alt="Opt C" class="mt-1 h-12 object-contain rounded border" />
                                    }
                                </div>

                                <!-- Option D -->
                                <div class="p-2 rounded-lg @(item.CorrectOption == "D" ? "bg-emerald-50 dark:bg-emerald-950/60 font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-300" : "bg-white dark:bg-[#142025] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                    <div class="flex items-center justify-between">
                                        <span>D) @item.OptionD</span>
                                        @if (item.CorrectOption == "D") { <span class="text-emerald-600">✓ Correct</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.OptionDImageUrl))
                                    {
                                        <img src="@item.OptionDImageUrl" alt="Opt D" class="mt-1 h-12 object-contain rounded border" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">Standard automated question bank generated for this exam.</p>
                }
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => _previewExam = null"
                    class="px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-100 transition-colors">
                Close
            </button>
        </FooterTemplate>
    </Modal>
}

