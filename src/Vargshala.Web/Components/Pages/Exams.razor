    protected override void OnInitialized()
    {
        try
        {
            var jsonPath = Path.Combine(WebHostEnvironment.WebRootPath, "stet_2025_questions.json");
            if (File.Exists(jsonPath))
            {
                var json = File.ReadAllText(jsonPath);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var stetQuestions = new List<QuizQuestionModel>();
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    var sec = el.GetProperty("section").GetString() ?? "Computer Science";
                    var qText = el.GetProperty("question").GetString() ?? "";
                    var optA = el.GetProperty("optionA").GetString() ?? "";
                    var optB = el.GetProperty("optionB").GetString() ?? "";
                    var optC = el.GetProperty("optionC").GetString() ?? "";
                    var optD = el.GetProperty("optionD").GetString() ?? "";
                    var correct = el.GetProperty("correct").GetString() ?? "A";
                    stetQuestions.Add(new QuizQuestionModel(
                        sec, qText, optA, optB, optC, optD, correct, 1, 1, "Easy"
                    ) { IsCollapsed = true });
                }

                if (stetQuestions.Any())
                {
                    _exams.Insert(0, new ExamItem(
                        "STET Exam 2025 — Computer Science Paper II",
                        "STET Computer Science 2025",
                        "Upcoming",
                        "15 Sep 2026",
                        stetQuestions.Count,
                        150,
                        stetQuestions.Count,
                        0,
                        new() { "Computer Science", "Teaching & Pedagogy", "General Knowledge" },
                        stetQuestions
                    ));
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading STET questions: " + ex.Message);
        }
    }

    private List<ExamItem> FilteredExams => _exams.Where(e =>
        (string.IsNullOrWhiteSpace(_searchQuery) ||
         e.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
         e.BatchName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
         e.Categories.Any(c => c.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrWhiteSpace(_filterStatus) || e.Status == _filterStatus) &&
        (string.IsNullOrWhiteSpace(_filterBatch) || e.BatchName == _filterBatch)
    ).ToList();

    private List<QuizQuestionModel> CurrentSectionQuestions => _activeCategoryTab == "All"
        ? _newQuizQuestions
        : _newQuizQuestions.Where(q => q.Category == _activeCategoryTab).ToList();

