                                    Easy (1m)
                                </button>
                                <button type="button" @onclick='() => SetDifficulty(_newQuestionDraft, "Medium")'
                                        class="px-2 py-0.5 rounded text-[10px] font-bold transition-all @(_newQuestionDraft.Difficulty == "Medium" ? "bg-amber-500 text-white" : "text-slate-500 hover:text-slate-700")">
                                    Medium (2m)
                                </button>
                                <button type="button" @onclick='() => SetDifficulty(_newQuestionDraft, "Hard")'
                                        class="px-2 py-0.5 rounded text-[10px] font-bold transition-all @(_newQuestionDraft.Difficulty == "Hard" ? "bg-rose-500 text-white" : "text-slate-500 hover:text-slate-700")">
                                    Hard (4m)
