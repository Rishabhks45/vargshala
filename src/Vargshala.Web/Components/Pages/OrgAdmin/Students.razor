@page "/students"
@attribute [Authorize(Roles = "OrganizationAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Students
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Services
@inject IStudentService StudentService
@inject INotificationService Toast
@rendermode InteractiveServer

<PageTitle>Students Directory | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">
    
    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Students Directory
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage enrolled students, batch assignments, contact details, and fee records.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddModalAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Add Student</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Matched with Users.razor) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Enrolled</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_students.Count(s => s.IsActive) Active • @_students.Count(s => !s.IsActive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Students</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@_students.Count(s => s.IsActive)</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Currently Enrolled</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Fee Overdue</p>
                    <h3 class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">@_students.Count(s => s.FeeStatus == "Overdue")</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Payment Pending</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Loaded Records</p>
                    <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">@_students.Count</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Current Page View</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls (Matched with Users.razor) -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_searchQuery" 
                         OnSearch="() => LoadStudentsAsync(1)" 
                         Placeholder="Search student by name, roll, contact..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-44">
                <CustomSelect Value="@_selectedBatch" 
                              ValueChanged="HandleBatchChanged" 
                              Options="_batchFilterOptions" 
                              Placeholder="All Batches" />
            </div>
            <div class="w-36">
                <CustomSelect @bind-Value="_selectedFeeStatus" 
                              Options="_feeStatusFilterOptions" 
                              Placeholder="All Fee Status" />
            </div>
            <div class="w-36">
                <CustomSelect Value="@_selectedStatus" 
                              ValueChanged="HandleStatusChanged" 
                              Options="_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Students Data Table (Fits screen height, internal scrolling with hidden scrollbar) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[860px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[24%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Student</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="w-[9%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("RollNumber")'>
                            <div class="flex items-center gap-1.5">
                                <span>Roll</span>
                                <span class="@_sortState.GetIndicatorClass("RollNumber")">@_sortState.GetIndicator("RollNumber")</span>
                            </div>
                        </th>
                        <th class="w-[15%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("ClassName")'>
                            <div class="flex items-center gap-1.5">
                                <span>Batch</span>
                                <span class="@_sortState.GetIndicatorClass("ClassName")">@_sortState.GetIndicator("ClassName")</span>
                            </div>
                        </th>
                        <th class="w-[16%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Mobile")'>
                            <div class="flex items-center gap-1.5">
                                <span>Contact</span>
                                <span class="@_sortState.GetIndicatorClass("Mobile")">@_sortState.GetIndicator("Mobile")</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2 px-3">
                            <div class="flex items-center gap-1.5">
                                <span>Fees</span>
                            </div>
                        </th>
                        <th class="w-[16%] py-2 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _students.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_students.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="8" />
                    }
                    else if (_students.Any())
                    {
                        @foreach (var student in _students)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors">
                                
                                <!-- Student: Initials Avatar + Full Name + ID -->
                                <td class="py-1.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                            @student.Initials
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-800 dark:text-white leading-tight truncate cursor-pointer hover:text-[#009488]"
                                                 @onclick="() => OpenViewProfile(student)">
                                                @student.Name
                                            </div>
                                            <div class="text-[10px] text-slate-400 font-mono leading-none mt-0.5">
                                                @(!string.IsNullOrEmpty(student.StudentCode) ? student.StudentCode : "—")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Roll Number -->
                                <td class="py-1.5 px-3 font-semibold text-slate-700 dark:text-slate-300">
                                    @(!string.IsNullOrEmpty(student.RollNumber) ? student.RollNumber : "—")
                                </td>

                                <!-- Batch Name Pill -->
                                <td class="py-1.5 px-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300">
                                        @(!string.IsNullOrEmpty(student.BatchName) ? student.BatchName : (!string.IsNullOrEmpty(student.ClassName) ? student.ClassName : "—"))
                                    </span>
                                </td>

                                <!-- Contact & Parent -->
                                <td class="py-1.5 px-3">
                                    <div class="font-semibold text-slate-800 dark:text-slate-200 leading-tight">
                                        @(!string.IsNullOrEmpty(student.Phone) ? student.Phone : (!string.IsNullOrEmpty(student.Email) ? student.Email : "—"))
                                    </div>
                                    <div class="text-[10px] text-slate-400 mt-0.5 leading-none">
                                        @(!string.IsNullOrEmpty(student.ParentName) ? student.ParentName : "—")
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-1.5 px-3 text-center">
                                    @if (student.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Fee Status Badge -->
                                <td class="py-1.5 px-3">
                                    @if (student.FeeStatus == "Paid")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            Paid
                                        </span>
                                    }
                                    else if (student.FeeStatus == "Partial")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800">
                                            Partial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800">
                                            Overdue
                                        </span>
                                    }
                                </td>

                                <!-- Actions Column: Direct Action Buttons with Isolated Tooltips -->
                                <td class="py-1.5 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        
                                        <!-- Action 1: View Profile -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenViewProfile(student)" 
                                                    class="p-1.5 text-[#009488] dark:text-teal-400 hover:text-[#00796b] dark:hover:text-teal-300 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="View Profile"
                                                    aria-label="View Profile">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                    View Profile
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 2: Edit Student -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenEditModalAsync(student)" 
                                                    class="p-1.5 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="Edit Student"
                                                    aria-label="Edit Student">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-amber-600 text-white border border-amber-400/50 shadow-lg tracking-wide">
                                                    Edit Student
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-amber-600 border-r border-b border-amber-400/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 3: Collect Fee -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenFeeModal(student)" 
                                                    class="p-1.5 text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="Collect Fee"
                                                    aria-label="Collect Fee">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-emerald-700 text-white border border-emerald-500/50 shadow-lg tracking-wide">
                                                    Collect Fee
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-emerald-700 border-r border-b border-emerald-500/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 4: Toggle Status (Activate / Deactivate) -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => ToggleStudentStatus(student)" 
                                                    class="p-1.5 @(student.IsActive 
                                                        ? "text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-950/40" 
                                                        : "text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="@(student.IsActive ? "Deactivate" : "Activate")"
                                                    aria-label="Toggle Status">
                                                @if (student.IsActive)
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                                    </svg>
                                                }
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded @(student.IsActive ? "bg-sky-700" : "bg-slate-700") text-white border border-white/20 shadow-lg tracking-wide">
                                                    @(student.IsActive ? "Deactivate" : "Activate")
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 @(student.IsActive ? "bg-sky-700" : "bg-slate-700") border-r border-b border-white/20"></span>
                                            </div>
                                        </div>

                                        <!-- Action 5: Delete Student -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => DeleteStudentAsync(student.Id)" 
                                                    class="p-1.5 text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="Delete Student"
                                                    aria-label="Delete Student">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-rose-600 text-white border border-rose-400/50 shadow-lg tracking-wide">
                                                    Delete Student
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-rose-600 border-r border-b border-rose-400/50"></span>
                                            </div>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No students found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber" 
                             PageSize="_query.PageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="students"
                             IsLoading="_isLoading"
                             OnPageChanged="LoadStudentsAsync"
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Add / Edit Student Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showAddEditModal)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Side-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient & Golden/Teal Badge -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/plant-books.png" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingStudent == null ? "New Student Admission" : "Edit Student Profile")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingStudent == null ? "Enroll a new student to coaching batch with complete profile" : $"Updating records for {_editingStudent.FullName}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Blazor EditForm Wrapper with FluentValidation -->
        <EditForm Model="@_modalModel" OnValidSubmit="SaveStudentAsync" class="flex-1 flex flex-col justify-between overflow-hidden">
            <FluentValidationValidator />

            <!-- Drawer Scrollable Form Body (No Scrollbar) -->
            <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-6 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                <!-- Section 1: Personal & Identity Information -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>1. Personal &amp; Identity Details</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">First Name *</label>
                            <InputText @bind-Value="_modalModel.FirstName" placeholder="e.g. Aarav" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.FirstName)" class="text-[10px] text-rose-500" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Last Name *</label>
                            <InputText @bind-Value="_modalModel.LastName" placeholder="e.g. Mehta" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.LastName)" class="text-[10px] text-rose-500" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Student Email</label>
                            <InputText @bind-Value="_modalModel.Email" placeholder="student@example.com" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.Email)" class="text-[10px] text-rose-500" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Student Mobile / Phone</label>
                            <InputText @bind-Value="_modalModel.Mobile" placeholder="+91 90000 00000" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.Mobile)" class="text-[10px] text-rose-500" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Date of Birth</label>
                            <InputDate Type="InputDateType.Date" @bind-Value="_modalModel.DateOfBirth" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Gender</label>
                            <CustomSelect @bind-Value="_modalModel.Gender" Options="_genderOptions" Placeholder="Select Gender" Class="w-full" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Blood Group</label>
                            <CustomSelect @bind-Value="_modalModel.BloodGroup" Options="_bloodGroupOptions" Placeholder="Select Group" Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Nationality</label>
                            <InputText @bind-Value="_modalModel.Nationality" placeholder="e.g. Indian" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Aadhar Number</label>
                            <InputText @bind-Value="_modalModel.AadharNumber" placeholder="12-digit UID" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Section 2: Academic & Enrollment Details -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>2. Academic &amp; Enrollment Details</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-start">
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Student Code / ID *</label>
                                <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold">Auto (STU-YY00001)</span>
                            </div>
                            <div class="relative">
                                <InputText @bind-Value="_modalModel.StudentCode" readonly placeholder="e.g. STU-2600001" class="w-full h-10 pl-3.5 pr-8 py-2.5 text-xs bg-slate-100 dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300 font-mono font-bold cursor-not-allowed select-none focus:outline-none transition-all" />
                                <button type="button" @onclick="RegenerateStudentCodeAsync" title="Regenerate unique Code & Roll" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-[#009488] transition-colors cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Roll Number</label>
                                <span class="text-[10px] text-slate-400 font-medium">Auto (YY00001)</span>
                            </div>
                            <InputText @bind-Value="_modalModel.RollNumber" readonly placeholder="e.g. 2600001" class="w-full h-10 px-3.5 py-2.5 text-xs bg-slate-100 dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300 font-mono font-bold cursor-not-allowed select-none focus:outline-none transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-start">
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Class / Course *</label>
                            </div>
                            <CustomSelect @bind-Value="_modalModel.ClassName" Options="_drawerBatchOptions" Placeholder="Select Class / Course" Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Section</label>
                            </div>
                            <InputText @bind-Value="_modalModel.Section" placeholder="e.g. Section A" class="w-full h-10 px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-start">
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Admission Date</label>
                            </div>
                            <InputDate Type="InputDateType.Date" @bind-Value="_modalModel.AdmissionDate" class="w-full h-10 px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Previous School / Institute</label>
                            </div>
                            <InputText @bind-Value="_modalModel.PreviousInstitute" placeholder="e.g. DPS Patna" class="w-full h-10 px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Section 3: Parent & Guardian Details -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>3. Parent &amp; Guardian Details</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Father's Name</label>
                            <InputText @bind-Value="_modalModel.FatherName" placeholder="Father's full name" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Father's Mobile</label>
                            <InputText @bind-Value="_modalModel.FatherMobile" placeholder="+91 90000 00000" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Mother's Name</label>
                            <InputText @bind-Value="_modalModel.MotherName" placeholder="Mother's full name" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Alternate / WhatsApp Mobile</label>
                            <InputText @bind-Value="_modalModel.FatherAlternateMobile" placeholder="+91 90000 00000" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Section 4: Residential Address -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>4. Residential Address</span>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Street / House Address</label>
                        <InputText @bind-Value="_modalModel.Address" placeholder="Flat / House No., Landmark, Area" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">City</label>
                            <InputText @bind-Value="_modalModel.City" placeholder="e.g. Patna" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">State</label>
                            <InputText @bind-Value="_modalModel.State" placeholder="e.g. Bihar" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Postal / PIN Code</label>
                            <InputText @bind-Value="_modalModel.PostalCode" placeholder="e.g. 800001" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Country</label>
                            <InputText @bind-Value="_modalModel.Country" placeholder="India" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>
