        if (_isSaving) return;
        _isSaving = true;

        try
        {
            var firstName = _modalModel.FirstName?.Trim();
            var lastName = _modalModel.LastName?.Trim();

            if (string.IsNullOrWhiteSpace(firstName) && !string.IsNullOrWhiteSpace(_modalModel.Name))
            {
                var parts = _modalModel.Name.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                firstName = parts.Length > 0 ? parts[0] : "Student";
                lastName = parts.Length > 1 ? parts[1] : ".";
