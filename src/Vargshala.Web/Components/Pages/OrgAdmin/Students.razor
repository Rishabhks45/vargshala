        new("Class 12 — Physics", "Class 12 — Physics"),
        new("Class 12 — Chemistry", "Class 12 — Chemistry"),
        new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };

    private readonly List<CustomSelect.CustomSelectOption> _genderOptions = new()
    {
        new("", "Select Gender"),
        new("Male", "Male"),
        new("Female", "Female"),
        new("Other", "Other")
    };

    private readonly List<CustomSelect.CustomSelectOption> _bloodGroupOptions = new()
    {
        new("", "Select Blood Group"),
        new("A+", "A+"),
        new("A-", "A-"),
        new("B+", "B+"),
        new("B-", "B-"),
        new("O+", "O+"),
        new("O-", "O-"),
        new("AB+", "AB+"),
        new("AB-", "AB-")
    };

    private readonly List<CustomSelect.CustomSelectOption> _paymentModeOptions = new()
    {
        new("UPI / Online (GPay, PhonePe, Paytm)", "UPI / Online (GPay, PhonePe, Paytm)"),
        new("Cash Receipt", "Cash Receipt"),
        new("Bank Transfer (NEFT/IMPS)", "Bank Transfer (NEFT/IMPS)"),
        new("Cheque", "Cheque")
    };

    private bool _showAddEditModal = false;
    private bool _isDrawerOpen = false;
    private StudentDto? _editingStudent;
    private StudentDto _modalModel = new();
    private StudentDto? _selectedProfileStudent;
    private StudentDto? _feeCollectStudent;
    private decimal _feeAmountToCollect = 5000;

    private List<StudentDto> _students = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync(1);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadStudentsAsync(1);
    }

    private async Task LoadStudentsAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = page;

        try
        {
            bool? isActive = null;
            if (_selectedStatus == "Active") isActive = true;
            else if (_selectedStatus == "Inactive") isActive = false;

            var pagedRequest = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim(),
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : (_sortState.Direction == SortDirection.Ascending ? "asc" : null)
            };

            var response = await StudentService.GetStudentsPagedAsync(
                pagedRequest,
                className: string.IsNullOrWhiteSpace(_selectedBatch) ? null : _selectedBatch,
                isActive: isActive);

            if (response != null && response.Success && response.Data != null)
            {
                _students = response.Data.Items.ToList();
                _totalRecords = response.Data.TotalRecords;
            }
            else
            {
                _students = new();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load students: {ex.Message}");
            _students = new();
            _totalRecords = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        await LoadStudentsAsync(1);
    }

    private async Task ClearSearchAsync()
    {
        _searchQuery = string.Empty;
        await LoadStudentsAsync(1);
    }

    private async Task HandleBatchChanged(string val)
    {
        _selectedBatch = val;
        await LoadStudentsAsync(1);
    }

    private async Task HandleStatusChanged(string val)
    {
        _selectedStatus = val;
        await LoadStudentsAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadStudentsAsync(1);
    }

    private async Task OpenAddModalAsync()
    {
        _editingStudent = null;
        _modalModel = new StudentDto
        {
            FirstName = string.Empty,
            LastName = string.Empty,
            Nationality = "Indian",
            Country = "India",
            AdmissionDate = DateOnly.FromDateTime(DateTime.UtcNow),
            ClassName = "Class 10 — Maths",
            BatchName = "Class 10 — Maths",
            Status = "Active",
            IsActive = true,
            FeeStatus = "Paid",
            TotalFee = 25000,
            PaidFee = 25000
        };

        // Auto-fetch generated Student Code (STU-YY00001) and Roll Number (YY00001)
        try
        {
            var genRes = await StudentService.GenerateStudentCodeAsync();
            if (genRes != null && genRes.Success && genRes.Data != null)
            {
                _modalModel.StudentCode = genRes.Data.StudentCode;
                _modalModel.RollNumber = genRes.Data.RollNumber;
            }
        }
        catch
        {
            // Backend will auto-generate if network fails
        }

        _showAddEditModal = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task RegenerateStudentCodeAsync()
    {
        try
        {
            var genRes = await StudentService.GenerateStudentCodeAsync();
            if (genRes != null && genRes.Success && genRes.Data != null)
            {
                _modalModel.StudentCode = genRes.Data.StudentCode;
                _modalModel.RollNumber = genRes.Data.RollNumber;
