    private void OpenFeeModal(StudentDto student)
    {
        _feeCollectStudent = student;
        _feeAmountToCollect = student.DueFee > 0 ? student.DueFee : 5000;
        _selectedProfileStudent = null;
    }

    private void ProcessFeePayment()
    {
        if (_feeCollectStudent != null)
        {
            _feeCollectStudent.PaidFee += _feeAmountToCollect;
            if (_feeCollectStudent.PaidFee >= _feeCollectStudent.TotalFee)
            {
                _feeCollectStudent.PaidFee = _feeCollectStudent.TotalFee;
                _feeCollectStudent.FeeStatus = "Paid";
            }
            else if (_feeCollectStudent.PaidFee > 0)
            {
                _feeCollectStudent.FeeStatus = "Partial";
            }

            Toast.Success($"Fee payment of ₹{_feeAmountToCollect:N0} recorded for {_feeCollectStudent.Name}.");
            _feeCollectStudent = null;
        }
    }

