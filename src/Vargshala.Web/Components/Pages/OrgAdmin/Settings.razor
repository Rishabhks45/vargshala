                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">New Password</label>
                                <input type="password" 
                                       @bind="_newPassword"
                                       class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" 
                                       placeholder="Min 8 chars" />
                            </div>

                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Confirm Password</label>
                                <input type="password" 
                                       @bind="_confirmPassword"
                                       class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" 
                                       placeholder="Repeat password" />
                            </div>
                        </div>

                        <button type="button" 
                                @onclick="UpdatePasswordAsync"
                                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer">
                            <span>Update Password</span>
                        </button>
                    </div>

                    <!-- 2FA & Session Security -->
                    <div class="pt-5 border-t border-slate-100 dark:border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-800 dark:text-white">Two-Factor Authentication</span>
