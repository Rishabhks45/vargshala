                            <span class="text-xs font-bold text-[#004D40] dark:text-teal-300">Active Academic Session</span>
                            <span class="text-[10px] font-bold text-teal-600 dark:text-teal-400 bg-teal-100/70 dark:bg-teal-900/60 px-2 py-0.5 rounded-full">
                                Live In Production
                            </span>
                        </div>
                        <div class="max-w-md">
                            <CustomSelect Value="@_model.AcademicSession" 
                                          ValueChanged="OnAcademicSessionChanged" 
                                          Options="@_sessionOptions" 
                                          Placeholder="Select Active Session..." />
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
