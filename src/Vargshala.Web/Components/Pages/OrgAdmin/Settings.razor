@page "/settings"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Organizations
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Web.Services
@inject IInstituteService InstituteService
@inject INotificationService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject IFileUploadService FileUploadService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Settings | Vargshala</PageTitle>

<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-5 transition-colors duration-200 pb-6">

    <!-- Top Breadcrumb & Actions Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shadow-[#004D40]/20 shrink-0">
                <svg class="w-5 h-5 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Settings &amp; Preferences
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage institute profile, academic sessions, white-label branding, security and communication preferences.
                </p>
            </div>
        </div>

        <!-- Header Actions -->
        <div class="flex items-center gap-2.5 shrink-0">
            <button type="button" 
                    @onclick="ResetForm"
                    disabled="@_isSaving"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5 disabled:opacity-50">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Reset</span>
            </button>

            <button type="button" 
                    @onclick="SaveSettingsAsync"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.01] active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed">
                @if (_isSaving)
                {
                    <svg class="animate-spin -ml-0.5 mr-1 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Save Changes</span>
                }
            </button>
        </div>
    </div>

    <!-- Institute Hero Overview Banner (Theme 4 Deep Teal Gradient) -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#004D40] via-[#00695C] to-[#009488] text-white p-5 shadow-lg shadow-[#004D40]/15">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute right-20 top-2 w-32 h-32 bg-teal-300/10 rounded-full blur-xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <!-- Avatar / Logo -->
                <div class="relative w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-sm border-2 border-white/20 flex items-center justify-center shrink-0 shadow-inner overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(_model.LogoUrl))
                    {
                        <img src="@_model.LogoUrl" alt="Logo" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="text-lg font-black tracking-wider text-teal-100">
                            @(GetInitials(_model.Name))
                        </span>
                    }
                </div>

                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-base font-extrabold tracking-tight text-white">
                            @(string.IsNullOrWhiteSpace(_model.Name) ? "Institute Profile" : _model.Name)
                        </h2>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/20 text-white backdrop-blur-xs border border-white/30">
                            @(_orgCode)
                        </span>
                        @if (_model.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-400/20 text-emerald-200 border border-emerald-300/30">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span> Active
                            </span>
                        }
                    </div>
                    <p class="text-xs text-teal-100/80 mt-0.5 font-medium flex items-center gap-3 flex-wrap">
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            @(string.IsNullOrWhiteSpace(_model.City) ? "India" : $"{_model.City}, {_model.State}")
                        </span>
                        <span class="text-teal-300/50">•</span>
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            Session: @(string.IsNullOrWhiteSpace(_model.AcademicSession) ? "2026-2027" : _model.AcademicSession)
                        </span>
                        <span class="text-teal-300/50">•</span>
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            Enterprise SaaS Plan
                        </span>
                    </p>
                </div>
            </div>

            <!-- Quick Sync Timestamp Pill -->
            <div class="flex items-center gap-2 self-start md:self-auto bg-black/15 backdrop-blur-sm px-3 py-1.5 rounded-xl border border-white/10 text-[11px] text-teal-100">
                <svg class="w-3.5 h-3.5 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Synced: @_lastSavedText</span>
            </div>
        </div>
    </div>

    <!-- Main Segmented Settings Layout (Left Nav + Right Content) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- Left Navigation Sidebar (Pills with icons) -->
        <div class="lg:col-span-3 bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-2 shadow-xs space-y-1">
            <button type="button" 
                    @onclick='() => _activeTab = "profile"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "profile" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "profile" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span>Institute Profile</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "sessions"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "sessions" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "sessions" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Academic Sessions</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "branding"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "branding" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "branding" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                    <span>Branding &amp; Portal</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "security"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "security" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "security" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <span>Security &amp; Passwords</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "notifications"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "notifications" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "notifications" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span>Notifications &amp; Alerts</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "subscription"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "subscription" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "subscription" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span>Subscription &amp; Quotas</span>
                </div>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-teal-100 dark:bg-teal-900/60 text-[#004D40] dark:text-teal-300">PRO</span>
            </button>
        </div>

        <!-- Right Main Panel Content -->
        <div class="lg:col-span-9 space-y-5">

            <!-- 1. Institute Profile Tab -->
            @if (_activeTab == "profile")
            {
                <EditForm Model="_model" OnValidSubmit="SaveSettingsAsync">
                    <FluentValidationValidator />

                    <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
                            <div>
                                <h3 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                    <span>🏛️ General Institute Information</span>
                                </h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                    Update official school/institute profile shown on parent portal and invoices.
                                </p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-[#00796b] dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                                Tenant ID: @_model.Id.ToString().Substring(0, 8)...
                            </span>
                        </div>

                        <!-- Logo & Identity Section -->
                        <div class="flex flex-col sm:flex-row sm:items-center gap-5 p-4 rounded-xl bg-slate-50/70 dark:bg-[#131f24] border border-slate-100 dark:border-slate-800">
                            <div class="relative w-20 h-20 rounded-2xl bg-white dark:bg-[#18262c] border-2 border-dashed border-teal-400/50 dark:border-teal-700/50 flex items-center justify-center shrink-0 shadow-xs overflow-hidden group">
                                @if (!string.IsNullOrWhiteSpace(_model.LogoUrl))
                                {
                                    <img src="@_model.LogoUrl" alt="Institute Logo" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="text-center p-2">
                                        <svg class="w-6 h-6 text-[#009488] mx-auto mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        <span class="text-[9px] font-bold text-[#009488]">No Logo</span>
                                    </div>
                                }
                            </div>
                            <div class="flex-1 space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Logo Image URL or Local File</label>
                                    <label class="cursor-pointer inline-flex items-center gap-1 text-[11px] font-bold text-[#009488] hover:text-[#00796b] hover:underline">
                                        <InputFile OnChange="HandleLogoFileSelected" class="hidden" accept=".png,.jpg,.jpeg,.svg" />
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                        <span>Browse File...</span>
                                    </label>
                                </div>
                                <div class="relative">
                                    <InputText @bind-Value="_model.LogoUrl" 
                                               placeholder="https://cdn.example.com/logo.png or choose local file" 
                                               class="w-full px-3.5 py-2 text-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-500">
                                    Supported: PNG, JPG, SVG up to 2MB. Validated via FileUploadService.
                                </p>
                            </div>
                        </div>

                        <!-- Core Fields Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Institute Name -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
                                    <span>Institute Name <span class="text-rose-500">*</span></span>
                                </label>
                                <InputText @bind-Value="_model.Name" 
                                           placeholder="e.g. Apex Science &amp; Commerce Academy" 
                                           class="w-full px-3.5 py-2.5 text-xs font-semibold bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                <ValidationMessage For="@(() => _model.Name)" class="text-rose-500 text-[10px] font-medium" />
                            </div>

                            <!-- Institute Code (Immutable) -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
                                    <span>Institute Code (Tenant Slug)</span>
                                    <span class="text-[10px] text-slate-400 font-normal">System-assigned</span>
                                </label>
                                <div class="relative flex items-center">
                                    <input type="text" readonly value="@_orgCode" 
                                           class="w-full px-3.5 py-2.5 text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-600 dark:text-slate-300 cursor-not-allowed select-all" />
                                    <span class="absolute right-3 text-slate-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                    </span>
                                </div>
                            </div>

                            <!-- Official Email -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Official Email</label>
                                <InputText @bind-Value="_model.Email" 
                                           placeholder="admin@institute.edu.in" 
                                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                <ValidationMessage For="@(() => _model.Email)" class="text-rose-500 text-[10px] font-medium" />
                            </div>

                            <!-- Contact Phone -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Contact / Helpline Phone</label>
                                <InputText @bind-Value="_model.Mobile" 
                                           placeholder="+91 98765 43210" 
                                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                <ValidationMessage For="@(() => _model.Mobile)" class="text-rose-500 text-[10px] font-medium" />
                            </div>

                            <!-- Address Line -->
                            <div class="space-y-1 md:col-span-2">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Campus Address</label>
                                <InputText @bind-Value="_model.Address" 
                                           placeholder="e.g. 42 Knowledge Park, Main Ring Road" 
                                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                <ValidationMessage For="@(() => _model.Address)" class="text-rose-500 text-[10px] font-medium" />
                            </div>

                            <!-- City -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">City</label>
                                <InputText @bind-Value="_model.City" 
                                           placeholder="e.g. Jaipur" 
                                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            </div>

                            <!-- State & Pincode -->
                            <div class="grid grid-cols-2 gap-3">
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">State</label>
                                    <InputText @bind-Value="_model.State" 
                                               placeholder="e.g. Rajasthan" 
                                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Pincode</label>
                                    <InputText @bind-Value="_model.Pincode" 
                                               placeholder="302001" 
                                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                </div>
                            </div>
                        </div>

                        <!-- Save Trigger at bottom of tab -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-[11px] text-slate-400">All updates immediately sync with tenant subdomains.</span>
                            <button type="submit" 
                                    disabled="@_isSaving"
                                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.01] active:scale-[0.99] disabled:opacity-60">
                                <span>Save Institute Profile</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            }

            <!-- 2. Academic Sessions Tab -->
            @if (_activeTab == "sessions")
            {
                <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
                        <div>
                            <h3 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <span>📅 Academic Sessions &amp; Term Management</span>
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Select current active academic year for student attendance, batches, exams, and fee schedules.
                            </p>
                        </div>

                        <button type="button" 
                                @onclick="ShowNewSessionDialog"
                                class="px-3.5 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm hover:opacity-95 transition-all flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            <span>Add Session</span>
                        </button>
                    </div>

                    <!-- Current Active Session Selector -->
                    <div class="p-4 rounded-xl bg-teal-50/50 dark:bg-[#131f24] border border-teal-200/70 dark:border-teal-800/60 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-[#004D40] dark:text-teal-300">Active Academic Session</span>
                            <span class="text-[10px] font-bold text-teal-600 dark:text-teal-400 bg-teal-100/70 dark:bg-teal-900/60 px-2 py-0.5 rounded-full">
                                Live In Production
                            </span>
                        </div>
                        <div class="max-w-md">
                            <CustomSelect Value="@_model.AcademicSession" 
                                          ValueChanged="OnAcademicSessionChanged" 
                                          Options="@_sessionOptions" 
                                          Placeholder="Select Active Session..." />
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">
                            Changing the active session shifts the default student enrollment registers, fee dues, and batch allocations.
                        </p>
                    </div>

                    <!-- Academic Sessions List / History -->
                    <div class="space-y-3">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Registered Sessions</span>
                        
                        @foreach (var s in _availableSessions)
                        {
                            var isActive = s.Code == _model.AcademicSession;
                            <div class="flex items-center justify-between p-4 rounded-xl border transition-all @(isActive ? "border-teal-300 dark:border-teal-700 bg-teal-50/30 dark:bg-teal-950/20 shadow-xs" : "border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-[#142025]")">
                                <div class="flex items-center gap-3.5">
                                    <div class="w-10 h-10 rounded-xl @(isActive ? "bg-gradient-to-tr from-[#004D40] to-[#009488] text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-500") flex items-center justify-center shrink-0 shadow-xs">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-slate-800 dark:text-white">@s.Name</span>
                                            @if (isActive)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Current Active
                                                </span>
                                            }
                                        </div>
                                        <p class="text-[11px] text-slate-400 mt-0.5 font-medium">Duration: @s.Period • Status: @s.Status</p>
                                    </div>
                                </div>

                                <div>
                                    @if (!isActive)
                                    {
                                        <button type="button" 
                                                @onclick="() => SetActiveSession(s.Code)"
                                                class="px-3 py-1.5 rounded-lg text-xs font-bold text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/60 border border-teal-200 dark:border-teal-800 transition-colors cursor-pointer">
                                            Switch To This
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Operational Rules -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#142025] border border-slate-200 dark:border-slate-800 grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Attendance Cut-off</label>
                            <input type="text" value="09:30 AM" readonly class="w-full px-3 py-2 text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Working Days / Week</label>
                            <input type="text" value="Monday – Saturday (6 Days)" readonly class="w-full px-3 py-2 text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Default Currency</label>
                            <input type="text" value="INR (₹) — Indian Rupee" readonly class="w-full px-3 py-2 text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300" />
                        </div>
                    </div>
                </div>
            }

            <!-- 3. Branding & Portal Tab -->
            @if (_activeTab == "branding")
            {
                <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
                    <div class="border-b border-slate-100 dark:border-slate-800 pb-4">
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            <span>🎨 Branding, Theme &amp; Custom Subdomain</span>
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            Configure your institute's visual identity, white-label subdomain, and invoice statements.
                        </p>
                    </div>

                    <!-- Theme & Template Color Picker -->
                    <div class="space-y-4 pt-2">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                            <div>
                                <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                                    <span>🎨 Interface Theme &amp; Template Colors</span>
                                </h4>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                    Select any template color palette below. The theme instantly updates your entire portal, top header, sidebar navigation, and primary buttons.
                                </p>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (_currentThemeId != "deep-teal")
                                {
                                    <button type="button" 
                                            @onclick="ResetThemeToDefaultAsync" 
                                            class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                        Reset to Deep Teal
                                    </button>
                                }
                                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full border bg-teal-50 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 border-teal-200 dark:border-teal-800">
                                    Active: @(_themeTemplates.FirstOrDefault(t => t.Id == _currentThemeId)?.Name ?? "Deep Teal")
                                </span>
                            </div>
                        </div>

                        <!-- 17 Template Colors Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
                            @foreach (var theme in _themeTemplates)
                            {
                                var isSelected = _currentThemeId == theme.Id;
                                <div @onclick="() => SwitchThemeAsync(theme.Id)"
                                     class="relative group rounded-2xl border transition-all duration-200 cursor-pointer overflow-hidden p-3.5 flex flex-col justify-between select-none @(isSelected ? "border-2 border-[#009488] dark:border-teal-400 ring-2 ring-[#009488]/20 shadow-md shadow-[#009488]/10 scale-[1.01] bg-white dark:bg-[#131f24]" : "border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 bg-slate-50/70 dark:bg-[#131f24]/50 hover:bg-white dark:hover:bg-[#18262c]")">
                                    
                                    <!-- Mini Layout Mockup Bar -->
                                    <div class="w-full h-11 rounded-xl overflow-hidden shadow-inner flex mb-3 border border-black/5 dark:border-white/5">
                                        <!-- Mini Sidebar -->
                                        <div class="w-1/4 h-full" style="background-color: @theme.HeaderHex;"></div>
                                        <!-- Mini Main Window -->
                                        <div class="flex-1 h-full flex flex-col" style="background-color: @theme.LightBgHex;">
                                            <!-- Mini Top Header -->
                                            <div class="w-full h-3.5" style="background-color: @theme.HeaderHex;"></div>
                                            <!-- Mini Content Area with Primary Button Dot -->
                                            <div class="flex-1 flex items-center justify-between px-2">
                                                <div class="w-6 h-1.5 rounded-full bg-slate-300/80"></div>
                                                <div class="w-3 h-3 rounded-full shadow-sm" style="background-color: @theme.PrimaryHex;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Theme Title & Category -->
                                    <div class="space-y-1 mb-3">
                                        <div class="flex items-center justify-between gap-1">
                                            <h5 class="text-xs font-bold text-slate-900 dark:text-white truncate">
                                                @theme.Name
                                            </h5>
                                            @if (isSelected)
                                            {
                                                <span class="shrink-0 flex items-center gap-1 text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded-md bg-emerald-500 text-white">
                                                    ✓ Active
                                                </span>
                                            }
                                        </div>
                                        <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">
                                            @theme.Category
                                        </p>
                                    </div>

                                    <!-- Color Swatches & Codes -->
                                    <div class="pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[10px] font-mono">
                                        <!-- Header Swatch -->
                                        <div class="flex items-center gap-1.5" title="Top Header & Sidebar Background">
                                            <span class="w-3.5 h-3.5 rounded-full border border-black/10 shrink-0 shadow-xs" style="background-color: @theme.HeaderHex;"></span>
                                            <span class="text-slate-600 dark:text-slate-400">@theme.HeaderHex</span>
                                        </div>
                                        <!-- Primary Accent Swatch -->
                                        <div class="flex items-center gap-1.5" title="Primary Buttons & Active Nav Items">
                                            <span class="w-3.5 h-3.5 rounded-full border border-black/10 shrink-0 shadow-xs" style="background-color: @theme.PrimaryHex;"></span>
                                            <span class="text-slate-600 dark:text-slate-400">@theme.PrimaryHex</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- All-in-One Live Theme & Component Testing Showcase -->
                    <div class="card-surface p-5 space-y-5 border border-slate-200 dark:border-slate-800">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800/80 pb-4">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="p-1.5 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-[#009488]">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                                        </svg>
                                    </span>
                                    <h4 class="text-sm font-extrabold text-slate-800 dark:text-white">
                                        Live Component &amp; Theme Test Bench
                                    </h4>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300">
                                        Active: @(_themeTemplates.FirstOrDefault(t => t.Id == _currentThemeId)?.Name ?? _currentThemeId)
                                    </span>
                                </div>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                    Select any theme above and test active inputs, caret glow, dropdowns, calendar, buttons, drawers &amp; modals in real time.
                                </p>
                            </div>

                            <!-- Live Controls (Dark Mode Toggle & Modal / Drawer Triggers) -->
                            <div class="flex items-center gap-2 flex-wrap">
                                <button type="button"
                                        @onclick="ToggleDarkModeAsync"
                                        class="px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#18262c] text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-[#20323a] transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                                    </svg>
                                    <span>Dark/Light Toggle</span>
                                </button>
                                <button type="button"
                                        @onclick="() => _showTestDrawer = true"
                                        class="px-3 py-1.5 rounded-xl text-xs font-bold bg-[#004D40] hover:bg-[#00382E] text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs">
                                    <span>Test Drawer</span>
                                </button>
                                <button type="button"
                                        @onclick="() => _showTestModal = true"
                                        class="px-3 py-1.5 rounded-xl text-xs font-bold bg-[#009488] hover:bg-[#00796b] text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs">
                                    <span>Test Modal</span>
                                </button>
                                <button type="button"
                                        @onclick='() => Toast.Theme($"Active theme: {_themeTemplates.FirstOrDefault(t => t.Id == _currentThemeId)?.Name ?? "Deep Teal"}. All alerts adapt to your selected color palette in real time!", "Theme Notification")'
                                        class="px-3 py-1.5 rounded-xl text-xs font-bold border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 text-[#00796b] dark:text-teal-300 hover:bg-teal-100 dark:hover:bg-teal-900/60 transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                                    <span>Test Alert</span>
                                </button>
                            </div>
                        </div>

                        <!-- 1. Form Inputs Row -->
                        <div class="space-y-2">
                            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                1. Form Inputs (Click to test Active Focus Glow &amp; Border)
                            </span>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <!-- Text Input -->
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                        Text Input (Active Glow Test)
                                    </label>
                                    <input type="text"
                                           @bind="_testTextInput"
                                           placeholder="Type here..."
                                           class="w-full px-3.5 py-2 text-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all shadow-2xs" />
                                </div>

                                <!-- Number Input -->
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                        Number Input
                                    </label>
                                    <input type="number"
                                           @bind="_testNumberInput"
                                           class="w-full px-3.5 py-2 text-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all shadow-2xs" />
                                </div>

                                <!-- Search Input with Icon -->
                                <div>
