                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                                Require an OTP authenticator app verification code on every login attempt.
                            </p>
                            <button type="button" @onclick="Enable2FaNotice" class="text-xs font-bold text-[#009488] hover:underline cursor-pointer">
                                Configure 2FA &rarr;
                            </button>
                        </div>

                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 space-y-2">
                            <div class="flex items-center justify-between">
