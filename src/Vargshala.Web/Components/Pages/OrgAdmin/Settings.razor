    <div class="fixed inset-y-0 right-0 max-w-md w-full bg-white dark:bg-[#111c21] shadow-2xl z-50 flex flex-col border-l border-slate-200 dark:border-slate-800 animate-drawer-slide">
        <!-- Drawer Header -->
        <div class="p-4 bg-gradient-to-r from-[#004D40] to-[#009488] text-white flex items-center justify-between shrink-0 shadow-md">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-white/10 backdrop-blur-xs flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </span>
                <div>
                    <h3 class="font-bold text-sm leading-tight">Theme Drawer Preview</h3>
                    <p class="text-[11px] text-teal-100/80">Header matches the active theme dynamically</p>
                </div>
            </div>
            <button type="button" @onclick="() => _showTestDrawer = false" class="text-white/80 hover:text-white p-1.5 rounded-lg hover:bg-white/10 cursor-pointer">
                ✕
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-5 space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Test Form Input</label>
                <input type="text" placeholder="Click to focus inside drawer..." class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:outline-none text-slate-900 dark:text-white" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Select Status</label>
                <CustomSelect Value="@_testSelectValue" ValueChanged="@((val) => _testSelectValue = val)" Options="_testSelectOptions" />
            </div>

            <div class="p-3 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-slate-800 dark:text-white">Active Status Switch</div>
                    <p class="text-[11px] text-slate-400">Toggle switch indicator</p>
                </div>
                <button type="button" 
                        role="switch" 
                        aria-checked="@_testDrawerSwitch"
                        @onclick="() => _testDrawerSwitch = !_testDrawerSwitch"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none @(_testDrawerSwitch ? "bg-[#009488]" : "bg-slate-300 dark:bg-slate-700")">
                    <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out @(_testDrawerSwitch ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-3 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex justify-end gap-2 shrink-0">
            <button type="button" @onclick="() => _showTestDrawer = false" class="btn-secondary text-xs">Close</button>
            <button type="button" @onclick="() => _showTestDrawer = false" class="btn-primary text-xs">Save Changes</button>
        </div>
    </div>
}

@if (_showTestModal)
{
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 animate-in fade-in duration-150" @onclick="() => _showTestModal = false">
        <div class="bg-white dark:bg-[#111c21] rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-200 dark:border-slate-800 animate-in zoom-in-95 duration-150" @onclick:stopPropagation="true">
            <div class="p-4 bg-gradient-to-r from-[#004D40] to-[#009488] text-white flex items-center justify-between shadow-md">
                <div class="flex items-center gap-2">
                    <h3 class="font-bold text-sm">Theme Modal Dialog Preview</h3>
                </div>
