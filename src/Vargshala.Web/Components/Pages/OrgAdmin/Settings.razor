                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">Active</span>
                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">
