                                Theme 4: Deep Teal (Default)
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-[#004D40] shrink-0 shadow-sm"></span>
                                <div>
                                    <p class="text-xs font-bold text-slate-800 dark:text-white">Deep Teal</p>
                                    <p class="text-[10px] text-slate-400 font-mono">#004D40</p>
                                </div>
                            </div>
                            <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-[#009488] shrink-0 shadow-sm"></span>
                                <div>
                                    <p class="text-xs font-bold text-slate-800 dark:text-white">Primary Teal</p>
                                    <p class="text-[10px] text-slate-400 font-mono">#009488</p>
                                </div>
                            </div>
                            <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-gradient-to-r from-[#004D40] to-[#00796b] shrink-0 shadow-sm"></span>
                                <div>
                                    <p class="text-xs font-bold text-slate-800 dark:text-white">Gradient Accent</p>
                                    <p class="text-[10px] text-slate-400 font-mono">#00796b</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Portal Subdomain -->
                    <div class="p-4 rounded-xl bg-slate-50/60 dark:bg-[#131f24] border border-slate-200 dark:border-slate-800 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800 dark:text-white">Student &amp; Parent Portal URL</span>
                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                SSL Active
                            </span>
                        </div>
                        <div class="flex items-center">
                            <span class="px-3.5 py-2.5 text-xs bg-slate-200/70 dark:bg-slate-700/60 border border-r-0 border-slate-300 dark:border-slate-700 rounded-l-xl text-slate-500 font-mono">https://</span>
                            <input type="text" value="@(_orgCode.ToLower()).vargshala.com" readonly class="flex-1 px-3.5 py-2.5 text-xs font-mono font-bold bg-white dark:bg-[#18262c] border border-slate-300 dark:border-slate-700 text-[#00796b] dark:text-teal-300 focus:outline-none select-all" />
                            <button type="button" @onclick="CopySubdomain" class="px-3.5 py-2.5 text-xs font-bold bg-[#004D40] hover:bg-[#00382E] text-white rounded-r-xl border border-l-0 border-[#004D40] transition-colors cursor-pointer">
                                Copy
                            </button>
