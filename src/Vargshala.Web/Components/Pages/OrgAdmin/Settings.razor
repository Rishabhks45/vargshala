                            </p>
                            <span class="text-[10px] text-slate-400">Browser: Current Device • IP: 127.0.0.1</span>
                        </div>
                    </div>
                </div>
            }

            <!-- 5. Notifications & Alerts Tab -->
            @if (_activeTab == "notifications")
            {
