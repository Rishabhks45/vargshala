                                           placeholder="e.g. 42 Knowledge Park, Main Ring Road" 
                                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
