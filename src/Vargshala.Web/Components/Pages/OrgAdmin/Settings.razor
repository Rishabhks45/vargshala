                            <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Attendance Cut-off</label>
                            <input type="text" value="09:30 AM" readonly class="w-full px-3 py-2 text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300" />
