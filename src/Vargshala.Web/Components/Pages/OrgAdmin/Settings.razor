@page "/settings"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Organizations
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Web.Services
@inject IInstituteService InstituteService
@inject INotificationService Toast
@inject AuthenticationStateProvider AuthStateProvider
@inject IFileUploadService FileUploadService
@rendermode InteractiveServer

<PageTitle>Settings | Vargshala</PageTitle>

<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-5 transition-colors duration-200 pb-20">

    <!-- Top Breadcrumb & Actions Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shadow-[#004D40]/20 shrink-0">
                <svg class="w-5 h-5 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Settings &amp; Preferences
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage institute profile, academic sessions, white-label branding, security and communication preferences.
                </p>
            </div>
        </div>

        <!-- Header Actions -->
        <div class="flex items-center gap-2.5 shrink-0">
            <button type="button" 
                    @onclick="ResetForm"
                    disabled="@_isSaving"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5 disabled:opacity-50">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Reset</span>
            </button>

            <button type="button" 
                    @onclick="SaveSettingsAsync"
                    disabled="@_isSaving"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.01] active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed">
                @if (_isSaving)
                {
                    <svg class="animate-spin -ml-0.5 mr-1 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Saving...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Save Changes</span>
                }
            </button>
        </div>
    </div>

    <!-- Institute Hero Overview Banner (Theme 4 Deep Teal Gradient) -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#004D40] via-[#00695C] to-[#009488] text-white p-5 shadow-lg shadow-[#004D40]/15">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute right-20 top-2 w-32 h-32 bg-teal-300/10 rounded-full blur-xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <!-- Avatar / Logo -->
                <div class="relative w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-sm border-2 border-white/20 flex items-center justify-center shrink-0 shadow-inner overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(_model.LogoUrl))
                    {
                        <img src="@_model.LogoUrl" alt="Logo" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="text-lg font-black tracking-wider text-teal-100">
                            @(GetInitials(_model.Name))
                        </span>
                    }
                </div>

                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-base font-extrabold tracking-tight text-white">
                            @(string.IsNullOrWhiteSpace(_model.Name) ? "Institute Profile" : _model.Name)
                        </h2>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/20 text-white backdrop-blur-xs border border-white/30">
                            @(_orgCode)
                        </span>
                        @if (_model.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-400/20 text-emerald-200 border border-emerald-300/30">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span> Active
                            </span>
                        }
                    </div>
                    <p class="text-xs text-teal-100/80 mt-0.5 font-medium flex items-center gap-3 flex-wrap">
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            @(string.IsNullOrWhiteSpace(_model.City) ? "India" : $"{_model.City}, {_model.State}")
                        </span>
                        <span class="text-teal-300/50">•</span>
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            Session: @(string.IsNullOrWhiteSpace(_model.AcademicSession) ? "2026-2027" : _model.AcademicSession)
                        </span>
                        <span class="text-teal-300/50">•</span>
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            Enterprise SaaS Plan
                        </span>
                    </p>
                </div>
            </div>

            <!-- Quick Sync Timestamp Pill -->
            <div class="flex items-center gap-2 self-start md:self-auto bg-black/15 backdrop-blur-sm px-3 py-1.5 rounded-xl border border-white/10 text-[11px] text-teal-100">
                <svg class="w-3.5 h-3.5 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Synced: @_lastSavedText</span>
            </div>
        </div>
    </div>

    <!-- Main Segmented Settings Layout (Left Nav + Right Content) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- Left Navigation Sidebar (Pills with icons) -->
        <div class="lg:col-span-3 bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-2 shadow-xs space-y-1">
            <button type="button" 
                    @onclick='() => _activeTab = "profile"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "profile" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "profile" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span>Institute Profile</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "sessions"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "sessions" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "sessions" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Academic Sessions</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "branding"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "branding" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "branding" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                    <span>Branding &amp; Portal</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "security"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "security" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "security" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <span>Security &amp; Passwords</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "notifications"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "notifications" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "notifications" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span>Notifications &amp; Alerts</span>
                </div>
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button type="button" 
                    @onclick='() => _activeTab = "subscription"'
                    class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_activeTab == "subscription" ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white")">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 @(_activeTab == "subscription" ? "text-teal-200" : "text-slate-400 dark:text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span>Subscription &amp; Quotas</span>
                </div>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-teal-100 dark:bg-teal-900/60 text-[#004D40] dark:text-teal-300">PRO</span>
            </button>
        </div>

        <!-- Right Main Panel Content -->
        <div class="lg:col-span-9 space-y-5">

            <!-- 1. Institute Profile Tab -->
            @if (_activeTab == "profile")
            {
                <EditForm Model="_model" OnValidSubmit="SaveSettingsAsync">
                    <FluentValidationValidator />

                    <div class="bg-white dark:bg-[#18262c] rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
                            <div>
                                <h3 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                    <span>🏛️ General Institute Information</span>
                                </h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                    Update official school/institute profile shown on parent portal and invoices.
                                </p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-[#00796b] dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                                Tenant ID: @_model.Id.ToString().Substring(0, 8)...
                            </span>
                        </div>

                        <!-- Logo & Identity Section -->
                        <div class="flex flex-col sm:flex-row sm:items-center gap-5 p-4 rounded-xl bg-slate-50/70 dark:bg-[#131f24] border border-slate-100 dark:border-slate-800">
                            <div class="relative w-20 h-20 rounded-2xl bg-white dark:bg-[#18262c] border-2 border-dashed border-teal-400/50 dark:border-teal-700/50 flex items-center justify-center shrink-0 shadow-xs overflow-hidden group">
                                @if (!string.IsNullOrWhiteSpace(_model.LogoUrl))
                                {
                                    <img src="@_model.LogoUrl" alt="Institute Logo" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="text-center p-2">
                                        <svg class="w-6 h-6 text-[#009488] mx-auto mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        <span class="text-[9px] font-bold text-[#009488]">No Logo</span>
                                    </div>
                                }
                            </div>
                            <div class="flex-1 space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Logo Image URL or Local File</label>
                                    <label class="cursor-pointer inline-flex items-center gap-1 text-[11px] font-bold text-[#009488] hover:text-[#00796b] hover:underline">
                                        <InputFile OnChange="HandleLogoFileSelected" class="hidden" accept=".png,.jpg,.jpeg,.svg" />
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                        <span>Browse File...</span>
                                    </label>
                                </div>
                                <div class="relative">
                                    <InputText @bind-Value="_model.LogoUrl" 
                                               placeholder="https://cdn.example.com/logo.png or choose local file" 
                                               class="w-full px-3.5 py-2 text-xs bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-500">
                                    Supported: PNG, JPG, SVG up to 2MB. Validated via FileUploadService.
                                </p>
                            </div>
                        </div>

                        <!-- Core Fields Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Institute Name -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
                                    <span>Institute Name <span class="text-rose-500">*</span></span>
                                </label>
                                <InputText @bind-Value="_model.Name" 
                                           placeholder="e.g. Apex Science &amp; Commerce Academy" 
                                           class="w-full px-3.5 py-2.5 text-xs font-semibold bg-slate-50/50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                                <ValidationMessage For="@(() => _model.Name)" class="text-rose-500 text-[10px] font-medium" />
                            </div>

                            <!-- Institute Code (Immutable) -->
                            <div class="space-y-1">
                                <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
                                    <span>Institute Code (Tenant Slug)</span>
                                    <span class="text-[10px] text-slate-400 font-normal">System-assigned</span>
                                </label>
                                <div class="relative flex items-center">
                                    <input type="text" readonly value="@_orgCode" 
                                           class="w-full px-3.5 py-2.5 text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-600 dark:text-slate-300 cursor-not-allowed select-all" />
                                    <span class="absolute right-3 text-slate-400">
