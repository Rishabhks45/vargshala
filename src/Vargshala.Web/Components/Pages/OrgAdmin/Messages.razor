@page "/messages"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin,Teacher,BranchAdmin,Student")]
@using System.Security.Claims
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Messages
@using Vargshala.SharedKernel.Enums
@using Vargshala.Web.Services
@inject IMessageService MessageService
@inject IChatHubService ChatHubService
@inject INotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Messages | Vargshala</PageTitle>

<!-- Full-Height Modern Messaging Hub Container (Matching Exact Design) -->
<div class="h-[calc(100vh-5.5rem)] max-h-[calc(100vh-5.5rem)] rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-sm flex overflow-hidden select-none transition-colors duration-200">

    <!-- ========================================================================= -->
    <!-- 1. LEFT PANEL: Conversations Sidebar -->
    <!-- ========================================================================= -->
    <div class="w-80 lg:w-88 shrink-0 h-full flex flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111c21]">
        
        <!-- Sidebar Header -->
        <div class="p-4 border-b border-slate-100 dark:border-slate-800/80 space-y-3 shrink-0">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-lg font-black text-slate-900 dark:text-white tracking-tight">
                        Messages
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                        Stay connected with your students, teachers and staff
                    </p>
                </div>

                <button type="button" 
                        @onclick="OpenCreateModal" 
                        class="p-2 rounded-xl bg-[#00796b] hover:bg-[#004D40] text-white shadow-xs transition-all cursor-pointer"
                        title="New Conversation / Group">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </button>
            </div>

            <!-- Filter Category Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 select-none scroll-smooth">
                <button type="button" 
                        @onclick='() => _activeCategory = "All"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "All" ? "bg-[#00796b] text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    All
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Groups"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Groups" ? "bg-[#00796b] text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    Groups
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Announcements"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Announcements" ? "bg-[#00796b] text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    Announcements
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Unread"'
                        class="flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Unread" ? "bg-[#00796b] text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    <span>Unread</span>
                    @if (UnreadConversationsCount > 0)
                    {
                        <span class="px-1.5 py-0.2 text-[10px] rounded-full leading-none font-bold @(_activeCategory == "Unread" ? "bg-white text-[#00796b]" : "bg-[#00796b] text-white")">
                            @UnreadConversationsCount
                        </span>
                    }
                </button>
            </div>
        </div>

        <!-- Conversations Scrollable Feed -->
        <div class="flex-1 min-h-0 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60">
            @if (_isLoadingConversations && !_conversations.Any())
            {
                <SkeletonConversations Count="6" />
            }
            else if (FilteredConversations.Any())
            {
                @foreach (var conv in FilteredConversations)
                {
                    var isSelected = conv.Id == _selectedConversation?.Id;
                    <div @onclick="() => SelectConversationAsync(conv)"
                         class="px-4 py-3 flex items-center gap-3 cursor-pointer transition-colors @(isSelected ? "bg-teal-50/70 dark:bg-teal-950/30 border-l-4 border-l-[#00796b]" : "hover:bg-slate-50 dark:hover:bg-slate-800/40")">
                        
                        <!-- Avatar -->
                        <div class="relative shrink-0">
                            @if (conv.IsAnnouncement)
                            {
                                <div class="w-11 h-11 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                                    </svg>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(conv.AvatarUrl))
                            {
                                <img src="@conv.AvatarUrl" alt="@conv.Name" class="w-11 h-11 rounded-full object-cover border border-slate-200 dark:border-slate-700 shadow-xs" />
                            }
                            else if (conv.Type == ConversationType.Direct)
                            {
                                <div class="w-11 h-11 rounded-full bg-teal-100 dark:bg-teal-950 text-teal-800 dark:text-teal-200 font-bold text-sm flex items-center justify-center border border-teal-200 dark:border-teal-800">
                                    @conv.Initials
                                </div>
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-full bg-teal-50 dark:bg-teal-950/50 text-[#00796b] dark:text-teal-300 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-3-3.87 4.004 4.004 0 013 4.87zM4 15a4 4 0 003-3.87A4.004 4.004 0 004 16v-1z" />
                                    </svg>
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-1">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-white truncate">
                                    @conv.Name
                                </h3>
                                <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium shrink-0">@conv.LastMessageTime</span>
                            </div>

                            <div class="flex items-center justify-between gap-2 mt-0.5">
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate leading-tight">
                                    @(string.IsNullOrWhiteSpace(conv.LastMessage) ? "No messages yet" : conv.LastMessage)
                                </p>

                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="w-4.5 h-4.5 rounded-full bg-[#00796b] text-white text-[10px] font-bold flex items-center justify-center shrink-0">
                                        @conv.UnreadCount
                                    </span>
                                }
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="p-8 text-center text-slate-400 space-y-2">
                    <p class="text-xs font-medium">No conversations found</p>
                    <button type="button" @onclick="OpenCreateModal" class="px-3 py-1.5 rounded-lg bg-teal-50 text-[#00796b] font-bold text-xs hover:bg-teal-100 transition-colors">
                        + Start Conversation
                    </button>
                </div>
            }
        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 2. MIDDLE PANEL: Active Chat Window -->
    <!-- ========================================================================= -->
    <div class="flex-1 min-w-0 h-full flex flex-col bg-[#F9FBFA] dark:bg-[#0c1417]">
        
        @if (_selectedConversation != null)
        {
            <!-- Chat Header -->
            <div class="px-5 py-3.5 bg-white dark:bg-[#111c21] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3 shrink-0 shadow-2xs">
                <button type="button" 
                        @onclick="() => _showRightPanel = !_showRightPanel"
                        class="flex items-center gap-3 min-w-0 text-left cursor-pointer group/header focus:outline-none"
                        title="Click to view @(_selectedConversation.Type == ConversationType.Direct ? "contact" : "group") info">
                    <div class="w-10 h-10 rounded-full bg-[#004D40] text-teal-300 font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-xs ring-2 ring-transparent group-hover/header:ring-[#00796b]/60 transition-all">
                        @if (!string.IsNullOrWhiteSpace(_selectedConversation.AvatarUrl))
                        {
                            <img src="@_selectedConversation.AvatarUrl" class="w-full h-full object-cover" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_selectedConversation.Initials))
                        {
                            <span>@_selectedConversation.Initials</span>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-3-3.87 4.004 4.004 0 013 4.87zM4 15a4 4 0 003-3.87A4.004 4.004 0 004 16v-1z" />
                            </svg>
                        }
                    </div>

                    <div class="min-w-0">
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white truncate group-hover/header:text-[#00796b] dark:group-hover/header:text-teal-400 transition-colors">
                            @_selectedConversation.Name
                        </h2>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium truncate">
                            @_selectedConversation.MemberCount members | @_selectedConversation.Type
                        </p>
                    </div>
                </button>

                <!-- Right Header Actions (Search, Call, Video, Three Dots) -->
                <div class="flex items-center gap-1.5 shrink-0 text-slate-600 dark:text-slate-300">
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Search">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </button>
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Voice Call">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                    </button>
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Video Call">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                    </button>
                    <button type="button" 
                            @onclick="() => _showRightPanel = !_showRightPanel"
                            class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
                            title="Group Info">
                        <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Messages Stream -->
            <div id="messages-stream" class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 space-y-2 select-text scroll-smooth">
                
                @if (_isLoadingMessages && !_currentMessages.Any())
                {
                    <SkeletonMessages Count="4" />
                }
                else if (_currentMessages.Any())
                {
                    <!-- Date Separator Pill -->
                    <div class="flex items-center justify-center my-1">
                        <span class="px-3.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                            @(_currentMessages.First().SentAt.ToString("MMM dd, yyyy"))
                        </span>
                    </div>

                    @foreach (var msg in _currentMessages)
                    {
                        @if (msg.MessageType == MessageType.System)
                        {
                            <!-- System Event Notice (Centered Card) -->
                            <div class="max-w-md mx-auto p-2.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/80 text-center text-xs text-slate-600 dark:text-slate-300">
                                <p class="font-medium">@msg.Content</p>
                                <span class="text-[10px] text-slate-400">@msg.SentAt.ToString("hh:mm tt")</span>
                            </div>
                        }
                        else if (msg.IsOutgoing)
                        {
                            <!-- OUTGOING MESSAGE (Right Aligned, Mint Green Bubble) -->
                            <div class="flex flex-col items-end">
                                <div class="relative group/msg w-fit max-w-lg">
                                    <!-- Floating Quick Reactions Bar (on hover of message bubble) -->
                                    <div class="opacity-0 pointer-events-none group-hover/msg:pointer-events-auto group-hover/msg:opacity-100 transition-opacity duration-150 absolute -top-3.5 right-2 z-20 flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-white dark:bg-[#18262c] shadow-md border border-slate-200 dark:border-slate-700 text-sm">
                                        @foreach (var qe in EmojiHelper.QuickReactions)
                                        {
                                            <button type="button" 
                                                    @onclick="() => ToggleReaction(msg, qe)" 
                                                    class="hover:scale-130 transition-transform p-1 cursor-pointer" 
                                                    title="@qe">
                                                @qe
                                            </button>
                                        }
                                        <button type="button" 
                                                @onclick="() => OpenReactionPicker(msg.Id)" 
                                                class="w-5 h-5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 font-bold text-xs ml-0.5 cursor-pointer" 
                                                title="More Reactions">
                                            +
                                        </button>
                                    </div>

                                    <!-- Reaction Picker Popup for this message -->
                                    @if (_reactionPickerMessageId == msg.Id)
                                    {
                                        <!-- Backdrop: Click outside to close reaction picker -->
                                        <div class="fixed inset-0 z-20" 
                                             style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 20;" 
                                             @onclick="() => _reactionPickerMessageId = null"></div>

                                        <div class="absolute -top-72 right-0 z-30 w-72 sm:w-80 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden text-xs">
                                            <div class="p-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                                <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                                    @foreach (var cat in EmojiHelper.Categories)
                                                    {
                                                        <button type="button" 
                                                                @onclick="() => _activeEmojiCategory = cat.Key"
                                                                class="px-2 py-0.5 rounded text-xs cursor-pointer @(_activeEmojiCategory == cat.Key ? "bg-teal-50 dark:bg-teal-950 text-[#00796b]" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
                                                            @cat.Icon
                                                        </button>
                                                    }
                                                </div>
                                                <button type="button" @onclick="() => _reactionPickerMessageId = null" class="text-slate-400 hover:text-slate-600 cursor-pointer text-xs font-bold">✕</button>
                                            </div>
                                            <div class="p-2 max-h-52 overflow-y-auto grid grid-cols-8 gap-1 text-base">
                                                @foreach (var emoji in FilteredEmojis)
                                                {
                                                    <button type="button" 
                                                            @onclick="() => ToggleReaction(msg, emoji)"
                                                            class="w-7 h-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                                            title="@emoji">
                                                        @emoji
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="rounded-2xl rounded-tr-xs bg-[#E8F8F0] dark:bg-[#16382f] px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 shadow-2xs border border-[#d2f0e0] dark:border-teal-900/40">
                                        @if (!string.IsNullOrWhiteSpace(msg.AttachmentName))
                                        {
                                            <div class="flex items-center justify-between gap-3 p-2 bg-white dark:bg-[#102922] rounded-xl border border-teal-100 dark:border-teal-800 mb-1">
                                                <div class="flex items-center gap-2.5 min-w-0">
                                                    <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-extrabold text-[10px] flex items-center justify-center shrink-0">
                                                        FILE
                                                    </div>
                                                    <div class="min-w-0">
                                                        <p class="font-bold text-slate-900 dark:text-white truncate text-xs">@msg.AttachmentName</p>
                                                        <span class="text-[10.5px] text-slate-400">@(msg.AttachmentSize ?? "Attachment")</span>
                                                    </div>
                                                </div>
                                                <a href="@msg.AttachmentUrl" target="_blank" download class="p-1.5 text-slate-500 hover:text-slate-700 dark:text-slate-300">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                    </svg>
                                                </a>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(msg.Content))
                                        {
                                            <div class="leading-normal whitespace-pre-wrap font-normal break-words">
                                                <span>@msg.Content</span>
                                                <span class="inline-flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-400 font-medium float-right ml-2.5 mt-0.5 select-none shrink-0">
                                                    <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                    @if (msg.IsRead)
                                                    {
                                                        <!-- Double Tick (Read) -->
                                                        <span title="Read" class="inline-flex items-center text-[#009488] dark:text-teal-400">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M18 6L7 17l-5-5"/>
                                                                <path d="M22 10l-7.5 7.5-1.5-1.5"/>
                                                            </svg>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <!-- Single Tick (Sent) -->
                                                        <span title="Sent" class="inline-flex items-center text-slate-400 dark:text-slate-500">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M20 6L9 17l-5-5"/>
                                                            </svg>
                                                        </span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center justify-end gap-1 text-[10px] text-slate-400 font-medium mt-0.5">
                                                <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                @if (msg.IsRead)
                                                {
                                                    <span title="Read" class="inline-flex items-center text-[#009488] dark:text-teal-400">
                                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M18 6L7 17l-5-5"/>
                                                            <path d="M22 10l-7.5 7.5-1.5-1.5"/>
                                                        </svg>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span title="Sent" class="inline-flex items-center text-slate-400 dark:text-slate-500">
                                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M20 6L9 17l-5-5"/>
                                                        </svg>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Reactions Badges -->
                                @if (msg.Reactions.Any())
                                {
                                    <div class="flex flex-wrap gap-1 mt-1 justify-end">
                                        @foreach (var kv in msg.Reactions)
                                        {
                                            var isMyReaction = _myReactions.TryGetValue(msg.Id, out var myEmoji) && myEmoji == kv.Key;
                                            <button type="button" 
                                                    @onclick="() => ToggleReaction(msg, kv.Key)"
                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs transition-colors cursor-pointer @(isMyReaction ? "bg-teal-50 dark:bg-teal-950/80 border border-[#00796b] text-[#00796b] font-bold shadow-2xs" : "bg-white dark:bg-[#18262c] hover:bg-teal-50 dark:hover:bg-teal-950 border border-slate-200 dark:border-slate-700 hover:border-[#00796b] shadow-2xs text-slate-700 dark:text-slate-300")"
                                                    title="@(isMyReaction ? "Remove reaction" : "React with " + kv.Key)">
                                                <span>@kv.Key</span>
                                                @if (kv.Value > 1)
                                                {
                                                    <span class="text-[10px] font-bold @(isMyReaction ? "text-[#00796b] dark:text-teal-400" : "text-slate-600 dark:text-slate-300")">@kv.Value</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- INCOMING MESSAGE (Left Aligned, White Bubble) -->
                            <div class="flex items-start gap-2.5">
                                <button type="button" 
                                        @onclick="() => _showRightPanel = true"
                                        class="w-8 h-8 rounded-full overflow-hidden shrink-0 mt-0.5 border border-slate-200 cursor-pointer hover:opacity-80 hover:ring-2 hover:ring-[#00796b] transition-all"
                                        title="View info for @msg.SenderName">
                                    @if (!string.IsNullOrWhiteSpace(msg.SenderAvatarUrl))
                                    {
                                        <img src="@msg.SenderAvatarUrl" alt="@msg.SenderName" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-teal-100 dark:bg-teal-950 text-teal-800 dark:text-teal-200 font-bold text-xs flex items-center justify-center">
                                            @msg.SenderInitials
                                        </div>
                                    }
                                </button>

                                <div class="space-y-1">
                                    <button type="button" 
                                            @onclick="() => _showRightPanel = true"
                                            class="text-[11px] font-bold text-[#00796b] dark:text-teal-400 ml-1 block text-left cursor-pointer hover:underline"
                                            title="View info for @msg.SenderName">
                                        @msg.SenderName
                                    </button>

                                    <div class="relative group/msg w-fit max-w-lg">
                                        <!-- Floating Quick Reactions Bar (on hover of message bubble) -->
                                        <div class="opacity-0 pointer-events-none group-hover/msg:pointer-events-auto group-hover/msg:opacity-100 transition-opacity duration-150 absolute -top-3.5 left-2 z-20 flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-white dark:bg-[#18262c] shadow-md border border-slate-200 dark:border-slate-700 text-sm">
                                            @foreach (var qe in EmojiHelper.QuickReactions)
                                            {
                                                <button type="button" 
                                                        @onclick="() => ToggleReaction(msg, qe)" 
                                                        class="hover:scale-130 transition-transform p-1 cursor-pointer" 
                                                        title="@qe">
                                                    @qe
                                                </button>
                                            }
                                            <button type="button" 
                                                    @onclick="() => OpenReactionPicker(msg.Id)" 
                                                    class="w-5 h-5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 font-bold text-xs ml-0.5 cursor-pointer" 
                                                    title="More Reactions">
                                                +
                                            </button>
                                        </div>

                                        <!-- Reaction Picker Popup for this message -->
                                        @if (_reactionPickerMessageId == msg.Id)
                                        {
                                            <!-- Backdrop: Click outside to close reaction picker -->
                                            <div class="fixed inset-0 z-20" 
                                                 style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 20;" 
                                                 @onclick="() => _reactionPickerMessageId = null"></div>

                                            <div class="absolute -top-72 left-0 z-30 w-72 sm:w-80 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden text-xs">
                                                <div class="p-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                                    <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                                        @foreach (var cat in EmojiHelper.Categories)
                                                        {
                                                            <button type="button" 
                                                                    @onclick="() => _activeEmojiCategory = cat.Key"
                                                                    class="px-2 py-0.5 rounded text-xs cursor-pointer @(_activeEmojiCategory == cat.Key ? "bg-teal-50 dark:bg-teal-950 text-[#00796b]" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
                                                                @cat.Icon
                                                            </button>
                                                        }
                                                    </div>
                                                    <button type="button" @onclick="() => _reactionPickerMessageId = null" class="text-slate-400 hover:text-slate-600 cursor-pointer text-xs font-bold">✕</button>
                                                </div>
                                                <div class="p-2 max-h-52 overflow-y-auto grid grid-cols-8 gap-1 text-base">
                                                    @foreach (var emoji in FilteredEmojis)
                                                    {
                                                        <button type="button" 
                                                                @onclick="() => ToggleReaction(msg, emoji)"
                                                                class="w-7 h-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                                                title="@emoji">
                                                            @emoji
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <div class="rounded-2xl rounded-tl-xs bg-white dark:bg-[#18262c] px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 shadow-2xs border border-slate-200 dark:border-slate-800">
                                            @if (!string.IsNullOrWhiteSpace(msg.AttachmentName))
                                            {
                                                <div class="flex items-center justify-between gap-3 p-2 bg-slate-50 dark:bg-[#121e23] rounded-xl border border-slate-200 dark:border-slate-700 mb-1">
                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                        <div class="w-8 h-8 rounded-lg bg-rose-600 text-white font-extrabold text-[10px] flex items-center justify-center shrink-0">
                                                            PDF
                                                        </div>
                                                        <div class="min-w-0">
                                                            <p class="font-bold text-slate-900 dark:text-white truncate text-xs">@msg.AttachmentName</p>
                                                            <span class="text-[10.5px] text-slate-400">@(msg.AttachmentSize ?? "PDF")</span>
                                                        </div>
                                                    </div>
                                                    <a href="@msg.AttachmentUrl" target="_blank" download class="p-1.5 text-slate-500 hover:text-slate-700 dark:text-slate-300">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                        </svg>
                                                    </a>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(msg.Content))
                                            {
                                                <div class="leading-normal whitespace-pre-wrap font-normal break-words">
                                                    <span>@msg.Content</span>
                                                    <span class="inline-flex items-center text-[10px] text-slate-400 dark:text-slate-400 font-medium float-right ml-2.5 mt-0.5 select-none shrink-0">
                                                        <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="flex items-center justify-end text-[10px] text-slate-400 font-medium mt-0.5">
                                                    <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Reactions Badges -->
                                    @if (msg.Reactions.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mt-1 justify-start">
                                            @foreach (var kv in msg.Reactions)
                                            {
                                                var isMyReaction = _myReactions.TryGetValue(msg.Id, out var myEmoji) && myEmoji == kv.Key;
                                                <button type="button" 
                                                        @onclick="() => ToggleReaction(msg, kv.Key)"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs transition-colors cursor-pointer @(isMyReaction ? "bg-teal-50 dark:bg-teal-950/80 border border-[#00796b] text-[#00796b] font-bold shadow-2xs" : "bg-white dark:bg-[#18262c] hover:bg-teal-50 dark:hover:bg-teal-950 border border-slate-200 dark:border-slate-700 hover:border-[#00796b] shadow-2xs text-slate-700 dark:text-slate-300")"
                                                        title="@(isMyReaction ? "Remove reaction" : "React with " + kv.Key)">
                                                    <span>@kv.Key</span>
                                                    @if (kv.Value > 1)
                                                    {
                                                        <span class="text-[10px] font-bold @(isMyReaction ? "text-[#00796b] dark:text-teal-400" : "text-slate-600 dark:text-slate-300")">@kv.Value</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="p-8 text-center text-slate-400 space-y-1">
                        <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No messages yet</p>
                        <p class="text-xs">Send a message below to start the conversation.</p>
                    </div>
                }

                @if (ActiveTypingUsers.Any())
                {
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-50/90 dark:bg-teal-950/60 border border-teal-200/60 dark:border-teal-800/60 w-fit text-xs text-[#00796b] dark:text-teal-300 font-medium transition-all shadow-2xs">
                        <div class="flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00796b] dark:bg-teal-400 animate-bounce" style="animation-delay: 0ms"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00796b] dark:bg-teal-400 animate-bounce" style="animation-delay: 150ms"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00796b] dark:bg-teal-400 animate-bounce" style="animation-delay: 300ms"></span>
                        </div>
                        <span>@GetTypingText()</span>
                    </div>
                }

            </div>

            <!-- Chat Composer Bar (Matching Exact Unified Input Style) -->
            <div class="px-4 py-3 bg-white dark:bg-[#111c21] border-t border-slate-200 dark:border-slate-800 shrink-0 relative">
                
                <!-- Full Emoji Picker Popover for Input -->
                @if (_showInputEmojiPicker)
                {
                    <!-- Backdrop: Click outside to close emoji picker -->
                    <div class="fixed inset-0 z-40" 
                         style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" 
                         @onclick="() => _showInputEmojiPicker = false"></div>

                    <div class="absolute bottom-16 right-4 z-50 w-80 sm:w-96 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden animate-in fade-in duration-150">
                        <div class="p-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                @foreach (var cat in EmojiHelper.Categories)
                                {
                                    <button type="button" 
                                            @onclick="() => _activeEmojiCategory = cat.Key"
                                            class="px-2 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors @(_activeEmojiCategory == cat.Key ? "bg-teal-50 dark:bg-teal-950 text-[#00796b] dark:text-teal-300 font-bold" : "text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")"
                                            title="@cat.Title">
                                        <span>@cat.Icon</span>
                                    </button>
                                }
                            </div>
                            <button type="button" @onclick="() => _showInputEmojiPicker = false" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs font-bold cursor-pointer">
                                ✕
                            </button>
                        </div>

                        <div class="p-2 border-b border-slate-100 dark:border-slate-800">
                            <input type="text" 
                                   @bind="_emojiSearchTerm" 
                                   @bind:event="oninput" 
                                   placeholder="Search emojis..." 
                                   class="w-full px-3 py-1.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-[#00796b] text-slate-900 dark:text-white placeholder-slate-400" />
                        </div>

                        <div class="p-2 max-h-56 overflow-y-auto grid grid-cols-8 gap-1 text-lg select-none">
                            @foreach (var emoji in FilteredEmojis)
                            {
                                <button type="button" 
                                        @onclick="() => InsertEmojiIntoInput(emoji)"
                                        class="w-8 h-8 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                        title="@emoji">
                                    @emoji
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Unified Input Card (Textarea + Action Icons + Send) -->
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-white dark:bg-[#18262c] border border-slate-300 dark:border-slate-700 shadow-2xs transition-all focus-within:border-[#00796b] focus-within:border-b-2 focus-within:border-b-[#00796b]">
                    
                    <!-- Auto-Growing Textarea (Shift + Enter for new line, Enter to send) -->
                    <textarea id="chat-composer-textarea"
                              rows="1"
                              value="@_messageInput"
                              @oninput="HandleInput"
                              disabled="@_isSending"
                              placeholder="Type a message"
                              class="flex-1 min-w-0 bg-transparent border-0 focus:outline-none focus:ring-0 p-0 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 resize-none max-h-40 overflow-y-auto leading-normal"
                              style="min-height: 24px; height: 24px;"></textarea>

                    <!-- Right-Side Action Icons Strip (Only Upload & Emoji) -->
                    <div class="flex items-center gap-1 sm:gap-1.5 text-slate-500 dark:text-slate-300 shrink-0 select-none">
                        
                        <!-- 1. Attachment / Upload Paperclip Icon -->
                        <button type="button" 
                                class="p-1 hover:text-[#00796b] dark:hover:text-teal-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors cursor-pointer" 
                                title="Attach File">
                            <svg class="w-5 h-5 shrink-0" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                            </svg>
                        </button>

                        <!-- 2. Emoji Smiley Icon -->
                        <button type="button" 
                                @onclick="ToggleInputEmojiPicker" 
                                class="p-1 hover:text-[#00796b] dark:hover:text-teal-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors cursor-pointer @(_showInputEmojiPicker ? "text-[#00796b] dark:text-teal-400" : "")" 
                                title="Choose Emoji">
                            <svg class="w-5 h-5 shrink-0" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </button>

                        <!-- Vertical Divider Separator -->
                        <div class="h-5 w-[1px] bg-slate-300 dark:bg-slate-600 mx-0.5 shrink-0"></div>

                        <!-- 3. Send Button (Paper Plane Outline) -->
                        <button type="button" 
                                id="chat-send-btn"
                                @onclick="SendMessageAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_messageInput) || _isSending)"
                                class="p-1 transition-all cursor-pointer @(string.IsNullOrWhiteSpace(_messageInput) || _isSending ? "text-slate-400 dark:text-slate-500 cursor-not-allowed opacity-60" : "text-[#00796b] dark:text-teal-400 hover:text-[#004D40] hover:scale-110")"
                                title="Send (Enter)">
                            @if (_isSending)
                            {
                                <div class="w-4 h-4 border-2 border-[#00796b] border-t-transparent rounded-full animate-spin"></div>
                            }
                            else
                            {
                                <svg class="w-5 h-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                </svg>
                            }
                        </button>
                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400">
                <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mb-3">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <p class="text-sm font-bold text-slate-700 dark:text-slate-300">Select a conversation to start messaging</p>
                <p class="text-xs text-slate-500 mt-1">Choose an existing conversation or create a new group.</p>
            </div>
        }

    </div>

    <!-- ========================================================================= -->
    <!-- 3. RIGHT PANEL: Group Info / Details Sidebar (Matching Exact Design) -->
    <!-- ========================================================================= -->
    @if (_selectedConversation != null && _showRightPanel)
    {
        <div class="w-80 lg:w-84 shrink-0 h-full border-l border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111c21] flex flex-col overflow-y-auto">
            
            <div class="p-3.5 border-b border-slate-100 dark:border-slate-800/80">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input type="text" 
                           placeholder="Search messages, people or groups..." 
                           class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-[#00796b] text-slate-900 dark:text-white placeholder-slate-400" />
                </div>
            </div>

            <!-- Group Info Card -->
            <div class="p-4 space-y-4">
                
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Group Info</h3>
                    <button type="button" @onclick="() => _showRightPanel = false" class="p-1 text-slate-400 hover:text-slate-700 dark:hover:text-white text-sm font-bold cursor-pointer">
                        ✕
                    </button>
                </div>

                <!-- Group Avatar & Title with Edit Button -->
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="relative group w-12 h-12 rounded-full bg-[#004D40] text-teal-300 font-bold text-sm flex items-center justify-center shrink-0 shadow-inner overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(_selectedConversation.AvatarUrl))
                            {
                                <img src="@_selectedConversation.AvatarUrl" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span>@_selectedConversation.Initials</span>
                            }
                            @if (_selectedConversation.IsAdmin && _selectedConversation.Type != ConversationType.Direct)
                            {
                                <button type="button" @onclick="PromptChangeGroupPhotoAsync" title="Change Group Photo (Admin)" class="absolute inset-0 bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                </button>
                            }
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-slate-900 dark:text-white">@_selectedConversation.Name</h4>
                            <p class="text-[11px] text-slate-400">@_selectedConversation.Type • @_selectedConversation.MemberCount members</p>
                        </div>
                    </div>
                </div>

                <!-- Description Card -->
                <div class="p-3 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800 flex items-start justify-between gap-2">
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                        @(!string.IsNullOrWhiteSpace(_selectedConversation.Subtitle) ? _selectedConversation.Subtitle : "No description provided.")
                    </p>
                </div>

                <!-- Media, Starred, Notification Settings Rows -->
                <div class="divide-y divide-slate-100 dark:divide-slate-800/80 text-xs">
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-[#00796b] text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>🖼️</span> Media, Links and Files
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            0 <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-[#00796b] text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>⭐</span> Starred Messages
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            0 <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-[#00796b] text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>🔔</span> Notification Settings
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            All messages <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                </div>

                <!-- Toggle Switches (Mute Chat & Allow Replies) -->
                <div class="space-y-3 pt-1 border-t border-slate-100 dark:border-slate-800/80 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                            <span>🔕</span> Mute Chat
                        </span>
                        <button type="button" 
                                @onclick="() => _isMuted = !_isMuted"
                                class="w-10 h-5 rounded-full p-0.5 transition-colors cursor-pointer @(_isMuted ? "bg-[#00796b]" : "bg-slate-300 dark:bg-slate-700")">
                            <div class="w-4 h-4 rounded-full bg-white transition-transform @(_isMuted ? "translate-x-5" : "translate-x-0")"></div>
                        </button>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                            <span>ℹ️</span> Allow Replies
                        </span>
                        <button type="button" 
                                @onclick="() => _allowReplies = !_allowReplies"
                                class="w-10 h-5 rounded-full p-0.5 transition-colors cursor-pointer @(_allowReplies ? "bg-[#00796b]" : "bg-slate-300 dark:bg-slate-700")">
                            <div class="w-4 h-4 rounded-full bg-white transition-transform @(_allowReplies ? "translate-x-5" : "translate-x-0")"></div>
                        </button>
                    </div>
                </div>

                <!-- Participants Section -->
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white">Participants (@(_selectedConversation.Members?.Count ?? 0))</h4>
                        @if (_selectedConversation.Type != ConversationType.Direct && _selectedConversation.IsAdmin)
                        {
                            <button type="button" 
                                    @onclick="OpenAddMemberModalAsync"
                                    class="flex items-center gap-1 text-[11px] font-bold text-[#00796b] hover:text-[#004D40] bg-teal-50 dark:bg-teal-950/60 hover:bg-teal-100 dark:hover:bg-teal-900/60 px-2 py-0.5 rounded-lg border border-teal-200 dark:border-teal-800 transition-colors cursor-pointer"
                                    title="Add Member to Group">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                </svg>
                                <span>Add Member</span>
                            </button>
                        }
                    </div>

                    <!-- Member Items List -->
                    <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                        @if (_selectedConversation.Members != null && _selectedConversation.Members.Any())
                        {
                            @foreach (var member in _selectedConversation.Members)
                            {
                                <div class="flex items-center justify-between py-1">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="w-8 h-8 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700">
                                            @if (!string.IsNullOrWhiteSpace(member.AvatarUrl))
                                            {
                                                <img src="@member.AvatarUrl" alt="@member.Name" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full bg-teal-100 dark:bg-teal-950 text-[#00796b] dark:text-teal-200 font-bold text-xs flex items-center justify-center">
                                                    @member.Initials
                                                </div>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-slate-900 dark:text-white truncate">@member.Name</p>
                                            <span class="text-[10px] text-slate-400">@member.Role</span>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1">
                                        @if (member.IsAdmin)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold text-[#00796b] bg-teal-50 dark:bg-teal-950/50 border border-teal-200 dark:border-teal-800">
                                                Admin
                                            </span>
                                        }
                                        else if (_selectedConversation.IsAdmin)
                                        {
                                            <button type="button" @onclick="() => PromoteMemberAsync(member)" title="Promote to Group Admin" class="p-1 text-slate-400 hover:text-[#00796b] rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                                            </button>
                                            <button type="button" @onclick="() => RemoveMemberAsync(member)" title="Remove Member" class="p-1 text-slate-400 hover:text-red-500 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            </button>
                                        }
                                    </div>
                                </div>

                            }
                        }
                        else
                        {
                            <p class="text-xs text-slate-400 py-2">No participant details available</p>
                        }
                    </div>
                </div>

            </div>

        </div>
    }

</div>

