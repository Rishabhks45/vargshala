@page "/messages"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin,Teacher,BranchAdmin,Student")]
@using System.Security.Claims
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Messages
@using Vargshala.SharedKernel.Enums
@using Vargshala.Web.Services
@inject IMessageService MessageService
@inject IChatHubService ChatHubService
@inject INotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Messages> Logger
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Messages | Vargshala</PageTitle>

<div class="h-full max-h-full flex-1 min-h-0 rounded-[20px] bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-800 shadow-sm flex overflow-hidden select-none transition-colors duration-200">

    <!-- ========================================================================= -->
    <!-- 1. LEFT PANEL: Conversations Sidebar -->
    <!-- ========================================================================= -->
    <div class="w-80 lg:w-88 shrink-0 h-full flex flex-col bg-white dark:bg-[#111c21]">
        
        <!-- Sidebar Header -->
        <div class="p-4 border-b border-slate-100 dark:border-slate-800/80 space-y-3 shrink-0">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-lg font-black text-slate-900 dark:text-white tracking-tight">
                        Messages
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                        Stay connected with your students, teachers and staff
                    </p>
                </div>

                <button type="button" 
                        @onclick="OpenCreateModal" 
                        class="p-2 rounded-xl bg-theme-primary hover:bg-theme-header text-white shadow-xs transition-all cursor-pointer"
                        title="New Conversation / Group">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </button>
            </div>

            <!-- Filter Category Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 select-none scroll-smooth">
                <button type="button" 
                        @onclick='() => _activeCategory = "All"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "All" ? "bg-theme-primary text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    All
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Groups"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Groups" ? "bg-theme-primary text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    Groups
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Announcements"'
                        class="px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Announcements" ? "bg-theme-primary text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    Announcements
                </button>
                <button type="button" 
                        @onclick='() => _activeCategory = "Unread"'
                        class="flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium transition-all shrink-0 whitespace-nowrap cursor-pointer @(_activeCategory == "Unread" ? "bg-theme-primary text-white font-semibold shadow-xs" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700")">
                    <span>Unread</span>
                    @if (UnreadConversationsCount > 0)
                    {
                        <span class="px-1.5 py-0.2 text-[10px] rounded-full leading-none font-bold @(_activeCategory == "Unread" ? "bg-white text-theme-primary" : "bg-theme-primary text-white")">
                            @UnreadConversationsCount
                        </span>
                    }
                </button>
            </div>
        </div>

        <!-- Conversations Scrollable Feed -->
        <div class="flex-1 min-h-0 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800/60 no-scrollbar scrollbar-hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
            @if (_isLoadingConversations && !_conversations.Any())
            {
                <SkeletonConversations Count="6" />
            }
            else if (FilteredConversations.Any())
            {
                @foreach (var conv in FilteredConversations)
                {
                    var isSelected = conv.Id == _selectedConversation?.Id;
                    <div @onclick="() => SelectConversationAsync(conv)"
                         class="px-4 py-3 flex items-center gap-3 cursor-pointer transition-colors @(isSelected ? "selected-conversation-active border-l-4" : "hover:bg-slate-50 dark:hover:bg-slate-800/40")">
                        
                        <!-- Avatar -->
                        <div class="relative shrink-0">
                            @if (conv.IsAnnouncement)
                            {
                                <div class="w-11 h-11 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                                    </svg>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(conv.AvatarUrl))
                            {
                                <img src="@conv.AvatarUrl" alt="@conv.Name" class="w-11 h-11 rounded-full object-cover border border-slate-200 dark:border-slate-700 shadow-xs" />
                            }
                            else if (conv.Type == ConversationType.Direct)
                            {
                                <div class="w-11 h-11 rounded-full avatar-theme-gradient font-bold text-sm flex items-center justify-center shadow-xs">
                                    @conv.Initials
                                </div>
                            }
                            else
                            {
                                <div class="w-11 h-11 rounded-full avatar-theme-gradient font-bold text-sm flex items-center justify-center shadow-xs">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-3-3.87 4.004 4.004 0 013 4.87zM4 15a4 4 0 003-3.87A4.004 4.004 0 004 16v-1z" />
                                    </svg>
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-1">
                                <h3 class="text-xs font-bold text-slate-900 dark:text-white truncate">
                                    @conv.Name
                                </h3>
                                <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium shrink-0">@conv.LastMessageTime</span>
                            </div>

                            <div class="flex items-center justify-between gap-2 mt-0.5">
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate leading-tight">
                                    @(string.IsNullOrWhiteSpace(conv.LastMessage) ? "No messages yet" : conv.LastMessage)
                                </p>

                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="w-4.5 h-4.5 rounded-full bg-theme-primary text-white text-[10px] font-bold flex items-center justify-center shrink-0">
                                        @conv.UnreadCount
                                    </span>
                                }
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="p-8 text-center text-slate-400 space-y-2">
                    <p class="text-xs font-medium">No conversations found</p>
                    <button type="button" @onclick="OpenCreateModal" class="px-3 py-1.5 rounded-lg bg-theme-primary-subtle text-theme-primary font-bold text-xs hover:opacity-80 transition-opacity">
                        + Start Conversation
                    </button>
                </div>
            }
        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 2. MIDDLE PANEL: Active Chat Window -->
    <!-- ========================================================================= -->
    <div class="flex-1 min-w-0 h-full flex flex-col bg-white dark:bg-[#111c21]">
        
        <!-- Chat Header: Always Persistent (Consistent 68px height, never disappears during loading) -->
        <div class="h-[68px] min-h-[68px] px-5 py-3.5 bg-white dark:bg-[#111c21] flex items-center justify-between gap-3 shrink-0">
            @if (_selectedConversation != null)
            {
                <button type="button" 
                        @onclick="() => _showRightPanel = !_showRightPanel"
                        class="flex items-center gap-3 min-w-0 text-left cursor-pointer group/header focus:outline-none"
                        title="Click to view @(_selectedConversation.Type == ConversationType.Direct ? "contact" : "group") info">
                    <div class="w-10 h-10 rounded-full avatar-theme-gradient font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden shadow-xs ring-2 ring-transparent transition-all">
                        @if (!string.IsNullOrWhiteSpace(_selectedConversation.AvatarUrl))
                        {
                            <img src="@_selectedConversation.AvatarUrl" class="w-full h-full object-cover" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_selectedConversation.Initials))
                        {
                            <span>@_selectedConversation.Initials</span>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-3-3.87 4.004 4.004 0 013 4.87zM4 15a4 4 0 003-3.87A4.004 4.004 0 004 16v-1z" />
                            </svg>
                        }
                    </div>

                    <div class="min-w-0">
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white truncate group-hover/header:text-theme-primary transition-colors">
                            @_selectedConversation.Name
                        </h2>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium truncate">
                            @_selectedConversation.MemberCount members | @_selectedConversation.Type
                        </p>
                    </div>
                </button>

                <!-- Right Header Actions (Search, Call, Video, Three Dots) -->
                <div class="flex items-center gap-1.5 shrink-0 text-slate-600 dark:text-slate-300">
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Search">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </button>
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Voice Call">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                    </button>
                    <button type="button" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Video Call">
                        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                        </svg>
                    </button>
                    <button type="button" 
                            @onclick="() => _showRightPanel = !_showRightPanel"
                            class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
                            title="Group Info">
                        <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                    </button>
                </div>
            }
            else if (_isLoadingConversations)
            {
                <!-- Header Skeleton Shimmer (Keeps header visible during loading) -->
                <div class="flex items-center gap-3 animate-pulse">
                    <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700/60 shrink-0"></div>
                    <div class="space-y-1.5">
                        <div class="h-4 w-32 bg-slate-200 dark:bg-slate-700/60 rounded-md"></div>
                        <div class="h-3 w-20 bg-slate-200 dark:bg-slate-700/60 rounded-md"></div>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 animate-pulse">
                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-700/60"></div>
                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-700/60"></div>
                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-700/60"></div>
                    <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-700/60"></div>
                </div>
            }
            else
            {
                <!-- Fallback Header Placeholder -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-700 dark:text-slate-300">Messages</h2>
                        <p class="text-[11px] text-slate-400 font-medium">Select a conversation to start messaging</p>
                    </div>
                </div>
            }
        </div>

        <!-- Chat Canvas Body (Messages Stream + Composer) with Rounded Inner Top-Left Corner (Matching Layout Style) -->
        <div class="flex-1 min-h-0 flex flex-col theme-canvas-bg rounded-tl-[20px] shadow-inner overflow-hidden border-t border-l border-slate-200/40 dark:border-slate-800/40 transition-colors"
             style="background-color: var(--theme-current-canvas, var(--theme-canvas-bg, #F0FDFA));">

            @if (_selectedConversation != null)
            {

                <!-- Messages Stream -->
                <div id="messages-stream" class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 space-y-2 select-text scroll-smooth no-scrollbar scrollbar-hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                @if (_isLoadingMessages && !_currentMessages.Any())
                {
                    <SkeletonMessages Count="4" />
                }
                else if (_currentMessages.Any())
                {
                    <!-- Date Separator Pill -->
                    <div class="flex items-center justify-center my-1">
                        <span class="px-3.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-[11px] font-medium text-slate-500 dark:text-slate-400">
                            @(_currentMessages.First().SentAt.ToString("MMM dd, yyyy"))
                        </span>
                    </div>

                    @foreach (var msg in _currentMessages)
                    {
                        @if (msg.MessageType == MessageType.System)
                        {
                            <!-- System Event Notice (Centered Card) -->
                            <div class="max-w-md mx-auto p-2.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/80 text-center text-xs text-slate-600 dark:text-slate-300">
                                <p class="font-medium">@msg.Content</p>
                                <span class="text-[10px] text-slate-400">@msg.SentAt.ToString("hh:mm tt")</span>
                            </div>
                        }
                        else if (msg.IsOutgoing)
                        {
                            <!-- OUTGOING MESSAGE (Right Aligned, Mint Green Bubble) -->
                            <div class="flex flex-col items-end">
                                <div class="relative group/msg w-fit max-w-lg">
                                    <!-- Floating Quick Reactions Bar (on hover of message bubble) -->
                                    <div class="opacity-0 pointer-events-none group-hover/msg:pointer-events-auto group-hover/msg:opacity-100 transition-opacity duration-150 absolute -top-3.5 right-2 z-20 flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-white dark:bg-[#18262c] shadow-md border border-slate-200 dark:border-slate-700 text-sm">
                                        @foreach (var qe in EmojiHelper.QuickReactions)
                                        {
                                            <button type="button" 
                                                    @onclick="() => ToggleReaction(msg, qe)" 
                                                    class="hover:scale-130 transition-transform p-1 cursor-pointer" 
                                                    title="@qe">
                                                @qe
                                            </button>
                                        }
                                        <button type="button" 
                                                @onclick="() => OpenReactionPicker(msg.Id)" 
                                                class="w-5 h-5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 font-bold text-xs ml-0.5 cursor-pointer" 
                                                title="More Reactions">
                                            +
                                        </button>
                                        <!-- Delete Outgoing Message -->
                                        <div class="w-px h-3.5 bg-slate-200 dark:bg-slate-700 mx-0.5"></div>
                                        <button type="button" 
                                                @onclick="() => DeleteMessageAsync(msg)" 
                                                class="w-5 h-5 rounded-full hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors cursor-pointer" 
                                                title="Delete Message">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>

                                    <!-- Reaction Picker Popup for this message -->
                                    @if (_reactionPickerMessageId == msg.Id)
                                    {
                                        <!-- Backdrop: Click outside to close reaction picker -->
                                        <div class="fixed inset-0 z-20" 
                                             style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 20;" 
                                             @onclick="() => _reactionPickerMessageId = null"></div>

                                        <div class="absolute -top-72 right-0 z-30 w-72 sm:w-80 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden text-xs">
                                            <div class="p-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                                <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                                    @foreach (var cat in EmojiHelper.Categories)
                                                    {
                                                        <button type="button" 
                                                                @onclick="() => _activeEmojiCategory = cat.Key"
                                                                class="px-2 py-0.5 rounded text-xs cursor-pointer @(_activeEmojiCategory == cat.Key ? "bg-theme-primary-subtle text-theme-primary font-bold" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
                                                            @cat.Icon
                                                        </button>
                                                    }
                                                </div>
                                                <button type="button" @onclick="() => _reactionPickerMessageId = null" class="text-slate-400 hover:text-slate-600 cursor-pointer text-xs font-bold">✕</button>
                                            </div>
                                            <div class="p-2 max-h-52 overflow-y-auto grid grid-cols-8 gap-1 text-base">
                                                @foreach (var emoji in FilteredEmojis)
                                                {
                                                    <button type="button" 
                                                            @onclick="() => ToggleReaction(msg, emoji)"
                                                            class="w-7 h-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                                            title="@emoji">
                                                        @emoji
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="rounded-2xl rounded-tr-xs outgoing-chat-bubble px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 shadow-2xs border">
                                        @if (!string.IsNullOrWhiteSpace(msg.AttachmentUrl))
                                        {
                                            @if (IsImageAttachment(msg.AttachmentName, msg.AttachmentType))
                                            {
                                                <div class="mb-1.5 rounded-xl overflow-hidden max-w-xs">
                                                    <a href="@msg.AttachmentUrl" target="_blank" title="View full image">
                                                        <img src="@msg.AttachmentUrl" alt="@msg.AttachmentName" class="max-h-60 w-auto rounded-lg object-contain hover:opacity-95 transition-opacity" loading="lazy" />
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(msg.AttachmentName))
                                                    {
                                                        <div class="mt-1 flex items-center justify-between text-[10px] text-slate-400">
                                                            <span class="truncate max-w-[180px]">@msg.AttachmentName</span>
                                                            <div class="flex items-center gap-2">
                                                                @if (!string.IsNullOrWhiteSpace(msg.AttachmentSize))
                                                                {
                                                                    <span>@msg.AttachmentSize</span>
                                                                }
                                                                <a href="@GetDownloadUrl(msg.AttachmentUrl, msg.AttachmentName)" target="_blank" download="@msg.AttachmentName" class="p-0.5 hover:text-slate-700 dark:hover:text-slate-200 transition-colors" title="Download Image">
                                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                                    </svg>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                var isDocx = IsDocxAttachment(msg.AttachmentName, msg.AttachmentType);
                                                <div class="flex items-center justify-between gap-3 p-2 bg-white/90 dark:bg-[#111c21]/90 rounded-xl border border-slate-200/50 dark:border-slate-700/50 mb-1">
                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                        <div class="w-8 h-8 rounded-lg @(isDocx ? "bg-blue-600" : "bg-rose-600") text-white font-extrabold text-[10px] flex items-center justify-center shrink-0">
                                                            @(isDocx ? "DOCX" : "PDF")
                                                        </div>
                                                        <div class="min-w-0">
                                                            <p class="font-bold text-slate-900 dark:text-white truncate text-xs">@msg.AttachmentName</p>
                                                            <span class="text-[10.5px] text-slate-400">@(msg.AttachmentSize ?? (isDocx ? "Word Document" : "PDF Document"))</span>
                                                        </div>
                                                    </div>
                                                    <a href="@GetDownloadUrl(msg.AttachmentUrl, msg.AttachmentName)" target="_blank" download="@msg.AttachmentName" class="p-1.5 text-slate-500 hover:text-slate-700 dark:text-slate-300" title="Download">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                        </svg>
                                                    </a>
                                                </div>
                                            }
                                        }

                                        @if (!string.IsNullOrWhiteSpace(msg.Content))
                                        {
                                            <div class="leading-normal whitespace-pre-wrap font-normal break-words">
                                                <span>@msg.Content</span>
                                                <span class="inline-flex items-center gap-1 text-[10px] text-slate-400 dark:text-slate-400 font-medium float-right ml-2.5 mt-0.5 select-none shrink-0">
                                                    <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                    @if (_pendingOptimisticMessageIds.Contains(msg.Id))
                                                    {
                                                        <!-- Clock (Sending...) -->
                                                        <span title="Sending..." class="inline-flex items-center text-slate-400 dark:text-slate-500 animate-pulse">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <circle cx="12" cy="12" r="10"></circle>
                                                                <polyline points="12 6 12 12 16 14"></polyline>
                                                            </svg>
                                                        </span>
                                                    }
                                                    else if (msg.IsRead)
                                                    {
                                                        <!-- Double Tick (Read) -->
                                                        <span title="Read" class="inline-flex items-center" style="color: var(--theme-primary, #009488);">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M18 6L7 17l-5-5"/>
                                                                <path d="M22 10l-7.5 7.5-1.5-1.5"/>
                                                            </svg>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <!-- Single Tick (Sent) -->
                                                        <span title="Sent" class="inline-flex items-center text-slate-400 dark:text-slate-500">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M20 6L9 17l-5-5"/>
                                                            </svg>
                                                        </span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center justify-end gap-1 text-[10px] text-slate-400 font-medium mt-0.5">
                                                <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                @if (_pendingOptimisticMessageIds.Contains(msg.Id))
                                                {
                                                    <!-- Clock (Sending...) -->
                                                    <span title="Sending..." class="inline-flex items-center text-slate-400 dark:text-slate-500 animate-pulse">
                                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <polyline points="12 6 12 12 16 14"></polyline>
                                                        </svg>
                                                    </span>
                                                }
                                                else if (msg.IsRead)
                                                {
                                                    <span title="Read" class="inline-flex items-center" style="color: var(--theme-primary, #009488);">
                                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M18 6L7 17l-5-5"/>
                                                            <path d="M22 10l-7.5 7.5-1.5-1.5"/>
                                                        </svg>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span title="Sent" class="inline-flex items-center text-slate-400 dark:text-slate-500">
                                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M20 6L9 17l-5-5"/>
                                                        </svg>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Reactions Badges -->
                                @if (msg.Reactions.Any())
                                {
                                    <div class="flex flex-wrap gap-1 mt-1 justify-end">
                                        @foreach (var kv in msg.Reactions)
                                        {
                                            var isMyReaction = _myReactions.TryGetValue(msg.Id, out var myEmoji) && myEmoji == kv.Key;
                                            <button type="button" 
                                                    @onclick="() => ToggleReaction(msg, kv.Key)"
                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs transition-colors cursor-pointer @(isMyReaction ? "reaction-pill-active font-bold shadow-2xs" : "bg-white dark:bg-[#18262c] hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xs text-slate-700 dark:text-slate-300")"
                                                    title="@(isMyReaction ? "Remove reaction" : "React with " + kv.Key)">
                                                <span>@kv.Key</span>
                                                @if (kv.Value > 1)
                                                {
                                                    <span class="text-[10px] font-bold @(isMyReaction ? "" : "text-slate-600 dark:text-slate-300")">@kv.Value</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- INCOMING MESSAGE (Left Aligned, White Bubble) -->
