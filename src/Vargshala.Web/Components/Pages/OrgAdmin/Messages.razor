@code {
    private string _activeCategory = "All";
    private string _messageInput = string.Empty;
    private bool _showRightPanel = false;
    private bool _isMuted = false;
    private bool _allowReplies = true;

    private bool _isLoadingConversations = true;
    private bool _isLoadingMessages = true;
    private readonly HashSet<Guid> _pendingOptimisticMessageIds = new();
    private bool _isCreating = false;
    private bool _showCreateModal = false;

    private string _newConversationName = string.Empty;
    private string _newConversationDescription = string.Empty;
    private ConversationType _newConversationType = ConversationType.Group;
    private readonly List<CustomSelect.CustomSelectOption> _conversationTypeOptions = new()
    {
        new(ConversationType.Direct.ToString(), "Direct 1-on-1 Message"),
        new(ConversationType.Group.ToString(), "Group Discussion"),
        new(ConversationType.Channel.ToString(), "Announcement Channel")
    };

    private List<EligibleUserDto> _eligibleContacts = new();
    private Guid? _selectedTargetUserId;
    private readonly HashSet<Guid> _selectedGroupMemberIds = new();
    private string _contactSearchTerm = string.Empty;
    private bool _isLoadingContacts = false;

    private bool _showAddMemberModal = false;
    private string _addMemberSearchTerm = string.Empty;
    private bool _isAddingMember = false;

    // Emoji Picker & Message Reactions State
    private bool _showInputEmojiPicker = false;
    private string _activeEmojiCategory = "Smileys";
    private string _emojiSearchTerm = string.Empty;
    private Guid? _reactionPickerMessageId;
    private readonly Dictionary<Guid, string> _myReactions = new();

    // Attachment State
    private MessageAttachmentUploadResponse? _pendingAttachment;
    private bool _isUploadingAttachment = false;

    // Soft Delete & Undo State
    private ChatMessageDto? _recentlyDeletedMessage;
    private int _undoCountdown = 5;
    private System.Threading.Timer? _undoTimer;

    private IEnumerable<string> FilteredEmojis => EmojiHelper.FilterEmojis(_activeEmojiCategory, _emojiSearchTerm);


    private ChatConversationDto? _selectedConversation;
    private List<ChatConversationDto> _conversations = new();
    private List<ChatMessageDto> _currentMessages = new();

    private Guid _currentUserId = Guid.Empty;
    private string _currentUserName = "User";
    private readonly Dictionary<string, DateTime> _typingUsers = new();
    private System.Threading.Timer? _typingDebounceTimer;
    private bool _isCurrentlyTyping = false;

    private List<string> ActiveTypingUsers => _typingUsers
        .Where(kv => kv.Value > DateTime.UtcNow)
        .Select(kv => kv.Key)
        .ToList();

    private string GetTypingText()
    {
        var users = ActiveTypingUsers;
        if (users.Count == 1) return $"{users[0]} is typing...";
        if (users.Count == 2) return $"{users[0]} and {users[1]} are typing...";
        return "Multiple people are typing...";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
        if (Guid.TryParse(userIdStr, out var parsedGuid))
        {
            _currentUserId = parsedGuid;
        }

        _currentUserName = user.FindFirst(ClaimTypes.Name)?.Value 
                          ?? user.FindFirst("name")?.Value 
                          ?? "User";

        ChatHubService.OnMessageReceived += HandleIncomingMessageAsync;
        ChatHubService.OnMessagesRead += HandleMessagesRead;
        ChatHubService.OnUserTyping += HandleUserTyping;
        ChatHubService.OnReactionUpdated += HandleReactionUpdated;
        ChatHubService.OnMessageDeleted += HandleMessageDeleted;
        ChatHubService.OnMessageRestored += HandleMessageRestoredAsync;

        await ChatHubService.ConnectAsync();
        await LoadConversationsAsync();
    }

    private async Task HandleIncomingMessageAsync(ChatMessageDto message)
    {
        await InvokeAsync(async () =>
        {
            if (_typingUsers.ContainsKey(message.SenderName))
            {
                _typingUsers.Remove(message.SenderName);
            }

            if (_selectedConversation != null && _selectedConversation.Id == message.ConversationId)
            {
                // Reconcile optimistic outgoing message if incoming message is from current user
                if (message.SenderId == _currentUserId.ToString())
                {
                    var optMsg = _currentMessages.FirstOrDefault(m => _pendingOptimisticMessageIds.Contains(m.Id) && m.Content == message.Content);
                    if (optMsg != null)
                    {
                        _pendingOptimisticMessageIds.Remove(optMsg.Id);
                        var idx = _currentMessages.IndexOf(optMsg);
                        message.IsOutgoing = true;
                        _currentMessages[idx] = message;
                        StateHasChanged();
                        return;
                    }
                }

                if (!_currentMessages.Any(m => m.Id == message.Id))
                {
                    message.IsOutgoing = message.SenderId == _currentUserId.ToString();
                    _currentMessages.Add(message);
                    _selectedConversation.LastMessage = message.Content;
                    _selectedConversation.LastMessageTime = message.SentAt.ToString("hh:mm tt");
                    _selectedConversation.LastMessageAt = message.SentAt;
                    MoveConversationToTop(_selectedConversation);

                    if (!message.IsOutgoing)
                    {
                        await MessageService.MarkAsReadAsync(message.ConversationId, message.Id);
                    }
                    await ScrollToBottomAsync();
                }
            }
            else
            {
                var conv = _conversations.FirstOrDefault(c => c.Id == message.ConversationId);
                if (conv != null)
                {
                    conv.LastMessage = message.Content;
                    conv.LastMessageTime = message.SentAt.ToString("hh:mm tt");
                    conv.LastMessageAt = message.SentAt;
                    if (message.SenderId != _currentUserId.ToString())
                    {
                        conv.UnreadCount++;
                    }
                    MoveConversationToTop(conv);
                }
            }
            StateHasChanged();
        });
    }

    private void HandleMessagesRead(MessagesReadNotification notification)
    {
        InvokeAsync(() =>
        {
            if (_selectedConversation != null && _selectedConversation.Id == notification.ConversationId)
            {
                if (notification.ReadByUserId != _currentUserId)
                {
                    var hasChanges = false;
                    foreach (var msg in _currentMessages.Where(m => m.IsOutgoing && !m.IsRead))
                    {
                        if (msg.SentAt <= notification.ReadAt || msg.Id == notification.LatestMessageId)
                        {
                            msg.IsRead = true;
                            msg.ReadAt = notification.ReadAt;
                            hasChanges = true;
                        }
                    }
                    if (hasChanges)
                    {
                        StateHasChanged();
                    }
                }
            }
        });
    }

    private void HandleUserTyping(string convId, string userName, bool isTyping)
    {
        InvokeAsync(() =>
        {
            if (_selectedConversation != null && _selectedConversation.Id.ToString() == convId)
            {
                if (userName != _currentUserName)
                {
                    if (isTyping)
                    {
                        _typingUsers[userName] = DateTime.UtcNow.AddSeconds(3);
                    }
                    else
                    {
                        _typingUsers.Remove(userName);
                    }
                    StateHasChanged();
                }
            }
        });
    }

    private async Task LoadConversationsAsync()
    {
        _isLoadingConversations = true;
        StateHasChanged();
        try
        {
            var response = await MessageService.GetConversationsAsync(new GetConversationsPagedRequest { PageSize = 100 });
            if (response.Success && response.Data != null)
            {
                _conversations = (response.Data.Items ?? new())
                    .OrderByDescending(c => c.LastMessageAt ?? DateTime.MinValue)
                    .ToList();
                if (_conversations.Any())
                {
                    await SelectConversationAsync(_conversations.First());
                }
            }
            else
            {
                NotificationService.Error(response.Message ?? "Failed to load conversations.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Error loading conversations: {ex.Message}");
        }
        finally
        {
            _isLoadingConversations = false;
            StateHasChanged();
        }
    }

    private List<ChatConversationDto> FilteredConversations
    {
        get
        {
            var query = _conversations.AsEnumerable();

            if (_activeCategory == "Groups") query = query.Where(c => c.Type == ConversationType.Group);
            else if (_activeCategory == "Announcements") query = query.Where(c => c.IsAnnouncement || c.Type == ConversationType.Channel);
            else if (_activeCategory == "Unread") query = query.Where(c => c.UnreadCount > 0);

            return query
                .OrderByDescending(c => c.LastMessageAt ?? DateTime.MinValue)
                .ToList();
        }
    }

    private int UnreadConversationsCount => _conversations.Count(c => c.UnreadCount > 0);

    private async Task SelectConversationAsync(ChatConversationDto conv)
    {
        if (_selectedConversation != null)
        {
            await ChatHubService.LeaveConversationAsync(_selectedConversation.Id);
        }
        await ChatHubService.JoinConversationAsync(conv.Id);

        _selectedConversation = conv;
        _isLoadingMessages = true;
        _currentMessages.Clear();
        _typingUsers.Clear();

        try
        {
            var response = await MessageService.GetMessagesAsync(conv.Id, new PagedRequest { PageSize = 100 });
            if (response.Success && response.Data != null)
            {
                _currentMessages = response.Data.Items ?? new();
                conv.UnreadCount = 0;

                _myReactions.Clear();
                foreach (var msg in _currentMessages.Where(m => !string.IsNullOrEmpty(m.MyReaction)))
                {
                    _myReactions[msg.Id] = msg.MyReaction!;
                }

                if (_currentMessages.Any())
                {
                    await MessageService.MarkAsReadAsync(conv.Id, _currentMessages.Last().Id);
                }
                await ScrollToBottomAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Error loading messages: {ex.Message}");
        }
        finally
        {
            _isLoadingMessages = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        _messageInput = e.Value?.ToString() ?? string.Empty;

        if (_selectedConversation != null)
        {
            if (!_isCurrentlyTyping && !string.IsNullOrWhiteSpace(_messageInput))
            {
                _isCurrentlyTyping = true;
                await ChatHubService.SendTypingAsync(_selectedConversation.Id, _currentUserName, true);
            }

            _typingDebounceTimer?.Dispose();
            _typingDebounceTimer = new System.Threading.Timer(async _ =>
            {
                if (_isCurrentlyTyping && _selectedConversation != null)
                {
                    _isCurrentlyTyping = false;
                    await ChatHubService.SendTypingAsync(_selectedConversation.Id, _currentUserName, false);
                }
            }, null, 2500, Timeout.Infinite);
        }
    }

    private static bool IsImageAttachment(string? name, string? type)
    {
        if (!string.IsNullOrWhiteSpace(type) && type.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(name))
        {
            var ext = Path.GetExtension(name).ToLowerInvariant();
            return ext is ".png" or ".jpg" or ".jpeg" or ".webp" or ".gif";
        }

        return false;
    }

    private static bool IsDocxAttachment(string? name, string? type)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            var ext = Path.GetExtension(name).ToLowerInvariant();
            return ext is ".docx" or ".doc";
        }
        return false;
    }

    private static string FormatFileSize(long? bytes)
    {
        if (bytes == null || bytes == 0) return string.Empty;
        var b = bytes.Value;
        if (b >= 1024 * 1024) return $"{b / (1024.0 * 1024.0):0.#} MB";
        if (b >= 1024) return $"{b / (1024.0 * 1024.0 < 1 ? b / 1024.0 : b / 1024.0):0.#} KB";
        return $"{b} B";
    }

    private static string GetDownloadUrl(string? url, string? fileName)
    {
        if (string.IsNullOrWhiteSpace(url)) return "#";
        if (url.Contains("supabase.co", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(fileName))
        {
            var separator = url.Contains('?') ? "&" : "?";
            return $"{url}{separator}download={Uri.EscapeDataString(fileName)}";
        }
        return url;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (_selectedConversation == null)
        {
            NotificationService.Warning("Please select a conversation first.");
            return;
        }

        var file = e.File;
        if (file == null) return;

        const long maxFileSize = 15 * 1024 * 1024; // 15 MB
        if (file.Size > maxFileSize)
        {
            NotificationService.Warning("File size exceeds the 15 MB limit.");
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".pdf", ".png", ".jpg", ".jpeg", ".webp", ".docx", ".doc"
        };

        if (!allowedExtensions.Contains(ext))
        {
            NotificationService.Warning("Only PDF, DOCX, PNG, JPG, JPEG, and WEBP files are supported.");
            return;
        }

        _isUploadingAttachment = true;
        StateHasChanged();

        try
        {
            var uploadResult = await MessageService.UploadAttachmentAsync(
                _selectedConversation.Id,
                file);

            if (uploadResult.Success && uploadResult.Data != null)
            {
                _pendingAttachment = uploadResult.Data;
                NotificationService.Success($"Attached {file.Name}");
            }
            else
            {
                NotificationService.Error(uploadResult.Message ?? "Failed to upload file to Supabase.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Upload failed: {ex.Message}");
        }
        finally
        {
            _isUploadingAttachment = false;
            StateHasChanged();
        }
    }

    private async Task SendMessageAsync()
    {
        if ((string.IsNullOrWhiteSpace(_messageInput) && _pendingAttachment == null) || _selectedConversation == null || _isUploadingAttachment) return;

        var text = _messageInput?.Trim() ?? string.Empty;
        var attachment = _pendingAttachment;

        // Instantly clear composer & reset input height for zero-delay UX
        _messageInput = string.Empty;
        _pendingAttachment = null;
        await ResetTextareaHeightAsync();

        if (_isCurrentlyTyping && _selectedConversation != null)
        {
            _isCurrentlyTyping = false;
            _typingDebounceTimer?.Dispose();
            _ = ChatHubService.SendTypingAsync(_selectedConversation.Id, _currentUserName, false);
        }

        var messageType = MessageType.Text;
        if (attachment != null)
        {
            messageType = IsImageAttachment(attachment.FileName, attachment.ContentType)
                ? MessageType.Image
                : MessageType.File;
        }

        // 1. Create optimistic local message and add immediately to chat stream
        var tempId = Guid.NewGuid();
        _pendingOptimisticMessageIds.Add(tempId);

        var optimisticMsg = new ChatMessageDto
        {
            Id = tempId,
            ConversationId = _selectedConversation!.Id,
            SenderId = _currentUserId.ToString(),
            SenderName = _currentUserName,
            SenderInitials = !string.IsNullOrWhiteSpace(_currentUserName) 
                ? (_currentUserName.Length > 1 ? _currentUserName[..2] : _currentUserName).ToUpperInvariant() 
                : "U",
            MessageType = messageType,
            Content = text,
            SentAt = DateTime.UtcNow,
            IsOutgoing = true,
            IsRead = false
        };

        if (attachment != null)
        {
            optimisticMsg.AttachmentName = attachment.FileName;
            optimisticMsg.AttachmentSize = FormatFileSize(attachment.FileSize);
            optimisticMsg.AttachmentType = messageType == MessageType.Image ? "Image" : "Document";
            optimisticMsg.AttachmentUrl = attachment.FileUrl;
        }

        _currentMessages.Add(optimisticMsg);
        _selectedConversation.LastMessage = !string.IsNullOrWhiteSpace(text) ? text : (attachment?.FileName ?? "Attachment");
        _selectedConversation.LastMessageTime = DateTime.Now.ToString("hh:mm tt");
        _selectedConversation.LastMessageAt = DateTime.UtcNow;
        MoveConversationToTop(_selectedConversation);

        // Render immediately in chat and instant scroll to bottom
        StateHasChanged();
        await ScrollToBottomAsync();

        // 2. Dispatch network send in background
        _ = Task.Run(async () =>
        {
            try
            {
                var request = new SendMessageRequest
                {
                    ConversationId = optimisticMsg.ConversationId,
                    MessageType = messageType,
                    MessageText = text
                };

                if (attachment != null)
                {
                    request.Attachments.Add(new MessageAttachmentRequest
                    {
                        FileName = attachment.FileName,
                        ContentType = attachment.ContentType,
                        FileSize = attachment.FileSize,
                        FileUrl = attachment.FileUrl,
                        ThumbnailUrl = attachment.ThumbnailUrl,
                        StorageKey = attachment.StorageKey
                    });
                }

                var response = await MessageService.SendMessageAsync(request);
                await InvokeAsync(() =>
                {
                    _pendingOptimisticMessageIds.Remove(tempId);
                    if (response.Success && response.Data != null)
                    {
                        var existingIndex = _currentMessages.FindIndex(m => m.Id == tempId);
                        if (existingIndex >= 0)
                        {
                            response.Data.IsOutgoing = true;
                            _currentMessages[existingIndex] = response.Data;
                        }
                        else if (!_currentMessages.Any(m => m.Id == response.Data.Id))
                        {
                            response.Data.IsOutgoing = true;
                            _currentMessages.Add(response.Data);
                        }

                        if (_selectedConversation != null && _selectedConversation.Id == response.Data.ConversationId)
                        {
                            _selectedConversation.LastMessage = response.Data.Content;
                            _selectedConversation.LastMessageTime = response.Data.SentAt.ToLocalTime().ToString("hh:mm tt");
                            _selectedConversation.LastMessageAt = response.Data.SentAt;
                        }
                    }
                    else
                    {
                        _currentMessages.RemoveAll(m => m.Id == tempId);
                        NotificationService.Error(response.Message ?? "Failed to send message.");
                    }
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _pendingOptimisticMessageIds.Remove(tempId);
                    _currentMessages.RemoveAll(m => m.Id == tempId);
                    NotificationService.Error($"Error sending message: {ex.Message}");
                    StateHasChanged();
                });
            }
        });
    }

    private async Task ToggleReaction(ChatMessageDto msg, string emoji)
    {
        _reactionPickerMessageId = null;

        var convId = _selectedConversation?.Id;
        bool hasExisting = _myReactions.TryGetValue(msg.Id, out var existingEmoji);

        if (hasExisting && existingEmoji == emoji)
        {
            // Case 1: User clicked the SAME emoji -> Remove reaction (Toggle Off)
            _myReactions.Remove(msg.Id);

            int newCount = 0;
            if (msg.Reactions.ContainsKey(emoji))
            {
                msg.Reactions[emoji]--;
                if (msg.Reactions[emoji] <= 0)
                {
                    msg.Reactions.Remove(emoji);
                    newCount = 0;
                }
                else
                {
                    newCount = msg.Reactions[emoji];
                }
            }

            StateHasChanged();

            if (convId.HasValue)
            {
                await ChatHubService.SendReactionAsync(convId.Value, msg.Id, emoji, newCount);
            }
        }
        else if (hasExisting && !string.IsNullOrEmpty(existingEmoji))
        {
            // Case 2: User clicked a DIFFERENT emoji -> Swap reaction (Remove old, Add new)
            // Step A: Decrement old reaction
            int oldCount = 0;
            if (msg.Reactions.ContainsKey(existingEmoji))
            {
                msg.Reactions[existingEmoji]--;
                if (msg.Reactions[existingEmoji] <= 0)
                {
                    msg.Reactions.Remove(existingEmoji);
                    oldCount = 0;
                }
                else
                {
                    oldCount = msg.Reactions[existingEmoji];
                }
            }

            // Step B: Increment new reaction
            int newCount;
            if (msg.Reactions.ContainsKey(emoji))
            {
                msg.Reactions[emoji]++;
                newCount = msg.Reactions[emoji];
            }
            else
            {
                msg.Reactions[emoji] = 1;
                newCount = 1;
            }

            _myReactions[msg.Id] = emoji;
            StateHasChanged();

            if (convId.HasValue)
            {
                await ChatHubService.SendReactionAsync(convId.Value, msg.Id, existingEmoji, oldCount);
                await ChatHubService.SendReactionAsync(convId.Value, msg.Id, emoji, newCount);
            }
        }
        else
        {
            // Case 3: First reaction on this message by this user -> Add reaction
            int newCount;
            if (msg.Reactions.ContainsKey(emoji))
            {
                msg.Reactions[emoji]++;
                newCount = msg.Reactions[emoji];
            }
            else
            {
                msg.Reactions[emoji] = 1;
                newCount = 1;
            }

            _myReactions[msg.Id] = emoji;
            StateHasChanged();

            if (convId.HasValue)
            {
                await ChatHubService.SendReactionAsync(convId.Value, msg.Id, emoji, newCount);
            }
        }

        // Persist to database asynchronously
        try
        {
            var apiResult = await MessageService.ToggleReactionAsync(msg.Id, emoji);
            if (apiResult.Success && apiResult.Data != null)
            {
                msg.Reactions = apiResult.Data.Reactions;
                if (string.IsNullOrEmpty(apiResult.Data.ActiveEmoji))
                {
                    _myReactions.Remove(msg.Id);
                }
                else
                {
                    _myReactions[msg.Id] = apiResult.Data.ActiveEmoji;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist reaction for message {MessageId}", msg.Id);
        }
    }

    private void HandleReactionUpdated(string convId, string messageIdStr, string emoji, int count)
    {
        if (_selectedConversation == null || _selectedConversation.Id.ToString() != convId) return;
        if (!Guid.TryParse(messageIdStr, out var msgId)) return;

        var targetMsg = _currentMessages.FirstOrDefault(m => m.Id == msgId);
        if (targetMsg == null) return;

        if (count > 0)
        {
            targetMsg.Reactions[emoji] = count;
        }
        else
        {
            targetMsg.Reactions.Remove(emoji);
        }

        _ = InvokeAsync(StateHasChanged);
    }


