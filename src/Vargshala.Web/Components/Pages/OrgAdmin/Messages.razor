    private async Task DeleteMessageAsync(ChatMessageDto message)
    {
        if (message == null) return;

        // Clean up existing undo timer
        _undoTimer?.Dispose();
        _recentlyDeletedMessage = message;
        _undoCountdown = 5;

        // Optimistically remove from current message list
        _currentMessages.Remove(message);

        // Update active conversation's last message snippet if this was the last message
        if (_selectedConversation != null && _selectedConversation.Id == message.ConversationId)
        {
            var latest = _currentMessages.LastOrDefault();
            if (latest != null)
            {
                _selectedConversation.LastMessage = latest.Content;
                _selectedConversation.LastMessageTime = latest.SentAt.ToString("hh:mm tt");
                _selectedConversation.LastMessageAt = latest.SentAt;
            }
            else
            {
                _selectedConversation.LastMessage = string.Empty;
                _selectedConversation.LastMessageTime = string.Empty;
            }
        }

        StateHasChanged();

        // Call backend API to soft delete
        var response = await MessageService.DeleteMessageAsync(message.Id);
        if (!response.Success)
        {
            NotificationService.Error(response.Message ?? "Failed to delete message.");
            // Rollback optimistic removal
            if (!_currentMessages.Any(m => m.Id == message.Id))
            {
                _currentMessages.Add(message);
                _currentMessages = _currentMessages.OrderBy(m => m.SentAt).ToList();
            }
            _recentlyDeletedMessage = null;
            StateHasChanged();
            return;
        }

        // Start 5-second countdown timer for undo
        _undoTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                if (_undoCountdown > 1)
                {
                    _undoCountdown--;
                    StateHasChanged();
                }
                else
                {
                    _undoTimer?.Dispose();
                    _undoTimer = null;
                    _recentlyDeletedMessage = null;
                    StateHasChanged();
                }
            });
        }, null, 1000, 1000);
    }

    private async Task UndoDeleteAsync()
    {
        if (_recentlyDeletedMessage == null) return;

        var messageToRestore = _recentlyDeletedMessage;
        _undoTimer?.Dispose();
        _undoTimer = null;
        _recentlyDeletedMessage = null;

        var response = await MessageService.RestoreMessageAsync(messageToRestore.Id);
        if (response.Success && response.Data != null)
        {
            var restored = response.Data;
            restored.IsOutgoing = restored.SenderId == _currentUserId.ToString();

            if (_selectedConversation != null && _selectedConversation.Id == restored.ConversationId)
            {
                if (!_currentMessages.Any(m => m.Id == restored.Id))
                {
                    _currentMessages.Add(restored);
                    _currentMessages = _currentMessages.OrderBy(m => m.SentAt).ToList();
                }

                var latest = _currentMessages.LastOrDefault();
                if (latest != null)
                {
                    _selectedConversation.LastMessage = latest.Content;
                    _selectedConversation.LastMessageTime = latest.SentAt.ToString("hh:mm tt");
                    _selectedConversation.LastMessageAt = latest.SentAt;
                }
                await ScrollToBottomAsync();
            }
            NotificationService.Success("Message restored!");
        }
        else
        {
            NotificationService.Error(response.Message ?? "Failed to restore message.");
        }
        StateHasChanged();
    }

    private void DismissUndo()
    {
        _undoTimer?.Dispose();
        _undoTimer = null;
        _recentlyDeletedMessage = null;
        StateHasChanged();
    }

    private void HandleMessageDeleted(MessageDeletedNotification notification)
    {
        InvokeAsync(() =>
        {
            if (_selectedConversation != null && _selectedConversation.Id == notification.ConversationId)
            {
                var existing = _currentMessages.FirstOrDefault(m => m.Id == notification.MessageId);
                if (existing != null)
                {
                    _currentMessages.Remove(existing);
                    var latest = _currentMessages.LastOrDefault();
                    if (latest != null)
                    {
                        _selectedConversation.LastMessage = latest.Content;
                        _selectedConversation.LastMessageTime = latest.SentAt.ToString("hh:mm tt");
                        _selectedConversation.LastMessageAt = latest.SentAt;
                    }
                    else
                    {
                        _selectedConversation.LastMessage = string.Empty;
                        _selectedConversation.LastMessageTime = string.Empty;
                    }
                    StateHasChanged();
                }
            }
        });
    }

    private async Task HandleMessageRestoredAsync(ChatMessageDto message)
    {
        await InvokeAsync(async () =>
        {
            if (_selectedConversation != null && _selectedConversation.Id == message.ConversationId)
            {
                if (!_currentMessages.Any(m => m.Id == message.Id))
                {
                    message.IsOutgoing = message.SenderId == _currentUserId.ToString();
                    _currentMessages.Add(message);
                    _currentMessages = _currentMessages.OrderBy(m => m.SentAt).ToList();

                    var latest = _currentMessages.LastOrDefault();
                    if (latest != null)
                    {
                        _selectedConversation.LastMessage = latest.Content;
                        _selectedConversation.LastMessageTime = latest.SentAt.ToString("hh:mm tt");
                        _selectedConversation.LastMessageAt = latest.SentAt;
                    }
                    await ScrollToBottomAsync();
                    StateHasChanged();
                }
            }
        });
    }

