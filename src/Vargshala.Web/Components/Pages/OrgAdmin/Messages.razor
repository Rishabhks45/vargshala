    private async Task AddMemberToGroupAsync(EligibleUserDto contact)
    {
        if (_selectedConversation == null) return;
        _isAddingMember = true;
        try
        {
            var response = await MessageService.AddParticipantAsync(_selectedConversation.Id, contact.UserId);
            if (response.Success)
            {
                NotificationService.Success($"{contact.FullName} was added to the group!");
                _selectedConversation.Members.Add(new ChatMemberDto
                {
                    UserId = contact.UserId,
                    Name = contact.FullName,
                    Role = contact.Role ?? "Member",
                    Initials = !string.IsNullOrWhiteSpace(contact.FullName) ? contact.FullName[0].ToString().ToUpper() : "?",
                    IsAdmin = false
                });
                _selectedConversation.MemberCount++;
                StateHasChanged();
            }
            else
            {
                NotificationService.Error(response.Message ?? "Failed to add member.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Error adding member: {ex.Message}");
        }
        finally
        {
            _isAddingMember = false;
        }
    }

    private async Task CreateConversationAsync()
    {
        if (_newConversationType == ConversationType.Direct)
        {
            if (!_selectedTargetUserId.HasValue)
            {
                NotificationService.Warning("Please select an authorized contact to start a direct message.");
                return;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_newConversationName))
            {
                NotificationService.Warning("Please enter a name for the group or channel.");
                return;
            }
        }

        _isCreating = true;
        try
        {
            var request = new CreateConversationRequest
            {
                Type = _newConversationType,
                Name = _newConversationName.Trim(),
                Description = _newConversationDescription.Trim(),
                TargetUserId = _selectedTargetUserId,
                ParticipantUserIds = _selectedGroupMemberIds.ToList(),
                IsAnnouncement = _newConversationType == ConversationType.Channel
            };

            var response = await MessageService.CreateConversationAsync(request);
            if (response.Success && response.Data != null)
            {
                response.Data.LastMessageAt ??= DateTime.UtcNow;
                _conversations.Insert(0, response.Data);
                _showCreateModal = false;
                await SelectConversationAsync(response.Data);
                NotificationService.Success("Conversation created successfully!");
            }
            else
            {
                NotificationService.Error(response.Message ?? "Failed to create conversation.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Error creating conversation: {ex.Message}");
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void MoveConversationToTop(ChatConversationDto conv)
    {
        var existing = _conversations.FirstOrDefault(c => c.Id == conv.Id);
        if (existing != null)
        {
            _conversations.Remove(existing);
            _conversations.Insert(0, existing);
        }
        else
        {
            _conversations.Insert(0, conv);
        }
    }

    public ValueTask DisposeAsync()
    {
        _typingDebounceTimer?.Dispose();
        _undoTimer?.Dispose();
        ChatHubService.OnMessageReceived -= HandleIncomingMessageAsync;
        ChatHubService.OnMessagesRead -= HandleMessagesRead;
        ChatHubService.OnUserTyping -= HandleUserTyping;
        ChatHubService.OnReactionUpdated -= HandleReactionUpdated;
        ChatHubService.OnMessageDeleted -= HandleMessageDeleted;
        ChatHubService.OnMessageRestored -= HandleMessageRestoredAsync;
        return ValueTask.CompletedTask;
    }
}
