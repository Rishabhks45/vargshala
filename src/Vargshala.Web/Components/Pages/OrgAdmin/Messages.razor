    private async Task OnConversationTypeChangedAsync()
    {
        if (!_eligibleContacts.Any())
        {
            await SearchEligibleContactsAsync();
        }
    }

    private void ToggleGroupMember(Guid userId)
    {
        if (!_selectedGroupMemberIds.Add(userId))
        {
            _selectedGroupMemberIds.Remove(userId);
        }
    }

    private async Task SearchEligibleContactsAsync()
    {
        _isLoadingContacts = true;
        try
        {
            var result = await MessageService.GetEligibleRecipientsAsync(new GetEligibleRecipientsRequest
            {
                SearchTerm = _contactSearchTerm,
                PageSize = 30
            });
            if (result.Success && result.Data != null)
            {
                _eligibleContacts = result.Data.Items.ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error($"Error searching contacts: {ex.Message}");
        }
        finally
        {
            _isLoadingContacts = false;
        }
    }

    private async Task PromoteMemberAsync(ChatMemberDto member)
    {
        if (_selectedConversation == null) return;
        var response = await MessageService.PromoteAdminAsync(_selectedConversation.Id, member.UserId);
        if (response.Success)
        {
            member.IsAdmin = true;
            NotificationService.Success($"{member.Name} has been promoted to Group Admin!");
            await SelectConversationAsync(_selectedConversation);
        }
        else
        {
            NotificationService.Error(response.Message ?? "Failed to promote member.");
        }
    }

    private async Task RemoveMemberAsync(ChatMemberDto member)
    {
        if (_selectedConversation == null) return;
        var response = await MessageService.RemoveParticipantAsync(_selectedConversation.Id, member.UserId);
        if (response.Success)
        {
            _selectedConversation.Members.Remove(member);
            _selectedConversation.MemberCount--;
            NotificationService.Success($"{member.Name} was removed from the conversation.");
            await SelectConversationAsync(_selectedConversation);
        }
        else
        {
            NotificationService.Error(response.Message ?? "Failed to remove member.");
        }
    }

    private async Task PromptChangeGroupPhotoAsync()
    {
        if (_selectedConversation == null) return;
        var promptResult = await JSRuntime.InvokeAsync<string?>("prompt", "Enter new group photo URL:", _selectedConversation.AvatarUrl ?? "");
        if (!string.IsNullOrWhiteSpace(promptResult))
        {
            var response = await MessageService.ChangeGroupPhotoAsync(_selectedConversation.Id, promptResult.Trim());
            if (response.Success)
            {
                _selectedConversation.AvatarUrl = promptResult.Trim();
                NotificationService.Success("Group photo updated successfully!");
                await SelectConversationAsync(_selectedConversation);
            }
            else
            {
                NotificationService.Error(response.Message ?? "Failed to update group photo.");
            }
        }
    }

