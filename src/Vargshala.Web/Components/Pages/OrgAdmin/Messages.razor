                                <button type="button" 
                                        @onclick="() => _showRightPanel = true"
                                        class="w-8 h-8 rounded-full overflow-hidden shrink-0 mt-0.5 border border-slate-200 cursor-pointer hover:opacity-80 hover:ring-2 transition-all"
                                        title="View info for @msg.SenderName">
                                    @if (!string.IsNullOrWhiteSpace(msg.SenderAvatarUrl))
                                    {
                                        <img src="@msg.SenderAvatarUrl" alt="@msg.SenderName" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full avatar-theme-gradient font-bold text-xs flex items-center justify-center">
                                            @msg.SenderInitials
                                        </div>
                                    }
                                </button>

                                <div class="space-y-1">
                                    <button type="button" 
                                            @onclick="() => _showRightPanel = true"
                                            class="text-[11px] font-bold ml-1 block text-left cursor-pointer hover:underline text-theme-primary"
                                            title="View info for @msg.SenderName">
                                        @msg.SenderName
                                    </button>

                                    <div class="relative group/msg w-fit max-w-lg">
                                        <!-- Floating Quick Reactions Bar (on hover of message bubble) -->
                                        <div class="opacity-0 pointer-events-none group-hover/msg:pointer-events-auto group-hover/msg:opacity-100 transition-opacity duration-150 absolute -top-3.5 left-2 z-20 flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-white dark:bg-[#18262c] shadow-md border border-slate-200 dark:border-slate-700 text-sm">
                                            @foreach (var qe in EmojiHelper.QuickReactions)
                                            {
                                                <button type="button" 
                                                        @onclick="() => ToggleReaction(msg, qe)" 
                                                        class="hover:scale-130 transition-transform p-1 cursor-pointer" 
                                                        title="@qe">
                                                    @qe
                                                </button>
                                            }
                                            <button type="button" 
                                                    @onclick="() => OpenReactionPicker(msg.Id)" 
                                                    class="w-5 h-5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 font-bold text-xs ml-0.5 cursor-pointer" 
                                                    title="More Reactions">
                                                +
                                            </button>
                                            @if (_selectedConversation?.IsAdmin == true)
                                            {
                                                <div class="w-px h-3.5 bg-slate-200 dark:bg-slate-700 mx-0.5"></div>
                                                <button type="button" 
                                                        @onclick="() => DeleteMessageAsync(msg)" 
                                                        class="w-5 h-5 rounded-full hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-400 hover:text-rose-500 flex items-center justify-center transition-colors cursor-pointer" 
                                                        title="Delete Message (Admin)">
                                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    </svg>
                                                </button>
                                            }
                                        </div>

                                        <!-- Reaction Picker Popup for this message -->
                                        @if (_reactionPickerMessageId == msg.Id)
                                        {
                                            <!-- Backdrop: Click outside to close reaction picker -->
                                            <div class="fixed inset-0 z-20" 
                                                 style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 20;" 
                                                 @onclick="() => _reactionPickerMessageId = null"></div>

                                            <div class="absolute -top-72 left-0 z-30 w-72 sm:w-80 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden text-xs">
                                                <div class="p-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                                    <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                                        @foreach (var cat in EmojiHelper.Categories)
                                                        {
                                                            <button type="button" 
                                                                    @onclick="() => _activeEmojiCategory = cat.Key"
                                                                    class="px-2 py-0.5 rounded text-xs cursor-pointer @(_activeEmojiCategory == cat.Key ? "bg-theme-primary-subtle text-theme-primary font-bold" : "text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800")">
                                                                @cat.Icon
                                                            </button>
                                                        }
                                                    </div>
                                                    <button type="button" @onclick="() => _reactionPickerMessageId = null" class="text-slate-400 hover:text-slate-600 cursor-pointer text-xs font-bold">✕</button>
                                                </div>
                                                <div class="p-2 max-h-52 overflow-y-auto grid grid-cols-8 gap-1 text-base">
                                                    @foreach (var emoji in FilteredEmojis)
                                                    {
                                                        <button type="button" 
                                                                @onclick="() => ToggleReaction(msg, emoji)"
                                                                class="w-7 h-7 rounded hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                                                title="@emoji">
                                                            @emoji
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <div class="rounded-2xl rounded-tl-xs bg-white dark:bg-[#18262c] px-3 py-1.5 text-xs text-slate-800 dark:text-slate-100 shadow-2xs border border-slate-200 dark:border-slate-800">
                                            @if (!string.IsNullOrWhiteSpace(msg.AttachmentUrl))
                                            {
                                                @if (IsImageAttachment(msg.AttachmentName, msg.AttachmentType))
                                                {
                                                    <div class="mb-1.5 rounded-xl overflow-hidden max-w-xs">
                                                        <a href="@msg.AttachmentUrl" target="_blank" title="View full image">
                                                            <img src="@msg.AttachmentUrl" alt="@msg.AttachmentName" class="max-h-60 w-auto rounded-lg object-contain hover:opacity-95 transition-opacity" loading="lazy" />
                                                        </a>
                                                        @if (!string.IsNullOrWhiteSpace(msg.AttachmentName))
                                                        {
                                                            <div class="mt-1 flex items-center justify-between text-[10px] text-slate-400">
                                                                <span class="truncate max-w-[180px]">@msg.AttachmentName</span>
                                                                <div class="flex items-center gap-2">
                                                                    @if (!string.IsNullOrWhiteSpace(msg.AttachmentSize))
                                                                    {
                                                                        <span>@msg.AttachmentSize</span>
                                                                    }
                                                                    <a href="@GetDownloadUrl(msg.AttachmentUrl, msg.AttachmentName)" target="_blank" download="@msg.AttachmentName" class="p-0.5 hover:text-slate-700 dark:hover:text-slate-200 transition-colors" title="Download Image">
                                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                                        </svg>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    var isDocx = IsDocxAttachment(msg.AttachmentName, msg.AttachmentType);
                                                    <div class="flex items-center justify-between gap-3 p-2 bg-slate-50 dark:bg-[#121e23] rounded-xl border border-slate-200 dark:border-slate-700 mb-1">
                                                        <div class="flex items-center gap-2.5 min-w-0">
                                                            <div class="w-8 h-8 rounded-lg @(isDocx ? "bg-blue-600" : "bg-rose-600") text-white font-extrabold text-[10px] flex items-center justify-center shrink-0">
                                                                @(isDocx ? "DOCX" : "PDF")
                                                            </div>
                                                            <div class="min-w-0">
                                                                <p class="font-bold text-slate-900 dark:text-white truncate text-xs">@msg.AttachmentName</p>
                                                                <span class="text-[10.5px] text-slate-400">@(msg.AttachmentSize ?? (isDocx ? "Word Document" : "PDF Document"))</span>
                                                            </div>
                                                        </div>
                                                        <a href="@GetDownloadUrl(msg.AttachmentUrl, msg.AttachmentName)" target="_blank" download="@msg.AttachmentName" class="p-1.5 text-slate-500 hover:text-slate-700 dark:text-slate-300" title="Download">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                }
                                            }

                                            @if (!string.IsNullOrWhiteSpace(msg.Content))
                                            {
                                                <div class="leading-normal whitespace-pre-wrap font-normal break-words">
                                                    <span>@msg.Content</span>
                                                    <span class="inline-flex items-center text-[10px] text-slate-400 dark:text-slate-400 font-medium float-right ml-2.5 mt-0.5 select-none shrink-0">
                                                        <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="flex items-center justify-end text-[10px] text-slate-400 font-medium mt-0.5">
                                                    <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Reactions Badges -->
                                    @if (msg.Reactions.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mt-1 justify-start">
                                            @foreach (var kv in msg.Reactions)
                                            {
                                                var isMyReaction = _myReactions.TryGetValue(msg.Id, out var myEmoji) && myEmoji == kv.Key;
                                                <button type="button" 
                                                        @onclick="() => ToggleReaction(msg, kv.Key)"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs transition-colors cursor-pointer @(isMyReaction ? "reaction-pill-active font-bold shadow-2xs" : "bg-white dark:bg-[#18262c] hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xs text-slate-700 dark:text-slate-300")"
                                                        title="@(isMyReaction ? "Remove reaction" : "React with " + kv.Key)">
                                                    <span>@kv.Key</span>
                                                    @if (kv.Value > 1)
                                                    {
                                                        <span class="text-[10px] font-bold @(isMyReaction ? "" : "text-slate-600 dark:text-slate-300")">@kv.Value</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="p-8 text-center text-slate-400 space-y-1">
                        <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No messages yet</p>
                        <p class="text-xs">Send a message below to start the conversation.</p>
                    </div>
                }

                @if (ActiveTypingUsers.Any())
                {
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 dark:bg-[#18262c]/90 border border-slate-200/80 dark:border-slate-700/80 w-fit text-xs text-theme-primary font-medium transition-all shadow-2xs">
                        <div class="flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-theme-primary animate-bounce" style="animation-delay: 0ms"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-theme-primary animate-bounce" style="animation-delay: 150ms"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-theme-primary animate-bounce" style="animation-delay: 300ms"></span>
                        </div>
                        <span>@GetTypingText()</span>
                    </div>
                }

            </div>

            <!-- Chat Composer Bar (Matching Exact Unified Input Style) -->
            <div class="px-4 py-3 bg-white/80 dark:bg-[#111c21]/80 backdrop-blur-xs border-t border-slate-200/50 dark:border-slate-800/50 shrink-0 relative">
                
                <!-- Floating Undo Delete Notification Banner -->
                @if (_recentlyDeletedMessage != null)
                {
                    <div class="absolute -top-12 left-1/2 -translate-x-1/2 z-30 flex items-center gap-3 px-4 py-2 rounded-xl bg-slate-900/95 dark:bg-[#18262c]/95 text-white shadow-xl backdrop-blur-sm border border-slate-700/60 animate-in fade-in slide-in-from-bottom-2 duration-200 text-xs whitespace-nowrap">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            <span class="font-medium">Message deleted</span>
                        </div>
                        <div class="h-3.5 w-px bg-slate-700"></div>
                        <button type="button" 
                                @onclick="UndoDeleteAsync" 
                                class="font-bold text-teal-300 hover:text-teal-200 cursor-pointer flex items-center gap-1 hover:underline">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a5 5 0 015 5v2m0 0l-4-4m4 4l4-4" transform="matrix(-1 0 0 1 24 0)"/>
                            </svg>
                            <span>Undo (@_undoCountdown s)</span>
                        </button>
                        <button type="button" 
                                @onclick="DismissUndo" 
                                class="text-slate-400 hover:text-white cursor-pointer ml-1 text-sm font-bold leading-none"
                                title="Dismiss">
                            ✕
                        </button>
                    </div>
                }

                <!-- Full Emoji Picker Popover for Input -->
                @if (_showInputEmojiPicker)
                {
