    private async Task PromoteMemberAsync(ChatMemberDto member)
    {
        if (_selectedConversation == null) return;
        var response = await MessageService.PromoteAdminAsync(_selectedConversation.Id, member.UserId);
        if (response.Success)
        {
            member.IsAdmin = true;
            NotificationService.Success($"{member.Name} has been promoted to Group Admin!");
            await SelectConversationAsync(_selectedConversation);
        }
        else
        {
            NotificationService.Error(response.Message ?? "Failed to promote member.");
        }
    }

    private async Task RemoveMemberAsync(ChatMemberDto member)
    {
        if (_selectedConversation == null) return;
        var response = await MessageService.RemoveParticipantAsync(_selectedConversation.Id, member.UserId);
        if (response.Success)
        {
            _selectedConversation.Members.Remove(member);
            _selectedConversation.MemberCount--;
            NotificationService.Success($"{member.Name} was removed from the conversation.");
            await SelectConversationAsync(_selectedConversation);
        }
        else
        {
            NotificationService.Error(response.Message ?? "Failed to remove member.");
        }
    }

