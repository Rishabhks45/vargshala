                         style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100vw; height: 100vh; z-index: 40;" 
                         @onclick="() => _showInputEmojiPicker = false"></div>

                    <div class="absolute bottom-16 right-4 z-50 w-80 sm:w-96 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 shadow-2xl overflow-hidden animate-in fade-in duration-150">
                        <div class="p-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-1">
                            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar">
                                @foreach (var cat in EmojiHelper.Categories)
                                {
                                    <button type="button" 
                                            @onclick="() => _activeEmojiCategory = cat.Key"
                                            class="px-2 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors @(_activeEmojiCategory == cat.Key ? "bg-theme-primary-subtle text-theme-primary font-bold" : "text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")"
                                            title="@cat.Title">
                                        <span>@cat.Icon</span>
                                    </button>
                                }
                            </div>
                            <button type="button" @onclick="() => _showInputEmojiPicker = false" class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs font-bold cursor-pointer">
                                ✕
                            </button>
                        </div>

                        <div class="p-2 border-b border-slate-100 dark:border-slate-800">
                            <input type="text" 
                                   @bind="_emojiSearchTerm" 
                                   @bind:event="oninput" 
                                   placeholder="Search emojis..." 
                                   class="w-full px-3 py-1.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary text-slate-900 dark:text-white placeholder-slate-400" />
                        </div>

                        <div class="p-2 max-h-56 overflow-y-auto grid grid-cols-8 gap-1 text-lg select-none">
                            @foreach (var emoji in FilteredEmojis)
                            {
                                <button type="button" 
                                        @onclick="() => InsertEmojiIntoInput(emoji)"
                                        class="w-8 h-8 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center hover:scale-125 transition-transform cursor-pointer"
                                        title="@emoji">
                                    @emoji
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Pending Attachment Preview Banner -->
                @if (_isUploadingAttachment)
                {
                    <div class="mb-2 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
                        <div class="flex items-center gap-2">
                            <div class="w-3.5 h-3.5 border-2 border-theme-primary border-t-transparent rounded-full animate-spin"></div>
                            <span class="font-medium">Uploading document to Supabase Storage...</span>
                        </div>
                    </div>
                }
                else if (_pendingAttachment != null)
                {
                    <div class="mb-2 px-3 py-2 rounded-xl bg-teal-50 dark:bg-[#14262c] border border-teal-200 dark:border-teal-800 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2.5 min-w-0">
                            @if (IsImageAttachment(_pendingAttachment.FileName, _pendingAttachment.ContentType))
                            {
                                <div class="w-7 h-7 rounded bg-teal-100 dark:bg-teal-900/60 text-theme-primary flex items-center justify-center font-bold text-xs shrink-0">
                                    IMG
                                </div>
                            }
                            else if (IsDocxAttachment(_pendingAttachment.FileName, _pendingAttachment.ContentType))
                            {
                                <div class="w-7 h-7 rounded bg-blue-100 dark:bg-blue-900/60 text-blue-600 flex items-center justify-center font-bold text-[10px] shrink-0">
                                    DOCX
                                </div>
                            }
                            else
                            {
                                <div class="w-7 h-7 rounded bg-rose-100 dark:bg-rose-900/60 text-rose-600 flex items-center justify-center font-bold text-xs shrink-0">
                                    PDF
                                </div>
                            }
                            <div class="truncate">
                                <p class="font-bold text-slate-800 dark:text-white truncate text-xs">@_pendingAttachment.FileName</p>
                                <span class="text-[10px] text-slate-500">@FormatFileSize(_pendingAttachment.FileSize) • Ready to send</span>
                            </div>
                        </div>
                        <button type="button" 
                                @onclick="() => _pendingAttachment = null" 
                                class="text-slate-400 hover:text-rose-600 p-1 cursor-pointer font-bold text-xs transition-colors" 
                                title="Remove attachment">
                            ✕
                        </button>
                    </div>
                }

                <!-- Unified Input Card (Textarea + Action Icons + Send) -->
                <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-white dark:bg-[#18262c] border border-slate-300 dark:border-slate-700 shadow-2xs transition-all focus-within:border-theme-primary focus-within:ring-2 focus-within:ring-theme-primary/20">
                    
                    <!-- Auto-Growing Textarea (Shift + Enter for new line, Enter to send) -->
                    <textarea id="chat-composer-textarea"
                              rows="1"
                              value="@_messageInput"
                              @oninput="HandleInput"
                              disabled="@_isUploadingAttachment"
                              placeholder="Type a message"
                              class="chat-composer-input flex-1 min-w-0 bg-transparent border-0 focus:outline-none focus:ring-0 p-0 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 resize-none max-h-40 overflow-y-auto leading-normal"
                              style="min-height: 24px; height: 24px; border: none !important; outline: none !important; box-shadow: none !important; -webkit-box-shadow: none !important;"></textarea>

                    <!-- Right-Side Action Icons Strip (Only Upload & Emoji) -->
                    <div class="flex items-center gap-1 sm:gap-1.5 text-slate-500 dark:text-slate-300 shrink-0 select-none">
                        
                        <!-- Hidden InputFile for Attachments -->
                        <InputFile id="chat-file-input" OnChange="HandleFileSelected" class="hidden" accept=".pdf,.png,.jpg,.jpeg,.webp,.docx,.doc" />

                        <!-- 1. Attachment / Upload Paperclip Icon as label -->
                        <label for="chat-file-input" 
                               class="p-1 hover:text-theme-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors cursor-pointer" 
                               title="Attach Document or Image (PDF, DOCX, PNG, JPG)">
                            <svg class="w-5 h-5 shrink-0" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                            </svg>
                        </label>

                        <!-- 2. Emoji Smiley Icon -->
                        <button type="button" 
                                @onclick="ToggleInputEmojiPicker" 
                                class="p-1 hover:text-theme-primary hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors cursor-pointer @(_showInputEmojiPicker ? "text-theme-primary" : "")" 
                                title="Choose Emoji">
                            <svg class="w-5 h-5 shrink-0" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </button>

                        <!-- Vertical Divider Separator -->
                        <div class="h-5 w-[1px] bg-slate-300 dark:bg-slate-600 mx-0.5 shrink-0"></div>

                        <!-- 3. Send Button (Paper Plane Outline) -->
                        <button type="button" 
                                id="chat-send-btn"
                                @onclick="SendMessageAsync"
                                disabled="@((string.IsNullOrWhiteSpace(_messageInput) && _pendingAttachment == null) || _isUploadingAttachment)"
                                class="p-1 transition-all cursor-pointer @((string.IsNullOrWhiteSpace(_messageInput) && _pendingAttachment == null) || _isUploadingAttachment ? "text-slate-400 dark:text-slate-500 cursor-not-allowed opacity-60" : "text-theme-primary hover:opacity-80 hover:scale-110")"
                                title="Send (Enter)">
                            <svg class="w-5 h-5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>

                </div>

            </div>

            }
            else
            {
                <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400">
                    <div class="w-16 h-16 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-400 flex items-center justify-center mb-3 shadow-xs">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                    </div>
                    <p class="text-sm font-bold text-slate-700 dark:text-slate-300">Select a conversation to start messaging</p>
                    <p class="text-xs text-slate-500 mt-1">Choose an existing conversation or create a new group.</p>
                </div>
            }

        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 3. RIGHT PANEL: Group Info / Details Sidebar (Matching Exact Design) -->
    <!-- ========================================================================= -->
    @if (_selectedConversation != null && _showRightPanel)
    {
        <div class="w-80 lg:w-84 shrink-0 h-full border-l border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111c21] flex flex-col overflow-y-auto no-scrollbar scrollbar-hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
            
            <div class="p-3.5 border-b border-slate-100 dark:border-slate-800/80">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input type="text" 
                           placeholder="Search messages, people or groups..." 
                           class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary text-slate-900 dark:text-white placeholder-slate-400" />
                </div>
            </div>

            <!-- Group Info Card -->
            <div class="p-4 space-y-4">
                
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Group Info</h3>
                    <button type="button" @onclick="() => _showRightPanel = false" class="p-1 text-slate-400 hover:text-slate-700 dark:hover:text-white text-sm font-bold cursor-pointer">
                        ✕
                    </button>
                </div>

                <!-- Group Avatar & Title with Edit Button -->
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="relative group w-12 h-12 rounded-full avatar-theme-gradient font-bold text-sm flex items-center justify-center shrink-0 shadow-inner overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(_selectedConversation.AvatarUrl))
                            {
                                <img src="@_selectedConversation.AvatarUrl" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span>@_selectedConversation.Initials</span>
                            }
                            @if (_selectedConversation.IsAdmin && _selectedConversation.Type != ConversationType.Direct)
                            {
                                <button type="button" @onclick="PromptChangeGroupPhotoAsync" title="Change Group Photo (Admin)" class="absolute inset-0 bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                </button>
                            }
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-slate-900 dark:text-white">@_selectedConversation.Name</h4>
                            <p class="text-[11px] text-slate-400">@_selectedConversation.Type • @_selectedConversation.MemberCount members</p>
                        </div>
                    </div>
                </div>

                <!-- Description Card -->
                <div class="p-3 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800 flex items-start justify-between gap-2">
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                        @(!string.IsNullOrWhiteSpace(_selectedConversation.Subtitle) ? _selectedConversation.Subtitle : "No description provided.")
                    </p>
                </div>

                <!-- Media, Starred, Notification Settings Rows -->
                <div class="divide-y divide-slate-100 dark:divide-slate-800/80 text-xs">
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-theme-primary text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>🖼️</span> Media, Links and Files
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            0 <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-theme-primary text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>⭐</span> Starred Messages
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            0 <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                    <button type="button" class="w-full py-2.5 flex items-center justify-between hover:text-theme-primary text-slate-700 dark:text-slate-300 cursor-pointer">
                        <span class="flex items-center gap-2">
                            <span>🔔</span> Notification Settings
                        </span>
                        <span class="text-slate-400 flex items-center gap-1 font-medium">
                            All messages <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </span>
                    </button>
                </div>

                <!-- Toggle Switches (Mute Chat & Allow Replies) -->
                <div class="space-y-3 pt-1 border-t border-slate-100 dark:border-slate-800/80 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                            <span>🔕</span> Mute Chat
                        </span>
                        <button type="button" 
                                @onclick="() => _isMuted = !_isMuted"
                                class="w-10 h-5 rounded-full p-0.5 transition-colors cursor-pointer @(_isMuted ? "bg-theme-primary" : "bg-slate-300 dark:bg-slate-700")">
                            <div class="w-4 h-4 rounded-full bg-white transition-transform @(_isMuted ? "translate-x-5" : "translate-x-0")"></div>
                        </button>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                            <span>ℹ️</span> Allow Replies
                        </span>
                        <button type="button" 
                                @onclick="() => _allowReplies = !_allowReplies"
                                class="w-10 h-5 rounded-full p-0.5 transition-colors cursor-pointer @(_allowReplies ? "bg-theme-primary" : "bg-slate-300 dark:bg-slate-700")">
                            <div class="w-4 h-4 rounded-full bg-white transition-transform @(_allowReplies ? "translate-x-5" : "translate-x-0")"></div>
                        </button>
                    </div>
                </div>

                <!-- Participants Section -->
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white">Participants (@(_selectedConversation.Members?.Count ?? 0))</h4>
                        @if (_selectedConversation.Type != ConversationType.Direct && _selectedConversation.IsAdmin)
                        {
                            <button type="button" 
                                    @onclick="OpenAddMemberModalAsync"
                                    class="flex items-center gap-1 text-[11px] font-bold text-theme-primary bg-theme-primary-subtle px-2 py-0.5 rounded-lg border border-theme-primary hover:opacity-80 transition-colors cursor-pointer"
                                    title="Add Member to Group">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                </svg>
                                <span>Add Member</span>
                            </button>
                        }
                    </div>

                    <!-- Member Items List -->
                    <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                        @if (_selectedConversation.Members != null && _selectedConversation.Members.Any())
                        {
                            @foreach (var member in _selectedConversation.Members)
                            {
                                <div class="flex items-center justify-between py-1">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="w-8 h-8 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700">
                                            @if (!string.IsNullOrWhiteSpace(member.AvatarUrl))
                                            {
                                                <img src="@member.AvatarUrl" alt="@member.Name" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full avatar-theme-gradient font-bold text-xs flex items-center justify-center">
                                                    @member.Initials
                                                </div>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-slate-900 dark:text-white truncate">@member.Name</p>
                                            <span class="text-[10px] text-slate-400">@member.Role</span>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1">
                                        @if (member.IsAdmin)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold text-theme-primary bg-theme-primary-subtle border border-theme-primary">
                                                Admin
                                            </span>
                                        }
                                        else if (_selectedConversation.IsAdmin)
                                        {
                                            <button type="button" @onclick="() => PromoteMemberAsync(member)" title="Promote to Group Admin" class="p-1 text-slate-400 hover:text-theme-primary rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                                            </button>
                                            <button type="button" @onclick="() => RemoveMemberAsync(member)" title="Remove Member" class="p-1 text-slate-400 hover:text-red-500 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                            </button>
                                        }
                                    </div>
                                </div>

                            }
                        }
                        else
                        {
                            <p class="text-xs text-slate-400 py-2">No participant details available</p>
                        }
                    </div>
                </div>

            </div>

        </div>
    }

</div>

<!-- ========================================================================= -->
<!-- CREATE CONVERSATION MODAL -->
<!-- ========================================================================= -->
@if (_showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div class="bg-white dark:bg-[#111c21] rounded-2xl shadow-xl w-full max-w-md border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">Create New Channel / Group</h3>
                <button type="button" @onclick="() => _showCreateModal = false" class="text-slate-400 hover:text-slate-600">✕</button>
            </div>

            <div class="p-5 space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Type</label>
                    <CustomSelect Value="@_newConversationType.ToString()"
                                  ValueChanged="OnConversationTypeChanged"
                                  Options="_conversationTypeOptions"
                                  Placeholder="Select Type"
                                  Class="w-full" />
                </div>

                @if (_newConversationType == ConversationType.Direct)
                {
                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Select Authorized Contact</label>
                        <input type="text" @bind="_contactSearchTerm" @bind:event="oninput" @bind:after="SearchEligibleContactsAsync" placeholder="Type name or email..." class="w-full mb-2 px-3 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary" />

                        <div class="max-h-48 overflow-y-auto space-y-1 border border-slate-100 dark:border-slate-800 rounded-xl p-1 bg-slate-50/50 dark:bg-[#18262c]/50">
                            @if (_isLoadingContacts)
                            {
                                <p class="text-slate-400 text-center py-3">Loading authorized contacts...</p>
                            }
                            else if (_eligibleContacts.Any())
                            {
                                @foreach (var contact in _eligibleContacts)
                                {
                                    <div @onclick="() => _selectedTargetUserId = contact.UserId"
                                         class="flex items-center justify-between p-2 rounded-lg cursor-pointer transition-colors @(_selectedTargetUserId == contact.UserId ? "bg-theme-primary-subtle border border-theme-primary text-theme-primary" : "hover:bg-slate-100 dark:hover:bg-slate-800")">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="w-7 h-7 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700">
                                                @if (!string.IsNullOrWhiteSpace(contact.AvatarUrl))
                                                {
                                                    <img src="@contact.AvatarUrl" alt="@contact.FullName" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full avatar-theme-gradient font-bold text-xs flex items-center justify-center">
                                                        @(!string.IsNullOrWhiteSpace(contact.FullName) ? contact.FullName[0].ToString().ToUpper() : "?")
                                                    </div>
                                                }
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-bold text-slate-900 dark:text-white truncate">@contact.FullName</p>
                                                <p class="text-[10px] text-slate-400">@contact.Role @(!string.IsNullOrWhiteSpace(contact.Email) ? $"• {contact.Email}" : "")</p>
                                            </div>
                                        </div>
                                        @if (_selectedTargetUserId == contact.UserId)
                                        {
                                            <span class="text-theme-primary font-bold">✓</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-slate-400 text-center py-3">No authorized contacts found</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Name</label>
                        <input type="text" @bind="_newConversationName" placeholder="e.g. Class 10 - Mathematics" class="w-full px-3 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary" />
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Description</label>
                        <textarea @bind="_newConversationDescription" rows="2" placeholder="Brief description of the channel..." class="w-full px-3 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary"></textarea>
                    </div>

                    <!-- Member Selection for Group / Channel -->
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300">
                                Add Members <span class="text-slate-400 font-normal">(@_selectedGroupMemberIds.Count selected)</span>
                            </label>
                            @if (_selectedGroupMemberIds.Any())
                            {
                                <button type="button" @onclick="() => _selectedGroupMemberIds.Clear()" class="text-[11px] text-theme-primary hover:underline cursor-pointer">
                                    Clear all
                                </button>
                            }
                        </div>

                        @if (_selectedGroupMemberIds.Any())
                        {
                            <div class="flex flex-wrap gap-1.5 mb-2 max-h-20 overflow-y-auto p-1.5 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-200/80 dark:border-slate-700/80">
                                @foreach (var id in _selectedGroupMemberIds)
                                {
                                    var contact = _eligibleContacts.FirstOrDefault(c => c.UserId == id);
                                    var name = contact?.FullName ?? "Member";
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-theme-primary-subtle text-theme-primary border border-theme-primary">
                                        @name
                                        <button type="button" @onclick="() => ToggleGroupMember(id)" class="hover:text-red-500 font-bold ml-0.5 cursor-pointer">✕</button>
                                    </span>
                                }
                            </div>
                        }

                        <input type="text" 
                               @bind="_contactSearchTerm" 
                               @bind:event="oninput" 
                               @bind:after="SearchEligibleContactsAsync" 
                               placeholder="Search members to add..." 
                               class="w-full mb-2 px-3 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-theme-primary" />

                        <div class="max-h-36 overflow-y-auto space-y-1 border border-slate-100 dark:border-slate-800 rounded-xl p-1 bg-slate-50/50 dark:bg-[#18262c]/50">
                            @if (_isLoadingContacts)
                            {
                                <p class="text-slate-400 text-center py-3">Loading authorized contacts...</p>
                            }
                            else if (_eligibleContacts.Any())
                            {
                                @foreach (var contact in _eligibleContacts)
                                {
                                    var isSelected = _selectedGroupMemberIds.Contains(contact.UserId);
                                    <div @onclick="() => ToggleGroupMember(contact.UserId)"
                                         class="flex items-center justify-between p-2 rounded-lg cursor-pointer transition-colors @(isSelected ? "bg-theme-primary-subtle border border-theme-primary text-theme-primary" : "hover:bg-slate-100 dark:hover:bg-slate-800")">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <div class="w-7 h-7 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700">
