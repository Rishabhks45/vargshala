                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#00796b] dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                                        @name
                                        <button type="button" @onclick="() => ToggleGroupMember(id)" class="hover:text-red-500 font-bold ml-0.5 cursor-pointer">✕</button>
                                    </span>
                                }
                            </div>
                        }

                        <input type="text" 
                               @bind="_contactSearchTerm" 
                               @bind:event="oninput" 
                               @bind:after="SearchEligibleContactsAsync" 
                               placeholder="Search members to add..." 
                               class="w-full mb-2 px-3 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-[#00796b]" />

                        <div class="max-h-36 overflow-y-auto space-y-1 border border-slate-100 dark:border-slate-800 rounded-xl p-1 bg-slate-50/50 dark:bg-[#18262c]/50">
                            @if (_isLoadingContacts)
                            {
                                <p class="text-slate-400 text-center py-3">Loading authorized contacts...</p>
                            }
                            else if (_eligibleContacts.Any())
                            {
                                @foreach (var contact in _eligibleContacts)
                                {
                                    var isSelected = _selectedGroupMemberIds.Contains(contact.UserId);
                                    <div @onclick="() => ToggleGroupMember(contact.UserId)"
                                         class="flex items-center justify-between p-2 rounded-lg cursor-pointer transition-colors @(isSelected ? "bg-teal-50 dark:bg-teal-950/60 border border-teal-300 dark:border-teal-700 text-[#00796b]" : "hover:bg-slate-100 dark:hover:bg-slate-800")">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <div class="w-7 h-7 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-700">
                                                @if (!string.IsNullOrWhiteSpace(contact.AvatarUrl))
                                                {
                                                    <img src="@contact.AvatarUrl" alt="@contact.FullName" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full bg-teal-100 dark:bg-teal-950 text-[#00796b] dark:text-teal-300 font-bold text-xs flex items-center justify-center">
                                                        @(!string.IsNullOrWhiteSpace(contact.FullName) ? contact.FullName[0].ToString().ToUpper() : "?")
                                                    </div>
                                                }
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-bold text-slate-900 dark:text-white truncate">@contact.FullName</p>
                                                <p class="text-[10px] text-slate-400 truncate">@contact.Role @(!string.IsNullOrWhiteSpace(contact.Email) ? $"• {contact.Email}" : "")</p>
                                            </div>
                                        </div>
                                        <div class="shrink-0 ml-2">
                                            @if (isSelected)
                                            {
                                                <span class="w-5 h-5 rounded-md bg-[#00796b] text-white flex items-center justify-center text-xs font-bold">✓</span>
                                            }
                                            else
                                            {
                                                <span class="w-5 h-5 rounded-md border border-slate-300 dark:border-slate-600 flex items-center justify-center text-xs text-slate-400 hover:border-[#00796b]">+</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-slate-400 text-center py-3">No authorized contacts found</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="px-5 py-3.5 bg-slate-50 dark:bg-[#18262c] border-t border-slate-100 dark:border-slate-800 flex justify-end gap-2 text-xs">
                <button type="button" @onclick="() => _showCreateModal = false" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 font-semibold cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="CreateConversationAsync" disabled="@_isCreating" class="px-4 py-2 rounded-xl bg-[#00796b] text-white hover:bg-[#004D40] font-bold disabled:opacity-50 cursor-pointer">
                    @(_isCreating ? "Creating..." : (_newConversationType == ConversationType.Direct ? "Start Chat" : _newConversationType == ConversationType.Group ? "Create Group" : "Create Channel"))
                </button>
            </div>

        </div>
    </div>
}

