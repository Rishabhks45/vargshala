                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 3: Recent Attendance Activity Feed -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs rounded-2xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white">Recent Attendance Activity</h3>
                </div>
                <button type="button" @onclick='() => SetActiveTab("student")'
                        class="text-[11px] font-bold text-[#009488] hover:underline cursor-pointer">
                    View All
                </button>
            </div>

            <div class="space-y-2.5 pt-1">
                @if (_overview?.RecentActivities != null && _overview.RecentActivities.Count > 0)
                {
                    @foreach (var act in _overview.RecentActivities)
                    {
                        <div class="flex items-center justify-between text-xs py-1 border-b border-slate-50 dark:border-slate-800/40 last:border-0">
                            <div class="flex items-center gap-2 truncate">
                                <span class="w-2 h-2 rounded-full shrink-0 @(act.Status == AttendanceStatus.Present ? "bg-emerald-500" : act.Status == AttendanceStatus.Late ? "bg-amber-500" : "bg-rose-500")"></span>
                                <span class="font-medium text-slate-700 dark:text-slate-200 truncate">
                                    @act.StudentName marked @act.Status
                                </span>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-400 shrink-0 ml-2">
                                @act.MarkedAtFormatted
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-xs text-slate-400">
                        No attendance recorded yet today.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

</div>

