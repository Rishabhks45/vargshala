                            <span class="text-[11px] font-semibold text-slate-400 w-10 text-right">@(CurrentPresentPercentage)%</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                            <span class="text-slate-600 dark:text-slate-300 font-medium">Absent</span>
