                                stroke="#10b981" stroke-width="3.5"
                                stroke-dasharray="@(PresentDash) 100"
                                stroke-dashoffset="0"
                                stroke-linecap="round" />

                        <!-- Late Arc (Amber) -->
                        <circle cx="18" cy="18" r="14" fill="transparent"
                                stroke="#f59e0b" stroke-width="3.5"
                                stroke-dasharray="@(LateDash) 100"
                                stroke-dashoffset="@(-PresentDash)"
