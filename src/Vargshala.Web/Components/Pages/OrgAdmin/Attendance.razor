@page "/attendance"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin,Teacher")]
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@rendermode InteractiveServer

<PageTitle>Attendance | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Attendance</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Mark and track daily student attendance across batches.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" @onclick="MarkAllPresent"
                    class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-950/80 transition-all shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Mark All Present</span>
            </button>
            <button type="button" @onclick="SaveAttendance"
                    class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Save Attendance</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Students</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_attendanceList.Count</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Present</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_attendanceList.Count(a => a.Status == "Present")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Absent</p>
                <h3 class="text-lg font-extrabold text-rose-600 dark:text-rose-400">@_attendanceList.Count(a => a.Status == "Absent")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Late</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">@_attendanceList.Count(a => a.Status == "Late")</h3>
            </div>
        </div>
    </div>

    <!-- Batch & Date Selectors -->
    <div class="card-surface p-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <CustomSelect @bind-Value="_selectedBatch" Options="_batchOptions" Placeholder="Select Batch" />
        <div class="relative">
            <input type="date" @bind="_selectedDate"
                   class="px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-bold transition-all" />
        </div>
        <div class="flex-1"></div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
            Attendance Rate: <span class="font-extrabold text-[#009488]">@AttendanceRate%</span>
        </div>
    </div>

    <!-- Attendance List -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[600px] text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                        <th class="py-3.5 px-6 w-12">#</th>
                        <th class="py-3.5 px-4">Student</th>
                        <th class="py-3.5 px-4">Roll No</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-4">Monthly %</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                    @{ var index = 0; }
                    @foreach (var record in _attendanceList)
                    {
                        index++;
                        var currentRecord = record;
                        <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors">
                            <td class="py-3.5 px-6 text-slate-400 dark:text-slate-500 font-medium">@index</td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold text-[10px] flex items-center justify-center shrink-0">
                                        @record.Initials
                                    </div>
                                    <span class="font-bold text-slate-900 dark:text-white">@record.Name</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4 font-semibold text-slate-600 dark:text-slate-400">@record.RollNumber</td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button type="button" @onclick="() => SetStatus(currentRecord, StatusPresent)"
                                            class="px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all cursor-pointer @(record.Status == "Present" ? "bg-emerald-500 text-white shadow-sm" : "bg-slate-50 dark:bg-[#18262c] text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-700 dark:hover:text-emerald-300")">
                                        P
                                    </button>
                                    <button type="button" @onclick="() => SetStatus(currentRecord, StatusAbsent)"
                                            class="px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all cursor-pointer @(record.Status == "Absent" ? "bg-rose-500 text-white shadow-sm" : "bg-slate-50 dark:bg-[#18262c] text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-rose-50 dark:hover:bg-rose-950/50 hover:text-rose-700 dark:hover:text-rose-300")">
                                        A
                                    </button>
                                    <button type="button" @onclick="() => SetStatus(currentRecord, StatusLate)"
                                            class="px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all cursor-pointer @(record.Status == "Late" ? "bg-amber-500 text-white shadow-sm" : "bg-slate-50 dark:bg-[#18262c] text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-amber-50 dark:hover:bg-amber-950/50 hover:text-amber-700 dark:hover:text-amber-300")">
                                        L
                                    </button>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-14 h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full rounded-full bg-[#009488]" style="width: @(record.MonthlyPercent)%"></div>
                                    </div>
                                    <span class="font-bold text-[11px] text-slate-600 dark:text-slate-400">@record.MonthlyPercent%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Monthly Calendar Heatmap -->
    <div class="card-surface p-5 space-y-3">
        <h3 class="text-sm font-bold text-slate-800 dark:text-white">Monthly Overview — September 2026</h3>
        <div class="grid grid-cols-7 gap-1.5 text-center">
            @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
            {
                <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 py-1">@day</div>
            }
            @for (int d = 1; d <= 30; d++)
            {
                var dayNum = d;
                var rate = _calendarData.ContainsKey(dayNum) ? _calendarData[dayNum] : -1;
                var bgClass = rate < 0 ? "bg-slate-50 dark:bg-[#18262c] text-slate-300 dark:text-slate-600" :
                              rate >= 90 ? "bg-emerald-500 text-white" :
                              rate >= 70 ? "bg-emerald-200 dark:bg-emerald-800 text-emerald-800 dark:text-emerald-200" :
                              rate >= 50 ? "bg-amber-200 dark:bg-amber-800 text-amber-800 dark:text-amber-200" :
                              "bg-rose-200 dark:bg-rose-800 text-rose-800 dark:text-rose-200";
                <div class="aspect-square rounded-lg text-[11px] font-bold flex items-center justify-center @bgClass transition-colors cursor-default" title="@(rate >= 0 ? $"{rate}% attendance" : "No data")">
                    @dayNum
                </div>
            }
        </div>
        <div class="flex items-center gap-4 text-[10px] text-slate-500 dark:text-slate-400 pt-1">
            <div class="flex items-center gap-1"><div class="w-3 h-3 rounded bg-emerald-500"></div> 90%+</div>
            <div class="flex items-center gap-1"><div class="w-3 h-3 rounded bg-emerald-200 dark:bg-emerald-800"></div> 70-89%</div>
            <div class="flex items-center gap-1"><div class="w-3 h-3 rounded bg-amber-200 dark:bg-amber-800"></div> 50-69%</div>
            <div class="flex items-center gap-1"><div class="w-3 h-3 rounded bg-rose-200 dark:bg-rose-800"></div> &lt;50%</div>
        </div>
    </div>
</div>

@code {
    private string _selectedBatch = "Class 10 — Maths";
    private DateTime _selectedDate = DateTime.Today;

    private readonly List<CustomSelect.CustomSelectOption> _batchOptions = new()
    {
        new("Class 10 — Maths", "Class 10 — Maths"),
        new("Class 10 — Science", "Class 10 — Science"),
        new("Class 12 — Physics", "Class 12 — Physics"),
        new("Class 12 — Chemistry", "Class 12 — Chemistry"),
        new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };

    private int AttendanceRate => _attendanceList.Count > 0
        ? (int)Math.Round((double)_attendanceList.Count(a => a.Status == "Present") / _attendanceList.Count * 100)
        : 0;

    private readonly List<AttendanceRecord> _attendanceList = new()
    {
        new("Aarav Mehta", "10A-01", "Present", 96),
        new("Isha Agarwal", "10A-02", "Present", 92),
        new("Rohan Sharma", "10A-03", "Present", 88),
        new("Priya Patel", "10A-04", "Absent", 78),
        new("Karan Malhotra", "10A-05", "Present", 94),
        new("Sneha Reddy", "10A-06", "Late", 85),
        new("Arjun Verma", "10A-07", "Present", 91),
        new("Divya Singh", "10A-08", "Present", 89),
        new("Nikhil Gupta", "10A-09", "Absent", 72),
        new("Meera Iyer", "10A-10", "Present", 95),
        new("Rahul Joshi", "10A-11", "Present", 87),
        new("Ananya Rao", "10A-12", "Late", 83)
    };

    private readonly Dictionary<int, int> _calendarData = new()
    {
        { 1, 92 }, { 2, 88 }, { 3, 95 },
        { 5, 78 }, { 6, 45 }, { 7, 91 }, { 8, 93 }, { 9, 86 }, { 10, 90 },
        { 12, 88 }, { 13, 92 }, { 14, 85 }, { 15, 96 }, { 16, 72 }, { 17, 90 },
        { 19, 94 }, { 20, 91 }, { 21, 88 }, { 22, 93 }, { 23, 87 }, { 24, 95 },
        { 26, 90 }, { 27, 92 }, { 28, 86 }, { 29, 94 }, { 30, 91 }
    };

    private void MarkAllPresent()
    {
        foreach (var record in _attendanceList)
            record.Status = "Present";
    }

    private void SaveAttendance()
    {
        // Save logic — would call API
    }

    private const string StatusPresent = "Present";
    private const string StatusAbsent = "Absent";
    private const string StatusLate = "Late";

    private void SetStatus(AttendanceRecord record, string status)
    {
        record.Status = status;
    }

    public class AttendanceRecord
    {
        public string Name { get; set; }
        public string RollNumber { get; set; }
        public string Status { get; set; } // Present, Absent, Late
        public int MonthlyPercent { get; set; }
        public string Initials => string.Join("", Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();

        public AttendanceRecord(string name, string rollNumber, string status, int monthlyPercent)
        {
            Name = name; RollNumber = rollNumber; Status = status; MonthlyPercent = monthlyPercent;
        }
    }
}
