@page "/attendance"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin,BranchAdmin,1,1001,4,Teacher,2")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Batches
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Classes
@using Vargshala.Contracts.Subjects
@using Vargshala.Contracts.ClassSessions
@using Vargshala.Contracts.Attendances
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Services
@inject IBranchService BranchService
@inject IClassService ClassService
@inject ISubjectService SubjectService
@inject IBatchService BatchService
@inject IClassSessionService ClassSessionService
@inject IAttendanceService AttendanceService
@inject INotificationService Toast
@inject NavigationManager Navigation

<div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-4 transition-colors duration-200 pb-20 pr-1 select-text">

<!-- Top Header: Title & Description on Left, Filters Toolbar & "+ Take Attendance" Action on Right in ONE SINGLE LINE -->
<div class="flex items-center justify-between gap-3.5 w-full">
    <!-- Left: Header & Description -->
    <div class="shrink-0">
        <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white leading-none">Attendance</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Track and manage student attendance batch-wise.</p>
    </div>

    <!-- Right: Top Filters Toolbar & Primary "+ Take Attendance" Action (Single Row) -->
    <div class="flex items-center gap-2 shrink-0">
        <!-- Branch Filter -->
        <div class="w-36">
            <CustomSelect Value="@_selectedBranchId"
                          ValueChanged="OnBranchChanged"
                          Options="@_branchOptions"
                          Placeholder="Main Branch" />
        </div>

        <!-- Class Filter -->
        <div class="w-32">
            <CustomSelect Value="@_selectedClassId"
                          ValueChanged="OnClassChanged"
                          Options="@_classOptions"
                          Placeholder="Physics" />
        </div>

        <!-- Batch Filter -->
        <div class="w-40">
            <CustomSelect Value="@_selectedBatchId"
                          ValueChanged="OnBatchChanged"
                          Options="@_batchOptions"
                          Placeholder="Physics Batch 2" />
        </div>

        <!-- Date Picker: Styled pill with calendar icon and up-down arrows matching snapshot -->
        <div class="relative flex items-center h-10 px-3 py-2 bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl shadow-2xs gap-2 cursor-pointer hover:border-slate-300 dark:hover:border-slate-600 transition-colors">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 select-none whitespace-nowrap">
                @_selectedDate.ToString("dd MMM yyyy")@(_selectedDate == DateOnly.FromDateTime(DateTime.Today) ? " (Today)" : "")
            </span>
            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
            </svg>
            <input type="date"
                   value="@_selectedDate.ToString("yyyy-MM-dd")"
                   @onchange="OnDateChanged"
                   class="absolute inset-0 opacity-0 w-full h-full cursor-pointer" />
        </div>

        <!-- Primary Action: + Take Attendance (Dark forest green matching snapshot) -->
        <button type="button" @onclick="OpenTakeAttendanceModal"
                class="h-10 px-4 rounded-xl text-xs font-bold text-white bg-[#004D40] hover:bg-[#00382E] active:scale-98 shadow-sm flex items-center gap-1.5 transition-all cursor-pointer shrink-0">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            <span>Take Attendance</span>
        </button>
    </div>
</div>

<!-- Hero Cards Row: All 5 Cards in ONE SINGLE LINE Matching Reference Snapshot -->
<div class="grid grid-cols-12 gap-2.5 xl:gap-3 items-stretch w-full" style="grid-template-columns: repeat(12, minmax(0, 1fr));">
    <!-- Card 1: Selected Batch Hero Card (4 Columns) -->
    <div class="col-span-4 card-surface p-3.5 border border-tealborder shadow-2xs relative overflow-hidden flex items-center justify-between gap-3 min-w-0" style="grid-column: span 4 / span 4;">
        <div class="flex items-center gap-3 min-w-0">
            <div class="w-11 h-11 rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-[#009488] flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <div class="min-w-0">
                <h3 class="text-sm font-extrabold text-slate-800 dark:text-white truncate leading-tight">
                    @(_overview?.BatchName ?? _selectedBatch?.Name ?? "Select Batch")
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate font-medium">
                    @(_overview != null ? $"{_overview.SubjectName} ({_overview.ClassName})" : (_selectedBatch != null ? $"{_selectedBatch.SubjectName} ({_selectedBatch.ClassName})" : "No batch chosen"))
                </p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5 truncate">
                    @(_overview?.ScheduleFormatted ?? "Mon, Wed, Fri | 4:00 PM - 5:30 PM")
                </p>
            </div>
        </div>
        @if (_selectedBatch != null)
        {
            <button type="button" @onclick='() => Navigation.NavigateTo("batches")'
                    class="px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl hover:bg-slate-50 transition-all shrink-0 cursor-pointer shadow-2xs">
                View Batch Details
            </button>
        }
    </div>

    <!-- Card 2: Total Students (2 Columns) -->
    <div class="col-span-2 card-surface p-3.5 border border-tealborder shadow-2xs relative overflow-hidden flex items-center gap-3 min-w-0" style="grid-column: span 2 / span 2;">
        <div class="w-11 h-11 rounded-2xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
        </div>
        <div class="min-w-0">
            <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 truncate">Total Students</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5">@CurrentTotalStudents</h3>
        </div>
    </div>

    <!-- Card 3: Present Today (2 Columns) -->
    <div class="col-span-2 card-surface p-3.5 border border-tealborder shadow-2xs relative overflow-hidden flex items-center gap-3 min-w-0" style="grid-column: span 2 / span 2;">
        <div class="w-11 h-11 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="min-w-0">
            <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 truncate">Present Today</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5">@CurrentPresentCount</h3>
            <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5 truncate">@(CurrentPresentPercentage)%</p>
        </div>
    </div>

    <!-- Card 4: Absent Today (2 Columns) -->
    <div class="col-span-2 card-surface p-3.5 border border-tealborder shadow-2xs relative overflow-hidden flex items-center gap-3 min-w-0" style="grid-column: span 2 / span 2;">
        <div class="w-11 h-11 rounded-2xl bg-rose-50 dark:bg-rose-950/60 text-rose-500 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="min-w-0">
            <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 truncate">Absent Today</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5">@CurrentAbsentCount</h3>
            <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5 truncate">@(CurrentAbsentPercentage)%</p>
        </div>
    </div>

    <!-- Card 5: Late Today (2 Columns) -->
    <div class="col-span-2 card-surface p-3.5 border border-tealborder shadow-2xs relative overflow-hidden flex items-center gap-3 min-w-0" style="grid-column: span 2 / span 2;">
        <div class="w-11 h-11 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-500 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="min-w-0">
            <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 truncate">Late Today</p>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white leading-tight mt-0.5">@CurrentLateCount</h3>
            <p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5 truncate">@(CurrentLatePercentage)%</p>
        </div>
    </div>
</div>

<!-- Main Content Grid: 8 Cols Tabs & Tables | 4 Cols Overview Widgets -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
    
    <!-- Left Section (Tabs & Tables) - 8 Cols -->
    <div class="lg:col-span-8 space-y-3.5">
        <!-- Navigation Tabs Bar -->
        <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800">
            <button type="button" @onclick='() => SetActiveTab("student")'
                    class="pb-3 px-3 text-xs font-bold flex items-center gap-2 border-b-2 transition-all cursor-pointer @(_activeTab == "student" ? "text-[#009488] border-[#009488]" : "text-slate-500 hover:text-slate-700 dark:text-slate-400 border-transparent")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                </svg>
                <span>Student Attendance</span>
            </button>
            <button type="button" @onclick='() => SetActiveTab("batch")'
                    class="pb-3 px-3 text-xs font-bold flex items-center gap-2 border-b-2 transition-all cursor-pointer @(_activeTab == "batch" ? "text-[#009488] border-[#009488]" : "text-slate-500 hover:text-slate-700 dark:text-slate-400 border-transparent")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Batch Overview</span>
            </button>
            <button type="button" @onclick='() => SetActiveTab("date")'
                    class="pb-3 px-3 text-xs font-bold flex items-center gap-2 border-b-2 transition-all cursor-pointer @(_activeTab == "date" ? "text-[#009488] border-[#009488]" : "text-slate-500 hover:text-slate-700 dark:text-slate-400 border-transparent")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>Date-wise Report</span>
            </button>
            <button type="button" @onclick='() => SetActiveTab("student-report")'
                    class="pb-3 px-3 text-xs font-bold flex items-center gap-2 border-b-2 transition-all cursor-pointer @(_activeTab == "student-report" ? "text-[#009488] border-[#009488]" : "text-slate-500 hover:text-slate-700 dark:text-slate-400 border-transparent")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Student-wise Report</span>
            </button>
        </div>

        <!-- TAB 1: STUDENT ATTENDANCE -->
        @if (_activeTab == "student")
        {
            <div class="card-surface rounded-2xl border border-tealborder shadow-2xs overflow-hidden">
                <!-- Session Selector / Banner if multiple sessions exist on this date -->
                @if (_daySessions.Count > 1)
                {
                    <div class="p-3 bg-teal-50/60 dark:bg-teal-950/40 border-b border-teal-100 dark:border-teal-900/40 flex items-center justify-between gap-3">
                        <span class="text-xs font-bold text-teal-800 dark:text-teal-200">
                            Multiple Sessions on @_selectedDate.ToString("dd MMM yyyy"):
                        </span>
                        <div class="flex items-center gap-2">
                            @foreach (var sess in _daySessions)
                            {
                                <button type="button" @onclick="() => SelectSessionAsync(sess.Id)"
                                        class="px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-all @(sess.Id.ToString() == _selectedSessionId ? "bg-[#009488] text-white shadow-xs" : "bg-white dark:bg-[#142025] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700")">
                                    @sess.StartTime.ToString("hh:mm tt") - @sess.EndTime.ToString("hh:mm tt") (@(sess.TeacherName ?? "Teacher"))
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Card Header: Title + [Mark All Present] + [Mark All Absent] + [Save Attendance] -->
                <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800 dark:text-white">
                                Students in @(_sheet?.BatchName ?? _selectedBatch?.Name ?? "Selected Batch")
                            </h3>
                            <p class="text-xs text-slate-400 mt-0.5">
                                Mark attendance for @_selectedDate.ToString("dd MMM yyyy")
                                @if (_sheet != null && !string.IsNullOrEmpty(_sheet.TeacherName))
                                {
                                    <span> • Faculty: @_sheet.TeacherName</span>
                                }
                            </p>
                        </div>
                    </div>

                    <!-- Header Action Buttons (Matching Reference UI) -->
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="MarkAllPresent"
                                class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-[#15803D] bg-[#DCFCE7] hover:bg-[#BBF7D0] border border-emerald-200 transition-all cursor-pointer">
                            Mark All Present
                        </button>
                        <button type="button" @onclick="MarkAllAbsent"
                                class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-[#B91C1C] bg-[#FEE2E2] hover:bg-[#FECACA] border border-rose-200 transition-all cursor-pointer">
                            Mark All Absent
                        </button>
                        <button type="button" @onclick="SaveAttendanceAsync" disabled="@_isSaving"
                                class="px-4 py-1.5 rounded-xl text-xs font-bold text-white bg-[#009488] hover:bg-[#007A6F] active:scale-98 shadow-xs flex items-center gap-1.5 transition-all cursor-pointer disabled:opacity-50">
                            @if (_isSaving)
                            {
                                <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Save Attendance</span>
                            }
                        </button>
                    </div>
                </div>

                <!-- Search & Filter Bar: Compact Search Box on Left, Filter Pills & Menu on Right -->
                <div class="p-3.5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <!-- Search Box (Width controlled to match reference UI) -->
                    <div class="relative w-full sm:w-64 md:w-72">
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" @bind="_studentSearchQuery" @bind:event="oninput"
                               placeholder="Search by name or roll no..."
                               class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-[#142025] border border-slate-200 dark:border-slate-700/80 rounded-xl text-slate-700 dark:text-slate-200 focus:outline-none focus:border-[#009488] transition-all" />
                    </div>

                    <!-- Filter Pills & Ellipsis Action Menu (Right Aligned) -->
                    <div class="flex items-center gap-1.5">
                        <button type="button" @onclick='() => _statusFilter = "ALL"'
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer @(_statusFilter == "ALL" ? "bg-slate-800 text-white dark:bg-white dark:text-slate-900 shadow-2xs" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 hover:bg-slate-200")">
                            All (@(_sheet?.Students.Count ?? 0))
                        </button>
                        <button type="button" @onclick='() => _statusFilter = AttendanceStatus.Present'
                                class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer @(_statusFilter == AttendanceStatus.Present ? "bg-emerald-600 text-white shadow-2xs" : "bg-white dark:bg-[#18262c] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50")">
                            Present (@CurrentPresentCount)
                        </button>
                        <button type="button" @onclick='() => _statusFilter = AttendanceStatus.Absent'
                                class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer @(_statusFilter == AttendanceStatus.Absent ? "bg-rose-600 text-white shadow-2xs" : "bg-white dark:bg-[#18262c] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50")">
                            Absent (@CurrentAbsentCount)
                        </button>
                        <button type="button" @onclick='() => _statusFilter = AttendanceStatus.Late'
                                class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer @(_statusFilter == AttendanceStatus.Late ? "bg-amber-600 text-white shadow-2xs" : "bg-white dark:bg-[#18262c] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50")">
                            Late (@CurrentLateCount)
                        </button>
                        <button type="button" class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-all cursor-pointer ml-0.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Attendance Table Content -->
                @if (_isLoadingSheet)
                {
                    <div class="p-12 flex flex-col items-center justify-center text-center">
                        <div class="w-8 h-8 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
                        <p class="text-xs font-semibold text-slate-500 mt-3">Loading session attendance records...</p>
                    </div>
                }
                else if (string.IsNullOrEmpty(_selectedSessionId) && _daySessions.Count == 0)
                {
                    <!-- Requirement #23: NO SESSION CASE -->
                    <div class="p-12 flex flex-col items-center justify-center text-center">
                        <div class="w-14 h-14 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center mb-3">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="text-sm font-bold text-slate-800 dark:text-white">No Class Session Found</h4>
                        <p class="text-xs text-slate-400 max-w-sm mt-1">No class session found for this batch on @_selectedDate.ToString("dd MMMM yyyy").</p>
                        <div class="mt-4 flex items-center gap-2">
                            <button type="button" @onclick='() => Navigation.NavigateTo("class-sessions")'
                                    class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#009488] hover:bg-[#007A6F] shadow-xs transition-all cursor-pointer">
                                Create Class Session
                            </button>
                            <button type="button" @onclick="SetDateToToday"
                                    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 transition-all cursor-pointer">
                                Select Today's Date
                            </button>
                        </div>
                    </div>
                }
                else if (_sheet == null || _sheet.Students.Count == 0)
                {
                    <div class="p-12 flex flex-col items-center justify-center text-center">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mb-3">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <h4 class="text-sm font-bold text-slate-800 dark:text-white">No Enrolled Students</h4>
                        <p class="text-xs text-slate-400 max-w-sm mt-1">This batch does not have any active enrolled students yet.</p>
                        <button type="button" @onclick='() => Navigation.NavigateTo("batches")'
                                class="mt-4 px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#009488] hover:bg-[#007A6F] shadow-xs transition-all cursor-pointer">
                            Enroll Students in Batch
                        </button>
                    </div>
                }
                else
                {
                    <!-- Requirement #24: ALREADY MARKED NOTICE -->
                    @if (_sheet.IsAttendanceMarked)
                    {
                        <div class="px-4 py-2 bg-emerald-50/80 dark:bg-emerald-950/30 border-b border-emerald-100 dark:border-emerald-900/40 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-xs font-semibold text-emerald-800 dark:text-emerald-300">
                                Attendance already recorded for this session. Changes will update existing records.
                            </span>
                        </div>
                    }

                    <!-- Student Attendance Table (Pixel-perfect matching reference image) -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider bg-slate-50/50 dark:bg-[#142025]/50">
                                    <th class="py-3 px-3 w-10 text-center">
                                        <input type="checkbox" @bind="_selectAllChecked" @bind:after="OnSelectAllToggled"
                                               class="rounded border-slate-300 text-[#009488] focus:ring-0 cursor-pointer" />
                                    </th>
                                    <th class="py-3 px-2 w-10 text-center">#</th>
                                    <th class="py-3 px-3 w-20">Roll No.</th>
                                    <th class="py-3 px-4">Student Name</th>
                                    <th class="py-3 px-4">Attendance Status</th>
                                    <th class="py-3 px-4">Check-in Time</th>
                                    <th class="py-3 px-4">Remarks</th>
                                    <th class="py-3 px-3 w-12 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                                @for (int i = 0; i < FilteredStudents.Count; i++)
                                {
                                    var studentIndex = i;
                                    var s = FilteredStudents[studentIndex];
                                    <tr class="hover:bg-slate-50/80 dark:hover:bg-[#142025]/40 transition-colors">
                                        <td class="py-3 px-3 text-center">
                                            <input type="checkbox" checked="@_selectedStudentIds.Contains(s.StudentId)"
                                                   @onchange="(e) => ToggleStudentSelected(s.StudentId, (bool)(e.Value ?? false))"
                                                   class="rounded border-slate-300 text-[#009488] focus:ring-0 cursor-pointer" />
                                        </td>
                                        <td class="py-3 px-2 text-center font-medium text-slate-400">@(studentIndex + 1)</td>
                                        <td class="py-3 px-3 font-semibold text-slate-700 dark:text-slate-300">
                                            @(string.IsNullOrWhiteSpace(s.RollNumber) ? (s.StudentCode ?? "-") : s.RollNumber)
                                        </td>
                                        <td class="py-3 px-4 font-bold text-slate-800 dark:text-white">
                                            @s.StudentName
                                        </td>
                                        
                                        <!-- Attendance Status Badge Button (Matching reference UI badge pill) -->
                                        <td class="py-3 px-4">
                                            @if (s.Status == AttendanceStatus.Present)
                                            {
                                                <button type="button" @onclick="() => CycleStudentStatus(s)"
                                                        title="Click to toggle status"
                                                        class="px-3.5 py-1 rounded-full text-[11px] font-bold bg-[#DCFCE7] text-[#15803D] hover:ring-2 hover:ring-emerald-400/30 transition-all cursor-pointer">
                                                    Present
                                                </button>
                                            }
                                            else if (s.Status == AttendanceStatus.Absent)
                                            {
                                                <button type="button" @onclick="() => CycleStudentStatus(s)"
                                                        title="Click to toggle status"
                                                        class="px-3.5 py-1 rounded-full text-[11px] font-bold bg-[#FEE2E2] text-[#B91C1C] hover:ring-2 hover:ring-rose-400/30 transition-all cursor-pointer">
                                                    Absent
                                                </button>
                                            }
                                            else if (s.Status == AttendanceStatus.Late)
                                            {
                                                <button type="button" @onclick="() => CycleStudentStatus(s)"
                                                        title="Click to toggle status"
                                                        class="px-3.5 py-1 rounded-full text-[11px] font-bold bg-[#FEF3C7] text-[#B45309] hover:ring-2 hover:ring-amber-400/30 transition-all cursor-pointer">
                                                    Late
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => CycleStudentStatus(s)"
                                                        title="Click to toggle status"
                                                        class="px-3.5 py-1 rounded-full text-[11px] font-bold bg-blue-100 text-blue-800 hover:ring-2 hover:ring-blue-400/30 transition-all cursor-pointer">
                                                    Excused
                                                </button>
                                            }
                                        </td>

                                        <!-- Check-in Time -->
                                        <td class="py-3 px-4 font-medium text-slate-600 dark:text-slate-300">
                                            @if (s.Status == AttendanceStatus.Absent)
                                            {
                                                <span class="text-slate-400">-</span>
                                            }
                                            else
                                            {
                                                <span>@s.CheckInTimeFormatted</span>
                                            }
                                        </td>

                                        <!-- Remarks -->
                                        <td class="py-3 px-4 min-w-[140px]">
                                            <input type="text" @bind="s.Remarks"
                                                   placeholder="-"
                                                   class="w-full px-2 py-1 text-xs bg-transparent border-0 focus:outline-none focus:bg-slate-50 dark:focus:bg-[#142025] rounded-md text-slate-600 dark:text-slate-300" />
                                        </td>

                                        <!-- Action Menu Button -->
                                        <td class="py-3 px-3 text-center">
                                            <button type="button" @onclick="() => CycleStudentStatus(s)"
                                                    title="Change Status"
                                                    class="p-1 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Footer -->
                    <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500">
                        <span>Showing 1 to @FilteredStudents.Count of @(_sheet?.Students.Count ?? 0) students</span>
                        <div class="flex items-center gap-1">
                            <button type="button" class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer disabled:opacity-40">
                                ‹
                            </button>
                            <button type="button" class="w-7 h-7 rounded-lg bg-[#004D40] text-white font-bold flex items-center justify-center cursor-pointer">
                                1
                            </button>
                            <button type="button" class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer disabled:opacity-40">
                                ›
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- TAB 2: BATCH OVERVIEW -->
        @if (_activeTab == "batch")
        {
            <div class="card-surface rounded-2xl border border-tealborder shadow-2xs p-6 space-y-6">
                <div>
                    <h3 class="text-base font-bold text-slate-800 dark:text-white">Batch Attendance Analysis</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Comprehensive attendance performance for @(_overview?.BatchName ?? "selected batch")</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#142025] border border-slate-200/60 dark:border-slate-800">
                        <p class="text-xs font-semibold text-slate-400">Total Enrolled</p>
                        <h4 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@(_overview?.TotalStudents ?? 0)</h4>
                        <p class="text-[11px] text-slate-500 mt-1">Active batch students</p>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#142025] border border-slate-200/60 dark:border-slate-800">
                        <p class="text-xs font-semibold text-slate-400">Today's Attendance Rate</p>
                        <h4 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@(_overview?.TodayAttendancePercentage ?? 0)%</h4>
                        <p class="text-[11px] text-slate-500 mt-1">Present + Late students</p>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#142025] border border-slate-200/60 dark:border-slate-800">
                        <p class="text-xs font-semibold text-slate-400">Weekly Performance</p>
                        <h4 class="text-2xl font-black text-[#009488] mt-1">
                            @(GetWeeklyAveragePercentage())%
                        </h4>
                        <p class="text-[11px] text-slate-500 mt-1">7-Day average attendance</p>
                    </div>
                </div>

                <!-- 7-Day Table Breakdown -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                                <th class="py-2.5 px-3">Date</th>
                                <th class="py-2.5 px-3">Day</th>
                                <th class="py-2.5 px-3">Present</th>
                                <th class="py-2.5 px-3">Late</th>
                                <th class="py-2.5 px-3">Absent</th>
                                <th class="py-2.5 px-3">Rate</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                            @if (_overview?.DailyTrends != null)
                            {
                                @foreach (var t in _overview.DailyTrends)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-[#142025]/50">
                                        <td class="py-2.5 px-3 font-semibold text-slate-700 dark:text-slate-300">@t.DateShortFormatted</td>
                                        <td class="py-2.5 px-3 text-slate-500">@t.DayOfWeekShort</td>
                                        <td class="py-2.5 px-3 font-bold text-emerald-600">@t.PresentCount</td>
                                        <td class="py-2.5 px-3 font-bold text-amber-600">@t.LateCount</td>
                                        <td class="py-2.5 px-3 font-bold text-rose-600">@t.AbsentCount</td>
                                        <td class="py-2.5 px-3">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                    <div class="h-full bg-[#009488] rounded-full" style="width: @t.Percentage%"></div>
                                                </div>
                                                <span class="font-bold text-slate-700 dark:text-slate-200">@t.Percentage%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- TAB 3: DATE-WISE REPORT -->
        @if (_activeTab == "date")
        {
            <div class="card-surface rounded-2xl border border-tealborder shadow-2xs overflow-hidden">
                <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white">Date-wise Attendance Report</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Historical session attendance log for this batch</p>
                    </div>
                    <button type="button" @onclick="ReloadDateWiseReportAsync"
                            class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all cursor-pointer">
                        Refresh Report
                    </button>
                </div>

                @if (_isLoadingDateReports)
                {
                    <div class="p-12 flex flex-col items-center justify-center text-center">
                        <div class="w-8 h-8 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
                        <p class="text-xs font-semibold text-slate-500 mt-3">Loading historical date reports...</p>
                    </div>
                }
                else if (_dateReports.Count == 0)
                {
                    <div class="p-12 text-center text-xs text-slate-400">
                        No class sessions recorded yet for this batch.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider bg-slate-50/50 dark:bg-[#142025]/50">
                                    <th class="py-3 px-3">Date</th>
                                    <th class="py-3 px-3">Session Timing</th>
                                    <th class="py-3 px-3">Faculty</th>
                                    <th class="py-3 px-3">Total</th>
                                    <th class="py-3 px-3 text-emerald-600">Present</th>
                                    <th class="py-3 px-3 text-rose-600">Absent</th>
                                    <th class="py-3 px-3 text-amber-600">Late</th>
                                    <th class="py-3 px-3">Rate</th>
                                    <th class="py-3 px-3 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var r in _dateReports)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-[#142025]/50">
                                        <td class="py-3 px-3 font-bold text-slate-800 dark:text-white">@r.SessionDate.ToString("dd MMM yyyy")</td>
                                        <td class="py-3 px-3 text-slate-600 dark:text-slate-300">@r.StartTime.ToString("hh:mm tt") - @r.EndTime.ToString("hh:mm tt")</td>
                                        <td class="py-3 px-3 text-slate-500">@r.TeacherName</td>
                                        <td class="py-3 px-3 font-semibold">@r.TotalStudents</td>
                                        <td class="py-3 px-3 font-bold text-emerald-600">@r.PresentCount</td>
                                        <td class="py-3 px-3 font-bold text-rose-600">@r.AbsentCount</td>
                                        <td class="py-3 px-3 font-bold text-amber-600">@r.LateCount</td>
                                        <td class="py-3 px-3 font-extrabold text-slate-800 dark:text-white">@r.AttendancePercentage%</td>
                                        <td class="py-3 px-3 text-center">
                                            <button type="button" @onclick="() => SelectSessionFromReportAsync(r.SessionId, r.SessionDate)"
                                                    class="px-2.5 py-1 text-[11px] font-bold text-[#009488] bg-teal-50 dark:bg-teal-950/40 rounded-lg hover:bg-teal-100 transition-all cursor-pointer">
                                                Open Sheet
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <!-- TAB 4: STUDENT-WISE REPORT -->
        @if (_activeTab == "student-report")
        {
            <div class="card-surface rounded-2xl border border-tealborder shadow-2xs overflow-hidden">
                <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white">Student-wise Attendance Report</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Aggregate attendance percentage per student across all sessions</p>
                    </div>
                    <button type="button" @onclick="ReloadStudentWiseReportAsync"
                            class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all cursor-pointer">
                        Refresh Report
                    </button>
                </div>

                @if (_isLoadingStudentReports)
                {
                    <div class="p-12 flex flex-col items-center justify-center text-center">
                        <div class="w-8 h-8 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></div>
                        <p class="text-xs font-semibold text-slate-500 mt-3">Loading student reports...</p>
                    </div>
                }
                else if (_studentReports.Count == 0)
                {
                    <div class="p-12 text-center text-xs text-slate-400">
                        No student records found for this batch.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider bg-slate-50/50 dark:bg-[#142025]/50">
                                    <th class="py-3 px-3">Roll No.</th>
                                    <th class="py-3 px-4">Student Name</th>
                                    <th class="py-3 px-3 text-center">Total Classes</th>
                                    <th class="py-3 px-3 text-center text-emerald-600">Present</th>
                                    <th class="py-3 px-3 text-center text-rose-600">Absent</th>
                                    <th class="py-3 px-3 text-center text-amber-600">Late</th>
                                    <th class="py-3 px-4">Attendance Rate</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var sr in _studentReports)
                                {
                                    <tr class="hover:bg-slate-50/50 dark:hover:bg-[#142025]/50">
                                        <td class="py-3 px-3 font-semibold text-slate-700 dark:text-slate-300">
                                            @(string.IsNullOrWhiteSpace(sr.RollNumber) ? (sr.StudentCode ?? "-") : sr.RollNumber)
                                        </td>
                                        <td class="py-3 px-4 font-bold text-slate-800 dark:text-white">
                                            @sr.FullName
                                        </td>
                                        <td class="py-3 px-3 text-center font-bold">@sr.TotalClasses</td>
                                        <td class="py-3 px-3 text-center font-bold text-emerald-600">@sr.PresentCount</td>
                                        <td class="py-3 px-3 text-center font-bold text-rose-600">@sr.AbsentCount</td>
                                        <td class="py-3 px-3 text-center font-bold text-amber-600">@sr.LateCount</td>
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-20 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                    <div class="h-full rounded-full @(sr.AttendancePercentage >= 80 ? "bg-emerald-500" : sr.AttendancePercentage >= 60 ? "bg-amber-500" : "bg-rose-500")"
                                                         style="width: @sr.AttendancePercentage%"></div>
                                                </div>
                                                <span class="font-extrabold @(sr.AttendancePercentage >= 80 ? "text-emerald-600" : sr.AttendancePercentage >= 60 ? "text-amber-600" : "text-rose-600")">
                                                    @sr.AttendancePercentage%
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Right Column Widgets (4 Cols) - Follows Reference UI -->
    <div class="lg:col-span-4 space-y-4">
        <!-- Widget 1: Batch Attendance Overview (7-Day Bar Chart) -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs rounded-2xl space-y-3.5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white">Batch Attendance Overview</h3>
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white dark:bg-[#18262c] px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700/80 shadow-2xs">
                    Last 7 Days
                </span>
            </div>

            <!-- Vertical Bar Chart with 7 Days -->
            <div class="pt-2">
                <div class="h-44 flex items-end justify-between gap-1.5 px-2 pb-1 border-b border-slate-100 dark:border-slate-800 relative">
                    <!-- Y-axis guide lines (subtle) -->
