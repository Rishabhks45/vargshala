@code {
// Top Filter State
private List<BranchDto> _branches = new();
private List<CustomSelect.CustomSelectOption> _branchOptions = new();
private string _selectedBranchId = string.Empty;

private List<ClassLookupDto> _classes = new();
private List<CustomSelect.CustomSelectOption> _classOptions = new();
private string _selectedClassId = string.Empty;

private List<BatchDto> _batches = new();
private List<CustomSelect.CustomSelectOption> _batchOptions = new();
private string _selectedBatchId = string.Empty;
private BatchDto? _selectedBatch => _batches.FirstOrDefault(b => b.Id.ToString() == _selectedBatchId);

private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);

// Active Tab: "student", "batch", "date", "student-report"
private string _activeTab = "student";

// Sessions for the selected Batch & Date
private List<ClassSessionDto> _daySessions = new();
private string _selectedSessionId = string.Empty;

// Overview & Sheet DTOs
private BatchAttendanceOverviewDto? _overview;
private SessionAttendanceSheetDto? _sheet;

// Reports DTOs
private List<DateAttendanceReportDto> _dateReports = new();
private List<StudentAttendanceReportDto> _studentReports = new();

// UI Loading & Filter states
private bool _isLoadingSheet = false;
private bool _isLoadingDateReports = false;
private bool _isLoadingStudentReports = false;
private bool _isSaving = false;

private string _studentSearchQuery = string.Empty;
private string _statusFilter = "ALL"; // ALL, Present, Absent, Late
private bool _selectAllChecked = false;
private HashSet<Guid> _selectedStudentIds = new();

// Take Attendance Modal State
private bool _showTakeAttendanceModal = false;
private string _modalBranchId = string.Empty;
private string _modalClassId = string.Empty;
private List<CustomSelect.CustomSelectOption> _modalClassOptions = new();
private string _modalBatchId = string.Empty;
private List<CustomSelect.CustomSelectOption> _modalBatchOptions = new();
private DateOnly _modalDate = DateOnly.FromDateTime(DateTime.Today);
private List<ClassSessionDto> _modalSessions = new();
private List<CustomSelect.CustomSelectOption> _modalSessionOptions = new();
private string _modalSessionId = string.Empty;
private bool _isModalLoadingSessions = false;

// Filtered Student List for Tab 1
private List<StudentAttendanceItemDto> FilteredStudents
{
    get
    {
        if (_sheet == null) return new();
        var list = _sheet.Students.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_studentSearchQuery))
        {
            var q = _studentSearchQuery.Trim().ToLower();
            list = list.Where(s =>
                s.StudentName.ToLower().Contains(q) ||
                (s.RollNumber != null && s.RollNumber.ToLower().Contains(q)) ||
                (s.StudentCode != null && s.StudentCode.ToLower().Contains(q))
            );
        }

        if (_statusFilter != "ALL")
        {
            list = list.Where(s => s.Status == _statusFilter);
        }

        return list.ToList();
    }
}

// Dynamic Counts from currently marked/sheet state (not hardcoded)
private int CurrentPresentCount => _sheet?.Students.Count(s => s.Status == AttendanceStatus.Present) ?? _overview?.TodayPresent ?? 0;
private int CurrentAbsentCount => _sheet?.Students.Count(s => s.Status == AttendanceStatus.Absent) ?? _overview?.TodayAbsent ?? 0;
private int CurrentLateCount => _sheet?.Students.Count(s => s.Status == AttendanceStatus.Late) ?? _overview?.TodayLate ?? 0;
private int CurrentTotalStudents => _sheet?.TotalStudents ?? _overview?.TotalStudents ?? 0;

private double CurrentPresentPercentage => CurrentTotalStudents > 0
    ? Math.Round((double)CurrentPresentCount / CurrentTotalStudents * 100, 1)
    : 0;

private double CurrentAbsentPercentage => CurrentTotalStudents > 0
    ? Math.Round((double)CurrentAbsentCount / CurrentTotalStudents * 100, 1)
    : 0;

private double CurrentLatePercentage => CurrentTotalStudents > 0
    ? Math.Round((double)CurrentLateCount / CurrentTotalStudents * 100, 1)
    : 0;

// Donut chart arc calculations (circumference for r=14 is 2 * pi * 14 ≈ 88)
private double PresentDash => Math.Round(CurrentPresentPercentage * 0.88, 1);
private double AbsentDash => Math.Round(CurrentAbsentPercentage * 0.88, 1);
private double LateDash => Math.Round(CurrentLatePercentage * 0.88, 1);

protected override async Task OnInitializedAsync()
{
    await LoadBranchesAsync();
    await LoadClassesAsync();
    await LoadBatchesAsync();
}

private async Task LoadBranchesAsync()
{
    try
    {
        var res = await BranchService.GetAllActiveBranchesAsync();
        if (res.Success && res.Data != null)
        {
            _branches = res.Data;
            _branchOptions = _branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)).ToList();
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Failed to load branches: " + ex.Message);
    }
}

private async Task LoadClassesAsync(Guid? branchId = null)
{
    try
    {
        var res = await ClassService.GetAllActiveClassesAsync(branchId);
        if (res.Success && res.Data != null)
        {
            _classes = res.Data;
            _classOptions = _classes.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)).ToList();
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Failed to load classes: " + ex.Message);
    }
}

private async Task LoadBatchesAsync(Guid? classId = null)
{
    try
    {
        var res = await BatchService.GetAllActiveBatchesAsync(classId);
        if (res.Success && res.Data != null)
        {
            _batches = res.Data;
            _batchOptions = _batches.Select(b => new CustomSelect.CustomSelectOption(
                b.Id.ToString(),
                $"{b.Name} ({b.ClassName} - {b.SubjectName})"
            )).ToList();

            if (_batches.Count > 0 && string.IsNullOrEmpty(_selectedBatchId))
            {
                _selectedBatchId = _batches[0].Id.ToString();
                await OnBatchSelectedAsync(Guid.Parse(_selectedBatchId));
            }
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Failed to load batches: " + ex.Message);
    }
}

private async Task OnBranchChanged(string branchIdStr)
{
    _selectedBranchId = branchIdStr;
    _selectedClassId = string.Empty;
    _selectedBatchId = string.Empty;

    Guid? bId = Guid.TryParse(branchIdStr, out var id) ? id : null;
    await LoadClassesAsync(bId);
    await LoadBatchesAsync(null);
}

private async Task OnClassChanged(string classIdStr)
{
    _selectedClassId = classIdStr;
    _selectedBatchId = string.Empty;

    Guid? cId = Guid.TryParse(classIdStr, out var id) ? id : null;
    await LoadBatchesAsync(cId);
}

private async Task OnBatchChanged(string batchIdStr)
{
    _selectedBatchId = batchIdStr;
    if (Guid.TryParse(batchIdStr, out var batchId))
    {
        await OnBatchSelectedAsync(batchId);
    }
}

private async Task OnDateChanged(ChangeEventArgs e)
{
    if (DateOnly.TryParse(e.Value?.ToString(), out var d))
    {
        _selectedDate = d;
        if (Guid.TryParse(_selectedBatchId, out var batchId))
        {
            await ReloadBatchSessionsAndSheetAsync(batchId);
        }
    }
}

private void SetDateToToday()
{
    _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    if (Guid.TryParse(_selectedBatchId, out var batchId))
    {
        _ = ReloadBatchSessionsAndSheetAsync(batchId);
    }
}

private async Task OnBatchSelectedAsync(Guid batchId)
{
    // 1. Load Batch Overview (Timings, 7-day trend, recent activities)
    await LoadBatchOverviewAsync(batchId);

    // 2. Load ClassSessions for this batch on _selectedDate
    await ReloadBatchSessionsAndSheetAsync(batchId);

    // 3. Preload reports if active tab requires it
    if (_activeTab == "date") await ReloadDateWiseReportAsync();
    if (_activeTab == "student-report") await ReloadStudentWiseReportAsync();
}

private async Task LoadBatchOverviewAsync(Guid batchId)
{
    try
    {
        var res = await AttendanceService.GetBatchOverviewAsync(batchId, _selectedDate);
        if (res.Success && res.Data != null)
        {
            _overview = res.Data;
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Failed to load batch overview: " + ex.Message);
    }
}

private async Task ReloadBatchSessionsAndSheetAsync(Guid batchId)
{
    _isLoadingSheet = true;
    _selectedSessionId = string.Empty;
    _sheet = null;
    _daySessions = new();

    try
    {
        var res = await ClassSessionService.GetClassSessionsPagedAsync(
            new PagedRequest { PageSize = 50 },
            batchId: batchId,
            fromDate: _selectedDate,
            toDate: _selectedDate);

        if (res.Success && res.Data != null && res.Data.Items.Count > 0)
        {
            _daySessions = res.Data.Items.OrderBy(s => s.StartTime).ToList();
            _selectedSessionId = _daySessions[0].Id.ToString();
            await LoadAttendanceSheetAsync(Guid.Parse(_selectedSessionId));
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Failed to load sessions: " + ex.Message);
    }
    finally
    {
        _isLoadingSheet = false;
    }
}

private async Task SelectSessionAsync(Guid sessionId)
{
    _selectedSessionId = sessionId.ToString();
    await LoadAttendanceSheetAsync(sessionId);
}

private async Task LoadAttendanceSheetAsync(Guid sessionId)
{
    _isLoadingSheet = true;
    try
    {
        var res = await AttendanceService.GetSessionAttendanceSheetAsync(sessionId);
        if (res.Success && res.Data != null)
        {
            _sheet = res.Data;
        }
        else
        {
            _sheet = null;
            Toast.Error(res.Message ?? "Failed to load attendance sheet.");
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Error loading attendance: " + ex.Message);
    }
    finally
    {
        _isLoadingSheet = false;
    }
}

private void SetActiveTab(string tab)
{
    _activeTab = tab;
    if (tab == "date" && _dateReports.Count == 0 && Guid.TryParse(_selectedBatchId, out var bId1))
    {
        _ = ReloadDateWiseReportAsync();
    }
    else if (tab == "student-report" && _studentReports.Count == 0 && Guid.TryParse(_selectedBatchId, out var bId2))
    {
        _ = ReloadStudentWiseReportAsync();
    }
}

private async Task ReloadDateWiseReportAsync()
{
    if (!Guid.TryParse(_selectedBatchId, out var batchId)) return;
    _isLoadingDateReports = true;
    try
    {
        var res = await AttendanceService.GetDateWiseReportAsync(batchId);
        if (res.Success && res.Data != null)
        {
            _dateReports = res.Data;
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Error loading date report: " + ex.Message);
    }
    finally
    {
        _isLoadingDateReports = false;
    }
}

private async Task ReloadStudentWiseReportAsync()
{
    if (!Guid.TryParse(_selectedBatchId, out var batchId)) return;
    _isLoadingStudentReports = true;
    try
    {
        var res = await AttendanceService.GetStudentWiseReportAsync(batchId);
        if (res.Success && res.Data != null)
        {
            _studentReports = res.Data;
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Error loading student report: " + ex.Message);
    }
    finally
    {
        _isLoadingStudentReports = false;
    }
}

private async Task SelectSessionFromReportAsync(Guid sessionId, DateOnly sessionDate)
{
    _selectedDate = sessionDate;
    _selectedSessionId = sessionId.ToString();
    _activeTab = "student";
    await LoadAttendanceSheetAsync(sessionId);
}

// Status Toggling & Actions
private void CycleStudentStatus(StudentAttendanceItemDto student)
{
    student.Status = student.Status switch
    {
        AttendanceStatus.Present => AttendanceStatus.Absent,
        AttendanceStatus.Absent => AttendanceStatus.Late,
        AttendanceStatus.Late => AttendanceStatus.Excused,
        _ => AttendanceStatus.Present
    };

    if (student.Status == AttendanceStatus.Absent)
    {
        student.MarkedAt = null;
    }
    else if (!student.MarkedAt.HasValue)
    {
        student.MarkedAt = DateTime.UtcNow;
    }
}

private void MarkAllPresent()
{
    if (_sheet == null) return;
    var now = DateTime.UtcNow;
    foreach (var s in _sheet.Students)
    {
        s.Status = AttendanceStatus.Present;
        s.MarkedAt = now;
    }
    Toast.Info("All students set to Present. Click Save Attendance to commit.");
}

private void MarkAllAbsent()
{
    if (_sheet == null) return;
    foreach (var s in _sheet.Students)
    {
        s.Status = AttendanceStatus.Absent;
        s.MarkedAt = null;
    }
    Toast.Info("All students set to Absent. Click Save Attendance to commit.");
}

private void OnSelectAllToggled()
{
    if (_sheet == null) return;
    if (_selectAllChecked)
    {
        _selectedStudentIds = _sheet.Students.Select(s => s.StudentId).ToHashSet();
    }
    else
    {
        _selectedStudentIds.Clear();
    }
}

private void ToggleStudentSelected(Guid id, bool isSelected)
{
    if (isSelected) _selectedStudentIds.Add(id);
    else _selectedStudentIds.Remove(id);
    _selectAllChecked = _sheet != null && _sheet.Students.Count > 0 && _selectedStudentIds.Count == _sheet.Students.Count;
}

private async Task SaveAttendanceAsync()
{
    if (_sheet == null || !Guid.TryParse(_selectedSessionId, out var sessionId))
    {
        Toast.Error("No active session to save attendance for.");
        return;
    }

    _isSaving = true;
    try
    {
        var req = new MarkSessionAttendanceRequest
        {
            ClassSessionId = sessionId,
            Items = _sheet.Students.Select(s => new StudentAttendanceEntry
            {
                StudentId = s.StudentId,
                Status = s.Status,
                Remarks = s.Remarks
            }).ToList()
        };

        var res = await AttendanceService.SaveSessionAttendanceAsync(sessionId, req);
        if (res.Success && res.Data != null)
        {
            _sheet = res.Data;
            Toast.Success("Attendance saved successfully!");

            // Refresh overview to update 7-day trend and activity feed
            if (Guid.TryParse(_selectedBatchId, out var bId))
            {
                await LoadBatchOverviewAsync(bId);
            }
        }
        else
        {
            Toast.Error(res.Message ?? "Failed to save attendance.");
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Error saving attendance: " + ex.Message);
    }
    finally
    {
        _isSaving = false;
    }
}

// Modal Workflow Helpers (Requirement #22)
private async Task OpenTakeAttendanceModal()
{
    _modalBranchId = _selectedBranchId;
    _modalClassId = _selectedClassId;
    _modalBatchId = _selectedBatchId;
    _modalDate = _selectedDate;
    _modalSessionId = _selectedSessionId;

    // Populate modal classes
    Guid? bId = Guid.TryParse(_modalBranchId, out var bid) ? bid : null;
    var resClasses = await ClassService.GetAllActiveClassesAsync(bId);
    if (resClasses.Success && resClasses.Data != null)
    {
        _modalClassOptions = resClasses.Data.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)).ToList();
    }

    // Populate modal batches
    Guid? cId = Guid.TryParse(_modalClassId, out var cid) ? cid : null;
    var resBatches = await BatchService.GetAllActiveBatchesAsync(cId);
    if (resBatches.Success && resBatches.Data != null)
    {
        _modalBatchOptions = resBatches.Data.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)).ToList();
    }

    if (!string.IsNullOrEmpty(_modalBatchId))
    {
        await CheckModalSessionsAsync(Guid.Parse(_modalBatchId), _modalDate);
    }

    _showTakeAttendanceModal = true;
}

private async Task OnModalBranchChanged(string branchIdStr)
{
    _modalBranchId = branchIdStr;
    _modalClassId = string.Empty;
    _modalBatchId = string.Empty;
    _modalSessionId = string.Empty;
    _modalSessions.Clear();

    Guid? bId = Guid.TryParse(branchIdStr, out var id) ? id : null;
    var res = await ClassService.GetAllActiveClassesAsync(bId);
    if (res.Success && res.Data != null)
    {
        _modalClassOptions = res.Data.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)).ToList();
    }
}

private async Task OnModalClassChanged(string classIdStr)
{
    _modalClassId = classIdStr;
    _modalBatchId = string.Empty;
    _modalSessionId = string.Empty;
    _modalSessions.Clear();

    Guid? cId = Guid.TryParse(classIdStr, out var id) ? id : null;
    var res = await BatchService.GetAllActiveBatchesAsync(cId);
    if (res.Success && res.Data != null)
    {
        _modalBatchOptions = res.Data.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)).ToList();
    }
}

private async Task OnModalBatchChanged(string batchIdStr)
{
    _modalBatchId = batchIdStr;
    if (Guid.TryParse(batchIdStr, out var batchId))
    {
        await CheckModalSessionsAsync(batchId, _modalDate);
    }
}

private async Task OnModalDateChanged(ChangeEventArgs e)
{
    if (DateOnly.TryParse(e.Value?.ToString(), out var d))
    {
        _modalDate = d;
        if (Guid.TryParse(_modalBatchId, out var batchId))
        {
            await CheckModalSessionsAsync(batchId, d);
        }
    }
}

private async Task CheckModalSessionsAsync(Guid batchId, DateOnly date)
{
    _isModalLoadingSessions = true;
    _modalSessions.Clear();
    _modalSessionOptions.Clear();
    _modalSessionId = string.Empty;

    try
    {
        var res = await ClassSessionService.GetClassSessionsPagedAsync(
            new PagedRequest { PageSize = 50 },
            batchId: batchId,
            fromDate: date,
            toDate: date);

        if (res.Success && res.Data != null && res.Data.Items.Count > 0)
        {
            _modalSessions = res.Data.Items.OrderBy(s => s.StartTime).ToList();
            _modalSessionOptions = _modalSessions.Select(s => new CustomSelect.CustomSelectOption(
                s.Id.ToString(),
                $"{s.StartTime:hh:mm tt} - {s.EndTime:hh:mm tt} ({s.TeacherName ?? "Teacher"})"
            )).ToList();

            _modalSessionId = _modalSessions[0].Id.ToString();
        }
    }
    catch (Exception ex)
    {
        Toast.Error("Error checking sessions: " + ex.Message);
    }
    finally
    {
        _isModalLoadingSessions = false;
    }
}

private async Task ApplyModalSelectionAndOpenSheetAsync()
{
    if (string.IsNullOrEmpty(_modalSessionId)) return;

    _selectedBranchId = _modalBranchId;
    _selectedClassId = _modalClassId;
    _selectedBatchId = _modalBatchId;
    _selectedDate = _modalDate;
    _selectedSessionId = _modalSessionId;
    _showTakeAttendanceModal = false;
    _activeTab = "student";

    if (Guid.TryParse(_selectedBatchId, out var batchId))
    {
        await LoadBatchOverviewAsync(batchId);
        await LoadAttendanceSheetAsync(Guid.Parse(_selectedSessionId));
    }
}

private int GetWeeklyAveragePercentage()
{
    if (_overview?.DailyTrends == null || _overview.DailyTrends.Count == 0) return 0;
    var valid = _overview.DailyTrends.Where(d => d.Percentage > 0).ToList();
    return valid.Count > 0 ? (int)Math.Round(valid.Average(d => d.Percentage)) : 0;
}

