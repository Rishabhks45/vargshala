@page "/"
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>Dashboard | Vargshala</PageTitle>

<AuthorizeView Roles="OrganizationAdmin,Teacher" Context="coachDashboardContext">
    <Authorized>
        <div class="flex-1 min-h-0 h-full overflow-y-auto scrollbar-hidden space-y-6 transition-colors duration-200 pb-20">
    
    <!-- Top Dashboard Action Bar with DateRangePicker & Coral Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Overview & Analytics</h2>
            <AuthorizeView>
                <Authorized>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Welcome back, @(context.User.Identity?.Name ?? "Admin")! Here is what is happening today.</p>
                </Authorized>
                <NotAuthorized>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Welcome back! Here is what is happening today.</p>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="flex items-center gap-3">
            <!-- Blazor DateRangePicker Component -->
            <DateRangePicker RangeText="01 May, 2026 – 31 May, 2026" />

            <!-- Blazor Button Component (Coral Variant) -->
            <Button Variant="Button.ButtonVariant.Coral" 
                    Text="Export" 
                    Icon="Export" 
                    OnClick="HandleExport" />
        </div>
    </div>

    <!-- Vargshala Institute Hero Showcase Banner with Section.svg -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#004D40] via-[#00382E] to-[#002B23] border border-teal-700/60 shadow-xl p-5 sm:p-6 text-white flex flex-col lg:flex-row items-center justify-between gap-6">
        <!-- Ambient Glowing Background Spheres -->
        <div class="absolute -top-16 -left-16 w-64 h-64 bg-[#009488]/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-3 max-w-xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-900/80 border border-teal-500/40 text-[11px] font-bold text-teal-300">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Institute Management Suite Active
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
                Welcome to <span class="text-[#2DD4BF]">Vargshala</span>
            </h1>
            <p class="text-xs sm:text-sm text-teal-200/90 leading-relaxed">
                Streamlined multi-tenant coaching & institute automation. Monitor student admissions, live classroom batches, fee collections, and staff analytics in real time.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="students" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white text-xs font-bold shadow-md transition-all">
                    <span>+ New Admission</span>
                </a>
                <a href="batches" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-teal-500/30 text-white text-xs font-semibold transition-all">
                    <span>View Batches</span>
                </a>
            </div>
        </div>

        <div class="relative z-10 w-full lg:w-auto flex justify-center lg:justify-end shrink-0">
            <img src="images/Section.svg" alt="Vargshala Institutes" class="w-full max-w-sm sm:max-w-md lg:max-w-lg h-auto object-contain drop-shadow-2xl hover:scale-[1.02] transition-transform duration-300" />
        </div>
    </div>

    <!-- 4 Key Metric Cards (Blazor MetricCard Components) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <MetricCard Title="Total Students" 
                    Value="1,248" 
                    Trend="12.5%" 
                    IsPositiveTrend="true" 
                    Subtitle="from last month" 
                    Icon="Students" />

        <MetricCard Title="Total Teachers" 
                    Value="86" 
                    Trend="8.4%" 
                    IsPositiveTrend="true" 
                    Subtitle="from last month" 
                    Icon="Teachers" />

        <MetricCard Title="Total Classes" 
                    Value="64" 
                    Trend="11.3%" 
                    IsPositiveTrend="true" 
                    Subtitle="from last month" 
                    Icon="Classes" />

        <MetricCard Title="Attendance" 
                    Value="92%" 
                    Trend="6.2%" 
                    IsPositiveTrend="true" 
                    Subtitle="from last month" 
                    Icon="Attendance" />

    </div>

    <!-- Middle Section: AttendanceChart Component + RecentActivitiesCard Component -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Blazor AttendanceChart Component (7 cols) -->
        <div class="lg:col-span-7">
            <AttendanceChart Title="Attendance Overview" 
                             CurrentMonthLabel="This Month" 
                             LastMonthLabel="Last Month" />
        </div>

        <!-- Blazor RecentActivitiesCard Component (5 cols) -->
        <div class="lg:col-span-5">
            <RecentActivitiesCard Title="Recent Activities" 
                                  ViewAllUrl="activities" 
                                  Activities="_recentActivities" />
        </div>

    </div>

    <!-- Quick Links Grid using Blazor QuickLinkCard Components -->
    <div class="card-surface p-6">
        <h2 class="font-bold text-base text-slate-800 dark:text-white mb-4">Quick Links</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            
            <QuickLinkCard Title="Students" 
                           Subtitle="Manage students" 
                           Href="students" 
                           Icon="Students" 
                           IconBgClass="bg-teal-50" 
                           IconTextClass="text-brand-600" />

            <QuickLinkCard Title="Teachers" 
                           Subtitle="Manage teachers" 
                           Href="teachers" 
                           Icon="Teachers" 
                           IconBgClass="bg-emerald-50" 
                           IconTextClass="text-emerald-600" />

            <QuickLinkCard Title="Classes" 
                           Subtitle="Manage classes" 
                           Href="batches" 
                           Icon="Classes" 
                           IconBgClass="bg-blue-50" 
                           IconTextClass="text-blue-600" />

            <QuickLinkCard Title="Exams" 
                           Subtitle="Manage exams" 
                           Href="exams" 
                           Icon="Exams" 
                           IconBgClass="bg-purple-50" 
                           IconTextClass="text-purple-600" />

            <QuickLinkCard Title="Fees" 
                           Subtitle="Manage fees" 
                           Href="fees" 
                           Icon="Fees" 
                           IconBgClass="bg-coral-50" 
                           IconTextClass="text-coral-500" />

            <QuickLinkCard Title="Reports" 
                           Subtitle="View reports" 
                           Href="reports" 
                           Icon="Reports" 
                           IconBgClass="bg-amber-50" 
                           IconTextClass="text-amber-500" />

        </div>
    </div>

        </div>
    </Authorized>
</AuthorizeView>

@code {
    private readonly List<RecentActivitiesCard.ActivityItemModel> _recentActivities = new()
    {
        new()
        {
            Title = "New student added",
            Subtitle = "Rahul Sharma",
            TimeAgo = "2 min ago",
            Type = RecentActivitiesCard.ActivityType.Student
        },
        new()
        {
            Title = "Assignment submitted",
            Subtitle = "Class 10 - Maths",
            TimeAgo = "1 hour ago",
            Type = RecentActivitiesCard.ActivityType.Assignment
        },
        new()
        {
            Title = "Exam scheduled",
            Subtitle = "Class 12 - Physics",
            TimeAgo = "3 hours ago",
            Type = RecentActivitiesCard.ActivityType.Exam
        },
        new()
        {
            Title = "Fee payment received",
            Subtitle = "Arjun Verma",
            TimeAgo = "5 hours ago",
            Type = RecentActivitiesCard.ActivityType.Fee
        }
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.IsInRole("SuperAdmin") || user.IsInRole("1001"))
            {
                Navigation.NavigateTo("controlpanel/platform", replace: true);
                return;
            }

            if (user.IsInRole("Student") || user.IsInRole("3"))
            {
                Navigation.NavigateTo("student/home", replace: true);
                return;
            }
        }
    }

    private void HandleExport()
    {
        // Export logic / modal trigger
    }
}
