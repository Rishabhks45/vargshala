                        @(_selectedBranch.City ?? "—"), @(_selectedBranch.State ?? "—") @(!string.IsNullOrWhiteSpace(_selectedBranch.Pincode) ? $"- {_selectedBranch.Pincode}" : "")
                    </div>
                </div>

                <div class="border-t border-slate-100 dark:border-slate-800 pt-3 grid grid-cols-2 gap-3">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active Batches</span>
                        <div class="mt-1 font-black text-slate-800 dark:text-white text-base">@_selectedBranch.ActiveBatchesCount</div>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Enrolled Students</span>
                        <div class="mt-1 font-black text-slate-800 dark:text-white text-base">@_selectedBranch.TotalStudentsCount</div>
                    </div>
