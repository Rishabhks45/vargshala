@page "/branches"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Common
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Services
@inject IBranchService BranchService
@inject INotificationService Toast
@inject IJSRuntime JS

<PageTitle>Branch Management | Vargshala</PageTitle>

<div class="space-y-4 max-w-full">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white dark:bg-slate-900 px-5 py-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-lg bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/60 flex items-center justify-center text-teal-700 dark:text-teal-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">Branches &amp; Campuses</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Manage institution campus locations, codes, contact points, and active batches</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    @onclick="OpenAddDrawerAsync"
                    class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-white bg-teal-700 hover:bg-teal-800 active:bg-teal-900 rounded-lg shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:ring-offset-2 dark:focus:ring-offset-slate-900 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add Branch</span>
            </button>
        </div>
    </div>

    <!-- Stat Cards (No blinking - render values directly) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Total Branches -->
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Branches</p>
                <h3 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mt-1">@_totalRecords</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Across all locations</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
        </div>

        <!-- Active Branches -->
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Campuses</p>
                <h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@_activeCount</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Operational</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>

        <!-- Main Headquarters -->
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Main Branch</p>
                <h3 class="text-base font-bold text-teal-700 dark:text-teal-400 mt-1 truncate max-w-[150px]">@(_mainBranchName ?? "Not Set")</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Headquarters</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/60 flex items-center justify-center text-teal-700 dark:text-teal-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
            </div>
        </div>

        <!-- Total Batches -->
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Batches</p>
                <h3 class="text-2xl font-bold text-sky-600 dark:text-sky-400 mt-1">@_totalBatches</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Running classes</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800/60 flex items-center justify-center text-sky-600 dark:text-sky-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Filters & Actions Bar -->
    <div class="bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col md:flex-row items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <!-- Search Input -->
            <div class="relative flex-1 sm:w-64 md:w-72">
                <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text"
                       @bind="_search"
                       @bind:event="oninput"
                       @onkeyup="HandleSearchKeyUp"
                       placeholder="Search by name, code, city..."
                       class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 rounded-lg text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-teal-500 focus:border-teal-500 transition-all duration-150" />
            </div>

            <!-- Status Filter (CustomSelect) -->
            <div class="w-36">
                <CustomSelect Value="_selectedStatus"
                              ValueChanged="HandleStatusFilterChanged"
                              Options="_statusOptions"
                              Placeholder="All Status" />
            </div>
        </div>

        <div class="flex items-center gap-2 self-end md:self-auto">
            <button type="button"
                    @onclick="() => LoadDataAsync(1)"
                    title="Refresh List"
                    class="p-1.5 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors cursor-pointer">
                <svg class="w-4 h-4 @(_isLoading ? "animate-spin text-teal-600" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Data Table Card (Strictly adhering to Gold Standard) -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse table-fixed">
                <thead>
                    <tr class="bg-slate-50/75 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th class="w-[28%] px-4 py-3 cursor-pointer select-none hover:text-slate-800 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Branch Details</span>
                                <span class="text-xs">@GetSortIcon("Name")</span>
                            </div>
                        </th>
                        <th class="w-[12%] px-3 py-3 cursor-pointer select-none hover:text-slate-800 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Code")'>
                            <div class="flex items-center gap-1.5">
                                <span>Code</span>
                                <span class="text-xs">@GetSortIcon("Code")</span>
                            </div>
                        </th>
                        <th class="w-[18%] px-3 py-3 cursor-pointer select-none hover:text-slate-800 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("City")'>
                            <div class="flex items-center gap-1.5">
                                <span>Location / City</span>
                                <span class="text-xs">@GetSortIcon("City")</span>
                            </div>
                        </th>
                        <th class="w-[18%] px-3 py-3">Contact</th>
                        <th class="w-[10%] px-3 py-3 text-center">Batches</th>
                        <th class="w-[8%] px-3 py-3 text-center cursor-pointer select-none hover:text-slate-800 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("IsActive")'>
                            <div class="flex items-center justify-center gap-1">
                                <span>Status</span>
                                <span class="text-xs">@GetSortIcon("IsActive")</span>
                            </div>
                        </th>
                        <th class="w-[6%] px-4 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs @(_isLoading && _branches.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_branches.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="5" />
                    }
                    else if (!_branches.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-12 text-center text-slate-400 dark:text-slate-500">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                    <p class="font-medium text-slate-600 dark:text-slate-400">No branches found</p>
                                    <p class="text-[11px] text-slate-400 dark:text-slate-500">Try adjusting your search criteria or add a new branch.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in _branches)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Branch Details -->
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg @(b.IsMainBranch ? "bg-teal-600 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700") flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">
                                            @(b.Name.Length >= 2 ? b.Name.Substring(0, 2).ToUpperInvariant() : b.Name.ToUpperInvariant())
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-semibold text-slate-900 dark:text-slate-100 truncate block">@b.Name</span>
                                                @if (b.IsMainBranch)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-bold rounded bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-300 border border-teal-300 dark:border-teal-700/60 shrink-0">
                                                        HQ
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-[11px] text-slate-400 dark:text-slate-500 truncate block">@(b.Address ?? "No address provided")</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Code -->
                                <td class="px-3 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                        @b.Code
                                    </span>
                                </td>

                                <!-- City / State -->
                                <td class="px-3 py-3">
                                    <div class="min-w-0">
                                        <span class="font-medium text-slate-800 dark:text-slate-200 truncate block">@(b.City ?? "—")</span>
                                        <span class="text-[11px] text-slate-400 dark:text-slate-500 truncate block">@(b.State ?? "—")</span>
                                    </div>
                                </td>

                                <!-- Contact -->
                                <td class="px-3 py-3">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                                            <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                            </svg>
                                            <span class="truncate">@(b.Mobile ?? "—")</span>
                                        </div>
                                        <div class="flex items-center gap-1 text-[11px] text-slate-400 dark:text-slate-500 truncate mt-0.5">
                                            <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                            </svg>
                                            <span class="truncate">@(b.Email ?? "—")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(b.BranchAdminName))
                                        {
                                            <div class="flex items-center gap-1 text-[10px] text-teal-600 dark:text-teal-400 font-semibold truncate mt-0.5" title="@($"Branch Admin: {b.BranchAdminName}")">
                                                <span class="truncate">👤 @b.BranchAdminName</span>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Batches -->
                                <td class="px-3 py-3 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                        @b.ActiveBatchesCount
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="px-3 py-3 text-center">
                                    @if (b.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- View Details -->
                                        <button type="button"
                                                @onclick="() => OpenDetailsModal(b)"
                                                title="View Details"
                                                class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded transition-colors cursor-pointer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </button>

                                        <!-- Edit -->
                                        <button type="button"
                                                @onclick="() => OpenEditDrawerAsync(b)"
                                                title="Edit Branch"
                                                class="p-1 text-slate-400 hover:text-teal-700 dark:hover:text-teal-400 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded transition-colors cursor-pointer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                            </svg>
                                        </button>

                                        <!-- Delete -->
                                        <button type="button"
                                                @onclick="() => OpenDeleteConfirm(b)"
                                                title="Delete Branch"
                                                class="p-1 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded transition-colors cursor-pointer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-4 py-3 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30">
            <TablePagination PageNumber="_currentPage"
                             PageSize="_pageSize"
                             TotalRecords="_totalRecords"
                             ItemLabel="branches"
                             IsLoading="_isLoading"
                             OnPageChanged="HandlePageChanged"
                             OnPageSizeChanged="HandlePageSizeChanged" />
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- ADD / EDIT BRANCH DRAWER (Slide-Over Matching Users.razor) -->
<!-- ========================================================= -->
@if (_showDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")"
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-teal-500/20 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏛️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_isEditing ? "Edit Branch" : "Add New Branch")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_isEditing ? "Update campus details, location, and parameters" : "Register a new campus branch under your institution")
                    </p>
                </div>
            </div>

            <button type="button"
                    @onclick="CloseDrawerAsync"
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer"
                    title="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Drawer Body & Footer inside EditForm -->
        <EditForm Model="_model" OnValidSubmit="HandleSaveBranch" class="flex-1 flex flex-col justify-between overflow-hidden">
            <FluentValidationValidator />

            <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs select-text">
                <!-- Basic Info -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Branch Details</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="sm:col-span-2">
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                Branch Name <span class="text-rose-500">*</span>
                            </label>
                            <InputText @bind-Value="_model.Name"
                                       placeholder="e.g. Main Campus / South Extension"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.Name)" class="text-[11px] text-rose-500 mt-1" />
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                Branch Code <span class="text-rose-500">*</span>
                            </label>
                            <InputText @bind-Value="_model.Code"
                                       placeholder="e.g. BR-MAIN or DEL-01"
                                       class="w-full px-3 py-2 text-xs font-mono bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.Code)" class="text-[11px] text-rose-500 mt-1" />
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                Primary Mobile
                            </label>
                            <InputText @bind-Value="_model.Mobile"
                                       placeholder="+91 98765 43210"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.Mobile)" class="text-[11px] text-rose-500 mt-1" />
                        </div>
                    </div>
                </div>

                <!-- Contact Details -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Contact &amp; Alternate Details</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">Email Address</label>
                            <InputText @bind-Value="_model.Email"
                                       type="email"
                                       placeholder="branch@institute.com"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.Email)" class="text-[11px] text-rose-500 mt-1" />
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">Alternate Mobile</label>
                            <InputText @bind-Value="_model.AlternateMobile"
                                       placeholder="+91 98765 11111"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.AlternateMobile)" class="text-[11px] text-rose-500 mt-1" />
                        </div>
                    </div>
                </div>

                <!-- Branch Administrator (Assigned BranchAdmin Role) -->
                @if (!_isEditing)
                {
                    <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                        <div class="flex items-center justify-between">
                            <h4 class="text-[11px] font-bold text-teal-600 dark:text-teal-400 uppercase tracking-wider flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <span>Branch Administrator (Branch Admin Role)</span>
                            </h4>
                            <span class="text-[10px] text-slate-400">Head of Branch</span>
                        </div>
                        <div class="p-3.5 bg-teal-50/50 dark:bg-teal-950/20 rounded-xl border border-teal-200/60 dark:border-teal-900/40 space-y-3">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                        Admin First Name <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText @bind-Value="_model.AdminFirstName"
                                               placeholder="e.g. Rahul"
                                               class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                    <ValidationMessage For="@(() => _model.AdminFirstName)" class="text-[11px] text-rose-500 mt-1" />
                                </div>
                                <div>
                                    <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                        Admin Last Name
                                    </label>
                                    <InputText @bind-Value="_model.AdminLastName"
                                               placeholder="e.g. Sharma"
                                               class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                    <ValidationMessage For="@(() => _model.AdminLastName)" class="text-[11px] text-rose-500 mt-1" />
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                        Admin Email (Login ID) <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText @bind-Value="_model.AdminEmail"
                                               type="email"
                                               placeholder="branchadmin@institute.com"
                                               class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                    <ValidationMessage For="@(() => _model.AdminEmail)" class="text-[11px] text-rose-500 mt-1" />
                                </div>
                                <div>
                                    <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                        Admin Mobile
                                    </label>
                                    <InputText @bind-Value="_model.AdminMobile"
                                               placeholder="+91 98765 00000"
                                               class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                    <ValidationMessage For="@(() => _model.AdminMobile)" class="text-[11px] text-rose-500 mt-1" />
                                </div>
                            </div>

                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">
                                    Admin Initial Password <span class="text-rose-500">*</span>
                                </label>
                                <InputText @bind-Value="_model.AdminPassword"
                                           type="password"
                                           placeholder="Set branch admin login password..."
                                           class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                <ValidationMessage For="@(() => _model.AdminPassword)" class="text-[11px] text-rose-500 mt-1" />
                                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">
                                    💡 This user account will be created with the <strong>Branch Admin</strong> role and linked to this branch.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Campus Location -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Campus Location</h4>
                    <div class="space-y-3">
                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">Street Address</label>
                            <InputText @bind-Value="_model.Address"
                                       placeholder="Plot No., Street, Area..."
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                            <ValidationMessage For="@(() => _model.Address)" class="text-[11px] text-rose-500 mt-1" />
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">City</label>
                                <InputText @bind-Value="_model.City"
                                           placeholder="City"
                                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                <ValidationMessage For="@(() => _model.City)" class="text-[11px] text-rose-500 mt-1" />
                            </div>

                            <div>
                                <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">State</label>
                                <InputText @bind-Value="_model.State"
                                           placeholder="State"
                                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                <ValidationMessage For="@(() => _model.State)" class="text-[11px] text-rose-500 mt-1" />
                            </div>

                            <div class="col-span-2 sm:col-span-1">
                                <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">Pincode</label>
                                <InputText @bind-Value="_model.Pincode"
                                           placeholder="PIN / Zip"
                                           class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                                <ValidationMessage For="@(() => _model.Pincode)" class="text-[11px] text-rose-500 mt-1" />
                            </div>
                        </div>

                        <div>
                            <label class="block font-medium text-slate-700 dark:text-slate-300 mb-1">Country</label>
                            <InputText @bind-Value="_model.Country"
                                       placeholder="Country"
                                       class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                        </div>
                    </div>
                </div>

                <!-- Toggles / Flags -->
                <div class="space-y-3">
                    <h4 class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Branch Options</h4>
                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                        <div>
                            <span class="font-semibold text-slate-800 dark:text-slate-200 block">Main Headquarters Branch</span>
                            <span class="text-[11px] text-slate-400 dark:text-slate-500">Designates this branch as the primary institution location.</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" @bind="_model.IsMainBranch" class="sr-only peer" />
                            <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-teal-600"></div>
                        </label>
                    </div>

                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
                        <div>
                            <span class="font-semibold text-slate-800 dark:text-slate-200 block">Branch Status</span>
                            <span class="text-[11px] text-slate-400 dark:text-slate-500">Enable or disable operations for this location.</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" @bind="_model.IsActive" class="sr-only peer" />
                            <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-teal-600"></div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Drawer Footer -->
            <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/90 dark:bg-[#18262c] flex items-center justify-end gap-2.5 shrink-0">
                <button type="button"
                        @onclick="CloseDrawerAsync"
                        class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 dark:text-slate-300 dark:hover:text-white bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        disabled="@_isSaving"
                        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-teal-700 hover:bg-teal-800 active:bg-teal-900 rounded-lg shadow-sm transition-all disabled:opacity-50 cursor-pointer">
                    @if (_isSaving)
                    {
                        <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>@(_isEditing ? "Update Branch" : "Create Branch")</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- ========================================================= -->
<!-- BRANCH DETAILS MODAL                                      -->
<!-- ========================================================= -->
@if (_selectedBranch != null && _isDetailsModalOpen)
{
    <Modal IsOpen="true"
           Title="Branch Details"
           Subtitle="@($"{_selectedBranch.Name} • {_selectedBranch.Code}")"
           OnClose="CloseDetailsModal"
           MaxWidth="max-w-xl">
        <ChildContent>
            <div class="space-y-4 text-xs">
                <!-- Header Banner -->
                <div class="flex items-center gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700">
                    <div class="w-12 h-12 rounded-xl @(_selectedBranch.IsMainBranch ? "bg-teal-600 text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200") flex items-center justify-center font-bold text-base shadow-sm shrink-0">
                        @(_selectedBranch.Name.Length >= 2 ? _selectedBranch.Name.Substring(0, 2).ToUpperInvariant() : _selectedBranch.Name.ToUpperInvariant())
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white truncate">@_selectedBranch.Name</h3>
                            @if (_selectedBranch.IsMainBranch)
                            {
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-300 border border-teal-300 dark:border-teal-700/60">
                                    Headquarters
                                </span>
                            }
                            @if (_selectedBranch.IsActive)
                            {
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300">
                                    Inactive
                                </span>
                            }
                        </div>
                        <p class="text-[11px] font-mono text-slate-500 dark:text-slate-400 mt-0.5">Code: @_selectedBranch.Code</p>
                    </div>
                </div>

                <!-- Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Primary Mobile</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@(_selectedBranch.Mobile ?? "—")</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Email</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@(_selectedBranch.Email ?? "—")</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">City / State</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@(_selectedBranch.City ?? "—"), @(_selectedBranch.State ?? "—")</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Pincode</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@(_selectedBranch.Pincode ?? "—")</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 sm:col-span-2">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Street Address</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@(_selectedBranch.Address ?? "—")</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Batches</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@_selectedBranch.ActiveBatchesCount</p>
                    </div>

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Enrolled Students</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@_selectedBranch.TotalStudentsCount</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedBranch.BranchAdminName))
                    {
                        <div class="p-3 rounded-lg bg-teal-50/60 dark:bg-teal-950/30 border border-teal-200/80 dark:border-teal-900/50 sm:col-span-2">
                            <p class="text-[11px] font-bold text-teal-700 dark:text-teal-300 uppercase tracking-wider flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <span>Branch Administrator</span>
                            </p>
                            <div class="flex items-center justify-between mt-1">
                                <span class="font-bold text-slate-800 dark:text-slate-100 text-xs">@_selectedBranch.BranchAdminName</span>
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-teal-100 dark:bg-teal-900/60 text-teal-800 dark:text-teal-300">Branch Admin</span>
                            </div>
                            <div class="flex items-center gap-4 text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                                @if (!string.IsNullOrWhiteSpace(_selectedBranch.BranchAdminEmail))
                                {
                                    <span>✉️ @_selectedBranch.BranchAdminEmail</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedBranch.BranchAdminMobile))
                                {
                                    <span>📞 @_selectedBranch.BranchAdminMobile</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="p-3 rounded-lg bg-slate-50/60 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 sm:col-span-2">
                        <p class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Created Date</p>
                        <p class="font-medium text-slate-800 dark:text-slate-200 mt-1">@_selectedBranch.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button"
                    @onclick="CloseDetailsModal"
                    class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors cursor-pointer">
                Close
            </button>
        </FooterTemplate>
    </Modal>
}

<!-- ========================================================= -->
<!-- DELETE CONFIRMATION MODAL                                 -->
<!-- ========================================================= -->
@if (_branchToDelete != null && _isDeleteModalOpen)
{
    <Modal IsOpen="true"
           Title="Delete Branch"
           Subtitle="@($"Remove {_branchToDelete.Name} ({_branchToDelete.Code})")"
           OnClose="CloseDeleteModal"
           MaxWidth="max-w-md">
        <ChildContent>
            <div class="space-y-3 text-xs">
                <div class="flex items-center gap-3 p-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 text-rose-800 dark:text-rose-200">
                    <svg class="w-5 h-5 shrink-0 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <p class="font-medium leading-relaxed">
                        Are you sure you want to delete branch <strong class="font-bold underline">@_branchToDelete.Name</strong> (@_branchToDelete.Code)?
                    </p>
                </div>
                <p class="text-slate-500 dark:text-slate-400 text-[11px] leading-relaxed">
                    This will delete the branch and remove associated staff branch access mappings.
                </p>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button"
                    @onclick="CloseDeleteModal"
                    class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="button"
                    disabled="@_isDeleting"
                    @onclick="ConfirmDeleteBranch"
                    class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 rounded-lg shadow-sm transition-all disabled:opacity-50 cursor-pointer">
                @if (_isDeleting)
                {
                    <svg class="w-3.5 h-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    <span>Deleting...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    <span>Confirm Delete</span>
                }
            </button>
        </FooterTemplate>
    </Modal>
}

@code {
    private List<BranchDto> _branches = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isDeleting = false;

    // Filters and Query
    private string _search = string.Empty;
    private string _selectedStatus = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalRecords = 0;
    private int _totalPages = 1;

    // Stat card values (rendered directly without blinking)
    private int _activeCount = 0;
    private string? _mainBranchName = null;
    private int _totalBatches = 0;

    // Sorting state (Gold standard 3-state cycle)
    private readonly TableSortState _sortState = new();

    // Status filter options
    private readonly List<CustomSelect.CustomSelectOption> _statusOptions = new()
    {
        new("", "All Status"),
        new("true", "Active"),
        new("false", "Inactive")
    };

    // Form Model for Add/Edit
    private BranchFormModel _model = new();
    private bool _showDrawer = false;
    private bool _isDrawerOpen = false;
    private bool _isEditing = false;

    // Modals
    private BranchDto? _selectedBranch;
    private bool _isDetailsModalOpen = false;
    private BranchDto? _branchToDelete;
    private bool _isDeleteModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync(1);
    }

    private async Task LoadDataAsync(int page = 1)
    {
        _isLoading = true;
        _currentPage = page;

        try
        {
            bool? isActive = null;
            if (!string.IsNullOrWhiteSpace(_selectedStatus))
                isActive = bool.Parse(_selectedStatus);

            var req = new PagedRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                Search = _search,
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : (_sortState.Direction == SortDirection.Ascending ? "asc" : null)
            };

            var response = await BranchService.GetBranchesPagedAsync(req, isActive: isActive);

            if (response != null && response.Success && response.Data != null)
            {
                _branches = response.Data.Items.ToList();
                _totalRecords = response.Data.TotalRecords;
                _totalPages = response.Data.TotalPages;

                // Update summary stats
                _activeCount = _branches.Count(b => b.IsActive);
                var main = _branches.FirstOrDefault(b => b.IsMainBranch);
                _mainBranchName = main?.Name;
                _totalBatches = _branches.Sum(b => b.ActiveBatchesCount);
            }
            else
            {
                _branches = new();
                _totalRecords = 0;
                _totalPages = 1;
                Toast.Error(response?.Message ?? "Failed to load branches.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error loading branches: {ex.Message}");
            _branches = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadDataAsync(1);
        }
    }

    private async Task HandleStatusFilterChanged(string val)
    {
        _selectedStatus = val;
        await LoadDataAsync(1);
    }

    private async Task HandlePageChanged(int page)
    {
        await LoadDataAsync(page);
    }

    private async Task HandlePageSizeChanged(int size)
    {
        _pageSize = size;
        await LoadDataAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadDataAsync(1);
    }

    private string GetSortIcon(string column) => _sortState.GetIndicator(column);

    // Drawer handling
    private async Task OpenAddDrawerAsync()
    {
        _isEditing = false;
        _model = new BranchFormModel
        {
            IsActive = true,
            IsMainBranch = !_branches.Any(b => b.IsMainBranch)
        };
        _showDrawer = true;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(BranchDto branch)
    {
        _isEditing = true;
        _model = new BranchFormModel
        {
            Id = branch.Id,
            Name = branch.Name,
            Code = branch.Code,
            Mobile = branch.Mobile,
            AlternateMobile = branch.AlternateMobile,
            Email = branch.Email,
            Address = branch.Address,
            City = branch.City,
            State = branch.State,
            Pincode = branch.Pincode,
            Country = branch.Country ?? "India",
            IsMainBranch = branch.IsMainBranch,
            UseBranchName = branch.UseBranchName,
            IsActive = branch.IsActive
        };
        _showDrawer = true;
        StateHasChanged();
        await Task.Delay(50);
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showDrawer = false;
    }

    private async Task HandleSaveBranch()
    {
        _isSaving = true;
        try
        {
            if (_isEditing)
            {
                var req = new UpdateBranchRequest
                {
                    Id = _model.Id!.Value,
                    Name = _model.Name,
                    Code = _model.Code,
                    Mobile = _model.Mobile,
                    AlternateMobile = _model.AlternateMobile,
                    Email = _model.Email,
                    Address = _model.Address,
                    City = _model.City,
                    State = _model.State,
                    Pincode = _model.Pincode,
                    Country = _model.Country,
                    IsMainBranch = _model.IsMainBranch,
                    UseBranchName = _model.UseBranchName,
                    IsActive = _model.IsActive
                };

                var res = await BranchService.UpdateBranchAsync(req);
                if (res != null && res.Success)
                {
                    Toast.Success("Branch updated successfully.");
                    await CloseDrawerAsync();
                    await LoadDataAsync(_currentPage);
                }
                else
                {
                    Toast.Error(res?.Message ?? "Failed to update branch.");
                }
            }
            else
            {
                var req = new CreateBranchRequest
                {
                    Name = _model.Name,
                    Code = _model.Code,
                    Mobile = _model.Mobile,
                    AlternateMobile = _model.AlternateMobile,
                    Email = _model.Email,
                    Address = _model.Address,
                    City = _model.City,
                    State = _model.State,
                    Pincode = _model.Pincode,
                    Country = _model.Country,
                    IsMainBranch = _model.IsMainBranch,
                    UseBranchName = _model.UseBranchName,
                    IsActive = _model.IsActive,
                    AdminFirstName = _model.AdminFirstName,
                    AdminLastName = _model.AdminLastName,
                    AdminEmail = _model.AdminEmail,
                    AdminMobile = _model.AdminMobile,
                    AdminPassword = _model.AdminPassword
                };

                var res = await BranchService.CreateBranchAsync(req);
                if (res != null && res.Success)
                {
                    Toast.Success("Branch created successfully.");
                    await CloseDrawerAsync();
                    await LoadDataAsync(1);
                }
                else
                {
                    Toast.Error(res?.Message ?? "Failed to create branch.");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Details Modal
    private void OpenDetailsModal(BranchDto branch)
    {
        _selectedBranch = branch;
        _isDetailsModalOpen = true;
    }

    private void CloseDetailsModal()
    {
        _isDetailsModalOpen = false;
        _selectedBranch = null;
    }

    // Delete Confirmation
    private void OpenDeleteConfirm(BranchDto branch)
    {
        _branchToDelete = branch;
        _isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        _isDeleteModalOpen = false;
        _branchToDelete = null;
    }

    private async Task ConfirmDeleteBranch()
    {
        if (_branchToDelete == null) return;

        _isDeleting = true;
        try
        {
            var res = await BranchService.DeleteBranchAsync(_branchToDelete.Id);
            if (res != null && res.Success)
            {
                Toast.Success("Branch deleted successfully.");
                CloseDeleteModal();
                await LoadDataAsync(1);
            }
            else
            {
                Toast.Error(res?.Message ?? "Failed to delete branch.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    // Form model for validation
    public class BranchFormModel
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string? Mobile { get; set; }
        public string? AlternateMobile { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? Pincode { get; set; }
        public string Country { get; set; } = "India";
        public bool IsMainBranch { get; set; } = false;
        public bool UseBranchName { get; set; } = true;
        public bool IsActive { get; set; } = true;

        // Branch Administrator (Assigned BranchAdmin Role)
        public string? AdminFirstName { get; set; }
        public string? AdminLastName { get; set; }
        public string? AdminEmail { get; set; }
        public string? AdminMobile { get; set; }
        public string? AdminPassword { get; set; }
    }

    public class BranchFormModelValidator : AbstractValidator<BranchFormModel>
    {
        public BranchFormModelValidator()
        {
            ClassLevelCascadeMode = CascadeMode.Stop;
            RuleLevelCascadeMode = CascadeMode.Stop;

            RuleFor(x => x.Name)
                .NotEmpty().WithMessage("Branch Name is required.")
                .MaximumLength(200).WithMessage("Branch Name cannot exceed 200 characters.");

            RuleFor(x => x.Code)
                .NotEmpty().WithMessage("Branch Code is required.")
                .MaximumLength(50).WithMessage("Branch Code cannot exceed 50 characters.");

            RuleFor(x => x.Email)
                .EmailAddress().WithMessage("Please enter a valid email address.")
                .MaximumLength(150).WithMessage("Email cannot exceed 150 characters.")
                .When(x => !string.IsNullOrWhiteSpace(x.Email));

            RuleFor(x => x.Mobile)
                .MaximumLength(20).WithMessage("Mobile number cannot exceed 20 characters.");

            RuleFor(x => x.AlternateMobile)
                .MaximumLength(20).WithMessage("Alternate mobile number cannot exceed 20 characters.");

            RuleFor(x => x.Address)
                .MaximumLength(500).WithMessage("Address cannot exceed 500 characters.");

            RuleFor(x => x.City)
                .MaximumLength(100).WithMessage("City cannot exceed 100 characters.");

            RuleFor(x => x.State)
                .MaximumLength(100).WithMessage("State cannot exceed 100 characters.");

            RuleFor(x => x.Pincode)
                .MaximumLength(10).WithMessage("Pincode cannot exceed 10 characters.");

            RuleFor(x => x.Country)
                .MaximumLength(100).WithMessage("Country cannot exceed 100 characters.");

            When(x => !string.IsNullOrWhiteSpace(x.AdminEmail) || !string.IsNullOrWhiteSpace(x.AdminFirstName), () =>
            {
                RuleFor(x => x.AdminFirstName)
                    .NotEmpty().WithMessage("Branch Admin First Name is required.")
                    .MaximumLength(100).WithMessage("First name cannot exceed 100 characters.");

                RuleFor(x => x.AdminLastName)
                    .MaximumLength(100).WithMessage("Last name cannot exceed 100 characters.");

                RuleFor(x => x.AdminEmail)
                    .NotEmpty().WithMessage("Branch Admin Email is required.")
                    .EmailAddress().WithMessage("Please enter a valid email address.")
                    .MaximumLength(150).WithMessage("Email cannot exceed 150 characters.");

                RuleFor(x => x.AdminPassword)
                    .NotEmpty().WithMessage("Branch Admin Password is required.")
                    .MinimumLength(6).WithMessage("Password must be at least 6 characters.");

                RuleFor(x => x.AdminMobile)
                    .MaximumLength(20).WithMessage("Mobile number cannot exceed 20 characters.");
            });
        }
    }
}
