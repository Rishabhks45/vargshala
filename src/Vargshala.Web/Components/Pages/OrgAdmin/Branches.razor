                <div class="border-t border-slate-100 dark:border-slate-800 pt-3">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Registered Since</span>
                    <div class="mt-1 text-slate-700 dark:text-slate-300 font-semibold">
                        @_selectedBranch.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Drawer Footer -->
        <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3 shrink-0">
            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                Close
            </button>
            <button type="button" 
                    @onclick="() => SwitchToEditDrawerAsync(_selectedBranch)" 
                    class="px-5 py-2.5 text-xs font-bold bg-[#009488] hover:bg-[#00796b] text-white rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <span>Edit Branch</span>
            </button>
        </div>
    </div>
}

