@page "/branches"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Common
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Services
@inject IBranchService BranchService
@inject INotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Branches &amp; Campuses | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Branches &amp; Campuses
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage institution campus locations, codes, contact points, and branch administrators.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>New Branch</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (No blinking - values rendered directly) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- 1. Total Campuses -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Branches</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_activeCount Active • @Math.Max(0, _totalRecords - _activeCount) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- 2. Main Headquarters -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Main Campus</p>
                    <h3 class="text-xl font-black text-slate-800 dark:text-white mt-1 truncate max-w-[150px]" title="@_mainBranchName">
                        @(_mainBranchName ?? "HQ Active")
                    </h3>
                    <p class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold mt-0.5">Headquarters</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- 3. Active Batches -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Batches</p>
                    <h3 class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">@_totalBatches</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Running Across Campuses</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- 4. Branch Admins Assigned -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Branch Admins</p>
                    <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">
                        @_branches.Count(b => !string.IsNullOrWhiteSpace(b.BranchAdminName))
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Designated Administrators</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_search" 
                         OnSearch="() => LoadDataAsync(1)" 
                         Placeholder="Search branch name, code, city, or admin..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-36">
                <CustomSelect Value="@_selectedStatus" 
                              ValueChanged="HandleStatusFilterChanged" 
                              Options="_statusOptions" 
                              Placeholder="All Status" />
            </div>

            <button type="button" 
                    @onclick="() => LoadDataAsync(1)"
                    title="Refresh List"
                    class="p-2 text-slate-500 hover:text-[#009488] dark:text-slate-400 dark:hover:text-teal-400 hover:bg-teal-50 dark:hover:bg-[#1f3037] border border-slate-200 dark:border-slate-700 rounded-xl transition-all shadow-2xs cursor-pointer">
                <svg class="w-4 h-4 @(_isLoading ? "animate-spin text-[#009488]" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Branches Data Table (Fits screen height, internal scrolling with hidden scrollbar) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[960px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[24%] py-2 px-4 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5 whitespace-nowrap">
                                <span>Branch / Campus</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="w-[9%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Code")'>
                            <div class="flex items-center gap-1.5 whitespace-nowrap">
                                <span>Code</span>
                                <span class="@_sortState.GetIndicatorClass("Code")">@_sortState.GetIndicator("Code")</span>
                            </div>
                        </th>
                        <th class="w-[13%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("City")'>
                            <div class="flex items-center gap-1.5 whitespace-nowrap">
                                <span>Location / City</span>
                                <span class="@_sortState.GetIndicatorClass("City")">@_sortState.GetIndicator("City")</span>
                            </div>
                        </th>
                        <th class="w-[21%] py-2 px-3 select-none">
                            <span class="whitespace-nowrap">Contact &amp; Admin</span>
                        </th>
                        <th class="w-[9%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Batches")'>
                            <div class="flex items-center justify-center gap-1.5 whitespace-nowrap">
                                <span>Batches</span>
                                <span class="@_sortState.GetIndicatorClass("Batches")">@_sortState.GetIndicator("Batches")</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("IsActive")'>
                            <div class="flex items-center justify-center gap-1.5 whitespace-nowrap">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("IsActive")">@_sortState.GetIndicator("IsActive")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2 px-4 text-right select-none">
                            <span class="whitespace-nowrap">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _branches.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_branches.Any())
                    {
                        <TableSkeletonRows Columns="7" Rows="8" />
                    }
                    else if (_branches.Any())
                    {
                        @foreach (var b in _branches)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors group">
                                <!-- Branch Name & HQ Badge -->
                                <td class="py-1.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg @(b.IsMainBranch ? "bg-gradient-to-tr from-[#004D40] to-[#009488] text-white" : "bg-teal-500/10 text-[#009488]") font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                            @(b.Name.Length >= 2 ? b.Name.Substring(0, 2).ToUpperInvariant() : b.Name.ToUpperInvariant())
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-bold text-slate-800 dark:text-white leading-tight truncate">@b.Name</span>
                                                @if (b.IsMainBranch)
                                                {
                                                    <span class="px-1.5 py-0.2 text-[9px] font-black rounded bg-teal-50 dark:bg-teal-950/60 text-[#009488] dark:text-teal-300 border border-teal-200 dark:border-teal-800 shrink-0">
                                                        HQ
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate mt-0.5">
                                                @(b.Address ?? "No address provided")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Code -->
                                <td class="py-1.5 px-3">
                                    <span class="inline-block px-1.5 py-0.5 text-[10px] font-mono font-bold rounded bg-teal-50 dark:bg-teal-950/50 text-[#009488] border border-teal-200 dark:border-teal-800">
                                        @b.Code
                                    </span>
                                </td>

                                <!-- Location / City -->
                                <td class="py-1.5 px-3 text-slate-600 dark:text-slate-300">
                                    <div class="font-semibold text-slate-800 dark:text-white leading-tight truncate">@(b.City ?? "—")</div>
                                    <div class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 leading-none truncate">@(b.State ?? "—")</div>
                                </td>

                                <!-- Contact & Admin -->
                                <td class="py-1.5 px-3 text-slate-600 dark:text-slate-300">
                                    <div class="flex items-center gap-1 font-semibold text-slate-800 dark:text-white leading-tight truncate">
                                        <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                        <span class="truncate">@(b.Mobile ?? b.Email ?? "—")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.BranchAdminName))
                                    {
                                        <div class="flex items-center gap-1 text-[10px] font-semibold text-teal-700 dark:text-teal-400 mt-0.5 leading-none truncate" title="@($"Branch Admin: {b.BranchAdminName}")">
                                            <span>👤 @b.BranchAdminName</span>
                                            <span class="text-[9px] px-1 py-0.2 rounded bg-teal-100 dark:bg-teal-950/70 text-[#00796b] dark:text-teal-300 shrink-0">Admin</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1 text-[10px] font-semibold text-slate-600 dark:text-slate-400 mt-0.5 leading-none truncate" title="Managed by Organization Admin">
                                            <span>👤 Org. Admin</span>
                                            <span class="text-[9px] px-1 py-0.2 rounded bg-teal-50 dark:bg-teal-950/50 text-[#009488] dark:text-teal-300 border border-teal-200 dark:border-teal-800 shrink-0">HQ</span>
                                        </div>
                                    }
                                </td>

                                <!-- Batches -->
                                <td class="py-1.5 px-3 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                        @b.ActiveBatchesCount
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="py-1.5 px-3 text-center">
                                    @if (b.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Actions: View, Edit, Delete -->
                                <td class="py-1.5 px-4 text-right overflow-visible">
                                    <div class="flex items-center justify-end gap-1.5 shrink-0 flex-nowrap">
                                        <!-- View Details (Teal Theme Tooltip) -->
                                        <div class="relative group/tip inline-flex items-center justify-center has-tooltip">
                                            <button type="button" 
                                                    @onclick="() => OpenBranchDetailsDrawer(b)" 
                                                    class="p-1 text-[#009488] dark:text-teal-400 hover:text-[#00796b] dark:hover:text-teal-300 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                                </svg>
                                            </button>
                                            <div class="tooltip-content absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tip:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-100">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                    View Details
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                            </div>
                                        </div>

                                        <!-- Edit Branch (Amber Theme Tooltip) -->
                                        <div class="relative group/tip inline-flex items-center justify-center has-tooltip">
                                            <button type="button" 
                                                    @onclick="() => OpenEditDrawerAsync(b)" 
                                                    class="p-1 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                    aria-label="Edit Branch">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                                                </svg>
                                            </button>
                                            <div class="tooltip-content absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tip:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-100">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-amber-600 text-white border border-amber-400/50 shadow-lg tracking-wide">
                                                    Edit Branch
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-amber-600 border-r border-b border-amber-400/50"></span>
                                            </div>
                                        </div>

                                        <!-- Delete Branch (Rose Theme Tooltip) -->
                                        @if (!b.IsMainBranch)
                                        {
                                            <div class="relative group/tip inline-flex items-center justify-center has-tooltip">
                                                <button type="button" 
                                                        @onclick="() => OpenDeleteConfirm(b)" 
                                                        class="p-1 text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-md transition-all cursor-pointer inline-flex items-center justify-center"
                                                        aria-label="Delete Branch">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                                    </svg>
                                                </button>
                                                <div class="tooltip-content absolute bottom-full right-0 mb-2 hidden group-hover/tip:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-100">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-rose-600 text-white border border-rose-400/50 shadow-lg tracking-wide">
                                                        Delete Branch
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-2 bg-rose-600 border-r border-b border-rose-400/50"></span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No branches found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Server-Side Table Pagination Component Matching Users.razor -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_currentPage" 
                             PageSize="_pageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="branches" 
                             IsLoading="_isLoading" 
                             OnPageChanged="HandlePageChanged"
                             OnPageSizeChanged="HandlePageSizeChanged" />
        </div>
    </div>

</div>

<!-- ========================================================= -->
<!-- DRAWER 1: ADD / EDIT BRANCH DRAWER (Slide-Over Pattern)   -->
<!-- ========================================================= -->
@if (_showDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-teal-500/20 p-1 flex items-center justify-center shadow-md shrink-0 text-xl font-bold">
                    🏛️
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_model.Id.HasValue ? "Edit Branch" : "Add New Branch")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_model.Id.HasValue ? "Update campus details, location, and parameters" : "Register a new campus branch and assign its administrator")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 text-teal-200 hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer"
                    title="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body & Footer inside EditForm -->
        <EditForm Model="@_model" OnValidSubmit="HandleSaveBranch" class="flex-1 flex flex-col justify-between overflow-hidden">
            <FluentValidationValidator />

            <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-4 text-xs" style="scrollbar-width: none; -ms-overflow-style: none;">
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <AlertNotification Type="AlertType.Error"
                                       Message="@_formError"
                                       Dismissible="true"
                                       OnClose="() => _formError = null" />
                }

                <!-- 1. Branch & Campus Details -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider">1. Branch &amp; Campus Details</h4>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-800 dark:text-slate-200">Branch Name *</label>
                        <InputText @bind-Value="_model.Name" placeholder="e.g. Main Campus / South Extension"
                                   class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                        <ValidationMessage For="@(() => _model.Name)" class="text-[10px] text-rose-500 font-semibold" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">Branch Code *</label>
                            <InputText @bind-Value="_model.Code" placeholder="e.g. BR-MAIN or BCC-02"
                                       class="w-full px-3 py-2.5 text-xs font-mono uppercase bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-bold" />
                            <ValidationMessage For="@(() => _model.Code)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">Primary Mobile</label>
                            <InputText @bind-Value="_model.Mobile" placeholder="+91 98765 43210"
                                       class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.Mobile)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- 2. Contact Details -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider">2. Contact Details</h4>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">Email Address</label>
                            <InputText @bind-Value="_model.Email" type="email" placeholder="branch@institute.com"
                                       class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.Email)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">Alternate Mobile</label>
                            <InputText @bind-Value="_model.AlternateMobile" placeholder="+91 98765 11111"
                                       class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.AlternateMobile)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- 3. Branch Administrator (Branch Admin Role) -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider flex items-center gap-1.5">
                            <span>👤 3. Branch Administrator</span>
                        </h4>
                        <span class="text-[10px] font-bold text-[#009488] bg-teal-50 dark:bg-teal-950/60 px-2 py-0.5 rounded-md border border-teal-200 dark:border-teal-800">
                            @(_model.Id.HasValue ? "Branch Admin" : "Branch Admin Role")
                        </span>
                    </div>

                    <div class="p-3.5 bg-teal-50/40 dark:bg-teal-950/20 rounded-xl border border-teal-200/60 dark:border-teal-900/40 space-y-3">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block font-bold text-slate-800 dark:text-slate-200">Admin First Name *</label>
                                <InputText @bind-Value="_model.AdminFirstName" placeholder="e.g. Vikram"
                                           class="w-full px-3 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                                <ValidationMessage For="@(() => _model.AdminFirstName)" class="text-[10px] text-rose-500 font-semibold" />
                            </div>
                            <div class="space-y-1">
                                <label class="block font-bold text-slate-800 dark:text-slate-200">Admin Last Name</label>
                                <InputText @bind-Value="_model.AdminLastName" placeholder="e.g. Singh"
                                           class="w-full px-3 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                                <ValidationMessage For="@(() => _model.AdminLastName)" class="text-[10px] text-rose-500 font-semibold" />
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="block font-bold text-slate-800 dark:text-slate-200">Admin Email (Login ID) *</label>
                                <InputText @bind-Value="_model.AdminEmail" type="email" placeholder="branchadmin@institute.com"
                                           class="w-full px-3 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                                <ValidationMessage For="@(() => _model.AdminEmail)" class="text-[10px] text-rose-500 font-semibold" />
                            </div>
                            <div class="space-y-1">
                                <label class="block font-bold text-slate-800 dark:text-slate-200">Admin Mobile</label>
                                <InputText @bind-Value="_model.AdminMobile" placeholder="+91 98765 00000"
                                           class="w-full px-3 py-2.5 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                                <ValidationMessage For="@(() => _model.AdminMobile)" class="text-[10px] text-rose-500 font-semibold" />
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">
                                @(_model.Id.HasValue ? "Admin Password" : "Admin Initial Password *")
                            </label>
                            <div class="relative">
                                <InputText @bind-Value="_model.AdminPassword" 
                                           type="@(_showAdminPassword ? "text" : "password")" 
                                           placeholder="@(_model.Id.HasValue ? "Leave blank to keep current password..." : "Set secure login password...")"
                                           class="w-full px-3 py-2.5 pr-10 text-xs bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                                <button type="button" 
                                        @onclick="() => _showAdminPassword = !_showAdminPassword"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer">
                                    @if (_showAdminPassword)
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _model.AdminPassword)" class="text-[10px] text-rose-500 font-semibold" />
                            <p class="text-[10px] text-teal-700 dark:text-teal-400 font-medium mt-1">
                                💡 @(_model.Id.HasValue ? "Update the Branch Admin account credentials linked to this campus." : "This account will be created with the Branch Admin role and linked to this branch.")
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 4. Campus Location -->
                <div class="space-y-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider">4. Campus Location</h4>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-800 dark:text-slate-200">Street Address</label>
                        <InputText @bind-Value="_model.Address" placeholder="Plot No., Street, Landmark, Area..."
                                   class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                        <ValidationMessage For="@(() => _model.Address)" class="text-[10px] text-rose-500 font-semibold" />
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">City</label>
                            <InputText @bind-Value="_model.City" placeholder="City"
                                       class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.City)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">State</label>
                            <InputText @bind-Value="_model.State" placeholder="State"
                                       class="w-full px-3 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.State)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                        <div class="space-y-1">
                            <label class="block font-bold text-slate-800 dark:text-slate-200">Pincode</label>
                            <InputText @bind-Value="_model.Pincode" placeholder="PIN"
                                       class="w-full px-3 py-2.5 text-xs font-mono bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white font-medium" />
                            <ValidationMessage For="@(() => _model.Pincode)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>
                    </div>
                </div>

                <!-- 5. Operational Settings -->
                <div class="space-y-3">
                    <h4 class="text-xs font-black text-[#009488] uppercase tracking-wider">5. Operational Settings</h4>

                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-white">Main Headquarters Branch</div>
                            <p class="text-[11px] text-slate-400">Designates this branch as the primary institution headquarters.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" @bind="_model.IsMainBranch" class="sr-only peer" />
                            <div class="w-10 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#009488]"></div>
                        </label>
                    </div>

                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-white">Active Status</div>
                            <p class="text-[11px] text-slate-400">Enable or disable operations and batch activities for this branch.</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" @bind="_model.IsActive" class="sr-only peer" />
                            <div class="w-10 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#009488]"></div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Drawer Footer -->
            <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3 shrink-0">
                <button type="button" 
                        @onclick="CloseDrawerAsync" 
                        class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" 
                        disabled="@_isSaving" 
                        class="px-5 py-2.5 text-xs font-bold bg-[#009488] hover:bg-[#00796b] text-white rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSaving)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <span>@(_model.Id.HasValue ? "Update Branch" : "Create Branch")</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- ========================================================= -->
<!-- DRAWER 2: VIEW BRANCH DETAILS SLIDE-OVER (Users.razor match) -->
<!-- ========================================================= -->
@if (_showDetailsDrawer && _selectedBranch != null)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl @(_selectedBranch.IsMainBranch ? "bg-gradient-to-tr from-teal-500 to-emerald-400" : "bg-teal-600") p-1 flex items-center justify-center shadow-md shrink-0 text-sm font-bold text-white">
                    @(_selectedBranch.Name.Length >= 2 ? _selectedBranch.Name.Substring(0, 2).ToUpperInvariant() : _selectedBranch.Name.ToUpperInvariant())
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@_selectedBranch.Name</span>
                        @if (_selectedBranch.IsMainBranch)
                        {
