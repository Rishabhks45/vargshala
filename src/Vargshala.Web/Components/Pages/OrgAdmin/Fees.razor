@page "/fees"
@page "/orgadmin/fees"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Fees
@using Vargshala.Contracts.Fees.Enums
@using Vargshala.Contracts.FeeStructures
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Classes
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Services
@inject IFeeService FeeService
@inject IFeeStructureService FeeStructureService
@inject IBranchService BranchService
@inject IClassService ClassService
@inject IBranchContextService BranchContext
@inject INotificationService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Student Fees | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Student Fees
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage student fee assignments, track installment schedules, and collect inward payments.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    id="btn-assign-fee"
                    @onclick="OpenAssignDrawerAsync"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-teal-600/30 text-[#00796b] dark:text-teal-400 hover:bg-teal-50/50 dark:hover:bg-teal-950/40 transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
                <span>Assign Fee</span>
            </button>

            <button type="button" 
                    id="btn-collect-fee"
                    @onclick="() => OpenCollectDrawerAsync(null)"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Collect Fee</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Directly rendered without layout shift) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Total Expected -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Expected</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">₹@_stats.TotalExpected.ToString("N0")</h3>
                    <p class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold mt-0.5">
                        @_totalRecords student assignments
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Total Collected -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Collected</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">₹@_stats.TotalCollected.ToString("N0")</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium mt-0.5">
                        @_stats.CollectionRate% collection rate
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Total Pending Due -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Outstanding</p>
                    <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">₹@_stats.TotalPending.ToString("N0")</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Pending collection</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Overdue -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Overdue Dues</p>
                    <h3 class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">@_stats.OverdueStudentsCount</h3>
                    <p class="text-[10px] text-rose-500 font-medium mt-0.5">Students past due date</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Collection Progress Bar -->
    <div class="card-surface p-4 border border-tealborder shadow-2xs">
        <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-bold text-slate-700 dark:text-slate-300">Overall Fee Collection Progress</span>
            <span class="font-extrabold text-[#009488]">@_stats.CollectionRate% collected (₹@_stats.TotalCollected.ToString("N0") / ₹@_stats.TotalExpected.ToString("N0"))</span>
        </div>
        <div class="w-full h-2.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r from-[#004D40] to-[#009488] transition-all duration-700" style="width: @(_stats.CollectionRate)%"></div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="shrink-0 card-surface p-3.5 border border-tealborder shadow-2xs flex flex-col md:flex-row items-center justify-between gap-3">
        <!-- Search Input -->
        <div class="w-full md:w-80 relative">
            <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text"
                   value="@_searchTerm"
                   @oninput="HandleSearchInput"
                   placeholder="Search student, roll number, fee package..."
                   class="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:border-[#009488] focus:ring-1 focus:ring-[#009488] transition-all" />
        </div>

        <!-- Filter Selectors -->
        <div class="w-full md:w-auto flex flex-wrap items-center gap-2.5">

            <!-- Class Filter -->
            <div class="w-40">
                <CustomSelect Value="@_selectedClassId"
                              ValueChanged="HandleClassFilterChanged"
                              Options="@_classFilterOptions"
                              Placeholder="All Classes" />
            </div>

            <!-- Status Filter -->
            <div class="w-36">
                <CustomSelect Value="@_selectedStatus"
                              ValueChanged="HandleStatusFilterChanged"
                              Options="@_statusFilterOptions"
                              Placeholder="All Status" />
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" 
                        @onclick="ClearFiltersAsync"
                        class="px-3 py-2 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-xl transition-all cursor-pointer">
                    Clear
                </button>
            }
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs flex-1 flex flex-col justify-between min-h-[360px]">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse table-fixed">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider select-none bg-slate-50/50 dark:bg-[#152328]/40">
                        <th class="py-3 px-4 w-[24%] cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("StudentName")'>
                            <div class="flex items-center gap-1.5">
                                <span>Student</span>
                                <span class="@_sortState.GetIndicatorClass("StudentName")">@_sortState.GetIndicator("StudentName")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[18%]">
                            <span>Fee Structure / Branch</span>
                        </th>
                        <th class="py-3 px-3 w-[11%] text-right cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Total")'>
                            <div class="flex items-center justify-end gap-1.5">
                                <span>Total (₹)</span>
                                <span class="@_sortState.GetIndicatorClass("Total")">@_sortState.GetIndicator("Total")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[11%] text-right cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Paid")'>
                            <div class="flex items-center justify-end gap-1.5">
                                <span>Paid (₹)</span>
                                <span class="@_sortState.GetIndicatorClass("Paid")">@_sortState.GetIndicator("Paid")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[11%] text-right cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Due")'>
                            <div class="flex items-center justify-end gap-1.5">
                                <span>Due (₹)</span>
                                <span class="@_sortState.GetIndicatorClass("Due")">@_sortState.GetIndicator("Due")</span>
                            </div>
                        </th>
                        <th class="py-3 px-3 w-[11%] text-center cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="py-3 px-4 w-[14%] text-right">Actions</th>
                    </tr>
                </thead>

                @if (_isLoading && !_items.Any())
                {
                    <TableSkeletonRows Columns="7" Rows="5" />
                }
                else if (!_items.Any())
                {
                    <tbody>
                        <tr>
                            <td colspan="7" class="py-12 text-center">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No Student Fee Records Found</p>
                                    <p class="text-xs text-slate-400 max-w-sm">No fee assignments match your current filters. Assign fee structures to students to start tracking collections.</p>
                                    <button type="button" @onclick="OpenAssignDrawerAsync" class="mt-2 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#009488] text-white shadow-sm hover:bg-[#00796b] transition-all cursor-pointer">
                                        Assign First Fee Structure
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
                else
                {
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs @(_isLoading ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                        @foreach (var item in _items)
                        {
                            <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/20 transition-colors group">
                                <!-- Student Name & Code -->
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold text-[10px] flex items-center justify-center shrink-0">
                                            @item.Initials
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 dark:text-white truncate">@item.StudentName</p>
                                            <p class="text-[10px] text-slate-400 truncate">
                                                @(string.IsNullOrWhiteSpace(item.RollNumber) ? (item.StudentCode ?? "No Roll") : $"Roll: {item.RollNumber}")
                                                @if (!string.IsNullOrWhiteSpace(item.ClassName))
                                                {
                                                    <span> • @item.ClassName</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Fee Structure & Branch -->
                                <td class="py-3 px-3">
                                    <p class="font-semibold text-slate-800 dark:text-slate-200 truncate">@item.FeeStructureName</p>
                                    <p class="text-[10px] text-slate-400 truncate">
                                        @item.BranchName
                                        @if (!string.IsNullOrWhiteSpace(item.BatchName))
                                        {
                                            <span> • @item.BatchName</span>
                                        }
                                    </p>
                                </td>

                                <!-- Total Fee -->
                                <td class="py-3 px-3 text-right">
                                    <p class="font-bold text-slate-900 dark:text-white">₹@item.FinalAmount.ToString("N0")</p>
                                    @if (item.DiscountAmount > 0)
                                    {
                                        <p class="text-[10px] text-emerald-600 font-medium">Saved ₹@item.DiscountAmount.ToString("N0")</p>
                                    }
                                </td>

                                <!-- Paid Amount -->
                                <td class="py-3 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">
                                    ₹@item.PaidAmount.ToString("N0")
                                </td>

                                <!-- Due Amount -->
                                <td class="py-3 px-3 text-right font-extrabold @(item.DueAmount > 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-400")">
                                    ₹@item.DueAmount.ToString("N0")
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3 px-3 text-center">
                                    <span class="@FeeFilterHelper.GetStudentFeeStatusBadgeClass(item.Status)">
                                        @FeeFilterHelper.GetStudentFeeStatusDisplayName(item.Status)
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Statement & History Button -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenStatementDrawerAsync(item.Id)"
                                                    aria-label="View Statement & History"
                                                    class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-all cursor-pointer inline-flex items-center justify-center">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                                </svg>
                                            </button>
                                            <!-- Tooltip -->
                                            <div class="absolute bottom-full right-0 mb-2 hidden group-hover/act:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                    View Statement &amp; History
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-2 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                            </div>
                                        </div>

                                        @if (item.DueAmount > 0)
                                        {
                                            <div class="relative group/act inline-flex items-center justify-center">
                                                <button type="button" 
                                                        @onclick="() => OpenCollectDrawerAsync(item)"
                                                        aria-label="Collect Fee"
                                                        class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/20 transition-all cursor-pointer inline-flex items-center justify-center">
                                                    Collect
                                                </button>
                                                <!-- Tooltip -->
                                                <div class="absolute bottom-full right-0 mb-2 hidden group-hover/act:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-emerald-700 text-white border border-emerald-500/40 shadow-lg tracking-wide">
                                                        Collect Fee
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-3 bg-emerald-700 border-r border-b border-emerald-500/40"></span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="relative group/act inline-flex items-center justify-center">
                                                <button type="button" 
                                                        @onclick="() => DownloadLatestReceiptAsync(item)"
                                                        disabled="@(_downloadingFeeId == item.Id)"
                                                        aria-label="Download Receipt"
                                                        class="p-1.5 rounded-lg text-[#009488] hover:text-[#004D40] dark:text-teal-400 dark:hover:text-teal-200 hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer inline-flex items-center justify-center disabled:opacity-50">
                                                    @if (_downloadingFeeId == item.Id)
                                                    {
                                                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                                        </svg>
                                                    }
                                                </button>
                                                <!-- Tooltip -->
                                                <div class="absolute bottom-full right-0 mb-2 hidden group-hover/act:flex flex-col items-end pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                    <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                        Download Receipt
                                                    </span>
                                                    <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 mr-2 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_currentPage"
                             PageSize="_pageSize"
                             TotalRecords="_totalRecords"
                             ItemLabel="students"
                             IsLoading="_isLoading"
                             OnPageChanged="HandlePageChangedAsync"
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DRAWER 1: Collect Fee Payment Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showCollectDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isCollectDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseCollectDrawerAsync"></div>

    <!-- Right Side-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isCollectDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient & Logo -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-white/10 border border-teal-400/30 p-1.5 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/Logo.svg" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>Collect Fee Payment</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Record inward student payment with automatic installment allocation
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseCollectDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Scrollable Form Body (No Scrollbar) -->
        <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-6 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
            
            <!-- Section 1: Branch & Student Selection -->
            <div class="space-y-4">
                <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                    <span>1. Branch &amp; Student Selection</span>
                </div>

                <!-- Branch Selector inside Drawer -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Branch *</label>
                    <CustomSelect Value="@_drawerBranchId"
                                  ValueChanged="HandleDrawerBranchChangedAsync"
                                  Options="@_drawerBranchOptions"
                                  Placeholder="Select Branch"
                                  Class="w-full" />
                </div>

                <!-- Select Student -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between min-h-[18px]">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Student *</label>
                        @if (_drawerStudentLookupOptions.Any())
                        {
                            <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold">@_drawerStudentLookupOptions.Count student(s) available</span>
                        }
                    </div>
                    <CustomSelect Value="@_collectStudentIdString"
                                  ValueChanged="HandleCollectStudentChanged"
                                  Options="@_drawerStudentLookupOptions"
                                  Placeholder="@(_drawerStudentLookupOptions.Any() ? "Search or select student..." : "No students in selected branch")"
                                  Disabled="@(!_drawerStudentLookupOptions.Any())"
                                  Class="w-full" />
                </div>
            </div>

            @if (_selectedCollectStudent != null)
            {
                <!-- Outstanding Info Box -->
                <div class="p-4 rounded-xl bg-teal-50/70 dark:bg-teal-950/40 border border-teal-200/80 dark:border-teal-800/60 space-y-2.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-600 dark:text-slate-400 font-medium">Student:</span>
                        <span class="font-bold text-slate-900 dark:text-white">@_selectedCollectStudent.FullName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedCollectStudent.RollNumber))
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-600 dark:text-slate-400 font-medium">Roll Number:</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200">@_selectedCollectStudent.RollNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedCollectStudent.ClassName))
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-600 dark:text-slate-400 font-medium">Class / Course:</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200">@_selectedCollectStudent.ClassName</span>
                        </div>
                    }
                    <div class="flex items-center justify-between text-xs pt-1.5 border-t border-teal-200/60 dark:border-teal-800/60">
                        <span class="text-slate-600 dark:text-slate-400 font-bold">Outstanding Balance:</span>
                        <span class="font-black text-rose-600 dark:text-rose-400 text-base">₹@_selectedCollectStudent.PendingDue.ToString("N0")</span>
                    </div>
                </div>

                <!-- Section 2: Payment Collection -->
                <div class="space-y-4 pt-1">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>2. Payment Collection Details</span>
                    </div>

                    <!-- Payment Amount -->
                    <div class="space-y-1">
                        <div class="flex items-center justify-between">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Amount to Collect (₹) *</label>
                            @if (_selectedCollectStudent.PendingDue > 0)
                            {
                                <button type="button" 
                                        @onclick="() => _collectRequest.Amount = _selectedCollectStudent.PendingDue"
                                        class="text-[10px] font-bold text-[#009488] hover:text-[#00796b] hover:underline cursor-pointer">
                                    Pay Full Due (₹@_selectedCollectStudent.PendingDue.ToString("N0"))
                                </button>
                            }
                        </div>
                        <input type="number" 
                               @bind="_collectRequest.Amount" 
                               min="1" 
                               max="@_selectedCollectStudent.PendingDue"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl font-bold text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                    </div>

                    <!-- Payment Mode & Reference -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Payment Mode *</label>
                            <CustomSelect Value="@_collectRequest.PaymentMethod"
                                          ValueChanged="(v) => _collectRequest.PaymentMethod = v"
                                          Options="@_paymentModeOptions"
                                          Placeholder="Select Mode"
                                          Class="w-full" />
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Reference / UTR</label>
                            <input type="text" 
                                   @bind="_collectRequest.TransactionReference"
                                   placeholder="UTR / Cheque / Ref No."
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                        </div>
                    </div>

                    <!-- Remarks -->
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Remarks / Receipt Note</label>
                        <input type="text" 
                               @bind="_collectRequest.Remarks"
                               placeholder="Optional notes or remarks..."
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                    </div>
                </div>
            }
        </div>

        <!-- Drawer Footer Action Buttons -->
        <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3 shrink-0">
            <button type="button" 
                    @onclick="CloseCollectDrawerAsync"
                    class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="button" 
                    @onclick="SubmitPaymentAsync"
                    disabled="@(_isSubmitting || _selectedCollectStudent == null || _collectRequest.Amount <= 0)"
                    class="px-5 py-2.5 text-xs font-bold bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50">
                @if (_isSubmitting)
                {
                    <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    <span>Recording Payment...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Confirm Payment</span>
                }
            </button>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- DRAWER 2: Assign Fee Structure Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showAssignDrawer)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isAssignDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseAssignDrawerAsync"></div>

    <!-- Right Side-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isAssignDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient & Logo -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-white/10 border border-teal-400/30 p-1.5 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/Logo.svg" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>Assign Fee Structure</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        Allocate fee package &amp; configure installment schedules
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseAssignDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Scrollable Form Body (No Scrollbar) -->
        <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-6 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
            
            <!-- Section 1: Branch, Student & Package Selection -->
            <div class="space-y-4">
                <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                    <span>1. Branch, Student &amp; Package</span>
                </div>

                <!-- Branch Selector inside Drawer -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Branch *</label>
                    <CustomSelect Value="@_drawerBranchId"
                                  ValueChanged="HandleDrawerBranchChangedAsync"
                                  Options="@_drawerBranchOptions"
                                  Placeholder="Select Branch"
                                  Class="w-full" />
                </div>

                <!-- Select Student -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between min-h-[18px]">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Student *</label>
                        @if (_drawerStudentLookupOptions.Any())
                        {
                            <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold">@_drawerStudentLookupOptions.Count student(s) available</span>
                        }
                    </div>
                    <CustomSelect Value="@_assignStudentIdString"
                                  ValueChanged="HandleAssignStudentChanged"
                                  Options="@_drawerStudentLookupOptions"
                                  Placeholder="@(_drawerStudentLookupOptions.Any() ? "Search or select student..." : "No students in selected branch")"
                                  Disabled="@(!_drawerStudentLookupOptions.Any())"
                                  Class="w-full" />
                </div>

                <!-- Select Fee Structure -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between min-h-[18px]">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Fee Structure Package *</label>
                        @if (_drawerStructureLookupOptions.Any())
                        {
                            <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold">@_drawerStructureLookupOptions.Count package(s) available</span>
                        }
                    </div>
                    <CustomSelect Value="@_assignStructureIdString"
                                  ValueChanged="HandleAssignStructureChanged"
                                  Options="@_drawerStructureLookupOptions"
                                  Placeholder="@(_drawerStructureLookupOptions.Any() ? "Choose fee package..." : "No packages in selected branch")"
                                  Disabled="@(!_drawerStructureLookupOptions.Any())"
                                  Class="w-full" />
                </div>
            </div>

            @if (_selectedAssignStructure != null)
            {
                <div class="p-4 rounded-xl bg-teal-50/70 dark:bg-teal-950/40 border border-teal-200/80 dark:border-teal-800/60 flex items-center justify-between text-xs">
                    <div class="space-y-0.5">
                        <span class="text-slate-600 dark:text-slate-400 font-medium">Selected Package Total:</span>
                        <div class="text-[11px] text-teal-700 dark:text-teal-300 font-semibold">@_selectedAssignStructure.AcademicSession</div>
                    </div>
                    <span class="font-extrabold text-slate-900 dark:text-white text-base">₹@_selectedAssignStructure.TotalAmount.ToString("N0")</span>
                </div>

                <!-- Section 2: Discount & Installments -->
                <div class="space-y-4 pt-1">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>2. Discount &amp; Installments</span>
                    </div>

                    <!-- Discount Selector -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Discount Type</label>
                            <CustomSelect Value="@_assignRequest.DiscountType"
                                          ValueChanged="(v) => _assignRequest.DiscountType = v"
                                          Options="@_discountTypeOptions"
                                          Placeholder="No Discount"
                                          Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Discount Value</label>
                            <input type="number" 
                                   @bind="_assignRequest.DiscountValue" 
                                   min="0" 
                                   placeholder="@(_assignRequest.DiscountType == nameof(FeeDiscountType.Percentage) ? "% (e.g. 10)" : "₹ (e.g. 2000)")"
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                        </div>
                    </div>

                    <!-- Discount Reason -->
                    @if (!string.IsNullOrWhiteSpace(_assignRequest.DiscountType) && _assignRequest.DiscountValue > 0)
                    {
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Discount Reason / Approval Note</label>
                            <input type="text" 
                                   @bind="_assignRequest.DiscountReason" 
                                   placeholder="e.g. Sibling concession, Merit scholarship"
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                        </div>
                    }

                    <!-- Installments Plan -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Installments *</label>
                            <CustomSelect Value="@_assignRequest.InstallmentsCount.ToString()"
                                          ValueChanged="(v) => _assignRequest.InstallmentsCount = int.TryParse(v, out var n) ? n : 1"
                                          Options="@_installmentsOptions"
                                          Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">First Due Date *</label>
                            <input type="date" 
                                   value="@_assignFirstDueDateString" 
                                   @onchange="(e) => HandleFirstDueDateChange(e.Value?.ToString())"
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white focus:bg-white dark:focus:bg-[#142025] focus:outline-none focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 transition-all" />
                        </div>
                    </div>

                    <!-- Final Amount Summary Box -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-500 dark:text-slate-400">Total Net Payable:</span>
                            <span class="font-extrabold text-[#00796b] dark:text-teal-300 text-base">₹@CalculatedFinalAmount.ToString("N0")</span>
                        </div>
                        @if (_assignRequest.InstallmentsCount > 1)
                        {
                            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1.5 border-t border-slate-200 dark:border-slate-700">
                                <span>Per Installment (approx):</span>
                                <span class="font-semibold text-slate-700 dark:text-slate-300">
                                    ₹@((CalculatedFinalAmount / _assignRequest.InstallmentsCount).ToString("N0")) × @_assignRequest.InstallmentsCount
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Drawer Footer Action Buttons -->
        <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3 shrink-0">
            <button type="button" 
                    @onclick="CloseAssignDrawerAsync"
                    class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="button" 
                    @onclick="SubmitAssignAsync"
                    disabled="@(_isSubmitting || string.IsNullOrEmpty(_assignStudentIdString) || string.IsNullOrEmpty(_assignStructureIdString))"
                    class="px-5 py-2.5 text-xs font-bold bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50">
                @if (_isSubmitting)
                {
                    <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                    <span>Assigning Package...</span>
                }
                else
                {
                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Assign Structure</span>
                }
            </button>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- DRAWER 3: Statement & Installments Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showStatementDrawer && _selectedFeeDetail != null)
{
    <!-- Backdrop Overlay with Smooth Fade -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isStatementDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseStatementDrawerAsync"></div>

    <!-- Right Side-Over Drawer Container with Bidirectional Smooth Slide Transition -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-xl bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isStatementDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Theme 4 Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <!-- Ambient Glow -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-white/10 border border-teal-400/30 text-teal-200 font-extrabold text-xs flex items-center justify-center shadow-md shrink-0">
                    @_selectedFeeDetail.StudentFee.Initials
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@_selectedFeeDetail.StudentFee.StudentName</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @_selectedFeeDetail.StudentFee.FeeStructureName • @_selectedFeeDetail.StudentFee.BranchName
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseStatementDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-6 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
            <!-- Summary Card -->
            <div class="grid grid-cols-3 gap-3 p-4 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-center">
                <div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase">Total Fee</p>
                    <p class="text-sm font-extrabold text-slate-900 dark:text-white mt-0.5">₹@_selectedFeeDetail.StudentFee.FinalAmount.ToString("N0")</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-emerald-600 uppercase">Paid</p>
                    <p class="text-sm font-extrabold text-emerald-600 dark:text-emerald-400 mt-0.5">₹@_selectedFeeDetail.StudentFee.PaidAmount.ToString("N0")</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-rose-600 uppercase">Due</p>
                    <p class="text-sm font-extrabold text-rose-600 dark:text-rose-400 mt-0.5">₹@_selectedFeeDetail.StudentFee.DueAmount.ToString("N0")</p>
                </div>
            </div>

            <!-- Installment Schedule -->
            <div class="space-y-2">
                <h3 class="text-xs font-bold text-slate-800 dark:text-white flex items-center justify-between">
                    <span>Installment Schedule</span>
                    <span class="text-[11px] font-medium text-slate-400">@_selectedFeeDetail.Installments.Count installments</span>
                </h3>
                <div class="border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-slate-50 dark:bg-[#18262c] text-[10px] font-bold text-slate-500 uppercase border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="py-2.5 px-3">#</th>
                                <th class="py-2.5 px-3">Due Date</th>
                                <th class="py-2.5 px-3 text-right">Amount</th>
                                <th class="py-2.5 px-3 text-right">Paid</th>
                                <th class="py-2.5 px-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var inst in _selectedFeeDetail.Installments)
                            {
                                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                    <td class="py-2.5 px-3 font-bold text-slate-700 dark:text-slate-300">Inst @inst.InstallmentNumber</td>
                                    <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">@inst.DueDate.ToString("dd MMM yyyy")</td>
                                    <td class="py-2.5 px-3 text-right font-semibold text-slate-900 dark:text-white">₹@inst.Amount.ToString("N0")</td>
                                    <td class="py-2.5 px-3 text-right font-semibold text-emerald-600">₹@inst.PaidAmount.ToString("N0")</td>
                                    <td class="py-2.5 px-3 text-center">
                                        @if (inst.Status == nameof(StudentFeeStatus.Paid))
                                        {
                                            <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Paid</span>
                                        }
                                        else if (inst.Status == nameof(StudentFeeStatus.PartiallyPaid))
                                        {
                                            <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Partial</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-100 text-slate-600 border border-slate-200">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Payments / Receipts -->
            <div class="space-y-2">
                <h3 class="text-xs font-bold text-slate-800 dark:text-white">Payment Receipts</h3>
                @if (!_selectedFeeDetail.RecentPayments.Any())
                {
                    <p class="text-xs text-slate-400 italic">No payments recorded yet.</p>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var p in _selectedFeeDetail.RecentPayments)
                        {
                            <div class="p-3 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-slate-900 dark:text-white">@p.ReceiptNumber</span>
                                        <span class="text-[10px] px-1.5 py-0.2 rounded bg-teal-50 dark:bg-teal-950 text-[#009488] font-semibold">@p.PaymentMethod</span>
                                    </div>
                                    <p class="text-[10px] text-slate-400 mt-0.5">@p.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="font-black text-emerald-600 dark:text-emerald-400 text-sm mr-1">₹@p.Amount.ToString("N0")</span>
                                    <button type="button" 
                                            @onclick="() => PreviewReceipt(p)"
                                            class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all cursor-pointer"
                                            title="Preview Receipt">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    </button>
                                    <button type="button" 
                                            @onclick="() => DownloadPaymentReceiptAsync(p)"
                                            disabled="@(_downloadingPaymentId == p.Id)"
                                            class="p-1.5 rounded-lg text-[#009488] hover:text-[#004D40] dark:text-teal-400 dark:hover:text-teal-200 hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-all cursor-pointer disabled:opacity-50 inline-flex items-center justify-center"
                                            title="Download PDF Receipt">
                                        @if (_downloadingPaymentId == p.Id)
                                        {
                                            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Drawer Footer Action Buttons -->
        <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3 shrink-0">
            <div>
                @if (_selectedFeeDetail.StudentFee.DueAmount > 0)
                {
                    <button type="button" 
                            @onclick="() => HandleStatementCollectClickedAsync(_selectedFeeDetail.StudentFee)"
                            class="px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md border border-teal-400/30 transition-all flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Collect Payment</span>
                    </button>
                }
            </div>
            <button type="button" 
                    @onclick="CloseStatementDrawerAsync"
                    class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                Close
            </button>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- PRINTABLE RECEIPT MODAL -->
<!-- ========================================================================= -->
<FeeReceiptModal @bind-IsOpen="_showReceiptModal"
                 Receipt="_activeReceipt"
                 InstituteName="Vargshala Coaching Academy"
                 InstituteTagline="Premier Educational & Academic Excellence Center" />

@code {
    private bool _isLoading = true;
    private bool _isSubmitting = false;

    private List<StudentFeeDto> _items = new();
    private FeeStatisticsDto _stats = new();
    private int _totalRecords = 0;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private string _searchTerm = string.Empty;
    private string _selectedClassId = string.Empty;
    private string _selectedStatus = string.Empty;
    private readonly TableSortState _sortState = new();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrWhiteSpace(_selectedClassId) ||
        !string.IsNullOrWhiteSpace(_selectedStatus);

    // Filter Options
    private List<BranchDto> _branches = new();
    private List<CustomSelect.CustomSelectOption> _classFilterOptions = new();
    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = FeeFilterHelper.GetStatusFilterOptions();

    // Drawer Branch & Data State
    private string _drawerBranchId = string.Empty;
    private List<CustomSelect.CustomSelectOption> _drawerBranchOptions = new();
    private List<StudentLookupForFeeDto> _allDrawerStudentLookups = new();
    private List<CustomSelect.CustomSelectOption> _drawerStudentLookupOptions = new();
    private List<FeeStructureLookupDto> _allDrawerStructureLookups = new();
    private List<CustomSelect.CustomSelectOption> _drawerStructureLookupOptions = new();

    // Collect Fee State
    private bool _showCollectDrawer = false;
    private bool _isCollectDrawerOpen = false;
    private CollectPaymentRequest _collectRequest = new();
    private string _collectStudentIdString = string.Empty;
    private StudentLookupForFeeDto? _selectedCollectStudent = null;

    // Assign Fee State
    private bool _showAssignDrawer = false;
    private bool _isAssignDrawerOpen = false;
    private AssignStudentFeeRequest _assignRequest = new();
    private string _assignStudentIdString = string.Empty;
    private string _assignStructureIdString = string.Empty;
    private string _assignFirstDueDateString = DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd");
    private FeeStructureLookupDto? _selectedAssignStructure = null;

    // Statement & Receipt State
    private bool _showStatementDrawer = false;
    private bool _isStatementDrawerOpen = false;
    private StudentFeeDetailDto? _selectedFeeDetail = null;

    private bool _showReceiptModal = false;
    private PaymentDto? _activeReceipt = null;
    private Guid? _downloadingFeeId = null;

    private readonly List<CustomSelect.CustomSelectOption> _paymentModeOptions = FeeFilterHelper.GetPaymentMethodOptions();
    private readonly List<CustomSelect.CustomSelectOption> _discountTypeOptions = FeeFilterHelper.GetDiscountTypeOptions();
    private readonly List<CustomSelect.CustomSelectOption> _installmentsOptions = FeeFilterHelper.GetInstallmentOptions();

    private decimal CalculatedFinalAmount =>
        FeeFilterHelper.CalculateNetPayable(
            _selectedAssignStructure?.TotalAmount ?? 0,
            _assignRequest.DiscountType,
            _assignRequest.DiscountValue);

    protected override async Task OnInitializedAsync()
    {
        BranchContext.OnBranchChanged += HandleBranchContextChangedAsync;

        if (!BranchContext.IsInitialized)
        {
            await BranchContext.InitializeAsync();
        }

        await LoadFilterDropdownsAsync();
        await LoadDataAsync(1);
    }

    private async Task HandleBranchContextChangedAsync()
    {
        _selectedClassId = string.Empty;
        await InvokeAsync(async () =>
        {
            await LoadFilterDropdownsAsync();
            await LoadDataAsync(1);
            StateHasChanged();
        });
    }

    private async Task LoadFilterDropdownsAsync()
    {
        // 1. Branches (for drawer branch options)
        var branchRes = await BranchService.GetAllActiveBranchesAsync();
        if (branchRes.Success && branchRes.Data != null)
        {
            _branches = branchRes.Data;
            _drawerBranchOptions = _branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name + (b.IsMainBranch ? " (Main Branch)" : ""))).ToList();
        }

        // 2. Classes (Filtered by the currently selected global branch)
        Guid? bId = BranchContext.CurrentBranchId;
        var classRes = await ClassService.GetAllActiveClassesAsync(bId);
        if (classRes.Success && classRes.Data != null)
        {
            _classFilterOptions = new() { new("", "All Classes") };

            if (!bId.HasValue && _branches.Count > 1)
            {
                // In "All Branches" mode, append branch name to prevent ambiguous duplicate class names (e.g. Class 10th (Main Branch))
                _classFilterOptions.AddRange(classRes.Data.Select(c =>
                {
                    var branchName = _branches.FirstOrDefault(b => b.Id == c.BranchId)?.Name;
                    var label = !string.IsNullOrWhiteSpace(branchName) ? $"{c.Name} ({branchName})" : c.Name;
                    return new CustomSelect.CustomSelectOption(c.Id.ToString(), label);
                }));
            }
            else
            {
                _classFilterOptions.AddRange(classRes.Data.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)));
            }
        }
    }

    private async Task LoadDataAsync(int page)
    {
        _isLoading = true;
        _currentPage = page;

        Guid? branchId = BranchContext.CurrentBranchId;
        Guid? classId = Guid.TryParse(_selectedClassId, out var c) && c != Guid.Empty ? c : null;

        var req = new PagedRequest
        {
            PageNumber = _currentPage,
            PageSize = _pageSize,
            Search = _searchTerm,
            SortBy = _sortState.Column,
            SortDirection = _sortState.IsSorted ? (_sortState.Direction == SortDirection.Descending ? "desc" : "asc") : null
        };

        var taskList = FeeService.GetStudentFeesPagedAsync(req, branchId, classId, null, _selectedStatus);
        var taskStats = FeeService.GetFeeStatisticsAsync(branchId);

        await Task.WhenAll(taskList, taskStats);

        var listRes = await taskList;
        if (listRes.Success && listRes.Data != null)
        {
            _items = listRes.Data.Items;
            _totalRecords = listRes.Data.TotalRecords;
        }
        else
        {
            _items = new();
            _totalRecords = 0;
            if (!string.IsNullOrWhiteSpace(listRes.Message))
            {
                if (listRes.Message.Contains("401") || listRes.Message.Contains("Unauthorized"))
                {
                    Toast.Error("Your session has expired. Please log in again.");
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
                Toast.Error(listRes.Message);
            }
        }

        var statsRes = await taskStats;
        if (statsRes.Success && statsRes.Data != null)
        {
            _stats = statsRes.Data;
        }

        _isLoading = false;
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadDataAsync(1);
    }

    private async Task HandleClassFilterChanged(string val)
    {
        _selectedClassId = val;
        await LoadDataAsync(1);
    }

    private async Task HandleStatusFilterChanged(string val)
    {
        _selectedStatus = val;
        await LoadDataAsync(1);
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = string.Empty;
        _selectedClassId = string.Empty;
        _selectedStatus = string.Empty;
        _sortState.Reset();
        await LoadDataAsync(1);
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadDataAsync(1);
    }

    private async Task HandlePageChangedAsync(int page)
    {
        await LoadDataAsync(page);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _pageSize = newSize;
        await LoadDataAsync(1);
    }

    // =========================================================================
    // DRAWER HELPER & BRANCH LOGIC
    // =========================================================================
    private string DetermineDefaultDrawerBranchId()
    {
        // 1. Check if BranchContext has a current branch selected
        if (BranchContext.CurrentBranchId.HasValue && BranchContext.CurrentBranchId.Value != Guid.Empty)
        {
            return BranchContext.CurrentBranchId.Value.ToString();
        }

        // 2. Find the main branch from loaded branches
        var main = _branches.FirstOrDefault(b => b.IsMainBranch);
        if (main != null)
        {
            return main.Id.ToString();
        }

        // 3. Fallback to first branch if any
        return _branches.FirstOrDefault()?.Id.ToString() ?? string.Empty;
    }

    private async Task HandleDrawerBranchChangedAsync(string newBranchId)
    {
        _drawerBranchId = newBranchId;

        // Reset student selection
        _collectStudentIdString = string.Empty;
        _selectedCollectStudent = null;
        _collectRequest.StudentId = Guid.Empty;
        _collectRequest.Amount = 0;

        _assignStudentIdString = string.Empty;
        _assignStructureIdString = string.Empty;
        _selectedAssignStructure = null;
        _assignRequest.StudentId = Guid.Empty;
        _assignRequest.FeeStructureId = Guid.Empty;

        Guid? branchGuid = Guid.TryParse(newBranchId, out var g) && g != Guid.Empty ? g : null;
        await LoadDrawerStudentsAsync(branchGuid);

        if (_showAssignDrawer)
        {
            await LoadDrawerStructuresAsync(branchGuid);
        }

        StateHasChanged();
    }

    private async Task LoadDrawerStudentsAsync(Guid? branchId)
    {
        var res = await FeeService.GetStudentsLookupAsync(branchId);
        if (res.Success && res.Data != null)
        {
            _allDrawerStudentLookups = res.Data;

            // Ensure only students belonging to the chosen branch are presented in the drawer
            if (branchId.HasValue && branchId.Value != Guid.Empty)
            {
                _allDrawerStudentLookups = _allDrawerStudentLookups
                    .Where(s => s.BranchId == branchId.Value)
                    .ToList();
            }

            _drawerStudentLookupOptions = _allDrawerStudentLookups
                .Select(s => new CustomSelect.CustomSelectOption(
                    s.StudentId.ToString(),
                    $"{s.FullName} {(string.IsNullOrWhiteSpace(s.RollNumber) ? "" : $"({s.RollNumber})")} - Due: ₹{s.PendingDue:N0}"))
                .ToList();
        }
        else
        {
            _allDrawerStudentLookups = new();
            _drawerStudentLookupOptions = new();
        }
    }

    private async Task LoadDrawerStructuresAsync(Guid? branchId)
    {
        var res = await FeeStructureService.GetAllActiveFeeStructuresAsync(branchId);
        if (res.Success && res.Data != null)
        {
            _allDrawerStructureLookups = res.Data;
            _drawerStructureLookupOptions = _allDrawerStructureLookups
                .Select(fs => new CustomSelect.CustomSelectOption(
                    fs.Id.ToString(),
                    $"{fs.Name} (₹{fs.TotalAmount:N0}) - {fs.AcademicSession}"))
                .ToList();
        }
        else
        {
            _allDrawerStructureLookups = new();
            _drawerStructureLookupOptions = new();
        }
    }

    // =========================================================================
    // COLLECT FEE ACTIONS
    // =========================================================================
    private async Task OpenCollectDrawerAsync(StudentFeeDto? preselected)
    {
        _collectRequest = new CollectPaymentRequest();
        _selectedCollectStudent = null;
        _collectStudentIdString = string.Empty;

        // Default to Main Branch / current branch context
        _drawerBranchId = DetermineDefaultDrawerBranchId();
        if (preselected != null && preselected.BranchId != Guid.Empty)
        {
            _drawerBranchId = preselected.BranchId.ToString();
        }

        Guid? branchGuid = Guid.TryParse(_drawerBranchId, out var g) && g != Guid.Empty ? g : null;
        await LoadDrawerStudentsAsync(branchGuid);

        if (preselected != null)
        {
            _collectStudentIdString = preselected.StudentId.ToString();
            _selectedCollectStudent = _allDrawerStudentLookups.FirstOrDefault(s => s.StudentId == preselected.StudentId)
                ?? new StudentLookupForFeeDto
                {
                    StudentId = preselected.StudentId,
                    FullName = preselected.StudentName,
                    RollNumber = preselected.RollNumber,
                    ClassName = preselected.ClassName,
                    BranchId = preselected.BranchId,
                    BranchName = preselected.BranchName,
                    PendingDue = preselected.DueAmount
                };
            _collectRequest.StudentId = preselected.StudentId;
            _collectRequest.StudentFeeId = preselected.Id;
            _collectRequest.Amount = preselected.DueAmount;
        }

        _showCollectDrawer = true;
        StateHasChanged();
        await Task.Yield();
        _isCollectDrawerOpen = true;
    }

    private async Task CloseCollectDrawerAsync()
    {
        _isCollectDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showCollectDrawer = false;
    }

    private void HandleCollectStudentChanged(string val)
    {
        _collectStudentIdString = val;
        if (Guid.TryParse(val, out var sId))
        {
            _selectedCollectStudent = _allDrawerStudentLookups.FirstOrDefault(s => s.StudentId == sId);
            _collectRequest.StudentId = sId;
            _collectRequest.Amount = _selectedCollectStudent?.PendingDue ?? 0;
        }
        else
        {
            _selectedCollectStudent = null;
            _collectRequest.StudentId = Guid.Empty;
            _collectRequest.Amount = 0;
        }
    }

    private async Task SubmitPaymentAsync()
    {
        if (_selectedCollectStudent == null || _collectRequest.Amount <= 0) return;

        _isSubmitting = true;
        var res = await FeeService.CollectFeeAsync(_collectRequest);
        _isSubmitting = false;

        if (res.Success && res.Data != null)
        {
            Toast.Success(res.Message ?? "Payment collected successfully!");
            await CloseCollectDrawerAsync();
            _activeReceipt = res.Data;
            _showReceiptModal = true;
            await LoadDataAsync(_currentPage);
        }
        else
        {
            if (res.Message?.Contains("401") == true || res.Message?.Contains("Unauthorized") == true)
            {
                Toast.Error("Your session has expired. Please log in again.");
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            Toast.Error(res.Message ?? "Failed to collect payment.");
        }
    }

    // =========================================================================
    // ASSIGN FEE ACTIONS
    // =========================================================================
    private async Task OpenAssignDrawerAsync()
    {
        _assignRequest = new AssignStudentFeeRequest();
        _assignStudentIdString = string.Empty;
        _assignStructureIdString = string.Empty;
        _selectedAssignStructure = null;
        _assignFirstDueDateString = DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd");
        _assignRequest.FirstDueDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7));

        _drawerBranchId = DetermineDefaultDrawerBranchId();
        Guid? branchGuid = Guid.TryParse(_drawerBranchId, out var g) && g != Guid.Empty ? g : null;

        await LoadDrawerStudentsAsync(branchGuid);
        await LoadDrawerStructuresAsync(branchGuid);

        _showAssignDrawer = true;
        StateHasChanged();
        await Task.Yield();
        _isAssignDrawerOpen = true;
    }

    private async Task CloseAssignDrawerAsync()
    {
        _isAssignDrawerOpen = false;
        StateHasChanged();
        await Task.Delay(300);
        _showAssignDrawer = false;
    }

    private void HandleAssignStudentChanged(string val)
    {
        _assignStudentIdString = val;
        _assignRequest.StudentId = Guid.TryParse(val, out var sId) ? sId : Guid.Empty;
    }

    private void HandleAssignStructureChanged(string val)
    {
        _assignStructureIdString = val;
        if (Guid.TryParse(val, out var fsId))
        {
            _selectedAssignStructure = _allDrawerStructureLookups.FirstOrDefault(fs => fs.Id == fsId);
            _assignRequest.FeeStructureId = fsId;
        }
        else
        {
            _selectedAssignStructure = null;
            _assignRequest.FeeStructureId = Guid.Empty;
        }
    }

    private void HandleFirstDueDateChange(string? dateStr)
    {
        if (DateTime.TryParse(dateStr, out var dt))
        {
            _assignFirstDueDateString = dt.ToString("yyyy-MM-dd");
            _assignRequest.FirstDueDate = DateOnly.FromDateTime(dt);
        }
    }

    private async Task SubmitAssignAsync()
    {
        if (_assignRequest.StudentId == Guid.Empty || _assignRequest.FeeStructureId == Guid.Empty) return;

        _isSubmitting = true;
        var res = await FeeService.AssignFeeAsync(_assignRequest);
        _isSubmitting = false;

        if (res.Success && res.Data != null)
        {
            Toast.Success(res.Message ?? "Fee structure assigned successfully!");
            await CloseAssignDrawerAsync();
            await LoadDataAsync(1);
        }
        else
        {
            if (res.Message?.Contains("401") == true || res.Message?.Contains("Unauthorized") == true)
            {
                Toast.Error("Your session has expired. Please log in again.");
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            Toast.Error(res.Message ?? "Failed to assign fee structure.");
        }
    }

