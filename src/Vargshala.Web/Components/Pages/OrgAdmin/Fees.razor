@page "/fees"
@attribute [Authorize(Roles = "SuperAdmin,OrganizationAdmin")]
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Badges
@rendermode InteractiveServer

<PageTitle>Fees Management | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">Fees Management</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Track fee collection, pending dues, and payment history.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] transition-all shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Export Report</span>
            </button>
            <button type="button" @onclick="() => _showCollectModal = true"
                    class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                </span>
                <span>Collect Fee</span>
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Expected</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">₹@_totalExpected.ToString("N0")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Collected</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">₹@_totalCollected.ToString("N0")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Pending</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">₹@_totalPending.ToString("N0")</h3>
            </div>
        </div>
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/80 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Overdue</p>
                <h3 class="text-lg font-extrabold text-rose-600 dark:text-rose-400">@_feeRecords.Count(f => f.Status == "Overdue") students</h3>
            </div>
        </div>
    </div>

    <!-- Collection Progress -->
    <div class="card-surface p-5 space-y-3">
        <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-700 dark:text-slate-300">Fee Collection Progress</span>
            <span class="font-extrabold text-[#009488]">@CollectionPercent% collected</span>
        </div>
        <div class="w-full h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r from-[#009488] to-[#00796b] transition-all duration-700" style="width: @(CollectionPercent)%"></div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <div class="relative flex-1 w-full lg:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Search by student name..."
                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_filterBatch" Options="_batchFilterOptions" Placeholder="All Batches" />
            <CustomSelect @bind-Value="_filterStatus" Options="_statusFilterOptions" Placeholder="All Status" />
        </div>
    </div>

    <!-- Fee Records Table -->
    <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                        <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => _sortState.Toggle("Name")'>
                            <div class="flex items-center gap-1.5"><span>Student</span><span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span></div>
                        </th>
                        <th class="py-3.5 px-4">Batch</th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => _sortState.Toggle("Total")'>
                            <div class="flex items-center gap-1.5"><span>Total Fee</span><span class="@_sortState.GetIndicatorClass("Total")">@_sortState.GetIndicator("Total")</span></div>
                        </th>
                        <th class="py-3.5 px-4">Paid</th>
                        <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => _sortState.Toggle("Due")'>
                            <div class="flex items-center gap-1.5"><span>Due</span><span class="@_sortState.GetIndicatorClass("Due")">@_sortState.GetIndicator("Due")</span></div>
                        </th>
                        <th class="py-3.5 px-4">Status</th>
                        <th class="py-3.5 px-4">Last Payment</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                    @foreach (var record in FilteredRecords)
                    {
                        <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors">
                            <td class="py-3.5 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold text-[10px] flex items-center justify-center shrink-0">
                                        @record.Initials
                                    </div>
                                    <span class="font-bold text-slate-900 dark:text-white">@record.StudentName</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400">@record.BatchName</span>
                            </td>
                            <td class="py-3.5 px-4 font-bold text-slate-800 dark:text-white">₹@record.TotalFee.ToString("N0")</td>
                            <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">₹@record.PaidAmount.ToString("N0")</td>
                            <td class="py-3.5 px-4 font-extrabold @(record.DueAmount > 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-400")">₹@record.DueAmount.ToString("N0")</td>
                            <td class="py-3.5 px-4">
                                @if (record.Status == "Paid")
                                { <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">Paid</span> }
                                else if (record.Status == "Partial")
                                { <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800">Partial</span> }
                                else
                                { <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 dark:bg-rose-950/70 text-rose-700 dark:text-rose-300 border border-rose-200/80 dark:border-rose-800">Overdue</span> }
                            </td>
                            <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 font-medium">@record.LastPaymentDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Collect Fee Modal -->
@if (_showCollectModal)
{
    <Modal IsOpen="true" Title="Collect Fee Payment" Subtitle="Record a new fee payment" MaxWidth="max-w-md" OnClose="() => _showCollectModal = false">
        <ChildContent>
            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Select Student</label>
                    <CustomSelect @bind-Value="_collectStudentName" Options="_studentOptions" Placeholder="Select Student" Class="w-full" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Amount (₹)</label>
                        <input type="number" @bind="_collectAmount" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none font-bold text-slate-800 dark:text-white" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Payment Mode</label>
                        <CustomSelect @bind-Value="_collectMode" Options="_paymentModeOptions" Placeholder="Mode" Class="w-full" />
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => _showCollectModal = false" class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl transition-all cursor-pointer">Cancel</button>
            <button type="button" @onclick="ProcessCollection" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Confirm Payment</span>
            </button>
        </FooterTemplate>
    </Modal>
}

@code {
    private string _searchQuery = string.Empty;
    private string _filterBatch = string.Empty;
    private string _filterStatus = string.Empty;
    private bool _showCollectModal = false;
    private string _collectStudentName = string.Empty;
    private decimal _collectAmount = 5000;
    private string _collectMode = "UPI";
    private readonly TableSortState _sortState = new();

    private decimal _totalExpected => _feeRecords.Sum(f => f.TotalFee);
    private decimal _totalCollected => _feeRecords.Sum(f => f.PaidAmount);
    private decimal _totalPending => _feeRecords.Sum(f => f.DueAmount);
    private int CollectionPercent => _totalExpected > 0 ? (int)Math.Round(_totalCollected / _totalExpected * 100) : 0;

    private readonly List<CustomSelect.CustomSelectOption> _batchFilterOptions = new()
    {
        new("", "All Batches"), new("Class 10 — Maths", "Class 10 — Maths"), new("Class 10 — Science", "Class 10 — Science"),
        new("Class 12 — Physics", "Class 12 — Physics"), new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };
    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Status"), new("Paid", "Paid"), new("Partial", "Partial"), new("Overdue", "Overdue")
    };
    private readonly List<CustomSelect.CustomSelectOption> _studentOptions = new()
    {
        new("Aarav Mehta", "Aarav Mehta"), new("Isha Agarwal", "Isha Agarwal"), new("Kabir Singh", "Kabir Singh"),
        new("Vivaan Chopra", "Vivaan Chopra"), new("Devansh Jain", "Devansh Jain")
    };
    private readonly List<CustomSelect.CustomSelectOption> _paymentModeOptions = new()
    {
        new("UPI", "UPI / Online"), new("Cash", "Cash"), new("Bank Transfer", "Bank Transfer"), new("Cheque", "Cheque")
    };

    private readonly List<FeeRecord> _feeRecords = new()
    {
        new("Aarav Mehta", "Class 10 — Maths", 25000, 25000, "Paid", "28 Aug 2026"),
        new("Isha Agarwal", "Class 10 — Maths", 25000, 15000, "Partial", "15 Aug 2026"),
        new("Kabir Singh", "Class 10 — Science", 28000, 0, "Overdue", "—"),
        new("Ananya Rao", "Class 10 — Science", 28000, 28000, "Paid", "01 Sep 2026"),
        new("Devansh Jain", "Class 12 — Physics", 32000, 20000, "Partial", "20 Aug 2026"),
        new("Ridhima Kaur", "Class 12 — Chemistry", 32000, 32000, "Paid", "25 Aug 2026"),
        new("Vivaan Chopra", "IIT-JEE Morning Batch", 65000, 20000, "Overdue", "10 Jul 2026"),
        new("Meera Iyer", "IIT-JEE Morning Batch", 65000, 65000, "Paid", "01 Sep 2026")
    };

    private List<FeeRecord> FilteredRecords
    {
        get
        {
            var query = _feeRecords.Where(f =>
                (string.IsNullOrWhiteSpace(_searchQuery) || f.StudentName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_filterBatch) || f.BatchName == _filterBatch) &&
                (string.IsNullOrWhiteSpace(_filterStatus) || f.Status == _filterStatus));

            if (_sortState.IsSorted)
            {
                query = _sortState.Column switch
                {
                    "Name" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(f => f.StudentName) : query.OrderByDescending(f => f.StudentName),
                    "Total" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(f => f.TotalFee) : query.OrderByDescending(f => f.TotalFee),
                    "Due" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(f => f.DueAmount) : query.OrderByDescending(f => f.DueAmount),
                    _ => query
                };
            }
            return query.ToList();
        }
    }

    private void ProcessCollection() { _showCollectModal = false; }

    public class FeeRecord
    {
        public string StudentName { get; set; }
        public string BatchName { get; set; }
        public decimal TotalFee { get; set; }
        public decimal PaidAmount { get; set; }
        public decimal DueAmount => TotalFee - PaidAmount;
        public string Status { get; set; }
        public string LastPaymentDate { get; set; }
        public string Initials => string.Join("", StudentName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();

        public FeeRecord(string name, string batch, decimal total, decimal paid, string status, string lastPayment)
        { StudentName = name; BatchName = batch; TotalFee = total; PaidAmount = paid; Status = status; LastPaymentDate = lastPayment; }
    }
}
