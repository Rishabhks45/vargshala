            );
        }

        // 3. Mathematics: Blue (Sigma / Math Icon)
        if (name.Contains("math") || name.Contains("calc") || name.Contains("algeb") || name.Contains("trig"))
        {
            return (
                "bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400",
                "bg-blue-600",
                "<svg class='w-5 h-5 font-bold' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.2' d='M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z'/></svg>"
