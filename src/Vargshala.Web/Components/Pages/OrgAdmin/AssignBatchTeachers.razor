    private void PromptAssignModal(Guid subjectId)
    {
        if (_selectedBatchDetail == null) return;

        var assignedToThisSubj = _selectedBatchDetail.Teachers
            .Where(t => t.IsActive && t.SubjectId == subjectId)
            .Select(t => t.TeacherId)
            .ToHashSet();

        var firstAvailable = FilteredAvailableTeachers.FirstOrDefault(t => !assignedToThisSubj.Contains(t.Id));
        if (firstAvailable != null)
        {
            _ = AssignTeacherDirectlyAsync(firstAvailable.Id, subjectId);
        }
        else
        {
            Toast.Info("Pick a teacher from the left panel to assign.");
        }
    }

    private async Task SaveAssignmentsAsync()
    {
        if (_selectedBatchDetail == null) return;
        Toast.Success("Batch teacher assignments are saved and active.");
    }

    private async Task ClearAllAssignmentsAsync()
    {
        if (_selectedBatchDetail == null || !_selectedBatchDetail.Teachers.Any(t => t.IsActive))
        {
            Toast.Info("No teachers are assigned to this batch.");
            return;
        }

        var batchId = _selectedBatchDetail.Batch.Id;
        var distinctTeacherIds = _selectedBatchDetail.Teachers
            .Where(t => t.IsActive)
            .Select(t => t.TeacherId)
            .Distinct()
            .ToList();

        foreach (var tId in distinctTeacherIds)
        {
            await BatchService.RemoveTeacherFromBatchAsync(batchId, tId, null);
        }

        Toast.Success("All teacher assignments cleared for this batch.");
        await LoadBatchDetailAsync(batchId);
        await LoadAvailableTeachersAsync();
    }

    private async Task AutoAssignAsync()
    {
        if (_selectedBatchDetail == null) return;

        int assignedCount = 0;
        var batchId = _selectedBatchDetail.Batch.Id;

        foreach (var subj in _displaySubjects)
        {
            var alreadyAssigned = _selectedBatchDetail.Teachers
                .Any(t => t.IsActive && t.SubjectId == subj.Id);

            if (alreadyAssigned) continue;

            var match = _availableTeachers.FirstOrDefault(t =>
                t.IsActive &&
                ((!string.IsNullOrWhiteSpace(t.Department) && string.Equals(t.Department, subj.Name, StringComparison.OrdinalIgnoreCase)) ||
                 (!string.IsNullOrWhiteSpace(t.Specialization) && string.Equals(t.Specialization, subj.Name, StringComparison.OrdinalIgnoreCase))));

            if (match != null)
            {
                var res = await BatchService.AssignTeacherToBatchAsync(batchId, new AssignTeacherToBatchRequest
                {
                    TeacherId = match.Id,
                    SubjectId = subj.Id
                });

                if (res.Success)
                {
                    assignedCount++;
                }
            }
        }

        if (assignedCount > 0)
        {
            Toast.Success($"Auto-assigned {assignedCount} matching faculty members.");
            await LoadBatchDetailAsync(batchId);
            await LoadAvailableTeachersAsync();
        }
        else
        {
            var primarySubj = _displaySubjects.FirstOrDefault(s => s.IsPrimary) ?? _displaySubjects.FirstOrDefault();
            if (primarySubj != null)
            {
                var hasPrimaryTeacher = _selectedBatchDetail.Teachers.Any(t => t.IsActive && t.SubjectId == primarySubj.Id);
                if (!hasPrimaryTeacher)
                {
                    var first = _availableTeachers.FirstOrDefault(t => t.IsActive);
                    if (first != null)
                    {
                        var res = await BatchService.AssignTeacherToBatchAsync(batchId, new AssignTeacherToBatchRequest
                        {
                            TeacherId = first.Id,
                            SubjectId = primarySubj.Id
                        });
                        if (res.Success)
                        {
                            Toast.Success("Auto-assigned faculty member to primary subject.");
                            await LoadBatchDetailAsync(batchId);
                            await LoadAvailableTeachersAsync();
                            return;
                        }
                    }
                }
            }
            Toast.Info("No matching faculty members could be auto-assigned.");
        }
    }

