@page "/batches/assign-teachers"
@page "/batches/assign-teachers/{BatchId:guid}"
@page "/batches/{BatchId:guid}/assign-teachers"
@attribute [Authorize(Roles = "OrganizationAdmin,SuperAdmin,1,1001")]
@using Microsoft.AspNetCore.Components.Web
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Batches
@using Vargshala.Contracts.Classes
@using Vargshala.Contracts.Subjects
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Teachers
@using Vargshala.Contracts.Students
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services
@inject IBatchService BatchService
@inject IBranchService BranchService
@inject IClassService ClassService
@inject ISubjectService SubjectService
@inject ITeacherService TeacherService
@inject INotificationService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Assign Teachers to Batch | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-4 transition-colors duration-200 h-full overflow-y-auto no-scrollbar pb-10" style="scrollbar-width: none; -ms-overflow-style: none;">

    <!-- Top Header & Action Controls (Strictly aligned with Students.razor) -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shadow-[#004D40]/20 shrink-0">
                <svg class="w-5 h-5 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Assign Teachers to Batch
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Drag and drop teachers or click assign to map faculty members to batches and subjects.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <button type="button" 
                    @onclick="NavigateBack"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>Back to Batches</span>
            </button>

            <button type="button" 
                    @onclick="SaveAssignmentsAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Save Assignments</span>
            </button>
        </div>
    </div>

    <!-- Batch Selection Toolbar (Strictly matching Students.razor Filter Toolbar) -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <div class="w-48">
                <CustomSelect Value="@(_selectedBranchId == Guid.Empty ? "" : _selectedBranchId.ToString())"
                              ValueChanged="OnBranchChanged"
                              Options="_branchOptions"
                              Placeholder="Select Branch" />
            </div>
            <div class="w-56">
                <CustomSelect Value="@(_selectedBatchId == Guid.Empty ? "" : _selectedBatchId.ToString())"
                              ValueChanged="OnBatchChanged"
                              Options="_batchOptions"
                              Placeholder="Select Batch" />
            </div>
            <div class="w-32">
                <CustomSelect Value="@_selectedSession"
                              ValueChanged="@((string v) => _selectedSession = v)"
                              Options="_sessionOptions"
                              Placeholder="Academic Session" />
            </div>
        </div>

        @if (_isLoadingBatch && _selectedBatchDetail == null)
        {
            <div class="flex items-center gap-3 shrink-0">
                <Skeleton Width="90px" Height="16px" />
                <Skeleton Width="80px" Height="16px" />
                <Skeleton Width="60px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
            </div>
        }
        else if (_selectedBatchDetail != null)
        {
            <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 font-medium shrink-0">
                <span>Class: <strong class="text-slate-800 dark:text-white">@_selectedBatchDetail.Batch.ClassName</strong></span>
                <span class="text-slate-300 dark:text-slate-600">•</span>
                <span>Students: <strong class="text-slate-800 dark:text-white">@_selectedBatchDetail.Batch.StudentCount</strong></span>
                <span class="text-slate-300 dark:text-slate-600">•</span>
                @if (_selectedBatchDetail.Batch.IsActive)
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                        Active
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1"></span>
                        Inactive
                    </span>
                }
            </div>
        }
    </div>

    <!-- 3-Column Main Canvas (Strictly side-by-side on desktop: 3 + 6 + 3 = 12) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 items-start">

        <!-- ========================================================================= -->
        <!-- COLUMN 1: Available Teachers (Left Panel - 3 cols) -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-3 min-w-0 card-surface p-4 border border-tealborder shadow-2xs flex flex-col gap-3">
            <!-- Header -->
            <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <h2 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                        Available Teachers
                    </h2>
                </div>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/50">
                    @FilteredAvailableTeachers.Count() Teachers
                </span>
            </div>

            <!-- Search input using reusable SearchInput with debounce -->
            <SearchInput @bind-Value="_teacherSearchQuery"
                         Placeholder="Search by name, subject, code..." />

            <!-- Filter Controls -->
            <div class="grid grid-cols-2 gap-2">
                <CustomSelect Value="@_selectedSubjectFilter"
                              ValueChanged="@((string v) => _selectedSubjectFilter = v)"
                              Options="_subjectFilterOptions"
                              Placeholder="All Subjects"
                              Class="w-full text-xs" />

                <CustomSelect Value="@_selectedStatusFilter"
                              ValueChanged="@((string v) => _selectedStatusFilter = v)"
                              Options="_teacherStatusOptions"
                              Placeholder="All Faculty"
                              Class="w-full text-xs" />
            </div>

            <!-- Teacher Cards Scrollable List with Skeletons on Initial Load -->
            <div class="space-y-2 max-h-[580px] overflow-y-auto no-scrollbar pr-1 @(_isLoadingTeachers && _availableTeachers.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")" style="scrollbar-width: none; -ms-overflow-style: none;">
                @if (_isLoadingTeachers && !_availableTeachers.Any())
                {
                    <SkeletonTeacherCards Count="5" />
                }
                else if (!FilteredAvailableTeachers.Any())
                {
                    <div class="py-10 text-center text-slate-400 rounded-xl bg-slate-50 dark:bg-[#142025] border border-dashed border-slate-200 dark:border-slate-800">
                        <p class="text-xs font-bold text-slate-600 dark:text-slate-300">No teachers found</p>
                        <p class="text-[10px] mt-1 text-slate-400">Try changing branch or search filters.</p>
                    </div>
                }
                else
                {
                    @foreach (var teacher in FilteredAvailableTeachers)
                    {
                        var isAssignedToCurrent = _currentAssignedTeacherIds.Contains(teacher.Id);
                        <div draggable="true"
                             @ondragstart="() => OnDragStart(teacher)"
                             class="group p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 bg-white dark:bg-[#142025] hover:border-[#009488]/50 hover:shadow-xs transition-all flex items-center justify-between gap-2 cursor-grab active:cursor-grabbing">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <!-- Clean Theme 4 Avatar Initials / Photo (Students.razor standard) -->
                                @if (!string.IsNullOrWhiteSpace(teacher.ProfilePictureUrl))
                                {
                                    <img src="@teacher.ProfilePictureUrl"
                                         alt="@teacher.FullName"
                                         class="w-8 h-8 rounded-lg object-cover shrink-0 border border-slate-100 dark:border-slate-700" />
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-[#009488] font-bold text-xs flex items-center justify-center shrink-0">
                                        @teacher.Initials
                                    </div>
                                }

                                <div class="min-w-0">
                                    <h3 class="text-xs font-bold text-slate-800 dark:text-white truncate">@teacher.FullName</h3>
                                    <div class="flex flex-wrap items-center gap-1 mt-0.5">
                                        @if (!string.IsNullOrWhiteSpace(teacher.Department))
                                        {
                                            <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-md @GetSubjectBadgeClass(teacher.Department)">
                                                @teacher.Department
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(teacher.Specialization) && !string.Equals(teacher.Specialization, teacher.Department, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded-md @GetSubjectBadgeClass(teacher.Specialization)">
                                                @teacher.Specialization
                                            </span>
                                        }
                                        @if (teacher.BatchCount > 0)
                                        {
                                            <span class="text-[10px] font-bold px-1.5 py-0.2 rounded-md bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200/60" title="@teacher.BatchesDisplay">
                                                @(teacher.BatchCount == 1 ? "1 Batch" : $"{teacher.BatchCount} Batches")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                @if (isAssignedToCurrent)
                                {
                                    var assignedSubjectCount = _selectedBatchDetail?.Teachers.Count(t => t.IsActive && t.TeacherId == teacher.Id) ?? 0;
                                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 flex items-center gap-1 shadow-2xs">
                                        <svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>@(assignedSubjectCount > 1 ? $"{assignedSubjectCount} Subjects" : "In this Batch")</span>
                                    </span>
                                }
                                else
                                {
                                    <button type="button"
                                            @onclick="() => AssignTeacherDirectlyAsync(teacher.Id)"
                                            title="Click to assign to batch"
                                            class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/60 dark:hover:bg-emerald-900/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 transition-all cursor-pointer">
                                        + Assign
                                    </button>
                                }

                                <!-- Drag Handle dots (6 dots vertical) -->
                                <div class="text-slate-300 dark:text-slate-600 group-hover:text-slate-500 p-0.5 cursor-grab">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M9 5a2 2 0 11-4 0 2 2 0 014 0zM9 12a2 2 0 11-4 0 2 2 0 014 0zM9 19a2 2 0 11-4 0 2 2 0 014 0zM19 5a2 2 0 11-4 0 2 2 0 014 0zM19 12a2 2 0 11-4 0 2 2 0 014 0zM19 19a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- COLUMN 2: Batch Subjects Canvas (Middle Panel - 6 cols) -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-6 min-w-0 card-surface p-4 sm:p-5 border border-tealborder shadow-2xs flex flex-col gap-3.5">
            <!-- Header -->
            <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h2 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                        Batch Subjects & Faculty Mapping
                    </h2>
                </div>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/50">
                    @_displaySubjects.Count Subjects
                </span>
            </div>

            <!-- Instruction Alert matching Reference Mockup -->
            <div class="p-3 rounded-xl bg-blue-50/70 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/60 text-blue-700 dark:text-blue-300 text-xs flex items-center gap-2.5">
                <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Drag faculty members from the left panel and drop them on subject cards, or click "+ Assign". Faculty members can be assigned to multiple batches across the institute.</span>
            </div>

            <!-- Subjects List with Skeletons on Initial Load -->
            <div class="space-y-3 max-h-[580px] overflow-y-auto no-scrollbar pr-1 @(_isLoadingBatch && _displaySubjects.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")" style="scrollbar-width: none; -ms-overflow-style: none;">
                @if (_isLoadingBatch && !_displaySubjects.Any())
                {
                    <SkeletonSubjectCards Count="3" />
                }
                else if (_selectedBatchDetail == null)
                {
                    <div class="py-16 text-center text-slate-400">
                        <p class="text-xs font-semibold">Select a batch to begin assigning teachers.</p>
                    </div>
                }
                else if (!_displaySubjects.Any())
                {
                    <div class="py-16 text-center text-slate-400">
                        <p class="text-xs font-bold">No subjects configured for this batch.</p>
                        <p class="text-[10px] mt-1">Please add subjects under the Subjects Directory.</p>
                    </div>
                }
                else
                {
                    @foreach (var subj in _displaySubjects)
                    {
                        var isDraggingOver = _dragOverSubjectId == subj.Id;
                        var assignedForSubj = GetTeachersForSubject(subj);

                        <div ondragover="event.preventDefault();"
                             @ondragenter="() => _dragOverSubjectId = subj.Id"
                             @ondragleave="() => { if (_dragOverSubjectId == subj.Id) _dragOverSubjectId = null; }"
                             @ondrop="() => OnDropTeacherAsync(subj.Id)"
                             class="relative overflow-hidden p-3.5 sm:p-4 rounded-2xl border transition-all flex flex-col gap-3 shadow-2xs @(isDraggingOver ? "border-2 border-[#009488] bg-teal-50/50 dark:bg-teal-950/40 ring-4 ring-teal-500/15 scale-[1.005]" : "border-slate-200/70 dark:border-slate-800 bg-white dark:bg-[#142025] hover:border-slate-300 dark:hover:border-slate-700")">

                            <!-- Distinct Colored Vertical Accent Bar on the Left -->
                            <div class="w-1.5 absolute left-0 top-0 bottom-0 rounded-l-2xl @subj.AccentBg"></div>

                            <!-- Subject Header Row -->
                            <div class="flex items-center justify-between pl-2">
                                <div class="flex items-center gap-3 shrink-0">
                                    <div class="w-9 h-9 rounded-xl @subj.IconBg flex items-center justify-center shrink-0 shadow-2xs">
                                        @((MarkupString)subj.IconSvg)
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <h3 class="text-xs font-bold text-slate-900 dark:text-white">@subj.Name</h3>
                                            @if (subj.IsPrimary)
                                            {
                                                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/60">
                                                    Primary
                                                </span>
                                            }
                                        </div>
                                        <p class="text-[10px] text-slate-400 font-medium">@_selectedBatchDetail.Batch.ClassName • Code: @subj.Code</p>
                                    </div>
                                </div>

                                <div class="text-[11px] font-semibold text-slate-400">
                                    @(assignedForSubj.Count) Assigned
                                </div>
                            </div>

                            <!-- Assigned Teachers and Drop Area -->
                            <div class="flex flex-wrap items-center gap-2 pl-2 pt-1 border-t border-slate-100 dark:border-slate-800/60">
                                @foreach (var t in assignedForSubj)
                                {
                                    <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 shadow-2xs">
                                        <div class="w-6 h-6 rounded-lg bg-teal-500/10 text-[#009488] font-bold text-[10px] flex items-center justify-center shrink-0">
                                            @(string.IsNullOrWhiteSpace(t.TeacherName) ? "T" : t.TeacherName[0].ToString().ToUpper())
                                        </div>
                                        <span class="text-xs font-semibold text-slate-800 dark:text-slate-100">@t.TeacherName</span>
                                        <button type="button"
                                                @onclick="() => RemoveTeacherFromSubjectAsync(t.TeacherId, subj.Id)"
                                                title="Remove teacher from this subject"
                                                class="w-4 h-4 rounded-full text-slate-400 hover:text-rose-600 hover:bg-rose-100 dark:hover:bg-rose-950/60 flex items-center justify-center transition-colors cursor-pointer ml-0.5">
                                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                }

                                <!-- Drop Zone / Assign Placeholder -->
                                @if (assignedForSubj.Any())
                                {
                                    <div class="h-9 px-3.5 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 text-slate-400 hover:text-[#009488] hover:border-[#009488] hover:bg-teal-50/20 dark:hover:bg-teal-950/20 transition-all flex items-center gap-1.5 text-xs font-medium cursor-pointer"
                                         @onclick="() => PromptAssignModal(subj.Id)">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span>Drop another teacher here</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="h-10 px-5 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 text-slate-400 hover:text-[#009488] hover:border-[#009488] hover:bg-teal-50/20 dark:hover:bg-teal-950/20 transition-all flex items-center justify-center gap-1.5 text-xs font-medium cursor-pointer w-full"
                                         @onclick="() => PromptAssignModal(subj.Id)">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span>Drop teacher here</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- COLUMN 3: Batch Info, Assigned Teachers & Quick Actions (3 cols) -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-3 min-w-0 space-y-3.5">

            <!-- Card 1: Batch Information with Skeletons on Initial Load -->
            <div class="card-surface p-4 border border-tealborder shadow-2xs @(_isLoadingBatch && _selectedBatchDetail != null ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 mb-3">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
