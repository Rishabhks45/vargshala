        }

        // Default cycling colors matching design palette
        var palettes = new[]
        {
            ("bg-teal-50 text-[#009488] dark:bg-teal-950/60 dark:text-teal-300", "bg-[#009488]"),
            ("bg-purple-50 text-purple-600 dark:bg-purple-950/60 dark:text-purple-400", "bg-purple-500"),
            ("bg-sky-50 text-sky-600 dark:bg-sky-950/60 dark:text-sky-400", "bg-sky-500"),
            ("bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400", "bg-rose-500")
        };
        var selectedPalette = palettes[Math.Abs(index) % palettes.Length];
        return (
            selectedPalette.Item1,
            selectedPalette.Item2,
            "<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25'/></svg>"
        );
    }

    private string GetSubjectBadgeClass(string? subjectName)
    {
        var name = (subjectName ?? "").ToLowerInvariant();
        if (name.Contains("math") || name.Contains("calc") || name.Contains("algeb"))
            return "bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300 border border-blue-200/60";
        if (name.Contains("physic") || name.Contains("mechanic"))
            return "bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-300 border border-purple-200/60";
        if (name.Contains("chem") || name.Contains("organ"))
            return "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200/60";
        if (name.Contains("bio") || name.Contains("botan"))
            return "bg-pink-50 text-pink-700 dark:bg-pink-950/50 dark:text-pink-300 border border-pink-200/60";
        if (name.Contains("eng") || name.Contains("hind") || name.Contains("lang"))
            return "bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200/60";
        return "bg-teal-50 text-teal-700 dark:bg-teal-950/50 dark:text-teal-300 border border-teal-200/60";
    }

    private void BuildDisplaySubjects()
    {
        _displaySubjects.Clear();
        if (_selectedBatchDetail == null) return;

        int index = 0;
        var primarySubjId = _selectedBatchDetail.Batch.SubjectId;
        var primarySubjName = _selectedBatchDetail.Batch.SubjectName;

        var primarySubjObj = _allOrgSubjects.FirstOrDefault(s => s.Id == primarySubjId);
        var finalPrimaryName = primarySubjObj?.Name ?? (!string.IsNullOrWhiteSpace(primarySubjName) ? primarySubjName : "Primary Subject");

        var primaryStyle = GetSubjectStyling(finalPrimaryName, index++);
        _displaySubjects.Add(new SubjectDisplayModel
        {
            Id = primarySubjId,
            Name = finalPrimaryName,
            Code = primarySubjObj?.Code ?? _selectedBatchDetail.Batch.Code,
            IsPrimary = true,
            IconBg = primaryStyle.iconBg,
            AccentBg = primaryStyle.accentBg,
            IconSvg = primaryStyle.iconSvg
        });

        // Dynamic active subjects from database
        foreach (var subj in _allOrgSubjects.Where(s => s.Id != primarySubjId))
        {
            var style = GetSubjectStyling(subj.Name, index++);
            _displaySubjects.Add(new SubjectDisplayModel
            {
                Id = subj.Id,
                Name = subj.Name,
                Code = subj.Code,
                IsPrimary = false,
                IconBg = style.iconBg,
                AccentBg = style.accentBg,
                IconSvg = style.iconSvg
            });
        }
    }

    private List<BatchTeacherDto> GetTeachersForSubject(SubjectDisplayModel subj)
    {
        if (_selectedBatchDetail == null) return new();

        return _selectedBatchDetail.Teachers
            .Where(t => t.IsActive && (t.SubjectId == subj.Id || (t.SubjectId == Guid.Empty && subj.IsPrimary)))
            .ToList();
    }

    private IEnumerable<TeacherDto> FilteredAvailableTeachers
    {
        get
        {
            var list = _availableTeachers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_teacherSearchQuery))
            {
                var query = _teacherSearchQuery.Trim().ToLower();
                list = list.Where(t => t.FullName.ToLower().Contains(query)
                    || (t.Department != null && t.Department.ToLower().Contains(query))
                    || (t.Specialization != null && t.Specialization.ToLower().Contains(query))
                    || (t.EmployeeCode != null && t.EmployeeCode.ToLower().Contains(query)));
            }

            if (!string.IsNullOrWhiteSpace(_selectedSubjectFilter))
            {
                list = list.Where(t => string.Equals(t.Department, _selectedSubjectFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_selectedStatusFilter == "available")
            {
                list = list.Where(t => !_currentAssignedTeacherIds.Contains(t.Id));
            }
            else if (_selectedStatusFilter == "assigned")
            {
                list = list.Where(t => _currentAssignedTeacherIds.Contains(t.Id));
            }

            return list;
        }
    }

    private async Task OnBranchChanged(string value)
    {
        if (Guid.TryParse(value, out var branchId))
        {
            _selectedBranchId = branchId;
            await LoadBatchesForBranchAsync(branchId);
            if (_batches.Any())
            {
                _selectedBatchId = _batches[0].Id;
                await LoadBatchDetailAsync(_selectedBatchId);
            }
            else
            {
                _selectedBatchId = Guid.Empty;
                _selectedBatchDetail = null;
            }
            await LoadAvailableTeachersAsync();
        }
    }

    private async Task OnBatchChanged(string value)
    {
        if (Guid.TryParse(value, out var batchId))
        {
            _selectedBatchId = batchId;
            await LoadBatchDetailAsync(batchId);
        }
    }

    private void OnDragStart(TeacherDto teacher)
    {
        _draggedTeacher = teacher;
    }

    private async Task OnDropTeacherAsync(Guid subjectId)
    {
        _dragOverSubjectId = null;
        if (_draggedTeacher == null || _selectedBatchDetail == null) return;

        var teacherToAssign = _draggedTeacher;
        _draggedTeacher = null;

        await AssignTeacherDirectlyAsync(teacherToAssign.Id, subjectId);
    }

    private async Task AssignTeacherDirectlyAsync(Guid teacherId, Guid? subjectId = null)
    {
        if (_selectedBatchDetail == null)
        {
            Toast.Warning("Please select a batch first.");
            return;
        }

        try
        {
            var batchId = _selectedBatchDetail.Batch.Id;
            var targetSubjId = subjectId ?? _selectedBatchDetail.Batch.SubjectId;

            var res = await BatchService.AssignTeacherToBatchAsync(batchId, new AssignTeacherToBatchRequest
            {
                TeacherId = teacherId,
                SubjectId = targetSubjId
            });

            if (res.Success)
            {
                Toast.Success("Teacher assigned successfully.");
                await LoadBatchDetailAsync(batchId);
                await LoadAvailableTeachersAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to assign teacher.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error assigning teacher: " + ex.Message);
        }
    }

    private async Task RemoveTeacherFromSubjectAsync(Guid teacherId, Guid subjectId)
