                "bg-pink-500",
                "<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z'/></svg>"
            );
        }

        // 5. English / Language: Amber / Orange (Open Book Icon)
        if (name.Contains("eng") || name.Contains("hind") || name.Contains("sans") || name.Contains("lang") || name.Contains("liter"))
        {
            return (
                "bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-400",
                "bg-amber-500",
                "<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'/></svg>"
            );
        }

        // 6. Reasoning / Computer / Logic: Rose (Brain / Bulb Icon)
        if (name.Contains("reason") || name.Contains("aptitud") || name.Contains("logic") || name.Contains("comp") || name.Contains("it") || name.Contains("code"))
        {
            return (
                "bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400",
                "bg-rose-500",
                "<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'/></svg>"
