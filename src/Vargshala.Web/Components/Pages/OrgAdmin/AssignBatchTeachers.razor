                            <span class="text-slate-400 font-medium">Class</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedBatchDetail.Batch.ClassName</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-medium">Branch</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedBatchDetail.Batch.BranchName</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-medium">Total Students</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedBatchDetail.Batch.StudentCount</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-medium">Start Time</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">
