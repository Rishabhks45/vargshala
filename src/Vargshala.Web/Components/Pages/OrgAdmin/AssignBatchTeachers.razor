                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-400 font-medium">End Time</span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">
                                @(_selectedBatchDetail.Batch.EndTime.HasValue ? _selectedBatchDetail.Batch.EndTime.Value.ToString("hh:mm tt") : "—")
                            </span>
                        </div>
                        <div class="flex items-center justify-between pt-1.5 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-slate-400 font-medium">Status</span>
