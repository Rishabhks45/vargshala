                    </div>
                }
            </div>

            <!-- Card 2: Assigned Teachers List matching Reference Mockup -->
            <div class="card-surface p-4 border border-tealborder shadow-2xs @(_isLoadingBatch && _selectedBatchDetail != null ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 mb-2">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                        <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                            Assigned Teachers (@DistinctAssignedTeacherCount)
                        </h3>
                    </div>
                </div>

                @if (_isLoadingBatch && _selectedBatchDetail == null)
                {
                    <div class="space-y-2 py-1">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="flex items-center justify-between py-1.5">
                                <div class="flex items-center gap-2">
                                    <Skeleton Width="28px" Height="28px" Shape="Skeleton.SkeletonShape.Rounded" />
                                    <Skeleton Width="100px" Height="12px" />
                                </div>
                                <Skeleton Width="55px" Height="18px" Shape="Skeleton.SkeletonShape.Pill" />
                            </div>
                        }
                    </div>
                }
                else if (_selectedBatchDetail == null || !_selectedBatchDetail.Teachers.Any(t => t.IsActive))
                {
                    <p class="text-xs text-slate-400 text-center py-5">No teachers assigned yet.</p>
                }
                else
                {
                    <div class="space-y-1.5 max-h-56 overflow-y-auto no-scrollbar pr-1" style="scrollbar-width: none; -ms-overflow-style: none;">
                        @foreach (var group in _selectedBatchDetail.Teachers.Where(t => t.IsActive).GroupBy(t => t.TeacherId))
                        {
                            var teacherFirst = group.First();
                            <div class="flex items-center justify-between py-1.5 px-1 border-b border-slate-50 dark:border-slate-800/60 last:border-0">
                                <div class="flex items-center gap-2 min-w-0">
                                    <div class="w-6 h-6 rounded-lg bg-teal-500/10 text-[#009488] font-bold text-[10px] flex items-center justify-center shrink-0">
                                        @(string.IsNullOrWhiteSpace(teacherFirst.TeacherName) ? "T" : teacherFirst.TeacherName[0].ToString().ToUpper())
                                    </div>
                                    <span class="text-xs font-bold text-slate-800 dark:text-white truncate">@teacherFirst.TeacherName</span>
                                </div>

                                <div class="flex items-center gap-1.5 shrink-0 flex-wrap justify-end">
                                    @foreach (var item in group)
                                    {
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md @GetSubjectBadgeClass(item.SubjectName)">
                                            @item.SubjectName
                                        </span>
                                    }
                                    <button type="button"
                                            @onclick="() => RemoveTeacherAllAsync(teacherFirst.TeacherId)"
                                            title="Remove teacher from batch"
                                            class="p-1 rounded-lg text-rose-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors cursor-pointer">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Card 3: Quick Actions matching Reference Mockup -->
            <div class="card-surface p-4 border border-tealborder shadow-2xs space-y-2.5">
                <div class="flex items-center gap-2 pb-1 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">Quick Actions</h3>
                </div>

                <!-- Save Assignments Button -->
                <button type="button"
                        @onclick="SaveAssignmentsAsync"
                        class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.01] active:scale-[0.99]">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Save Assignments</span>
                </button>

                <!-- Clear All Button -->
                <button type="button"
                        @onclick="ClearAllAssignmentsAsync"
                        class="w-full py-2 px-4 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-[#18262c] hover:bg-slate-50 dark:hover:bg-[#1f3037] border border-slate-200 dark:border-slate-700 transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    <span>Clear All</span>
                </button>

                <!-- Auto Assign (AI) Button -->
                <button type="button"
                        @onclick="AutoAssignAsync"
                        class="w-full py-2 px-4 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-[#18262c] hover:bg-slate-50 dark:hover:bg-[#1f3037] border border-slate-200 dark:border-slate-700 transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                    <span>Auto Assign (AI)</span>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid? BatchId { get; set; }

    private Guid _selectedBranchId = Guid.Empty;
    private Guid _selectedBatchId = Guid.Empty;
    private string _selectedSession = "2026-27";

    private List<BranchDto> _branches = new();
    private List<BatchDto> _batches = new();
    private List<TeacherDto> _availableTeachers = new();
    private BatchDetailDto? _selectedBatchDetail;
    private HashSet<Guid> _currentAssignedTeacherIds = new();
    private int DistinctAssignedTeacherCount =>
        _selectedBatchDetail?.Teachers.Where(t => t.IsActive).Select(t => t.TeacherId).Distinct().Count() ?? 0;

    private List<CustomSelect.CustomSelectOption> _branchOptions = new();
    private List<CustomSelect.CustomSelectOption> _batchOptions = new();
    private List<CustomSelect.CustomSelectOption> _sessionOptions = new()
    {
        new("2026-27", "2026-27"),
        new("2025-26", "2025-26"),
        new("2027-28", "2027-28")
    };

    private string _teacherSearchQuery = string.Empty;
    private string _selectedSubjectFilter = "";
    private string _selectedStatusFilter = "";
    private List<CustomSelect.CustomSelectOption> _subjectFilterOptions = new() { new("", "All Subjects") };
    private readonly List<CustomSelect.CustomSelectOption> _teacherStatusOptions = new()
    {
        new("", "All Faculty"),
        new("available", "Not in this Batch"),
        new("assigned", "In this Batch")
    };

    private bool _isLoadingTeachers = false;
    private bool _isLoadingBatch = false;
    private TeacherDto? _draggedTeacher = null;
    private Guid? _dragOverSubjectId = null;
    private List<SubjectDto> _allOrgSubjects = new();

    private class SubjectDisplayModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public bool IsPrimary { get; set; }
        public string IconSvg { get; set; } = string.Empty;
        public string IconBg { get; set; } = string.Empty;
        public string AccentBg { get; set; } = string.Empty;
    }

    private List<SubjectDisplayModel> _displaySubjects = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (BatchId.HasValue && BatchId.Value != Guid.Empty && BatchId.Value != _selectedBatchId)
        {
            _selectedBatchId = BatchId.Value;
            await LoadBatchDetailAsync(_selectedBatchId);
        }
    }

    private async Task LoadInitialDataAsync()
    {
        _isLoadingBatch = true;
        _isLoadingTeachers = true;
        try
        {
            var branchRes = await BranchService.GetAllActiveBranchesAsync();
            if (branchRes.Success && branchRes.Data != null)
            {
                _branches = branchRes.Data;
                _branchOptions = _branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)).ToList();
            }

            var subjRes = await SubjectService.GetAllActiveSubjectsAsync();
            if (subjRes.Success && subjRes.Data != null)
            {
                _allOrgSubjects = subjRes.Data;
            }

            if (_selectedBranchId == Guid.Empty && _branches.Any())
            {
                _selectedBranchId = _branches[0].Id;
            }

            await LoadBatchesForBranchAsync(_selectedBranchId);

            if (BatchId.HasValue && BatchId.Value != Guid.Empty)
            {
                _selectedBatchId = BatchId.Value;
            }
            else if (_batches.Any())
            {
                _selectedBatchId = _batches[0].Id;
            }

            if (_selectedBatchId != Guid.Empty)
            {
                await LoadBatchDetailAsync(_selectedBatchId);
            }

            await LoadAvailableTeachersAsync();
        }
        catch (Exception ex)
        {
            Toast.Error("Error loading initialization data: " + ex.Message);
        }
        finally
        {
            _isLoadingBatch = false;
        }
    }

    private async Task LoadBatchesForBranchAsync(Guid branchId)
    {
        try
        {
            var res = await BatchService.GetBatchesPagedAsync(
                new PagedRequest { PageSize = 100 },
                branchId: branchId != Guid.Empty ? branchId : null,
                isActive: true);

            if (res.Success && res.Data != null)
            {
                _batches = res.Data.Items;
                _batchOptions = _batches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), $"{b.Name} ({b.Grade})")).ToList();
            }
            else
            {
                _batches = new();
                _batchOptions = new();
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error fetching batches: " + ex.Message);
        }
    }

    private async Task LoadAvailableTeachersAsync()
    {
        _isLoadingTeachers = true;
        try
        {
            var res = await TeacherService.GetTeachersPagedAsync(
                new PagedRequest { PageSize = 200 },
                isActive: true,
                branchId: _selectedBranchId != Guid.Empty ? _selectedBranchId : null);

            if (res.Success && res.Data != null)
            {
                _availableTeachers = res.Data.Items.Where(t => t.IsActive).ToList();

                _subjectFilterOptions = new() { new("", "All Subjects") };
                if (_allOrgSubjects.Any())
                {
                    _subjectFilterOptions.AddRange(_allOrgSubjects.Select(s => new CustomSelect.CustomSelectOption(s.Name, s.Name)));
                }
                else
                {
                    var subjects = _availableTeachers
                        .Select(t => t.Department)
                        .Where(d => !string.IsNullOrWhiteSpace(d))
                        .Distinct()
                        .OrderBy(d => d)
                        .ToList();
                    _subjectFilterOptions.AddRange(subjects.Select(s => new CustomSelect.CustomSelectOption(s!, s!)));
                }
            }
            else
            {
                _availableTeachers = new();
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error loading teachers: " + ex.Message);
        }
        finally
        {
            _isLoadingTeachers = false;
        }
    }

    private async Task LoadBatchDetailAsync(Guid batchId)
    {
        _isLoadingBatch = true;
        try
        {
            var res = await BatchService.GetBatchByIdAsync(batchId);
            if (res.Success && res.Data != null)
            {
                _selectedBatchDetail = res.Data;

                if (_selectedBatchDetail.Batch.BranchId != Guid.Empty && _selectedBatchDetail.Batch.BranchId != _selectedBranchId)
                {
                    _selectedBranchId = _selectedBatchDetail.Batch.BranchId;
                    await LoadAvailableTeachersAsync();
                }

                _currentAssignedTeacherIds = _selectedBatchDetail.Teachers
                    .Where(t => t.IsActive)
                    .Select(t => t.TeacherId)
                    .ToHashSet();

                BuildDisplaySubjects();
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error loading batch details: " + ex.Message);
        }
        finally
        {
            _isLoadingBatch = false;
        }
    }

    private (string iconBg, string accentBg, string iconSvg) GetSubjectStyling(string subjectName, int index)
