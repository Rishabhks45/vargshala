@page "/fee-structures"
@page "/orgadmin/fee-structures"
@attribute [Authorize(Roles = "OrganizationAdmin,SuperAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.FeeStructures
@using Vargshala.Contracts.Branches
@using Vargshala.Contracts.Classes
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Services
@inject IFeeStructureService FeeStructureService
@inject IBranchService BranchService
@inject IClassService ClassService
@inject INotificationService Toast
@inject IBranchContextService BranchContext
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Fee Structures | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Fee Structures
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Configure fee packages, branch & class allocations, academic sessions, and total fees.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Add Fee Structure</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Directly rendered without layout shift) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Total Structures -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Templates</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_items.Count(x => x.Status == EntityStatus.Active) Active • @_items.Count(x => x.Status == EntityStatus.Inactive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Active Structures -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Templates</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@_items.Count(x => x.Status == EntityStatus.Active)</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Available for Students</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Average Fee Amount -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Average Fee</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">
                        @(_items.Any() ? "₹" + _items.Average(x => x.TotalAmount).ToString("N0") : "₹0")
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Across All Packages</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Linked Classes -->
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Linked Classes</p>
                    <h3 class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">
                        @_items.Count(x => x.ClassId.HasValue)
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Grade-specific plans</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        
        <!-- Search Input with Debounce -->
        <div class="relative w-full md:w-72 lg:w-80 shrink-0">
            <input type="text" 
                   @bind="_searchQuery" 
                   @bind:event="oninput"
                   @onkeyup="HandleSearchKeyUp"
                   placeholder="Search fee structure or session..." 
                   class="w-full pl-9 pr-8 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-800 dark:text-white transition-all shadow-xs" />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <button type="button" @onclick="ClearSearch" class="absolute right-2.5 top-2.5 text-slate-400 hover:text-slate-600 cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <!-- Filter Dropdowns & View Mode Controls -->
        <div class="flex items-center gap-2 w-full md:w-auto flex-wrap md:flex-nowrap justify-end">
            <!-- Branch Filter -->
            <div class="w-36">
                <CustomSelect Value="@(_selectedBranchId?.ToString() ?? "")"
                              ValueChanged="HandleBranchChanged"
                              Options="_branchFilterOptions"
                              Placeholder="All Branches" />
            </div>

            <!-- Class Filter -->
            <div class="w-36">
                <CustomSelect Value="@(_selectedClassId?.ToString() ?? "")"
                              ValueChanged="HandleClassChanged"
                              Options="_classFilterOptions"
                              Placeholder="All Classes" />
            </div>

            <!-- Academic Session Filter -->
            <div class="w-32">
                <CustomSelect Value="@_selectedSession"
                              ValueChanged="HandleSessionChanged"
                              Options="_sessionFilterOptions"
                              Placeholder="All Sessions" />
            </div>

            <!-- Status Filter -->
            <div class="w-32">
                <CustomSelect Value="@(_statusFilter == EntityStatus.All ? "" : _statusFilter.ToString())"
                              ValueChanged="HandleStatusChanged"
                              Options="_statusFilterOptions"
                              Placeholder="All Statuses" />
            </div>

            <!-- View Mode Toggle -->
            <div class="inline-flex rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] p-0.5 shadow-2xs shrink-0">
                <button type="button" @onclick='() => _viewMode = "table"'
                        class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all @(_viewMode == "table" ? "bg-[#009488] text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <button type="button" @onclick='() => _viewMode = "grid"'
                        class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all @(_viewMode == "grid" ? "bg-[#009488] text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-700")">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Container: Table View or Grid View -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        @if (_viewMode == "table")
        {
            <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
                <table class="w-full min-w-[860px] text-left border-collapse table-fixed">
                    <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                        <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                            <th class="w-[28%] py-2.5 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Fee Structure</span>
                                    <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                                </div>
                            </th>
                            <th class="w-[22%] py-2.5 px-3">
                                <span>Branch & Class</span>
                            </th>
                            <th class="w-[15%] py-2.5 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Session")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Session</span>
                                    <span class="@_sortState.GetIndicatorClass("Session")">@_sortState.GetIndicator("Session")</span>
                                </div>
                            </th>
                            <th class="w-[15%] py-2.5 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Amount")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Total Amount</span>
                                    <span class="@_sortState.GetIndicatorClass("Amount")">@_sortState.GetIndicator("Amount")</span>
                                </div>
                            </th>
                            <th class="w-[10%] py-2.5 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                                <div class="flex items-center justify-center gap-1.5">
                                    <span>Status</span>
                                    <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                                </div>
                            </th>
                            <th class="w-[10%] py-2.5 px-5 text-right select-none">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _items.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                        @if (_isLoading && !_items.Any())
                        {
                            <TableSkeletonRows Columns="6" Rows="8" />
                        }
                        else if (_items.Any())
                        {
                            @foreach (var item in _items)
                            {
                                <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors">
                                    <!-- Structure Name & Description -->
                                    <td class="py-2.5 px-5">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-xl bg-teal-500/10 text-[#009488] font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                                @GetInitials(item.Name)
                                            </div>
                                            <div class="min-w-0">
                                                <div class="font-bold text-slate-800 dark:text-white leading-tight truncate cursor-pointer hover:text-[#009488]"
                                                     @onclick="() => OpenViewModal(item)">
                                                    @item.Name
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <div class="text-[10px] text-slate-400 truncate max-w-xs mt-0.5">
                                                        @item.Description
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Branch & Class -->
                                    <td class="py-2.5 px-3">
                                        <div class="flex flex-wrap items-center gap-1">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                                @(string.IsNullOrWhiteSpace(item.BranchName) ? "Default Branch" : item.BranchName)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.ClassName))
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/60 dark:border-teal-800/60">
                                                    @item.ClassName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-slate-400 italic">All Classes</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Academic Session -->
                                    <td class="py-2.5 px-3 font-semibold text-slate-700 dark:text-slate-300">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
                                            @item.AcademicSession
                                        </span>
                                    </td>

                                    <!-- Total Amount -->
                                    <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white text-sm">
                                        ₹@item.TotalAmount.ToString("N2")
                                    </td>

                                    <!-- Status -->
                                    <td class="py-2.5 px-3 text-center">
                                        <button type="button" 
                                                @onclick="() => ToggleStatusAsync(item)"
                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border transition-colors cursor-pointer @(item.Status == EntityStatus.Active ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800" : "bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200 dark:border-slate-700")">
                                            @item.Status.GetDisplayName()
                                        </button>
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-2.5 px-5 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <button type="button" 
                                                    @onclick="() => OpenEditDrawerAsync(item)"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/40 transition-colors cursor-pointer"
                                                    title="Edit Structure">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            </button>
                                            <button type="button" 
                                                    @onclick="() => ConfirmDelete(item)"
                                                    class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
                                                    title="Delete Structure">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400">
                                    <div class="max-w-xs mx-auto space-y-2">
                                        <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No fee structures found</p>
                                        <p class="text-xs text-slate-400">Try changing your search filters or create a new template.</p>
                                        <button type="button" @onclick="OpenAddDrawerAsync"
                                                class="mt-2 px-3 py-1.5 rounded-lg bg-gradient-to-r from-[#004D40] to-[#009488] text-white text-xs font-bold shadow-xs hover:scale-[1.02] transition-all cursor-pointer">
                                            Add First Fee Structure
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Grid View -->
            <div class="flex-1 overflow-auto p-4 scrollbar-hidden @(_isLoading && _items.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                @if (_isLoading && !_items.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="card-surface p-4 border border-tealborder rounded-2xl shadow-2xs animate-pulse space-y-3">
                                <div class="flex justify-between items-center">
                                    <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-28"></div>
                                    <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded-full w-14"></div>
                                </div>
                                <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-36"></div>
                                <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex justify-between">
                                    <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-20"></div>
                                    <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded w-16"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_items.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
                        @foreach (var item in _items)
                        {
                            <div class="card-surface p-4 border border-tealborder rounded-2xl shadow-2xs hover:border-[#009488]/40 transition-all flex flex-col justify-between group">
                                <div>
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/80 dark:border-teal-800 font-black text-sm flex items-center justify-center shrink-0">
                                                @GetInitials(item.Name)
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-slate-900 dark:text-white text-sm group-hover:text-[#009488] transition-colors">@item.Name</h4>
                                                <span class="inline-block font-mono text-[10px] font-bold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/50 px-1.5 py-0.5 rounded border border-blue-200/80 dark:border-blue-800">
                                                    @item.AcademicSession
                                                </span>
                                            </div>
                                        </div>
                                        <button type="button" @onclick="() => ToggleStatusAsync(item)"
                                                class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @(item.Status == EntityStatus.Active ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800" : "bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200")">
                                            @item.Status.GetDisplayName()
                                        </button>
                                    </div>

                                    <div class="mt-3.5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                                        <div class="flex items-center justify-between text-[11px]">
                                            <span class="text-slate-400">Branch:</span>
                                            <span class="font-semibold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(item.BranchName) ? "Default" : item.BranchName)</span>
                                        </div>
                                        <div class="flex items-center justify-between text-[11px]">
                                            <span class="text-slate-400">Class:</span>
                                            <span class="font-bold text-[#009488]">@(string.IsNullOrWhiteSpace(item.ClassName) ? "All Classes" : item.ClassName)</span>
                                        </div>
                                        <div class="flex items-center justify-between text-[11px] pt-1">
                                            <span class="text-slate-400 font-bold">Total Fee:</span>
                                            <span class="font-black text-slate-900 dark:text-white text-sm">₹@item.TotalAmount.ToString("N2")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 pt-1 border-t border-slate-100 dark:border-slate-800">
                                                @item.Description
                                            </p>
                                        }
                                    </div>
                                </div>

                                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
                                    <button type="button" @onclick="() => OpenViewModal(item)"
                                            class="text-xs font-bold text-[#009488] hover:underline cursor-pointer">
                                        View Details →
                                    </button>
                                    <div class="flex items-center gap-1">
                                        <button type="button" @onclick="() => OpenEditDrawerAsync(item)"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/40 transition-colors cursor-pointer"
                                                title="Edit Structure">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </button>
                                        <button type="button" @onclick="() => ConfirmDelete(item)"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
                                                title="Delete Structure">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex-1 flex flex-col items-center justify-center p-12 text-center">
                        <div class="w-16 h-16 rounded-2xl bg-teal-50 dark:bg-teal-950/50 text-[#009488] flex items-center justify-center mb-3">
                            <svg class="w-8 h-8 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-bold text-slate-800 dark:text-white">No Fee Structures Found</h3>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 max-w-sm">
                            No templates match your search filters or none have been created yet.
                        </p>
                        <button type="button" @onclick="OpenAddDrawerAsync"
                                class="mt-4 px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] text-white text-xs font-bold shadow-md shadow-[#004D40]/20 hover:scale-[1.02] transition-all cursor-pointer">
                            Add First Fee Structure
                        </button>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber"
                             PageSize="_query.PageSize"
                             TotalRecords="_totalRecords"
                             ItemLabel="fee structures"
                             IsLoading="_isLoading"
                             OnPageChanged="LoadDataAsync"
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- DRAWER: Add / Edit Fee Structure Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showAddEditDrawer)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Slide-Over Drawer Container -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-white/10 border border-teal-400/30 p-2 flex items-center justify-center shadow-md shrink-0">
                    <svg class="w-5 h-5 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight">
                        <span>@(_editingItem == null ? "Add Fee Structure" : "Edit Fee Structure")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingItem == null ? "Define a fee package and branch details" : $"Updating {_editingItem.Name}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Form Body -->
        <EditForm Model="@_formModel" OnValidSubmit="SaveFeeStructureAsync" class="flex-1 flex flex-col justify-between overflow-hidden">
            <DataAnnotationsValidator />

            <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-4 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                <!-- Branch Selection -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Branch *</label>
                    <CustomSelect Value="@(_formModel.BranchId == Guid.Empty ? "" : _formModel.BranchId.ToString())"
                                  ValueChanged="@((string v) => HandleDrawerBranchChanged(v))"
                                  Options="_drawerBranchOptions"
                                  Placeholder="Select Branch"
                                  Class="w-full" />
                    @if (_formModel.BranchId == Guid.Empty && _submitted)
                    {
                        <p class="text-[10px] text-rose-500 font-semibold">Please select a branch.</p>
                    }
                </div>

                <!-- Class Selection (Optional) -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Class / Grade (Optional)</label>
                    <CustomSelect Value="@(_formModel.ClassId.HasValue ? _formModel.ClassId.Value.ToString() : "")"
                                  ValueChanged="@((string v) => _formModel.ClassId = string.IsNullOrEmpty(v) ? null : Guid.Parse(v))"
                                  Options="_drawerClassOptions"
                                  Placeholder="All Classes in Branch (General)"
                                  Class="w-full" />
                    <p class="text-[10px] text-slate-400">Leave blank if this fee structure applies to all classes.</p>
                </div>

                <!-- Structure Name -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Fee Structure Name *</label>
                    <InputText @bind-Value="_formModel.Name" placeholder="e.g. Class 12th Full Academic Fee 2026-27" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    @if (string.IsNullOrWhiteSpace(_formModel.Name) && _submitted)
                    {
                        <p class="text-[10px] text-rose-500 font-semibold">Fee structure name is required.</p>
                    }
                </div>

                <!-- Academic Session & Total Fee -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Academic Session *</label>
                        <CustomSelect Value="@_formModel.AcademicSession"
                                      ValueChanged="@((string v) => _formModel.AcademicSession = v)"
                                      Options="_sessionOptions"
                                      Placeholder="Select Session"
                                      Class="w-full" />
                        @if (string.IsNullOrWhiteSpace(_formModel.AcademicSession) && _submitted)
                        {
                            <p class="text-[10px] text-rose-500 font-semibold">Academic session is required.</p>
                        }
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Total Amount (₹) *</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-xs font-bold text-slate-400">₹</span>
                            <InputNumber @bind-Value="_formModel.TotalAmount" placeholder="0.00" class="w-full pl-7 pr-3 py-2.5 text-xs font-bold bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        @if (_formModel.TotalAmount < 0 && _submitted)
                        {
                            <p class="text-[10px] text-rose-500 font-semibold">Amount cannot be negative.</p>
                        }
                    </div>
                </div>

                <!-- Description -->
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Description / Fee Breakdown Notes</label>
                    <InputTextArea @bind-Value="_formModel.Description" rows="3" placeholder="Includes tuition, exam fees, laboratory charges, and study material..." class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>

                <!-- Active Status Toggle -->
                <div class="pt-2">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" @bind="_formModel.IsActive" class="w-4 h-4 rounded text-[#009488] focus:ring-teal-500 border-slate-300 dark:border-slate-700" />
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Active (Ready for student fee assignments)</span>
                    </label>
                </div>

            </div>

            <!-- Drawer Footer Buttons -->
            <div class="p-4 bg-slate-50 dark:bg-[#111c21] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-2.5 shrink-0">
                <button type="button" 
                        @onclick="CloseDrawerAsync" 
                        disabled="@_isSaving"
                        class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-[#1f3037] rounded-xl transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="submit" 
                        disabled="@_isSaving"
                        class="px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] rounded-xl transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSaving)
                    {
                        <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                        </svg>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(_editingItem == null ? "Create Fee Structure" : "Update Fee Structure")</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: View Fee Structure Details Modal -->
<!-- ========================================================================= -->
@if (_viewingItem != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="card-surface max-w-lg w-full rounded-2xl shadow-2xl border border-tealborder overflow-hidden select-none animate-in fade-in zoom-in-95 duration-150">
            <div class="px-6 py-4 bg-[#004D40] text-white flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center">
                        <svg class="w-4 h-4 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-sm text-white">Fee Structure Details</h3>
                        <p class="text-[10px] text-teal-200">@_viewingItem.Name</p>
                    </div>
                </div>
                <button type="button" @onclick="() => _viewingItem = null" class="text-teal-200 hover:text-white cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <div class="p-6 space-y-3.5 select-text text-xs">
                <div class="grid grid-cols-2 gap-3">
                    <div class="p-3 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800">
                        <span class="text-[10px] text-slate-400 font-bold block uppercase">Total Amount</span>
                        <span class="text-base font-black text-slate-900 dark:text-white">₹@_viewingItem.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="p-3 bg-slate-50 dark:bg-[#18262c] rounded-xl border border-slate-100 dark:border-slate-800">
                        <span class="text-[10px] text-slate-400 font-bold block uppercase">Academic Session</span>
                        <span class="text-base font-black text-blue-600 dark:text-blue-400">@_viewingItem.AcademicSession</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="text-[10px] text-slate-400 font-semibold block">Branch</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@(_viewingItem.BranchName ?? "Default")</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 font-semibold block">Class / Grade</span>
                        <span class="font-bold text-[#009488]">@(!string.IsNullOrWhiteSpace(_viewingItem.ClassName) ? _viewingItem.ClassName : "All Classes (General)")</span>
                    </div>
                </div>

                <div>
                    <span class="text-[10px] text-slate-400 font-semibold block">Status</span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold mt-0.5 @(_viewingItem.Status == EntityStatus.Active ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300" : "bg-slate-100 text-slate-500")">
                        @_viewingItem.Status.GetDisplayName()
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_viewingItem.Description))
                {
                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                        <span class="text-[10px] text-slate-400 font-semibold block">Description / Notes</span>
                        <p class="text-slate-700 dark:text-slate-300 mt-1">@_viewingItem.Description</p>
                    </div>
                }

                <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex justify-between text-[10px] text-slate-400">
                    <span>Created: @_viewingItem.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                    @if (_viewingItem.UpdatedAt.HasValue)
                    {
                        <span>Updated: @_viewingItem.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                    }
                </div>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-[#18262c] border-t border-slate-100 dark:border-slate-800 flex justify-end gap-2">
                <button type="button" @onclick="() => _viewingItem = null" class="px-4 py-2 text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer">
                    Close
                </button>
                <button type="button" @onclick="async () => { var itm = _viewingItem; _viewingItem = null; await OpenEditDrawerAsync(itm); }" class="px-4 py-2 text-xs font-bold text-white bg-[#009488] rounded-xl cursor-pointer">
                    Edit Structure
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: Delete Confirmation Modal -->
<!-- ========================================================================= -->
@if (_deletingItem != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="card-surface max-w-sm w-full rounded-2xl shadow-2xl border border-rose-200 dark:border-rose-900/50 p-6 space-y-4 text-center animate-in fade-in zoom-in-95 duration-150">
            <div class="w-12 h-12 rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 mx-auto flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <div>
                <h3 class="font-extrabold text-slate-800 dark:text-white text-base">Delete Fee Structure?</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    Are you sure you want to delete <strong class="text-slate-800 dark:text-slate-200">@_deletingItem.Name</strong>? This cannot be undone.
                </p>
            </div>
            <div class="flex items-center justify-center gap-2 pt-2">
                <button type="button" @onclick="() => _deletingItem = null" class="px-4 py-2 text-xs font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-xl hover:bg-slate-200 cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="DeleteFeeStructureAsync" class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl cursor-pointer">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<FeeStructureDto> _items = new();
    private int _totalRecords = 0;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _submitted = false;

    // View Mode: 'table' or 'grid'
    private string _viewMode = "table";

    // Filtering State
    private string _searchQuery = string.Empty;
    private Guid? _selectedBranchId;
    private Guid? _selectedClassId;
    private string _selectedSession = string.Empty;
    private EntityStatus _statusFilter = EntityStatus.All;
    private bool? _selectedStatus => _statusFilter.ToNullableBool();

    // Dropdown Select Options
    private List<CustomSelect.CustomSelectOption> _branchFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _classFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _sessionFilterOptions = new();
    private List<CustomSelect.CustomSelectOption> _statusFilterOptions = new();

    private List<CustomSelect.CustomSelectOption> _drawerBranchOptions = new();
    private List<CustomSelect.CustomSelectOption> _drawerClassOptions = new();
    private List<CustomSelect.CustomSelectOption> _sessionOptions = new();

    // Raw lookup cache
    private List<BranchDto> _branches = new();
    private List<ClassLookupDto> _allClasses = new();

    // Query & Sort
    private PagedRequest _query = new() { PageNumber = 1, PageSize = 10, SortBy = "CreatedAt", SortDirection = "desc" };
    private TableSortState _sortState = new();

    // Drawer / Modals State
    private bool _showAddEditDrawer = false;
    private bool _isDrawerOpen = false;
    private FeeStructureDto? _editingItem = null;
    private FeeStructureDto? _viewingItem = null;
    private FeeStructureDto? _deletingItem = null;

    // Form Model
    private FeeStructureFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeFilterOptions();
        await LoadLookupsAsync();
        await LoadDataAsync(1);
    }

    private void InitializeFilterOptions()
    {
        _statusFilterOptions = new List<CustomSelect.CustomSelectOption>
        {
            new("", EntityStatus.All.GetDisplayName()),
            new(EntityStatus.Active.ToString(), EntityStatus.Active.GetDisplayName()),
            new(EntityStatus.Inactive.ToString(), EntityStatus.Inactive.GetDisplayName())
        };

        var currentYear = DateTime.UtcNow.Year;
        _sessionOptions = new List<CustomSelect.CustomSelectOption>
        {
            new($"{currentYear - 1}-{currentYear}", $"{currentYear - 1}-{currentYear}"),
            new($"{currentYear}-{currentYear + 1}", $"{currentYear}-{currentYear + 1}"),
            new($"{currentYear + 1}-{currentYear + 2}", $"{currentYear + 1}-{currentYear + 2}")
        };

        _sessionFilterOptions = new List<CustomSelect.CustomSelectOption> { new("", "All Sessions") };
        _sessionFilterOptions.AddRange(_sessionOptions);
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            // Load Branches
            var branchRes = await BranchService.GetBranchesPagedAsync(new PagedRequest { PageNumber = 1, PageSize = 100 });
            if (branchRes.Success && branchRes.Data?.Items != null)
            {
                _branches = branchRes.Data.Items;
                _branchFilterOptions = new List<CustomSelect.CustomSelectOption> { new("", "All Branches") };
                _branchFilterOptions.AddRange(_branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)));

                _drawerBranchOptions = _branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)).ToList();
            }

            // Load Classes
            var classRes = await ClassService.GetAllActiveClassesAsync();
            if (classRes.Success && classRes.Data != null)
            {
                _allClasses = classRes.Data;
                UpdateClassFilterOptions();
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Failed to load filter options: " + ex.Message);
        }
    }

    private void UpdateClassFilterOptions()
    {
        var filtered = _selectedBranchId.HasValue && _selectedBranchId.Value != Guid.Empty
            ? _allClasses.Where(c => c.BranchId == _selectedBranchId.Value)
            : _allClasses;

        _classFilterOptions = new List<CustomSelect.CustomSelectOption> { new("", "All Classes") };
        _classFilterOptions.AddRange(filtered.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)));
    }

    private void UpdateDrawerClassOptions(Guid branchId)
    {
        var classesInBranch = _allClasses.Where(c => c.BranchId == branchId).ToList();
        _drawerClassOptions = new List<CustomSelect.CustomSelectOption> { new("", "All Classes in Branch (General)") };
        _drawerClassOptions.AddRange(classesInBranch.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)));
    }

    private async Task LoadDataAsync(int pageNumber)
    {
        _isLoading = true;
        _query.PageNumber = pageNumber;
        _query.SortBy = _sortState.Column ?? "CreatedAt";
        _query.SortDirection = _sortState.Direction == SortDirection.Ascending ? "asc" : "desc";
        _query.Search = _searchQuery;

        try
        {
            var res = await FeeStructureService.GetFeeStructuresPagedAsync(
                _query,
                _selectedBranchId,
                _selectedClassId,
                _selectedSession,
                _selectedStatus);

            if (res.Success && res.Data != null)
            {
                _items = res.Data.Items;
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _items = new();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error loading fee structures: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadDataAsync(1);
    }

    private async Task HandlePageSizeChangedAsync(int newSize)
    {
        _query.PageSize = newSize;
        await LoadDataAsync(1);
    }

    private async Task HandleBranchChanged(string val)
    {
        _selectedBranchId = string.IsNullOrEmpty(val) ? null : Guid.Parse(val);
        UpdateClassFilterOptions();
        await LoadDataAsync(1);
    }

    private async Task HandleClassChanged(string val)
    {
        _selectedClassId = string.IsNullOrEmpty(val) ? null : Guid.Parse(val);
        await LoadDataAsync(1);
    }

    private async Task HandleSessionChanged(string val)
    {
        _selectedSession = val;
        await LoadDataAsync(1);
    }

    private async Task HandleStatusChanged(string val)
    {
        if (Enum.TryParse<EntityStatus>(val, true, out var status))
        {
            _statusFilter = status;
        }
        else
        {
            _statusFilter = EntityStatus.All;
        }
        await LoadDataAsync(1);
    }

    private System.Threading.Timer? _debounceTimer;
    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await LoadDataAsync(1));
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadDataAsync(1);
    }

    // Drawer handling
    private async Task OpenAddDrawerAsync()
    {
        _editingItem = null;
        _submitted = false;

        var defaultBranch = _branches.FirstOrDefault()?.Id ?? Guid.Empty;
        var currentYear = DateTime.UtcNow.Year;

        _formModel = new FeeStructureFormModel
        {
            BranchId = defaultBranch,
            AcademicSession = $"{currentYear}-{currentYear + 1}",
            IsActive = true,
            TotalAmount = 0
        };

        UpdateDrawerClassOptions(defaultBranch);

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(FeeStructureDto item)
    {
        _editingItem = item;
        _submitted = false;

        _formModel = new FeeStructureFormModel
        {
            Id = item.Id,
            BranchId = item.BranchId,
            ClassId = item.ClassId,
            Name = item.Name,
            Description = item.Description,
            TotalAmount = item.TotalAmount,
            AcademicSession = item.AcademicSession,
            IsActive = item.Status == EntityStatus.Active
        };

        UpdateDrawerClassOptions(item.BranchId);

        _showAddEditDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private void HandleDrawerBranchChanged(string val)
    {
        if (Guid.TryParse(val, out var bid))
        {
            _formModel.BranchId = bid;
            _formModel.ClassId = null;
            UpdateDrawerClassOptions(bid);
        }
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(300);
        _showAddEditDrawer = false;
    }

    private async Task SaveFeeStructureAsync()
    {
        _submitted = true;

        if (_formModel.BranchId == Guid.Empty ||
            string.IsNullOrWhiteSpace(_formModel.Name) ||
            string.IsNullOrWhiteSpace(_formModel.AcademicSession) ||
            _formModel.TotalAmount < 0)
        {
            return;
        }

        _isSaving = true;

        try
        {
            if (_editingItem == null)
            {
                var req = new CreateFeeStructureRequest
                {
                    BranchId = _formModel.BranchId,
                    ClassId = _formModel.ClassId,
                    Name = _formModel.Name.Trim(),
                    Description = _formModel.Description?.Trim(),
                    TotalAmount = _formModel.TotalAmount,
                    AcademicSession = _formModel.AcademicSession.Trim()
                };

                var res = await FeeStructureService.CreateFeeStructureAsync(req);
                if (res.Success)
                {
                    Toast.Success("Fee structure created successfully.");
                    await CloseDrawerAsync();
                    await LoadDataAsync(1);
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to create fee structure.");
                }
            }
            else
            {
                var req = new UpdateFeeStructureRequest
                {
                    Id = _formModel.Id,
                    BranchId = _formModel.BranchId,
                    ClassId = _formModel.ClassId,
                    Name = _formModel.Name.Trim(),
                    Description = _formModel.Description?.Trim(),
                    TotalAmount = _formModel.TotalAmount,
                    AcademicSession = _formModel.AcademicSession.Trim(),
                    IsActive = _formModel.IsActive
                };

                var res = await FeeStructureService.UpdateFeeStructureAsync(req);
                if (res.Success)
                {
                    Toast.Success("Fee structure updated successfully.");
                    await CloseDrawerAsync();
                    await LoadDataAsync(_query.PageNumber);
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to update fee structure.");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleStatusAsync(FeeStructureDto item)
    {
        try
        {
            var res = await FeeStructureService.ToggleFeeStructureStatusAsync(item.Id);
            if (res.Success)
            {
                item.Status = item.Status == EntityStatus.Active ? EntityStatus.Inactive : EntityStatus.Active;
                Toast.Success(res.Message ?? "Status updated.");
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to toggle status.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
    }

    private void OpenViewModal(FeeStructureDto item)
    {
        _viewingItem = item;
    }

    private void ConfirmDelete(FeeStructureDto item)
    {
        _deletingItem = item;
    }

    private async Task DeleteFeeStructureAsync()
    {
        if (_deletingItem == null) return;

        try
        {
            var res = await FeeStructureService.DeleteFeeStructureAsync(_deletingItem.Id);
            if (res.Success)
            {
                Toast.Success("Fee structure deleted successfully.");
                _deletingItem = null;
                await LoadDataAsync(1);
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to delete fee structure.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
    }

    private async Task ExportCsv()
    {
        if (!_items.Any())
        {
            Toast.Warning("No records to export.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Id,Name,Branch,Class,AcademicSession,TotalAmount,Status,CreatedAt");

        foreach (var itm in _items)
        {
            sb.AppendLine($"\"{itm.Id}\",\"{Escape(itm.Name)}\",\"{Escape(itm.BranchName)}\",\"{Escape(itm.ClassName ?? "All Classes")}\",\"{Escape(itm.AcademicSession)}\",{itm.TotalAmount},{itm.Status.GetDisplayName()},\"{itm.CreatedAt:yyyy-MM-dd HH:mm:ss}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "fee_structures_export.csv", "text/csv", base64);
        Toast.Success("CSV exported successfully.");
    }

    private string Escape(string val) => val.Replace("\"", "\"\"");

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "FS";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }

    public class FeeStructureFormModel
    {
        public Guid Id { get; set; }
        public Guid BranchId { get; set; }
        public Guid? ClassId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal TotalAmount { get; set; }
        public string AcademicSession { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
