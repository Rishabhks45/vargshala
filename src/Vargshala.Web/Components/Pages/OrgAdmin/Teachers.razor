    private async Task LoadTeachersAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = page;

        try
        {
            bool? isActive = null;
            if (_selectedStatus == "Active") isActive = true;
            else if (_selectedStatus == "Inactive") isActive = false;

            var pagedRequest = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim(),
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : (_sortState.Direction == SortDirection.Ascending ? "asc" : null)
            };

            var response = await TeacherService.GetTeachersPagedAsync(
                pagedRequest,
                department: string.IsNullOrWhiteSpace(_selectedSubject) ? null : _selectedSubject,
                designation: string.IsNullOrWhiteSpace(_selectedDesignation) ? null : _selectedDesignation,
                isActive: isActive);

            if (response != null && response.Success && response.Data != null)
            {
                _teachers = response.Data.Items.ToList();
                _totalRecords = response.Data.TotalRecords;
            }
            else
            {
                _teachers = new();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load teachers: {ex.Message}");
            _teachers = new();
            _totalRecords = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

