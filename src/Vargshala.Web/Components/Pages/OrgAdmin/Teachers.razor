@page "/teachers"
@attribute [Authorize(Roles = "OrganizationAdmin")]
@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Teachers
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Web.Components.UI.Pagination
@using Vargshala.Web.Services
@inject ITeacherService TeacherService
@inject INotificationService Toast
@rendermode InteractiveServer

<PageTitle>Teachers &amp; Staff | Vargshala</PageTitle>

<div class="flex-1 min-h-0 flex flex-col gap-3 transition-colors duration-200 h-full">
    
    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-md shrink-0">
                <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </span>
            <div>
                <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight leading-tight">
                    Teachers &amp; Faculty
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Manage teaching staff, subject assignments, batch mappings, and qualifications.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" 
                    @onclick="ExportCsv"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] hover:text-slate-900 dark:hover:text-white transition-all shadow-2xs cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <span>Export CSV</span>
            </button>

            <button type="button" 
                    @onclick="OpenAddDrawerAsync"
                    class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white text-xs font-bold transition-all shadow-md shadow-[#004D40]/20 flex items-center gap-2 cursor-pointer hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>Add Teacher</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards Summary (Matched with Users.razor) -->
    <div class="shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Total Teachers</p>
                    <h3 class="text-2xl font-black text-slate-800 dark:text-white mt-1">@_totalRecords</h3>
                    <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                        @_teachers.Count(t => t.IsActive) Active • @_teachers.Count(t => !t.IsActive) Inactive
                    </p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-[#009488] flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Active Faculty</p>
                    <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@_teachers.Count(t => t.IsActive)</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Assigned &amp; Teaching</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Departments</p>
                    <h3 class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1">
                        @_teachers.Select(t => t.Department ?? t.Subject).Where(s => !string.IsNullOrEmpty(s)).Distinct().Count()
                    </h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Active Academic Streams</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="card-surface p-4 border border-tealborder shadow-2xs relative overflow-hidden">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Loaded Records</p>
                    <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">@_teachers.Count</h3>
                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Current Page View</p>
                </div>
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls (Matched with Users.razor) -->
    <div class="shrink-0 card-surface p-3 border border-tealborder shadow-xs flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Reusable SearchInput Component with Debounce & Clear -->
        <div class="relative w-full md:w-80">
            <SearchInput @bind-Value="_searchQuery" 
                         OnSearch="() => LoadTeachersAsync(1)" 
                         Placeholder="Search teacher by name, subject, contact..." />
        </div>

        <!-- Filter Dropdowns with CustomSelect -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="w-44">
                <CustomSelect Value="@_selectedSubject" 
                              ValueChanged="HandleSubjectChanged" 
                              Options="_subjectFilterOptions" 
                              Placeholder="All Subjects" />
            </div>
            <div class="w-40">
                <CustomSelect Value="@_selectedDesignation" 
                              ValueChanged="HandleDesignationChanged" 
                              Options="_designationFilterOptions" 
                              Placeholder="All Designations" />
            </div>
            <div class="w-36">
                <CustomSelect Value="@_selectedStatus" 
                              ValueChanged="HandleStatusChanged" 
                              Options="_statusFilterOptions" 
                              Placeholder="All Status" />
            </div>
        </div>
    </div>

    <!-- Teachers Data Table (Fits screen height, internal scrolling with hidden scrollbar) -->
    <div class="flex-1 min-h-0 card-surface border border-tealborder shadow-xs flex flex-col overflow-hidden">
        <div class="flex-1 min-h-0 overflow-auto scrollbar-hidden">
            <table class="w-full min-w-[860px] text-left border-collapse table-fixed">
                <thead class="sticky top-0 z-10 bg-white dark:bg-[#111c21] border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs">
                    <tr class="text-[11px] font-bold text-slate-500 dark:text-slate-400 tracking-wider select-none uppercase bg-white dark:bg-[#111c21]">
                        <th class="w-[26%] py-2 px-5 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Name")'>
                            <div class="flex items-center gap-1.5">
                                <span>Teacher</span>
                                <span class="@_sortState.GetIndicatorClass("Name")">@_sortState.GetIndicator("Name")</span>
                            </div>
                        </th>
                        <th class="w-[18%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Subject")'>
                            <div class="flex items-center gap-1.5">
                                <span>Subject / Dept</span>
                                <span class="@_sortState.GetIndicatorClass("Subject")">@_sortState.GetIndicator("Subject")</span>
                            </div>
                        </th>
                        <th class="w-[16%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Designation")'>
                            <div class="flex items-center gap-1.5">
                                <span>Designation</span>
                                <span class="@_sortState.GetIndicatorClass("Designation")">@_sortState.GetIndicator("Designation")</span>
                            </div>
                        </th>
                        <th class="w-[16%] py-2 px-3 cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Mobile")'>
                            <div class="flex items-center gap-1.5">
                                <span>Contact</span>
                                <span class="@_sortState.GetIndicatorClass("Mobile")">@_sortState.GetIndicator("Mobile")</span>
                            </div>
                        </th>
                        <th class="w-[10%] py-2 px-3 text-center cursor-pointer hover:text-slate-800 dark:hover:text-slate-200 group" @onclick='() => HandleSortAsync("Status")'>
                            <div class="flex items-center justify-center gap-1.5">
                                <span>Status</span>
                                <span class="@_sortState.GetIndicatorClass("Status")">@_sortState.GetIndicator("Status")</span>
                            </div>
                        </th>
                        <th class="w-[14%] py-2 px-5 text-right select-none">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100/90 dark:divide-slate-800/60 text-xs @(_isLoading && _teachers.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_teachers.Any())
                    {
                        <TableSkeletonRows Columns="6" Rows="8" />
                    }
                    else if (_teachers.Any())
                    {
                        @foreach (var teacher in _teachers)
                        {
                            <tr class="hover:bg-teal-500/5 dark:hover:bg-teal-500/5 transition-colors">
                                
                                <!-- Teacher: Initials Avatar + Full Name + Employee ID -->
                                <td class="py-1.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-[#009488] font-black text-xs flex items-center justify-center shrink-0 shadow-inner">
                                            @teacher.Initials
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-800 dark:text-white leading-tight truncate cursor-pointer hover:text-[#009488]"
                                                 @onclick="() => OpenViewProfile(teacher)">
                                                @teacher.Name
                                            </div>
                                            <div class="text-[10px] text-slate-400 font-mono leading-none mt-0.5">
                                                @(!string.IsNullOrEmpty(teacher.EmployeeId) ? teacher.EmployeeId : "—")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Subject -->
                                <td class="py-1.5 px-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-blue-50 dark:bg-blue-950/70 border border-blue-200/80 dark:border-blue-800 text-blue-700 dark:text-blue-300">
                                        @(!string.IsNullOrEmpty(teacher.Subject) ? teacher.Subject : (!string.IsNullOrEmpty(teacher.Department) ? teacher.Department : "—"))
                                    </span>
                                </td>

                                <!-- Designation -->
                                <td class="py-1.5 px-3 font-semibold text-slate-700 dark:text-slate-300">
                                    @(!string.IsNullOrEmpty(teacher.Designation) ? teacher.Designation : "—")
                                </td>

                                <!-- Contact Details -->
                                <td class="py-1.5 px-3">
                                    <div class="font-semibold text-slate-800 dark:text-slate-200 leading-tight">
                                        @(!string.IsNullOrEmpty(teacher.Phone) ? teacher.Phone : "—")
                                    </div>
                                    <div class="text-[10px] text-slate-400 mt-0.5 leading-none truncate max-w-[140px]">
                                        @(!string.IsNullOrEmpty(teacher.Email) ? teacher.Email : "—")
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-1.5 px-3 text-center">
                                    @if (teacher.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Actions Column: Direct Action Buttons with Isolated Tooltips -->
                                <td class="py-1.5 px-5 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        
                                        <!-- Action 1: View Profile -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenViewProfile(teacher)" 
                                                    class="p-1.5 text-[#009488] dark:text-teal-400 hover:text-[#00796b] dark:hover:text-teal-300 hover:bg-teal-50 dark:hover:bg-teal-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="View Profile"
                                                    aria-label="View Profile">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-[#004D40] text-teal-100 border border-teal-500/50 shadow-lg tracking-wide">
                                                    View Profile
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-[#004D40] border-r border-b border-teal-500/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 2: Edit Teacher -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => OpenEditDrawerAsync(teacher)" 
                                                    class="p-1.5 text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="Edit Teacher"
                                                    aria-label="Edit Teacher">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-amber-600 text-white border border-amber-400/50 shadow-lg tracking-wide">
                                                    Edit Teacher
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-amber-600 border-r border-b border-amber-400/50"></span>
                                            </div>
                                        </div>

                                        <!-- Action 3: Toggle Status (Activate / Deactivate) -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => ToggleTeacherStatus(teacher)" 
                                                    class="p-1.5 @(teacher.IsActive 
                                                        ? "text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-950/40" 
                                                        : "text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="@(teacher.IsActive ? "Deactivate" : "Activate")"
                                                    aria-label="Toggle Status">
                                                @if (teacher.IsActive)
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                                    </svg>
                                                }
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded @(teacher.IsActive ? "bg-sky-700" : "bg-slate-700") text-white border border-white/20 shadow-lg tracking-wide">
                                                    @(teacher.IsActive ? "Deactivate" : "Activate")
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 @(teacher.IsActive ? "bg-sky-700" : "bg-slate-700") border-r border-b border-white/20"></span>
                                            </div>
                                        </div>

                                        <!-- Action 4: Delete Teacher -->
                                        <div class="relative group/act inline-flex items-center justify-center">
                                            <button type="button" 
                                                    @onclick="() => DeleteTeacherAsync(teacher.Id)" 
                                                    class="p-1.5 text-rose-600 dark:text-rose-400 hover:text-rose-700 dark:hover:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-all cursor-pointer inline-flex items-center justify-center"
                                                    title="Delete Teacher"
                                                    aria-label="Delete Teacher">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/act:flex flex-col items-center pointer-events-none z-30 whitespace-nowrap animate-in fade-in zoom-in-95 duration-150">
                                                <span class="px-2 py-0.5 text-[9px] font-extrabold rounded bg-rose-600 text-white border border-rose-400/50 shadow-lg tracking-wide">
                                                    Delete Teacher
                                                </span>
                                                <span class="w-1.5 h-1.5 rotate-45 -mt-0.5 bg-rose-600 border-r border-b border-rose-400/50"></span>
                                            </div>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <div class="max-w-xs mx-auto space-y-2">
                                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                                    </svg>
                                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No teachers found</p>
                                    <p class="text-xs text-slate-400">Try changing your search query or filter options.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Reusable Server-Side Table Pagination Component -->
        <div class="shrink-0 border-t border-slate-100 dark:border-slate-800/80">
            <TablePagination PageNumber="_query.PageNumber" 
                             PageSize="_query.PageSize" 
                             TotalRecords="_totalRecords" 
                             ItemLabel="teachers"
                             IsLoading="_isLoading"
                             OnPageChanged="LoadTeachersAsync"
                             OnPageSizeChanged="HandlePageSizeChangedAsync" />
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- DRAWER: Add / Edit Teacher Right Slide-Over Drawer -->
<!-- ========================================================================= -->
@if (_showDrawer)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 ease-in-out @(_isDrawerOpen ? "opacity-100" : "opacity-0")" 
         @onclick="CloseDrawerAsync"></div>

    <!-- Right Side-Over Drawer -->
    <div class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white dark:bg-[#111c21] shadow-2xl flex flex-col justify-between border-l border-teal-800/80 dark:border-slate-800 transform transition-transform duration-300 ease-in-out @(_isDrawerOpen ? "translate-x-0" : "translate-x-full") select-none overflow-hidden">
        
        <!-- Drawer Header with Deep Teal Gradient -->
        <div class="px-6 py-5 bg-[#004D40] text-white flex items-center justify-between shadow-md relative shrink-0">
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#009488]/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-3 relative z-10">
                <div class="w-10 h-10 rounded-2xl bg-amber-400 p-1 flex items-center justify-center shadow-md shrink-0">
                    <img src="images/plant-books.png" alt="Vargshala" class="w-full h-full object-contain" />
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-white tracking-tight leading-tight flex items-center gap-1.5">
                        <span>@(_editingTeacher == null ? "Register New Teacher" : "Edit Teacher Profile")</span>
                    </h3>
                    <p class="text-xs text-teal-200/90 font-medium">
                        @(_editingTeacher == null ? "Add a new teaching staff member with complete profile" : $"Updating records for {_editingTeacher.FullName}")
                    </p>
                </div>
            </div>

            <button type="button" 
                    @onclick="CloseDrawerAsync" 
                    class="relative z-10 p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                    title="Close Drawer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- EditForm with FluentValidation -->
        <EditForm Model="@_modalModel" OnValidSubmit="SaveTeacherAsync" class="flex-1 flex flex-col justify-between overflow-hidden">
            <FluentValidationValidator />

            <!-- Drawer Scrollable Form Body (No Scrollbar) -->
            <div class="flex-1 overflow-y-auto no-scrollbar p-6 space-y-6 select-text text-slate-800 dark:text-slate-100" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                <!-- Section 1: Personal Information -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>1. Personal &amp; Identity Information</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">First Name *</label>
                            <InputText @bind-Value="_modalModel.FirstName" placeholder="e.g. Priya" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.FirstName)" class="text-[10px] text-rose-500" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Last Name *</label>
                            <InputText @bind-Value="_modalModel.LastName" placeholder="e.g. Sharma" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.LastName)" class="text-[10px] text-rose-500" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Email Address</label>
                            <InputText @bind-Value="_modalModel.Email" placeholder="e.g. priya.sharma@vargshala.com" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.Email)" class="text-[10px] text-rose-500" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Phone / Mobile</label>
                            <InputText @bind-Value="_modalModel.Mobile" placeholder="+91 98765 43210" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                            <ValidationMessage For="@(() => _modalModel.Mobile)" class="text-[10px] text-rose-500" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Aadhar Card / Gov ID</label>
                        <InputText @bind-Value="_modalModel.AadharNumber" placeholder="12-digit UID" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>
                </div>

                <!-- Section 2: Professional & Role Details -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>2. Employment &amp; Role Details</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-start">
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Employee Code / ID *</label>
                                <span class="text-[10px] text-teal-600 dark:text-teal-400 font-semibold">Auto (EMP-YY00001)</span>
                            </div>
                            <div class="relative">
                                <InputText @bind-Value="_modalModel.EmployeeCode" readonly placeholder="e.g. EMP-2600001" class="w-full h-10 pl-3.5 pr-8 py-2.5 text-xs bg-slate-100 dark:bg-[#111c21] border border-slate-200 dark:border-slate-700 rounded-xl text-slate-700 dark:text-slate-300 font-mono font-bold cursor-not-allowed select-none focus:outline-none transition-all" />
                                <button type="button" @onclick="RegenerateTeacherCodeAsync" title="Regenerate unique Employee Code" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-[#009488] transition-colors cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center justify-between min-h-[18px]">
                                <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Joining Date</label>
                            </div>
                            <InputDate Type="InputDateType.Date" @bind-Value="_modalModel.JoiningDate" class="w-full h-10 px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Department</label>
                            <CustomSelect @bind-Value="_modalModel.Department" Options="_drawerSubjectOptions" Placeholder="Select Department" Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Designation</label>
                            <CustomSelect @bind-Value="_modalModel.Designation" Options="_drawerDesignationOptions" Placeholder="Select Designation" Class="w-full" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Teaching Experience (Years)</label>
                        <InputNumber @bind-Value="_modalModel.TeachingExperienceYears" placeholder="e.g. 5" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>
                </div>

                <!-- Section 3: Qualifications & Expertise -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>3. Qualifications &amp; Subject</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Highest Qualification</label>
                            <CustomSelect @bind-Value="_modalModel.HighestQualification" Options="_drawerQualificationOptions" Placeholder="Select Qualification" Class="w-full" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Specialization / Subject</label>
                            <InputText @bind-Value="_modalModel.Specialization" placeholder="e.g. Pure Mathematics / Organic Chemistry" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Previous Institute / Organization</label>
                        <InputText @bind-Value="_modalModel.PreviousInstitute" placeholder="e.g. Allen Career Institute / FIITJEE" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>
                </div>

                <!-- Section 4: Address Details -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>4. Residential Address</span>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Street / House Address</label>
                        <InputText @bind-Value="_modalModel.Address" placeholder="Flat / House No., Landmark, Area" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">City</label>
                            <InputText @bind-Value="_modalModel.City" placeholder="e.g. Patna" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">State</label>
                            <InputText @bind-Value="_modalModel.State" placeholder="e.g. Bihar" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Postal / PIN Code</label>
                            <InputText @bind-Value="_modalModel.PostalCode" placeholder="e.g. 800001" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Country</label>
                            <InputText @bind-Value="_modalModel.Country" placeholder="India" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Section 5: Bio & Notes -->
                <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider pb-1 border-b border-teal-500/20">
                        <span>5. Faculty Bio / Notes</span>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Bio / Background Description</label>
                        <InputText @bind-Value="_modalModel.Bio" placeholder="Brief professional biography or achievements" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                    </div>
                </div>

                <!-- Section 6: Status -->
                <div class="space-y-3 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2 text-xs font-bold text-[#00796b] dark:text-teal-300 uppercase tracking-wider">
                        <span>6. Account &amp; Status</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" @bind="_modalModel.IsActive" class="rounded text-[#009488] focus:ring-teal-500" />
                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Active Faculty Member (Allowed to manage batches, assignments &amp; attendance)</span>
                        </label>
                    </div>
                </div>

            </div>

            <!-- Drawer Footer Buttons -->
            <div class="p-4 bg-slate-50 dark:bg-[#0c1417] border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3 shrink-0">
                <button type="button" 
                        @onclick="CloseDrawerAsync" 
                        class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" 
                        disabled="@_isSaving"
                        class="px-5 py-2.5 text-xs font-bold bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] text-white rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50">
                    @if (_isSaving)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>@(_editingTeacher == null ? "Register Teacher" : "Update Teacher")</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 2: View Teacher Profile Modal -->
<!-- ========================================================================= -->
@if (_selectedProfileTeacher != null)
{
    <Modal IsOpen="true" 
           Title="Teacher Profile" 
           Subtitle="@($"{_selectedProfileTeacher.Designation} • {_selectedProfileTeacher.Subject}")" 
           MaxWidth="max-w-xl" 
           OnClose="() => _selectedProfileTeacher = null">
        <ChildContent>
            <div class="space-y-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-black text-lg flex items-center justify-center shadow-xs">
                        @_selectedProfileTeacher.Initials
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white">@_selectedProfileTeacher.FullName</h4>
                        <p class="text-xs text-slate-400 dark:text-slate-500 font-medium">@_selectedProfileTeacher.EmployeeCode • @(!string.IsNullOrEmpty(_selectedProfileTeacher.HighestQualification) ? _selectedProfileTeacher.HighestQualification : _selectedProfileTeacher.Qualification)</p>
                        <div class="mt-1 flex items-center gap-2">
                            <Badge Text="@(_selectedProfileTeacher.IsActive ? "Active" : "Inactive")" 
                                   Variant="@(_selectedProfileTeacher.IsActive ? Badge.BadgeVariant.Green : Badge.BadgeVariant.Gray)" 
                                   ShowDot="true" />
                            @if (_selectedProfileTeacher.TeachingExperienceYears.HasValue)
                            {
                                <span class="text-[11px] font-medium text-teal-600 dark:text-teal-400">• @_selectedProfileTeacher.TeachingExperienceYears yrs exp</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 dark:bg-[#18262c] p-4 rounded-2xl space-y-2.5 text-xs border border-slate-100 dark:border-slate-800">
                    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Department:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.Department) ? _selectedProfileTeacher.Department : _selectedProfileTeacher.Subject)</span>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Designation:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.Designation</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Phone / Mobile:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.Mobile) ? _selectedProfileTeacher.Mobile : (!string.IsNullOrEmpty(_selectedProfileTeacher.Phone) ? _selectedProfileTeacher.Phone : "—"))</span>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Email:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.Email) ? _selectedProfileTeacher.Email : "—")</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-700/50">
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Joining Date:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(_selectedProfileTeacher.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Specialization:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.Specialization) ? _selectedProfileTeacher.Specialization : "—")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_selectedProfileTeacher.Address) || !string.IsNullOrEmpty(_selectedProfileTeacher.City))
                    {
                        <div class="pb-2 border-b border-slate-200 dark:border-slate-700/50">
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Address:</span>
                            <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.Address, @_selectedProfileTeacher.City @_selectedProfileTeacher.State @_selectedProfileTeacher.PostalCode</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_selectedProfileTeacher.PreviousInstitute) || !string.IsNullOrEmpty(_selectedProfileTeacher.AadharNumber))
                    {
                        <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-700/50">
                            <div>
                                <span class="text-slate-400 dark:text-slate-500 font-medium">Prev Institute:</span>
                                <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.PreviousInstitute) ? _selectedProfileTeacher.PreviousInstitute : "—")</span>
                            </div>
                            <div>
                                <span class="text-slate-400 dark:text-slate-500 font-medium">Gov ID:</span>
                                <span class="ml-1 font-bold text-slate-800 dark:text-slate-200">@(!string.IsNullOrEmpty(_selectedProfileTeacher.AadharNumber) ? _selectedProfileTeacher.AadharNumber : "—")</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_selectedProfileTeacher.Bio))
                    {
                        <div class="pt-1">
                            <span class="text-slate-400 dark:text-slate-500 font-medium">Bio:</span>
                            <p class="mt-0.5 text-slate-700 dark:text-slate-300 italic">@_selectedProfileTeacher.Bio</p>
                        </div>
                    }
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" 
                    @onclick="() => _selectedProfileTeacher = null" 
                    class="px-5 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800 rounded-xl transition-all cursor-pointer">
                Close
            </button>
        </FooterTemplate>
    </Modal>
}

