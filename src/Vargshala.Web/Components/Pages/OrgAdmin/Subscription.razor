@page "/subscription"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "OrganizationAdmin,SuperAdmin,1001,1002")]
@rendermode InteractiveServer
@implements IDisposable

@using Vargshala.Contracts.Common
@using Vargshala.Contracts.Subscriptions
@using Vargshala.Contracts.Coupons
@using Vargshala.SharedKernel.Enums
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Skeletons
@using Vargshala.Web.Services

@inject IOrganizationSubscriptionService SubscriptionService
@inject ISubscriptionPlanService PlanService
@inject INotificationService Toast
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Institute Subscription &amp; Billing | Vargshala</PageTitle>

<div class="flex-1 min-h-0 h-full overflow-y-auto pr-1 pb-16 space-y-6 select-text transition-colors duration-200" style="scrollbar-width: thin;">

    <!-- Top Header & Action Controls -->
    <div class="shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <span class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#004D40] to-[#009488] text-white flex items-center justify-center shadow-lg shadow-[#004D40]/25 shrink-0">
                <svg class="w-6 h-6 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
            </span>
            <div>
                <h1 class="text-2xl font-black text-slate-800 dark:text-white tracking-tight leading-tight">
                    Institute Subscription &amp; Billing
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-medium">
                    Monitor capacity quotas, upgrade your coaching plan, apply discount coupons, and complete Razorpay checkout
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
            <button type="button" 
                    @onclick="LoadDataAsync"
                    disabled="@_isLoading"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-[#18262c] border border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-[#1f3037] transition-all shadow-2xs cursor-pointer flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98]">
                <svg class="w-3.5 h-3.5 text-[#009488] @(_isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Refresh Status</span>
            </button>
        </div>
    </div>

    <!-- Active Plan & Quotas Section -->
    @if (_currentQuota?.CurrentSubscription != null)
    {
        var sub = _currentQuota.CurrentSubscription;
        <div class="shrink-0 rounded-3xl p-6 sm:p-7 text-white shadow-xl shadow-[#004D40]/25 relative overflow-hidden bg-gradient-to-r from-[#00382E] via-[#004D40] to-[#00796B] border border-white/10">
            <!-- Decorative background pattern -->
            <div class="absolute -right-12 -bottom-12 w-72 h-72 rounded-full bg-[#009488]/20 pointer-events-none blur-3xl"></div>
            <div class="absolute left-1/3 -top-16 w-56 h-56 rounded-full bg-white/10 pointer-events-none blur-2xl"></div>

            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="space-y-3">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-white/15 backdrop-blur-md text-teal-100 border border-white/20">
                            @sub.BillingCycle.ToString() Plan
                        </span>
                        <span class="px-3 py-1 rounded-full text-xs font-bold @GetStatusBadgeClass(sub.Status)">
                            ● @sub.Status.ToString()
                        </span>
                        @if (sub.RemainingDays >= 0)
                        {
                            <span class="text-xs font-bold text-teal-100/90 flex items-center gap-1.5 bg-black/20 px-3 py-1 rounded-full backdrop-blur-xs border border-white/10">
                                <svg class="w-3.5 h-3.5 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                @sub.RemainingDays Days Remaining
                            </span>
                        }
                    </div>

                    <div>
                        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
                            @sub.PlanName
                        </h2>
                        <p class="text-xs text-teal-100/90 mt-1 max-w-xl leading-relaxed font-medium">
                            Active for <strong class="text-white font-bold">@sub.OrganizationName</strong> • Valid from 
                            @(sub.StartDate.ToString("dd MMM yyyy")) to @(sub.EndDate.ToString("dd MMM yyyy"))
                        </p>
                    </div>
                </div>

                <div class="shrink-0 flex flex-col sm:flex-row lg:flex-col items-start lg:items-end justify-between gap-4 border-t lg:border-t-0 lg:border-l border-white/15 pt-4 lg:pt-0 lg:pl-8">
                    <div>
                        <p class="text-[11px] font-bold text-teal-200/80 uppercase tracking-widest">Current Investment</p>
                        <p class="text-3xl font-black text-white mt-0.5">
                            @(sub.PlanPrice == 0 ? "Free Trial" : $"₹{sub.PlanPrice:N0}")
                            <span class="text-xs font-normal text-teal-200">/@(sub.BillingCycle == BillingCycle.Trial ? "trial" : "month")</span>
                        </p>
                    </div>
                    <a href="#plans-grid" class="px-5 py-2.5 rounded-xl bg-white text-[#004D40] hover:bg-teal-50 text-xs font-extrabold transition-all shadow-md hover:scale-105 active:scale-95 cursor-pointer inline-flex items-center gap-1.5">
                        <span>Upgrade / Change Plan</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                </div>
            </div>
        </div>
    }
    else if (!_isLoading)
    {
        <!-- No Active Plan Warning Banner -->
        <div class="shrink-0 rounded-3xl p-6 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-amber-900 dark:text-amber-200">No Active Subscription Plan</h3>
                    <p class="text-xs text-amber-700 dark:text-amber-300 mt-0.5">
                        Your institute does not currently have an active SaaS subscription. Select a free trial or paid plan below to unlock institute features.
                    </p>
                </div>
            </div>
            <a href="#plans-grid" class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold transition-all shadow-sm shrink-0 text-center cursor-pointer">
                Select a Plan Now →
            </a>
        </div>
    }

    <!-- 3 Capacity Quota Cards (Direct Values - No Layout Shifts) -->
    <div class="shrink-0 grid grid-cols-1 md:grid-cols-3 gap-4.5">
        <!-- 1. Students Quota -->
        <div class="bg-white dark:bg-[#18262c] p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-2xl relative hover:shadow-md transition-all">
            <div class="flex items-center justify-between mb-3.5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#009488]/10 text-[#009488] flex items-center justify-center font-bold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Student Capacity</p>
                        <h4 class="text-xl font-black text-slate-900 dark:text-white mt-0.5">
                            @(_currentQuota?.CurrentStudentsCount ?? 0)
                            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">/ @(_currentQuota?.MaxStudents.HasValue == true ? _currentQuota.MaxStudents.Value.ToString("N0") : "Unlimited")</span>
                        </h4>
                    </div>
                </div>
                <span class="text-xs font-black px-2.5 py-1 rounded-lg @GetUsageTextColor(_currentQuota?.StudentsUsagePercentage ?? 0, _currentQuota?.IsStudentsQuotaExceeded ?? false)">
                    @(_currentQuota?.MaxStudents.HasValue == true ? $"{_currentQuota.StudentsUsagePercentage}%" : "100% OK")
                </span>
            </div>
            @if (_currentQuota?.MaxStudents.HasValue == true)
            {
                <div class="w-full bg-slate-100 dark:bg-slate-800/80 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @GetUsageBarColor(_currentQuota.StudentsUsagePercentage, _currentQuota.IsStudentsQuotaExceeded)" 
                         style="width: @Math.Min(100, _currentQuota.StudentsUsagePercentage)%"></div>
                </div>
            }
            else
            {
                <div class="w-full bg-emerald-100 dark:bg-emerald-950/40 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full w-full"></div>
                </div>
            }
        </div>

        <!-- 2. Teachers Quota -->
        <div class="bg-white dark:bg-[#18262c] p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-2xl relative hover:shadow-md transition-all">
            <div class="flex items-center justify-between mb-3.5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#009488]/10 text-[#009488] flex items-center justify-center font-bold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Faculty Capacity</p>
                        <h4 class="text-xl font-black text-slate-900 dark:text-white mt-0.5">
                            @(_currentQuota?.CurrentTeachersCount ?? 0)
                            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">/ @(_currentQuota?.MaxTeachers.HasValue == true ? _currentQuota.MaxTeachers.Value.ToString("N0") : "Unlimited")</span>
                        </h4>
                    </div>
                </div>
                <span class="text-xs font-black px-2.5 py-1 rounded-lg @GetUsageTextColor(_currentQuota?.TeachersUsagePercentage ?? 0, _currentQuota?.IsTeachersQuotaExceeded ?? false)">
                    @(_currentQuota?.MaxTeachers.HasValue == true ? $"{_currentQuota.TeachersUsagePercentage}%" : "100% OK")
                </span>
            </div>
            @if (_currentQuota?.MaxTeachers.HasValue == true)
            {
                <div class="w-full bg-slate-100 dark:bg-slate-800/80 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @GetUsageBarColor(_currentQuota.TeachersUsagePercentage, _currentQuota.IsTeachersQuotaExceeded)" 
                         style="width: @Math.Min(100, _currentQuota.TeachersUsagePercentage)%"></div>
                </div>
            }
            else
            {
                <div class="w-full bg-emerald-100 dark:bg-emerald-950/40 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full w-full"></div>
                </div>
            }
        </div>

        <!-- 3. Branches Quota -->
        <div class="bg-white dark:bg-[#18262c] p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-2xl relative hover:shadow-md transition-all">
            <div class="flex items-center justify-between mb-3.5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#009488]/10 text-[#009488] flex items-center justify-center font-bold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-500 dark:text-slate-400">Branch Capacity</p>
                        <h4 class="text-xl font-black text-slate-900 dark:text-white mt-0.5">
                            @(_currentQuota?.CurrentBranchesCount ?? 0)
                            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">/ @(_currentQuota?.MaxBranches.HasValue == true ? _currentQuota.MaxBranches.Value.ToString("N0") : "Unlimited")</span>
                        </h4>
                    </div>
                </div>
                <span class="text-xs font-black px-2.5 py-1 rounded-lg @GetUsageTextColor(_currentQuota?.BranchesUsagePercentage ?? 0, _currentQuota?.IsBranchesQuotaExceeded ?? false)">
                    @(_currentQuota?.MaxBranches.HasValue == true ? $"{_currentQuota.BranchesUsagePercentage}%" : "100% OK")
                </span>
            </div>
            @if (_currentQuota?.MaxBranches.HasValue == true)
            {
                <div class="w-full bg-slate-100 dark:bg-slate-800/80 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @GetUsageBarColor(_currentQuota.BranchesUsagePercentage, _currentQuota.IsBranchesQuotaExceeded)" 
                         style="width: @Math.Min(100, _currentQuota.BranchesUsagePercentage)%"></div>
                </div>
            }
            else
            {
                <div class="w-full bg-emerald-100 dark:bg-emerald-950/40 h-2.5 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full w-full"></div>
                </div>
            }
        </div>
    </div>

    <!-- Available Plans Grid -->
    <div id="plans-grid" class="shrink-0 scroll-mt-6 pt-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
            <div>
                <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <span>Choose Your Subscription Plan</span>
                    <span class="w-2 h-2 rounded-full bg-[#009488]"></span>
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
                    Upgrade anytime to increase student and branch capacity. Instant activation via Razorpay.
                </p>
            </div>
            <span class="text-xs font-extrabold text-[#009488] bg-teal-50 dark:bg-teal-950/40 px-3.5 py-1.5 rounded-full border border-teal-200/60 dark:border-teal-800/40 shrink-0 self-start sm:self-auto flex items-center gap-1.5">
                <span>⚡ Secure Checkout via Razorpay</span>
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 items-stretch">
            @foreach (var plan in _availablePlans)
            {
                bool isCurrentPlan = _currentQuota?.CurrentSubscription?.PlanId == plan.Id;
                bool isPopular = plan.Name.Contains("Standard", StringComparison.OrdinalIgnoreCase);
                bool isTrial = plan.Price == 0;

                <div class="bg-white dark:bg-[#18262c] rounded-3xl p-6 sm:p-7 border @(isPopular ? "border-[#009488] ring-2 ring-[#009488]/30 shadow-xl shadow-[#009488]/15 bg-gradient-to-b from-teal-50/30 via-white to-white dark:from-[#1c2e36] dark:via-[#18262c] dark:to-[#18262c]" : "border-slate-200/80 dark:border-slate-800 shadow-sm") flex flex-col justify-between relative transition-all duration-200 hover:shadow-lg hover:-translate-y-1">
                    @if (isPopular)
                    {
                        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-[#004D40] to-[#009488] text-white text-[10px] font-black uppercase tracking-widest px-3.5 py-1 rounded-full shadow-md">
                            ⭐ Most Popular
                        </div>
                    }

                    <div>
                        <div class="flex items-center justify-between gap-2">
                            <h3 class="text-lg font-black text-slate-900 dark:text-white">@plan.Name</h3>
                            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                @plan.BillingCycle.ToString()
                            </span>
                        </div>

                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 min-h-[34px] line-clamp-2 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(plan.Description) ? "Comprehensive management features for coaching institutes." : plan.Description)
                        </p>

                        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/80">
                            <div class="flex items-baseline gap-1">
                                <span class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
                                    @(isTrial ? "Free" : $"₹{plan.Price:N0}")
                                </span>
                                <span class="text-xs text-slate-400 dark:text-slate-500 font-semibold">
                                    /@(isTrial ? "7 days" : "month")
                                </span>
                            </div>
                        </div>

                        <!-- Feature Limits Checklist -->
                        <div class="mt-6 space-y-3 text-xs text-slate-600 dark:text-slate-300 font-medium">
                            <div class="flex items-center gap-2.5">
                                <span class="w-4 h-4 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                                <span>
                                    <strong class="text-slate-900 dark:text-white font-bold">@(plan.MaxStudents.HasValue ? $"{plan.MaxStudents.Value:N0} Students" : "Unlimited Students")</strong> capacity
                                </span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="w-4 h-4 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                                <span>
                                    <strong class="text-slate-900 dark:text-white font-bold">@(plan.MaxTeachers.HasValue ? $"{plan.MaxTeachers.Value:N0} Faculty" : "Unlimited Faculty")</strong> accounts
                                </span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="w-4 h-4 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                                <span>
                                    <strong class="text-slate-900 dark:text-white font-bold">@(plan.MaxBranches.HasValue ? $"{plan.MaxBranches.Value:N0} Branch" : "Unlimited Branches")</strong>
                                </span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="w-4 h-4 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                                <span>Attendance, Fee Packages &amp; Receipts</span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="w-4 h-4 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                                <span>Exam &amp; Batch Management</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-7 pt-4">
                        @if (isCurrentPlan)
                        {
                            <button type="button" disabled
                                    class="w-full py-3 px-4 rounded-xl border border-emerald-500/40 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-extrabold text-xs flex items-center justify-center gap-2">
                                <span>✓ Current Active Plan</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                                    @onclick="() => OpenCheckoutModal(plan)"
                                    class="w-full py-3 px-4 rounded-xl @(isPopular ? "bg-gradient-to-r from-[#004D40] to-[#009488] text-white hover:from-[#00382E] hover:to-[#007A6F] shadow-lg shadow-[#004D40]/25" : "bg-slate-900 dark:bg-[#00796B] hover:bg-slate-800 dark:hover:bg-[#009488] text-white") font-extrabold text-xs transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2">
                                <span>@(isTrial ? "Start 7-Day Free Trial" : "Select & Checkout →")</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Billing & Invoice History Table -->
    <div class="shrink-0 bg-white dark:bg-[#18262c] rounded-3xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-7 shadow-sm">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <span>Billing &amp; Invoice History</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#009488]"></span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
                    Record of past subscription charges, payment gateway confirmations, and transaction receipts
                </p>
            </div>
            <span class="text-xs font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full">
                Total Invoices: @_billingHistory.Count
            </span>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-100 dark:border-slate-800">
            <table class="table-fixed w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-[#111c21] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold text-[11px] border-b border-slate-100 dark:border-slate-800">
                    <tr>
                        <th style="width: 22%" class="p-3.5">Invoice / Receipt #</th>
                        <th style="width: 18%" class="p-3.5">Date (UTC)</th>
                        <th style="width: 18%" class="p-3.5">Plan / Cycle</th>
                        <th style="width: 14%" class="p-3.5 text-right">Amount</th>
                        <th style="width: 14%" class="p-3.5 text-center">Status</th>
                        <th style="width: 14%" class="p-3.5 text-center">Gateway Ref</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium @(_isLoading && _billingHistory.Any() ? "opacity-60 pointer-events-none transition-opacity duration-150" : "transition-opacity duration-150")">
                    @if (_isLoading && !_billingHistory.Any())
                    {
                        <TableSkeletonRows Columns="6" Rows="3" />
                    }
                    else if (!_billingHistory.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                                No billing transactions recorded yet. Complete a checkout above to generate an invoice.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in _billingHistory)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                                <td class="p-3.5 font-mono text-slate-800 dark:text-white font-bold">
                                    @(string.IsNullOrWhiteSpace(item.ReceiptNumber) ? item.PaymentId.ToString("N")[..8].ToUpperInvariant() : item.ReceiptNumber)
                                </td>
                                <td class="p-3.5 text-slate-600 dark:text-slate-300">
                                    @item.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td class="p-3.5">
                                    <span class="font-bold text-slate-800 dark:text-white">@item.PlanName</span>
                                    <span class="text-[10px] text-slate-400 block">@item.PaymentMethod</span>
                                </td>
                                <td class="p-3.5 text-right font-bold text-slate-900 dark:text-white">
                                    @(item.Amount == 0 ? "Free" : $"₹{item.Amount:N2}")
                                </td>
                                <td class="p-3.5 text-center">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(item.Status.Equals("Active", StringComparison.OrdinalIgnoreCase) || item.Status.Equals("Success", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400" : "bg-slate-100 text-slate-600")">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="p-3.5 text-center text-slate-500 dark:text-slate-400 font-mono text-[11px] truncate max-w-[120px]" title="@item.TransactionReference">
                                    @(string.IsNullOrWhiteSpace(item.TransactionReference) ? "-" : item.TransactionReference)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Checkout Modal Slide-over / Dialog (Split 2-Column: Left Details, Right Checkout) -->
@if (_isCheckoutModalOpen && _selectedPlan != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-5 animate-fadeIn">
        <div class="bg-white dark:bg-[#111c21] rounded-3xl max-w-4xl w-full shadow-2xl border border-tealborder relative overflow-hidden flex flex-col md:flex-row my-auto">
            
            <!-- Close Button (Top-Right on Mobile & Desktop) -->
            <button type="button" 
                    @onclick="CloseCheckoutModal"
                    disabled="@_isProcessingPayment"
                    class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center justify-center transition-all cursor-pointer">
                ✕
            </button>

            <!-- LEFT COLUMN: Plan Details, Quotas & Features -->
            <div class="w-full md:w-5/12 bg-gradient-to-br from-slate-50 via-teal-50/25 to-slate-100 dark:from-[#152329] dark:via-[#131f24] dark:to-[#0f171b] p-6 sm:p-7 border-b md:border-b-0 md:border-r border-slate-200/80 dark:border-slate-800 flex flex-col justify-between">
                <div>
                    <!-- Badge & Plan Name -->
                    <div class="flex items-center gap-2 mb-3">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#009488]/15 text-[#009488] dark:bg-[#009488]/25 dark:text-teal-300 border border-[#009488]/30">
                            @_selectedPlan.BillingCycleName Plan
                        </span>
                        @if (_selectedPlan.Price <= 0)
                        {
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400">
                                Free
                            </span>
                        }
                    </div>

                    <h3 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight mb-1">
                        @_selectedPlan.Name
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-5 leading-relaxed">
                        @(!string.IsNullOrWhiteSpace(_selectedPlan.Description) ? _selectedPlan.Description : "Subscription plan for your coaching institute.")
                    </p>

                    <!-- Quota & Capacity Grid -->
                    <div class="space-y-2.5 mb-6">
                        <div class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-[#18262c] border border-slate-100 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-lg bg-teal-50 dark:bg-teal-950/50 text-[#009488] flex items-center justify-center text-xs">
                                    🎓
                                </span>
                                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Student Quota</span>
                            </div>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">
                                @(_selectedPlan.MaxStudents.HasValue ? $"{_selectedPlan.MaxStudents.Value:N0} Students" : "Unlimited")
                            </span>
                        </div>

                        <div class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-[#18262c] border border-slate-100 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-lg bg-teal-50 dark:bg-teal-950/50 text-[#009488] flex items-center justify-center text-xs">
                                    👨‍🏫
                                </span>
                                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Faculty Quota</span>
                            </div>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">
                                @(_selectedPlan.MaxTeachers.HasValue ? $"{_selectedPlan.MaxTeachers.Value:N0} Faculty" : "Unlimited")
                            </span>
                        </div>

                        <div class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-[#18262c] border border-slate-100 dark:border-slate-800 shadow-sm">
                            <div class="flex items-center gap-2.5">
                                <span class="w-7 h-7 rounded-lg bg-teal-50 dark:bg-teal-950/50 text-[#009488] flex items-center justify-center text-xs">
                                    🏛️
                                </span>
                                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Campuses / Branches</span>
                            </div>
                            <span class="text-xs font-bold text-slate-900 dark:text-white">
                                @(_selectedPlan.MaxBranches.HasValue ? $"{_selectedPlan.MaxBranches.Value:N0} Branch" : "Unlimited")
                            </span>
                        </div>
                    </div>

                    <!-- Key Plan Highlights -->
                    <div class="space-y-2 mb-4">
                        <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">
                            Included In This Plan:
                        </span>
                        <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1.5 font-medium">
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-500 dark:text-emerald-400 font-bold">✓</span>
                                <span>Real-time Attendance &amp; Fee Tracking</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-500 dark:text-emerald-400 font-bold">✓</span>
                                <span>Automated WhatsApp &amp; SMS Updates</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-500 dark:text-emerald-400 font-bold">✓</span>
                                <span>Exam Engine &amp; Student Report Cards</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="text-emerald-500 dark:text-emerald-400 font-bold">✓</span>
                                <span>Multi-device Web &amp; Mobile Access</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Left Footer Institute Info -->
                <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                    <span class="truncate">
                        Institute: <strong class="text-slate-700 dark:text-slate-300 font-semibold">@(_currentQuota?.CurrentSubscription?.OrganizationName ?? "Your Institute")</strong>
                    </span>
                </div>
            </div>

            <!-- RIGHT COLUMN: Checkout, Coupon & Payment Action -->
            <div class="w-full md:w-7/12 p-6 sm:p-7 flex flex-col justify-between bg-white dark:bg-[#111c21]">
                <div>
                    <!-- Section Header -->
                    <div class="flex items-center gap-3 mb-5 pr-8">
                        <div class="w-10 h-10 rounded-2xl bg-[#009488]/10 text-[#009488] flex items-center justify-center font-black shrink-0">
                            💳
                        </div>
                        <div>
                            <h4 class="text-lg font-black text-slate-900 dark:text-white">
                                Order Summary
                            </h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                                Review your plan, apply coupon, and pay securely
                            </p>
                        </div>
                    </div>

                    <!-- Coupon Code Application Box -->
                    @if (_selectedPlan.Price > 0)
                    {
                        <div class="mb-5">
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1.5">
                                Have a Discount Coupon?
                            </label>
                            <div class="flex gap-2">
                                <input type="text" 
                                       @bind="_couponInput" 
                                       @bind:event="oninput"
                                       placeholder="e.g. DIWALI20" 
                                       disabled="@(_isProcessingPayment || _isApplyingCoupon || _isCouponValid)"
                                       class="flex-1 uppercase text-xs font-bold tracking-wider px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#009488]" />
                                
                                @if (_isCouponValid)
                                {
                                    <button type="button" 
                                            @onclick="RemoveCoupon"
                                            disabled="@_isProcessingPayment"
                                            class="px-3.5 py-2.5 rounded-xl bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold hover:bg-slate-300 transition-all cursor-pointer">
                                        Remove
                                    </button>
                                }
                                else
                                {
                                    <button type="button" 
                                            @onclick="ApplyCouponAsync"
                                            disabled="@(_isProcessingPayment || _isApplyingCoupon || string.IsNullOrWhiteSpace(_couponInput))"
                                            class="px-4 py-2.5 rounded-xl bg-[#004D40] hover:bg-[#00382E] text-white text-xs font-bold transition-all disabled:opacity-50 cursor-pointer flex items-center gap-1.5 shrink-0">
                                        @if (_isApplyingCoupon)
                                        {
                                            <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                        }
                                        <span>Apply</span>
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_couponMessage))
                            {
                                <p class="text-[11px] font-bold mt-1.5 @(_isCouponValid ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                                    @_couponMessage
                                </p>
                            }
                        </div>
                    }

                    <!-- Price Breakdown Summary Box -->
                    <div class="bg-slate-50 dark:bg-[#18262c] rounded-2xl p-4 border border-slate-100 dark:border-slate-800 mb-5 space-y-2.5">
                        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                            <span>Base Plan Price (@_selectedPlan.BillingCycleName)</span>
                            <span class="font-semibold text-slate-800 dark:text-slate-200">₹@_selectedPlan.Price.ToString("N2")</span>
                        </div>

                        @if (_discountAmount > 0)
                        {
                            <div class="flex items-center justify-between text-xs text-emerald-600 dark:text-emerald-400 font-semibold">
                                <span>Coupon Discount (@_appliedCouponCode)</span>
                                <span>- ₹@_discountAmount.ToString("N2")</span>
                            </div>
                        }

                        <div class="flex items-center justify-between text-xs text-slate-400 dark:text-slate-500">
                            <span>Platform Tax &amp; GST</span>
                            <span class="font-medium">Inclusive</span>
                        </div>

                        <div class="border-t border-slate-200/80 dark:border-slate-700/80 pt-2.5 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-black text-slate-900 dark:text-white block">Final Amount Payable</span>
                            </div>
                            <span class="text-2xl font-black text-[#009488]">₹@FinalPayableAmount.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Error message if any -->
                    @if (!string.IsNullOrWhiteSpace(_checkoutErrorMessage))
                    {
                        <div class="p-3 mb-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-xs text-rose-700 dark:text-rose-300 font-medium">
                            @_checkoutErrorMessage
                        </div>
                    }
                </div>

                <!-- Action Button -->
                <div class="pt-2">
                    <button type="button" 
                            @onclick="InitiateCheckoutAsync"
                            disabled="@_isProcessingPayment"
                            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-[#004D40] to-[#009488] hover:from-[#00382E] hover:to-[#007A6F] text-white font-bold text-xs sm:text-sm transition-all shadow-lg shadow-[#004D40]/25 flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.01] active:scale-[0.99] disabled:opacity-60">
                        @if (_isProcessingPayment)
                        {
                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                            <span>Processing...</span>
                        }
                        else if (FinalPayableAmount <= 0)
                        {
                            <span>Activate Free Plan</span>
                        }
                        else
                        {
                            <span>Pay ₹@FinalPayableAmount.ToString("N2")</span>
                        }
                    </button>
                </div>

            </div>

        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isProcessingPayment = false;
    private bool _isApplyingCoupon = false;
    private bool _isCheckoutModalOpen = false;

    private QuotaUsageDto? _currentQuota;
    private List<SubscriptionPlanDto> _availablePlans = new();
    private List<SubscriptionBillingHistoryDto> _billingHistory = new();

    private SubscriptionPlanDto? _selectedPlan;
    private string _couponInput = string.Empty;
    private string? _appliedCouponCode;
    private SubscriptionCheckoutResponse? _cachedCheckoutData;
    private decimal _discountAmount = 0m;
    private bool _isCouponValid = false;
    private string? _couponMessage;
    private string? _checkoutErrorMessage;

    private DotNetObjectReference<Subscription>? _dotNetRef;

    private decimal FinalPayableAmount => _selectedPlan == null 
        ? 0m 
        : Math.Max(0m, _selectedPlan.Price - _discountAmount);

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            // 1. Load Current Subscription & Quota Usage
            var quotaRes = await SubscriptionService.GetCurrentSubscriptionAsync();
            if (quotaRes.Success && quotaRes.Data != null)
            {
                _currentQuota = quotaRes.Data;
            }

            // 2. Load Active Plans
            var plansRes = await PlanService.GetActivePlansAsync();
            if (plansRes.Success && plansRes.Data != null)
            {
                _availablePlans = plansRes.Data.OrderBy(p => p.Price).ToList();
            }

            // 3. Load Billing & Invoice History
            var historyRes = await SubscriptionService.GetSubscriptionHistoryAsync();
            if (historyRes.Success && historyRes.Data != null)
            {
                _billingHistory = historyRes.Data;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load subscription details: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenCheckoutModal(SubscriptionPlanDto plan)
    {
        _selectedPlan = plan;
        _couponInput = string.Empty;
        _appliedCouponCode = null;
        _cachedCheckoutData = null;
        _discountAmount = 0m;
        _isCouponValid = false;
        _couponMessage = null;
        _checkoutErrorMessage = null;
        _isCheckoutModalOpen = true;
    }

    private void CloseCheckoutModal()
    {
        if (_isProcessingPayment) return;
        _isCheckoutModalOpen = false;
        _selectedPlan = null;
        _cachedCheckoutData = null;
    }

    private async Task ApplyCouponAsync()
    {
        if (string.IsNullOrWhiteSpace(_couponInput))
        {
            Toast.Warning("Please enter a coupon code.");
            return;
        }

        if (_selectedPlan == null)
        {
            Toast.Warning("Please select a plan first.");
            return;
        }

        _isApplyingCoupon = true;
        _couponMessage = null;

        try
        {
            var code = _couponInput.Trim().ToUpperInvariant();
            var res = await SubscriptionService.CheckoutAsync(new SubscriptionCheckoutRequest
            {
                PlanId = _selectedPlan.Id,
                CouponCode = code
            });

            if (res.Success && res.Data != null)
            {
                _cachedCheckoutData = res.Data;
                _discountAmount = res.Data.DiscountAmount;
                _appliedCouponCode = code;
                _isCouponValid = true;
                _couponMessage = res.Data.DiscountAmount > 0 
                    ? $"✓ Coupon '{code}' applied: ₹{res.Data.DiscountAmount:N2} discount!" 
                    : (!string.IsNullOrWhiteSpace(res.Data.CouponDescription) ? $"✓ Coupon applied: {res.Data.CouponDescription}" : "✓ Coupon applied successfully!");
                Toast.Success(_couponMessage);
            }
            else
            {
                _discountAmount = 0m;
                _appliedCouponCode = null;
                _isCouponValid = false;
                _cachedCheckoutData = null;
                _couponMessage = !string.IsNullOrWhiteSpace(res.Message) ? res.Message : "Invalid coupon code.";
                Toast.Error(_couponMessage);
            }
        }
        catch (Exception ex)
        {
            _discountAmount = 0m;
            _appliedCouponCode = null;
            _isCouponValid = false;
            _cachedCheckoutData = null;
            _couponMessage = $"Error validating coupon: {ex.Message}";
            Toast.Error(_couponMessage);
        }
        finally
        {
            _isApplyingCoupon = false;
            StateHasChanged();
        }
    }

    private void RemoveCoupon()
    {
        _couponInput = string.Empty;
        _appliedCouponCode = null;
        _cachedCheckoutData = null;
        _discountAmount = 0m;
        _isCouponValid = false;
        _couponMessage = null;
    }

    private async Task InitiateCheckoutAsync()
    {
        if (_selectedPlan == null) return;
        _isProcessingPayment = true;
        _checkoutErrorMessage = null;

        try
        {
            SubscriptionCheckoutResponse checkoutData;

            if (_cachedCheckoutData != null && 
                string.Equals(_cachedCheckoutData.CouponCode, _appliedCouponCode, StringComparison.OrdinalIgnoreCase))
            {
                checkoutData = _cachedCheckoutData;
            }
            else
            {
                var checkoutReq = new SubscriptionCheckoutRequest
                {
                    PlanId = _selectedPlan.Id,
                    CouponCode = string.IsNullOrWhiteSpace(_appliedCouponCode) ? null : _appliedCouponCode.Trim()
                };

                var response = await SubscriptionService.CheckoutAsync(checkoutReq);
                if (!response.Success || response.Data == null)
                {
                    _checkoutErrorMessage = response.Message ?? "Failed to initialize subscription checkout";
                    Toast.Error(_checkoutErrorMessage);
                    _isProcessingPayment = false;
                    return;
                }

                checkoutData = response.Data;
            }

            // Free plan or 100% coupon discount -> directly activate without Razorpay modal
            if (checkoutData.IsFreePlan || checkoutData.FinalAmount <= 0)
            {
                await HandlePaymentConfirmationAsync(null, null, null);
                return;
            }

            // Paid plan -> Open official Razorpay Checkout SDK Modal
            var options = new
            {
                keyId = checkoutData.RazorpayKeyId,
                amount = checkoutData.FinalAmount,
                currency = checkoutData.Currency,
                orderId = checkoutData.RazorpayOrderId,
                companyName = checkoutData.CompanyName ?? "Vargshala SaaS",
                description = $"Subscription - {checkoutData.PlanName}",
                themeColor = checkoutData.ThemeColor ?? "#004D40",
                prefillName = _currentQuota?.CurrentSubscription?.OrganizationName ?? "Institute Admin",
                prefillEmail = "",
                prefillContact = ""
            };

            await JS.InvokeVoidAsync("RazorpayInterop.openCheckout", options, _dotNetRef);
        }
        catch (Exception ex)
        {
            _checkoutErrorMessage = ex.Message;
            Toast.Error($"Checkout initialization error: {ex.Message}");
            _isProcessingPayment = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnRazorpaySuccess(string razorpayOrderId, string razorpayPaymentId, string razorpaySignature)
    {
        await HandlePaymentConfirmationAsync(razorpayOrderId, razorpayPaymentId, razorpaySignature);
    }

    [JSInvokable]
    public void OnRazorpayDismissed()
    {
        _isProcessingPayment = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRazorpayFailed(string reason)
    {
        _isProcessingPayment = false;
        _checkoutErrorMessage = $"Payment unsuccessful: {reason}";
        Toast.Error(_checkoutErrorMessage);
        StateHasChanged();
    }

    private async Task HandlePaymentConfirmationAsync(string? orderId, string? paymentId, string? signature)
    {
        if (_selectedPlan == null) return;
        _isProcessingPayment = true;

        try
        {
            var confirmReq = new ConfirmSubscriptionPaymentRequest
            {
                PlanId = _selectedPlan.Id,
                CouponCode = string.IsNullOrWhiteSpace(_appliedCouponCode) ? null : _appliedCouponCode.Trim(),
                RazorpayOrderId = orderId,
                RazorpayPaymentId = paymentId,
                RazorpaySignature = signature
            };

            var confirmRes = await SubscriptionService.ConfirmPaymentAsync(confirmReq);
            if (confirmRes.Success)
            {
                Toast.Success("🎉 Plan activated successfully! Your institute capacity has been updated.");
                _isCheckoutModalOpen = false;
                _selectedPlan = null;
                _cachedCheckoutData = null;
                await LoadDataAsync();
            }
            else
            {
                _checkoutErrorMessage = confirmRes.Message ?? "Payment confirmation failed.";
                Toast.Error(_checkoutErrorMessage);
            }
        }
        catch (Exception ex)
        {
            _checkoutErrorMessage = ex.Message;
            Toast.Error($"Confirmation error: {ex.Message}");
        }
        finally
        {
            _isProcessingPayment = false;
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => "bg-emerald-400 text-emerald-950 font-black",
        SubscriptionStatus.Trial => "bg-blue-300 text-blue-950 font-black",
        SubscriptionStatus.Expired => "bg-rose-400 text-rose-950 font-black",
        SubscriptionStatus.Suspended => "bg-amber-400 text-amber-950 font-black",
        _ => "bg-slate-300 text-slate-900"
    };

    private string GetUsageTextColor(int percentage, bool isExceeded)
    {
        if (isExceeded || percentage >= 100) return "text-rose-600 dark:text-rose-400";
        if (percentage >= 80) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }

    private string GetUsageBarColor(int percentage, bool isExceeded)
    {
        if (isExceeded || percentage >= 100) return "bg-rose-500";
        if (percentage >= 80) return "bg-amber-500";
        return "bg-emerald-500";
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
