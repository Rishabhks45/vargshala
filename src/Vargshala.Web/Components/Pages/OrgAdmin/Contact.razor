@page "/contact"
@using Vargshala.Web.Components.UI.Badges
@using Vargshala.Web.Components.UI.Buttons
@using Vargshala.Web.Components.UI.Inputs
@rendermode InteractiveServer

<PageTitle>Contact & Support | Vargshala</PageTitle>

<div class="space-y-6 max-w-6xl mx-auto pb-10 transition-colors duration-200">
    
    <!-- Top Header & Live Dark Mode Demonstration -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 rounded-3xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-[#00796b] dark:text-teal-300 border border-teal-200 dark:border-teal-800/60 mb-2 shadow-2xs">
                <span>🎧 24/7 Institute Helpdesk</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Contact & Support Center
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Have questions regarding admissions, batch schedules, fees, or academic doubts? We are here to help.
            </p>
        </div>

        <!-- Live Theme Mode Switcher Box -->
        <div class="flex items-center gap-3 p-2 px-3.5 rounded-2xl bg-slate-50 dark:bg-[#18262c] border border-slate-200/80 dark:border-slate-700/60 shrink-0">
            <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Theme:</span>
            <button type="button" 
                    onclick="window.toggleAppTheme()" 
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-[#004D40] text-slate-800 dark:text-white border border-slate-200 dark:border-teal-600/50 text-xs font-extrabold shadow-2xs hover:shadow-xs transition-all cursor-pointer">
                <span class="block dark:hidden">🌙 Switch to Dark</span>
                <span class="hidden dark:block text-amber-300">☀️ Switch to Light</span>
            </button>
        </div>
    </div>

    <!-- 3 Quick Contact Info Cards (Light & Dark Mode) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        
        <!-- Card 1: Phone & WhatsApp -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-teal-300 dark:hover:border-teal-700 transition-all space-y-3 group">
            <div class="w-11 h-11 rounded-2xl bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300 flex items-center justify-center font-bold text-lg shadow-2xs group-hover:scale-105 transition-transform">
                📞
            </div>
            <div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">Call & WhatsApp Support</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Mon – Sat from 8:00 AM to 8:00 PM</p>
            </div>
            <div class="space-y-1 text-xs font-bold text-[#00796b] dark:text-teal-300 pt-1">
                <p>+91 98765 43210 (Toll Free)</p>
                <p>+91 91234 56789 (WhatsApp)</p>
            </div>
        </div>

        <!-- Card 2: Email & Helpdesk -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-teal-300 dark:hover:border-teal-700 transition-all space-y-3 group">
            <div class="w-11 h-11 rounded-2xl bg-purple-50 dark:bg-purple-950/80 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 flex items-center justify-center font-bold text-lg shadow-2xs group-hover:scale-105 transition-transform">
                ✉️
            </div>
            <div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">Email Inquiries</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Guaranteed 2-hour response time SLA</p>
            </div>
            <div class="space-y-1 text-xs font-bold text-purple-700 dark:text-purple-300 pt-1">
                <p>support@vargshala.com</p>
                <p>admissions@vargshala.com</p>
            </div>
        </div>

        <!-- Card 3: Head Campus Location -->
        <div class="p-5 rounded-2xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-teal-300 dark:hover:border-teal-700 transition-all space-y-3 group">
            <div class="w-11 h-11 rounded-2xl bg-amber-50 dark:bg-amber-950/80 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold text-lg shadow-2xs group-hover:scale-105 transition-transform">
                📍
            </div>
            <div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">Headquarters & Branches</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Open for in-person counseling</p>
            </div>
            <div class="text-xs text-slate-700 dark:text-slate-300 font-medium pt-1">
                <p class="font-bold">Main Campus — Patna</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Kankarbagh Main Rd, Bihar 800020</p>
            </div>
        </div>

    </div>

    <!-- Contact Form & FAQ Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left: Inquiry & Support Form (7 cols) -->
        <div class="lg:col-span-7 p-6 rounded-3xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-5">
            <div>
                <h2 class="text-base font-extrabold text-slate-900 dark:text-white">
                    Send a Message or Raise a Ticket
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Our academic coordinators and administration team will revert within 24 hours.
                </p>
            </div>

            @if (_formSubmitted)
            {
                <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 text-xs space-y-1">
                    <div class="flex items-center gap-2 font-bold text-sm text-emerald-800 dark:text-emerald-300">
                        <span>✓ Message Sent Successfully!</span>
                    </div>
                    <p>Ticket ID <strong>#VS-2026-981</strong> has been created. We have notified the support team.</p>
                    <button type="button" @onclick="() => _formSubmitted = false" class="text-emerald-700 dark:text-emerald-400 underline font-bold mt-2 cursor-pointer">
                        Send another message
                    </button>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubmit" class="space-y-4">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Your Full Name *</label>
                            <input type="text" 
                                   @bind="_contactName" 
                                   required 
                                   placeholder="e.g. Rishabh Sharma" 
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-medium transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Phone Number *</label>
                            <input type="tel" 
                                   @bind="_contactPhone" 
                                   required 
                                   placeholder="+91 90000 10001" 
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-medium transition-all" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Email Address</label>
                            <input type="email" 
                                   @bind="_contactEmail" 
                                   placeholder="student@example.com" 
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-medium transition-all" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Inquiry Category *</label>
                            <select @bind="_contactCategory" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:outline-none text-slate-900 dark:text-white font-medium cursor-pointer">
                                <option value="Academic Doubt">Academic Doubt / Faculty Help</option>
                                <option value="Fee Query">Fee Installment / Payment Receipt</option>
                                <option value="Admission Enquiry">New Admission / Batch Transfer</option>
                                <option value="App Issue">Mobile App / Portal Technical Support</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Message / Query Details *</label>
                        <textarea @bind="_contactMessage" 
                                  required 
                                  rows="4" 
                                  placeholder="Describe your question or requirement in detail..." 
                                  class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white font-medium transition-all"></textarea>
                    </div>

                    <button type="submit" 
                            class="inline-flex items-center justify-center gap-2 w-full py-3 px-6 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                        <span>Submit Inquiry Ticket</span>
                        <svg class="w-4 h-4 text-teal-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </button>

                </form>
            }
        </div>

        <!-- Right: FAQs & Emergency Helpdesk (5 cols) -->
        <div class="lg:col-span-5 space-y-5">
            
            <!-- Frequently Asked Questions -->
            <div class="p-6 rounded-3xl bg-white dark:bg-[#111c21] border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>💡 Frequently Asked Questions</span>
                </h3>

                <div class="space-y-3 text-xs">
                    
                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-[#18262c] border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                        <p class="font-bold text-slate-900 dark:text-white">How do I download my fee receipt?</p>
                        <p class="text-slate-500 dark:text-slate-400 text-[11.5px] leading-relaxed">Go to the **Students Directory**, select your profile, and click *Download Payment Receipt*.</p>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-[#18262c] border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                        <p class="font-bold text-slate-900 dark:text-white">How to ask doubts to batch teachers?</p>
                        <p class="text-slate-500 dark:text-slate-400 text-[11.5px] leading-relaxed">Use the **Messages & Teams** section to post questions directly in your batch channel.</p>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-[#18262c] border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                        <p class="font-bold text-slate-900 dark:text-white">Can parents track attendance online?</p>
                        <p class="text-slate-500 dark:text-slate-400 text-[11.5px] leading-relaxed">Yes, real-time SMS alerts and daily attendance percentages are available in the portal.</p>
                    </div>

                </div>
            </div>

            <!-- Emergency Examination Counseling Banner -->
            <div class="p-5 rounded-3xl bg-gradient-to-br from-[#004D40] to-[#00796b] text-white shadow-md space-y-3">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-xl bg-white/20 flex items-center justify-center font-bold text-sm">🎯</span>
                    <h4 class="text-xs font-extrabold uppercase tracking-wider text-teal-200">Exam Counseling Hotline</h4>
                </div>
                <p class="text-xs text-teal-50/90 leading-relaxed font-medium">
                    Stress-relief and academic revision guidance for upcoming Board & JEE/NEET aspirants.
                </p>
                <div class="pt-1">
                    <span class="inline-block px-3 py-1.5 rounded-xl bg-white text-[#004D40] font-extrabold text-xs shadow-xs">
                        Call Helpline: 1800-123-4567
                    </span>
                </div>
            </div>

        </div>

    </div>

</div>

@code {
    private string _contactName = string.Empty;
    private string _contactPhone = string.Empty;
    private string _contactEmail = string.Empty;
    private string _contactCategory = "Academic Doubt";
    private string _contactMessage = string.Empty;
    private bool _formSubmitted = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_contactName) || string.IsNullOrWhiteSpace(_contactPhone))
            return;

        _formSubmitted = true;
        _contactMessage = string.Empty;
    }
}
