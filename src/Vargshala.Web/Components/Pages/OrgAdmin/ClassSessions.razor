@code {
    private List<ClassSessionDto> _sessions = new();
    private List<BranchDto> _branches = new();
    private List<ClassLookupDto> _classes = new();
    private List<BatchDto> _batches = new();
    private List<TeacherDto> _teachers = new();

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isGenerating = false;
    private string _viewMode = "table";

    // Filtering State
    private readonly TableQueryState _query = new();
    private TableSortState _sortState => _query.SortState;
    private string _searchQuery = string.Empty;

    // CustomSelect Filter Options
    private List<CustomSelect.CustomSelectOption> _branchFilterOptions = new() { new("", "All Branches") };
    private List<CustomSelect.CustomSelectOption> _classFilterOptions = new() { new("", "All Classes") };
    private List<CustomSelect.CustomSelectOption> _batchFilterOptions = new() { new("", "All Batches") };
    private List<CustomSelect.CustomSelectOption> _teacherFilterOptions = new() { new("", "All Teachers") };
    private readonly List<CustomSelect.CustomSelectOption> _statusFilterOptions = new()
    {
        new("", "All Statuses"),
        new(ClassSessionStatusNames.Scheduled, "Scheduled"),
        new(ClassSessionStatusNames.Completed, "Completed"),
        new(ClassSessionStatusNames.Cancelled, "Cancelled"),
        new(ClassSessionStatusNames.Postponed, "Postponed")
    };

    // CustomSelect Drawer & Modal Options
    private List<CustomSelect.CustomSelectOption> _drawerBatchOptions = new();
    private List<CustomSelect.CustomSelectOption> _drawerTeacherOptions = new();
    private List<CustomSelect.CustomSelectOption> _generateTeacherOptions = new();
    private readonly List<CustomSelect.CustomSelectOption> _drawerStatusOptions = new()
    {
        new(ClassSessionStatusNames.Scheduled, "Scheduled"),
        new(ClassSessionStatusNames.Completed, "Completed"),
        new(ClassSessionStatusNames.Cancelled, "Cancelled"),
        new(ClassSessionStatusNames.Postponed, "Postponed")
    };
    private Guid? _selectedBranchId;
    private Guid? _selectedClassId;
    private Guid? _selectedBatchId;
    private Guid? _selectedTeacherId;
    private string? _selectedStatus;
    private int _totalRecords = 0;

    // Drawer state
    private bool _showAddEditModal = false;
    private bool _isDrawerOpen = false;
    private ClassSessionDto? _editingSession;
    private SessionFormModel _formModel = new();

    // Generate Modal state
    private bool _showGenerateModal = false;
    private GenerateFormModel _generateModel = new();

    // Details & Actions state
    private ClassSessionDto? _selectedSession;
    private ClassSessionDto? _completingSession;
    private string _completeTopic = string.Empty;
    private string _completeNotes = string.Empty;

    private ClassSessionDto? _cancellingSession;
    private string _cancelReason = string.Empty;

    private ClassSessionDto? _sessionToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadSessionsAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var branchTask = BranchService.GetAllActiveBranchesAsync();
            var classTask = ClassService.GetAllActiveClassesAsync();
            var batchTask = BatchService.GetAllActiveBatchesAsync();
            var teacherTask = TeacherService.GetTeachersPagedAsync(new PagedRequest { PageSize = 100 });

            await Task.WhenAll(branchTask, classTask, batchTask, teacherTask);

            if (branchTask.Result.Success && branchTask.Result.Data != null)
            {
                _branches = branchTask.Result.Data;
                _branchFilterOptions = new() { new("", "All Branches") };
                _branchFilterOptions.AddRange(_branches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)));
            }
            if (classTask.Result.Success && classTask.Result.Data != null)
            {
                _classes = classTask.Result.Data;
                _classFilterOptions = new() { new("", "All Classes") };
                _classFilterOptions.AddRange(_classes.Select(c => new CustomSelect.CustomSelectOption(c.Id.ToString(), c.Name)));
            }
            if (batchTask.Result.Success && batchTask.Result.Data != null)
            {
                _batches = batchTask.Result.Data;
                _batchFilterOptions = new() { new("", "All Batches") };
                _batchFilterOptions.AddRange(_batches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), b.Name)));
                _drawerBatchOptions = _batches.Select(b => new CustomSelect.CustomSelectOption(b.Id.ToString(), $"{b.Name} ({b.ClassName} - {b.SubjectName})")).ToList();
            }
            if (teacherTask.Result.Success && teacherTask.Result.Data != null)
            {
                _teachers = teacherTask.Result.Data.Items;
                _teacherFilterOptions = new() { new("", "All Teachers") };
                _teacherFilterOptions.AddRange(_teachers.Select(t => new CustomSelect.CustomSelectOption(t.Id.ToString(), t.FullName)));
                _drawerTeacherOptions = new() { new("", "-- No Teacher Assigned --") };
                _drawerTeacherOptions.AddRange(_teachers.Select(t => new CustomSelect.CustomSelectOption(t.Id.ToString(), $"{t.FullName} ({t.Department})")));
                _generateTeacherOptions = new() { new("", "-- Batch Primary Teacher --") };
                _generateTeacherOptions.AddRange(_teachers.Select(t => new CustomSelect.CustomSelectOption(t.Id.ToString(), $"{t.FullName} ({t.Department})")));
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error loading filter lookups: " + ex.Message);
        }
    }

    private async Task LoadSessionsAsync(int page = 1)
    {
        _isLoading = true;
        _query.PageNumber = page;

        try
        {
            var req = new PagedRequest
            {
                PageNumber = _query.PageNumber,
                PageSize = _query.PageSize,
                Search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim(),
                SortBy = _sortState.Column,
                SortDirection = _sortState.Direction == SortDirection.Descending ? "desc" : (_sortState.Direction == SortDirection.Ascending ? "asc" : null)
            };

            var res = await ClassSessionService.GetClassSessionsPagedAsync(
                req,
                _selectedBranchId,
                _selectedClassId,
                _selectedBatchId,
                _selectedTeacherId,
                null,
                null,
                _selectedStatus);

            if (res.Success && res.Data != null)
            {
                _sessions = res.Data.Items;
                _totalRecords = res.Data.TotalRecords;
            }
            else
            {
                _sessions.Clear();
                _totalRecords = 0;
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error fetching class sessions: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSortAsync(string column)
    {
        _sortState.Toggle(column);
        await LoadSessionsAsync(1);
    }

    private async Task HandlePageSizeChangedAsync(int size)
    {
        _query.PageSize = size;
        await LoadSessionsAsync(1);
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadSessionsAsync(1);
    }

    private async Task HandleBranchChanged(string val)
    {
        _selectedBranchId = string.IsNullOrWhiteSpace(val) ? null : Guid.Parse(val);
        await LoadSessionsAsync(1);
    }

    private async Task HandleClassChanged(string val)
    {
        _selectedClassId = string.IsNullOrWhiteSpace(val) ? null : Guid.Parse(val);
        await LoadSessionsAsync(1);
    }

    private async Task HandleBatchChanged(string val)
    {
        _selectedBatchId = string.IsNullOrWhiteSpace(val) ? null : Guid.Parse(val);
        await LoadSessionsAsync(1);
    }

    private async Task HandleTeacherChanged(string val)
    {
        _selectedTeacherId = string.IsNullOrWhiteSpace(val) ? null : Guid.Parse(val);
        await LoadSessionsAsync(1);
    }

    private async Task HandleStatusChanged(string val)
    {
        _selectedStatus = string.IsNullOrWhiteSpace(val) ? null : val;
        await LoadSessionsAsync(1);
    }

    private async Task ClearAllFilters()
    {
        _searchQuery = string.Empty;
        _selectedBranchId = null;
        _selectedClassId = null;
        _selectedBatchId = null;
        _selectedTeacherId = null;
        _selectedStatus = null;
        _sortState.Reset();
        await LoadSessionsAsync(1);
    }

    private async Task OpenAddDrawerAsync()
    {
        _editingSession = null;
        _formModel = new SessionFormModel
        {
            BatchId = _batches.FirstOrDefault()?.Id ?? Guid.Empty,
            SessionDate = DateOnly.FromDateTime(DateTime.Today),
            StartTime = DateTime.Today.AddHours(8),
            EndTime = DateTime.Today.AddHours(9),
            Status = ClassSessionStatusNames.Scheduled
        };

        _showAddEditModal = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(ClassSessionDto s)
    {
        _editingSession = s;
        _formModel = new SessionFormModel
        {
            Id = s.Id,
            BatchId = s.BatchId,
            TeacherId = s.TeacherId,
            SessionDate = s.SessionDate,
            StartTime = DateTime.Today.Add(s.StartTime.ToTimeSpan()),
            EndTime = DateTime.Today.Add(s.EndTime.ToTimeSpan()),
            Topic = s.Topic,
            Notes = s.Notes,
            Status = s.Status
        };

        _showAddEditModal = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(250);
        _showAddEditModal = false;
        _editingSession = null;
    }

    private async Task SaveSessionAsync()
    {
        _isSaving = true;
        try
        {
            var sTime = _formModel.StartTime.HasValue ? TimeOnly.FromDateTime(_formModel.StartTime.Value) : new TimeOnly(8, 0);
            var eTime = _formModel.EndTime.HasValue ? TimeOnly.FromDateTime(_formModel.EndTime.Value) : new TimeOnly(9, 0);

            if (_editingSession == null)
            {
                var req = new CreateClassSessionRequest
                {
                    BatchId = _formModel.BatchId,
                    TeacherId = _formModel.TeacherId,
                    SessionDate = _formModel.SessionDate,
                    StartTime = sTime,
                    EndTime = eTime,
                    Topic = _formModel.Topic,
                    Notes = _formModel.Notes
                };

                var res = await ClassSessionService.CreateClassSessionAsync(req);
                if (res.Success)
                {
                    Toast.Success("Class session created successfully.");
                    await CloseDrawerAsync();
                    await LoadSessionsAsync();
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to create session.");
                }
            }
            else
            {
                var req = new UpdateClassSessionRequest
                {
                    Id = _formModel.Id,
                    TeacherId = _formModel.TeacherId,
                    SessionDate = _formModel.SessionDate,
                    StartTime = sTime,
                    EndTime = eTime,
                    Topic = _formModel.Topic,
                    Notes = _formModel.Notes,
                    Status = _formModel.Status
                };

                var res = await ClassSessionService.UpdateClassSessionAsync(_formModel.Id, req);
                if (res.Success)
                {
                    Toast.Success("Class session updated successfully.");
                    await CloseDrawerAsync();
                    await LoadSessionsAsync();
                }
                else
                {
                    Toast.Error(res.Message ?? "Failed to update session.");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error saving session: " + ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenGenerateModal()
    {
        _generateModel = new GenerateFormModel
        {
            BatchId = _batches.FirstOrDefault()?.Id ?? Guid.Empty,
            StartDate = DateOnly.FromDateTime(DateTime.Today),
            EndDate = DateOnly.FromDateTime(DateTime.Today.AddDays(14))
        };
        _showGenerateModal = true;
    }

    private async Task GenerateSessionsAsync()
    {
        if (_generateModel.BatchId == Guid.Empty)
        {
            Toast.Warning("Please select a batch.");
            return;
        }

        _isGenerating = true;
        try
        {
            var req = new GenerateSessionsFromScheduleRequest
            {
                BatchId = _generateModel.BatchId,
                StartDate = _generateModel.StartDate,
                EndDate = _generateModel.EndDate,
                TeacherId = _generateModel.TeacherId
            };

            var res = await ClassSessionService.GenerateSessionsFromScheduleAsync(req);
            if (res.Success)
            {
                Toast.Success(res.Message ?? $"Generated {res.Data} sessions.");
                _showGenerateModal = false;
                await LoadSessionsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to generate sessions.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private void OpenSessionDetail(ClassSessionDto s)
    {
        _selectedSession = s;
    }

    private void OpenCompleteModal(ClassSessionDto s)
    {
        _completingSession = s;
        _completeTopic = s.Topic ?? string.Empty;
        _completeNotes = s.Notes ?? string.Empty;
    }

    private async Task SubmitCompleteSessionAsync()
    {
        if (_completingSession == null) return;
        try
        {
            var res = await ClassSessionService.CompleteClassSessionAsync(_completingSession.Id, new CompleteClassSessionRequest
            {
                Topic = _completeTopic,
                Notes = _completeNotes
            });

            if (res.Success)
            {
                Toast.Success("Session marked as completed.");
                _completingSession = null;
                await LoadSessionsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to complete session.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
    }

    private void OpenCancelModal(ClassSessionDto s)
    {
        _cancellingSession = s;
        _cancelReason = string.Empty;
    }

    private async Task SubmitCancelSessionAsync()
    {
        if (_cancellingSession == null) return;
        try
        {
            var res = await ClassSessionService.CancelClassSessionAsync(_cancellingSession.Id, new CancelClassSessionRequest
            {
                Reason = _cancelReason
            });

            if (res.Success)
            {
                Toast.Success("Session cancelled.");
                _cancellingSession = null;
                await LoadSessionsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to cancel session.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
    }

    private void ConfirmDelete(ClassSessionDto s)
    {
        _sessionToDelete = s;
    }

    private async Task DeleteSessionAsync()
    {
        if (_sessionToDelete == null) return;
        try
        {
            var res = await ClassSessionService.DeleteClassSessionAsync(_sessionToDelete.Id);
            if (res.Success)
            {
                Toast.Success("Session deleted successfully.");
                _sessionToDelete = null;
                await LoadSessionsAsync();
            }
            else
            {
                Toast.Error(res.Message ?? "Failed to delete session.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("Error: " + ex.Message);
        }
    }

    private void ExportCsv()
    {
        Toast.Info("Exporting class sessions directory to CSV...");
    }

    private string FormatSchedule(TimeOnly start, TimeOnly end)
    {
        return $"{start:HH:mm} - {end:HH:mm}";
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        ClassSessionStatusNames.Completed => "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80",
        ClassSessionStatusNames.Scheduled => "bg-teal-50 dark:bg-teal-950/60 text-[#009488] border border-teal-200/80",
        ClassSessionStatusNames.Cancelled => "bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200/80",
        ClassSessionStatusNames.Postponed => "bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/80",
        _ => "bg-slate-100 text-slate-600"
    };

    private string GetStatusDotClass(string status) => status switch
    {
        ClassSessionStatusNames.Completed => "bg-emerald-500",
        ClassSessionStatusNames.Scheduled => "bg-[#009488] animate-pulse",
        ClassSessionStatusNames.Cancelled => "bg-rose-500",
        ClassSessionStatusNames.Postponed => "bg-amber-500",
        _ => "bg-slate-400"
    };

    private string GetStatusTextColor(string status) => status switch
    {
        ClassSessionStatusNames.Completed => "text-emerald-600",
        ClassSessionStatusNames.Scheduled => "text-[#009488]",
        ClassSessionStatusNames.Cancelled => "text-rose-600",
        ClassSessionStatusNames.Postponed => "text-amber-600",
        _ => "text-slate-400"
    };

