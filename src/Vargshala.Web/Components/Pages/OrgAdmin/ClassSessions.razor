                        <span class="text-[10px] text-slate-400 block">Branch</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedSession.BranchName</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block">Faculty Assigned</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@(_selectedSession.TeacherName ?? "Unassigned")</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block">Status</span>
