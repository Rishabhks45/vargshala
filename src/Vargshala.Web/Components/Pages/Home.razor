@page "/"

<PageTitle>Dashboard | Vargshala</PageTitle>

<div class="space-y-6">
    
    <!-- Top Dashboard Header with Date Filter & Export Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Dashboard</h1>
            <p class="text-xs text-slate-500 mt-0.5">Welcome back, Rishabh!</p>
        </div>

        <div class="flex items-center gap-3">
            <!-- Date Range Selector Pill -->
            <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-tealborder shadow-sm text-xs font-medium text-slate-700 cursor-pointer hover:border-brand-400 transition-colors">
                <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>01 May, 2026 – 31 May, 2026</span>
                <svg class="w-3.5 h-3.5 text-slate-400 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>

            <!-- Coral Export Button (Matching Screenshot) -->
            <button class="btn-coral text-xs py-2 px-4 shadow-coral">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
                <span>Export</span>
            </button>
        </div>
    </div>

    <!-- 4 Key Metric Cards (Matching Screenshot) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Card 1: Total Students -->
        <div class="card-surface p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-sm shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold text-slate-700">Total Students</span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-slate-900 tracking-tight">1,248</span>
                <span class="text-xs font-bold text-emerald-600 flex items-center">
                    ↑ 12.5%
                </span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">from last month</p>
        </div>

        <!-- Card 2: Total Teachers -->
        <div class="card-surface p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-sm shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold text-slate-700">Total Teachers</span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-slate-900 tracking-tight">86</span>
                <span class="text-xs font-bold text-emerald-600 flex items-center">
                    ↑ 8.4%
                </span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">from last month</p>
        </div>

        <!-- Card 3: Total Classes -->
        <div class="card-surface p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-sm shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold text-slate-700">Total Classes</span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-slate-900 tracking-tight">64</span>
                <span class="text-xs font-bold text-emerald-600 flex items-center">
                    ↑ 11.3%
                </span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">from last month</p>
        </div>

        <!-- Card 4: Attendance -->
        <div class="card-surface p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shadow-sm shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold text-slate-700">Attendance</span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-slate-900 tracking-tight">92%</span>
                <span class="text-xs font-bold text-emerald-600 flex items-center">
                    ↑ 6.2%
                </span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">from last month</p>
        </div>

    </div>

    <!-- Middle Section: Attendance Chart + Recent Activities -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Attendance Overview Chart (8 cols) -->
        <div class="lg:col-span-7 card-surface p-6">
            <div class="flex items-center justify-between pb-4 border-b border-tealborder">
                <h2 class="font-bold text-base text-slate-800">Attendance Overview</h2>
                <div class="flex items-center gap-4 text-xs">
                    <span class="flex items-center gap-1.5 font-medium text-brand-700">
                        <span class="w-2.5 h-2.5 rounded-full bg-brand-600"></span>
                        This Month
                    </span>
                    <span class="flex items-center gap-1.5 text-slate-400">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                        Last Month
                    </span>
                </div>
            </div>

            <!-- Custom SVG Curved Line Chart Matching Theme 4 -->
            <div class="mt-6 relative h-64 w-full">
                <!-- Y-Axis Labels & Gridlines -->
                <div class="absolute inset-0 flex flex-col justify-between text-[11px] text-slate-400 select-none">
                    <div class="flex items-center gap-3">
                        <span class="w-8 text-right">100%</span>
                        <div class="flex-1 border-b border-slate-100"></div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-8 text-right">75%</span>
                        <div class="flex-1 border-b border-slate-100"></div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-8 text-right">50%</span>
                        <div class="flex-1 border-b border-slate-100"></div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-8 text-right">25%</span>
                        <div class="flex-1 border-b border-slate-100"></div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-8 text-right">0%</span>
                        <div class="flex-1 border-b border-slate-100"></div>
                    </div>
                </div>

                <!-- SVG Paths for Chart -->
                <svg class="absolute inset-0 w-full h-full pl-10 pb-5" viewBox="0 0 500 200" preserveAspectRatio="none">
                    <!-- Dotted Line for Last Month -->
                    <path d="M 10 160 Q 60 140 120 130 T 230 110 T 350 80 T 480 60" 
                          fill="none" 
                          stroke="#cbd5e1" 
                          stroke-width="2" 
                          stroke-dasharray="4,4" />

                    <!-- Solid Teal Line for This Month -->
                    <path d="M 10 150 Q 60 110 120 75 T 230 60 T 350 40 T 480 25" 
                          fill="none" 
                          stroke="#009488" 
                          stroke-width="3" />

                    <!-- Data Node Points -->
                    <circle cx="10" cy="150" r="4" fill="#009488" stroke="#fff" stroke-width="2" />
                    <circle cx="120" cy="75" r="4" fill="#009488" stroke="#fff" stroke-width="2" />
                    <circle cx="230" cy="60" r="4" fill="#009488" stroke="#fff" stroke-width="2" />
                    <circle cx="350" cy="40" r="4" fill="#009488" stroke="#fff" stroke-width="2" />
                    <circle cx="480" cy="25" r="4" fill="#009488" stroke="#fff" stroke-width="2" />
                </svg>

                <!-- X-Axis Labels -->
                <div class="absolute bottom-0 left-10 right-0 flex justify-between text-[10px] text-slate-400 select-none">
                    <span>01 May</span>
                    <span>08 May</span>
                    <span>15 May</span>
                    <span>22 May</span>
                    <span>29 May</span>
                </div>
            </div>
        </div>

        <!-- Recent Activities (5 cols) -->
        <div class="lg:col-span-5 card-surface p-6">
            <div class="flex items-center justify-between pb-4 border-b border-tealborder">
                <h2 class="font-bold text-base text-slate-800">Recent Activities</h2>
                <a href="activities" class="text-xs font-semibold text-brand-600 hover:underline">View All</a>
            </div>

            <div class="mt-4 space-y-4">
                
                <!-- Activity 1 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-800">New student added</p>
                            <p class="text-[11px] text-slate-500">Rahul Sharma</p>
                        </div>
                    </div>
                    <span class="text-[10px] text-slate-400 font-medium">2 min ago</span>
                </div>

                <!-- Activity 2 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-800">Assignment submitted</p>
                            <p class="text-[11px] text-slate-500">Class 10 - Maths</p>
                        </div>
                    </div>
                    <span class="text-[10px] text-slate-400 font-medium">1 hour ago</span>
                </div>

                <!-- Activity 3 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-800">Exam scheduled</p>
                            <p class="text-[11px] text-slate-500">Class 12 - Physics</p>
                        </div>
                    </div>
                    <span class="text-[10px] text-slate-400 font-medium">3 hours ago</span>
                </div>

                <!-- Activity 4 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-800">Fee payment received</p>
                            <p class="text-[11px] text-slate-500">Arjun Verma</p>
                        </div>
                    </div>
                    <span class="text-[10px] text-slate-400 font-medium">5 hours ago</span>
                </div>

            </div>
        </div>

    </div>

    <!-- Quick Links Section (6 Column Cards Matching Screenshot) -->
    <div class="card-surface p-6">
        <h2 class="font-bold text-base text-slate-800 mb-4">Quick Links</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            
            <!-- Quick Link 1: Students -->
            <a href="students" class="p-4 rounded-xl border border-tealborder hover:border-brand-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-teal-50 text-brand-600 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <p class="text-xs font-bold text-slate-800">Students</p>
                <p class="text-[10px] text-slate-400">Manage students</p>
            </a>

            <!-- Quick Link 2: Teachers -->
            <a href="teachers" class="p-4 rounded-xl border border-tealborder hover:border-emerald-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
