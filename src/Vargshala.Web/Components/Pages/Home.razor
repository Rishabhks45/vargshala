@page "/"

<PageTitle>Dashboard | Vargshala</PageTitle>

<div class="space-y-8">
    <!-- Welcome Header Banner -->
    <div class="relative overflow-hidden p-8 rounded-3xl bg-gradient-to-r from-brand-900 via-brand-700 to-violet-800 text-white shadow-soft-xl">
        <!-- Abstract Background Orbs -->
        <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-violet-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/2 -top-10 w-60 h-60 bg-brand-400/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="badge-emerald">● Live Session Active</span>
                    <span class="text-xs text-brand-200">Academic Year 2026-27</span>
                </div>
                <h1 class="text-3xl font-extrabold tracking-tight">
                    Welcome back, Rishabh! 👋
                </h1>
                <p class="mt-1 text-slate-200 text-sm max-w-xl">
                    Here's what is happening at <strong class="text-white">Vargshala Institute</strong> today. 4 batches are scheduled, and 12 fee payments were received.
                </p>
            </div>

            <div class="flex items-center gap-3">
                <button class="px-4 py-2.5 rounded-xl text-sm font-semibold bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/20 transition-all">
                    Generate Report
                </button>
                <button class="px-4 py-2.5 rounded-xl text-sm font-semibold bg-white text-brand-900 hover:bg-slate-100 shadow-lg hover:shadow-xl transition-all">
                    + Create Batch
                </button>
            </div>
        </div>
    </div>

    <!-- 4 Key Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1: Total Students -->
        <div class="glass-card p-6 rounded-2xl transition-transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Students</span>
                <div class="p-2.5 rounded-xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">1,248</span>
                <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center">
                    ↑ 12%
                </span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">vs last academic month</p>
        </div>

        <!-- Card 2: Active Batches -->
        <div class="glass-card p-6 rounded-2xl transition-transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Active Batches</span>
                <div class="p-2.5 rounded-xl bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">18</span>
                <span class="text-xs font-semibold text-brand-600 dark:text-brand-400">4 running today</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Class 9th - 12th & JEE/NEET</p>
        </div>

        <!-- Card 3: Fee Collection -->
        <div class="glass-card p-6 rounded-2xl transition-transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Fee Collection</span>
                <div class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">₹ 4.82 L</span>
                <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">92%</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Collected for current cycle</p>
        </div>

        <!-- Card 4: Faculty & Teachers -->
        <div class="glass-card p-6 rounded-2xl transition-transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Faculty & Staff</span>
                <div class="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">24</span>
                <span class="badge-emerald text-[10px] py-0.5">All Active</span>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">100% Attendance today</p>
        </div>
    </div>

    <!-- Bottom Section: Active Batches & Quick Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Today's Schedule & Batches (2 cols) -->
        <div class="lg:col-span-2 glass-card p-6 rounded-3xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 dark:border-slate-800/80">
                <div>
                    <h2 class="font-bold text-lg text-slate-900 dark:text-white">Today's Batch Schedule</h2>
                    <p class="text-xs text-slate-500">Live & upcoming classes for today</p>
                </div>
                <a href="batches" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">View All Batches →</a>
            </div>

            <div class="space-y-3">
                <!-- Batch Item 1 -->
                <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800/60">
                    <div class="flex items-center gap-4">
                        <div class="flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-brand-500/10 text-brand-600 font-bold text-xs">
                            <span>04:00</span>
                            <span class="text-[10px] font-normal text-slate-500">PM</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Physics - JEE Advanced (Batch Alpha)</h3>
                            <p class="text-xs text-slate-500">Room 102 • Dr. S. K. Verma • 42 Students</p>
                        </div>
                    </div>
                    <span class="badge-emerald">● In Progress</span>
                </div>

                <!-- Batch Item 2 -->
                <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800/60">
                    <div class="flex items-center gap-4">
                        <div class="flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-violet-500/10 text-violet-600 font-bold text-xs">
                            <span>05:30</span>
                            <span class="text-[10px] font-normal text-slate-500">PM</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Mathematics - Class 10th Foundation</h3>
                            <p class="text-xs text-slate-500">Room 105 • Prof. Amit Roy • 38 Students</p>
                        </div>
                    </div>
                    <span class="badge-brand">Upcoming</span>
                </div>

                <!-- Batch Item 3 -->
                <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800/60">
                    <div class="flex items-center gap-4">
                        <div class="flex flex-col items-center justify-center w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 font-bold text-xs">
                            <span>07:00</span>
                            <span class="text-[10px] font-normal text-slate-500">PM</span>
                        </div>
                        <div>
                            <h3 class="font-semibold text-sm text-slate-900 dark:text-white">Chemistry - NEET Special Revision</h3>
                            <p class="text-xs text-slate-500">Room 101 • Dr. Meera Sen • 55 Students</p>
                        </div>
                    </div>
                    <span class="badge-violet">Scheduled</span>
                </div>
            </div>
        </div>

        <!-- Quick Institute Actions (1 col) -->
        <div class="glass-card p-6 rounded-3xl space-y-4">
            <h2 class="font-bold text-lg text-slate-900 dark:text-white">Quick Actions</h2>
            <p class="text-xs text-slate-500">Frequent administrative tasks</p>

            <div class="space-y-2.5 pt-2">
                <button class="w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-200 dark:border-slate-700/60 hover:bg-brand-50/50 dark:hover:bg-brand-950/20 hover:border-brand-300 transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-brand-50 dark:bg-brand-950 text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Register Student</p>
                            <p class="text-xs text-slate-400">Enroll new student</p>
                        </div>
                    </div>
                    <span class="text-slate-400 group-hover:text-brand-600 transition-colors">→</span>
                </button>

                <button class="w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-200 dark:border-slate-700/60 hover:bg-emerald-50/50 dark:hover:bg-emerald-950/20 hover:border-emerald-300 transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Collect Fee</p>
                            <p class="text-xs text-slate-400">Issue receipt & invoice</p>
                        </div>
                    </div>
                    <span class="text-slate-400 group-hover:text-emerald-600 transition-colors">→</span>
                </button>

                <button class="w-full flex items-center justify-between p-3.5 rounded-xl border border-slate-200 dark:border-slate-700/60 hover:bg-violet-50/50 dark:hover:bg-violet-950/20 hover:border-violet-300 transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-violet-50 dark:bg-violet-950 text-violet-600 group-hover:bg-violet-600 group-hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Send Announcement</p>
                            <p class="text-xs text-slate-400">Broadcast SMS/App message</p>
                        </div>
                    </div>
                    <span class="text-slate-400 group-hover:text-violet-600 transition-colors">→</span>
                </button>
            </div>
        </div>
    </div>
</div>
