                <p class="text-xs font-bold text-slate-800">Teachers</p>
                <p class="text-[10px] text-slate-400">Manage teachers</p>
            </a>

            <!-- Quick Link 3: Classes -->
            <a href="batches" class="p-4 rounded-xl border border-tealborder hover:border-blue-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                </div>
                <p class="text-xs font-bold text-slate-800">Classes</p>
                <p class="text-[10px] text-slate-400">Manage classes</p>
            </a>

            <!-- Quick Link 4: Exams -->
            <a href="exams" class="p-4 rounded-xl border border-tealborder hover:border-purple-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                </div>
                <p class="text-xs font-bold text-slate-800">Exams</p>
                <p class="text-[10px] text-slate-400">Manage exams</p>
            </a>

            <!-- Quick Link 5: Fees -->
            <a href="fees" class="p-4 rounded-xl border border-tealborder hover:border-coral-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-coral-50 text-coral-500 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <p class="text-xs font-bold text-slate-800">Fees</p>
                <p class="text-[10px] text-slate-400">Manage fees</p>
            </a>

            <!-- Quick Link 6: Reports -->
            <a href="reports" class="p-4 rounded-xl border border-tealborder hover:border-amber-500 hover:shadow-md transition-all text-center group bg-white">
                <div class="w-11 h-11 mx-auto rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center group-hover:scale-105 transition-transform mb-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
