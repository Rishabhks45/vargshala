@page "/register-organization"
@page "/register"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Forms
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Contracts.Authentication
@using Vargshala.Contracts.Common
@using Vargshala.Web.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Register Institute | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto flex items-center justify-center h-full">

    @if (_isRegistered)
    {
        <!-- ========================================================================= -->
        <!-- SUCCESS REGISTRATION STATE (Theme 4 Deep Teal Glassmorphic Card) -->
        <!-- ========================================================================= -->
        <div class="w-full max-w-xl p-8 sm:p-10 rounded-3xl bg-[#004D40]/90 border border-teal-500/50 shadow-2xl backdrop-blur-2xl text-center space-y-6 animate-in zoom-in-95 duration-200 relative overflow-hidden">
            
            <!-- Ambient Glow -->
            <div class="absolute -top-16 -left-16 w-48 h-48 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-16 -right-16 w-48 h-48 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Animated Checkmark Badge -->
            <div class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-tr from-[#009488] to-emerald-500 text-white flex items-center justify-center shadow-lg shadow-teal-500/40 relative z-10">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
            </div>

            <div class="space-y-2 relative z-10">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-xs">
                    🎉 Institute Successfully Provisioned!
                </span>
                <h2 class="text-2xl font-extrabold text-white tracking-tight">Welcome to Vargshala</h2>
                <p class="text-xs text-teal-200/90">
                    <span class="font-bold text-white">@_model.OrganizationName</span> has been registered with organization code 
                    <span class="font-mono font-bold text-amber-300 bg-[#00382E] px-2 py-0.5 rounded-md border border-amber-500/30">@_model.OrganizationCode</span>.
                </p>
            </div>

            <!-- Credentials Snapshot -->
            <div class="p-4 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 text-left text-xs space-y-2.5 relative z-10 shadow-inner">
                <div class="flex justify-between items-center pb-2 border-b border-teal-800/80">
                    <span class="text-teal-300/80">Institute Name:</span>
                    <span class="font-bold text-white">@_model.OrganizationName</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-teal-800/80">
                    <span class="text-teal-300/80">Institute Code:</span>
                    <span class="font-mono font-bold text-amber-300">@_model.OrganizationCode</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-teal-800/80">
                    <span class="text-teal-300/80">Super Admin:</span>
                    <span class="font-bold text-white">@_model.AdminFirstName @_model.AdminLastName</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-teal-800/80">
                    <span class="text-teal-300/80">Login Email:</span>
                    <span class="font-bold text-emerald-400">@_model.AdminEmail</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-teal-300/80">Location & Session:</span>
                    <span class="font-semibold text-teal-100">@_model.City, @_model.State (@_model.AcademicSession)</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-col sm:flex-row gap-3 relative z-10">
                <button type="button" @onclick='() => Navigation.NavigateTo("/login")'
                        class="flex-1 py-3 px-5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-lg shadow-teal-500/25 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer flex items-center justify-center gap-2">
                    <span>Sign In to Dashboard</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </button>
                <button type="button" @onclick='() => Navigation.NavigateTo("/")'
                        class="px-5 py-3 rounded-xl bg-[#00382E] border border-teal-600/50 text-teal-200 text-xs font-bold hover:text-white hover:border-teal-400 transition-all cursor-pointer">
                    Home
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- 2-COLUMN REGISTER CARD (Unified with Login.razor Design System) -->
        <!-- ========================================================================= -->
        <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">

            <!-- ===================================================================== -->
            <!-- LEFT COLUMN: Educational Institute Showcase & Value Props -->
            <!-- ===================================================================== -->
            <div class="hidden lg:flex lg:col-span-5 flex-col justify-between relative rounded-3xl bg-[#004D40]/80 border border-teal-700/60 backdrop-blur-xl p-6 shadow-2xl overflow-hidden min-h-[520px]">
                
                <!-- Glowing Ambient Lights -->
                <div class="absolute -top-10 -left-10 w-60 h-60 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
                <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-[#FB6868]/20 rounded-full blur-3xl pointer-events-none"></div>

                <!-- Top Header with Institute Icon -->
                <div class="relative z-10 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-teal-300">
                            <svg class="w-5 h-5 text-[#2DD4BF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#00382E] text-amber-300 border border-amber-500/40">
                            ⚡ Instant Provisioning
                        </span>
                    </div>

                    <div>
                        <h2 class="text-xl font-extrabold text-white tracking-tight">Empower Your Coaching</h2>
                        <p class="text-xs text-teal-200/90 mt-1 leading-relaxed">
                            Join 450+ educational institutes using Vargshala for seamless student, batch, and fee administration.
                        </p>
                    </div>
                </div>

                <!-- Feature Pillars with Modern Badges -->
                <div class="relative z-10 space-y-3 my-auto py-2">
                    <div class="p-3 rounded-2xl bg-[#00382E]/80 border border-teal-600/40 flex items-start gap-3">
                        <div class="w-7 h-7 rounded-xl bg-teal-500/20 text-[#2DD4BF] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                            🏛️
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-white">Multi-Tenant Isolation</h4>
                            <p class="text-[10px] text-teal-200/80">Dedicated tenant data security with your unique institute code.</p>
                        </div>
                    </div>

                    <div class="p-3 rounded-2xl bg-[#00382E]/80 border border-teal-600/40 flex items-start gap-3">
                        <div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                            💳
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-white">Fee & Batch Automation</h4>
                            <p class="text-[10px] text-teal-200/80">Track student installments, receipts, and live batch rosters.</p>
                        </div>
                    </div>

                    <div class="p-3 rounded-2xl bg-[#00382E]/80 border border-teal-600/40 flex items-start gap-3">
                        <div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                            📊
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-white">Real-Time Attendance & SMS</h4>
                            <p class="text-[10px] text-teal-200/80">Instant parent notifications with daily attendance tracking.</p>
                        </div>
                    </div>
                </div>

                <!-- Bottom Telemetry Card -->
                <div class="relative z-10 p-3 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-xl backdrop-blur-md flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-xl bg-[#009488] text-white flex items-center justify-center text-xs font-bold shadow-md shrink-0">
                            🎓
                        </div>
                        <div>
                            <span class="text-[11px] font-bold text-white">Enterprise SLA</span>
                            <p class="text-[9px] text-teal-200">99.9% Uptime & Daily Backups</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[8px] font-bold bg-emerald-900/80 text-emerald-300 border border-emerald-500/50">
                        ● LIVE 24/7
                    </span>
                </div>

            </div>

            <!-- ===================================================================== -->
            <!-- RIGHT COLUMN: 2-Step Registration Glassmorphic Form Card -->
            <!-- ===================================================================== -->
            <div class="lg:col-span-7 w-full flex flex-col justify-between p-6 sm:p-7 rounded-3xl bg-[#004D40]/90 border border-teal-700/70 shadow-2xl backdrop-blur-2xl min-h-[520px]">
                
                <!-- Branding Header -->
                <div class="flex items-center justify-between pb-3 border-b border-teal-800/80">
                    <div class="flex items-center gap-2.5">
                        <img src="images/vargshala-logo.png" alt="Vargshala" class="w-9 h-9 rounded-full shadow-md object-contain" />
                        <div>
                            <h3 class="text-sm font-extrabold text-white tracking-tight">Register Institute</h3>
                            <p class="text-[10px] text-teal-200/80">Step @_currentStep of 2: @(_currentStep == 1 ? "Institute Profile" : "Admin Credentials")</p>
                        </div>
                    </div>

                    <!-- Step Pill Badges -->
                    <div class="flex items-center gap-1.5 text-[10px] font-bold">
                        <button type="button" @onclick="() => _currentStep = 1"
                                class="px-2.5 py-1 rounded-full transition-all cursor-pointer @(_currentStep == 1 ? "bg-[#009488] text-white shadow-xs" : "bg-[#00382E] text-teal-300 hover:text-white")">
                            1. Institute
                        </button>
                        <button type="button" @onclick="() => { if (ValidateStep1()) _currentStep = 2; }"
                                class="px-2.5 py-1 rounded-full transition-all cursor-pointer @(_currentStep == 2 ? "bg-[#009488] text-white shadow-xs" : "bg-[#00382E] text-teal-300 hover:text-white")">
                            2. Admin
                        </button>
                    </div>
                </div>

                <!-- Form Container with EditForm -->
                <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" class="flex-1 flex flex-col justify-between py-3 space-y-4">
                    <FluentValidationValidator />

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-3 rounded-2xl bg-rose-950/70 border border-rose-500/60 text-rose-200 text-xs font-semibold flex items-center gap-2 animate-in fade-in duration-150">
                            <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>@_errorMessage</span>
                        </div>
                    }

                    <!-- ============================================================= -->
                    <!-- STEP 1: INSTITUTE PROFILE -->
                    <!-- ============================================================= -->
                    @if (_currentStep == 1)
                    {
                        <div class="space-y-3.5 animate-in fade-in duration-150">
                            
                            <!-- Institute Name -->
                            <div>
                                <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                    Institute / Coaching Name <span class="text-[#FB6868]">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                    </div>
                                    <InputText @bind-Value="_model.OrganizationName"
                                               @bind-Value:after="OnInstituteNameChanged"
                                               placeholder="e.g. Apex Physics Classes"
                                               class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                </div>
                                <ValidationMessage For="@(() => _model.OrganizationName)" class="text-[10px] text-rose-300 mt-0.5" />
                            </div>

                            <!-- Institute Code & Academic Session Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="text-[11px] font-bold text-teal-100">
                                            Institute Code <span class="text-[#FB6868]">*</span>
                                        </label>
                                        <span class="text-[9px] text-teal-300/70 font-mono">Unique ID</span>
                                    </div>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60 font-bold text-xs">
                                            #
                                        </div>
                                        <InputText @bind-Value="_model.OrganizationCode"
                                                   @bind-Value:after="FilterCodeFormat"
                                                   placeholder="e.g. APEX01"
                                                   class="w-full pl-8 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-amber-300 font-mono font-bold uppercase placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.OrganizationCode)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="text-[11px] font-bold text-teal-100">
                                            Academic Session
                                        </label>
                                        <div class="flex items-center gap-1 text-[9px]">
                                            <button type="button" @onclick="() => _model.AcademicSession = SessionPrevCurrent"
                                                    class="px-1.5 py-0.5 rounded cursor-pointer transition-colors @(_model.AcademicSession == SessionPrevCurrent ? "bg-[#009488] text-white font-bold" : "bg-[#00382E] text-teal-300 hover:text-white")">
                                                @SessionPrevCurrent
                                            </button>
                                            <button type="button" @onclick="() => _model.AcademicSession = SessionCurrentNext"
                                                    class="px-1.5 py-0.5 rounded cursor-pointer transition-colors @(_model.AcademicSession == SessionCurrentNext ? "bg-[#009488] text-white font-bold" : "bg-[#00382E] text-teal-300 hover:text-white")">
                                                @SessionCurrentNext
                                            </button>
                                        </div>
                                    </div>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.AcademicSession"
                                                   placeholder="@SessionPrevCurrent"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                </div>
                            </div>

                            <!-- Official Email & Mobile Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Official Email <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.Email"
                                                   placeholder="contact@apexclasses.com"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.Email)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Contact Phone <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.Mobile"
                                                   placeholder="+91 9876543210"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.Mobile)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>
                            </div>

                            <!-- City, State & Pincode Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">City</label>
                                    <InputText @bind-Value="_model.City" placeholder="New Delhi"
                                               class="w-full px-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">State</label>
                                    <InputText @bind-Value="_model.State" placeholder="Delhi"
                                               class="w-full px-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">Pincode</label>
                                    <InputText @bind-Value="_model.Pincode" placeholder="110001"
                                               class="w-full px-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                </div>
                            </div>

                            <!-- Step 1 Button -->
                            <div class="pt-2">
                                <button type="button" @onclick="NextToStep2"
                                        class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-lg shadow-teal-500/25 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer flex items-center justify-center gap-2">
                                    <span>Continue to Admin Setup</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                </button>
                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- ============================================================= -->
                        <!-- STEP 2: ADMINISTRATOR CREDENTIALS -->
                        <!-- ============================================================= -->
                        <div class="space-y-3.5 animate-in fade-in duration-150">
                            
                            <!-- Admin Name Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Admin First Name <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <InputText @bind-Value="_model.AdminFirstName"
                                               placeholder="Rishabh"
                                               class="w-full px-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    <ValidationMessage For="@(() => _model.AdminFirstName)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Admin Last Name <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <InputText @bind-Value="_model.AdminLastName"
                                               placeholder="Sharma"
                                               class="w-full px-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    <ValidationMessage For="@(() => _model.AdminLastName)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>
                            </div>

                            <!-- Admin Email & Admin Mobile Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Admin Login Email <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.AdminEmail"
                                                   placeholder="admin@apexclasses.com"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.AdminEmail)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Admin Mobile
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.AdminMobile"
                                                   placeholder="+91 9876543210"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                </div>
                            </div>

                            <!-- Password & Confirm Password Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Password <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.Password"
                                                   type="@(_showPassword ? "text" : "password")"
                                                   placeholder="••••••••"
                                                   class="w-full pl-9 pr-8 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                        <button type="button" @onclick="() => _showPassword = !_showPassword"
                                                class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-teal-300/60 hover:text-white cursor-pointer">
                                            @if (_showPassword)
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            }
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => _model.Password)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-teal-100 mb-1">
                                        Confirm Password <span class="text-[#FB6868]">*</span>
                                    </label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-teal-300/60">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                        </div>
                                        <InputText @bind-Value="_model.ConfirmPassword"
                                                   type="@(_showPassword ? "text" : "password")"
                                                   placeholder="••••••••"
                                                   class="w-full pl-9 pr-3 py-2 rounded-xl bg-[#00382E]/90 border border-teal-600/50 text-white placeholder-teal-300/40 text-xs focus:border-[#2DD4BF] focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all shadow-inner" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.ConfirmPassword)" class="text-[10px] text-rose-300 mt-0.5" />
                                </div>
                            </div>

                            <!-- Terms & Conditions Checkbox -->
                            <div class="pt-1">
                                <label class="flex items-center gap-2 cursor-pointer select-none">
                                    <InputCheckbox @bind-Value="_model.AcceptTerms"
                                                   class="w-4 h-4 rounded-md bg-[#00382E] border-teal-600 text-[#009488] focus:ring-teal-500/30" />
                                    <span class="text-[11px] text-teal-200">
                                        I agree to the <a href="#" class="text-amber-300 hover:underline">Terms of Service</a> and <a href="#" class="text-amber-300 hover:underline">Privacy Policy</a>
                                    </span>
                                </label>
                                <ValidationMessage For="@(() => _model.AcceptTerms)" class="text-[10px] text-rose-300 mt-0.5" />
                            </div>

                            <!-- Buttons: Back and Submit -->
                            <div class="flex items-center gap-3 pt-2">
                                <button type="button" @onclick="() => _currentStep = 1"
                                        class="px-4 py-2.5 rounded-xl bg-[#00382E] border border-teal-600/50 text-teal-200 text-xs font-bold hover:text-white hover:border-teal-400 transition-all cursor-pointer">
                                    ← Back
                                </button>
                                <button type="submit" disabled="@_isSubmitting"
                                        class="flex-1 py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-lg shadow-teal-500/25 hover:from-[#00a89a] hover:to-[#00897b] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50">
                                    @if (_isSubmitting)
                                    {
                                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>Provisioning Institute...</span>
                                    }
                                    else
                                    {
                                        <span>Complete Registration 🚀</span>
                                    }
                                </button>
                            </div>

                        </div>
                    }
                </EditForm>

                <!-- Footer Sign-In Redirect -->
                <div class="pt-3 border-t border-teal-800/80 text-center">
                    <p class="text-[11px] text-teal-200/80">
                        Already have an Institute Account?
                        <a href="/login" class="font-bold text-amber-300 hover:text-white hover:underline ml-1">
                            Sign In to Vargshala →
                        </a>
                    </p>
                </div>

            </div>

        </div>
    }

</div>

@code {
    private static readonly int CurrentYear = DateTime.Now.Year;
    private static readonly string SessionPrevCurrent = $"{CurrentYear - 1}-{CurrentYear}";
    private static readonly string SessionCurrentNext = $"{CurrentYear}-{CurrentYear + 1}";

    private readonly RegisterOrganizationRequest _model = new()
    {
        AcademicSession = $"{DateTime.Now.Year - 1}-{DateTime.Now.Year}"
    };

    private int _currentStep = 1;
    private bool _showPassword = false;
    private bool _isSubmitting = false;
    private bool _isRegistered = false;
    private string? _errorMessage;

    private void OnInstituteNameChanged()
    {
        // Suggest clean uppercase code if empty
        if (string.IsNullOrWhiteSpace(_model.OrganizationCode) && !string.IsNullOrWhiteSpace(_model.OrganizationName))
        {
            var words = _model.OrganizationName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (words.Length == 1)
            {
                _model.OrganizationCode = words[0].Substring(0, Math.Min(6, words[0].Length)).ToUpperInvariant();
            }
            else
            {
                var acr = string.Concat(words.Select(w => char.ToUpperInvariant(w[0])));
                _model.OrganizationCode = acr.Length < 3 ? (acr + "01") : acr;
            }
        }
    }

    private void FilterCodeFormat()
    {
        if (!string.IsNullOrWhiteSpace(_model.OrganizationCode))
        {
            _model.OrganizationCode = _model.OrganizationCode.ToUpperInvariant().Trim();
        }
    }

    private bool ValidateStep1()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.OrganizationName) || _model.OrganizationName.Length < 3)
        {
            _errorMessage = "Institute name must be at least 3 characters.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_model.OrganizationCode) || _model.OrganizationCode.Length < 2)
        {
            _errorMessage = "Institute code must be at least 2 characters (letters/numbers).";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_model.Email) || !_model.Email.Contains('@'))
        {
            _errorMessage = "Please provide a valid institute email address.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_model.Mobile))
        {
            _errorMessage = "Please enter an institute contact number.";
            return false;
        }

        return true;
    }

    private void NextToStep2()
    {
        if (ValidateStep1())
        {
            _currentStep = 2;
        }
    }

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;

        if (!ValidateStep1())
        {
            _currentStep = 1;
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.AdminFirstName) || string.IsNullOrWhiteSpace(_model.AdminLastName))
        {
            _errorMessage = "Please provide Admin First and Last Name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.AdminEmail) || !_model.AdminEmail.Contains('@'))
        {
            _errorMessage = "Please provide a valid Admin Email address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Password) || _model.Password.Length < 6)
        {
            _errorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (_model.Password != _model.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        if (!_model.AcceptTerms)
        {
            _errorMessage = "You must agree to the Terms of Service to register.";
            return;
        }

        _isSubmitting = true;

        try
        {
            // Call real backend API
            var response = await AuthService.RegisterOrganizationAsync(_model);

            if (response.Success)
            {
                _isRegistered = true;
            }
            else
            {
                _errorMessage = response.Message ?? "Registration failed. Please check the entered information.";
                if (response.Errors is { Count: > 0 })
                {
                    _errorMessage += " (" + string.Join(", ", response.Errors) + ")";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Unexpected error: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
