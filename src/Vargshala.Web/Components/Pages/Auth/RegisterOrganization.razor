@page "/register-organization"
@page "/register"
@page "/signup"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Forms
@using Vargshala.Web.Components.UI.Validation
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Contracts.Authentication
@using Vargshala.Contracts.Common
@using Vargshala.Web.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Register Institute | Vargshala</PageTitle>

<!-- Fullscreen Seamless Light Canvas (No Page Scroll, Fits 100vh Screen) -->
<div class="fixed inset-0 z-30 h-screen w-screen overflow-hidden bg-[#F8FCFA] text-slate-800 selection:bg-[#004D40] selection:text-white flex flex-col">
    
    <div class="h-full w-full grid grid-cols-1 lg:grid-cols-12 relative overflow-hidden">

        <!-- ========================================================================= -->
        <!-- LEFT COLUMN: Seamless Form (Compact, No Page Scroll, Matched Input Height)-->
        <!-- ========================================================================= -->
        <div class="lg:col-span-5 xl:col-span-5 flex flex-col justify-between px-6 sm:px-10 lg:px-12 xl:px-14 py-4 lg:py-5 z-10 h-full overflow-y-auto" style="scrollbar-width: none; -ms-overflow-style: none;">
            
            <div class="w-full max-w-md mx-auto flex flex-col justify-between h-full">

                <!-- Top Brand Logo -->
                <div class="flex items-center justify-between shrink-0">
                    <a href="/" class="flex items-center gap-2.5">
                        <img src="images/Logo.svg" alt="Vargshala" class="w-9 h-9 object-contain" />
                        <div class="flex flex-col leading-tight">
                            <span class="text-lg font-extrabold text-[#004D40] tracking-tight">Varg<span class="text-[#009488]">shala</span></span>
                            <span class="text-[9px] text-teal-700/80 font-semibold tracking-wider">Institute SaaS</span>
                        </div>
                    </a>

                    <!-- Switch to Login button -->
                    <button type="button" 
                            @onclick="NavigateToLogin" 
                            class="text-xs font-semibold text-[#004D40] hover:text-[#009488] hover:underline cursor-pointer bg-transparent border-0 p-0 focus:outline-none">
                        ← Sign In
                    </button>
                </div>

                <!-- Center Form Area -->
                <div class="my-auto py-2 w-full">

                @if (_isRegistered)
                {
                    <!-- ===== SUCCESS STATE ===== -->
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-[#EDF8F4] border border-teal-200 flex items-center justify-center text-[#009488] shadow-xs">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>

                        <div class="space-y-1">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#EDF8F4] text-[#004D40] border border-teal-200 shadow-2xs">
                                🎉 Institute Successfully Provisioned!
                            </span>
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2E27] tracking-tight">
                                Welcome to Vargshala
                            </h1>
                            <p class="text-xs text-slate-500 font-normal leading-relaxed">
                                <strong class="text-[#004D40]">@_model.OrganizationName</strong> has been registered with organization code 
                                <span class="font-mono font-bold text-[#009488] bg-[#EDF8F4] px-1.5 py-0.5 rounded text-xs border border-teal-200">@_model.OrganizationCode</span>.
                            </p>
                        </div>

                        <!-- Credentials Snapshot -->
                        <div class="p-3.5 rounded-xl bg-[#EDF8F4] border border-teal-100 text-left text-xs space-y-2">
                            <div class="flex justify-between items-center pb-1.5 border-b border-teal-200/60">
                                <span class="text-slate-500 text-[11px]">Institute Name:</span>
                                <span class="font-bold text-[#004D40]">@_model.OrganizationName</span>
                            </div>
                            <div class="flex justify-between items-center pb-1.5 border-b border-teal-200/60">
                                <span class="text-slate-500 text-[11px]">Institute Code:</span>
                                <span class="font-mono font-bold text-[#009488]">@_model.OrganizationCode</span>
                            </div>
                            <div class="flex justify-between items-center pb-1.5 border-b border-teal-200/60">
                                <span class="text-slate-500 text-[11px]">Super Admin:</span>
                                <span class="font-bold text-[#004D40]">@_model.AdminFirstName @_model.AdminLastName</span>
                            </div>
                            <div class="flex justify-between items-center pb-1.5 border-b border-teal-200/60">
                                <span class="text-slate-500 text-[11px]">Login Email:</span>
                                <span class="font-bold text-[#009488]">@_model.AdminEmail</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-slate-500 text-[11px]">Location & Session:</span>
                                <span class="font-semibold text-slate-700">@_model.City, @_model.State (@_model.AcademicSession)</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-2.5 pt-1">
                            <button type="button" @onclick="NavigateToLogin"
                                    class="flex-1 py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md cursor-pointer flex items-center justify-center gap-2 hover:shadow-lg">
                                <span>Sign In to Dashboard →</span>
                            </button>
                            <button type="button" @onclick='() => Navigation.NavigateTo("/")'
                                    class="px-4 py-2.5 rounded-full bg-white border border-slate-200 text-slate-600 text-xs font-bold hover:text-[#004D40] hover:border-teal-300 transition-all cursor-pointer">
                                Home
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ===== REGISTRATION FORM ===== -->

                    <!-- Heading -->
                    <div class="space-y-1 mb-2 text-center">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2E27] tracking-tight">
                            Register Institute
                        </h1>
                        <p class="text-xs text-slate-500 font-normal leading-snug">
                            Step @_currentStep of 2: @(_currentStep == 1 ? "Provide your organization details" : "Set up super administrator credentials")
                        </p>
                    </div>

                    <!-- Center Segmented Tabs -->
                    <div class="flex justify-center mb-3">
                        <div class="inline-flex p-1 bg-[#EDF8F4] rounded-full border border-teal-200/70 shadow-2xs w-full max-w-[280px]">
                            <button type="button" @onclick="() => _currentStep = 1"
                                    class="flex-1 py-1.5 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer text-center flex items-center justify-center gap-1.5 @(_currentStep == 1 ? "bg-[#004D40] text-white shadow-xs" : "text-[#004D40] hover:bg-teal-100/70")">
                                <span class="w-4 h-4 rounded-full text-[10px] flex items-center justify-center font-black @(_currentStep == 1 ? "bg-white/20 text-white" : "bg-teal-600/10 text-[#004D40]")">1</span>
                                <span>Profile</span>
                            </button>
                            <button type="button" @onclick="() => { if (ValidateStep1()) _currentStep = 2; }"
                                    class="flex-1 py-1.5 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer text-center flex items-center justify-center gap-1.5 @(_currentStep == 2 ? "bg-[#004D40] text-white shadow-xs" : "text-[#004D40] hover:bg-teal-100/70")">
                                <span class="w-4 h-4 rounded-full text-[10px] flex items-center justify-center font-black @(_currentStep == 2 ? "bg-white/20 text-white" : "bg-teal-600/10 text-[#004D40]")">2</span>
                                <span>Admin</span>
                            </button>
                        </div>
                    </div>

                    <!-- Form -->
                    <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" class="space-y-2.5">
                        <FluentValidationValidator />

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold flex items-center gap-2">
                                <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span class="leading-tight">@_errorMessage</span>
                            </div>
                        }

                        <!-- ============================================================= -->
                        <!-- STEP 1: INSTITUTE PROFILE                                     -->
                        <!-- ============================================================= -->
                        @if (_currentStep == 1)
                        {
                            <div class="space-y-2.5">
                                
                                <!-- Institute Name -->
                                <div class="space-y-1">
                                    <label class="block text-[11px] font-bold text-slate-700">
                                        Institute / Coaching Name <span class="text-rose-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                        </span>
                                        <InputText @bind-Value="_model.OrganizationName"
                                                   @bind-Value:after="OnInstituteNameChanged"
                                                   placeholder="e.g. Apex Physics Classes"
                                                   class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.OrganizationName)" class="text-[10px] text-rose-500 font-semibold" />
                                </div>

                                <!-- Institute Code & Academic Session Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <div class="flex items-center justify-between">
                                            <label class="text-[11px] font-bold text-slate-700">
                                                Institute Code <span class="text-rose-500">*</span>
                                            </label>
                                            <span class="text-[9px] text-slate-400 font-mono">Unique ID</span>
                                        </div>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600 font-bold text-xs">
                                                #
                                            </span>
                                            <InputText @bind-Value="_model.OrganizationCode"
                                                       @bind-Value:after="FilterCodeFormat"
                                                       placeholder="e.g. APEX01"
                                                       class="w-full py-2 pl-8 pr-3 text-xs font-mono font-bold uppercase bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-[#004D40] placeholder-slate-400 transition-all shadow-2xs" />
                                        </div>
                                        <ValidationMessage For="@(() => _model.OrganizationCode)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>

                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Academic Session <span class="text-rose-500">*</span>
                                        </label>
                                        <CustomSelect Value="@_model.AcademicSession"
                                                      ValueChanged="@(val => _model.AcademicSession = val)"
                                                      Options="_sessionOptions"
                                                      Placeholder="Select Session"
                                                      Class="w-full"
                                                      TriggerClass="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl text-slate-800 font-medium transition-all shadow-2xs flex items-center justify-between" />
                                    </div>
                                </div>

                                <!-- Official Email (Single Full Width Row) -->
                                <div class="space-y-1">
                                    <label class="block text-[11px] font-bold text-slate-700">
                                        Official Email <span class="text-rose-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                                        </span>
                                        <InputText @bind-Value="_model.Email"
                                                   placeholder="contact@apexclasses.com"
                                                   class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                    </div>
                                    <ValidationMessage For="@(() => _model.Email)" class="text-[10px] text-rose-500 font-semibold" />
                                </div>

                                <!-- Contact Phone & City Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Contact Phone <span class="text-rose-500">*</span>
                                        </label>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                            </span>
                                            <InputText @bind-Value="_model.Mobile"
                                                       placeholder="+91 9876543210"
                                                       class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                        </div>
                                        <ValidationMessage For="@(() => _model.Mobile)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>

                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">City</label>
                                        <InputText @bind-Value="_model.City" placeholder="New Delhi"
                                                   class="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                    </div>
                                </div>

                                <!-- State & Pincode Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">State</label>
                                        <InputText @bind-Value="_model.State" placeholder="Delhi"
                                                   class="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                    </div>
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">Pincode</label>
                                        <InputText @bind-Value="_model.Pincode" placeholder="110001"
                                                   class="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                    </div>
                                </div>

                                <!-- Step 1 Continue Button -->
                                <div class="pt-1.5">
                                    <button type="button" @onclick="NextToStep2"
                                            class="w-full py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg">
                                        <span>Continue to Admin Setup</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                    </button>
                                </div>

                            </div>
                        }
                        else
                        {
                            <!-- ============================================================= -->
                            <!-- STEP 2: ADMINISTRATOR CREDENTIALS                            -->
                            <!-- ============================================================= -->
                            <div class="space-y-2.5">
                                
                                <!-- Admin Name Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Admin First Name <span class="text-rose-500">*</span>
                                        </label>
                                        <InputText @bind-Value="_model.AdminFirstName"
                                                   placeholder="Rishabh"
                                                   class="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                        <ValidationMessage For="@(() => _model.AdminFirstName)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Admin Last Name <span class="text-rose-500">*</span>
                                        </label>
                                        <InputText @bind-Value="_model.AdminLastName"
                                                   placeholder="Sharma"
                                                   class="w-full py-2 px-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                        <ValidationMessage For="@(() => _model.AdminLastName)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>
                                </div>

                                <!-- Admin Email & Admin Mobile Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Admin Login Email <span class="text-rose-500">*</span>
                                        </label>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>
                                            </span>
                                            <InputText @bind-Value="_model.AdminEmail"
                                                       placeholder="admin@apexclasses.com"
                                                       class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                        </div>
                                        <ValidationMessage For="@(() => _model.AdminEmail)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>

                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Admin Mobile
                                        </label>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                            </span>
                                            <InputText @bind-Value="_model.AdminMobile"
                                                       placeholder="+91 9876543210"
                                                       class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Password & Confirm Password Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Password <span class="text-rose-500">*</span>
                                        </label>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                            </span>
                                            @if (_showPassword)
                                            {
                                                <InputText type="text"
                                                           @bind-Value="_model.Password"
                                                           placeholder="••••••••"
                                                           class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                            }
                                            else
                                            {
                                                <InputText type="password"
                                                           @bind-Value="_model.Password"
                                                           placeholder="••••••••"
                                                           class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                            }
                                            <button type="button" 
                                                    @onclick="TogglePasswordVisibility"
                                                    @onclick:preventDefault="true"
                                                    class="absolute inset-y-0 right-0 flex items-center pr-3 z-20 cursor-pointer text-slate-400 hover:text-slate-600 transition-colors"
                                                    tabindex="-1">
                                                @if (_showPassword)
                                                {
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                    </svg>
                                                }
                                            </button>
                                        </div>
                                        <ValidationMessage For="@(() => _model.Password)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>

                                    <div class="space-y-1">
                                        <label class="block text-[11px] font-bold text-slate-700">
                                            Confirm Password <span class="text-rose-500">*</span>
                                        </label>
                                        <div class="relative">
                                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                            </span>
                                            @if (_showPassword)
                                            {
                                                <InputText type="text"
                                                           @bind-Value="_model.ConfirmPassword"
                                                           placeholder="••••••••"
                                                           class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                            }
                                            else
                                            {
                                                <InputText type="password"
                                                           @bind-Value="_model.ConfirmPassword"
                                                           placeholder="••••••••"
                                                           class="w-full py-2 pl-9 pr-3 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                            }
                                        </div>
                                        <ValidationMessage For="@(() => _model.ConfirmPassword)" class="text-[10px] text-rose-500 font-semibold" />
                                    </div>
                                </div>

                                <!-- Terms & Conditions Checkbox -->
                                <div class="pt-0.5">
                                    <label class="flex items-center gap-2 cursor-pointer select-none">
                                        <InputCheckbox @bind-Value="_model.AcceptTerms"
                                                       class="w-3.5 h-3.5 rounded text-[#004D40] border-slate-300 focus:ring-[#004D40]" />
                                        <span class="text-[11px] text-slate-600">
                                            I agree to the <a href="#" class="text-[#004D40] font-semibold hover:underline">Terms of Service</a> and <a href="#" class="text-[#004D40] font-semibold hover:underline">Privacy Policy</a>
                                        </span>
                                    </label>
                                    <ValidationMessage For="@(() => _model.AcceptTerms)" class="text-[10px] text-rose-500 font-semibold" />
                                </div>

                                <!-- Buttons: Back and Submit -->
                                <div class="flex items-center gap-2.5 pt-1.5">
                                    <button type="button" @onclick="() => _currentStep = 1"
                                            class="px-4 py-2.5 rounded-full bg-white border border-slate-200 text-slate-600 text-xs font-bold hover:text-[#004D40] hover:border-teal-300 transition-all cursor-pointer">
                                        ← Back
                                    </button>
                                    <button type="submit" disabled="@_isSubmitting"
                                            class="flex-1 py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg disabled:opacity-50">
                                        @if (_isSubmitting)
                                        {
                                            <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                            <span>Provisioning Institute...</span>
                                        }
                                        else
                                        {
                                            <span>Complete Registration 🚀</span>
                                        }
                                    </button>
                                </div>

                            </div>
                        }
                    </EditForm>

                    <!-- Footer Sign-In Redirect -->
                    <div class="pt-2 text-center">
                        <p class="text-[11px] text-slate-500">
                            Already have an Institute Account?
                            <button type="button" @onclick="NavigateToLogin" 
                                    class="font-bold text-[#004D40] hover:text-[#009488] hover:underline ml-1 bg-transparent border-0 p-0 cursor-pointer focus:outline-none">
                                Sign In to Vargshala →
                            </button>
                        </p>
                    </div>
                }

            </div>
        </div>
    </div>

        <!-- ========================================================================= -->
        <!-- RIGHT COLUMN: Organic Mint Canvas with Online Learning SVG & Quote        -->
