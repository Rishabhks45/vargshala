@page "/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Vargshala.Contracts.Authentication
@using Vargshala.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Vargshala.Web.Components.UI.Validation
@inject IAuthService AuthService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Create New Password | Vargshala</PageTitle>

<!-- Fullscreen Seamless Light Canvas (No Page Scroll, Fits 100vh Screen) -->
<div class="fixed inset-0 z-30 h-screen w-screen overflow-hidden bg-[#F8FCFA] text-slate-800 selection:bg-[#004D40] selection:text-white flex flex-col">
    
    <div class="h-full w-full grid grid-cols-1 lg:grid-cols-12 relative overflow-hidden">

        <!-- ========================================================================= -->
        <!-- LEFT COLUMN: Completely Seamless Form (Compact, No Page Scroll)           -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-5 xl:col-span-5 flex flex-col justify-between px-6 sm:px-10 lg:px-12 xl:px-14 py-4 lg:py-5 z-10 h-full overflow-y-auto" style="scrollbar-width: none; -ms-overflow-style: none;">
            
            <div class="w-full max-w-md mx-auto flex flex-col justify-between h-full">

                <!-- Top Brand Logo -->
                <div class="flex items-center justify-between shrink-0">
                    <a href="/" class="flex items-center gap-2.5">
                        <img src="images/Logo.svg" alt="Vargshala" class="w-9 h-9 object-contain" />
                        <div class="flex flex-col leading-tight">
                            <span class="text-lg font-extrabold text-[#004D40] tracking-tight">Varg<span class="text-[#009488]">shala</span></span>
                            <span class="text-[9px] text-teal-700/80 font-semibold tracking-wider">Institute SaaS</span>
                        </div>
                    </a>

                    <!-- Switch to Login button -->
                    <button type="button" 
                            @onclick="NavigateToLogin" 
                            class="text-xs font-semibold text-[#004D40] hover:text-[#009488] hover:underline cursor-pointer bg-transparent border-0 p-0 focus:outline-none">
                        ← Back to Login
                    </button>
                </div>

                <!-- Center Form Area -->
                <div class="my-auto py-2 w-full">

                @if (_isSuccess)
                {
                    <!-- Success State -->
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-[#EDF8F4] border border-teal-200 flex items-center justify-center text-[#009488] shadow-xs">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>

                        <div class="space-y-1">
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2E27] tracking-tight">
                                Password Updated!
                            </h1>
                            <p class="text-xs text-slate-500 font-normal leading-relaxed">
                                Your password has been changed successfully. You will be redirected to the sign-in screen.
                            </p>
                        </div>

                        <button type="button"
                                @onclick="NavigateToLogin"
                                class="w-full py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg">
                            <span>Sign In Now →</span>
                        </button>
                    </div>
                }
                else if (_isInvalidLink || _tokenExpired)
                {
                    <!-- Invalid/Expired Link State -->
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-500 shadow-xs">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                        </div>

                        <div class="space-y-1">
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2E27] tracking-tight">
                                @(_tokenExpired ? "Link Expired" : "Invalid Reset Link")
                            </h1>
                            <p class="text-xs text-slate-500 font-normal leading-relaxed">
                                @if (_tokenExpired)
                                {
                                    <span>Security links are single-use and expire after 30 minutes. This link has either already been used or has expired.</span>
                                }
                                else
                                {
                                    <span>This link is incomplete or missing a valid token. Please request a new recovery link.</span>
                                }
                            </p>
                        </div>

                        <a href="forgot-password" 
                           class="w-full py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg no-underline">
                            <span>Request New Link →</span>
                        </a>
                    </div>
                }
                else
                {
                    <!-- Heading -->
                    <div class="space-y-1.5 mb-4">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0B2E27] tracking-tight">
                            Set New Password
                        </h1>
                        <p class="text-xs text-slate-500 font-normal leading-snug">
                            Create a strong and secure password for your account.
                        </p>
                    </div>

                    <!-- Reset Password Form -->
                    <EditForm Model="@_resetModel" OnValidSubmit="HandleResetPassword" class="space-y-3">
                        <FluentValidationValidator />

                        @if (!string.IsNullOrWhiteSpace(_resetModel.Email))
                        {
                            <div class="p-2.5 rounded-xl bg-[#EDF8F4] border border-teal-100 flex items-center justify-between">
                                <span class="text-[10px] uppercase font-semibold text-teal-700 tracking-wider">Account:</span>
                                <span class="text-xs font-semibold text-[#004D40] truncate max-w-[200px]">@_resetModel.Email</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs flex items-center gap-2">
                                <svg class="w-4 h-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>@_errorMessage</span>
                            </div>
                        }

                        <!-- New Password Input -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-bold text-slate-700">
                                New Password
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                    </svg>
                                </span>
                                @if (_showNewPassword)
                                {
                                    <InputText type="text" 
                                               @bind-Value="_resetModel.NewPassword" 
                                               placeholder="Minimum 8 characters"
                                               class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                }
                                else
                                {
                                    <InputText type="password" 
                                               @bind-Value="_resetModel.NewPassword" 
                                               placeholder="Minimum 8 characters"
                                               class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                }
                                <button type="button" 
                                        @onclick="ToggleNewPasswordVisibility"
                                        @onclick:preventDefault="true"
                                        class="absolute inset-y-0 right-0 flex items-center pr-3 z-20 cursor-pointer text-slate-400 hover:text-slate-600 transition-colors"
                                        tabindex="-1">
                                    @if (_showNewPassword)
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _resetModel.NewPassword)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>

                        <!-- Confirm Password Input -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-bold text-slate-700">
                                Confirm New Password
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                    </svg>
                                </span>
                                @if (_showConfirmPassword)
                                {
                                    <InputText type="text" 
                                               @bind-Value="_resetModel.ConfirmPassword" 
                                               placeholder="Re-type your password"
                                               class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                }
                                else
                                {
                                    <InputText type="password" 
                                               @bind-Value="_resetModel.ConfirmPassword" 
                                               placeholder="Re-type your password"
                                               class="w-full py-2 pl-9 pr-9 text-xs bg-white border border-slate-200 rounded-xl focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 placeholder-slate-400 font-medium transition-all shadow-2xs" />
                                }
                                <button type="button" 
                                        @onclick="ToggleConfirmPasswordVisibility"
                                        @onclick:preventDefault="true"
                                        class="absolute inset-y-0 right-0 flex items-center pr-3 z-20 cursor-pointer text-slate-400 hover:text-slate-600 transition-colors"
                                        tabindex="-1">
                                    @if (_showConfirmPassword)
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _resetModel.ConfirmPassword)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>

                        <!-- Security Callout -->
                        <p class="text-[11px] text-slate-500 leading-snug">
                            🔒 <strong>Single-use token:</strong> This link will be permanently invalidated as soon as your new password is saved.
                        </p>

                        <!-- Primary Pill Button -->
                        <button type="submit" 
                                disabled="@_isLoading"
                                class="w-full py-2.5 rounded-full font-bold text-xs text-white bg-[#004D40] hover:bg-[#00382E] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg mt-2">
                            @if (_isLoading)
                            {
                                <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Updating Password...</span>
                            }
                            else
                            {
                                <span>Confirm & Reset Password →</span>
                            }
                        </button>
                    </EditForm>
                }

                    <!-- Footer Sign-In Redirect -->
                    <div class="pt-3 text-center">
                        <p class="text-[11px] text-slate-500">
                            Already have an Institute Account?
                            <button type="button" @onclick="NavigateToLogin" 
                                    class="font-bold text-[#004D40] hover:text-[#009488] hover:underline ml-1 bg-transparent border-0 p-0 cursor-pointer focus:outline-none">
                                Sign In to Vargshala →
                            </button>
                        </p>
                    </div>

                </div>

            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- RIGHT COLUMN: Organic Mint Canvas with Online Learning SVG & Quote        -->
        <!-- ========================================================================= -->
        <div class="hidden lg:flex lg:col-span-7 xl:col-span-7 flex-col items-center justify-center relative px-6 py-6 h-full overflow-hidden">
            
            <!-- Large Organic Mint Fluid Background Shape -->
            <div class="absolute inset-y-4 right-5 left-3 rounded-[3rem] bg-[#EDF8F4] -z-0 pointer-events-none"></div>

            <!-- Floating Clean Mint Circles -->
            <div class="absolute inset-y-4 right-5 left-3 rounded-[3rem] overflow-hidden pointer-events-none z-0">
                <div class="auth-bubble w-28 h-28 top-8 left-10" style="animation: floatBubble1 8s ease-in-out infinite;"></div>
                <div class="auth-bubble w-20 h-20 bottom-24 right-14" style="animation: floatBubble2 10s ease-in-out 1s infinite;"></div>
                <div class="auth-bubble w-14 h-14 top-1/4 right-8" style="animation: floatBubble3 7s ease-in-out 2s infinite;"></div>
                <div class="auth-bubble w-24 h-24 bottom-1/3 left-6" style="animation: floatBubble1 11s ease-in-out 3s infinite;"></div>
                <div class="auth-bubble w-12 h-12 top-16 right-32" style="animation: floatBubble2 6.5s ease-in-out 0.5s infinite;"></div>
                <div class="auth-bubble w-16 h-16 top-2/3 right-10" style="animation: floatBubble3 9s ease-in-out 2.5s infinite;"></div>
                <div class="auth-bubble w-9 h-9 bottom-12 left-28" style="animation: floatBubble2 6s ease-in-out 1.5s infinite;"></div>
            </div>

            <!-- Decorative Floating Sparkles -->
            <div class="absolute top-12 right-20 text-teal-600/40 text-base pointer-events-none z-10">✦</div>
            <div class="absolute bottom-16 left-12 text-teal-600/40 text-xs pointer-events-none z-10">✦</div>
            <div class="absolute top-1/3 left-8 text-teal-600/30 text-xs pointer-events-none z-10">✚</div>

            <!-- Center Educational SVG Illustration Showcase -->
            <div class="relative z-10 w-full flex flex-col items-center justify-center my-auto max-w-lg xl:max-w-xl">
                <object data="images/online-learning.svg?v=3" 
                        type="image/svg+xml" 
                        class="w-full max-h-[100vh] object-contain pointer-events-none drop-shadow-[0_15px_30px_rgba(0,77,64,0.06)]">
                </object>
            </div>

            <!-- Quote & Accent Underline Bar -->
            <div class="absolute bottom-8 inset-x-0 z-10 text-center space-y-2 pointer-events-none">
                <p class="text-xs sm:text-sm font-semibold italic text-[#0B2E27] tracking-wide">
                    "Simplifying Institute Management, Amplifying Education."
                </p>
                <div class="w-12 h-1 bg-[#F59E0B] rounded-full mx-auto shadow-2xs"></div>
            </div>

        </div>

    </div>

</div>

<style>
    .auth-bubble {
        position: absolute;
        border-radius: 9999px;
        background: #80D8CB;
        opacity: 0.85;
        pointer-events: none;
    }
    @@keyframes floatBubble1 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        33% {
            transform: translateY(-22px) translateX(12px) scale(1.05);
        }
        66% {
            transform: translateY(-38px) translateX(-10px) scale(0.96);
        }
    }
    @@keyframes floatBubble2 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        40% {
            transform: translateY(-30px) translateX(-14px) scale(1.06);
        }
        75% {
            transform: translateY(-12px) translateX(10px) scale(0.95);
        }
    }
    @@keyframes floatBubble3 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        50% {
            transform: translateY(-26px) translateX(16px) scale(1.08);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetPasswordRequest _resetModel = new();
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private bool _isLoading = false;
    private bool _isSuccess = false;
    private bool _isInvalidLink = false;
    private bool _tokenExpired = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _isInvalidLink = true;
            return;
        }

        _resetModel.Token = Token.Trim();

        if (!string.IsNullOrWhiteSpace(Email))
        {
            _resetModel.Email = Email.Trim();
        }
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleNewPasswordVisibility()
    {
        _showNewPassword = !_showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        _showConfirmPassword = !_showConfirmPassword;
    }

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.ResetPasswordAsync(_resetModel);

            if (response.Success)
            {
                _isSuccess = true;
                NotificationService.Success("Password reset successfully! Redirecting...", "Success");
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var msg = response.Message ?? "Failed to reset password.";
                _errorMessage = msg;
                NotificationService.Error(msg, "Reset Failed");

                if (msg.Contains("expired", StringComparison.OrdinalIgnoreCase) ||
                    msg.Contains("invalid", StringComparison.OrdinalIgnoreCase) ||
                    msg.Contains("already been used", StringComparison.OrdinalIgnoreCase))
                {
                    _tokenExpired = true;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred: " + ex.Message;
            NotificationService.Error(_errorMessage, "Error");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
