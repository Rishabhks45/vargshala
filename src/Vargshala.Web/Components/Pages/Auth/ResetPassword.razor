@page "/reset-password"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Create New Password | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto flex items-center justify-center h-full">
    
    <!-- Unified 2-Column Responsive Card Shell -->
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- ========================================================================= -->
        <!-- LEFT COLUMN: Security Showcase with Plant & Books PNG -->
        <!-- ========================================================================= -->
        <div class="hidden lg:flex lg:col-span-7 flex-col justify-between relative rounded-3xl bg-[#004D40]/80 border border-teal-700/60 backdrop-blur-xl p-6 shadow-2xl overflow-hidden min-h-[460px]">
            
            <!-- Ambient Glowing Background Lights -->
            <div class="absolute -top-10 -left-10 w-60 h-60 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
            <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-[#FB6868]/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Background Dotted Trajectory Curves -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" xmlns="http://www.w3.org/2000/svg">
                <path d="M 40 100 Q 180 20 380 80 T 480 220" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="6,6" class="animate-dash-flow" />
                <path d="M 60 320 Q 200 380 420 290" fill="none" stroke="#fb6868" stroke-width="2" stroke-dasharray="6,6" />
            </svg>

            <!-- Top Floating Shields -->
            <div class="flex items-center justify-between relative z-10 w-full">
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-teal-300 animate-float-slow">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div class="p-2.5 rounded-2xl bg-gradient-to-tr from-[#FB6868] to-amber-500 text-white shadow-lg animate-plane-fly">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                </div>
            </div>

            <!-- Center Plant & Books Illustration with Soft Glow -->
            <div class="relative flex flex-col items-center justify-center my-auto py-2 group z-10">
                <div class="absolute inset-0 bg-[#009488]/25 rounded-full blur-2xl group-hover:bg-[#14B8A6]/35 transition-all"></div>
                <img src="images/plant-books.png" 
                     alt="Secure Password" 
                     class="w-56 h-48 object-contain relative drop-shadow-[0_15px_30px_rgba(0,148,136,0.35)]" />
            </div>

            <!-- Bottom Security Advice -->
            <div class="p-3 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-xl backdrop-blur-md relative z-10">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-xs shadow-md shrink-0">
                        🛡️
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-white">Password Security Guidelines</p>
                        <p class="text-[9px] text-teal-200">Use at least 8 characters with a mix of numbers, symbols, and letters.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- RIGHT COLUMN: Reset Password Form Card -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-5 w-full flex flex-col justify-between p-6 sm:p-7 rounded-3xl bg-[#004D40]/90 border border-teal-700/70 shadow-2xl backdrop-blur-2xl min-h-[460px]">
            
            <!-- Branding Header -->
            <div class="text-center space-y-1">
                <img src="images/vargshala-logo.png" alt="Vargshala" class="w-14 h-14 rounded-full shadow-xl mb-1 mx-auto drop-shadow-md object-contain" />
                <h2 class="text-xl font-extrabold text-white tracking-tight">
                    Set New Password
                </h2>
                <p class="text-[11px] text-teal-200">
                    Create a strong and secure password for your account
                </p>
            </div>

            <!-- Form -->
            <EditForm Model="@_resetModel" OnValidSubmit="HandleResetPassword" class="space-y-3.5 my-auto py-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-2 rounded-xl bg-rose-950/70 border border-rose-700 text-rose-200 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="p-2.5 rounded-xl bg-emerald-950/80 border border-emerald-600 text-emerald-200 text-[11px] flex items-center gap-2">
                        <svg class="w-4 h-4 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>@_successMessage</span>
                    </div>
                }

                <!-- New Password Input -->
                <div class="space-y-1">
                    <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                        New Password
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input type="@(_showNewPassword ? "text" : "password")" 
                               @bind="_resetModel.NewPassword" 
                               placeholder="Minimum 8 characters"
                               class="w-full py-2 pl-9 pr-9 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                        <button type="button" 
                                @onclick="() => _showNewPassword = !_showNewPassword"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-teal-400 hover:text-white">
                            @if (_showNewPassword)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _resetModel.NewPassword)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Confirm Password Input -->
                <div class="space-y-1">
                    <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                        Confirm New Password
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </span>
                        <input type="@(_showConfirmPassword ? "text" : "password")" 
                               @bind="_resetModel.ConfirmPassword" 
                               placeholder="Re-type password"
                               class="w-full py-2 pl-9 pr-9 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                        <button type="button" 
                                @onclick="() => _showConfirmPassword = !_showConfirmPassword"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-teal-400 hover:text-white">
                            @if (_showConfirmPassword)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _resetModel.ConfirmPassword)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        disabled="@_isLoading"
                        class="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-[#009488] hover:bg-[#0f766e] transition-all shadow-[0_8px_20px_-4px_rgba(0,148,136,0.5)] flex items-center justify-center gap-2">
                    @if (_isLoading)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Updating Password...</span>
                    }
                    else
                    {
                        <span>Confirm & Reset Password →</span>
                    }
                </button>
            </EditForm>

            <!-- Back to Sign In Link -->
            <div class="pt-3 border-t border-teal-800/80 text-center">
                <a href="login" class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-teal-200 hover:text-white transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    <span>Back to Sign In</span>
                </a>
            </div>

        </div>

    </div>

</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetPasswordRequest _resetModel = new();
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private bool _isLoading = false;
    private string? _errorMessage;
    private string? _successMessage;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            _resetModel.Email = Email;
        }
        if (!string.IsNullOrEmpty(Token))
        {
            _resetModel.Token = Token;
        }
        else
        {
            _resetModel.Token = "demo-security-token-2026";
        }
    }

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await Task.Delay(900);
            _successMessage = "Password successfully reset! Redirecting to login...";
            await Task.Delay(1000);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = "Password reset failed: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
