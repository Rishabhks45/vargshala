@page "/login"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Sign In | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center h-full max-h-full">
    
    <!-- ========================================================================= -->
    <!-- LEFT COLUMN: Theme 4 Educational Showcase with Plant & Books PNG -->
    <!-- ========================================================================= -->
    <div class="hidden lg:flex lg:col-span-7 flex-col justify-center relative">
        
        <!-- Glowing Ambient Lights in background -->
        <div class="absolute top-4 left-4 w-60 h-60 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
        <div class="absolute bottom-4 right-4 w-60 h-60 bg-[#FB6868]/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Illustration Canvas Container (Compact Proportional Height: 440px) -->
        <div class="relative w-full h-[430px] bg-[#004D40]/80 rounded-3xl border border-teal-700/60 backdrop-blur-xl p-6 overflow-hidden shadow-2xl flex flex-col items-center justify-center">
            
            <!-- Background Dotted Trajectory Curves -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-25" xmlns="http://www.w3.org/2000/svg">
                <path d="M 40 120 Q 180 30 380 90 T 480 250" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="6,6" class="animate-dash-flow" />
                <path d="M 60 340 Q 200 400 420 310" fill="none" stroke="#fb6868" stroke-width="2" stroke-dasharray="6,6" />
            </svg>

            <!-- Floating Target Badge -->
            <div class="absolute top-6 left-6 p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-teal-300 animate-float-slow">
                <svg class="w-5 h-5 text-[#14B8A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                    <circle cx="12" cy="12" r="6" stroke-width="2"></circle>
                    <circle cx="12" cy="12" r="2" stroke-width="2"></circle>
                </svg>
            </div>

            <!-- Flying Paper Plane (Coral Accent) -->
            <div class="absolute top-8 right-8 p-2.5 rounded-2xl bg-gradient-to-tr from-[#FB6868] to-amber-500 text-white shadow-lg animate-plane-fly">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </div>

            <!-- Central Hero: Plant & Books PNG with Glowing Halo -->
            <div class="relative flex flex-col items-center justify-center animate-float-medium group">
                <div class="absolute -inset-4 bg-[#009488]/30 rounded-full blur-2xl group-hover:bg-[#14B8A6]/40 transition-all"></div>
                <img src="images/plant-books.png" 
                     alt="Vargshala Learning" 
                     class="w-64 h-56 object-contain relative drop-shadow-[0_20px_35px_rgba(0,148,136,0.35)]" />
            </div>

            <!-- Floating Top Card: Live Batch Active -->
            <div class="absolute bottom-6 left-6 p-3 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-2xl backdrop-blur-md flex items-center gap-2.5 animate-float-reverse">
                <div class="w-8 h-8 rounded-xl bg-amber-400 text-slate-900 font-bold flex items-center justify-center text-xs shadow-md">
                    📚
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-[11px] font-bold text-white">Vidya Mandir</span>
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[8px] font-bold bg-emerald-900/80 text-emerald-300 border border-emerald-500/50">
                            ● LIVE
                        </span>
                    </div>
                    <p class="text-[10px] text-teal-200">64 Batches • 1,248 Students</p>
                </div>
            </div>

            <!-- Floating Right Card: Attendance & Performance -->
            <div class="absolute bottom-6 right-6 p-3 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-2xl backdrop-blur-md flex items-center gap-2.5 animate-float-slow">
                <div class="w-8 h-8 rounded-xl bg-[#009488] text-white flex items-center justify-center text-xs shadow-md font-bold">
                    📈
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-[11px] font-bold text-white">Attendance Rate</span>
                        <span class="text-[9px] font-bold text-emerald-400">↑ 92%</span>
                    </div>
                    <p class="text-[10px] text-teal-200">Real-Time Institute Sync</p>
                </div>
            </div>

        </div>

        <!-- Institute Highlight Metrics Footer (Theme 4 Style) -->
        <div class="grid grid-cols-3 gap-3 mt-3">
            <div class="py-2 px-3 rounded-xl bg-[#00382E]/60 border border-teal-800/60 text-center">
                <p class="text-sm font-bold text-white">99.9%</p>
                <p class="text-[10px] text-teal-200/80">Cloud Uptime</p>
            </div>
            <div class="py-2 px-3 rounded-xl bg-[#00382E]/60 border border-teal-800/60 text-center">
                <p class="text-sm font-bold text-[#14B8A6]">Multi-Tenant</p>
                <p class="text-[10px] text-teal-200/80">Org Data Security</p>
            </div>
            <div class="py-2 px-3 rounded-xl bg-[#00382E]/60 border border-teal-800/60 text-center">
                <p class="text-sm font-bold text-[#FB6868]">Instant Sync</p>
                <p class="text-[10px] text-teal-200/80">Batch & Fees</p>
            </div>
        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- RIGHT COLUMN: Theme 4 Teal Glassmorphic Login Form Card -->
    <!-- ========================================================================= -->
    <div class="lg:col-span-5 w-full max-w-md mx-auto">
        <div class="p-6 sm:p-7 rounded-3xl bg-[#004D40]/90 border border-teal-700/70 shadow-2xl backdrop-blur-2xl">
            
            <!-- Branding Header with Golden Logo -->
            <div class="text-center space-y-1 mb-4">
                <div class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-amber-400 text-slate-900 font-extrabold text-xl shadow-lg mb-1">
                    <svg class="w-6 h-6 text-teal-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <h2 class="text-xl font-extrabold text-white tracking-tight">
                    Welcome to Vargshala
                </h2>
                <p class="text-[11px] text-teal-200">
                    Sign in to manage your coaching institute
                </p>
            </div>

            <!-- Login Form (Theme 4 Inputs & Actions) -->
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="space-y-3.5 mt-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-2.5 rounded-xl bg-rose-950/70 border border-rose-700 text-rose-200 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="p-2.5 rounded-xl bg-emerald-950/70 border border-emerald-700 text-emerald-200 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>@_successMessage</span>
                    </div>
                }

                <!-- Email Input -->
                <div class="space-y-1">
                    <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                        Email Address
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206"/>
                            </svg>
                        </span>
                        <InputText @bind-Value="_loginModel.Email" 
                                   placeholder="name@institute.com"
                                   class="w-full py-2 pl-9 pr-3 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Email)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Password Input -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                            Password
                        </label>
                        <a href="#" class="text-[11px] font-medium text-[#14B8A6] hover:text-white hover:underline">
                            Forgot?
                        </a>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input type="@(_showPassword ? "text" : "password")" 
                               @bind="_loginModel.Password" 
                               placeholder="••••••••"
                               class="w-full py-2 pl-9 pr-9 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                        <button type="button" 
                                @onclick="TogglePasswordVisibility"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-teal-400 hover:text-white">
                            @if (_showPassword)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Remember Me Checkbox -->
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="rememberMe" class="w-3.5 h-3.5 rounded text-[#009488] bg-[#00382E] border-teal-600 focus:ring-[#009488]" />
                    <label for="rememberMe" class="text-[11px] text-teal-200/90 cursor-pointer">
                        Remember this device for 30 days
                    </label>
                </div>

                <!-- Submit Button (Theme 4 Teal / Coral Action Button) -->
                <button type="submit" 
                        disabled="@_isLoading"
                        class="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-[#009488] hover:bg-[#0f766e] transition-all shadow-[0_8px_20px_-4px_rgba(0,148,136,0.5)] flex items-center justify-center gap-2">
                    @if (_isLoading)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Authenticating...</span>
                    }
                    else
                    {
                        <span>Sign In to Dashboard →</span>
                    }
                </button>
            </EditForm>

            <!-- Register Organization Footer Link -->
            <div class="mt-4 pt-3 border-t border-teal-800/80 text-center">
                <p class="text-[11px] text-teal-200/80">
                    New Institute?
                    <a href="register" class="font-bold text-amber-300 hover:text-white hover:underline ml-1">
                        Register Organization
                    </a>
                </p>
            </div>

        </div>
    </div>

</div>

@code {
    private readonly LoginRequest _loginModel = new()
    {
        Email = "rishabh.admin@vargshala.com",
        Password = "Admin@12345"
    };

    private bool _showPassword = false;
    private bool _isLoading = false;
    private string? _errorMessage;
    private string? _successMessage;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await Task.Delay(800);
            _successMessage = "Login successful! Redirecting to Dashboard...";
            await Task.Delay(500);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = "Authentication failed: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
