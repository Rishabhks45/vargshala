@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Vargshala.Web.Services
@inject IAuthService AuthService
@inject INotificationService NotificationService
@rendermode InteractiveServer

<PageTitle>Sign In | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto flex items-center justify-center h-full">
    
    <!-- Unified 2-Column Responsive Card Shell (Matching Heights & Zero Clipping) -->
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- ========================================================================= -->
        <!-- LEFT COLUMN: Theme 4 Educational Showcase with Plant & Books PNG -->
        <!-- ========================================================================= -->
        <div class="hidden lg:flex lg:col-span-7 flex-col justify-between relative rounded-3xl bg-[#004D40]/80 border border-teal-700/60 backdrop-blur-xl p-6 shadow-2xl overflow-hidden min-h-[440px]">
            
            <!-- Glowing Ambient Background Lights -->
            <div class="absolute -top-10 -left-10 w-60 h-60 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
            <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-[#FB6868]/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Background Dotted Trajectory Curves -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" xmlns="http://www.w3.org/2000/svg">
                <path d="M 40 100 Q 180 20 380 80 T 480 220" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="6,6" class="animate-dash-flow" />
                <path d="M 60 320 Q 200 380 420 290" fill="none" stroke="#fb6868" stroke-width="2" stroke-dasharray="6,6" />
            </svg>

            <!-- Top Row Floating Badges -->
            <div class="flex items-center justify-between relative z-10 w-full">
                <!-- Target Icon -->
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-teal-300 animate-float-slow">
                    <svg class="w-4 h-4 text-[#14B8A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                        <circle cx="12" cy="12" r="6" stroke-width="2"></circle>
                        <circle cx="12" cy="12" r="2" stroke-width="2"></circle>
                    </svg>
                </div>

                <!-- Paper Airplane -->
                <div class="p-2.5 rounded-2xl bg-gradient-to-tr from-[#FB6868] to-amber-500 text-white shadow-lg animate-plane-fly">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                </div>
            </div>

            <!-- Center Plant & Books Illustration with Soft Glow -->
            <div class="relative flex flex-col items-center justify-center my-auto py-2 group z-10">
                <div class="absolute inset-0 bg-[#009488]/25 rounded-full blur-2xl group-hover:bg-[#14B8A6]/35 transition-all"></div>
                <img src="images/plant-books.png" 
                     alt="Vargshala Learning" 
                     class="w-56 h-48 object-contain relative drop-shadow-[0_15px_30px_rgba(0,148,136,0.35)]" />
            </div>

            <!-- Bottom Floating Telemetry Badges -->
            <div class="grid grid-cols-2 gap-3 relative z-10 w-full">
                <!-- Live Class Telemetry -->
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-xl backdrop-blur-md flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-amber-400 text-slate-900 font-bold flex items-center justify-center text-xs shadow-md shrink-0">
                        📚
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-1">
                            <span class="text-[11px] font-bold text-white truncate">Vidya Mandir</span>
                            <span class="inline-flex items-center px-1 py-0.2 rounded text-[7px] font-bold bg-emerald-900/80 text-emerald-300 border border-emerald-500/50 shrink-0">
                                ● LIVE
                            </span>
                        </div>
                        <p class="text-[9px] text-teal-200 truncate">64 Batches • 1,248 Students</p>
                    </div>
                </div>

                <!-- Attendance Rate Telemetry -->
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-xl backdrop-blur-md flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-[#009488] text-white flex items-center justify-center text-xs shadow-md font-bold shrink-0">
                        📈
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-1">
                            <span class="text-[11px] font-bold text-white">Attendance</span>
                            <span class="text-[9px] font-bold text-emerald-400">↑ 92%</span>
                        </div>
                        <p class="text-[9px] text-teal-200 truncate">Real-Time Institute Sync</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- RIGHT COLUMN: Theme 4 Teal Glassmorphic Login Form Card -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-5 w-full flex flex-col justify-between p-6 sm:p-7 rounded-3xl bg-[#004D40]/90 border border-teal-700/70 shadow-2xl backdrop-blur-2xl min-h-[440px]">
            
            <!-- Branding Header with Vargshala Logo -->
            <div class="text-center space-y-1">
                <img src="images/vargshala-logo.png" alt="Vargshala" class="w-14 h-14 rounded-full shadow-xl mb-1 mx-auto drop-shadow-md object-contain" />
                <h2 class="text-xl font-extrabold tracking-tight">
                    <span class="text-white">Welcome to </span><span class="text-white">Varg</span><span class="text-[#2DD4BF]">shala</span>
                </h2>
                <p class="text-[11px] text-teal-200">
                    Sign in to manage your coaching institute
                </p>
            </div>

            <!-- Login Form -->
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="space-y-3.5 my-auto py-2">
                <FluentValidationValidator />

                <!-- Email Input -->
                <div class="space-y-1">
                    <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                        Email Address
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206"/>
                            </svg>
                        </span>
                        <InputText @bind-Value="_loginModel.Email" 
                                   placeholder="name@institute.com"
                                   class="w-full py-2.5 pl-9 pr-3 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Email)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Password Input -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                            Password
                        </label>
                        <a href="forgot-password" class="text-[11px] font-medium text-[#14B8A6] hover:text-white hover:underline">
                            Forgot?
                        </a>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input type="@(_showPassword ? "text" : "password")" 
                               @bind="_loginModel.Password" 
                               placeholder="••••••••"
                               class="w-full py-2.5 pl-9 pr-9 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                        <button type="button" 
                                @onclick="TogglePasswordVisibility"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-teal-400 hover:text-white">
                            @if (_showPassword)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-[10px] text-rose-300" />
                </div>

                <!-- Remember Me Checkbox -->
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="rememberMe" @bind="_rememberMe" class="w-3.5 h-3.5 rounded text-[#009488] bg-[#00382E] border-teal-600 focus:ring-[#009488]" />
                    <label for="rememberMe" class="text-[11px] text-teal-200/90 cursor-pointer">
                        Remember this device for 30 days
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        disabled="@_isLoading"
                        class="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-[#009488] hover:bg-[#0f766e] transition-all shadow-[0_8px_20px_-4px_rgba(0,148,136,0.5)] flex items-center justify-center gap-2">
                    @if (_isLoading)
                    {
                        <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Authenticating...</span>
                    }
                    else
                    {
                        <span>Sign In to Dashboard →</span>
                    }
                </button>
            </EditForm>

            <!-- Register Organization Footer Link -->
            <div class="pt-3 border-t border-teal-800/80 text-center">
                <p class="text-[11px] text-teal-200/80">
                    New Institute?
                    <a href="register" class="font-bold text-amber-300 hover:text-white hover:underline ml-1">
                        Register Organization
                    </a>
                </p>
            </div>

        </div>

    </div>

</div>

@code {
    private readonly LoginRequest _loginModel = new();
    private bool _rememberMe = true;

    private bool _showPassword = false;
    private bool _isLoading = false;

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var target = Vargshala.Web.Common.RoleNavigationHelper.GetDefaultRouteForClaimsPrincipal(authState.User);
                Navigation.NavigateTo(target, replace: true);
            }
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(_loginModel);
            if (response.Success && response.Data is not null)
            {
                NotificationService.Success("Login successful! Redirecting...", "Welcome");
                await Task.Delay(200);

                var login = response.Data;
                var role = login.User?.Role ?? UserRole.OrganizationAdmin;
                var targetUrl = Vargshala.Web.Common.RoleNavigationHelper.GetDefaultRouteForRole(role);

                var signInUrl = $"/account/signin?token={Uri.EscapeDataString(login.AccessToken)}" +
                                $"&refreshToken={Uri.EscapeDataString(login.RefreshToken ?? string.Empty)}" +
                                $"&rememberMe={_rememberMe.ToString().ToLowerInvariant()}" +
                                $"&orgName={Uri.EscapeDataString(login.User?.OrganizationName ?? string.Empty)}" +
                                $"&branchId={Uri.EscapeDataString(login.User?.CurrentBranchId?.ToString() ?? string.Empty)}" +
                                $"&branchName={Uri.EscapeDataString(login.User?.CurrentBranchName ?? string.Empty)}" +
                                $"&returnUrl={Uri.EscapeDataString(targetUrl)}";

                Navigation.NavigateTo(signInUrl, forceLoad: true);
            }
            else
            {
                NotificationService.Error(response.Message ?? "Invalid email or password.", "Login Failed");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Authentication error: " + ex.Message, "Error");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
