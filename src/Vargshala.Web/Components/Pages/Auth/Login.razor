@page "/login"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Sign In | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center h-full max-h-full">
    
    <!-- ========================================================================= -->
    <!-- LEFT COLUMN: Animated Educational Vector Illustration Showcase -->
    <!-- ========================================================================= -->
    <div class="hidden lg:flex lg:col-span-7 flex-col justify-center relative">
        
        <!-- Glowing Ambient Lights in background -->
        <div class="absolute top-4 left-4 w-60 h-60 bg-brand-600/20 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
        <div class="absolute bottom-4 right-4 w-60 h-60 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Illustration Canvas Container (Compact Proportional Height: 440px) -->
        <div class="relative w-full h-[430px] bg-slate-900/60 rounded-3xl border border-slate-800/80 backdrop-blur-xl p-6 overflow-hidden shadow-2xl flex items-center justify-center">
            
            <!-- Background Dotted Trajectory Curves -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-30" xmlns="http://www.w3.org/2000/svg">
                <path d="M 40 120 Q 180 30 380 90 T 480 250" fill="none" stroke="#818cf8" stroke-width="2" stroke-dasharray="6,6" class="animate-dash-flow" />
                <path d="M 60 340 Q 200 400 420 310" fill="none" stroke="#a78bfa" stroke-width="2" stroke-dasharray="6,6" />
            </svg>

            <!-- Floating Target Badge -->
            <div class="absolute top-6 left-6 p-2.5 rounded-2xl bg-slate-800/90 border border-slate-700 shadow-lg text-brand-400 animate-float-slow">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                    <circle cx="12" cy="12" r="6" stroke-width="2"></circle>
                    <circle cx="12" cy="12" r="2" stroke-width="2"></circle>
                </svg>
            </div>

            <!-- Flying Paper Plane (Animated) -->
            <div class="absolute top-8 right-8 p-2.5 rounded-2xl bg-gradient-to-tr from-brand-500 to-violet-500 text-white shadow-brand animate-plane-fly">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </div>

            <!-- Central Digital Classroom Browser Screen -->
            <div class="relative w-[310px] bg-slate-800/95 rounded-2xl border border-slate-700/80 shadow-2xl p-3.5 transition-transform animate-float-medium">
                <!-- Browser top bar with dots -->
                <div class="flex items-center justify-between pb-2.5 border-b border-slate-700/70">
                    <div class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    </div>
                    <span class="text-[10px] font-mono text-slate-400">vargshala.live/batch-alpha</span>
                    <span class="badge-emerald text-[8px] py-0 px-1.5">● LIVE</span>
                </div>

                <!-- Teacher Video Window & Presentation Screen -->
                <div class="mt-2.5 relative rounded-xl overflow-hidden bg-gradient-to-br from-brand-950 via-slate-900 to-violet-950 border border-brand-500/30 p-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-10 h-10 rounded-xl bg-brand-600/30 border border-brand-400/40 flex items-center justify-center text-brand-300 font-bold text-sm">
                            👨‍🏫
                        </div>
                        <div>
                            <h4 class="text-xs font-bold text-white leading-tight">Dr. Verma — Physics</h4>
                            <p class="text-[10px] text-slate-300">Live Streaming • 48 Students</p>
                        </div>
                    </div>

                    <!-- Video Thumbnail Previews -->
                    <div class="grid grid-cols-3 gap-1.5 mt-2.5">
                        <div class="h-8 rounded-lg bg-brand-500/20 border border-brand-400/30 flex items-center justify-center text-[10px] text-brand-300">
                            ▶ Video 1
                        </div>
                        <div class="h-8 rounded-lg bg-violet-500/20 border border-violet-400/30 flex items-center justify-center text-[10px] text-violet-300">
                            ▶ Video 2
                        </div>
                        <div class="h-8 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-[10px] text-emerald-300">
                            ▶ Quiz
                        </div>
                    </div>
                </div>

                <!-- Floating Speech Bubble from Teacher -->
                <div class="absolute -top-4 -right-4 px-2.5 py-1 rounded-2xl bg-violet-600 text-white text-[10px] font-semibold shadow-violet-glow flex items-center gap-1 animate-float-reverse">
                    <span>💬</span>
                    <span>Class in Session!</span>
                </div>
            </div>

            <!-- Bottom Left: Stack of Books & Graduation Cap (Mortarboard) -->
            <div class="absolute bottom-6 left-8 flex flex-col items-center animate-float-reverse">
                <!-- Graduation Cap -->
                <div class="relative -mb-2 z-10">
                    <div class="w-12 h-3.5 bg-brand-600 rounded-sm transform -rotate-6 shadow-md"></div>
                    <div class="w-7 h-3 bg-brand-700 mx-auto rounded-b-md"></div>
                    <span class="absolute right-0 top-0 text-[10px]">🎓</span>
                </div>
                <!-- Stacked Books -->
                <div class="w-24 h-4 bg-amber-500 rounded-md border-b-2 border-amber-600 shadow-sm"></div>
                <div class="w-28 h-4.5 bg-brand-600 rounded-md -mt-1 border-b-2 border-brand-700 shadow-md"></div>
                <div class="w-32 h-5 bg-violet-600 rounded-md -mt-1 border-b-2 border-violet-700 shadow-lg"></div>
            </div>

            <!-- Bottom Right: Student Learning Card -->
            <div class="absolute bottom-6 right-6 p-3 rounded-2xl bg-slate-800/90 border border-slate-700/80 shadow-2xl backdrop-blur-md flex items-center gap-2.5 animate-float-slow">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-coral-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
                    👩‍🎓
                </div>
                <div>
                    <div class="flex items-center gap-1">
                        <span class="text-[11px] font-bold text-white">Student Portal</span>
                        <span class="badge-emerald text-[8px] py-0 px-1">98% Score</span>
                    </div>
                    <p class="text-[10px] text-slate-400">Ananya • Class 12th JEE</p>
                </div>
            </div>

        </div>

        <!-- Institute Highlight Metrics Footer (Compact 3-grid) -->
        <div class="grid grid-cols-3 gap-3 mt-3">
            <div class="py-2 px-3 rounded-xl bg-slate-900/40 border border-slate-800/60 text-center">
                <p class="text-sm font-bold text-white">99.9%</p>
                <p class="text-[10px] text-slate-400">System Uptime</p>
            </div>
            <div class="py-2 px-3 rounded-xl bg-slate-900/40 border border-slate-800/60 text-center">
                <p class="text-sm font-bold text-brand-400">Multi-Tenant</p>
                <p class="text-[10px] text-slate-400">Strict Org Isolation</p>
            </div>
            <div class="py-2 px-3 rounded-xl bg-slate-900/40 border border-slate-800/60 text-center">
                <p class="text-sm font-bold text-emerald-400">Instant Sync</p>
                <p class="text-[10px] text-slate-400">Real-Time Classes</p>
            </div>
        </div>

    </div>

    <!-- ========================================================================= -->
    <!-- RIGHT COLUMN: Sleek Glassmorphic Login Form Card (Fitted) -->
    <!-- ========================================================================= -->
    <div class="lg:col-span-5 w-full max-w-md mx-auto">
        <div class="p-6 sm:p-7 rounded-3xl bg-slate-900/80 border border-slate-800/90 shadow-2xl backdrop-blur-2xl">
            
            <!-- Branding Header (Compact) -->
            <div class="text-center space-y-1 mb-5">
                <div class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 via-brand-500 to-violet-500 text-white font-extrabold text-xl shadow-brand mb-1">
                    V
                </div>
                <h2 class="text-xl font-extrabold text-white tracking-tight">
                    Welcome to Vargshala
                </h2>
                <p class="text-[11px] text-slate-400">
                    Sign in to manage your coaching institute
                </p>
            </div>

            <!-- Quick Demo Fill Pills -->
            <div class="mb-4 p-2.5 rounded-2xl bg-slate-950/60 border border-slate-800/70 space-y-1.5">
                <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold px-1">
                    <span>⚡ QUICK DEMO LOGIN:</span>
                    <span class="text-brand-400">Click to Auto-fill</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" 
                            @onclick="FillSuperAdminDemo"
                            class="p-1.5 px-2 rounded-xl text-left bg-slate-900 border border-slate-700/60 hover:border-brand-500 hover:bg-brand-950/30 transition-all text-xs group">
                        <span class="font-bold text-white text-[11px] flex items-center gap-1 group-hover:text-brand-300">
                            👑 SuperAdmin
                        </span>
                        <span class="text-[9px] text-slate-400 block truncate">rishabh.sharma@@...</span>
                    </button>
                    <button type="button" 
                            @onclick="FillOrgAdminDemo"
                            class="p-1.5 px-2 rounded-xl text-left bg-slate-900 border border-slate-700/60 hover:border-violet-500 hover:bg-violet-950/30 transition-all text-xs group">
                        <span class="font-bold text-white text-[11px] flex items-center gap-1 group-hover:text-violet-300">
                            🏫 Org Admin
                        </span>
                        <span class="text-[9px] text-slate-400 block truncate">rishabh.admin@@...</span>
                    </button>
                </div>
            </div>

            <!-- Login Form (Compact Spacing) -->
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" class="space-y-3.5">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-2.5 rounded-xl bg-rose-950/50 border border-rose-800/60 text-rose-300 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="p-2.5 rounded-xl bg-emerald-950/50 border border-emerald-800/60 text-emerald-300 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>@_successMessage</span>
                    </div>
                }

                <!-- Email Input -->
                <div class="space-y-1">
                    <label class="block text-[10px] font-semibold text-slate-300 uppercase tracking-wider">
                        Email Address
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-500">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206"/>
                            </svg>
                        </span>
                        <InputText @bind-Value="_loginModel.Email" 
                                   placeholder="name@institute.com"
                                   class="w-full py-2 pl-9 pr-3 text-xs bg-slate-950/70 border border-slate-800 rounded-xl focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 text-white placeholder-slate-500 transition-all" />
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Email)" class="text-[10px] text-rose-400" />
                </div>

                <!-- Password Input -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-[10px] font-semibold text-slate-300 uppercase tracking-wider">
                            Password
                        </label>
                        <a href="#" class="text-[11px] font-medium text-brand-400 hover:text-brand-300 hover:underline">
                            Forgot?
                        </a>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-500">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input type="@(_showPassword ? "text" : "password")" 
                               @bind="_loginModel.Password" 
                               placeholder="••••••••"
                               class="w-full py-2 pl-9 pr-9 text-xs bg-slate-950/70 border border-slate-800 rounded-xl focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 text-white placeholder-slate-500 transition-all" />
                        <button type="button" 
                                @onclick="TogglePasswordVisibility"
                                class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-500 hover:text-slate-300">
                            @if (_showPassword)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-[10px] text-rose-400" />
                </div>

                <!-- Remember Me Checkbox -->
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="rememberMe" class="w-3.5 h-3.5 rounded text-brand-600 bg-slate-950 border-slate-800 focus:ring-brand-500 focus:ring-offset-slate-900" />
                    <label for="rememberMe" class="text-[11px] text-slate-400 cursor-pointer">
                        Remember this device for 30 days
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        disabled="@_isLoading"
                        class="w-full btn-brand-primary py-2.5 rounded-xl font-bold text-xs shadow-brand hover:shadow-violet-glow transition-all">
                    @if (_isLoading)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Authenticating...</span>
                    }
                    else
                    {
                        <span>Sign In to Dashboard →</span>
                    }
                </button>
            </EditForm>

            <!-- Register Organization Footer Link -->
            <div class="mt-4 pt-3.5 border-t border-slate-800/80 text-center">
                <p class="text-[11px] text-slate-400">
                    New Institute?
                    <a href="register" class="font-bold text-brand-400 hover:text-brand-300 hover:underline ml-1">
                        Register Organization
                    </a>
                </p>
            </div>

        </div>
    </div>

</div>

@code {
    private readonly LoginRequest _loginModel = new()
    {
        Email = "rishabh.admin@vargshala.com",
        Password = "Admin@12345"
    };

    private bool _showPassword = false;
    private bool _isLoading = false;
    private string? _errorMessage;
    private string? _successMessage;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private void FillSuperAdminDemo()
    {
        _loginModel.Email = "rishabh.sharma@vargshala.com";
        _loginModel.Password = "Admin@12345";
        _errorMessage = null;
        _successMessage = "SuperAdmin credentials filled!";
    }

    private void FillOrgAdminDemo()
    {
        _loginModel.Email = "rishabh.admin@vargshala.com";
        _loginModel.Password = "Admin@12345";
        _errorMessage = null;
        _successMessage = "OrganizationAdmin credentials filled!";
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await Task.Delay(800);
            _successMessage = "Login successful! Redirecting to Dashboard...";
            await Task.Delay(500);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = "Authentication failed: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
