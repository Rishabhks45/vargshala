@page "/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Forgot Password | Vargshala</PageTitle>

<div class="w-full max-w-5xl mx-auto flex items-center justify-center h-full">
    
    <!-- Unified 2-Column Responsive Card Shell -->
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- ========================================================================= -->
        <!-- LEFT COLUMN: Educational Security Showcase with Plant & Books PNG -->
        <!-- ========================================================================= -->
        <div class="hidden lg:flex lg:col-span-7 flex-col justify-between relative rounded-3xl bg-[#004D40]/80 border border-teal-700/60 backdrop-blur-xl p-6 shadow-2xl overflow-hidden min-h-[440px]">
            
            <!-- Ambient Glowing Background Lights -->
            <div class="absolute -top-10 -left-10 w-60 h-60 bg-[#009488]/30 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
            <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-[#FB6868]/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Background Dotted Trajectory Curves -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-20" xmlns="http://www.w3.org/2000/svg">
                <path d="M 40 100 Q 180 20 380 80 T 480 220" fill="none" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="6,6" class="animate-dash-flow" />
                <path d="M 60 320 Q 200 380 420 290" fill="none" stroke="#fb6868" stroke-width="2" stroke-dasharray="6,6" />
            </svg>

            <!-- Top Row Floating Badges -->
            <div class="flex items-center justify-between relative z-10 w-full">
                <!-- Security Key Badge -->
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-teal-300 animate-float-slow">
                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                </div>

                <!-- Shield Badge -->
                <div class="p-2.5 rounded-2xl bg-[#00382E]/90 border border-teal-600/50 shadow-lg text-[#14B8A6] animate-plane-fly">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
            </div>

            <!-- Center Hero: Plant & Books PNG -->
            <div class="relative flex flex-col items-center justify-center my-auto py-2 group z-10">
                <div class="absolute inset-0 bg-[#009488]/25 rounded-full blur-2xl group-hover:bg-[#14B8A6]/35 transition-all"></div>
                <img src="images/plant-books.png" 
                     alt="Account Recovery" 
                     class="w-56 h-48 object-contain relative drop-shadow-[0_15px_30px_rgba(0,148,136,0.35)]" />
            </div>

            <!-- Bottom Information Pill -->
            <div class="p-3 rounded-2xl bg-[#00382E]/90 border border-teal-600/60 shadow-xl backdrop-blur-md relative z-10">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-[#009488] text-white flex items-center justify-center text-xs shadow-md shrink-0">
                        🔒
                    </div>
                    <div>
                        <p class="text-[11px] font-bold text-white">Encrypted Account Recovery</p>
                        <p class="text-[9px] text-teal-200">A secure reset token will be delivered to your registered email.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- RIGHT COLUMN: Forgot Password Form Card -->
        <!-- ========================================================================= -->
        <div class="lg:col-span-5 w-full flex flex-col justify-between p-6 sm:p-7 rounded-3xl bg-[#004D40]/90 border border-teal-700/70 shadow-2xl backdrop-blur-2xl min-h-[440px]">
            
            <!-- Branding Header -->
            <div class="text-center space-y-1">
                <img src="images/vargshala-logo.svg" alt="Vargshala" class="w-12 h-12 rounded-full shadow-lg mb-1 mx-auto drop-shadow-md" />
                <h2 class="text-xl font-extrabold text-white tracking-tight">
                    Reset Password
                </h2>
                <p class="text-[11px] text-teal-200">
                    Enter your email to receive recovery instructions
                </p>
            </div>

            <!-- Form -->
            <EditForm Model="@_forgotModel" OnValidSubmit="HandleForgotPassword" class="space-y-4 my-auto py-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-2 rounded-xl bg-rose-950/70 border border-rose-700 text-rose-200 text-[11px] flex items-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (_emailSent)
                {
                    <div class="p-3 rounded-2xl bg-emerald-950/80 border border-emerald-600 text-emerald-200 space-y-2 text-center">
                        <div class="w-8 h-8 rounded-full bg-emerald-800 text-emerald-200 mx-auto flex items-center justify-center font-bold text-sm">
                            ✓
                        </div>
                        <p class="text-xs font-bold text-white">Reset Link Sent!</p>
                        <p class="text-[10px] text-emerald-300">
                            We've sent a recovery link to <strong>@_forgotModel.Email</strong>.
                        </p>
                        <div class="pt-1">
                            <a href="reset-password?email=@Uri.EscapeDataString(_forgotModel.Email)" class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-300 hover:underline">
                                Proceed to Reset Screen →
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Email Input -->
                    <div class="space-y-1">
                        <label class="block text-[10px] font-semibold text-teal-200 uppercase tracking-wider">
                            Registered Email Address
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-teal-400">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206"/>
                                </svg>
                            </span>
                            <InputText @bind-Value="_forgotModel.Email" 
                                       placeholder="name@institute.com"
                                       class="w-full py-2.5 pl-9 pr-3 text-xs bg-[#00382E] border border-teal-600/70 rounded-xl focus:border-[#14B8A6] focus:outline-none focus:ring-2 focus:ring-teal-400/30 text-white placeholder-teal-300/50 transition-all" />
                        </div>
                        <ValidationMessage For="@(() => _forgotModel.Email)" class="text-[10px] text-rose-300" />
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                            disabled="@_isLoading"
                            class="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-[#009488] hover:bg-[#0f766e] transition-all shadow-[0_8px_20px_-4px_rgba(0,148,136,0.5)] flex items-center justify-center gap-2">
                        @if (_isLoading)
                        {
                            <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Sending instructions...</span>
                        }
                        else
                        {
                            <span>Send Recovery Link →</span>
                        }
                    </button>
                }
            </EditForm>

            <!-- Back to Sign In Link -->
            <div class="pt-3 border-t border-teal-800/80 text-center">
                <a href="login" class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-teal-200 hover:text-white transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    <span>Back to Sign In</span>
                </a>
            </div>

        </div>

    </div>

</div>

@code {
    private readonly ForgotPasswordRequest _forgotModel = new();
    private bool _isLoading = false;
    private bool _emailSent = false;
    private string? _errorMessage;

    private async Task HandleForgotPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await Task.Delay(900);
            _emailSent = true;
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to process request: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
