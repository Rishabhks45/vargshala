@page "/forgot-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using Vargshala.Contracts.Authentication
@using Vargshala.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Vargshala.Web.Components.UI.Validation
@inject IAuthService AuthService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Forgot Password | Vargshala</PageTitle>

<div class="h-full w-full grid grid-cols-1 lg:grid-cols-12 relative overflow-hidden">

    <!-- ========================================================================= -->
    <!-- LEFT COLUMN: Completely Seamless Form (Compact, No Page Scroll)           -->
    <!-- ========================================================================= -->
    <div class="lg:col-span-5 xl:col-span-5 flex flex-col justify-between px-6 sm:px-10 lg:px-12 xl:px-14 py-4 lg:py-5 z-10 h-full overflow-y-auto" style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <div class="w-full max-w-md mx-auto flex flex-col justify-between h-full">

            <!-- Top Brand Logo -->
            <div class="flex items-center justify-between shrink-0">
                <a href="/" class="flex items-center">
                    <VargshalaLogo Size="36" ShowText="true" />
                </a>

                <!-- Switch to Login button -->
                <button type="button" 
                        @onclick="NavigateToLogin" 
                        class="text-xs font-semibold hover:underline cursor-pointer bg-transparent border-0 p-0 focus:outline-none transition-colors"
                        style="color: var(--theme-primary, #009488);">
                    ← Back to Login
                </button>
            </div>

            <!-- Center Form Area -->
            <div class="my-auto py-2 w-full">
                
                @if (_emailSent)
                {
                    <!-- Success State -->
                    <div class="space-y-4 text-center">
                        <div class="w-12 h-12 mx-auto rounded-xl border flex items-center justify-center shadow-xs"
                             style="background-color: var(--theme-light-bg, #EDF8F4); border-color: var(--theme-primary, #009488); color: var(--theme-primary, #009488);">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>

                        <div class="space-y-1 text-center">
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                                Check Your Email
                            </h1>
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
                                If an account matches <strong class="font-bold" style="color: var(--theme-primary, #009488);">@_submittedEmail</strong>, a password reset link has been sent to your inbox.
                            </p>
                        </div>

                        <div class="p-3 rounded-xl border text-left bg-white dark:bg-[#15232a] border-slate-200 dark:border-slate-700/80">
                            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                                ⏱️ <strong>Note:</strong> The link is valid for <strong>30 minutes</strong> and can only be used <strong>once</strong>. Please check your Spam folder if not received shortly.
                            </p>
                        </div>

                        <button type="button" 
                                @onclick="ResetForm"
                                class="text-xs font-semibold hover:underline cursor-pointer bg-transparent border-0 p-0 focus:outline-none transition-colors"
                                style="color: var(--theme-primary, #009488);">
                            Didn't receive the email? Try again
                        </button>
                    </div>
                }
                else
                {
                    <!-- Heading -->
                    <div class="space-y-1.5 mb-4 text-center">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                            Forgot Password
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-normal leading-snug">
                            Enter your registered email to receive recovery instructions.
                        </p>
                    </div>

                    <!-- Forgot Password Form -->
                    <EditForm Model="@_forgotModel" OnValidSubmit="HandleForgotPassword" class="space-y-3">
                        <FluentValidationValidator />

                        <!-- Email Input -->
                        <div class="space-y-1">
                            <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300">
                                Registered Email Address
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none" style="color: var(--theme-primary, #009488);">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </span>
                                <InputText @bind-Value="_forgotModel.Email" 
                                           placeholder="name@institute.com" 
                                           class="w-full py-2 pl-9 pr-3 text-xs bg-white dark:bg-[#15232a] border border-slate-200 dark:border-slate-700/80 rounded-xl focus:border-[var(--theme-primary,#009488)] focus:ring-2 focus:ring-[var(--theme-primary,#009488)]/20 focus:outline-none text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 font-medium transition-all shadow-2xs" />
                            </div>
                            <ValidationMessage For="@(() => _forgotModel.Email)" class="text-[10px] text-rose-500 font-semibold" />
                        </div>

                        <!-- Primary Pill Button -->
                        <button type="submit" 
                                disabled="@_isLoading"
                                class="w-full py-2.5 rounded-full font-bold text-xs text-white transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer hover:shadow-lg hover:brightness-105 active:scale-[0.99] mt-2"
                                style="background: linear-gradient(135deg, var(--theme-header, #004D40) 0%, var(--theme-primary, #009488) 100%);">
                            @if (_isLoading)
                            {
                                <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Sending instructions...</span>
                            }
                            else
                            {
                                <span>Send Recovery Link →</span>
                            }
                        </button>
                    </EditForm>
                }

                <!-- Footer Sign-In Redirect -->
                <div class="pt-3 text-center">
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">
                        Already have an Institute Account?
                        <button type="button" @onclick="NavigateToLogin" 
                                class="font-bold hover:underline ml-1 bg-transparent border-0 p-0 cursor-pointer focus:outline-none"
                                style="color: var(--theme-primary, #009488);">
                            Sign In to Vargshala →
                        </button>
                    </p>
                </div>
            </div>

        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- RIGHT COLUMN: Organic Canvas with Online Learning SVG & Quote             -->
    <!-- ========================================================================= -->
    <div class="hidden lg:flex lg:col-span-7 xl:col-span-7 flex-col items-center justify-center relative px-6 py-6 h-full overflow-hidden">
        
        <!-- Large Organic Fluid Background Shape Matching Theme -->
        <div class="absolute inset-y-4 right-5 left-3 rounded-[3rem] -z-0 pointer-events-none transition-colors duration-300 dark:bg-[#111c21] dark:border dark:border-slate-800/80"
             style="background-color: var(--theme-light-bg, #EDF8F4);"></div>

        <!-- Floating Clean Circles with Theme Colors -->
        <div class="absolute inset-y-4 right-5 left-3 rounded-[3rem] overflow-hidden pointer-events-none z-0">
            <div class="auth-bubble w-28 h-28 top-8 left-10" style="animation: floatBubble1 8s ease-in-out infinite;"></div>
            <div class="auth-bubble w-20 h-20 bottom-24 right-14" style="animation: floatBubble2 10s ease-in-out 1s infinite;"></div>
            <div class="auth-bubble w-14 h-14 top-1/4 right-8" style="animation: floatBubble3 7s ease-in-out 2s infinite;"></div>
            <div class="auth-bubble w-24 h-24 bottom-1/3 left-6" style="animation: floatBubble1 11s ease-in-out 3s infinite;"></div>
            <div class="auth-bubble w-12 h-12 top-16 right-32" style="animation: floatBubble2 6.5s ease-in-out 0.5s infinite;"></div>
            <div class="auth-bubble w-16 h-16 top-2/3 right-10" style="animation: floatBubble3 9s ease-in-out 2.5s infinite;"></div>
            <div class="auth-bubble w-9 h-9 bottom-12 left-28" style="animation: floatBubble2 6s ease-in-out 1.5s infinite;"></div>
        </div>

        <!-- Decorative Floating Sparkles -->
        <div class="absolute top-12 right-20 text-base pointer-events-none z-10" style="color: var(--theme-primary, #009488); opacity: 0.4;">✦</div>
        <div class="absolute bottom-16 left-12 text-xs pointer-events-none z-10" style="color: var(--theme-primary, #009488); opacity: 0.4;">✦</div>
        <div class="absolute top-1/3 left-8 text-xs pointer-events-none z-10" style="color: var(--theme-primary, #009488); opacity: 0.3;">✚</div>

        <!-- Center Educational SVG Illustration Showcase -->
        <div class="relative z-10 w-full flex flex-col items-center justify-center my-auto max-w-lg xl:max-w-xl">
            <object data="images/online-learning.svg?v=3" 
                    type="image/svg+xml" 
                    class="w-full max-h-[100vh] object-contain pointer-events-none drop-shadow-[0_15px_30px_rgba(0,77,64,0.06)]">
            </object>
        </div>

        <!-- Quote & Accent Underline Bar -->
        <div class="absolute bottom-8 inset-x-0 z-10 text-center space-y-2 pointer-events-none">
            <p class="text-xs sm:text-sm font-semibold italic text-slate-800 dark:text-slate-200 tracking-wide">
                “Simplifying Institute Management, Amplifying Education.”
            </p>
            <div class="w-12 h-1 rounded-full mx-auto shadow-2xs" style="background-color: var(--theme-accent, #F59E0B);"></div>
        </div>

    </div>

</div>

<style>
    .auth-bubble {
        position: absolute;
        border-radius: 9999px;
        background-color: var(--theme-primary-light, #80D8CB);
        opacity: 0.55;
        pointer-events: none;
    }
    @@keyframes floatBubble1 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        33% {
            transform: translateY(-22px) translateX(12px) scale(1.05);
        }
        66% {
            transform: translateY(-38px) translateX(-10px) scale(0.96);
        }
    }
    @@keyframes floatBubble2 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        40% {
            transform: translateY(-30px) translateX(-14px) scale(1.06);
        }
        75% {
            transform: translateY(-12px) translateX(10px) scale(0.95);
        }
    }
    @@keyframes floatBubble3 {
        0%, 100% {
            transform: translateY(0px) translateX(0px) scale(1);
        }
        50% {
            transform: translateY(-26px) translateX(16px) scale(1.08);
        }
    }
</style>

@code {
    private readonly ForgotPasswordRequest _forgotModel = new();
    private string _submittedEmail = string.Empty;
    private bool _isLoading = false;
    private bool _emailSent = false;

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task HandleForgotPassword()
    {
        _isLoading = true;

        try
        {
            _submittedEmail = _forgotModel.Email;
            var response = await AuthService.ForgotPasswordAsync(_forgotModel);

            if (response.Success)
            {
                _emailSent = true;
                NotificationService.Success("Reset link sent! Please check your email inbox.", "Success");
            }
            else
            {
                NotificationService.Error(response.Message ?? "Failed to request password reset.", "Error");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Error("Unable to process request: " + ex.Message, "Error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetForm()
    {
        _emailSent = false;
        _forgotModel.Email = string.Empty;
    }
}
