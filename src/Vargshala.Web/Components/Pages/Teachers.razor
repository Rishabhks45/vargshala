                        <ValidationMessage For="@(() => _modalModel.Email)" class="text-[10px] text-rose-500" />
                    </div>

                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Phone Number *</label>
                        <InputText @bind-Value="_modalModel.Phone" placeholder="+91 98765 43210" class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
