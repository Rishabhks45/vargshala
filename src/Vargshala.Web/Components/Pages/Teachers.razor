    };

    // Drawer Form Options
    private readonly List<CustomSelect.CustomSelectOption> _drawerDesignationOptions = new()
    {
        new("HOD", "HOD"),
        new("Senior Teacher", "Senior Teacher"),
        new("Assistant Teacher", "Assistant Teacher"),
        new("Guest Lecturer", "Guest Lecturer")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerSubjectOptions = new()
    {
        new("Mathematics", "Mathematics"),
        new("Physics", "Physics"),
        new("Chemistry", "Chemistry"),
        new("Biology", "Biology"),
        new("English", "English"),
        new("Hindi", "Hindi"),
        new("Computer Science", "Computer Science"),
        new("Social Studies", "Social Studies")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerQualificationOptions = new()
    {
        new("B.Ed.", "B.Ed."),
        new("M.Sc.", "M.Sc."),
        new("M.A.", "M.A."),
        new("M.Ed.", "M.Ed."),
        new("Ph.D.", "Ph.D."),
        new("B.Tech.", "B.Tech."),
        new("M.Tech.", "M.Tech."),
        new("NET/JRF", "NET/JRF")
    };

    private readonly List<CustomSelect.CustomSelectOption> _drawerStatusOptions = new()
    {
        new("Active", "Active"),
        new("Inactive", "Inactive")
    };

    private readonly List<string> _allBatchNames = new()
    {
        "Class 10 — Maths",
        "Class 10 — Science",
        "Class 12 — Physics",
        "Class 12 — Chemistry",
        "Class 12 — Biology",
        "IIT-JEE Morning Batch",
        "NEET Evening Batch"
    };

    // State
    private Guid? _activeMenuTeacherId;
    private bool _showDrawer = false;
    private bool _isDrawerOpen = false;
    private TeacherDto? _editingTeacher;
    private TeacherDto _modalModel = new();
    private TeacherDto? _selectedProfileTeacher;
    private TeacherDto? _batchAssignTeacher;

    // Mock Data
    private readonly List<TeacherDto> _teachers = new()
    {
        new() { Name = "Dr. Priya Sharma", EmployeeId = "VM-T-001", Email = "priya.sharma@vargshala.com", Phone = "+91 98765 43210", Designation = "HOD", Qualification = "Ph.D.", Subject = "Mathematics", Batches = new List<string> { "Class 10 — Maths", "IIT-JEE Morning Batch" }, JoiningDate = new DateTime(2022, 6, 15) },
        new() { Name = "Rajesh Verma", EmployeeId = "VM-T-002", Email = "rajesh.verma@vargshala.com", Phone = "+91 98765 43211", Designation = "Senior Teacher", Qualification = "M.Sc.", Subject = "Physics", Batches = new List<string> { "Class 12 — Physics", "IIT-JEE Morning Batch" }, JoiningDate = new DateTime(2023, 1, 10) },
        new() { Name = "Sunita Gupta", EmployeeId = "VM-T-003", Email = "sunita.gupta@vargshala.com", Phone = "+91 98765 43212", Designation = "Senior Teacher", Qualification = "M.Sc.", Subject = "Chemistry", Batches = new List<string> { "Class 12 — Chemistry", "NEET Evening Batch" }, JoiningDate = new DateTime(2023, 4, 1) },
        new() { Name = "Amit Tiwari", EmployeeId = "VM-T-004", Email = "amit.tiwari@vargshala.com", Phone = "+91 98765 43213", Designation = "Assistant Teacher", Qualification = "B.Ed.", Subject = "English", Batches = new List<string> { "Class 10 — Maths", "Class 10 — Science" }, JoiningDate = new DateTime(2024, 7, 20) },
        new() { Name = "Dr. Kavita Reddy", EmployeeId = "VM-T-005", Email = "kavita.reddy@vargshala.com", Phone = "+91 98765 43214", Designation = "HOD", Qualification = "Ph.D.", Subject = "Biology", Batches = new List<string> { "Class 12 — Biology", "NEET Evening Batch" }, JoiningDate = new DateTime(2021, 8, 5) },
        new() { Name = "Manoj Kumar", EmployeeId = "VM-T-006", Email = "manoj.kumar@vargshala.com", Phone = "+91 98765 43215", Designation = "Assistant Teacher", Qualification = "M.A.", Subject = "Hindi", Batches = new List<string> { "Class 10 — Maths" }, JoiningDate = new DateTime(2025, 1, 15) },
        new() { Name = "Neha Agarwal", EmployeeId = "VM-T-007", Email = "neha.agarwal@vargshala.com", Phone = "+91 98765 43216", Designation = "Guest Lecturer", Qualification = "B.Tech.", Subject = "Computer Science", Batches = new List<string> { "Class 10 — Science", "Class 12 — Physics", "IIT-JEE Morning Batch" }, JoiningDate = new DateTime(2025, 3, 1) },
        new() { Name = "Vikram Singh", EmployeeId = "VM-T-008", Email = "vikram.singh@vargshala.com", Phone = "+91 98765 43217", Designation = "Senior Teacher", Qualification = "M.Ed.", Subject = "Social Studies", Batches = new List<string>(), Status = "Inactive", JoiningDate = new DateTime(2020, 5, 10) }
    };

    private List<TeacherDto> FilteredTeachers
    {
        get
        {
            var query = _teachers.Where(t =>
                (string.IsNullOrWhiteSpace(_searchQuery) || 
                 t.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                 t.Subject.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) || 
                 t.EmployeeId.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 t.Phone.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 t.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(_selectedSubject) || t.Subject == _selectedSubject) &&
                (string.IsNullOrWhiteSpace(_selectedDesignation) || t.Designation == _selectedDesignation) &&
                (string.IsNullOrWhiteSpace(_selectedStatus) || t.Status == _selectedStatus)
            );

            if (_sortState.IsSorted)
            {
                query = _sortState.Column switch
                {
                    "Name" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(t => t.Name) : query.OrderByDescending(t => t.Name),
                    "Subject" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(t => t.Subject) : query.OrderByDescending(t => t.Subject),
                    "Designation" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(t => t.Designation) : query.OrderByDescending(t => t.Designation),
                    "Contact" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(t => t.Phone) : query.OrderByDescending(t => t.Phone),
                    "Status" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(t => t.Status) : query.OrderByDescending(t => t.Status),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private void ToggleMenu(Guid teacherId)
    {
        _activeMenuTeacherId = _activeMenuTeacherId == teacherId ? null : teacherId;
    }

    private async Task OpenAddDrawerAsync()
    {
        _activeMenuTeacherId = null;
        _editingTeacher = null;
        _modalModel = new TeacherDto
        {
            Status = "Active",
            Designation = "Assistant Teacher",
            Subject = "Mathematics",
            Qualification = "B.Ed."
        };
        _showDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task OpenEditDrawerAsync(TeacherDto? teacher)
    {
        if (teacher == null) return;
        _activeMenuTeacherId = null;
        _editingTeacher = teacher;
        _modalModel = new TeacherDto
        {
            Id = teacher.Id,
            Name = teacher.Name,
            EmployeeId = teacher.EmployeeId,
            Email = teacher.Email,
            Phone = teacher.Phone,
            Designation = teacher.Designation,
            Qualification = teacher.Qualification,
            Subject = teacher.Subject,
            Status = teacher.Status,
            JoiningDate = teacher.JoiningDate,
            Batches = new List<string>(teacher.Batches)
        };
        _showDrawer = true;
        await Task.Yield();
        _isDrawerOpen = true;
    }

    private async Task CloseDrawerAsync()
    {
        _isDrawerOpen = false;
        await Task.Delay(300);
        _showDrawer = false;
        _editingTeacher = null;
    }

    private async Task SaveTeacherAsync()
    {
        if (_editingTeacher == null)
        {
            _modalModel.Id = Guid.NewGuid();
            if (string.IsNullOrWhiteSpace(_modalModel.EmployeeId))
            {
                _modalModel.EmployeeId = $"VM-T-{_teachers.Count + 1:D3}";
            }
            _teachers.Insert(0, _modalModel);
        }
        else
        {
            var index = _teachers.FindIndex(t => t.Id == _editingTeacher.Id);
            if (index != -1)
            {
                _modalModel.Batches = _editingTeacher.Batches;
                _teachers[index] = _modalModel;
            }
        }

        await CloseDrawerAsync();
    }

    private void OpenViewProfile(TeacherDto teacher)
    {
        _activeMenuTeacherId = null;
        _selectedProfileTeacher = teacher;
    }

    private void OpenBatchAssignment(TeacherDto teacher)
    {
        _activeMenuTeacherId = null;
        _batchAssignTeacher = teacher;
    }

    private void ToggleBatch(TeacherDto teacher, string batchName)
    {
        if (teacher.Batches.Contains(batchName))
            teacher.Batches.Remove(batchName);
        else
            teacher.Batches.Add(batchName);
    }

    private void ToggleTeacherStatus(TeacherDto teacher)
    {
        teacher.Status = teacher.Status == "Active" ? "Inactive" : "Active";
        _activeMenuTeacherId = null;
    }

    private void ExportCsv()
    {
        // CSV Export logic
    }
}
