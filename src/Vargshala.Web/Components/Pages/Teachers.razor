            </div>

            <!-- Drawer Sticky Footer -->
            <div class="p-4 px-6 border-t border-slate-200/80 dark:border-slate-800 bg-slate-50/90 dark:bg-[#18262c] backdrop-blur-sm flex items-center justify-between gap-3">
