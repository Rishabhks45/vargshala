                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>@(_editingTeacher == null ? "Save & Register Teacher" : "Update Teacher Records")</span>
                </button>
            </div>
        </EditForm>

    </div>
}

