@if (_selectedProfileTeacher != null)
{
    <Modal IsOpen="true" 
           Title="Teacher Profile" 
           Subtitle="@($"{_selectedProfileTeacher.EmployeeId} • {_selectedProfileTeacher.Subject}")" 
           MaxWidth="max-w-md" 
           OnClose="() => _selectedProfileTeacher = null">
        <ChildContent>
            <div class="space-y-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-black text-lg flex items-center justify-center shadow-xs">
                        @_selectedProfileTeacher.Initials
                    </div>
                    <div>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white">@_selectedProfileTeacher.Name</h4>
                        <p class="text-xs text-slate-400 dark:text-slate-500 font-medium">@_selectedProfileTeacher.Designation • @_selectedProfileTeacher.Qualification</p>
                        <div class="mt-1">
                            <Badge Text="@_selectedProfileTeacher.Status" 
                                   Variant="@(_selectedProfileTeacher.Status == "Active" ? Badge.BadgeVariant.Green : Badge.BadgeVariant.Gray)" 
                                   ShowDot="true" />
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 dark:bg-[#18262c] p-3.5 rounded-2xl space-y-2.5 text-xs border border-slate-100 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Subject</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.Subject</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Email</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.Email</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Phone</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.Phone</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 dark:text-slate-500 font-medium">Joining Date</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">@_selectedProfileTeacher.JoiningDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                        <span class="text-slate-400 dark:text-slate-500 font-medium text-[11px] block mb-1.5">Assigned Batches</span>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var batch in _selectedProfileTeacher.Batches)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                                    @batch
                                </span>
                            }
                            @if (_selectedProfileTeacher.Batches.Count == 0)
                            {
                                <span class="text-[11px] text-slate-400">No batches assigned yet</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" 
                    @onclick="async () => { var t = _selectedProfileTeacher; _selectedProfileTeacher = null; if (t != null) await OpenEditDrawerAsync(t); }"
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                <span>Edit Profile →</span>
            </button>
        </FooterTemplate>
    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL: Batch Assignment -->
<!-- ========================================================================= -->
@if (_batchAssignTeacher != null)
{
    <Modal IsOpen="true" 
           Title="Manage Batch Assignments" 
           Subtitle="@($"Assign or remove batches for {_batchAssignTeacher.Name}")" 
           MaxWidth="max-w-sm" 
           OnClose="() => _batchAssignTeacher = null">
        <ChildContent>
            <div class="space-y-3">
                <p class="text-xs text-slate-500 dark:text-slate-400">Toggle batches to assign or remove this teacher:</p>
                @foreach (var batchOption in _allBatchNames)
                {
                    var isAssigned = _batchAssignTeacher.Batches.Contains(batchOption);
                    <button type="button"
                            @onclick="() => ToggleBatch(_batchAssignTeacher, batchOption)"
                            class="w-full px-3.5 py-2.5 rounded-xl text-xs text-left flex items-center justify-between transition-all cursor-pointer @(isAssigned ? "bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 text-[#00796b] dark:text-teal-300 font-bold" : "bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-[#1f3037]")">
                        <span>@batchOption</span>
                        @if (isAssigned)
                        {
                            <svg class="w-4 h-4 text-[#009488]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                    </button>
                }
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" 
                    @onclick="() => _batchAssignTeacher = null"
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] hover:from-[#00a89a] hover:to-[#00897b] rounded-xl shadow-md shadow-teal-900/15 border border-teal-400/30 transition-all cursor-pointer">
                <span>Done</span>
            </button>
        </FooterTemplate>
    </Modal>
}

@code {
