@page "/study-material"
@using Vargshala.Contracts.StudyMaterials
@using Vargshala.Web.Common
@using Vargshala.Web.Components.UI.Inputs
@using Vargshala.Web.Components.UI.Modals
@using Vargshala.Web.Components.UI.Badges
@rendermode InteractiveServer

<PageTitle>Study Material & Notes | Vargshala</PageTitle>

<div class="space-y-6 transition-colors duration-200">

    <!-- Top Header & Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight">
                Study Material & Notes
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Upload, manage, and share syllabus notes, formula sheets, and study materials with batches.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <!-- View Toggle: Grid / Table -->
            <div class="inline-flex rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#18262c] overflow-hidden shadow-2xs">
                <button type="button" @onclick='() => _viewMode = "grid"'
                        class="px-3 py-2 text-xs font-bold transition-all @(_viewMode == "grid" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </button>
                <button type="button" @onclick='() => _viewMode = "list"'
                        class="px-3 py-2 text-xs font-bold transition-all @(_viewMode == "list" ? "bg-[#009488] text-white" : "text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>

            <button type="button" 
                    @onclick="OpenUploadModal"
                    class="group relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#009488] to-[#00796b] text-white text-xs font-bold shadow-md shadow-teal-900/15 hover:shadow-lg hover:shadow-teal-700/25 border border-teal-400/30 hover:from-[#00a89a] hover:to-[#00897b] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer">
                <span class="w-5 h-5 rounded-lg bg-white/20 flex items-center justify-center text-white group-hover:rotate-90 transition-transform duration-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </span>
                <span>Upload Material</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-teal-50 dark:bg-teal-950/80 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-[#009488]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Materials</p>
                <h3 class="text-lg font-extrabold text-slate-800 dark:text-white">@_materials.Count</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-blue-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">PDF Documents</p>
                <h3 class="text-lg font-extrabold text-blue-600 dark:text-blue-400">@_materials.Count(m => m.FileType == "PDF")</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Total Downloads</p>
                <h3 class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400">@_materials.Sum(m => m.DownloadCount)</h3>
            </div>
        </div>

        <div class="card-surface p-4 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/80 text-amber-600 flex items-center justify-center font-bold text-sm shrink-0">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                </svg>
            </div>
            <div>
                <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Subjects</p>
                <h3 class="text-lg font-extrabold text-amber-600 dark:text-amber-400">@_materials.Select(m => m.Subject).Distinct().Count()</h3>
            </div>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="card-surface p-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <div class="relative flex-1 w-full lg:max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </span>
            <input type="text" 
                   @bind="_searchQuery" 
                   @bind:event="oninput"
                   placeholder="Search material by title, tag, or uploader..." 
                   class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-800 dark:text-white transition-all placeholder-slate-400 dark:placeholder-slate-500" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button type="button" @onclick="() => _searchQuery = string.Empty" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 lg:flex items-center gap-2.5 w-full lg:w-auto">
            <CustomSelect @bind-Value="_filterSubject" Options="_subjectFilterOptions" Placeholder="All Subjects" />
            <CustomSelect @bind-Value="_filterBatch" Options="_batchFilterOptions" Placeholder="All Batches" />
            <CustomSelect @bind-Value="_filterType" Options="_typeFilterOptions" Placeholder="All Types" />
        </div>
    </div>

    <!-- GRID VIEW -->
    @if (_viewMode == "grid")
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var item in FilteredMaterials)
            {
                <div class="card-surface p-5 space-y-4 hover:shadow-md transition-all duration-200 border border-tealborder group flex flex-col justify-between">
                    <div>
                        <!-- Header: File Icon + Status -->
                        <div class="flex items-start justify-between gap-3">
                            <div class="w-12 h-12 rounded-2xl @(item.FileType == "PDF" ? "bg-rose-50 dark:bg-rose-950/60 text-rose-500 border border-rose-200/60 dark:border-rose-900/60" : "bg-blue-50 dark:bg-blue-950/60 text-blue-500 border border-blue-200/60 dark:border-blue-900/60") flex items-center justify-center shrink-0 shadow-xs">
                                @if (item.FileType == "PDF")
                                {
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                }
                            </div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800">
                                @item.Status
                            </span>
                        </div>

                        <!-- Title & Description -->
                        <div class="mt-3">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug group-hover:text-[#009488] transition-colors cursor-pointer"
                                @onclick="() => OpenDetailModal(item)">
                                @item.Title
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">
                                @item.Description
                            </p>
                        </div>

                        <!-- Pills: Subject & Batch -->
                        <div class="flex flex-wrap gap-1.5 mt-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                                @item.Subject
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300">
                                @item.BatchName
                            </span>
                        </div>

                        <!-- Tags -->
                        @if (item.Tags.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1 mt-2">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="text-[9px] font-medium text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-md">
                                        #@tag
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Footer: Meta & Actions -->
                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500">
                        <div class="flex items-center gap-2">
                            <span>@item.FileSize</span>
                            <span>•</span>
                            <span>@item.DownloadCount downloads</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" 
                                    @onclick="() => DownloadItem(item)"
                                    class="p-1.5 rounded-lg text-slate-400 hover:text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-colors"
                                    title="Download File">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                </svg>
                            </button>
                            <button type="button" 
                                    @onclick="() => OpenDetailModal(item)"
                                    class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                    title="View Details">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (!FilteredMaterials.Any())
            {
                <div class="col-span-full card-surface p-12 text-center">
                    <svg class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No study material found</p>
                    <p class="text-xs text-slate-400 mt-1">Try changing your search query or filter options.</p>
                </div>
            }
        </div>
    }

    <!-- LIST VIEW -->
    @if (_viewMode == "list")
    {
        <div class="card-surface overflow-hidden border border-tealborder shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px] text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-800/80 text-[11px] font-bold text-slate-400 dark:text-slate-500 tracking-wider select-none">
                            <th class="py-3.5 px-6 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => _sortState.Toggle("Title")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Material Title</span>
                                    <span class="@_sortState.GetIndicatorClass("Title")">@_sortState.GetIndicator("Title")</span>
                                </div>
                            </th>
                            <th class="py-3.5 px-4 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 transition-colors" @onclick='() => _sortState.Toggle("Subject")'>
                                <div class="flex items-center gap-1.5">
                                    <span>Subject</span>
                                    <span class="@_sortState.GetIndicatorClass("Subject")">@_sortState.GetIndicator("Subject")</span>
                                </div>
                            </th>
                            <th class="py-3.5 px-4">Batch</th>
                            <th class="py-3.5 px-4">Size</th>
                            <th class="py-3.5 px-4">Downloads</th>
                            <th class="py-3.5 px-4">Date</th>
                            <th class="py-3.5 px-6 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                        @foreach (var item in FilteredMaterials)
                        {
                            <tr class="hover:bg-teal-50/40 dark:hover:bg-teal-950/30 transition-colors">
                                <td class="py-3.5 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-xl @(item.FileType == "PDF" ? "bg-rose-50 dark:bg-rose-950/60 text-rose-500" : "bg-blue-50 dark:bg-blue-950/60 text-blue-500") flex items-center justify-center shrink-0">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-900 dark:text-white hover:text-[#009488] cursor-pointer truncate max-w-xs" @onclick="() => OpenDetailModal(item)">@item.Title</p>
                                            <p class="text-[10px] text-slate-400 dark:text-slate-500">By @item.UploadedBy</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-teal-50 dark:bg-teal-950/80 border border-teal-200/80 dark:border-teal-800 text-[#00796b] dark:text-teal-300">
                                        @item.Subject
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300">@item.BatchName</td>
                                <td class="py-3.5 px-4 font-semibold text-slate-500 dark:text-slate-400">@item.FileSize</td>
                                <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">@item.DownloadCount</td>
                                <td class="py-3.5 px-4 text-slate-400 dark:text-slate-500">@item.UploadDate.ToString("dd MMM yyyy")</td>
                                <td class="py-3.5 px-6 text-right">
                                    <button type="button" @onclick="() => DownloadItem(item)"
                                            class="p-1.5 rounded-lg text-[#009488] hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-colors" title="Download">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- MODAL: Upload Study Material -->
<!-- ========================================================================= -->
@if (_showUploadModal)
{
    <Modal IsOpen="true"
           Title="Upload Study Material"
           Subtitle="Share notes, syllabus or PDF worksheets with students"
           MaxWidth="max-w-lg"
           OnClose="() => _showUploadModal = false">
        <ChildContent>
            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Document Title *</label>
                    <input type="text" @bind="_uploadModel.Title" placeholder="e.g. Thermodynamics Formula Handout"
                           class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Subject *</label>
                        <CustomSelect @bind-Value="_uploadModel.Subject" Options="_subjectFilterOptions.Where(o => !string.IsNullOrEmpty(o.Value)).ToList()" Placeholder="Select Subject" Class="w-full" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Target Batch *</label>
                        <CustomSelect @bind-Value="_uploadModel.BatchName" Options="_batchFilterOptions.Where(o => !string.IsNullOrEmpty(o.Value)).ToList()" Placeholder="Select Batch" Class="w-full" />
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Description</label>
                    <textarea @bind="_uploadModel.Description" rows="2" placeholder="Brief summary of concepts covered in this material..."
                              class="w-full px-3.5 py-2.5 text-xs bg-slate-50 dark:bg-[#18262c] border border-slate-200 dark:border-slate-700 rounded-xl focus:bg-white dark:focus:bg-[#142025] focus:border-[#009488] focus:ring-2 focus:ring-teal-500/20 focus:outline-none text-slate-900 dark:text-white transition-all"></textarea>
                </div>

                <!-- Simulated Upload Zone -->
                <div class="border-2 border-dashed border-teal-300 dark:border-teal-800 bg-teal-50/40 dark:bg-teal-950/30 rounded-2xl p-5 text-center cursor-pointer hover:bg-teal-50 dark:hover:bg-teal-950/50 transition-colors">
                    <svg class="w-8 h-8 text-[#009488] mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                    </svg>
                    <p class="text-xs font-bold text-slate-700 dark:text-slate-200">Click to upload or drag & drop</p>
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">PDF, PNG, JPG or DOCX (Max 25 MB)</p>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => _showUploadModal = false" class="px-4 py-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-[#142025] border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-all cursor-pointer">Cancel</button>
            <button type="button" @onclick="SaveMaterial" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Upload & Publish</span>
            </button>
        </FooterTemplate>
    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL: View Material Detail -->
<!-- ========================================================================= -->
@if (_detailItem != null)
{
    <Modal IsOpen="true"
           Title="@_detailItem.Title"
           Subtitle="@($"{_detailItem.Subject} • {_detailItem.BatchName}")"
           MaxWidth="max-w-md"
           OnClose="() => _detailItem = null">
        <ChildContent>
            <div class="space-y-4">
                <p class="text-xs text-slate-600 dark:text-slate-300">@_detailItem.Description</p>
                <div class="bg-slate-50 dark:bg-[#18262c] p-3.5 rounded-2xl space-y-2 text-xs border border-slate-100 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">File Type & Size</span>
                        <span class="font-bold text-slate-800 dark:text-white">@_detailItem.FileType (@_detailItem.FileSize)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Uploaded By</span>
                        <span class="font-bold text-slate-800 dark:text-white">@_detailItem.UploadedBy</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Upload Date</span>
                        <span class="font-bold text-slate-800 dark:text-white">@_detailItem.UploadDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Total Downloads</span>
                        <span class="font-bold text-emerald-600">@_detailItem.DownloadCount</span>
                    </div>
                </div>
            </div>
        </ChildContent>
        <FooterTemplate>
            <button type="button" @onclick="() => DownloadItem(_detailItem)"
                    class="inline-flex items-center gap-1.5 px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#009488] to-[#00796b] rounded-xl shadow-md border border-teal-400/30 transition-all cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span>Download Document</span>
            </button>
        </FooterTemplate>
    </Modal>
}

@code {
    private string _searchQuery = string.Empty;
