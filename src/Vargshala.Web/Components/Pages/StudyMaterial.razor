    };

    private readonly List<CustomSelect.CustomSelectOption> _batchFilterOptions = new()
    {
        new("", "All Batches"),
        new("Class 10 — Maths", "Class 10 — Maths"),
        new("Class 10 — Science", "Class 10 — Science"),
        new("Class 12 — Physics", "Class 12 — Physics"),
        new("Class 12 — Chemistry", "Class 12 — Chemistry"),
        new("IIT-JEE Morning Batch", "IIT-JEE Morning Batch")
    };

    private readonly List<CustomSelect.CustomSelectOption> _typeFilterOptions = new()
    {
        new("", "All Types"),
        new("PDF", "PDF Documents"),
        new("Image", "Images & Diagrams")
    };

    private readonly List<StudyMaterialDto> _materials = new()
    {
        new() { Title = "Kinematics & Dynamics Formula Sheet", Subject = "Physics", BatchName = "Class 12 — Physics", FileType = "PDF", FileSize = "3.2 MB", Description = "Complete derivations and formula list for JEE Mains & Advanced revision.", Tags = new() { "Formulas", "JEE", "Mechanics" }, UploadedBy = "Rajesh Verma", UploadDate = new DateTime(2026, 8, 28), DownloadCount = 142 },
        new() { Title = "Organic Chemistry Reactions Mindmap", Subject = "Chemistry", BatchName = "Class 12 — Chemistry", FileType = "PDF", FileSize = "4.8 MB", Description = "Flowchart covering Aldehydes, Ketones, and Carboxylic acid pathways.", Tags = new() { "Mindmap", "Organic", "Reactions" }, UploadedBy = "Sunita Gupta", UploadDate = new DateTime(2026, 8, 25), DownloadCount = 98 },
        new() { Title = "Trigonometry Quick Reference Table", Subject = "Mathematics", BatchName = "Class 10 — Maths", FileType = "PDF", FileSize = "1.1 MB", Description = "Values table and standard trigonometric identities for Class 10 board exam.", Tags = new() { "Trigonometry", "NCERT", "Class10" }, UploadedBy = "Dr. Priya Sharma", UploadDate = new DateTime(2026, 8, 20), DownloadCount = 210 },
        new() { Title = "Human Anatomy & Cell Biology Diagrams", Subject = "Biology", BatchName = "NEET Evening Batch", FileType = "Image", FileSize = "5.6 MB", Description = "High resolution labelled diagrams for NEET 2027 preparation.", Tags = new() { "NEET", "Diagrams", "Botany" }, UploadedBy = "Dr. Kavita Reddy", UploadDate = new DateTime(2026, 8, 15), DownloadCount = 185 },
        new() { Title = "Electrostatics Class Notes — Complete", Subject = "Physics", BatchName = "Class 12 — Physics", FileType = "PDF", FileSize = "6.4 MB", Description = "Handwritten classroom notes including solved numericals from HC Verma.", Tags = new() { "Handwritten", "HCV", "Numericals" }, UploadedBy = "Rajesh Verma", UploadDate = new DateTime(2026, 8, 10), DownloadCount = 312 },
        new() { Title = "Quadratic Equations Problem Set with Solutions", Subject = "Mathematics", BatchName = "Class 10 — Maths", FileType = "PDF", FileSize = "2.3 MB", Description = "50 standard problems categorized by difficulty level (Easy, Medium, Tough).", Tags = new() { "Problems", "Solutions" }, UploadedBy = "Dr. Priya Sharma", UploadDate = new DateTime(2026, 8, 5), DownloadCount = 160 }
    };

    private List<StudyMaterialDto> FilteredMaterials
    {
        get
        {
            var query = _materials.Where(m =>
                (string.IsNullOrWhiteSpace(_searchQuery) ||
                 m.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 m.UploadedBy.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 m.Tags.Any(t => t.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrWhiteSpace(_filterSubject) || m.Subject == _filterSubject) &&
                (string.IsNullOrWhiteSpace(_filterBatch) || m.BatchName == _filterBatch) &&
                (string.IsNullOrWhiteSpace(_filterType) || m.FileType == _filterType)
            );

            if (_sortState.IsSorted)
            {
                query = _sortState.Column switch
                {
                    "Title" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(m => m.Title) : query.OrderByDescending(m => m.Title),
                    "Subject" => _sortState.Direction == SortDirection.Ascending ? query.OrderBy(m => m.Subject) : query.OrderByDescending(m => m.Subject),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private void OpenUploadModal()
    {
        _uploadModel = new StudyMaterialDto
        {
            Subject = "Physics",
            BatchName = "Class 12 — Physics",
            UploadedBy = "Dr. Priya Sharma"
        };
        _showUploadModal = true;
    }

    private void SaveMaterial()
    {
        if (string.IsNullOrWhiteSpace(_uploadModel.Title)) return;
        _uploadModel.Id = Guid.NewGuid();
        _uploadModel.UploadDate = DateTime.Today;
        _uploadModel.DownloadCount = 0;
        _uploadModel.Status = "Published";
        _materials.Insert(0, _uploadModel);
        _showUploadModal = false;
    }

    private void OpenDetailModal(StudyMaterialDto item)
    {
        _detailItem = item;
    }

    private void DownloadItem(StudyMaterialDto item)
    {
        item.DownloadCount++;
    }
}
