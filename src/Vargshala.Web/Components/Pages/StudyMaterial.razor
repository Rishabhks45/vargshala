    private string _filterType = string.Empty;
    private string _viewMode = "grid";
    private readonly TableSortState _sortState = new();

    private bool _showUploadModal = false;
    private StudyMaterialDto _uploadModel = new();
    private StudyMaterialDto? _detailItem;

    private readonly List<CustomSelect.CustomSelectOption> _subjectFilterOptions = new()
    {
        new("", "All Subjects"),
        new("Physics", "Physics"),
        new("Chemistry", "Chemistry"),
        new("Mathematics", "Mathematics"),
