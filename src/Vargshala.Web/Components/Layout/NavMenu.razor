@inject IAuthService AuthService

<aside class="@GetAsideClass()">
    
    <!-- Top Brand Header: Logo.svg + BrandText.svg when expanded, Logo.svg when collapsed -->
    <div class="@GetHeaderClass()">
        @if (!IsCollapsed)
        {
            <a href="/" class="flex items-center gap-2.5 overflow-hidden py-1 group" title="Vargshala Institute SaaS">
                <img src="images/Logo.svg" 
                     alt="Vargshala" 
                     class="w-10 h-10 shrink-0 object-contain drop-shadow-md transition-transform duration-200 group-hover:scale-105" />
                <img src="images/BrandText.svg" 
                     alt="Vargshala Institute SaaS" 
                     class="h-9 w-auto object-contain drop-shadow-sm transition-transform duration-200 group-hover:scale-[1.02]" />
            </a>
        }
        else
        {
            <!-- Always Visible Centered Brand Logo in Collapsed Icon Mode -->
            <a href="/" class="flex items-center justify-center" title="Vargshala Institute SaaS">
                <img src="images/Logo.svg" 
                     alt="Vargshala" 
                     class="w-10 h-10 shrink-0 cursor-pointer object-contain drop-shadow-md transition-transform duration-200 hover:scale-105" />
            </a>
        }
    </div>

    <!-- Navigation Menu Items (Compact - Hidden Scrollbar) -->
    <nav class="flex-1 px-2.5 py-2 space-y-0.5 overflow-y-auto overflow-x-hidden no-scrollbar relative z-10 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <!-- SuperAdmin & BackOffice Platform Navigation Menu (6 Items) -->
