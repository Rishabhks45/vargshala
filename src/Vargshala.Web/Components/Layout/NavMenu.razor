<aside class="@GetAsideClass()">
    
    <!-- Top Brand Header: Always Shows Logo (Both Expanded & Collapsed) -->
    <div class="@GetHeaderClass()">
        @if (!IsCollapsed)
        {
            <div class="flex items-center gap-3 overflow-hidden">
                <img src="images/vargshala-logo.png" alt="Vargshala" class="w-9 h-9 rounded-full shadow-md shrink-0 object-contain drop-shadow-sm" />
                <div class="min-w-0">
                    <div class="font-extrabold text-base tracking-tight leading-tight flex items-center">
                        <span class="text-white">Varg</span><span class="text-[#2DD4BF]">shala</span>
                    </div>
                    <p class="text-[9px] text-teal-200/80 uppercase tracking-wider">Institute SaaS</p>
                </div>
            </div>
        }
        else
        {
            <!-- Always Visible Centered Brand Logo in Collapsed Icon Mode -->
            <img src="images/vargshala-logo.png" alt="Vargshala" class="w-9 h-9 rounded-full shadow-md shrink-0 cursor-pointer object-contain drop-shadow-sm" title="Vargshala Institute SaaS" />
        }
    </div>

    <!-- Navigation Menu Items (Compact - Hidden Scrollbar) -->
    <nav class="flex-1 px-2.5 py-2 space-y-0.5 overflow-y-auto overflow-x-hidden no-scrollbar relative z-10 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <!-- Dashboard -->
        <NavLink class="@GetNavLinkClass()" 
                 href="" 
                 Match="NavLinkMatch.All" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Dashboard" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Dashboard</span>
            }
        </NavLink>

        <!-- Students -->
        <NavLink class="@GetNavLinkClass()" 
                 href="students" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Students" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Students</span>
            }
        </NavLink>

        <!-- Teachers -->
        <NavLink class="@GetNavLinkClass()" 
                 href="teachers" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Teachers" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Teachers</span>
            }
        </NavLink>

        <!-- Classes -->
        <NavLink class="@GetNavLinkClass()" 
                 href="batches" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Classes" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Classes</span>
            }
        </NavLink>

        <!-- Attendance -->
        <NavLink class="@GetNavLinkClass()" 
                 href="attendance" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Attendance" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Attendance</span>
            }
        </NavLink>

        <!-- Exam & Quizzes -->
        <NavLink class="@GetNavLinkClass()" 
                 href="exams" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Exam & Quizzes" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Exam & Quizzes</span>
            }
        </NavLink>

        <!-- Assignments -->
        <NavLink class="@GetNavLinkClass()" 
                 href="assignments" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Assignments" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Assignments</span>
            }
        </NavLink>

        <!-- Study Material -->
        <NavLink class="@GetNavLinkClass()" 
                 href="study-material" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Study Material" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Study Material</span>
            }
        </NavLink>

        <!-- Timetable -->
        <NavLink class="@GetNavLinkClass()" 
                 href="timetable" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Timetable" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Timetable</span>
            }
        </NavLink>

        <!-- Fees -->
        <NavLink class="@GetNavLinkClass()" 
                 href="fees" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Fees" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Fees</span>
            }
        </NavLink>

        <!-- Reports -->
        <NavLink class="@GetNavLinkClass()" 
                 href="reports" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Reports" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Reports</span>
            }
        </NavLink>

        <!-- Masters -->
        <NavLink class="@GetNavLinkClass()" 
                 href="masters" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Masters" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Masters</span>
            }
        </NavLink>

        <!-- Notices -->
        <NavLink class="@GetNavLinkClass()" 
                 href="notices" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Notices" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Notices</span>
            }
        </NavLink>

        <!-- Chat -->
        <NavLink class="@GetNavLinkClass()" 
                 href="messages" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Chat" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Messages</span>
            }
        </NavLink>

        <!-- Events -->
        <NavLink class="@GetNavLinkClass()" 
                 href="events" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Events" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2zM12 14v4m-2-2h4"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Events</span>
            }
        </NavLink>

        <!-- Settings -->
        <NavLink class="@GetNavLinkClass()" 
                 href="settings" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Settings" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Settings</span>
            }
        </NavLink>

        <!-- Contact Support -->
        <NavLink class="@GetNavLinkClass()" 
                 href="contact" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Contact" : "")">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Contact Support</span>
            }
        </NavLink>
    </nav>

    <!-- Plant & Books Watermark Shadow (Absolute Behind Menu Items) -->
    @if (!IsCollapsed)
    {
        <div class="absolute bottom-12 left-0 right-0 pointer-events-none flex justify-center z-0 overflow-hidden pb-1">
            <img src="images/plant-books.png" 
                 alt="Learning Growth" 
                 class="w-44 h-36 object-contain object-bottom opacity-15 filter brightness-110 contrast-125 select-none pointer-events-none" />
        </div>
    }

    <!-- Fixed Bottom Collapse/Expand Toggle Button Bar -->
    <div class="p-2 border-t border-teal-800/40 shrink-0 flex items-center @(IsCollapsed ? "justify-center" : "justify-between") bg-[#00382E] relative z-10">
        @if (!IsCollapsed)
        {
            <span class="text-[11px] font-semibold text-teal-200/80 pl-2">Collapse Menu</span>
            <button type="button" 
                    @onclick="ToggleCollapse" 
                    class="p-1.5 rounded-lg text-teal-200 hover:text-white hover:bg-white/10 transition-all active:scale-95"
                    title="Collapse Sidebar (Icon Only)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M16 8.5l-3.5 3.5 3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }
        else
        {
            <!-- Expand Button at Bottom in Collapsed Mode -->
            <button type="button" 
                    @onclick="ToggleCollapse" 
                    class="p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-all active:scale-95"
                    title="Expand Sidebar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M12.5 8.5l3.5 3.5-3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }
    </div>

</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private string GetAsideClass() =>
        $"flex flex-col {(IsCollapsed ? "w-16" : "w-60")} h-screen max-h-screen sticky top-0 bg-[#004D40] text-teal-100 transition-all duration-300 ease-in-out shrink-0 select-none border-none overflow-hidden justify-between relative";

    private string GetHeaderClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center px-2" : "justify-start px-4")} h-16 border-none shrink-0";

    private string GetNavLinkClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center p-2.5" : "gap-3 px-3.5 py-2")} rounded-xl text-xs font-medium transition-all text-teal-100 hover:text-white hover:bg-white/10 group relative";

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }
}
