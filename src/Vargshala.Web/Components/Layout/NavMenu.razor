<aside class="@GetAsideClass()">
    
    <!-- Brand Header & Collapse Toggle -->
    <div class="@GetHeaderClass()">
        @if (!IsCollapsed)
        {
            <div class="flex items-center gap-3 overflow-hidden">
                <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-amber-400 text-slate-900 font-extrabold text-lg shadow-sm shrink-0">
                    <svg class="w-5 h-5 text-teal-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="font-bold text-lg text-white tracking-tight leading-tight">
                        Vargshala
                    </div>
                    <p class="text-[10px] text-teal-200/80 uppercase tracking-wider">Institute SaaS</p>
                </div>
            </div>

            <!-- Exact Sidebar Toggle Icon (Collapse <) -->
            <button type="button" 
                    @onclick="ToggleCollapse" 
                    class="p-1.5 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-all active:scale-95"
                    title="Collapse Sidebar (Icon Only)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M16 8.5l-3.5 3.5 3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }
        else
        {
            <!-- Exact Sidebar Toggle Icon (Expand >) -->
            <button type="button" 
                    @onclick="ToggleCollapse" 
                    class="p-2 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-all active:scale-95"
                    title="Expand Sidebar">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M12.5 8.5l3.5 3.5-3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        }
    </div>

    <!-- Navigation Menu Items -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto overflow-x-hidden relative z-10">
        
        <!-- Dashboard -->
        <NavLink class="@GetNavLinkClass()" 
                 href="" 
                 Match="NavLinkMatch.All" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Dashboard" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Dashboard</span>
            }
        </NavLink>

        <!-- Students -->
        <NavLink class="@GetNavLinkClass()" 
                 href="students" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Students" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Students</span>
            }
        </NavLink>

        <!-- Teachers -->
        <NavLink class="@GetNavLinkClass()" 
                 href="teachers" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Teachers" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Teachers</span>
            }
        </NavLink>

        <!-- Classes -->
        <NavLink class="@GetNavLinkClass()" 
                 href="batches" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Classes" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Classes</span>
            }
        </NavLink>

        <!-- Attendance -->
        <NavLink class="@GetNavLinkClass()" 
                 href="attendance" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Attendance" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Attendance</span>
            }
        </NavLink>

        <!-- Exams -->
        <NavLink class="@GetNavLinkClass()" 
                 href="exams" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Exams" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Exams</span>
            }
        </NavLink>

        <!-- Assignments -->
        <NavLink class="@GetNavLinkClass()" 
                 href="assignments" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Assignments" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Assignments</span>
            }
        </NavLink>

        <!-- Fees -->
        <NavLink class="@GetNavLinkClass()" 
                 href="fees" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Fees" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Fees</span>
            }
        </NavLink>

        <!-- Messages -->
        <NavLink class="@GetNavLinkClass()" 
                 href="messages" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Messages" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Messages</span>
            }
        </NavLink>

        <!-- Reports -->
        <NavLink class="@GetNavLinkClass()" 
                 href="reports" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Reports" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Reports</span>
            }
        </NavLink>

        <!-- Settings -->
        <NavLink class="@GetNavLinkClass()" 
                 href="settings" 
                 ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                 title="@(IsCollapsed ? "Settings" : "")">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="truncate">Settings</span>
            }
        </NavLink>
    </nav>

    <!-- Bottom Plant & Books Illustration (Matching Theme 4) -->
    @if (!IsCollapsed)
    {
        <div class="px-4 pt-1 pb-3 opacity-30 hover:opacity-50 transition-opacity pointer-events-none flex justify-center shrink-0">
            <img src="images/plant-books.png" alt="Learning Growth" class="w-32 h-auto object-contain drop-shadow-md" />
        </div>
    }

</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private string GetAsideClass() =>
        $"flex flex-col {(IsCollapsed ? "w-20" : "w-64")} min-h-screen bg-[#004D40] text-teal-100 transition-all duration-300 ease-in-out shrink-0 select-none shadow-xl border-r border-teal-800/40 relative overflow-hidden";

    private string GetHeaderClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center px-2" : "justify-between px-5")} py-4 border-b border-teal-800/60 h-16 shrink-0";

    private string GetNavLinkClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center p-3" : "gap-3 px-4 py-2.5")} rounded-xl text-sm font-medium transition-all text-teal-100 hover:text-white hover:bg-white/10 group relative";

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }
}
