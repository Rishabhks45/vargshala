                                class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-medium text-teal-100 hover:text-white hover:bg-white/10 transition-all cursor-pointer">
                            <div class="flex items-center gap-3">
                                <svg class="w-4 h-4 shrink-0 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                                </svg>
                                <span class="truncate">Fees & Payments</span>
                            </div>
                            <svg class="w-3.5 h-3.5 text-teal-300/80 transition-transform duration-200 @(_activeStudentMenu == "fees" ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        @if (_activeStudentMenu == "fees")
                        {
                            <div class="pl-8 space-y-0.5 py-0.5 animate-in fade-in slide-in-from-top-1 duration-150">
                                <NavLink class="@GetSubNavLinkClass()" href="student/fees" ActiveClass="text-white font-bold bg-white/10">Fee Details</NavLink>
                                <NavLink class="@GetSubNavLinkClass()" href="student/fees/pay" ActiveClass="text-white font-bold bg-white/10">Pay Fees</NavLink>
                                <NavLink class="@GetSubNavLinkClass()" href="student/fees/history" ActiveClass="text-white font-bold bg-white/10">Payment History</NavLink>
                                <NavLink class="@GetSubNavLinkClass()" href="student/fees/receipts" ActiveClass="text-white font-bold bg-white/10">Receipts</NavLink>
                            </div>
                        }
                    </div>
                }

                <!-- 7. Messages -->
                <NavLink class="@GetNavLinkClass()" 
                         href="messages" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Messages" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Messages</span>
                    }
                </NavLink>

                <!-- 8. Notifications -->
                <NavLink class="@GetNavLinkClass()" 
                         href="student/notifications" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Notifications" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Notifications</span>
                    }
                </NavLink>

                <!-- 8. My Profile -->
                <NavLink class="@GetNavLinkClass()" 
                         href="profile" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "My Profile" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">My Profile</span>
                    }
                </NavLink>

                <!-- 9. Settings -->
                <NavLink class="@GetNavLinkClass()" 
                         href="settings" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Settings" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Settings</span>
                    }
                </NavLink>

                <!-- 10. Logout -->
                <button type="button" @onclick="HandleStudentLogout"
                        class="@GetNavLinkClass() w-full text-rose-300 hover:text-white hover:bg-rose-900/30 cursor-pointer"
                        title="@(IsCollapsed ? "Logout" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Logout</span>
                    }
                </button>
            </Authorized>
        </AuthorizeView>
    </nav>

    <!-- Plant & Books Watermark Shadow with "Learn Today, Grow Tomorrow" -->
    @if (!IsCollapsed)
    {
        <div class="px-4 pb-4 pt-1 select-none z-10 leading-tight relative">
            <div class="text-xs font-semibold text-teal-200/90">Learn Today,</div>
            <div class="text-xs font-bold text-teal-300">Grow Tomorrow</div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 pointer-events-none flex justify-center z-0 overflow-hidden pb-1">
            <img src="images/plant-books.png" 
                 alt="Learning Growth" 
                 class="w-54 h-46 object-contain object-bottom opacity-15 filter brightness-110 contrast-125 select-none pointer-events-none" />
        </div>
    }

</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private string? _activeStudentMenu = "learning";

    private void ToggleStudentMenu(string menu)
    {
        _activeStudentMenu = _activeStudentMenu == menu ? null : menu;
    }

    private string GetAsideClass() =>
        $"flex flex-col {(IsCollapsed ? "w-16" : "w-60")} h-screen max-h-screen sticky top-0 bg-[#004D40] text-teal-100 transition-all duration-300 ease-in-out shrink-0 select-none border-none overflow-hidden justify-between relative";

    private string GetHeaderClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center px-2" : "justify-start px-3")} h-16 border-none shrink-0";

    private string GetNavLinkClass() =>
        $"flex items-center {(IsCollapsed ? "justify-center p-2.5" : "gap-3 px-3.5 py-2")} rounded-xl text-xs font-medium transition-all text-teal-100 hover:text-white hover:bg-white/10 group relative";

    private string GetSubNavLinkClass() =>
        "block px-3 py-1.5 rounded-lg text-xs font-medium transition-colors text-teal-200/90 hover:text-white hover:bg-white/10 truncate";

    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private async Task HandleStudentLogout()
    {
        await AuthService.LogoutAsync();
    }
}
