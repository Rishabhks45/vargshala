<aside class="@GetAsideClass()">
    
    <!-- Top Brand Header: Always Shows Logo (Both Expanded & Collapsed) -->
    <div class="@GetHeaderClass()">
        @if (!IsCollapsed)
        {
            <div class="flex items-center gap-3 overflow-hidden">
                <img src="images/vargshala-logo.png" alt="Vargshala" class="w-9 h-9 rounded-full shadow-md shrink-0 object-contain drop-shadow-sm" />
                <div class="min-w-0">
                    <div class="font-extrabold text-base tracking-tight leading-tight flex items-center">
                        <span class="text-white">Varg</span><span class="text-[#2DD4BF]">shala</span>
                    </div>
                    <p class="text-[9px] text-teal-200/80 uppercase tracking-wider">Institute SaaS</p>
                </div>
            </div>
        }
        else
        {
            <!-- Always Visible Centered Brand Logo in Collapsed Icon Mode -->
            <img src="images/vargshala-logo.png" alt="Vargshala" class="w-9 h-9 rounded-full shadow-md shrink-0 cursor-pointer object-contain drop-shadow-sm" title="Vargshala Institute SaaS" />
        }
    </div>

    <!-- Navigation Menu Items (Compact - Hidden Scrollbar) -->
    <nav class="flex-1 px-2.5 py-2 space-y-0.5 overflow-y-auto overflow-x-hidden no-scrollbar relative z-10 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
        
        <!-- SuperAdmin & BackOffice Platform Navigation Menu (6 Items) -->
        <AuthorizeView Roles="SuperAdmin,BackOffice" Context="superAdminNavContext">
            <Authorized>
                <!-- 1. Platform -->
                <NavLink class="@GetNavLinkClass()" 
                         href="controlpanel/platform" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Platform" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Platform</span>
                    }
                </NavLink>

                <!-- 2. Institutes -->
                <NavLink class="@GetNavLinkClass()" 
                         href="controlpanel/institutes" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Institutes" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Institutes</span>
                    }
                </NavLink>

                <!-- Users (OrgAdmin & BackOffice) -->
                <NavLink class="@GetNavLinkClass()" 
                         href="controlpanel/users" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Users" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Users</span>
                    }
                </NavLink>

                <!-- 3. Subscriptions -->
