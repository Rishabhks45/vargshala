                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Email Templates</span>
                    }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <!-- Institute Staff Navigation (OrganizationAdmin, BranchAdmin & Teacher) -->
