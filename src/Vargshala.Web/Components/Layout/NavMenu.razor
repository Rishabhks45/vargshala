                         href="controlpanel/push" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Push" : "")">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span class="truncate">Push</span>
                    }
                </NavLink>

                <!-- 5. Logs -->
                <NavLink class="@GetNavLinkClass()" 
                         href="controlpanel/logs" 
                         ActiveClass="bg-[#009488] text-white shadow-sm font-semibold hover:bg-[#009488]"
                         title="@(IsCollapsed ? "Logs" : "")">
