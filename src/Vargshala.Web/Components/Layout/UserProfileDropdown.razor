@namespace Vargshala.Web.Components.Layout
@implements IDisposable
@inject IAuthService AuthService
@inject IUserService UserService
@inject NavigationManager Navigation

<!-- User Profile Pill & Dropdown -->
<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var profile = UserService.CurrentProfile;
            var name = profile != null && !string.IsNullOrWhiteSpace(profile.FirstName)
                ? $"{profile.FirstName} {profile.LastName}".Trim()
                : user.Identity?.Name ?? "User";
            var role = profile != null
                ? profile.Role.GetDisplayName()
                : RoleNavigationHelper.GetRoleDisplayName(user);
            var email = profile?.Email ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            var orgName = profile?.OrganizationName ?? user.FindFirst("OrganizationName")?.Value;
            var roleStr = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                       ?? user.FindFirst("role")?.Value 
                       ?? user.FindFirst("Role")?.Value;
            var isOrgAdmin = (profile != null && profile.Role == UserRole.OrganizationAdmin)
                          || user.IsInRole("OrganizationAdmin") || user.IsInRole("1") 
                          || string.Equals(roleStr, "OrganizationAdmin", StringComparison.OrdinalIgnoreCase) 
                          || roleStr == "1";
            var avatarUrl = profile?.ProfilePictureUrl;
            var nameParts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var initials = nameParts.Length > 0 
                ? string.Concat(nameParts.Take(2).Select(w => char.ToUpperInvariant(w[0]))) 
                : "U";
        }
        <div class="relative inline-flex items-center">
            <!-- Trigger Button (Clean, no background/border box on hover) -->
            <button type="button" @onclick="ToggleMenu"
                    class="group flex items-center gap-2.5 py-1 px-1 bg-transparent border-0 outline-hidden cursor-pointer select-none transition-transform active:scale-95"
                    aria-expanded="@_isOpen"
                    aria-haspopup="true"
                    aria-label="User menu for @name">
                
                <!-- Avatar with subtle scale on hover, no outer box -->
                <div class="w-8 h-8 rounded-xl text-white overflow-hidden shrink-0 flex items-center justify-center font-bold text-xs shadow-sm ring-1 ring-white/20 group-hover:ring-white/60 group-hover:scale-105 transition-all duration-150"
                     style="background: linear-gradient(135deg, var(--theme-primary, #009488), var(--theme-header, #004D40));">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        @initials
                    }
                </div>

                <!-- User text details -->
                <div class="hidden md:block text-left">
                    <p class="text-xs font-bold text-white leading-tight group-hover:text-white/90 transition-colors">@name</p>
                    <p class="text-[10px] font-medium transition-colors"
                       style="color: color-mix(in srgb, var(--theme-primary-light, #14b8a6) 75%, white);">@role</p>
                </div>

               
            </button>

            <!-- Floating Redesigned User Popup Card -->
            @if (_isOpen)
            {
                <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>
                <div class="absolute right-0 top-full mt-2.5 w-72 sm:w-76 rounded-2xl bg-white/95 dark:bg-[#111c21]/95 border border-slate-200/80 dark:border-slate-800 shadow-2xl shadow-slate-900/15 dark:shadow-black/60 p-2 z-50 animate-in fade-in zoom-in-95 duration-150 text-left backdrop-blur-xl ring-1 ring-black/5 dark:ring-white/10 select-none">
                    
                    <!-- User Profile Header Card -->
                    <div class="p-3 rounded-xl border border-slate-200/70 dark:border-slate-800/80 mb-1.5 relative overflow-hidden user-popup-header">
                        <!-- Ambient subtle theme glow -->
                        <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full pointer-events-none opacity-20 blur-xl"
                             style="background-color: var(--theme-primary, #009488);"></div>

                        <div class="flex items-center gap-3 relative z-10">
                            <div class="w-11 h-11 rounded-xl text-white overflow-hidden shrink-0 flex items-center justify-center font-extrabold text-sm shadow-sm ring-2 ring-white/90 dark:ring-slate-700"
                                 style="background: linear-gradient(135deg, var(--theme-primary, #009488), var(--theme-header, #004D40));">
                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="@name" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @initials
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-900 dark:text-white truncate leading-snug" title="@name">@name</p>
                                <div class="flex items-center gap-1.5 mt-1">
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] font-extrabold tracking-wide uppercase bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300 border border-emerald-500/20 shadow-2xs">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        @role
                                    </span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400 mt-2.5 pt-2 border-t border-slate-200/70 dark:border-slate-800 relative z-10" title="@email">
                                <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                                <span class="truncate font-medium">@email</span>
                            </div>
                        }

                        @if (isOrgAdmin && !string.IsNullOrWhiteSpace(orgName))
                        {
                            <div class="flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-300 mt-1.5 relative z-10" title="@orgName">
                                <div class="w-3.5 h-3.5 flex items-center justify-center shrink-0"
                                     style="color: var(--theme-primary, #009488);">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                </div>
                                <span class="truncate font-semibold text-slate-800 dark:text-slate-200">@orgName</span>
                            </div>
                        }
                    </div>

                    <!-- Navigation Links -->
                    <div class="space-y-0.5">
                        <!-- My Profile Link -->
                        <a href="profile" @onclick="CloseMenu"
                           class="group flex items-center justify-between w-full px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100/90 dark:hover:bg-slate-800/80 hover:text-slate-950 dark:hover:text-white transition-all cursor-pointer">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-teal-500/10 dark:group-hover:bg-teal-400/10 group-hover:text-[var(--theme-primary,#009488)] transition-colors">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <span>My Profile</span>
                            </div>
                            <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </a>

                        <!-- Institute Settings Link (ONLY FOR ORG ADMIN) -->
                        @if (isOrgAdmin)
                        {
                            <a href="settings" @onclick="CloseMenu"
                               class="group flex items-center justify-between w-full px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100/90 dark:hover:bg-slate-800/80 hover:text-slate-950 dark:hover:text-white transition-all cursor-pointer">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-teal-500/10 dark:group-hover:bg-teal-400/10 group-hover:text-[var(--theme-primary,#009488)] transition-colors">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                        </svg>
                                    </div>
                                    <span>Institute Settings</span>
                                </div>
                                <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        }
                    </div>

                    <div class="my-1 border-t border-slate-100 dark:border-slate-800/80"></div>

                    <!-- Sign Out Button -->
                    <button type="button" @onclick="HandleSignOut"
                            class="group flex items-center justify-between w-full px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-700 dark:hover:text-rose-300 transition-all cursor-pointer">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/50 group-hover:bg-rose-100 dark:group-hover:bg-rose-900/60 flex items-center justify-center text-rose-500 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                </svg>
                            </div>
                            <span>Sign Out</span>
                        </div>
                        <svg class="w-3.5 h-3.5 text-rose-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/login" class="text-xs font-bold text-white bg-[#009488] px-3.5 py-2 rounded-xl shadow-xs hover:bg-[#00a89a] transition-all">
            Sign In
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _isOpen = false;

    protected override async Task OnInitializedAsync()
    {
        UserService.OnProfileUpdated += HandleProfileUpdated;

        if (UserService.CurrentProfile == null)
        {
            await UserService.GetMyProfileAsync();
        }
    }

    private void HandleProfileUpdated(UserDto updatedProfile)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _isOpen = !_isOpen;
    private void CloseMenu() => _isOpen = false;

    private async Task HandleSignOut()
    {
        _isOpen = false;
        await AuthService.LogoutAsync();
    }

    public void Dispose()
    {
        UserService.OnProfileUpdated -= HandleProfileUpdated;
    }
}
