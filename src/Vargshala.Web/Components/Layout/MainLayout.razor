@implements IDisposable
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IUserService UserService
@inject IBranchContextService BranchContext

<div class="flex h-screen max-h-screen w-screen overflow-hidden theme-shell-bg font-sans text-slate-800 antialiased select-none" style="background-color: var(--theme-header, #004D40);">
    
    <!-- Permanently Fixed Left Sidebar Navigation -->
    <NavMenu @bind-IsCollapsed="_sidebarCollapsed" />

    <!-- Right Shell: Fixed Header + Scrollable Main Content Canvas -->
    <div class="flex flex-col flex-1 h-screen max-h-screen min-w-0 theme-shell-bg overflow-hidden" style="background-color: var(--theme-header, #004D40);">
        
        <!-- Dynamic Themed Top Header -->
        <header class="h-16 shrink-0 z-30 flex items-center justify-between px-4 sm:px-6 theme-shell-bg text-white border-none" style="background-color: var(--theme-header, #004D40);">
            
            <!-- Left: Sidebar Toggle + Dynamic Page Title & Organization Name -->
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <!-- Hamburger Toggle Button for Sidebar -->
                <button type="button" 
                        @onclick="() => _sidebarCollapsed = !_sidebarCollapsed"
                        class="p-0 -ml-1.5 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-all cursor-pointer"
                        title="@(_sidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">                   
                    @if(_sidebarCollapsed)
                    {
                  

                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M12.5 8.5l3.5 3.5-3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                    }
                    else
                    {
                           <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M16 8.5l-3.5 3.5 3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                    }
                </button>

                <!-- Dynamic Page Title & Organization Subtitle -->
                <div class="flex flex-col justify-center min-w-0">
                    <h1 class="text-base sm:text-lg font-extrabold text-white tracking-tight leading-tight truncate">
                        @GetCurrentPageTitle()
                    </h1>
                    <AuthorizeView>
                        <Authorized>
                            @{
                                var orgName = context.User.FindFirst("OrganizationName")?.Value;
                                var roleStr = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                                           ?? context.User.FindFirst("role")?.Value 
                                           ?? context.User.FindFirst("Role")?.Value;
                                var profile = UserService.CurrentProfile;
                                var isOrgAdmin = (profile != null && profile.Role == UserRole.OrganizationAdmin)
                                              || context.User.IsInRole("OrganizationAdmin") || context.User.IsInRole("1") 
                                              || string.Equals(roleStr, "OrganizationAdmin", StringComparison.OrdinalIgnoreCase) 
                                              || roleStr == "1";
                                var branchName = isOrgAdmin && BranchContext.IsInitialized
                                    ? (BranchContext.IsAllBranches ? "All Branches" : BranchContext.CurrentBranch?.Name)
                                    : context.User.FindFirst("BranchName")?.Value;
                                var role = RoleNavigationHelper.GetRoleDisplayName(context.User);
                            }
                            <p class="text-[11px] text-teal-200/90 font-medium truncate flex items-center gap-1.5">
                                @if (!string.IsNullOrWhiteSpace(orgName))
                                {
                                    <span class="font-bold text-white">@orgName</span>
                                    <span class="text-teal-400/80">•</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(branchName))
                                {
                                    <span class="text-teal-200 font-medium">@branchName</span>
                                    <span class="text-teal-400/80">•</span>
                                }
                                <span class="text-amber-300 font-semibold text-[10px]">@role</span>
                            </p>
                        </Authorized>
                        <NotAuthorized>
                            <p class="text-[11px] text-teal-200/80 font-medium">
                                Vargshala SaaS Portal
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <!-- Top Right Profile, Notification & Theme Controls -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                
                <!-- Branch Selector for Organization Admin -->
                <AuthorizeView>
                    <Authorized>
                        @{
                            var roleStr = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                                       ?? context.User.FindFirst("role")?.Value 
                                       ?? context.User.FindFirst("Role")?.Value;
                            var profile = UserService.CurrentProfile;
                            var isOrgAdmin = (profile != null && profile.Role == UserRole.OrganizationAdmin)
                                          || context.User.IsInRole("OrganizationAdmin") || context.User.IsInRole("1") 
                                          || string.Equals(roleStr, "OrganizationAdmin", StringComparison.OrdinalIgnoreCase) 
                                          || roleStr == "1";
                        }
                        @if (isOrgAdmin && BranchContext.AvailableBranches.Any())
                        {
                            <BranchSelector />
                        }
                    </Authorized>
                </AuthorizeView>

                <!-- Dark / Light Mode Toggle Button -->
                <button type="button" 
                        onclick="window.toggleAppTheme()" 
                        class="p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-all cursor-pointer shadow-2xs"
                        title="Toggle Dark / Light Mode">
                    <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                    <svg class="w-5 h-5 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </button>

                <!-- Notification Bell with Alert Badge -->
                <button class="relative p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                        title="Notifications">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    <span class="absolute top-1.5 right-1.5 flex items-center justify-center w-2 h-2 bg-[#FB6868] rounded-full ring-2 ring-[#004D40]"></span>
                </button>

                <!-- Admin User Profile Pill & Dropdown Component -->
                <UserProfileDropdown />

            </div>
        </header>

        <!-- Page Body Canvas (20px Curved Top-Left Radius, Fits Screen Height) -->
        <main class="flex-1 flex flex-col theme-canvas-bg text-slate-800 dark:text-slate-100 rounded-tl-[20px] p-6 overflow-hidden min-h-0 shadow-inner select-text transition-colors duration-200 scrollbar-hidden"
              style="background-color: var(--theme-current-canvas, var(--theme-canvas-bg, #F0FDFA));">
            @Body
        </main>
    </div>

    <!-- Global Toast / Alert Notifications Container (Rendered last with z-index 99999 to guarantee visibility over drawers, sidebars & modals) -->
    <ToastContainer />
</div>

@code {
    private bool _sidebarCollapsed = false;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UserService.OnProfileUpdated += HandleProfileUpdated;
        BranchContext.OnBranchChanged += HandleBranchChangedAsync;

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                if (UserService.CurrentProfile == null)
                {
                    await UserService.GetMyProfileAsync();
                }

                var roleStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                           ?? authState.User.FindFirst("role")?.Value 
                           ?? authState.User.FindFirst("Role")?.Value;
                var profile = UserService.CurrentProfile;
                var isOrgAdmin = (profile != null && profile.Role == UserRole.OrganizationAdmin)
                              || authState.User.IsInRole("OrganizationAdmin") || authState.User.IsInRole("1") 
                              || string.Equals(roleStr, "OrganizationAdmin", StringComparison.OrdinalIgnoreCase) 
                              || roleStr == "1";

                if (isOrgAdmin)
                {
                    await BranchContext.InitializeAsync();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private Task HandleBranchChangedAsync()
    {
        return InvokeAsync(StateHasChanged);
    }

    private void HandleProfileUpdated(UserDto updatedProfile)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private string GetCurrentPageTitle()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        var cleanPath = relativePath.Split('?')[0].Trim('/');

        return cleanPath switch
        {
            "" => "Dashboard",
            "controlpanel" or "controlpanel/platform" => "Platform",
            "controlpanel/institutes" => "Institutes",
            "controlpanel/subscriptions" => "Subscriptions",
            "controlpanel/coupons" => "Coupons & Discounts",
            "controlpanel/payment-logs" or "controlpanel/payments" => "Payment Logs",
            "controlpanel/tenants" => "Institutes",
            "controlpanel/push" => "Push",
            "controlpanel/logs" => "Logs",
            "controlpanel/health" => "Health",
            "controlpanel/email-templates" or "controlpanel/templates" => "Email Templates",
            "controlpanel/users" => "Users",

            "student" or "student/home" => "Dashboard",
            "student/classes" => "My Classes",
            "student/batches" => "My Batches",
            "student/subjects" => "Subjects",
            "student/timetable" => "My Timetable",
            "student/attendance" => "Attendance",
            "student/study-material" => "Study Material",
            "student/tasks" => "Tasks",
            "student/quizzes" => "Quizzes",
            "student/progress" => "Progress",
            "student/report-card" => "Report Card",
            "student/fees" => "Fees",
            "student/chat" => "Chat",
            "student/events" => "Events",

            "branch" => "Branch Dashboard",
            "branch/students" => "Branch Students",
            "branch/teachers" => "Branch Faculty",
            "branch/classes" => "Branch Classes",
            "branch/batches" => "Branch Batches",
            "branch/batches/assign-teachers" => "Assign Faculty",
            "branch/class-sessions" => "Class Sessions",
            "branch/attendance" => "Branch Attendance",

            "students" => "Students Directory",
            "teachers" => "Teachers & Faculty",
            "branches" => "Branch Management",
            "batches" => "Classes & Batches",
            "attendance" => "Attendance Register",
            "exams" => "Exams & Quizzes",
            "assignments" => "Assignments",
            "study-material" => "Study Material",
            "timetable" => "Class Timetable",
            "fees" => "Fee Management",
            "reports" => "Reports & Analytics",
            "masters" => "Master Configurations",
            "notices" => "Notice Board",
            "messages" => "Messages & Chat",
            "events" => "Events & Calendar",
            "settings" => "Institute Settings",
            "contact" => "Contact Support",
            _ => cleanPath.StartsWith("controlpanel") ? "Platform" :
                 cleanPath.StartsWith("student") ? "Student Portal" : "Dashboard"
        };
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        UserService.OnProfileUpdated -= HandleProfileUpdated;
        BranchContext.OnBranchChanged -= HandleBranchChangedAsync;
    }
}
