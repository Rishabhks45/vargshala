@inherits LayoutComponentBase

<div class="flex h-screen max-h-screen w-screen overflow-hidden bg-[#004D40] font-sans text-slate-800 antialiased select-none">
    
    <!-- Permanently Fixed Left Sidebar Navigation -->
    <NavMenu @bind-IsCollapsed="_sidebarCollapsed" />

    <!-- Right Shell: Fixed Header + Scrollable Main Content Canvas -->
    <div class="flex flex-col flex-1 h-screen max-h-screen min-w-0 bg-[#004D40] overflow-hidden">
        
        <!-- Permanently Fixed Deep Teal Top Header (Locked in place, zero scrolling) -->
        <header class="h-16 shrink-0 z-30 flex items-center justify-between px-6 bg-[#004D40] text-white border-none">
            
            <!-- Left: Page Title & Coaching Institute Name + Address -->
            <div class="flex flex-col justify-center">
                <h1 class="text-lg font-bold text-white tracking-tight leading-tight outline-none focus:outline-none">
                    Dashboard
                </h1>
                <p class="text-xs text-teal-200/90 font-medium">
                    Vidya Mandir Coaching Institute <span class="text-teal-400/80">•</span> Jaipur, Rajasthan
                </p>
            </div>

            <!-- Top Right Profile & Notification Controls -->
            <div class="flex items-center gap-3">
                
                <!-- Dark / Light Mode Toggle Button -->
                <button type="button" 
                        onclick="window.toggleAppTheme()" 
                        class="p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-all cursor-pointer shadow-2xs"
                        title="Toggle Dark / Light Mode">
                    <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                    <svg class="w-5 h-5 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </button>

                <!-- Notification Bell with Coral Alert Badge -->
                <button class="relative p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    <span class="absolute top-1 right-1 flex items-center justify-center w-4 h-4 text-[9px] font-bold text-white bg-coral-500 rounded-full border-2 border-[#004D40]">
                        1
                    </span>
                </button>

                <!-- Admin User Profile Pill -->
                <div class="flex items-center gap-2.5 pl-2 cursor-pointer hover:opacity-95 transition-opacity">
                    <div class="w-9 h-9 rounded-full bg-slate-200 border border-teal-300 overflow-hidden shrink-0 flex items-center justify-center font-bold text-teal-800 text-xs shadow-sm">
                        RS
                    </div>
                    <div class="hidden sm:block text-left">
                        <p class="text-xs font-bold text-white leading-tight">Rishabh Sharma</p>
                        <p class="text-[10px] text-teal-200">Super Admin</p>
                    </div>
                    <svg class="w-3.5 h-3.5 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>

            </div>
        </header>

        <!-- Only Scrollable Area: Page Body Canvas (20px Curved Top-Left Radius) -->
        <main class="flex-1 bg-[#F4F9F8] dark:bg-[#0c1417] text-slate-800 dark:text-slate-100 rounded-tl-[20px] p-6 overflow-y-auto min-h-0 shadow-inner select-text transition-colors duration-200">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed = false;
}
