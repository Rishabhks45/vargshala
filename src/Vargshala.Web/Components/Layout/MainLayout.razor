@inherits LayoutComponentBase

<div class="flex min-h-screen bg-[#004D40] font-sans text-slate-800 antialiased overflow-hidden">
    <!-- Theme 4 Deep Teal Sidebar Navigation (With dedicated toggle button inside) -->
    <NavMenu @bind-IsCollapsed="_sidebarCollapsed" />

    <!-- Main Content Shell (Matching Deep Teal Header with Rounded Canvas) -->
    <div class="flex flex-col flex-1 min-w-0 bg-[#004D40]">
        <!-- Seamless Deep Teal Top Header (Zero Border) -->
        <header class="sticky top-0 z-30 flex items-center justify-between h-16 px-6 bg-[#004D40] text-white select-none border-none">
            
            <!-- Left: Page Title & Coaching Name + Address (Matching User Screenshot) -->
            <div class="flex flex-col justify-center">
                <h1 class="text-lg font-bold text-white tracking-tight leading-tight">
                    Dashboard
                </h1>
                <p class="text-xs text-teal-200/90 font-medium">
                    Vidya Mandir Coaching Institute <span class="text-teal-400/80">•</span> Jaipur, Rajasthan
                </p>
            </div>

            <!-- Top Right Profile & Notification Controls -->
            <div class="flex items-center gap-4">
                
                <!-- Notification Bell with Coral Badge Dot -->
                <button class="relative p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    <span class="absolute top-1 right-1 flex items-center justify-center w-4 h-4 text-[9px] font-bold text-white bg-coral-500 rounded-full border-2 border-[#004D40]">
                        1
                    </span>
                </button>

                <!-- Admin User Profile Pill -->
                <div class="flex items-center gap-2.5 pl-2 cursor-pointer hover:opacity-95 transition-opacity">
                    <div class="w-9 h-9 rounded-full bg-slate-200 border border-teal-300 overflow-hidden shrink-0 flex items-center justify-center font-bold text-teal-800 text-xs shadow-sm">
                        RS
                    </div>
                    <div class="hidden sm:block text-left">
                        <p class="text-xs font-bold text-white leading-tight">Rishabh Sharma</p>
                        <p class="text-[10px] text-teal-200">Super Admin</p>
                    </div>
                    <svg class="w-3.5 h-3.5 text-teal-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>

            </div>
        </header>

        <!-- Page Body Canvas with Smooth Curved Top-Left Radius (20px) -->
        <main class="flex-1 bg-[#F4F9F8] rounded-tl-[20px] p-6 lg:p-8 overflow-y-auto min-h-0 shadow-inner">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed = false;
}
