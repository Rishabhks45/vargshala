@implements IDisposable
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IUserService UserService

<div class="flex h-screen max-h-screen w-screen overflow-hidden bg-[#004D40] font-sans text-slate-800 antialiased select-none">
    
    <!-- Global Toast / Alert Notifications Container -->
    <ToastContainer />
    
    <!-- Permanently Fixed Left Sidebar Navigation -->
    <NavMenu @bind-IsCollapsed="_sidebarCollapsed" />

    <!-- Right Shell: Fixed Header + Scrollable Main Content Canvas -->
    <div class="flex flex-col flex-1 h-screen max-h-screen min-w-0 bg-[#004D40] overflow-hidden">
        
        <!-- Deep Teal Top Header -->
        <header class="h-16 shrink-0 z-30 flex items-center justify-between px-4 sm:px-6 bg-[#004D40] text-white border-none">
            
            <!-- Left: Sidebar Toggle + Dynamic Page Title & Organization Name -->
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <!-- Hamburger Toggle Button for Sidebar -->
                <button type="button" 
                        @onclick="() => _sidebarCollapsed = !_sidebarCollapsed"
                        class="p-0 -ml-1.5 rounded-xl text-teal-200 hover:text-white hover:bg-white/10 transition-all cursor-pointer"
                        title="@(_sidebarCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">                   
                    @if(_sidebarCollapsed)
                    {
                  

                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M12.5 8.5l3.5 3.5-3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                    }
                    else
                    {
                           <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <line x1="8.5" y1="3" x2="8.5" y2="21" />
                    <path d="M16 8.5l-3.5 3.5 3.5 3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                    }
                </button>

                <!-- Dynamic Page Title & Organization Subtitle -->
                <div class="flex flex-col justify-center min-w-0">
                    <h1 class="text-base sm:text-lg font-extrabold text-white tracking-tight leading-tight truncate">
                        @GetCurrentPageTitle()
                    </h1>
                    <AuthorizeView>
                        <Authorized>
                            @{
                                var orgName = context.User.FindFirst("OrganizationName")?.Value;
                                var branchName = context.User.FindFirst("BranchName")?.Value;
                                var role = RoleNavigationHelper.GetRoleDisplayName(context.User);
                            }
                            <p class="text-[11px] text-teal-200/90 font-medium truncate flex items-center gap-1.5">
                                @if (!string.IsNullOrWhiteSpace(orgName))
                                {
                                    <span class="font-bold text-white">@orgName</span>
                                    <span class="text-teal-400/80">•</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(branchName))
                                {
                                    <span class="text-teal-200 font-medium">@branchName</span>
                                    <span class="text-teal-400/80">•</span>
                                }
                                <span class="text-amber-300 font-semibold text-[10px]">@role</span>
                            </p>
                        </Authorized>
                        <NotAuthorized>
                            <p class="text-[11px] text-teal-200/80 font-medium">
                                Vargshala SaaS Portal
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <!-- Top Right Profile, Notification & Theme Controls -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                
                <!-- Dark / Light Mode Toggle Button -->
                <button type="button" 
                        onclick="window.toggleAppTheme()" 
                        class="p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-all cursor-pointer shadow-2xs"
                        title="Toggle Dark / Light Mode">
                    <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                    <svg class="w-5 h-5 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </button>

                <!-- Notification Bell with Alert Badge -->
                <button class="relative p-2 rounded-xl text-teal-100 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
                        title="Notifications">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    <span class="absolute top-1.5 right-1.5 flex items-center justify-center w-2 h-2 bg-[#FB6868] rounded-full ring-2 ring-[#004D40]"></span>
                </button>

                <!-- Admin User Profile Pill with AuthorizeView & Sign Out -->
                <AuthorizeView>
                    <Authorized>
                        @{
                            var user = context.User;
                            var profile = UserService.CurrentProfile;
                            var name = profile != null && !string.IsNullOrWhiteSpace(profile.FirstName)
                                ? $"{profile.FirstName} {profile.LastName}".Trim()
                                : user.Identity?.Name ?? "User";
                            var role = profile != null
                                ? profile.Role.GetDisplayName()
                                : RoleNavigationHelper.GetRoleDisplayName(user);
                            var email = profile?.Email ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                            var orgName = profile?.OrganizationName ?? user.FindFirst("OrganizationName")?.Value;
                            var roleStr = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                                       ?? user.FindFirst("role")?.Value 
                                       ?? user.FindFirst("Role")?.Value;
                            var isOrgAdmin = (profile != null && profile.Role == UserRole.OrganizationAdmin)
                                          || user.IsInRole("OrganizationAdmin") || user.IsInRole("1") 
                                          || string.Equals(roleStr, "OrganizationAdmin", StringComparison.OrdinalIgnoreCase) 
                                          || roleStr == "1";
                            var avatarUrl = profile?.ProfilePictureUrl;
                            var nameParts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = nameParts.Length > 0 
                                ? string.Concat(nameParts.Take(2).Select(w => char.ToUpperInvariant(w[0]))) 
                                : "U";
                        }
                        <div class="relative">
                            <button type="button" @onclick="ToggleUserMenu"
                                    class="flex items-center gap-2.5 p-1 sm:px-2 sm:py-1.5 rounded-xl hover:bg-white/10 active:scale-95 cursor-pointer transition-all select-none border border-transparent hover:border-white/15">
                                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#009488] to-[#00796b] text-white overflow-hidden shrink-0 flex items-center justify-center font-bold text-xs shadow-sm ring-1 ring-white/20">
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="Avatar" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        @initials
                                    }
                                </div>
                                <div class="hidden md:block text-left">
                                    <p class="text-xs font-bold text-white leading-tight">@name</p>
                                    <p class="text-[10px] text-teal-200 font-medium">@role</p>
                                </div>
                                <svg class="w-3.5 h-3.5 text-teal-200 hidden md:block transition-transform duration-200 @(_userMenuOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            @if (_userMenuOpen)
                            {
                                <div class="fixed inset-0 z-40" @onclick="() => _userMenuOpen = false"></div>
                                <div class="absolute right-0 top-full mt-2 w-64 rounded-2xl bg-[#00382E] border border-teal-600/50 shadow-2xl p-2 z-50 animate-in fade-in zoom-in-95 duration-100 text-left backdrop-blur-md">
                                    <!-- User Header Info -->
                                    <div class="p-2.5 rounded-xl bg-[#004D40]/50 border border-teal-700/50 mb-1.5">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#009488] to-[#00796b] text-white overflow-hidden flex items-center justify-center font-extrabold text-xs shadow-xs shrink-0 ring-1 ring-white/20">
                                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                                {
                                                    <img src="@avatarUrl" alt="Avatar" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    @initials
                                                }
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-xs font-black text-white truncate" title="@name">@name</p>
                                                <div class="flex items-center gap-1.5 mt-0.5">
                                                    <span class="inline-block px-1.5 py-0.2 rounded-full text-[9px] font-extrabold bg-[#002820] text-teal-300 border border-teal-500/30">
                                                        @role
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(email))
                                        {
                                            <p class="text-[10px] text-teal-200/80 truncate font-mono mt-2 pt-2 border-t border-teal-700/40" title="@email">
                                                @email
                                            </p>
                                        }

                                        @if (isOrgAdmin && !string.IsNullOrWhiteSpace(orgName))
                                        {
                                            <p class="text-[10px] text-teal-100 truncate mt-1 flex items-center gap-1.5 font-semibold" title="@orgName">
                                                <span class="text-teal-300">🏛️</span>
                                                <span class="truncate">@orgName</span>
                                            </p>
                                        }
                                    </div>

                                    <!-- Navigation Links -->
                                    <div class="space-y-0.5">
                                        <!-- My Profile Link -->
                                        <a href="profile" @onclick="() => _userMenuOpen = false"
                                           class="w-full px-3 py-2 rounded-xl text-xs font-semibold text-teal-100 hover:bg-teal-700/40 hover:text-white flex items-center gap-2.5 transition-colors cursor-pointer">
                                            <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                            <span>My Profile</span>
                                        </a>

                                        <!-- Institute Settings Link (ONLY FOR ORG ADMIN) -->
                                        @if (isOrgAdmin)
                                        {
                                            <a href="settings" @onclick="() => _userMenuOpen = false"
                                               class="w-full px-3 py-2 rounded-xl text-xs font-semibold text-teal-100 hover:bg-teal-700/40 hover:text-white flex items-center gap-2.5 transition-colors cursor-pointer">
                                                <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                                </svg>
                                                <span>Institute Settings</span>
                                            </a>
                                        }
                                    </div>

                                    <div class="my-1 border-t border-teal-800/80"></div>

                                    <!-- Sign Out Button -->
                                    <button type="button" @onclick="HandleSignOut"
                                            class="w-full px-3 py-2 rounded-xl text-xs font-semibold text-rose-300 hover:bg-rose-950/60 hover:text-rose-200 flex items-center gap-2.5 cursor-pointer transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                        </svg>
                                        <span>Sign Out</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-xs font-bold text-white bg-[#009488] px-3.5 py-2 rounded-xl shadow-xs hover:bg-[#00a89a] transition-all">
                            Sign In
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

            </div>
        </header>

        <!-- Page Body Canvas (20px Curved Top-Left Radius, Fits Screen Height) -->
        <main class="flex-1 flex flex-col bg-[#F4F9F8] dark:bg-[#0c1417] text-slate-800 dark:text-slate-100 rounded-tl-[20px] p-6 overflow-hidden min-h-0 shadow-inner select-text transition-colors duration-200 scrollbar-hidden">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed = false;
    private bool _userMenuOpen = false;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UserService.OnProfileUpdated += HandleProfileUpdated;

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true && UserService.CurrentProfile == null)
            {
                await UserService.GetMyProfileAsync();
            }
        }
    }

    private void HandleProfileUpdated(UserDto updatedProfile)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private string GetCurrentPageTitle()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        var cleanPath = relativePath.Split('?')[0].Trim('/');

        return cleanPath switch
        {
            "" => "Dashboard",
            "controlpanel" or "controlpanel/platform" => "Platform",
            "controlpanel/institutes" => "Institutes",
            "controlpanel/subscriptions" => "Subscriptions",
            "controlpanel/coupons" => "Coupons & Discounts",
            "controlpanel/payment-logs" or "controlpanel/payments" => "Payment Logs",
            "controlpanel/tenants" => "Institutes",
            "controlpanel/push" => "Push",
            "controlpanel/logs" => "Logs",
            "controlpanel/health" => "Health",
            "controlpanel/email-templates" or "controlpanel/templates" => "Email Templates",
            "controlpanel/users" => "Users",

            "student" or "student/home" => "Home",
            "student/study-material" => "Study Material",
            "student/tasks" => "Tasks",
            "student/quizzes" => "Quizzes",
            "student/progress" => "Progress",
            "student/report-card" => "Report Card",
            "student/fees" => "Fees",
            "student/chat" => "Chat",
            "student/events" => "Events",

            "students" => "Students Directory",
            "teachers" => "Teachers & Faculty",
            "branches" => "Branch Management",
            "batches" => "Classes & Batches",
            "attendance" => "Attendance Register",
            "exams" => "Exams & Quizzes",
            "assignments" => "Assignments",
            "study-material" => "Study Material",
            "timetable" => "Class Timetable",
            "fees" => "Fee Management",
            "reports" => "Reports & Analytics",
            "masters" => "Master Configurations",
            "notices" => "Notice Board",
            "messages" => "Messages & Chat",
            "events" => "Events & Calendar",
            "settings" => "Institute Settings",
            "contact" => "Contact Support",
            _ => cleanPath.StartsWith("controlpanel") ? "Platform" :
                 cleanPath.StartsWith("student") ? "Student Portal" : "Dashboard"
        };
    }

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;

    private async Task HandleSignOut()
    {
        _userMenuOpen = false;
        await AuthService.LogoutAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        UserService.OnProfileUpdated -= HandleProfileUpdated;
    }
}
