@inherits LayoutComponentBase

<div class="h-screen max-h-screen overflow-hidden bg-slate-950 font-sans text-slate-100 flex flex-col justify-between selection:bg-brand-500 selection:text-white">
    <!-- Main Auth Content Area (Centered & Fits inside Viewport) -->
    <main class="flex-1 flex items-center justify-center p-3 sm:p-4 lg:p-6 min-h-0 overflow-hidden">
        @Body
    </main>

    <!-- Minimal Fixed-Height Footer -->
    <footer class="py-2.5 text-center text-[11px] text-slate-500 border-t border-slate-900/80 bg-slate-950 shrink-0">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-1">
            <span>© 2026 Vargshala SaaS • Multi-Tenant Institute Platform</span>
            <div class="flex items-center gap-3 text-slate-400">
                <a href="#" class="hover:text-brand-400 transition-colors">Privacy Policy</a>
                <span>•</span>
                <a href="#" class="hover:text-brand-400 transition-colors">Terms of Service</a>
                <span>•</span>
                <a href="#" class="hover:text-brand-400 transition-colors">Help Center</a>
            </div>
        </div>
    </footer>
</div>
